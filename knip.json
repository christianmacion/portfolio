// knip.json — dead-code detector config.
// Catches unused imports, exports, files, and dependencies. Runs as `npm run knip`.
// Ignored built-ins (dist, .astro, node_modules, public) are excluded by knip's defaults;
// *.d.ts files contain ambient types and aren't tracked.
//
// paths: Mirror of tsconfig.json path aliases. knip's tsconfig auto-loader doesn't
// pick up aliases from the extended `astro/tsconfigs/strict` base reliably, so we
// declare them inline. Mirroring `compilerOptions.paths` from tsconfig.json.
//
// v12.W5.2 — broader ignore patterns:
//   - src/components/icons/**     : icon library, dispatched dynamically by name
//   - src/scripts/**/*.ts          : scripts imported via @scripts/* alias
//   - src/data/earth-110m-*        : auto-generated topojson data (build script)
//   - src/_archive/**              : archived components (kept for git history; not imported)
//   - functions/**                 : Cloudflare Pages Functions, local-dev only (CF Pages deleted)
//   - workers/maintenance/**       : Cloudflare Worker, local-dev only (CF Pages deleted)
//   - public/sw.js                 : service worker (entry point, no static imports)
//   - perf-mobile.mjs / screenshot.mjs / serve-dist.mjs : verify scripts (run directly)
//   - scripts/**.mjs (legacy)      : one-shot verify / axe / debug / screenshot scripts
//                                   run directly via `node scripts/X.mjs`. Not part of
//                                   the build pipeline. Knip treats unimported files
//                                   as dead unless declared as entry points, so the
//                                   whole scripts/ dir is listed under entry below.
//   - scripts/__tests__/**         : smoke tests (run via node directly)
//   - .audit/**                    : diagnostic/audit working scripts, evidence
//                                   snapshots, and incident reports committed to the
//                                   repo. They are NEVER reachable as imports — they
//                                   are referenced from AAR docs only.
//   - src/utils/gdelt-client.ts + market-ticks.ts : used by <script> tags in .astro
//                                   pages (worldview.client.ts + gdelt-cache.json
//                                   consumers). Knip cannot follow these imports.
//   - src/components/Avatar|BrandMotif|CodeProofCard|FlagshipCard|NavMore|PulseRing|SiteHeader|V613Fonts :
//                                   legacy chrome components kept for git history; not
//                                   currently imported. Listed under ignore so knip
//                                   does not flag them as dead.
//
// knip cannot follow @components/* or @scripts/* path aliases reliably
// when imports appear inside <script> tags of .astro files (BaseLayout.astro
// imports ~15 scripts this way). Side-effect imports (`import '@scripts/x'`)
// are runtime-only and don't carry a module-reference the static analyzer
// can follow. Suppress with patterns.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/pages/**/*.astro",
    "functions/_middleware.js",
    "functions/api/**/*.ts",
    "functions/lib/**/*.ts",
    "functions/types/**/*.ts",
    "workers/maintenance/src/index.ts",
    "public/sw.js",
    "perf-mobile.mjs",
    "screenshot.mjs",
    "serve-dist.mjs",
    "scripts/__tests__/**/*.mjs",
    "scripts/axe-*.mjs",
    "scripts/debug-*.mjs",
    "scripts/probe.mjs",
    "scripts/screenshot-*.mjs",
    "scripts/w3-*.mjs",
    "scripts/wordcount-*.mjs",
    "scripts/worldview-*.mjs",
    "scripts/wv-*.mjs",
    "scripts/check-*.mjs"
  ],
  "paths": {
    "@components/*": ["src/components/*"],
    "@layouts/*": ["src/layouts/*"],
    "@styles/*": ["src/styles/*"],
    "@utils/*": ["src/utils/*"],
    "@content/*": ["src/content/*"],
    "@scripts/*": ["src/scripts/*"],
    "@data/*": ["src/data/*"]
  },
  "ignore": [
    "src/components/icons/**",
    "src/_archive/**",
    "src/data/earth-110m-*",
    "src/scripts/**",
    "src/utils/gdelt-client.ts",
    "src/utils/market-ticks.ts",
    "src/components/Avatar.astro",
    "src/components/BrandMotif.astro",
    "src/components/CodeProofCard.astro",
    "src/components/FlagshipCard.astro",
    "src/components/NavMore.astro",
    "src/components/PulseRing.astro",
    "src/components/SiteHeader.astro",
    "src/components/V613Fonts.astro",
    "axe-sweep.mjs",
    "axe-w2-verify.mjs",
    ".audit/**"
  ],
  "ignoreDependencies": [
    "astro-expressive-code",
    "@astrojs/rss",
    "astro-icon",
    "lightweight-charts",
    "lucide",
    "rehype-katex",
    "remark-math",
    "world-atlas",
    "@cloudflare/workers-types",
    "@fontsource/jetbrains-mono",
    "@fontsource/source-serif-4",
    "@fontsource/vt323",
    "@mojs/core",
    "d3-geo"
  ],
  "ignoreBinaries": ["pdftotext", "python3"],
  "ignoreExportsUsedInFile": true,
  "ignoreUnresolved": ["/_pagefind/pagefind-ui.js"],
  "ignoreMembers": ["src/utils/build-stamp.ts:packageVersion"]
}