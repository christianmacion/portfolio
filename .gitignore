# build artifacts — regenerated by `npm run build` (prebuild hook)
public/og-image*.jpg
public/pwa-*.png
public/apple-touch-icon-*.png
public/favicon.ico
public/maskable-icon-*.png
public/favicon-*.png
# resume build intermediates (the .pdf outputs are committed, the .docx are not)
public/resume-*.docx

# audit working artifacts — kept locally for the working session, NOT committed.
# The canonical evidence commits to .audit/lighthouse/ + .audit/a11y/axe-final-*.json +
# .audit/incident/<date>/ (SEV-1 trail). Per feedback-portfolio-visual-bar-2026-07-31
# (audit-trail matters), canonical is committed; transient working artifacts are not.
.audit/design-token-inventory.md
.audit/research-v6.md
.audit/visual-diff-v6.md
.audit/a11y/axe-before.json
.audit/a11y/axe-after-common.json
.audit/a11y/axe-after-cta-fix.json
.audit/a11y/axe-report.json
# transient audit caches (defense in depth — these dirs may not exist)
.audit/cache/
.audit/diff/
# diagnostic working scripts — never imported, never reached from app code.
# The committed JSON evidence (lighthouse/, a11y/axe-final-*, incident/<date>/) is the
# canonical artifact; the .cjs/.mjs scripts are regenerated on demand and never referenced.
.audit/**/*.cjs
.audit/**/*.mjs

# v2026-08-23 cleanup : transient per-wave verify/probe scripts in scripts/
# that regenerated ad-hoc on qa_engineer runs. The canonical evidence is in
# .audit/lighthouse/ + .audit/a11y/. These _*.mjs scripts are ad-hoc probe
# scripts and are never imported from app code; archived 2026-08-23 to
# ~/Contingency/portfolio-improvement/audit-archive/2026-08-23/scripts/.
scripts/_*.mjs

# v2026-08-23 cleanup : one-off verify scripts that landed in scripts/ at root.
# Pattern still applies : never imported, never referenced from app code.
scripts/audit-*.mjs
scripts/axe-*.mjs
scripts/build-graph-snapshot.mjs
scripts/cross-device-audit.mjs
scripts/debug-*.mjs
scripts/probe.mjs
scripts/vibe-audit-*.mjs
scripts/w3-*.mjs
scripts/worldview-verify.mjs
scripts/wv-verify2.mjs

# v2026-08-23 cleanup : root-level audit debris. _audit-* and _verify-* files
# were ad-hoc timeline / tape / axe verification scripts and screenshots.
# Archived 2026-08-23 to ~/Contingency/portfolio-improvement/audit-archive/.
_audit-*
_verify-*
