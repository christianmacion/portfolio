# v7.7.86 — exclude regenerated cache + build outputs from prettier format:check.
# Without this, `npm run ci` fails after every ship because `prebuild`
# regenerates the cache JSONs and resume MDs in formats Prettier does not
# match. Root-cause fix for the recurring v7.7.85 / v7.7.86 CI hiccup.
#
# Patterns below are intentionally narrow — anything that should be
# human-authored or hand-formatted remains in Prettier's scope.

# Live data caches (regenerated by scripts/fetch-*.mjs)
src/data/*-cache.json
src/data/*-cache.fallback.json

# Graph streaming snapshot (regenerated by scripts/build-graph-snapshot.mjs)
public/graph-stream.json

# Resume variants (regenerated by scripts/build-resumes*.mjs)
public/resume-*.md
public/resume-*.txt

# Astro build output
dist/
.astro/

# Pagefind search index
public/_pagefind/
