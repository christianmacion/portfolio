---
/**
 * HeroCurve.astro : flagship hero animated SVG equity curve centerpiece.
 *
 * Pure SVG, no JS lib. Hand-drawn realistic quant cumulative-PnL shape:
 * steady climb → mid-period drawdown → late acceleration. Animations:
 *   1. Draw-on-mount via stroke-dasharray + stroke-dashoffset
 *      (2.4s ease-out). prefers-reduced-motion: reduce disables.
 *   2. Pulse dot at curve terminus (1.6s opacity + r).
 *   3. Hairline grid behind curve (institutional register).
 *
 * Chrome contract: no halo, no glow, no gradient. Single accent
 * (j-amber) on the curve and the pulse dot.
 *
 * Caption row: live stats pulled from props.caption (passed by index.astro).
 */
interface Props {
  /** Caption shown beneath the chart. Default: 18-month paper-PnL summary. */
  caption?: string;
}

const { caption = '+47.3% · 18 MO · SHARPE 1.84 · PAPER' } = Astro.props;
---

<figure class="hero-curve" aria-label="Animated cumulative P&L curve">
  <svg
    class="hero-curve__svg"
    viewBox="0 0 480 240"
    role="img"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
  >
    <!-- Hairline grid: 4 horizontal rules, 1 vertical "now" line -->
    <g class="hero-curve__grid" stroke="currentColor" stroke-width="0.5">
      <line x1="20" y1="40" x2="460" y2="40" />
      <line x1="20" y1="90" x2="460" y2="90" />
      <line x1="20" y1="140" x2="460" y2="140" />
      <line x1="20" y1="190" x2="460" y2="190" />
      <line x1="20" y1="40" x2="20" y2="190" />
      <line x1="460" y1="40" x2="460" y2="190" stroke-dasharray="2 4" />
    </g>

    <!-- Y-axis tick labels -->
    <g class="hero-curve__ticks" font-family="ui-monospace, SFMono-Regular, Menlo, monospace" font-size="9" fill="currentColor">
      <text x="14" y="194" text-anchor="end">0</text>
      <text x="14" y="144" text-anchor="end">+15</text>
      <text x="14" y="94" text-anchor="end">+30</text>
      <text x="14" y="44" text-anchor="end">+45</text>
    </g>

    <!-- The curve itself: M start, then ascending polyline with one mid-drawdown.
         Path length tuned ~700 for the dasharray animation. -->
    <path
      class="hero-curve__line"
      d="M 20 195 L 60 188 L 100 170 L 140 158 L 180 162 L 220 130 L 260 138 L 300 100 L 340 70 L 380 48 L 460 28"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Pulse dot at the curve's terminus -->
    <circle class="hero-curve__pulse" cx="460" cy="28" r="3.5" fill="currentColor" />
    <circle class="hero-curve__pulse-ring" cx="460" cy="28" r="3.5" fill="none" stroke="currentColor" stroke-width="1" />
  </svg>

  <figcaption class="hero-curve__caption mono">{caption}</figcaption>
</figure>

<style>
  .hero-curve {
    margin: 0;
    width: 100%;
    color: var(--j-amber);
    background: var(--j-bg);
    border: 1px solid var(--j-rule);
    padding: 18px 20px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-radius: 0; /* chrome contract: sharp corners */
  }
  .hero-curve__svg {
    width: 100%;
    height: auto;
    display: block;
    color: var(--j-amber);
  }
  .hero-curve__grid,
  .hero-curve__ticks {
    color: var(--j-ink-3);
    opacity: 0.55;
  }
  .hero-curve__line {
    stroke-dasharray: 800;
    stroke-dashoffset: 800;
    animation: hero-curve-draw 2.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
  }
  .hero-curve__pulse {
    opacity: 0;
    animation: hero-curve-fade 0.4s ease-out 2.4s forwards;
  }
  .hero-curve__pulse-ring {
    opacity: 0;
    transform-origin: 460px 28px;
    animation: hero-curve-pulse 1.6s ease-out 2.6s infinite;
  }
  .hero-curve__caption {
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--j-ink-2);
    text-transform: uppercase;
    border-top: 1px solid var(--j-rule);
    padding-top: 8px;
    margin: 0;
  }
  @keyframes hero-curve-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes hero-curve-fade {
    to {
      opacity: 1;
    }
  }
  @keyframes hero-curve-pulse {
    0% {
      opacity: 0.9;
      transform: scale(1);
    }
    70% {
      opacity: 0;
      transform: scale(2.4);
    }
    100% {
      opacity: 0;
      transform: scale(2.4);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-curve__line {
      animation: none;
      stroke-dashoffset: 0;
    }
    .hero-curve__pulse {
      animation: none;
      opacity: 1;
    }
    .hero-curve__pulse-ring {
      animation: none;
      opacity: 0;
    }
  }
</style>
