<script>
  /**
   * v7.9 split — load country paths at runtime.
   * Fetches /data/world-map-equirect.json and populates the empty
   * `.bloomberg__continents` container. Cheap (1.46 MB) and lazy
   * (deferred until idle so it never competes with first paint).
   */
  const continentsTarget = document.querySelector<SVGGElement>('[data-continents-target]');
  if (continentsTarget) {
    const populate = (countries: Array<{ id: string; name: string; d: string }>): void => {
      const ns = 'http://www.w3.org/2000/svg';
      const frag = document.createDocumentFragment();
      for (const c of countries) {
        const path = document.createElementNS(ns, 'path');
        path.setAttribute('d', c.d);
        path.setAttribute('class', 'bloomberg__country');
        path.setAttribute('data-id', c.id);
        const title = document.createElementNS(ns, 'title');
        title.textContent = c.name;
        path.appendChild(title);
        frag.appendChild(path);
      }
      continentsTarget.appendChild(frag);
    };
    const start = (): void => {
      fetch('/data/world-map-equirect.json')
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`))))
        .then(populate)
        .catch((err) => {
          console.warn('[swarm-scene] country paths failed to load', err);
        });
    };
    const w = window as Window & { requestIdleCallback?: (cb: () => void) => void };
    if (typeof w.requestIdleCallback === 'function') {
      w.requestIdleCallback(start);
    } else {
      w.setTimeout(start, 0);
    }
  }
</script>
