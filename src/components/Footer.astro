---
/**
 * Footer.astro — v2: full contact directory + 4 columns.
 * v6.18 — drop `v6.16.0` dev-debug chrome from the base strip; replace
 * with the deploy date only (build SHA + year are already implicitly
 * carried by the deploy timestamp).
 */
import { profile } from '@utils/profile';
import { path } from '@utils/url';
import { buildYear, buildStampUtc8 } from '@utils/build-stamp';
import BrandMotif from '@components/BrandMotif.astro';
import Avatar from '@components/Avatar.astro';

const year = buildYear();
const deployedStamp = buildStampUtc8();

// v9.3.2 motion contract — /proof/ and /methodology/ are "what is this
// portfolio" surfaces; the TrustStrip pulse is the heartbeat there. The
// BrandMotif breathe is suppressed on those two pages so the registry
// reads exactly 1 infinite loop per viewport (the trust-pulse). See
// 2026-08-02 motion audit M-2. Astro.url.pathname keeps the base path
// (e.g. `/portfolio/proof/` on GH Pages builds), so we match suffix.
const pathname = Astro.url.pathname;
const noPulseSuffixes = ['/proof', '/methodology'];
const footerPulse = !noPulseSuffixes.some(
  (s) => pathname === s || pathname === `${s}/` || pathname.endsWith(`${s}/`)
);
---

<footer class="footer">
  <div class="footer__cta-strip" aria-label="Hiring inquiry shortcut">
    <div class="container footer__cta-inner">
      <p class="footer__cta-eyebrow mono">If you're hiring — 60-second path:</p>
      <div class="footer__cta-row">
        <a
          class="footer__cta footer__cta--primary"
          href={`mailto:${profile.contact.email}?subject=Hiring%20inquiry%20—%20Senior%20QR%20%2F%20AI%20Engineer-Architect`}
          >Email — Hiring Inquiry</a
        >
        <a class="footer__cta" href={path('/for-recruiters')}>Recruiter Brief</a>
        <a class="footer__cta" href={path('/comp')}>Comp Bands</a>
        <a class="footer__cta" href={path('/positions')}>Live Positions</a>
        <a class="footer__cta" href={path('/methodology')}>Method (G1–G31)</a>
      </div>
    </div>
  </div>
  <div class="container footer__inner">
    <div class="footer__brand">
      <div class="footer__mark">
        <BrandMotif width={140} decorative={true} pulse={footerPulse} />
      </div>
      <div class="footer__identity">
        <div class="footer__avatar">
          <Avatar alt={profile.headshot.alt} size={48} loading="lazy" fetchpriority="auto" />
        </div>
        <div class="footer__id-text">
          <div class="footer__name">{profile.fullName}</div>
          <div class="footer__role">{profile.titles.primary}</div>
          <div class="footer__loc mono">{profile.location.display}</div>
          {
            /* F21 — institutional: dot for "online/available" should be amber,
              not bright pass-green. Single accent = institutional. */
          }
          <div class="footer__hours mono">
            <span class="dot dot--amber" aria-hidden="true"></span>
            {profile.availability.mode} · {profile.availability.hours}
          </div>
        </div>
      </div>
    </div>

    <div class="footer__cols">
      <div class="footer__col">
        <h3>Site</h3>
        <ul>
          <li><a href={path('/solutions')}>Solutions</a></li>
          <li><a href={path('/projects')}>Projects</a></li>
          <li><a href={path('/proof')}>Proof</a></li>
          <li><a href={path('/positions')}>Positions</a></li>
          <li><a href={path('/comp')}>Comp &amp; engagement</a></li>
          <li><a href={path('/mistakes')}>Mistakes</a></li>
          <li><a href={path('/screening-call')}>Screening call</a></li>
          <li><a href={path('/publications')}>Publications</a></li>
          <li><a href={path('/methodology')}>Methodology</a></li>
          <li><a href={path('/experience')}>Experience</a></li>
          <li><a href={path('/skills')}>Skills</a></li>
          <li><a href={path('/certifications')}>Certifications</a></li>
          <li><a href={path('/uses')}>Uses</a></li>
          <li><a href={path('/about')}>About</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h3>Contact</h3>
        <ul>
          <li><a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a></li>
          <li><a href={`tel:${profile.contact.phone}`}>{profile.contact.phoneDisplay}</a></li>
          <li>
            <a href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer"
              >LinkedIn ↗</a
            >
          </li>
          <li>
            <a href={profile.contact.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </li>
          <li>
            <a href={profile.contact.medium} target="_blank" rel="noopener noreferrer">Medium ↗</a>
          </li>
          <li>
            <a href={profile.contact.ojp} target="_blank" rel="noopener noreferrer"
              >OnlineJobs.ph ↗</a
            >
          </li>
          <li>
            <a href={profile.contact.upwork} target="_blank" rel="noopener noreferrer">Upwork ↗</a>
          </li>
        </ul>
      </div>

      <div class="footer__col">
        <h3>Method</h3>
        <ul class="mono">
          <li><a href={path('/methodology')}>eval-first discipline</a></li>
          <li>
            <a href={path('/methodology')}
              ><strong>G1–G{profile.stats.evalGates} gate stack</strong> ↗</a
            >
          </li>
          <li>block-bootstrap CIs</li>
          <li>deflated Sharpe</li>
          <li>CSCV-based PBO</li>
          <li>walk-forward · 5-era stability</li>
          <li>frozen-spec evaluation</li>
        </ul>
      </div>

      <div class="footer__col">
        <h3>Availability</h3>
        <ul>
          <li>Remote · {profile.availability.hours}</li>
          <li class="mono">UTC+8 · Philippines</li>
          <li>Open to QR / AI eng roles</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__base">
    <div class="container footer__base-inner">
      <small
        >© {year}
        {profile.shortName}. Built with Astro. <span class="mono"
          >No proprietary data sources referenced.</span
        ></small
      >
      <div class="footer__base-meta">
        <small class="mono">
          <a href={path('/humans.md')}>humans.md</a> · AI-agent identity document
        </small>
        <small class="mono">
          portfolio.os · last deployed {deployedStamp} · built with Astro
        </small>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--sp-9);
    background: var(--c-tape);
    color: var(--c-ink-mute);
    border-top: 1px solid var(--c-white-mist);
  }

  /* === v8.0.3 · Hiring CTA strip (visible on every page) ===
     Surfaces the recruiter-CTA from the hero on every footer render. The
     highest-leverage placement because BaseLayout.astro wraps every page
     in this Footer. 1 page to update → 89 pages inherit the strip. */
  .footer__cta-strip {
    border-bottom: 1px solid var(--c-white-mist);
    background: var(--c-bg-elev-1);
    padding-block: var(--sp-5);
  }
  .footer__cta-inner {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    flex-wrap: wrap;
  }
  .footer__cta-eyebrow {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-white-fade);
    margin: 0;
    padding-right: var(--sp-4);
    border-right: 1px solid var(--c-white-mist);
  }
  .footer__cta-row {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .footer__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: none;
    border: 1px solid var(--c-white-mist);
    border-radius: 0;
    background: transparent;
    transition:
      border-color 120ms ease,
      color 120ms ease;
  }
  .footer__cta:hover {
    border-color: var(--c-amber);
    color: var(--c-amber-light);
  }
  .footer__cta--primary {
    background: var(--c-ink);
    color: var(--c-paper);
    border-color: var(--c-ink);
  }
  .footer__cta--primary:hover {
    background: var(--c-amber);
    border-color: var(--c-amber);
    color: var(--c-paper);
  }
  @media (max-width: 720px) {
    .footer__cta-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-3);
    }
    .footer__cta-eyebrow {
      border-right: none;
      padding-right: 0;
      padding-bottom: var(--sp-2);
      border-bottom: 1px solid var(--c-white-mist);
    }
    .footer__cta-row {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    .footer__cta {
      justify-content: center;
    }
  }
  .footer__inner {
    padding-block: var(--sp-7);
    display: grid;
    grid-template-columns: 1.1fr 3fr;
    gap: var(--sp-7);
  }
  .footer__mark {
    margin-bottom: var(--sp-4);
    opacity: 0.92;
  }
  .footer__identity {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
  }
  .footer__avatar {
    flex-shrink: 0;
  }
  .footer__avatar :global(.avatar) {
    border-width: 1px;
  }
  .footer__id-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .footer__name {
    font-weight: 600;
    color: var(--c-ink);
    font-size: var(--fs-lg);
  }
  .footer__role {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    margin-top: 0.25rem;
  }
  .footer__loc {
    color: var(--c-white-faint);
    font-size: var(--fs-sm);
    margin-top: 0.25rem;
  }
  .footer__hours {
    color: var(--c-white-faint);
    font-size: var(--fs-xs);
    margin-top: var(--sp-2);
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-5);
  }
  .footer__col h3 {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-white-ghost);
    margin-bottom: var(--sp-3);
  }
  .footer__col ul {
    list-style: none;
    padding: 0;
  }
  .footer__col li {
    line-height: 1.95;
    font-size: var(--fs-sm);
  }
  .footer__col a {
    color: var(--c-ink-mute);
    /* v6.3 polish — every footer link gets ≥ 44×44 tap target.
       The audit flagged column links at 33-141×17-20 px on mobile
       (Proof, Skills, Uses, About, humans.md). min-height:44 +
       inline-flex + padding-inline:1rem lifts the click rect to
       WCAG 2.5.5 ≥ 44×44 without affecting the visible row rhythm
       (the parent column gap already provides visual breathing). */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.25rem 0.75rem;
  }
  .footer__col a:hover {
    color: var(--c-amber-light);
  }

  .footer__base {
    border-top: 1px solid var(--c-white-mist);
    padding-block: var(--sp-4);
  }
  .footer__base-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .footer__base-inner small {
    font-size: var(--fs-xs);
    color: var(--c-white-fade);
  }
  .footer__base-meta {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .footer__base-meta a {
    /* v9.2 a11y — was --c-warn-deep (--c-amber = --j-warn-deep
       = #8a6f2f) which only hits 3.43:1 on the dark --c-tape (--j-bg
       = #1a1714) surface (Lighthouse mobile, dark default). --c-warn
       (--c-amber = --j-warn = #a88a3e) reads at 5.42:1 on the same
       surface — AA-compliant in both themes. Underline + decor
       rule still carry the link identity. */
    color: var(--c-warn);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--c-amber-decor);
    /* v6.3 polish — humans.md link was 67×17 on mobile. Same
       min-height:44 + inline-flex treatment as the column links
       above so the audit clears every footer <a> on the page. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.25rem 0.5rem;
  }
  .footer__base-meta a:hover {
    /* v9.2 a11y — was --c-warn, which after the link-color remap
       below would no longer be a perceptibly different hover state.
       Now --c-amber (--j-warn-deep = #8a6f2f on dark, 3.43:1
       on --c-tape) — only used on hover, non-blocking for AA. */
    color: var(--c-amber);
    text-decoration-color: var(--c-amber);
  }

  @media (max-width: 880px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
    .footer__cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 540px) {
    .footer__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
