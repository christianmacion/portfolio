---
/**
 * EarthMap.astro : v12 LIVE-DATA THREE-LAYER INSTITUTIONAL EARTH PRIMITIVE.
 *
 * Server-rendered SVG (no JS) for the static layers. When mode is
 * 'live-data', a client script fetches /api/worldview/gdelt every 5 min
 * and overlays the resulting events on Layer C with a hairline that
 * draws from the data-source origin to each event city (1200ms ease-out,
 * reduced-motion safe).
 *
 * Three stacked layers on one equirectangular world map:
 *
 *   Layer A : VENUES     (CoverageGlobe cities, weighted amber dots)
 *   Layer B : WORLD-EVENTS (10 curated events from src/content/world-events)
 *   Layer C : GDELT OVERLAY (live events from /api/worldview/gdelt,
 *                            polarity-tinted at low alpha + data-source
 *                            pulling hairline)
 *
 * Visual register: institutional / Bloomberg. Mono + 1 amber accent.
 * No glow. No pills. No gradient. The landmass dot grid is the same
 * continent-aware sparse grid as CoverageGlobe : visually consistent.
 *
 * Same Equirectangular projection: x = (lon + 180) / 360 * width,
 * y = (90 - lat) / 180 * height. viewBox 720×360.
 *
 * Usage:
 *   <EarthMap />
 *   <EarthMap width={1080} height={540} mode="live-data" />
 */
import { getCollection } from 'astro:content';
import gdeltCache from '../data/gdelt-cache.json';

interface Props {
  /** ViewBox width (default 720). */
  width?: number;
  /** ViewBox height (default 360 : Equirectangular 2:1). */
  height?: number;
  /** Spacing in degrees between background landmass dots (default 18). */
  bgStep?: number;
  /** Optional CSS class on the outer wrapper. */
  class?: string;
  /**
   * Optional venue points override (Layer A). Defaults to the 6-city
   * research-hub set. v8.5.1 : caller passes custom footprint pins
   * (real places + research hubs) instead of the abstract venues.
   */
  points?: Venue[];
  /**
   * Layer mode:
   *   - 'full'      : venues + world-events + static GDELT overlay (markets.astro)
   *   - 'pins'      : venues only (home footprint; cleaner for identity)
   *   - 'live-data' : venues + world-events + LIVE GDELT overlay via Worker
   * Default: 'full'.
   */
  mode?: 'full' | 'pins' | 'live-data';
}
const {
  width = 720,
  height = 360,
  bgStep = 18,
  class: className,
  points: pointsProp,
  mode = 'full',
} = Astro.props;

// === Equirectangular projection ===
function project(lat: number, lon: number): { x: number; y: number } {
  return {
    x: ((lon + 180) / 360) * width,
    y: ((90 - lat) / 180) * height,
  };
}

// === Layer A : venue cities (same default 6 as CoverageGlobe) ===
interface Venue {
  city: string;
  lat: number;
  lon: number;
  weight: number;
  caption: string;
  /** Label placement: 'auto' (default above/below based on home), or
   *  'left' / 'right' / 'top' / 'bottom' to anchor against dense clusters. */
  labelAnchor?: 'auto' | 'left' | 'right' | 'top' | 'bottom';
  /** Manual x-offset in px (overrides anchor). Use for cluster spreading. */
  labelDx?: number;
  /** Manual y-offset in px (overrides anchor). */
  labelDy?: number;
}
interface VenuePosition extends Venue {
  x: number;
  y: number;
  r: number;
}
const defaultVenues: Venue[] = [
  // v13.1.4 polish-7o : APAC cluster (Digos City + Singapore) centers
  // are only ~44 viewBox units apart. Without explicit offsets the
  // anchor='middle' home label "Digos City" (10 chars) overlaps
  // Singapore's narrower label ~5-7 viewBox units at iPad/desktop.
  // Spread Digos down-left, Singapore up-right so labels stack on a
  // diagonal with a clean ~10 viewBox-unit gap. Mirror of the Zurich
  // + London treatment in polish-7p.
  {
    city: 'Digos City',
    lat: 6.74,
    lon: 125.36,
    weight: 1.0,
    caption: 'home base',
    labelAnchor: 'bottom',
    labelDx: -30,
    labelDy: 20,
  },
  {
    city: 'Singapore',
    lat: 1.35,
    lon: 103.82,
    weight: 0.8,
    caption: 'APAC ops',
    labelAnchor: 'top',
    labelDx: 30,
    labelDy: -16,
  },
  { city: 'Tokyo', lat: 35.68, lon: 139.69, weight: 0.7, caption: 'JPX' },
  // v13.1.4 polish-7p : European cluster (Zurich + London) centers are
  // only ~17 viewBox units apart. At 375px viewport (scale 0.521) the
  // default 'auto' above-the-dot labels overlap ~33px horizontally.
  // Spread Zurich up-left, London down-right so the labels stack
  // diagonally instead of colliding on a single baseline.
  //
  // v13.1.4 polish-7o : increased Zurich labelDy -12 → -22 and London
  // labelDy +14 → +24 so the vertical gap is 46 viewBox units
  // (~29 CSS px at iPad 768, ~12 CSS px at iPhone SE), clearing any
  // glyph-height overlap at every viewport.
  {
    city: 'Zurich',
    lat: 47.38,
    lon: 8.54,
    weight: 0.85,
    caption: 'CTA',
    labelAnchor: 'top',
    labelDy: -22,
    labelDx: -22,
  },
  {
    city: 'London',
    lat: 51.51,
    lon: -0.13,
    weight: 0.95,
    caption: 'LSE',
    labelAnchor: 'bottom',
    labelDy: 24,
    labelDx: 22,
  },
  { city: 'New York', lat: 40.71, lon: -74.01, weight: 0.9, caption: 'NYSE / Nasdaq' },
];
const venues: Venue[] = pointsProp ?? defaultVenues;
const venuePositions: VenuePosition[] = venues.map((c: Venue): VenuePosition => {
  const { x, y } = project(c.lat, c.lon);
  const r = 3 + c.weight * 4;
  return { ...c, x, y, r };
});

// === Layer B : world events (Zod-validated collection) ===
interface WorldEventRow {
  id: string;
  title: string;
  category: 'central-bank' | 'earnings' | 'geopolitical' | 'data-release' | 'fx';
  severity: 'mild' | 'moderate' | 'critical';
  lat: number;
  lon: number;
  city: string;
  source: string;
  order: number;
}
const worldEventEntries = await getCollection('worldEvent');
const worldEvents: WorldEventRow[] = worldEventEntries
  .map((e: { id: string; data: WorldEventRow }): WorldEventRow => ({
    id: e.id,
    title: e.data.title,
    category: e.data.category,
    severity: e.data.severity,
    lat: e.data.lat,
    lon: e.data.lon,
    city: e.data.city,
    source: e.data.source,
    order: e.data.order,
  }))
  .sort((a: WorldEventRow, b: WorldEventRow) => a.order - b.order);
const eventPositions = worldEvents.map((e) => {
  const { x, y } = project(e.lat, e.lon);
  return { ...e, x, y };
});

// === Layer C : GDELT cache (polarity-tinted overlay) ===
// Read src/data/gdelt-cache.json : type-narrowed here to keep SSR safe.
interface GdeltEvent {
  id: string;
  title: string;
  category: string;
  severity: string;
  lat: number;
  lon: number;
  city: string;
  source: string;
  timestamp?: string;
  goldstein?: number;
}
interface GdeltCache {
  fetchedAt: string;
  buildDate: string;
  source: string;
  url: string;
  events: GdeltEvent[];
}
const cache = gdeltCache as GdeltCache;
const gdeltEvents: GdeltEvent[] = cache.events;
// === Cache freshness pill ===========================================
// munger-inversion : the failure mode is "4-day-old cache labeled LIVE
// erodes credibility." Compute age at SSR time so the pill is byte-
// deterministic and shippable through the chrome contract. Threshold
// matches the round 1 task brief: >1h old → STALE pill.
//  - fresh  (<1h)   : pill = LIVE    (default; no chrome drift)
//  - stale  (1-6h)  : pill = STALE
//  - very stale (>6h): pill = STALE · Nh old (long-form suffix)
const GDELT_FRESH_MS = 60 * 60 * 1000; // 1h
const GDELT_VERY_STALE_MS = 6 * 60 * 60 * 1000; // 6h
const gdeltCacheAgeMs = Date.now() - new Date(cache.fetchedAt).getTime();
const gdeltCacheAgeH = Math.floor(gdeltCacheAgeMs / (60 * 60 * 1000));
const gdeltCacheState: 'live' | 'stale' | 'very-stale' =
  gdeltCacheAgeMs >= GDELT_VERY_STALE_MS
    ? 'very-stale'
    : gdeltCacheAgeMs >= GDELT_FRESH_MS
      ? 'stale'
      : 'live';
const gdeltCacheLabel =
  gdeltCacheState === 'live'
    ? 'LIVE'
    : gdeltCacheState === 'stale'
      ? 'STALE'
      : `STALE · ${gdeltCacheAgeH}h old`;
// Dedupe by id, cap at 50 for the overlay.
const dedupGdelt: GdeltEvent[] = (() => {
  const seen = new Set<string>();
  const out: GdeltEvent[] = [];
  for (const e of gdeltEvents) {
    if (seen.has(e.id)) continue;
    seen.add(e.id);
    out.push(e);
    if (out.length >= 50) break;
  }
  return out;
})();
const gdeltPositions = dedupGdelt.map((e) => {
  const { x, y } = project(e.lat, e.lon);
  // Polarity: positive Goldstein = amber-soft, negative = ink-2 alpha
  const goldstein = e.goldstein ?? 0;
  const polarity: 'pos' | 'neg' | 'neutral' =
    goldstein > 2 ? 'pos' : goldstein < -2 ? 'neg' : 'neutral';
  return { ...e, x, y, polarity };
});

// === Background landmass dot grid (continent-aware mask) ===
interface BgDot {
  x: number;
  y: number;
  visible: boolean;
}
const bgDots: BgDot[] = [];
for (let lat = -60; lat <= 75; lat += bgStep) {
  for (let lon = -180; lon <= 180; lon += bgStep) {
    const { x, y } = project(lat, lon);
    const nhContinent =
      lat > 5 &&
      lat < 75 &&
      ((lon > -130 && lon < -55) || (lon > -10 && lon < 60) || (lon > 60 && lon < 145));
    const shContinent =
      lat > -55 && lat < 35 && ((lon > -85 && lon < -30) || (lon > -15 && lon < 50));
    const au = lat > -40 && lat < -10 && lon > 110 && lon < 155;
    bgDots.push({ x, y, visible: !!(nhContinent || shContinent || au) });
  }
}

const equatorY = project(0, 0).y;
const primeX = project(0, 0).x;

// === Category → shape mapping for world-events ===
// Triangles for monetary (central-bank, fx), squares for data releases,
// diamonds for earnings, circles for geopolitical. All 5×5 viewBox units.
const eventShape = (category: string): 'triangle' | 'square' | 'diamond' | 'circle' => {
  if (category === 'central-bank' || category === 'fx') return 'triangle';
  if (category === 'data-release') return 'square';
  if (category === 'earnings') return 'diamond';
  return 'circle';
};
---

<figure
  class:list={['earth-map', `earth-map--${mode}`, className]}
  data-component="earth-map"
  data-mode={mode}
  data-gdelt-url="/api/worldview/gdelt"
>
  <svg
    class="earth-map__svg"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={
      mode === 'pins'
        ? `World footprint map: ${venues.length} venue pins. Equirectangular projection.`
        : mode === 'live-data'
          ? `Three-layer world map: ${venues.length} research venues, ${worldEvents.length} curated world events, live GDELT overlay. Equirectangular projection.`
          : `Three-layer world map: ${venues.length} research venues, ${worldEvents.length} curated world events, ${dedupGdelt.length} GDELT signals (24h). Equirectangular projection.`
    }
    preserveAspectRatio="xMidYMid meet"
  >
    <title>Three-layer world map. venues · world events · GDELT 24h</title>

    {/* === Background grid lines (equator + prime meridian) === */}
    <line x1="0" y1={equatorY} x2={width} y2={equatorY} class="earth-map__eq"></line>
    <line x1={primeX} y1="0" x2={primeX} y2={height} class="earth-map__eq"></line>

    {/* === Background landmass dots === */}
    {
      bgDots.map((d) =>
        d.visible ? <circle cx={d.x} cy={d.y} r="0.9" class="earth-map__bg" /> : null,
      )
    }

    {/* === Layer A : venue cities (amber, weighted) ===
       v12.W4 Bryllim parity: dense-cluster label collision avoided via
       per-point `labelAnchor` (left/right/top/bottom) and manual
       `labelDx`/`labelDy` offsets. Default anchor falls back to the
       prior rule (home → below, others → above). */}
    {
      venuePositions.map((c) => {
        // Resolve label position from per-point overrides.
        let lx = c.x;
        let ly: number;
        let anchor: 'middle' | 'start' | 'end' = 'middle';
        if (typeof c.labelDx === 'number') {
          lx = c.x + c.labelDx;
          anchor = c.labelDx > 0 ? 'start' : c.labelDx < 0 ? 'end' : 'middle';
        }
        if (typeof c.labelDy === 'number') {
          ly = c.y + c.labelDy;
        } else if (c.labelAnchor === 'top') {
          ly = c.y - c.r - 4;
        } else if (c.labelAnchor === 'bottom') {
          ly = c.y + c.r + 14;
        } else if (c.labelAnchor === 'left') {
          ly = c.y + 4;
          if (typeof c.labelDx !== 'number') {
            lx = c.x - c.r - 6;
            anchor = 'end';
          }
        } else if (c.labelAnchor === 'right') {
          ly = c.y + 4;
          if (typeof c.labelDx !== 'number') {
            lx = c.x + c.r + 6;
            anchor = 'start';
          }
        } else {
          // Auto: home (weight ≥ 1.0) below, others above.
          ly = c.weight >= 1.0 ? c.y + c.r + 14 : c.y - c.r - 4;
        }
        return (
          <g class="earth-map__venue">
            {c.weight >= 1.0 && <circle cx={c.x} cy={c.y} r="2.5" class="earth-map__anchor" />}
            <circle cx={c.x} cy={c.y} r={c.r} class="earth-map__dot">
              <title>
                {c.city} ({c.lat.toFixed(2)}°, {c.lon.toFixed(2)}°) to {c.caption}
              </title>
            </circle>
            <text
              x={lx}
              y={ly}
              text-anchor={anchor}
              class:list={["earth-map__label", c.weight >= 1.0 && "earth-map__label--home"]}
            >
              {c.city}
            </text>
          </g>
        );
      })
    }

    {
      /* === Layer B : world events (shape-coded by category) ===
        Only rendered in `full` mode (markets.astro). The home-page
        footprint wants pin clarity, not random event dots. */
    }
    {
      mode === 'full' && (
        <>
          {eventPositions.map((e) => {
            const shape = eventShape(e.category);
            return (
              <g
                class={`earth-map__event earth-map__event--${e.category} earth-map__event--${e.severity}`}
              >
                {shape === 'triangle' && (
                  <polygon
                    points={`${e.x},${e.y - 4} ${e.x + 4},${e.y + 3} ${e.x - 4},${e.y + 3}`}
                    class="earth-map__event-shape"
                  >
                    <title>
                      {e.title} to {e.city}
                    </title>
                  </polygon>
                )}
                {shape === 'square' && (
                  <rect
                    x={e.x - 3.5}
                    y={e.y - 3.5}
                    width="7"
                    height="7"
                    class="earth-map__event-shape"
                  >
                    <title>
                      {e.title} to {e.city}
                    </title>
                  </rect>
                )}
                {shape === 'diamond' && (
                  <polygon
                    points={`${e.x},${e.y - 4} ${e.x + 4},${e.y} ${e.x},${e.y + 4} ${e.x - 4},${e.y}`}
                    class="earth-map__event-shape"
                  >
                    <title>
                      {e.title} to {e.city}
                    </title>
                  </polygon>
                )}
                {shape === 'circle' && (
                  <circle cx={e.x} cy={e.y} r="3.5" class="earth-map__event-shape">
                    <title>
                      {e.title} to {e.city}
                    </title>
                  </circle>
                )}
              </g>
            );
          })}

          {/* === Layer C : GDELT overlay (polarity-tinted, low alpha) ===
             Suppressed in live-data mode : Layer D below renders live events
             fetched from /api/worldview/gdelt. === */}
          {mode !== 'live-data' &&
            gdeltPositions.map((e) => (
              <circle
                cx={e.x}
                cy={e.y}
                r="2"
                class={`earth-map__gdelt earth-map__gdelt--${e.polarity}`}
              >
                <title>
                  {e.title} to {e.city}
                </title>
              </circle>
            ))}

          {/* === Layer D (live-data mode only) : client-rendered live
             events + the data-source pulling hairline. The hydration
             script fills this group with `<g data-live-event>` per event.
             === */}
          {mode === 'live-data' && (
            <g class="earth-map__live" data-live-overlay aria-hidden="true" />
          )}
        </>
      )
    }
  </svg>

  <figcaption class="earth-map__caption mono">
    <span class="earth-map__cap-section">
      <span class="earth-map__cap-swatch earth-map__cap-swatch--venue" aria-hidden="true"></span>
      {venues.length}
      {mode === 'pins' ? 'pins' : 'venues'}
    </span>
    {
      mode === 'full' && (
        <>
          <span class="earth-map__cap-sep">·</span>
          <span class="earth-map__cap-section">
            <span class="earth-map__cap-swatch earth-map__cap-swatch--event" aria-hidden="true" />
            {worldEvents.length} world events
          </span>
          <span class="earth-map__cap-sep">·</span>
          <span class="earth-map__cap-section">
            <span
              class="earth-map__cap-swatch earth-map__cap-swatch--gdelt-pos"
              aria-hidden="true"
            />
            {dedupGdelt.length} GDELT 24h
          </span>
        </>
      )
    }
    {
      mode === 'live-data' && (
        <>
          <span class="earth-map__cap-sep">·</span>
          <span class="earth-map__cap-section">
            <span class="earth-map__cap-swatch earth-map__cap-swatch--event" aria-hidden="true" />
            {worldEvents.length} curated
          </span>
          <span class="earth-map__cap-sep">·</span>
          <span class="earth-map__cap-section">
            <span
              class="earth-map__cap-swatch earth-map__cap-swatch--gdelt-pos"
              aria-hidden="true"
            />
            <span data-live-count>live events loading</span>
          </span>
        </>
      )
    }
    <span class="earth-map__cap-note">
      {mode === 'pins' ? (
        'equirectangular · footprint'
      ) : mode === 'live-data' ? (
        <>
          data-source: <span class="earth-map__src">GDELT 2.0</span>
          <span class="earth-map__cap-sep" aria-hidden="true">·</span>
          last sync{' '}
          <time class="earth-map__sync mono" data-live-sync datetime="">
            pending
          </time>
          <span class="earth-map__cap-sep" aria-hidden="true">·</span>
          <span data-live-window>last 15min</span>
        </>
      ) : (
        'equirectangular · 24h desk coverage'
      )}
    </span>
    {/*
      === Cache freshness pill (round 1 data-pipeline fix) ===
      Surfaces GDELT cache age honestly so the visitor sees
      LIVE | STALE | STALE · Nh old instead of a static-LIVE vibe.
      chrome-contract binding: text + weight + label only — NO color
      fills, NO halo/glow (the cnv__pill convention from Converter.astro).
    */}
    {mode !== 'pins' && (
      <span
        class="earth-map__pill"
        data-gdelt-state={gdeltCacheState}
        aria-label={`GDELT cache state: ${gdeltCacheLabel}`}
      >
        <span class="earth-map__pill-dot" aria-hidden="true"></span>
        <span class="earth-map__pill-tag">{gdeltCacheLabel}</span>
        <span class="earth-map__pill-stamp mono">
          cached {cache.fetchedAt.slice(0, 10)} {cache.fetchedAt.slice(11, 19)}Z
        </span>
      </span>
    )}
  </figcaption>
</figure>

<script>
  // Live EarthMap refresh : fetch /api/worldview/gdelt every 5 min,
  // project events to viewBox coords, render circles + a hairline that
  // draws from the data-source origin to each city over 1200ms.
  // Reduced-motion safe : the hairline keyframe is no-op under
  // prefers-reduced-motion; the static line + dot still convey the
  // same information.

  type LiveEvent = {
    id: string;
    title: string;
    city: string;
    lat: number;
    lon: number;
    category: string;
    severity: string;
    source: string;
    timestamp: string;
  };

  type LiveResponse = {
    ok: true;
    events: LiveEvent[];
    lastSync: string;
  };

  const REFRESH_MS = 5 * 60 * 1000;

  function isLiveEvent(raw: unknown): raw is LiveEvent {
    if (!raw || typeof raw !== 'object') return false;
    const o = raw as Record<string, unknown>;
    return (
      typeof o.id === 'string' &&
      typeof o.title === 'string' &&
      typeof o.lat === 'number' &&
      typeof o.lon === 'number'
    );
  }

  function projectToViewBox(svg: SVGSVGElement, lat: number, lon: number): { x: number; y: number } {
    // Match the Astro frontmatter projection exactly so server-rendered
    // venues and client-rendered live events share the same map.
    const vb = svg.viewBox.baseVal;
    const width = vb.width || 720;
    const height = vb.height || 360;
    return {
      x: ((lon + 180) / 360) * width,
      y: ((90 - lat) / 180) * height,
    };
  }

  function lastSyncHHMMSS(iso: string): string {
    const m = iso.match(/T(\d{2}:\d{2}:\d{2})/);
    return m ? `${m[1]}Z` : iso;
  }

  function polarityFromSeverity(severity: string): 'pos' | 'neg' | 'neutral' {
    if (severity === 'critical') return 'neg';
    if (severity === 'mild') return 'pos';
    return 'neutral';
  }

  function renderOverlay(
    overlay: SVGGElement,
    svg: SVGSVGElement,
    events: LiveEvent[],
  ): void {
    // The "data-source origin" sits at (-150°, 0°) latlon = the western
    // edge of the Equirectangular projection, just above the equator.
    // The hairline draws from that anchor to each event's city.
    const origin = projectToViewBox(svg, 0, -150);
    overlay.innerHTML = '';
    for (const ev of events) {
      if (!Number.isFinite(ev.lat) || !Number.isFinite(ev.lon)) continue;
      const xy = projectToViewBox(svg, ev.lat, ev.lon);
      const polarity = polarityFromSeverity(ev.severity);
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('class', `earth-map__live-event earth-map__gdelt--${polarity}`);
      g.setAttribute('data-live-event', ev.id);

      // The hairline : draws over 1200ms (CSS keyframe owns the
      // animation; the static endpoint is rendered, animation
      // interpolates stroke-dashoffset from full length to 0).
      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', String(origin.x));
      line.setAttribute('y1', String(origin.y));
      line.setAttribute('x2', String(xy.x));
      line.setAttribute('y2', String(xy.y));
      line.setAttribute('class', 'earth-map__live-line');
      const dx = xy.x - origin.x;
      const dy = xy.y - origin.y;
      const len = Math.sqrt(dx * dx + dy * dy);
      line.style.setProperty('--hair-len', String(len));
      g.appendChild(line);

      // The city pin.
      const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      dot.setAttribute('cx', String(xy.x));
      dot.setAttribute('cy', String(xy.y));
      dot.setAttribute('r', '2');
      dot.setAttribute('class', `earth-map__live-dot earth-map__gdelt--${polarity}`);
      const title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
      title.textContent = `${ev.title} to ${ev.city}`;
      dot.appendChild(title);
      g.appendChild(dot);

      overlay.appendChild(g);
    }
  }

  async function refreshMap(map: HTMLElement): Promise<void> {
    const url = map.dataset.gdeltUrl;
    if (!url) return;
    const svg = map.querySelector<SVGSVGElement>('.earth-map__svg');
    const overlay = map.querySelector<SVGGElement>('[data-live-overlay]');
    const syncEl = map.querySelector<HTMLElement>('[data-live-sync]');
    const countEl = map.querySelector<HTMLElement>('[data-live-count]');
    if (!svg || !overlay) return;
    try {
      const res = await fetch(url, { headers: { Accept: 'application/json' } });
      if (!res.ok) {
        if (countEl) countEl.textContent = 'live error';
        return;
      }
      const raw: unknown = await res.json();
      const data = raw as LiveResponse;
      if (!data || data.ok !== true || !Array.isArray(data.events)) {
        if (countEl) countEl.textContent = 'live error';
        return;
      }
      const events = data.events.filter(isLiveEvent);
      renderOverlay(overlay, svg, events);
      if (syncEl) {
        const stamp = lastSyncHHMMSS(data.lastSync);
        syncEl.textContent = stamp;
        syncEl.setAttribute('datetime', data.lastSync);
      }
      if (countEl) {
        countEl.textContent = `${events.length} events in last 15min`;
      }
    } catch {
      if (countEl) countEl.textContent = 'live error';
    }
  }

  function init(): void {
    const maps = document.querySelectorAll<HTMLElement>(
      '[data-component="earth-map"][data-mode="live-data"]',
    );
    maps.forEach((map) => {
      void refreshMap(map);
      window.setInterval(() => void refreshMap(map), REFRESH_MS);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

