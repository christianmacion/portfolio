  .earth-map__star:nth-child(8n) { opacity: 0.85; }
  .earth-map__star:nth-child(8n + 1) { opacity: 0.7; }
  @keyframes star-twinkle {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 0.35; }
  }

  /* === Globe sphere outline + country borders === */
  /* v7.7.6 — sphere is filled by url(#earth-map__ocean) gradient in
     markup; CSS only declares the stroke for the limb. */
  .earth-map__sphere {
    stroke: var(--j-cobalt-3);
    stroke-opacity: 0.65;
    stroke-width: 0.7;
  }
  .earth-map__sphere-edge {
    /* The crisp outer 1px stroke at 70% opacity — declares the disc edge. */
  }
  /* v7.7.6 — continents are sage land, bordered by warm amber so the
     silhouette of Africa / Eurasia reads instantly. */
  .earth-map__country {
    fill: var(--j-sage);
    fill-opacity: 0.88;
    stroke: var(--c-primary-2-light);
    stroke-opacity: 0.65;
    stroke-width: 0.9;
    stroke-linejoin: round;
    transition: fill-opacity 120ms ease, stroke-opacity 120ms ease;
  }
  .earth-map__country:hover {
    fill-opacity: 1;
    stroke-opacity: 0.95;
  }

  /* v7.7.6 — slow auto-rotation of the countries group. The clipPath
     in markup keeps back-hemisphere countries masked, so the continents
     drift across the visible disc instead of swinging off the rim. */
  .earth-map__countries {
    transform-box: fill-box;
    transform-origin: center;
    animation: earth-rotate 240s linear infinite;
    will-change: transform;
  }
  @keyframes earth-rotate {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .earth-map__countries { animation: none; }
  }

  /* v7.7.6 — night-side dim. Drawn as a path on the sphere outline
     using a radial gradient so the day/night boundary is a real gradient
     on the limb rather than just a dashed line. */
  .earth-map__night-mask {
    fill: url(#earth-map__night);
    pointer-events: none;
    mix-blend-mode: multiply;
  }
  .earth-map__scatter {
    fill: url(#earth-map__scatter);
    pointer-events: none;
  }

  /* === Layer A — venues === */
  .earth-map__pulse {
    fill: none;
    stroke: var(--c-primary-2);
    stroke-width: 1;
    opacity: 0.4;
    animation: globe-pulse 3.6s ease-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }
  .earth-map__pulse:nth-child(1) { animation-delay: 0s; }
  .earth-map__pulse:nth-child(2) { animation-delay: 0.6s; }
  .earth-map__pulse:nth-child(3) { animation-delay: 1.2s; }
  .earth-map__dot {
    fill: var(--c-primary-2);
    stroke: var(--c-primary-2-light);
    stroke-width: 1;
  }
  .earth-map__label {
    font-size: 10px;
    fill: var(--c-ink);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* === Layer B — world events === */
  .earth-map__event-shape {
    fill: var(--c-amber-deep);
    stroke: var(--c-bg);
    stroke-width: 1;
    opacity: 0.85;
  }
  .earth-map__event--critical .earth-map__event-shape {
    fill: var(--c-amber-deep);
    opacity: 1;
  }
  .earth-map__event--moderate .earth-map__event-shape {
    fill: var(--c-amber);
    opacity: 0.78;
  }
  .earth-map__event--mild .earth-map__event-shape {
    fill: var(--c-ink-2);
    opacity: 0.6;
  }

  /* === Layer E — connection arcs === */
  .earth-map__arc {
    fill: none;
    stroke: var(--c-warn-soft);
    stroke-width: 0.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.7;
    animation: arc-draw 1.6s var(--j-ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 60ms + 800ms);
  }
  .earth-map__arc--pos { stroke: var(--c-amber); }
  .earth-map__arc--neg { stroke: var(--c-ink-3); }
  .earth-map__arc--neutral { stroke: var(--c-ink-4); }
  @keyframes arc-draw {
    to { stroke-dashoffset: 0; }
  }

  /* === Layer C — GDELT (severity-weighted, polarity-tinted) === */
  .earth-map__gdelt { stroke: none; }
  .earth-map__gdelt--pos { fill: var(--c-amber); opacity: 0.65; }
  .earth-map__gdelt--neg { fill: var(--c-ink-2); opacity: 0.55; }
  .earth-map__gdelt--neutral { fill: var(--c-ink-3); opacity: 0.4; }

  /* === Layer F — terminator === */
  .earth-map__day-wash {
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .earth-map__terminator-line {
    fill: none;
    stroke: var(--c-warn);
    stroke-width: 1.2;
    stroke-dasharray: 4, 3;
    opacity: 0.8;
    pointer-events: none;
  }
  .earth-map__subsolar { fill: var(--c-amber); stroke: var(--c-bg); stroke-width: 1; }
  .earth-map__subsolar-pulse {
    fill: none;
    stroke: var(--c-amber);
    stroke-width: 1;
    opacity: 0.5;
    transform-origin: center;
    transform-box: fill-box;
    animation: subsolar-pulse 3.6s ease-out infinite;
  }
  @keyframes subsolar-pulse {
    0%   { transform: scale(0.5); opacity: 0.7; }
    100% { transform: scale(2.4); opacity: 0; }
  }

  /* === Layer D — arXiv + WIRE markers === */
  .earth-map__live {
    stroke: var(--c-bg);
    stroke-width: 0.6;
    transition: stroke 120ms ease, stroke-width 120ms ease;
    cursor: help;
  }
  .earth-map__live--arxiv {
    fill: color-mix(in oklab, var(--c-amber) 75%, var(--c-warn) 25%);
    opacity: 0.85;
  }
  .earth-map__live--macrowire {
    fill: color-mix(in oklab, var(--c-sage) 80%, var(--c-ink) 20%);
    opacity: 0.75;
  }
  /* === hover-sync focus ring (preserved) === */
  .earth-map__live--focus,
  .earth-map__gdelt--focus {
    stroke: var(--c-amber);
    stroke-width: 2.4;
    animation: earth-marker-focus 1.2s var(--j-ease-out) forwards;
    transform-origin: center;
    transform-box: fill-box;
  }
  @keyframes earth-marker-focus {
    0%   { stroke-opacity: 0.4; transform: scale(1); }
    35%  { stroke-opacity: 1;   transform: scale(1.6); }
    100% { stroke-opacity: 0;   transform: scale(2.2); }
  }

  /* === NEW v7.7.4 HUD chrome — 4-cell KPI strip === */
  .earth-map__hud {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-tape);
  }
  .earth-map__hud-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 14px;
    border-right: 1px solid var(--c-rule-soft);
  }
  .earth-map__hud-cell:last-child {
    border-right: none;
  }
  .earth-map__hud-label {
    font-size: 9px;
    color: var(--c-ink-3);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .earth-map__hud-value {
    font-size: 13px;
    color: var(--c-ink);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
    font-weight: 600;
  }
  @media (max-width: 600px) {
    .earth-map__hud {
      grid-template-columns: repeat(2, 1fr);
    }
    .earth-map__hud-cell:nth-child(2n) {
      border-right: none;
    }
    .earth-map__hud-cell:nth-child(-n + 2) {
      border-bottom: 1px solid var(--c-rule-soft);
    }
  }

  /* === Caption (legend + last-sync, v7.7.0 vocabulary preserved) === */
  .earth-map__caption {
    font-size: 10px;
    color: var(--c-ink-2);
    padding: 12px 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    border-top: 1px solid var(--c-rule);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .earth-map__cap-section {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .earth-map__cap-swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
  }
  .earth-map__cap-swatch--venue {
    background: var(--c-primary-2);
  }
  .earth-map__cap-swatch--event {
    background: var(--c-amber-deep);
    transform: rotate(45deg);
  }
  .earth-map__cap-swatch--gdelt-pos {
    background: var(--c-amber);
    opacity: 0.6;
    border-radius: 50%;
  }
  .earth-map__cap-swatch--arc {
    background: transparent;
    border-top: 1px solid var(--c-amber);
    height: 0;
    width: 12px;
    margin-block: 4px;
  }
  .earth-map__cap-swatch--arxiv {
    background: color-mix(in oklab, var(--c-amber) 75%, var(--c-warn) 25%);
    border-radius: 50%;
    opacity: 0.85;
  }
  .earth-map__cap-swatch--wire {
    background: color-mix(in oklab, var(--c-sage) 80%, var(--c-ink) 20%);
    border-radius: 50%;
    opacity: 0.75;
  }
  .earth-map__cap-swatch--day {
    background: color-mix(in oklab, var(--c-warn) 30%, transparent);
    border: 1px dashed var(--c-warn);
    opacity: 0.6;
  }
  .earth-map__cap-term {
    color: var(--c-warn);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-left: 4px;
  }
  .earth-map__cap-section--f { color: var(--c-amber); }
  .earth-map__cap-sep { color: var(--c-ink-4); }

  /* === last-sync chrome (right-side cluster, preserved) === */
  .earth-map__cap-sync {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: var(--c-ink-2);
  }
  .earth-map__cap-badge {
    display: inline-block;
    padding: 1px 6px;
    border: 1px solid currentColor;
    font-weight: 600;
    font-size: 9px;
    letter-spacing: 0.14em;
    line-height: 1.4;
  }
  .earth-map__cap-badge--live { color: var(--c-warn); }
  .earth-map__cap-badge--fallback { color: var(--c-ink-3); }
  .earth-map__cap-sync-text { color: var(--c-ink-3); }
  .earth-map__cap-sync-ago {
    color: var(--c-ink);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
    font-weight: 600;
    min-width: 16px;
    text-align: right;
    display: inline-block;
  }
  .earth-map__cap-sync-stamp {
    color: var(--c-ink-3);
    margin-left: 6px;
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  @media (max-width: 720px) {
    .earth-map__cap-sync {
      margin-left: 0;
      flex-basis: 100%;
    }
  }

  /* === Reduced-motion guard (v7.7.0 vocabulary + new twinkle) === */
  @media (prefers-reduced-motion: reduce) {
    .earth-map__pulse,
    .earth-map__arc,
    .earth-map__subsolar-pulse,
    .earth-map__live--focus,
    .earth-map__gdelt--focus,
    .earth-map__stars {
      animation: none;
      opacity: 1;
    }
    .earth-map__stars { opacity: 0.6; }
    .earth-map__arc { stroke-dashoffset: 0; }
  }
</style>

<script>
  /**
   * earth-sync (v7.7.4 inlined) — /live row → /desk EarthMap marker focus.
   *
   * Listens for CustomEvent('earth:focus', { detail: { id } }) on `window`.
   * Any page (typically /live) dispatches this when a row is hovered. The
   * listener finds the matching EarthMap marker by its `data-event-id`
   * attribute and adds a `--focus` modifier class for 1.2s. Cross-tab sync:
   * writes the id to localStorage under `earth:focus:v1` so a /desk tab
   * can pick up a focus event emitted by a /live tab in another window.
   *
   * No framework, no deps. SSR-safe (only runs in the browser; Astro skips
   * it on the server).
   */
  const FOCUS_DURATION_MS = 1200;
  const STORAGE_KEY = 'earth:focus:v1';

  function focusMarker(id: string | null | undefined): void {
    if (!id) return;
    const svg = document.querySelector<SVGSVGElement>('.earth-map__svg');
    if (!svg) return;
    const m = svg.querySelector<SVGCircleElement>(`[data-event-id="${CSS.escape(id)}"]`);
    if (!m) return;
    m.classList.remove('earth-map__live--focus', 'earth-map__gdelt--focus');
    void m.getBoundingClientRect(); // force reflow
    if (m.classList.contains('earth-map__live')) {
      m.classList.add('earth-map__live--focus');
    } else {
      m.classList.add('earth-map__gdelt--focus');
    }
    window.setTimeout(() => {
      m.classList.remove('earth-map__live--focus', 'earth-map__gdelt--focus');
    }, FOCUS_DURATION_MS);
  }

  window.addEventListener('earth:focus', (ev) => {
    const detail = (ev as CustomEvent).detail as { id?: string } | undefined;
    if (detail?.id) {
      focusMarker(detail.id);
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({ id: detail.id, ts: Date.now() }),
        );
      } catch {
        /* ignore */
      }
    }
  });

  // Cross-tab fallback — listen for the localStorage ping from another tab.
  window.addEventListener('storage', (ev) => {
    if (ev.key !== STORAGE_KEY || !ev.newValue) return;
    try {
      const parsed = JSON.parse(ev.newValue) as { id?: string; ts?: number };
      // Drop stale events (>2s old) so a refresh doesn't replay.
      if (parsed?.id && typeof parsed.ts === 'number' && Date.now() - parsed.ts < 2000) {
        focusMarker(parsed.id);
      }
    } catch {
      /* ignore */
    }
  });
</script>
