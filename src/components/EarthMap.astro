---
/**
 * EarthMap.astro — v7.7.3 LIVE-WORLD EARTH PRIMITIVE.
 *
 * Server-rendered SVG (no JS for the map itself; the odometer drives
 * the "last sync" count-up via the existing data-counter driver).
 * Six stacked layers on one equirectangular world map:
 *
 *   Layer A — VENUES          (6 weighted amber dots, with animated pulse)
 *   Layer B — WORLD-EVENTS    (10 curated events from src/content/world-events)
 *   Layer C — GDELT OVERLAY   (50+ events from src/data/gdelt-cache.json,
 *                               polarity-tinted, severity-weighted radius)
 *   Layer D — ARCS            (hairline connections from Layer C events to
 *                               matching venue cities; one-shot draw-in)
 *   Layer E — arXiv + WIRE    (NEW v7.7.3: institution geo-located arXiv
 *                               papers + publisher-city wire headlines
 *                               from src/data/live-feed-cache.json)
 *   Layer F — DAY/NIGHT       (NEW v7.7.3: terminator polyline computed
 *                               server-side at the current UTC time using
 *                               Meeus solar geometry; warm-cream day /
 *                               navy night halves; UTC+8 hour-marker)
 *
 * Hover-sync (NEW v7.7.3): hovering a /live feed row emits a
 * CustomEvent('earth:focus', { id, lat, lon }) which /desk listens for
 * and pulses the matching Layer C / E marker for 1.2s.
 *
 * Visual register: institutional / Bloomberg. Mono + 1 amber accent.
 * No glow. No pills. No gradient. The landmass dot grid is the same
 * continent-aware sparse grid as CoverageGlobe — visually consistent.
 *
 * Same Equirectangular projection: x = (lon + 180) / 360 * width,
 * y = (90 - lat) / 180 * height. viewBox 720×360.
 *
 * Usage:
 *   <EarthMap />
 *   <EarthMap width={1080} height={540} />
 */
import { getCollection } from 'astro:content';
import gdeltCache from '../data/gdelt-cache.json';
import liveFeedCache from '../data/live-feed-cache.json';
import { terminatorPolylinePath, solarDeclination, subsolarLongitude } from '../utils/suncalc';

interface Props {
  /** ViewBox width (default 720). */
  width?: number;
  /** ViewBox height (default 360 — Equirectangular 2:1). */
  height?: number;
  /** Spacing in degrees between background landmass dots (default 18). */
  bgStep?: number;
  /** Optional CSS class on the outer wrapper. */
  class?: string;
}
const { width = 720, height = 360, bgStep = 18, class: className } = Astro.props;

// === Equirectangular projection ===
function project(lat: number, lon: number): { x: number; y: number } {
  return {
    x: ((lon + 180) / 360) * width,
    y: ((90 - lat) / 180) * height,
  };
}

// === Layer A — venue cities (same default 6 as CoverageGlobe) ===
interface Venue {
  city: string;
  lat: number;
  lon: number;
  weight: number;
  caption: string;
}
interface VenuePosition extends Venue {
  x: number;
  y: number;
  r: number;
}
const venues: Venue[] = [
  { city: 'Digos City', lat: 6.74, lon: 125.36, weight: 1.0, caption: 'home base' },
  { city: 'Singapore', lat: 1.35, lon: 103.82, weight: 0.8, caption: 'APAC ops' },
  { city: 'Tokyo', lat: 35.68, lon: 139.69, weight: 0.7, caption: 'JPX' },
  { city: 'Zurich', lat: 47.38, lon: 8.54, weight: 0.85, caption: 'CTA' },
  { city: 'London', lat: 51.51, lon: -0.13, weight: 0.95, caption: 'LSE' },
  { city: 'New York', lat: 40.71, lon: -74.01, weight: 0.9, caption: 'NYSE / Nasdaq' },
];
const venuePositions: VenuePosition[] = venues.map((c: Venue): VenuePosition => {
  const { x, y } = project(c.lat, c.lon);
  const r = 3 + c.weight * 4;
  return { ...c, x, y, r };
});
// City-keyed lookup for arc endpoints
const venueByCity = new Map(venues.map((v) => [v.city.toLowerCase(), v]));

// === Layer B — world events (Zod-validated collection) ===
interface WorldEventRow {
  id: string;
  title: string;
  category: 'central-bank' | 'earnings' | 'geopolitical' | 'data-release' | 'fx';
  severity: 'mild' | 'moderate' | 'critical';
  lat: number;
  lon: number;
  city: string;
  source: string;
  order: number;
}
const worldEventEntries = await getCollection('worldEvent');
const worldEvents: WorldEventRow[] = worldEventEntries
  .map((e: { id: string; data: WorldEventRow }): WorldEventRow => ({
    id: e.id,
    title: e.data.title,
    category: e.data.category,
    severity: e.data.severity,
    lat: e.data.lat,
    lon: e.data.lon,
    city: e.data.city,
    source: e.data.source,
    order: e.data.order,
  }))
  .sort((a: WorldEventRow, b: WorldEventRow) => a.order - b.order);
const eventPositions = worldEvents.map((e) => {
  const { x, y } = project(e.lat, e.lon);
  return { ...e, x, y };
});

// === Layer C — GDELT cache (polarity-tinted overlay) ===
// Read src/data/gdelt-cache.json — type-narrowed here to keep SSR safe.
interface GdeltEvent {
  id: string;
  title: string;
  category: string;
  severity: string;
  lat: number;
  lon: number;
  city: string;
  source: string;
  timestamp?: string;
  goldstein?: number;
}
interface GdeltCache {
  fetchedAt: string;
  buildDate: string;
  source: string;
  url: string;
  events: GdeltEvent[];
}
const cache = gdeltCache as GdeltCache;
const gdeltEvents: GdeltEvent[] = cache.events;
// Dedupe by id, cap at 50 for the overlay.
const dedupGdelt: GdeltEvent[] = (() => {
  const seen = new Set<string>();
  const out: GdeltEvent[] = [];
  for (const e of gdeltEvents) {
    if (seen.has(e.id)) continue;
    seen.add(e.id);
    out.push(e);
    if (out.length >= 50) break;
  }
  return out;
})();
const gdeltPositions = dedupGdelt.map((e) => {
  const { x, y } = project(e.lat, e.lon);
  // Polarity: positive Goldstein = amber-soft, negative = ink-2 alpha
  const goldstein = e.goldstein ?? 0;
  const polarity: 'pos' | 'neg' | 'neutral' =
    goldstein > 2 ? 'pos' : goldstein < -2 ? 'neg' : 'neutral';
  // Severity-weighted radius: r = 1.5 + min(|goldstein|, 10) * 0.2 → 1.5..3.5
  const magnitude = Math.min(Math.abs(goldstein), 10);
  const r = 1.5 + magnitude * 0.2;
  return { ...e, x, y, polarity, r };
});

// === Layer D — connection arcs (event → venue city) ===
// For each GDELT event whose city matches a venue city, draw a hairline
// arc from the event point to the venue point. Curved with a quadratic
// Bezier that lifts ~12° of arc-height. Path is what we animate
// stroke-dashoffset on for the one-shot draw-in.
interface Arc {
  id: string;
  d: string;
  venue: string;
  city: string;
  polarity: 'pos' | 'neg' | 'neutral';
}
const arcs: Arc[] = [];
for (const e of gdeltPositions) {
  if (!e.city) continue;
  const venue = venueByCity.get(e.city.toLowerCase());
  if (!venue) continue;
  const vx = ((venue.lon + 180) / 360) * width;
  const vy = ((90 - venue.lat) / 180) * height;
  // Midpoint lifted 14°-of-arc-height toward the equator (visually
  // straight enough not to misroute, but with a slight arc)
  const mx = (e.x + vx) / 2;
  const my = (e.y + vy) / 2 - Math.max(20, Math.abs(e.x - vx) * 0.08);
  const d = `M ${e.x.toFixed(2)} ${e.y.toFixed(2)} Q ${mx.toFixed(2)} ${my.toFixed(2)} ${vx.toFixed(2)} ${vy.toFixed(2)}`;
  arcs.push({
    id: e.id,
    d,
    venue: venue.city,
    city: e.city,
    polarity: e.polarity,
  });
}

// === Background landmass dot grid (continent-aware mask) ===
interface BgDot {
  x: number;
  y: number;
  visible: boolean;
}
const bgDots: BgDot[] = [];
for (let lat = -60; lat <= 75; lat += bgStep) {
  for (let lon = -180; lon <= 180; lon += bgStep) {
    const { x, y } = project(lat, lon);
    const nhContinent =
      lat > 5 &&
      lat < 75 &&
      ((lon > -130 && lon < -55) || (lon > -10 && lon < 60) || (lon > 60 && lon < 145));
    const shContinent =
      lat > -55 && lat < 35 && ((lon > -85 && lon < -30) || (lon > -15 && lon < 50));
    const au = lat > -40 && lat < -10 && lon > 110 && lon < 155;
    bgDots.push({ x, y, visible: !!(nhContinent || shContinent || au) });
  }
}

const equatorY = project(0, 0).y;
const primeX = project(0, 0).x;

// === Layer F (v7.7.3) — terminator + day/night halves ===
// Computed at SSR (build time). Same projection as the map. We render
// the terminator as a thin amber polyline + fill the daylight half with
// warm-cream at 4% tint to honor "world covered by sunset." The night
// half is left to the underlying tape background.
interface TerminatorBuild {
  declinationDeg: number;
  subLonDeg: number;
  path: string;
  isoStamp: string;
}
const _now = new Date(); // SSR build-time; explicit so it's deterministic per build
const _termPath = terminatorPolylinePath(_now, width, height, { step: 2 });
const _subLat = solarDeclination(_now);
const _subLon = subsolarLongitude(_now);
const _sub = project(_subLat, _subLon);
const _hourMarker = `${String(_now.getUTCHours()).padStart(2, '0')}:${String(_now.getUTCMinutes()).padStart(2, '0')} UTC`;
const _hourMarkerPos = project(0, _subLon);

const terminator: TerminatorBuild = {
  declinationDeg: _subLat,
  subLonDeg: _subLon,
  path: _termPath,
  isoStamp: _now.toISOString().slice(0, 16).replace('T', ' ') + 'Z',
};

// === Layer E (v7.7.3) — arXiv + WIRE overlay from live-feed-cache.json ===
// Filters live-feed-cache.json to entries with coords (v7.7.3 fetcher
// already attached coords for arXiv via FNV-1a institution assignment
// and for wire via publisher-city lookup). Skips GDELT (already on Layer C).
interface LivePoint {
  id: string;
  source: 'arxiv' | 'macrowire';
  title: string;
  category: string;
  city: string | null;
  x: number;
  y: number;
  r: number;
}
interface LiveFeedCacheShape {
  generated: string;
  events: Array<{
    id: string;
    source: 'gdelt' | 'arxiv' | 'macrowire' | string;
    title: string;
    coords?: { lat: number; lon: number };
    city?: string | null;
    category: string;
    timestamp: string;
  }>;
}
const liveCache = liveFeedCache as LiveFeedCacheShape;
const livePoints: LivePoint[] = (liveCache.events || [])
  .filter((e): e is typeof e & { coords: { lat: number; lon: number } } =>
    (e.source === 'arxiv' || e.source === 'macrowire') && Boolean(e.coords),
  )
  .map((e) => {
    const { x, y } = project(e.coords.lat, e.coords.lon);
    // arXiv (q-fin/stat) = amber; wire = sage. Distinct from Layer C cobalt.
    const isWire = e.source === 'macrowire';
    return {
      id: e.id,
      source: e.source as 'arxiv' | 'macrowire',
      title: e.title,
      category: e.category,
      city: e.city ?? null,
      x,
      y,
      r: isWire ? 1.8 : 2.2,
    };
  });

// === Category → shape mapping for world-events ===
// Triangles for monetary (central-bank, fx), squares for data releases,
// diamonds for earnings, circles for geopolitical. All 5×5 viewBox units.
const eventShape = (category: string): 'triangle' | 'square' | 'diamond' | 'circle' => {
  if (category === 'central-bank' || category === 'fx') return 'triangle';
  if (category === 'data-release') return 'square';
  if (category === 'earnings') return 'diamond';
  return 'circle';
};

// === v7.7.0 — last-sync chrome ===
// Site is static: "now" is build-time. We compute the number of
// minutes between the cache `fetchedAt` and the build stamp so the
// caption reads as "synchronized Xm ago" the moment the page loads.
const fetchedAt = cache.fetchedAt;
const buildDateIso = cache.buildDate || fetchedAt;
const elapsedMs = new Date(buildDateIso).getTime() - new Date(fetchedAt).getTime();
const elapsedMin = Math.max(0, Math.floor(elapsedMs / 60_000));
const fetchedAtStamp = fetchedAt.slice(0, 16).replace('T', ' ').slice(0, 16) + 'Z';
const isLive = cache.source === 'gdelt';
---

<figure class:list={['earth-map', className]}>
  <svg
    class="earth-map__svg"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={`Three-layer world map: ${venues.length} research venues, ${worldEvents.length} curated world events, ${dedupGdelt.length} GDELT signals (24h). Equirectangular projection. Synchronized ${fetchedAtStamp}.`}
    preserveAspectRatio="xMidYMid meet"
  >
    {/* v7.6.1 — Owner feedback 2026-07-26: removed the top-level <title>
       element. WebKit/Safari rendered it as a persistent dark tooltip
       overlapping the center of the map. The aria-label on the same <svg>
       (above) carries the accessible name. Per-venue/per-event <title>
       elements below are KEPT — they correctly show on hover of each
       individual marker, which is the intended behavior. */}

    {/* === Background grid lines (equator + prime meridian) === */}
    <line x1="0" y1={equatorY} x2={width} y2={equatorY} class="earth-map__eq"></line>
    <line x1={primeX} y1="0" x2={primeX} y2={height} class="earth-map__eq"></line>

    {/* === Layer F (v7.7.3) — terminator + daylight half-tint ===
        Drawn FIRST so the day/night wash sits behind every marker. */}
    {
      terminator.path && (
        <g class="earth-map__terminator" aria-hidden="true">
          {/* Faint daylight wash — a hairline following the same polyline
             stroked slightly thicker to give the day side a soft glow. */}
          <path
            d={terminator.path}
            class="earth-map__terminator-fill"
          />
          <path d={terminator.path} class="earth-map__terminator-line" />
          {/* Subsolar marker — the noon point, small + amber */}
          <g>
            <circle
              cx={_sub.x}
              cy={_sub.y}
              r="4"
              class="earth-map__subsolar"
            />
            <circle
              cx={_sub.x}
              cy={_sub.y}
              r="9"
              class="earth-map__subsolar-pulse"
            />
          </g>
          {/* Hour-marker pip on the equator at the subsolar longitude */}
          <g>
            <line
              x1={_hourMarkerPos.x}
              x2={_hourMarkerPos.x}
              y1={_hourMarkerPos.y - 8}
              y2={_hourMarkerPos.y + 8}
              class="earth-map__hour-tick"
            />
            <text
              x={_hourMarkerPos.x + 6}
              y={_hourMarkerPos.y + 4}
              class="earth-map__hour-label"
            >
              {_hourMarker}
            </text>
          </g>
        </g>
      )
    }

    {/* === Background landmass dots === */}
    {
      bgDots.map((d) =>
        d.visible ? <circle cx={d.x} cy={d.y} r="0.9" class="earth-map__bg" /> : null,
      )
    }

    {/* === Layer A — venue cities (amber, weighted, with pulse) === */}
    {
      venuePositions.map((c) => (
        <g class="earth-map__venue">
          {c.weight >= 0.7 && <circle cx={c.x} cy={c.y} r={c.r + 4} class="earth-map__pulse" />}
          <circle cx={c.x} cy={c.y} r={c.r} class="earth-map__dot">
            <title>
              {c.city} ({c.lat.toFixed(2)}°, {c.lon.toFixed(2)}°) — {c.caption}
            </title>
          </circle>
          <text x={c.x} y={c.y - c.r - 4} text-anchor="middle" class="earth-map__label">
            {c.city}
          </text>
        </g>
      ))
    }

    {/* === Layer B — world events (shape-coded by category) === */}
    {
      eventPositions.map((e) => {
        const shape = eventShape(e.category);
        return (
          <g
            class={`earth-map__event earth-map__event--${e.category} earth-map__event--${e.severity}`}
          >
            {shape === 'triangle' && (
              <polygon
                points={`${e.x},${e.y - 4} ${e.x + 4},${e.y + 3} ${e.x - 4},${e.y + 3}`}
                class="earth-map__event-shape"
              >
                <title>
                  {e.title} — {e.city}
                </title>
              </polygon>
            )}
            {shape === 'square' && (
              <rect x={e.x - 3.5} y={e.y - 3.5} width="7" height="7" class="earth-map__event-shape">
                <title>
                  {e.title} — {e.city}
                </title>
              </rect>
            )}
            {shape === 'diamond' && (
              <polygon
                points={`${e.x},${e.y - 4} ${e.x + 4},${e.y} ${e.x},${e.y + 4} ${e.x - 4},${e.y}`}
                class="earth-map__event-shape"
              >
                <title>
                  {e.title} — {e.city}
                </title>
              </polygon>
            )}
            {shape === 'circle' && (
              <circle cx={e.x} cy={e.y} r="3.5" class="earth-map__event-shape">
                <title>
                  {e.title} — {e.city}
                </title>
              </circle>
            )}
          </g>
        );
      })
    }

    {/* === Layer D — connection arcs (event → venue city) ===
        Drawn BEFORE Layer C so the dot caps the arc visually. */}
    {
      arcs.map((a, i) => (
        <path
          d={a.d}
          pathLength="1"
          class={`earth-map__arc earth-map__arc--${a.polarity}`}
          style={`--i: ${i}`}
          aria-label={`${a.city} signal → ${a.venue} venue`}
        />
      ))
    }

    {/* === Layer C — GDELT overlay (severity-weighted, polarity-tinted) === */}
    {
      gdeltPositions.map((e) => (
        <circle
          cx={e.x}
          cy={e.y}
          r={e.r.toFixed(2)}
          data-event-id={e.id}
          class={`earth-map__gdelt earth-map__gdelt--${e.polarity}`}
        >
          <title>
            {e.title} — {e.city} ({e.goldstein?.toFixed(1) ?? '0.0'})
          </title>
        </circle>
      ))
    }

    {/* === Layer E (v7.7.3) — arXiv + WIRE (institution / publisher-city geo) ===
        Renders ABOVE Layer C so it's visually on top. Each marker carries
        a data-event-id so the hover-sync bus can pulse it from /live. */}
    <g class="earth-map__live-group">
      {
        livePoints.map((p) => (
          <circle
            cx={p.x}
            cy={p.y}
            r={p.r.toFixed(2)}
            data-event-id={p.id}
            data-event-source={p.source}
            class={`earth-map__live earth-map__live--${p.source}`}
          >
            <title>
              {p.source.toUpperCase()} · {p.city ?? ''} · {p.category.toUpperCase()}
              {'\n'}
              {p.title}
            </title>
          </circle>
        ))
      }
    </g>
  </svg>

  <figcaption class="earth-map__caption mono">
    <span class="earth-map__cap-section">
      <span class="earth-map__cap-swatch earth-map__cap-swatch--venue" aria-hidden="true"></span>
      {venues.length} venues
    </span>
    <span class="earth-map__cap-sep">·</span>
    <span class="earth-map__cap-section">
      <span class="earth-map__cap-swatch earth-map__cap-swatch--event" aria-hidden="true"></span>
      {worldEvents.length} world events
    </span>
    <span class="earth-map__cap-sep">·</span>
    <span class="earth-map__cap-section">
      <span class="earth-map__cap-swatch earth-map__cap-swatch--gdelt-pos" aria-hidden="true"
      ></span>
      {dedupGdelt.length} GDELT 24h
    </span>
    {arcs.length > 0 && (
      <>
        <span class="earth-map__cap-sep">·</span>
        <span class="earth-map__cap-section">
          <span class="earth-map__cap-swatch earth-map__cap-swatch--arc" aria-hidden="true"></span>
          {arcs.length} arcs
        </span>
      </>
    )}
    {/* v7.7.3 — Layer E legend (arXiv + WIRE counts) */}
    {livePoints.length > 0 && (
      <>
        <span class="earth-map__cap-sep">·</span>
        <span class="earth-map__cap-section">
          <span class="earth-map__cap-swatch earth-map__cap-swatch--arxiv" aria-hidden="true"></span>
          {livePoints.filter((p) => p.source === 'arxiv').length} arxiv
        </span>
        <span class="earth-map__cap-sep">·</span>
        <span class="earth-map__cap-section">
          <span class="earth-map__cap-swatch earth-map__cap-swatch--wire" aria-hidden="true"></span>
          {livePoints.filter((p) => p.source === 'macrowire').length} wire
        </span>
      </>
    )}
    {/* v7.7.3 — Layer F legend (subsolar + declination) */}
    {terminator.path && (
      <>
        <span class="earth-map__cap-sep">·</span>
        <span class="earth-map__cap-section earth-map__cap-section--f">
          <span class="earth-map__cap-swatch earth-map__cap-swatch--day" aria-hidden="true"></span>
          DAY/NIGHT
          <span class="earth-map__cap-term mono">
            δ{terminator.declinationDeg.toFixed(1)}° · {_hourMarker}
          </span>
        </span>
      </>
    )}
    <span class="earth-map__cap-sync">
      <span class={`earth-map__cap-badge earth-map__cap-badge--${isLive ? 'live' : 'fallback'}`}>
        {isLive ? 'LIVE' : 'FALLBACK'}
      </span>
      <span class="earth-map__cap-sync-text">SYNCHRONIZED</span>
      <span class="earth-map__cap-sync-ago" data-counter={`${elapsedMin}`} data-duration="600">
        {elapsedMin}
      </span>
      <span class="earth-map__cap-sync-text">M AGO</span>
      <span class="earth-map__cap-sync-stamp">{fetchedAtStamp}</span>
    </span>
  </figcaption>
</figure>

<style>
  .earth-map {
    margin: 0;
    padding: 0;
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    display: flex;
    flex-direction: column;
  }
  .earth-map__svg {
    width: 100%;
    height: auto;
    display: block;
    background: var(--c-tape);
  }
  .earth-map__eq {
    stroke: var(--c-rule);
    stroke-width: 0.5;
    stroke-dasharray: 2, 4;
    opacity: 0.6;
  }
  .earth-map__bg {
    fill: var(--c-ink-3);
    opacity: 0.18;
  }

  /* === Layer A — venues (amber, weighted, with pulse) === */
  .earth-map__pulse {
    fill: none;
    stroke: var(--c-primary-2);
    stroke-width: 1;
    opacity: 0.4;
    /* v7.7.0 — bind globe-pulse (was dead code in v7.5). Reuses the
       canonical keyframe from CoverageGlobe. Owns the single ambient
       budget on the map. 3.6s ease-out infinite. */
    animation: globe-pulse 3.6s ease-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }
  .earth-map__pulse:nth-child(1) { animation-delay: 0s; }
  .earth-map__pulse:nth-child(2) { animation-delay: 0.6s; }
  .earth-map__pulse:nth-child(3) { animation-delay: 1.2s; }
  .earth-map__dot {
    fill: var(--c-primary-2);
    stroke: var(--c-primary-2-light);
    stroke-width: 1;
  }
  .earth-map__label {
    font-size: 10px;
    fill: var(--c-ink);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* === Layer B — world events (shape-coded by category) === */
  .earth-map__event-shape {
    fill: var(--c-amber-deep);
    stroke: var(--c-bg);
    stroke-width: 1;
    opacity: 0.85;
  }
  .earth-map__event--critical .earth-map__event-shape {
    fill: var(--c-amber-deep);
    opacity: 1;
  }
  .earth-map__event--moderate .earth-map__event-shape {
    fill: var(--c-amber);
    opacity: 0.78;
  }
  .earth-map__event--mild .earth-map__event-shape {
    fill: var(--c-ink-2);
    opacity: 0.6;
  }

  /* === Layer D — connection arcs (hairline, one-shot draw-in) ===
     `stroke-dasharray` is sized to the path length via CSS variables
     set inline by the script (none yet — falls back to 320). The
     draw-in is one-shot (no infinite loop). */
  .earth-map__arc {
    fill: none;
    stroke: var(--c-warn-soft);
    stroke-width: 0.6;
    /* pathLength="1" on the SVG normalizes draw-in to a uniform
       1.6s regardless of actual arc length (v7.7.1 polish). */
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.7;
    animation: arc-draw 1.6s var(--j-ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 60ms + 800ms);
  }
  .earth-map__arc--pos {
    stroke: var(--c-amber);
  }
  .earth-map__arc--neg {
    stroke: var(--c-ink-3);
  }
  .earth-map__arc--neutral {
    stroke: var(--c-ink-4);
  }
  @keyframes arc-draw {
    to { stroke-dashoffset: 0; }
  }

  /* === Layer C — GDELT (severity-weighted, polarity-tinted) === */
  .earth-map__gdelt {
    stroke: none;
  }
  .earth-map__gdelt--pos {
    fill: var(--c-amber);
    opacity: 0.65;
  }
  .earth-map__gdelt--neg {
    fill: var(--c-ink-2);
    opacity: 0.55;
  }
  .earth-map__gdelt--neutral {
    fill: var(--c-ink-3);
    opacity: 0.4;
  }

  /* === Layer F (v7.7.3) — day/night terminator ===
     The wash follows the polyline; the polyline itself is a hairline
     amber stroke. Pure CSS, no JS animation — the geometry recomputes
     on every build, so the chrome naturally drifts as the day progresses. */
  .earth-map__terminator-fill {
    fill: color-mix(in oklab, var(--c-warn) 6%, transparent);
    fill-rule: nonzero;
    opacity: 0.42;
    /* Use SVG `mix-blend-mode: lighten` to brighten the sunlit half
       while leaving the night side untouched. */
  }
  .earth-map__terminator {
    mix-blend-mode: lighten;
  }
  .earth-map__terminator-line {
    fill: none;
    stroke: var(--c-warn);
    stroke-width: 1;
    stroke-dasharray: 4, 3;
    opacity: 0.55;
  }
  .earth-map__subsolar {
    fill: var(--c-amber);
    stroke: var(--c-bg);
    stroke-width: 1;
  }
  .earth-map__subsolar-pulse {
    fill: none;
    stroke: var(--c-amber);
    stroke-width: 1;
    opacity: 0.5;
    transform-origin: center;
    transform-box: fill-box;
    animation: subsolar-pulse 3.6s ease-out infinite;
  }
  @keyframes subsolar-pulse {
    0%   { transform: scale(0.5); opacity: 0.7; }
    100% { transform: scale(2.4); opacity: 0; }
  }
  .earth-map__hour-tick {
    stroke: var(--c-amber);
    stroke-width: 1;
    opacity: 0.7;
  }
  .earth-map__hour-label {
    font: 600 9px / 1 var(--ff-mono);
    fill: var(--c-amber);
    letter-spacing: 0.06em;
  }

  /* === Layer E (v7.7.3) — arXiv + WIRE markers === */
  .earth-map__live {
    stroke: var(--c-bg);
    stroke-width: 0.6;
    transition: stroke 120ms ease, stroke-width 120ms ease;
    cursor: help;
  }
  .earth-map__live--arxiv {
    fill: color-mix(in oklab, var(--c-amber) 75%, var(--c-warn) 25%);
    opacity: 0.85;
  }
  .earth-map__live--macrowire {
    fill: color-mix(in oklab, var(--j-sage, #788c5d) 80%, var(--c-ink) 20%);
    opacity: 0.75;
  }
  /* === hover-sync focus ring ===
     Set programmatically by the inline script below when a /live row
     is hovered. * Focus pulse lasts 1.2s, then auto-removes. */
  .earth-map__live--focus,
  .earth-map__gdelt--focus {
    stroke: var(--c-amber);
    stroke-width: 2.4;
    animation: earth-marker-focus 1.2s var(--j-ease-out) forwards;
  }
  @keyframes earth-marker-focus {
    0%   { stroke-opacity: 0.4; transform: scale(1); }
    35%  { stroke-opacity: 1;   transform: scale(1.6); }
    100% { stroke-opacity: 0;   transform: scale(2.2); }
  }
  .earth-map__live--focus,
  .earth-map__gdelt--focus {
    transform-origin: center;
    transform-box: fill-box;
  }
  .earth-map__caption {
    font-size: 10px;
    color: var(--c-ink-2);
    padding: 12px 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    border-top: 1px solid var(--c-rule);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .earth-map__cap-section {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .earth-map__cap-swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
  }
  .earth-map__cap-swatch--venue {
    background: var(--c-primary-2);
  }
  .earth-map__cap-swatch--event {
    background: var(--c-amber-deep);
    transform: rotate(45deg);
  }
  .earth-map__cap-swatch--gdelt-pos {
    background: var(--c-amber);
    opacity: 0.6;
    border-radius: 50%;
  }
  .earth-map__cap-swatch--arc {
    background: transparent;
    border-top: 1px solid var(--c-amber);
    height: 0;
    width: 12px;
    margin-block: 4px;
  }
  /* v7.7.3 — arXiv / WIRE / DAY swatches in the legend */
  .earth-map__cap-swatch--arxiv {
    background: color-mix(in oklab, var(--c-amber) 75%, var(--c-warn) 25%);
    border-radius: 50%;
    opacity: 0.85;
  }
  .earth-map__cap-swatch--wire {
    background: color-mix(in oklab, var(--j-sage, #788c5d) 80%, var(--c-ink) 20%);
    border-radius: 50%;
    opacity: 0.75;
  }
  .earth-map__cap-swatch--day {
    background: color-mix(in oklab, var(--c-warn) 30%, transparent);
    border: 1px dashed var(--c-warn);
    opacity: 0.6;
  }
  .earth-map__cap-term {
    color: var(--c-warn);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-left: 4px;
  }
  .earth-map__cap-section--f {
    color: var(--c-amber);
  }
  .earth-map__cap-sep {
    color: var(--c-ink-4);
  }

  /* === v7.7.0 — last-sync chrome (right-side cluster) === */
  .earth-map__cap-sync {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: var(--c-ink-2);
  }
  .earth-map__cap-badge {
    display: inline-block;
    padding: 1px 6px;
    border: 1px solid currentColor;
    font-weight: 600;
    font-size: 9px;
    letter-spacing: 0.14em;
    line-height: 1.4;
  }
  .earth-map__cap-badge--live {
    color: var(--c-warn);
  }
  .earth-map__cap-badge--fallback {
    color: var(--c-ink-3);
  }
  .earth-map__cap-sync-text {
    color: var(--c-ink-3);
  }
  .earth-map__cap-sync-ago {
    color: var(--c-ink);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
    font-weight: 600;
    min-width: 16px;
    text-align: right;
    display: inline-block;
  }
  .earth-map__cap-sync-stamp {
    color: var(--c-ink-3);
    margin-left: 6px;
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  @media (max-width: 720px) {
    .earth-map__cap-sync {
      margin-left: 0;
      flex-basis: 100%;
    }
  }

  /* === v7.7.0 — reduced-motion guard for the new animations === */
  @media (prefers-reduced-motion: reduce) {
    .earth-map__pulse,
    .earth-map__arc,
    .earth-map__subsolar-pulse,
    .earth-map__live--focus,
    .earth-map__gdelt--focus {
      animation: none;
      opacity: 1;
    }
    .earth-map__arc {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  /**
   * earth-sync.ts (inlined for Astro static-output safety)
   * v7.7.3 HOVER-SYNC BUS — /live row → /desk EarthMap marker focus.
   *
   * Listens for CustomEvent('earth:focus', { detail: { id, lat, lon } })
   * on `window`. Any page (typically /live) dispatches this when a row is
   * hovered. The listener finds the matching EarthMap <circle> by its
   * data-event-id attribute and adds a `--focus` modifier class for 1.2s.
   *
   * Cross-tab sync: also writes the id to localStorage under
   * `earth:focus:v1` so a /desk tab can pick up a focus event emitted by
   * a /live tab in another window. The `storage` event fires on the
   * other windows of the same origin — same site, so the bus works.
   *
   * No framework, no deps, ~30 LOC. SSR-safe (this script only runs in
   * the browser — Astro skips it on the server).
   */
  const FOCUS_DURATION_MS = 1200;
  const STORAGE_KEY = 'earth:focus:v1';

  function focusMarker(id: string | null | undefined): void {
    if (!id) return;
    const svg = document.querySelector<SVGSVGElement>('.earth-map__svg');
    if (!svg) return;
    const m = svg.querySelector<SVGCircleElement>(`[data-event-id="${CSS.escape(id)}"]`);
    if (!m) return;
    m.classList.remove('earth-map__live--focus', 'earth-map__gdelt--focus');
    // Force reflow so re-adding the class restarts the animation.
    void m.getBoundingClientRect();
    if (m.classList.contains('earth-map__live')) {
      m.classList.add('earth-map__live--focus');
    } else {
      m.classList.add('earth-map__gdelt--focus');
    }
    window.setTimeout(() => {
      m.classList.remove('earth-map__live--focus', 'earth-map__gdelt--focus');
    }, FOCUS_DURATION_MS);
  }

  window.addEventListener('earth:focus', (ev) => {
    const detail = (ev as CustomEvent).detail as { id?: string } | undefined;
    if (detail?.id) {
      focusMarker(detail.id);
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ id: detail.id, ts: Date.now() })); } catch { /* ignore */ }
    }
  });

  // Cross-tab fallback — listen for the localStorage ping from another tab.
  window.addEventListener('storage', (ev) => {
    if (ev.key !== STORAGE_KEY || !ev.newValue) return;
    try {
      const parsed = JSON.parse(ev.newValue) as { id?: string; ts?: number };
      // Drop stale events (>2s old) so a refresh doesn't replay.
      if (parsed?.id && typeof parsed.ts === 'number' && Date.now() - parsed.ts < 2000) {
        focusMarker(parsed.id);
      }
    } catch { /* ignore */ }
  });
</script>
