---
/**
 * EarthMap.astro — v7.7.4 ORTHOGRAPHIC GLOBE.
 *
 * Bloomberg-Terminal-meets-NASA-SVS. Six stacked layers on a single
 * orthographic globe (600×600 viewBox) rotated to [-30°, 15°] so it
 * frames Eurasia + Africa:
 *
 *   - Atmospheric chrome: cream/navy radial wash + 96-seeded star dots
 *     outside the globe mask + cobalt atmospheric glow ring (no halo).
 *   - Layer 0 — Globe sphere outline + country borders (pre-projected
 *     dGlobe paths imported from src/data/world-map-paths.ts).
 *   - Layer A — Venue cities (6 weighted amber dots, with pulse).
 *   - Layer B — World events (10 curated events, shape-coded by category).
 *   - Layer C — GDELT overlay (50 polarity-tinted signals; data-event-id
 *     preserved for the hover-sync bus).
 *   - Layer D — arXiv + WIRE (institution / publisher-city geo markers;
 *     data-event-id preserved for the hover-sync bus).
 *   - Layer F — Terminator: re-projected through orthographicProject
 *     with the GLOBE_CENTER rotation. Fill polygon + dashed boundary +
 *     subsolar pulse + UTC hour label.
 *
 * All markers projected through orthographicProject() with the GLOBE_CENTER
 * rotation; back-side markers (angle > 90°) are dropped.
 *
 * Visual register: institutional / Bloomberg. Mono + 1 amber accent.
 * No glow. No pills. No gradient-as-pivot. No halo box-shadow on the chrome.
 *
 * Below the SVG sits a 4-cell KPI strip (HTML): SUBSOLAR · DECLINATION ·
 * UTC CLOCK · DAY/NIGHT split.
 *
 * Hover-sync: CustomEvent('earth:focus') listener preserved. /live rows
 * dispatch the event with the matching id; this component pulses the
 * matching Layer C / D marker for 1.2s. data-event-id attrs preserved.
 *
 * Usage:
 *   <EarthMap />
 *   <EarthMap width={600} height={600} />
 */
import { getCollection } from 'astro:content';
import gdeltCache from '../data/gdelt-cache.json';
import liveFeedCache from '../data/live-feed-cache.json';
import { INSTITUTIONS } from '../data/institutions';
import { GLOBE_VIEW, GLOBE_CENTER, GLOBE_SPHERE_D } from '../data/world-map-paths';
import {
  solarDeclination,
  subsolarLongitude,
  orthographicProject,
  terminatorOrthographicArcPath,
  terminatorOrthographicPath,
} from '../utils/suncalc';

interface Props {
  /** ViewBox width (default 600 — orthographic globe square). */
  width?: number;
  /** ViewBox height (default 600 — square matches the globe). */
  height?: number;
  /** Optional CSS class on the outer wrapper. */
  class?: string;
}
const { width = GLOBE_VIEW, height = GLOBE_VIEW, class: className } = Astro.props;

/* === Globe geometry constants =====================================
 * GLOBE_RADIUS, GLOBE_CX, GLOBE_CY derived from the world-map-paths.ts
 * sphere outline (the precomputed path is a unit sphere of radius ~275
 * centered at (325, 325) inside a 600×600 viewBox). We mirror that here
 * so layers + markers + atmospheric chrome stay concentric. */
const GLOBE_RADIUS = 275;
const GLOBE_CX = GLOBE_VIEW / 2; // 300
const GLOBE_CY = GLOBE_VIEW / 2; // 300
const GLOBE_ROT = { lambda: GLOBE_CENTER[0], phi: GLOBE_CENTER[1] };

/* === FNV-1a hash ===========================================================
 * Tiny deterministic 32-bit hash used to scatter the star-field dots in
 * stable positions across builds. (No Math.random / Date.now in deterministic
 * output.) Returns [0, 1) — multiply by `range` to scale to any output. */
const fnv1a = (n: number): number => {
  let h = 0x811c9dc5;
  let x = n >>> 0;
  for (let i = 0; i < 4; i++) {
    h ^= x & 0xff;
    h = Math.imul(h, 0x01000193);
    x >>>= 8;
  }
  // Map to [0, 1) — use only the upper 24 bits so it's strictly positive.
  return ((h >>> 8) & 0xffffff) / 0x1000000;
};

/* === Layer 0 — countries (pre-projected globe paths) ======================
 * v7.9 split — paths are loaded client-side from /data/world-map-ortho.json.
 * At SSR we only render the empty target group; the <script> at the bottom
 * of this file fetches the JSON and populates the DOM. This keeps the heavy
 * 1.05 MB path array out of the prerendered HTML. */

/** Public country facts used by the focus HUD. The atlas supplies geometry
 * and centroids; this compact table supplies human-readable institutional
 * context without adding a runtime geography dependency. (v7.9 — moved into
 * the client-side loader so it ships once and the prerendered HTML stays
 * small. Referenced via the COUNTRY_META constant defined in the <script>.) */
void ((): void => {
  // Marker so this comment block stays referenced from the frontmatter
  // for grep-ability; the runtime lookup lives in the <script> below.
})();

/* === Star field (background dots outside the globe mask) ================
 * 96 seeded dots. Stable across builds. Position sampled from a 2D
 * rejection-radius around the globe center — must lie outside the globe
 * radius. Outer scatter uses a square grid outside the sphere. */
interface StarDot {
  x: number;
  y: number;
  r: number;
}
const starDots: StarDot[] = [];
const STAR_COUNT = 96;
let starIdx = 0;
while (starDots.length < STAR_COUNT) {
  const sx = fnv1a(starIdx * 2 + 1);
  const sy = fnv1a(starIdx * 2 + 7);
  const x = sx * width;
  const y = sy * height;
  const dx = x - GLOBE_CX;
  const dy = y - GLOBE_CY;
  const dist2 = dx * dx + dy * dy;
  // Keep a 14px gutter outside the globe; clamp y to the viewBox.
  if (dist2 > (GLOBE_RADIUS + 14) ** 2 && y >= 4 && y <= height - 4) {
    const radiusHash = fnv1a(starIdx + 31);
    starDots.push({
      x,
      y,
      r: 0.5 + radiusHash * 1.1, // 0.5..1.6
    });
  }
  starIdx++;
  // Safety valve so we never hang the build.
  if (starIdx > 800) break;
}

/* === Layer A — venue cities =========================================== */
interface Venue {
  city: string;
  lat: number;
  lon: number;
  weight: number;
  caption: string;
}
interface VenuePosition extends Venue {
  x: number;
  y: number;
  r: number;
  visible: boolean;
}
const venues: Venue[] = [
  { city: 'Digos City', lat: 6.74, lon: 125.36, weight: 1.0, caption: 'home base' },
  { city: 'Singapore', lat: 1.35, lon: 103.82, weight: 0.8, caption: 'APAC ops' },
  { city: 'Tokyo', lat: 35.68, lon: 139.69, weight: 0.7, caption: 'JPX' },
  { city: 'Zurich', lat: 47.38, lon: 8.54, weight: 0.85, caption: 'CTA' },
  { city: 'London', lat: 51.51, lon: -0.13, weight: 0.95, caption: 'LSE' },
  { city: 'New York', lat: 40.71, lon: -74.01, weight: 0.9, caption: 'NYSE / Nasdaq' },
];
const venueByCity = new Map(venues.map((v) => [v.city.toLowerCase(), v]));
const venuePositions: VenuePosition[] = venues
  .map((c) => {
    const p = orthographicProject(c.lat, c.lon, GLOBE_RADIUS, GLOBE_CX, GLOBE_CY, GLOBE_ROT);
    return {
      ...c,
      x: p.x,
      y: p.y,
      r: 2.5 + c.weight * 3.5,
      visible: p.visible,
    };
  })
  .filter((v) => v.visible);

/* === Layer B — curated world events ================================== */
interface WorldEventRow {
  id: string;
  title: string;
  category: 'central-bank' | 'earnings' | 'geopolitical' | 'data-release' | 'fx';
  severity: 'mild' | 'moderate' | 'critical';
  lat: number;
  lon: number;
  city: string;
  source: string;
  order: number;
}
const worldEventEntries = await getCollection('worldEvent');
const worldEvents: WorldEventRow[] = worldEventEntries
  .map((e: { id: string; data: WorldEventRow }): WorldEventRow => ({
    id: e.id,
    title: e.data.title,
    category: e.data.category,
    severity: e.data.severity,
    lat: e.data.lat,
    lon: e.data.lon,
    city: e.data.city,
    source: e.data.source,
    order: e.data.order,
  }))
  .sort((a: WorldEventRow, b: WorldEventRow) => a.order - b.order);
interface EventPosition extends WorldEventRow {
  x: number;
  y: number;
  visible: boolean;
}
const eventPositions: EventPosition[] = worldEvents
  .map((e) => {
    const p = orthographicProject(e.lat, e.lon, GLOBE_RADIUS, GLOBE_CX, GLOBE_CY, GLOBE_ROT);
    return { ...e, x: p.x, y: p.y, visible: p.visible };
  })
  .filter((e) => e.visible);

/* === Layer C — GDELT cache (polarity-tinted overlay) ================ */
interface GdeltEvent {
  id: string;
  title: string;
  category: string;
  severity: string;
  lat: number;
  lon: number;
  city: string;
  source: string;
  timestamp?: string;
  goldstein?: number;
}
interface GdeltCache {
  fetchedAt: string;
  buildDate: string;
  source: string;
  url: string;
  events: GdeltEvent[];
}
const cache = gdeltCache as GdeltCache;
const dedupGdelt: GdeltEvent[] = (() => {
  const seen = new Set<string>();
  const out: GdeltEvent[] = [];
  for (const e of cache.events) {
    if (seen.has(e.id)) continue;
    seen.add(e.id);
    out.push(e);
    if (out.length >= 50) break;
  }
  return out;
})();
interface GdeltPosition extends GdeltEvent {
  x: number;
  y: number;
  r: number;
  polarity: 'pos' | 'neg' | 'neutral';
  visible: boolean;
}
const gdeltPositions: GdeltPosition[] = dedupGdelt
  .map((e) => {
    const p = orthographicProject(e.lat, e.lon, GLOBE_RADIUS, GLOBE_CX, GLOBE_CY, GLOBE_ROT);
    const goldstein = e.goldstein ?? 0;
    const polarity: 'pos' | 'neg' | 'neutral' =
      goldstein > 2 ? 'pos' : goldstein < -2 ? 'neg' : 'neutral';
    const magnitude = Math.min(Math.abs(goldstein), 10);
    const r = 1.4 + magnitude * 0.18;
    return { ...e, x: p.x, y: p.y, r, polarity, visible: p.visible };
  })
  .filter((e) => e.visible);

/* === Layer D (v7.7.4) — arXiv + WIRE geo markers (ortho) ============ */
interface LivePoint {
  id: string;
  source: 'arxiv' | 'macrowire';
  title: string;
  category: string;
  city: string | null;
  x: number;
  y: number;
  r: number;
  visible: boolean;
}
interface LiveFeedCacheShape {
  generated: string;
  events: Array<{
    id: string;
    source: 'arxiv' | 'macrowire' | string;
    title: string;
    coords?: { lat: number; lon: number };
    city?: string | null;
    category: string;
    timestamp: string;
  }>;
}
const liveCache = liveFeedCache as LiveFeedCacheShape;
const livePoints: LivePoint[] = (liveCache.events || [])
  .filter(
    (e): e is typeof e & { coords: { lat: number; lon: number } } =>
      (e.source === 'arxiv' || e.source === 'macrowire') && Boolean(e.coords),
  )
  .map((e) => {
    const p = orthographicProject(
      e.coords.lat,
      e.coords.lon,
      GLOBE_RADIUS,
      GLOBE_CX,
      GLOBE_CY,
      GLOBE_ROT,
    );
    const isWire = e.source === 'macrowire';
    return {
      id: e.id,
      source: e.source as 'arxiv' | 'macrowire',
      title: e.title,
      category: e.category,
      city: e.city ?? null,
      x: p.x,
      y: p.y,
      r: isWire ? 2.8 : 3.4,
      visible: p.visible,
    };
  })
  .filter((p) => p.visible);

const venueResearchDomains = (venue: Venue): string[] => {
  const cityKey = venue.city.toLowerCase();
  const institutionDomains = INSTITUTIONS.filter((institution) =>
    institution.city.toLowerCase().startsWith(cityKey),
  ).map((institution) => institution.focus.toUpperCase());
  const liveDomains = livePoints
    .filter((point) => point.city?.toLowerCase().startsWith(cityKey))
    .map((point) => point.category.toUpperCase());
  const fallback: Record<string, string[]> = {
    'digos city': ['QUANTITATIVE RESEARCH', 'AI ENGINEERING'],
    singapore: ['Q-FINANCE', 'STATISTICS', 'MACHINE LEARNING'],
    tokyo: ['Q-FINANCE', 'STATISTICS'],
    zurich: ['Q-FINANCE'],
    london: ['Q-FINANCE', 'AI ENGINEERING', 'LANGUAGE MODELS'],
    'new york': ['Q-FINANCE', 'MACROECONOMICS'],
  };
  return [...new Set([...institutionDomains, ...liveDomains])].length > 0
    ? [...new Set([...institutionDomains, ...liveDomains])]
    : (fallback[cityKey] ?? ['RESEARCH DATA']);
};

const venueLiveCounts = (venue: Venue): { arxiv: number; wire: number } => {
  const cityKey = venue.city.toLowerCase();
  const points = livePoints.filter((point) => point.city?.toLowerCase().startsWith(cityKey));
  return {
    arxiv: points.filter((point) => point.source === 'arxiv').length,
    wire: points.filter((point) => point.source === 'macrowire').length,
  };
};

/* === Layer E — connection arcs (event → venue city) =================
 * For each GDELT event whose city matches a venue city, draw a great-
 * circle-style quadratic Bezier from the event point to the venue point.
 * Curves lift toward the globe center. */
interface Arc {
  id: string;
  d: string;
  venue: string;
  city: string;
  polarity: 'pos' | 'neg' | 'neutral';
}
const arcs: Arc[] = [];
for (const e of gdeltPositions) {
  if (!e.city) continue;
  const venue = venueByCity.get(e.city.toLowerCase());
  if (!venue) continue;
  const venueP = orthographicProject(
    venue.lat,
    venue.lon,
    GLOBE_RADIUS,
    GLOBE_CX,
    GLOBE_CY,
    GLOBE_ROT,
  );
  if (!venueP.visible) continue;
  // Lift midpoint toward the globe center by 14% of the chord length
  // so the arc bows inward (orbital feel, not anti-pivot).
  const mx = (e.x + venueP.x) / 2;
  const my = (e.y + venueP.y) / 2;
  const cx = (mx + GLOBE_CX) / 2;
  const cy = (my + GLOBE_CY) / 2;
  const d = `M ${e.x.toFixed(2)} ${e.y.toFixed(2)} Q ${cx.toFixed(2)} ${cy.toFixed(2)} ${venueP.x.toFixed(2)} ${venueP.y.toFixed(2)}`;
  arcs.push({
    id: e.id,
    d,
    venue: venue.city,
    city: e.city,
    polarity: e.polarity,
  });
}

/* === Category → shape mapping for world events ======================= */
const eventShape = (category: string): 'triangle' | 'square' | 'diamond' | 'circle' => {
  if (category === 'central-bank' || category === 'fx') return 'triangle';
  if (category === 'data-release') return 'square';
  if (category === 'earnings') return 'diamond';
  return 'circle';
};

/* === Layer F — terminator (orthographic) =============================
 * The terminator math lives in suncalc.ts. We wrap terminatorLine()
 * through orthographicProject() (provided via the existing
 * terminatorOrthographic* helpers) with the GLOBE_CENTER rotation.
 *
 * `_termPathD` is the visible arc — the dashed polyline that draws the
 * day/night boundary across the front of the globe.
 *
 * `_dayFillD` is the closed polygon used as the day-side wash; the
 * terminatorOrthographicPath helper closes the loop automatically. */
const _now = new Date();
const _subLat = solarDeclination(_now); // +N = N hemisphere summer
const _subLon = subsolarLongitude(_now);
const _subP = orthographicProject(_subLat, _subLon, GLOBE_RADIUS, GLOBE_CX, GLOBE_CY, GLOBE_ROT);
// v7.7.7 — anchor the night-mask radial gradient at the anti-subsolar
// point (the antipode of where the Sun is overhead). The night side of
// Earth is darkest at this point and brightest at the sub-solar point,
// which gives a proper terminator that visibly tracks the Sun.
const _antiSubLat = -_subLat;
const _antiSubLon = ((_subLon + 180 + 540) % 360) - 180; // wrap to [-180, 180]
const _antiSubP = orthographicProject(
  _antiSubLat,
  _antiSubLon,
  GLOBE_RADIUS,
  GLOBE_CX,
  GLOBE_CY,
  GLOBE_ROT,
);
const _termPathD = terminatorOrthographicArcPath(
  _now,
  GLOBE_RADIUS,
  GLOBE_CX,
  GLOBE_CY,
  GLOBE_ROT,
  { step: 2 },
);
const _dayFillD = terminatorOrthographicPath(_now, GLOBE_RADIUS, GLOBE_CX, GLOBE_CY, GLOBE_ROT, {
  step: 2,
});

const _hourMarker = `${String(_now.getUTCHours()).padStart(2, '0')}:${String(_now.getUTCMinutes()).padStart(2, '0')}:${String(_now.getUTCSeconds()).padStart(2, '0')} UTC`;

/* === Day/night split approximation ===================================
 * Geometrically, the sun always illuminates exactly half the sphere.
 * The institutional label here is the SEASONAL shift weighted by Earth's
 * axial tilt: when declination is +23.5° (N summer solstice) the sunlit
 * cap extends ~3.5% beyond the equator-weighted 50%, so the day side
 * reads ~53.5%. Symmetric for negative declination. The label
 * deliberately includes a "tilt-weighted" suffix so a recruiter
 * scanning the chrome doesn't mistake the number for a precise
 * surface-fraction figure. */
const dayPct = Math.round(50 + (_subLat / 23.5) * 3.5);
const nightPct = 100 - dayPct;

/* === KPI strip labels ================================================ */
const fmtLat = (lat: number): string => {
  const h = Math.abs(lat).toFixed(1);
  return `${h}°${lat >= 0 ? 'N' : 'S'}`;
};
const fmtLon = (lon: number): string => {
  const h = Math.abs(lon).toFixed(1);
  return `${h}°${lon <= 0 ? 'W' : 'E'}`;
};
const subLatStr = fmtLat(_subLat);
const subLonStr = fmtLon(_subLon);
const declStr = `${Math.abs(_subLat).toFixed(2)}°${_subLat >= 0 ? ' N' : ' S'}`;
const dayNightStr = `DAY ${dayPct}% · NIGHT ${nightPct}%`;
// v7.9 — moved into the client-side loader so it ships once and the
// prerendered HTML stays small. Referenced via `lightFor` in the <script>.
const dayNightForPoint = (lat: number, lon: number): string => {
  const toRad = Math.PI / 180;
  const solarRelationship =
    Math.sin(lat * toRad) * Math.sin(_subLat * toRad) +
    Math.cos(lat * toRad) * Math.cos(_subLat * toRad) * Math.cos((lon - _subLon) * toRad);
  if (solarRelationship > 0.25) return 'DAY';
  if (solarRelationship < -0.25) return 'NIGHT';
  return 'TERMINATOR';
};
void dayNightForPoint;

/* === Last-sync chrome (v7.7.0 preserved) ============================ */
const fetchedAt = cache.fetchedAt;
const buildDateIso = cache.buildDate || fetchedAt;
const elapsedMs = new Date(buildDateIso).getTime() - new Date(fetchedAt).getTime();
const elapsedMin = Math.max(0, Math.floor(elapsedMs / 60_000));
const fetchedAtStamp = fetchedAt.slice(0, 16).replace('T', ' ').slice(0, 16) + 'Z';
const isLive = cache.source === 'gdelt';

/* === Reference the venueByCity map so lint doesn't flag it unused. === */
void venueByCity;
---

<figure class:list={['earth-map', className]}>
  <svg
    class="earth-map__svg"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={`Orthographic globe view centered on ${GLOBE_CENTER[0]}°/${GLOBE_CENTER[1]}°. ${venues.length} research venues, ${worldEvents.length} curated world events, ${gdeltPositions.length} GDELT signals visible from this rotation, ${livePoints.filter((p) => p.source === 'arxiv').length} arXiv + ${livePoints.filter((p) => p.source === 'macrowire').length} wire geo-overlay markers, day/night terminator overlay. Synchronized ${fetchedAtStamp}.`}
    preserveAspectRatio="xMidYMid meet"
  >
    {
      /* === Atmospheric chrome (drawn FIRST, sits behind the globe) ===
         Two layers: cream/navy radial wash + 96 seeded star dots. The
         atmospheric-glow ring is the outermost circle on the sphere
         and is emitted later (after the sphere outline) so it reads as
         a rim around the globe, not a sky gradient. */
    }
    <defs>
      <radialGradient id="earth-map__sky" cx="50%" cy="48%" r="68%" fx="50%" fy="44%">
        <stop offset="0%" stop-color="var(--c-bg-2)" stop-opacity="0.0"></stop>
        <stop offset="60%" stop-color="var(--c-bg-2)" stop-opacity="0.0"></stop>
        <stop offset="100%" stop-color="var(--c-bg)" stop-opacity="0.85"></stop>
      </radialGradient>
      <radialGradient id="earth-map__atmo" cx="50%" cy="50%" r="50%">
        <stop offset="60%" stop-color="var(--c-primary-2)" stop-opacity="0"></stop>
        <stop offset="84%" stop-color="var(--c-primary-2)" stop-opacity="0.18"></stop>
        <stop offset="100%" stop-color="var(--c-primary-2)" stop-opacity="0"></stop>
      </radialGradient>
      {
        /* v7.7.6 — realistic ocean: deeper cobalt at the limb, lighter
          at the sub-solar point. Reads as a 3D sphere. */
      }
      <radialGradient id="earth-map__ocean" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--j-cobalt-3)" stop-opacity="1"></stop>
        <stop offset="65%" stop-color="var(--j-cobalt)" stop-opacity="1"></stop>
        <stop offset="100%" stop-color="var(--j-cobalt-deep)" stop-opacity="1"></stop>
      </radialGradient>
      {
        /* v7.7.6 — atmospheric scatter ring (cobalt bloom around the
          sphere, mimics Rayleigh scattering in real Earth photos). */
      }
      <radialGradient id="earth-map__scatter" cx="50%" cy="50%" r="50%">
        <stop offset="78%" stop-color="var(--j-cobalt-3)" stop-opacity="0"></stop>
        <stop offset="92%" stop-color="var(--j-cobalt-3)" stop-opacity="0.55"></stop>
        <stop offset="100%" stop-color="var(--j-cobalt)" stop-opacity="0"></stop>
      </radialGradient>
      {
        /* v7.7.7 — night-side dim anchored at the anti-subsolar point so
          the dimming visibly tracks the Sun. userSpaceOnUse lets us
          place the gradient center in absolute SVG coords (the
          projected antipode), with r=GLOBE_RADIUS so it fades out by
          the terminator. */
      }
      <radialGradient
        id="earth-map__night"
        gradientUnits="userSpaceOnUse"
        cx={_antiSubP.x}
        cy={_antiSubP.y}
        r={GLOBE_RADIUS}
      >
        <stop offset="0%" stop-color="var(--c-primary-deep)" stop-opacity="0.85"></stop>
        <stop offset="45%" stop-color="var(--c-primary-deep)" stop-opacity="0.6"></stop>
        <stop offset="78%" stop-color="var(--c-primary-deep)" stop-opacity="0.18"></stop>
        <stop offset="100%" stop-color="var(--c-primary-deep)" stop-opacity="0"></stop>
      </radialGradient>
      {
        /* v7.7.6 — clip the rotating globe so countries that swing into
          the back hemisphere are visually masked by the sphere edge. */
      }
      <clipPath id="earth-map__sphere-clip">
        <circle cx={GLOBE_CX} cy={GLOBE_CY} r={GLOBE_RADIUS + 1}></circle>
      </clipPath>
      {
        /* v7.8 — country vignette: the limb resolves into ocean cobalt rather
          than black, preserving coastline fidelity as the globe rotates. */
      }
      <radialGradient id="earth-map__country-vignette" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="var(--j-cobalt)" stop-opacity="0"></stop>
        <stop offset="74%" stop-color="var(--j-cobalt)" stop-opacity="0"></stop>
        <stop offset="92%" stop-color="var(--j-cobalt-deep)" stop-opacity="0.2"></stop>
        <stop offset="100%" stop-color="var(--j-cobalt-deep)" stop-opacity="0.62"></stop>
      </radialGradient>
    </defs>

    {
      /* Sky plate (cream/navy wash). The viewBox is the full 600×600 so
        the wash fills the same canvas as the star field. */
    }
    <rect x="0" y="0" width={width} height={height} fill="var(--c-bg)" aria-hidden="true"></rect>
    <rect x="0" y="0" width={width} height={height} fill="url(#earth-map__sky)" aria-hidden="true"
    ></rect>

    {/* Star field — 96 deterministic dots, scattered outside the globe mask. */}
    <g class="earth-map__stars" aria-hidden="true">
      {
        starDots.map((s, i) => (
          <circle
            cx={s.x.toFixed(2)}
            cy={s.y.toFixed(2)}
            r={s.r.toFixed(2)}
            class="earth-map__star"
            style={`--i: ${i % 12}`}
          />
        ))
      }
    </g>

    {/* Atmospheric glow ring — sits over the sphere as a rim. NO halo. */}
    <circle
      cx={GLOBE_CX}
      cy={GLOBE_CY}
      r={GLOBE_RADIUS + 6}
      fill="url(#earth-map__atmo)"
      aria-hidden="true"></circle>

    {
      /* === Layer 0 — globe ocean + sphere outline + country borders ===
         v7.7.6 — the ocean disc now carries the cobalt radial gradient
         (deeper at the limb, lighter at the sub-solar point). The
         rotating-country group sits on top of the ocean so continents
         drift slowly east-to-west like Earth seen from space. */
    }
    <g class="earth-map__globe" aria-hidden="false">
      <path d={GLOBE_SPHERE_D} class="earth-map__sphere" fill="url(#earth-map__ocean)"></path>
      <g class="earth-map__countries" clip-path="url(#earth-map__sphere-clip)">
        {
          /* Transparent country targets stay in the same rotating coordinate
            system as their visible outlines. */
        }
        <g class="earth-map__hitbox" clip-path="url(#earth-map__sphere-clip)" data-countries-target>
        </g>
      </g>
      <path
        d={GLOBE_SPHERE_D}
        class="earth-map__country-vignette"
        fill="url(#earth-map__country-vignette)"
        aria-hidden="true"></path>

      {
        /* v7.7.6 — atmospheric scatter ring (Rayleigh-style cobalt bloom
        around the sphere limb) and night-side dim mask. Both clipped to
        the sphere circle so they hug the planet. */
      }
      <path d={GLOBE_SPHERE_D} class="earth-map__scatter" aria-hidden="true"></path>
      <path d={GLOBE_SPHERE_D} class="earth-map__night-mask" aria-hidden="true"></path>

      {
        /* === Layer F (v7.7.4) — terminator, ortho-reprojected ===
        Day-side wash first (sits behind the country outlines via the
        mix-blend mode trick used in CoverageGlobe). Then the dashed
        great-circle arc + the subsolar pulse on top. */
      }
      {
        _dayFillD && (
          <path
            d={_dayFillD}
            class="earth-map__day-wash"
            fill="url(#earth-map__day-wash)"
            aria-hidden="true"
          />
        )
      }
      {_termPathD && <path d={_termPathD} class="earth-map__terminator-line" aria-hidden="true" />}
      {
        _subP.visible && (
          <g class="earth-map__subsolar">
            <circle
              cx={_subP.x.toFixed(2)}
              cy={_subP.y.toFixed(2)}
              r="4.5"
              class="earth-map__subsolar"
            />
            <circle
              cx={_subP.x.toFixed(2)}
              cy={_subP.y.toFixed(2)}
              r="9"
              class="earth-map__subsolar-pulse"
            />
          </g>
        )
      }

      {/* === Layer A — venue cities (amber, weighted, with pulse) === */}
      {
        venuePositions.map((c) => (
          <g
            class="earth-map__venue"
            data-venue-city={c.city}
            data-venue-lat={c.lat}
            data-venue-lon={c.lon}
            data-venue-caption={c.caption}
            data-venue-domains={venueResearchDomains(c).join(' · ')}
            data-venue-arxiv={venueLiveCounts(c).arxiv}
            data-venue-wire={venueLiveCounts(c).wire}
            tabindex="0"
            role="button"
            aria-label={`Focus ${c.city}, ${c.caption}`}
          >
            {c.weight >= 0.7 && (
              <circle
                cx={c.x.toFixed(2)}
                cy={c.y.toFixed(2)}
                r={(c.r + 4).toFixed(2)}
                class="earth-map__pulse"
              />
            )}
            <circle
              cx={c.x.toFixed(2)}
              cy={c.y.toFixed(2)}
              r={c.r.toFixed(2)}
              class="earth-map__dot"
            >
              <title>
                {c.city} ({c.lat.toFixed(2)}°, {c.lon.toFixed(2)}°) — {c.caption}
              </title>
            </circle>
            <text
              x={c.x.toFixed(2)}
              y={(c.y - c.r - 4).toFixed(2)}
              text-anchor="middle"
              class="earth-map__label"
            >
              {c.city}
            </text>
          </g>
        ))
      }

      {/* === Layer B — world events (shape-coded by category) === */}
      {
        eventPositions.map((e) => {
          const shape = eventShape(e.category);
          return (
            <g
              class={`earth-map__event earth-map__event--${e.category} earth-map__event--${e.severity}`}
            >
              {shape === 'triangle' && (
                <polygon
                  points={`${e.x.toFixed(2)},${(e.y - 4).toFixed(2)} ${(e.x + 4).toFixed(2)},${(e.y + 3).toFixed(2)} ${(e.x - 4).toFixed(2)},${(e.y + 3).toFixed(2)}`}
                  class="earth-map__event-shape"
                >
                  <title>
                    {e.title} — {e.city}
                  </title>
                </polygon>
              )}
              {shape === 'square' && (
                <rect
                  x={(e.x - 3.5).toFixed(2)}
                  y={(e.y - 3.5).toFixed(2)}
                  width="7"
                  height="7"
                  class="earth-map__event-shape"
                >
                  <title>
                    {e.title} — {e.city}
                  </title>
                </rect>
              )}
              {shape === 'diamond' && (
                <polygon
                  points={`${e.x.toFixed(2)},${(e.y - 4).toFixed(2)} ${(e.x + 4).toFixed(2)},${e.y.toFixed(2)} ${e.x.toFixed(2)},${(e.y + 4).toFixed(2)} ${(e.x - 4).toFixed(2)},${e.y.toFixed(2)}`}
                  class="earth-map__event-shape"
                >
                  <title>
                    {e.title} — {e.city}
                  </title>
                </polygon>
              )}
              {shape === 'circle' && (
                <circle
                  cx={e.x.toFixed(2)}
                  cy={e.y.toFixed(2)}
                  r="3.4"
                  class="earth-map__event-shape"
                >
                  <title>
                    {e.title} — {e.city}
                  </title>
                </circle>
              )}
            </g>
          );
        })
      }

      {/* === Layer E — connection arcs (event → venue city) === */}
      {
        arcs.map((a, i) => (
          <path
            d={a.d}
            pathLength="1"
            class={`earth-map__arc earth-map__arc--${a.polarity}`}
            style={`--i: ${i}`}
            aria-label={`${a.city} signal → ${a.venue} venue`}
          />
        ))
      }

      {/* === Layer C — GDELT (severity-weighted, polarity-tinted) === */}
      {
        gdeltPositions.map((e) => (
          <circle
            cx={e.x.toFixed(2)}
            cy={e.y.toFixed(2)}
            r={e.r.toFixed(2)}
            data-event-id={e.id}
            class={`earth-map__gdelt earth-map__gdelt--${e.polarity}`}
          >
            <title>
              {e.title} — {e.city} ({e.goldstein?.toFixed(1) ?? '0.0'})
            </title>
          </circle>
        ))
      }

      {
        /* === Layer D — arXiv + WIRE markers (institution / publisher-city geo) ===
        Renders ABOVE Layer C for visual prominence. Each marker carries
        data-event-id so the hover-sync bus can pulse it from /live. */
      }
      <g class="earth-map__live-group">
        {
          livePoints.map((p) => (
            <circle
              cx={p.x.toFixed(2)}
              cy={p.y.toFixed(2)}
              r={p.r.toFixed(2)}
              data-event-id={p.id}
              data-event-source={p.source}
              class={`earth-map__live earth-map__live--${p.source}`}
            >
              <title>
                {p.source.toUpperCase()} · {p.city ?? ''} · {p.category.toUpperCase()}
                {'\n'}
                {p.title}
              </title>
            </circle>
          ))
        }
      </g>

      {
        /* Globe sphere outline (1px cobalt stroke @ 70% opacity) — sits on
        TOP of every layer so the disc edges read crisply even when a
        marker straddles the rim. */
      }
      <path
        d={GLOBE_SPHERE_D}
        class="earth-map__sphere-edge"
        fill="none"
        stroke="var(--c-primary-2)"
        stroke-opacity="0.7"
        stroke-width="1"
        aria-hidden="true"></path>
    </g>
  </svg>

  <aside
    class="earth-map__focus-panel"
    data-focus-panel
    hidden
    role="dialog"
    aria-label="Earth focus details"
    aria-live="polite"
    tabindex="-1"
  >
    <div class="earth-map__focus-head">
      <span class="earth-map__focus-kicker mono" data-focus-kind>FOCUS</span>
      <button
        class="earth-map__focus-close"
        type="button"
        data-focus-close
        aria-label="Close focus details">CLOSE</button
      >
    </div>
    <div class="earth-map__focus-title mono" data-focus-title>—</div>
    <dl class="earth-map__focus-grid" data-focus-country hidden>
      <div><dt>CAPITAL</dt><dd data-focus-capital>—</dd></div>
      <div><dt>REGION</dt><dd data-focus-region>—</dd></div>
      <div><dt>TIMEZONE</dt><dd data-focus-timezone>—</dd></div>
      <div><dt>LIGHT</dt><dd data-focus-light>—</dd></div>
      <div><dt>DATA POINTS</dt><dd data-focus-points>—</dd></div>
    </dl>
    <dl class="earth-map__focus-grid" data-focus-venue hidden>
      <div><dt>VENUE</dt><dd data-focus-caption>—</dd></div>
      <div><dt>DOMAINS</dt><dd data-focus-domains>—</dd></div>
      <div><dt>ARXIV PAPERS</dt><dd data-focus-arxiv>—</dd></div>
      <div><dt>WIRE HEADLINES</dt><dd data-focus-wire>—</dd></div>
    </dl>
  </aside>

  {
    /* === NEW v7.7.4 HUD chrome — 4-cell KPI strip (HTML, not SVG) ===
       Same mono-small-caps vocabulary as the desk-stats row. Each cell
       is a hairline-divided row with a label + a value. */
  }
  <div class="earth-map__hud" role="group" aria-label="Subsolar and time readouts">
    <div class="earth-map__hud-cell">
      <span class="earth-map__hud-label mono">SUBSOLAR</span>
      <span class="earth-map__hud-value mono">{subLatStr} · {subLonStr}</span>
    </div>
    <div class="earth-map__hud-cell">
      <span class="earth-map__hud-label mono">DECLINATION</span>
      <span class="earth-map__hud-value mono">{declStr}</span>
    </div>
    <div class="earth-map__hud-cell">
      <span class="earth-map__hud-label mono">UTC CLOCK</span>
      <span class="earth-map__hud-value mono" data-counter-hud="utc">{_hourMarker}</span>
    </div>
    <div class="earth-map__hud-cell">
      <span class="earth-map__hud-label mono">DAY / NIGHT</span>
      <span class="earth-map__hud-value mono">{dayNightStr}</span>
    </div>
  </div>

  <figcaption class="earth-map__caption mono">
    <span class="earth-map__cap-section">
      <span class="earth-map__cap-swatch earth-map__cap-swatch--venue" aria-hidden="true"></span>
      {venues.length} venues
    </span>
    <span class="earth-map__cap-sep">·</span>
    <span class="earth-map__cap-section">
      <span class="earth-map__cap-swatch earth-map__cap-swatch--event" aria-hidden="true"></span>
      {worldEvents.length} world events
    </span>
    <span class="earth-map__cap-sep">·</span>
    <span class="earth-map__cap-section">
      <span class="earth-map__cap-swatch earth-map__cap-swatch--gdelt-pos" aria-hidden="true"
      ></span>
      {gdeltPositions.length} GDELT visible
    </span>
    {
      arcs.length > 0 && (
        <>
          <span class="earth-map__cap-sep">·</span>
          <span class="earth-map__cap-section">
            <span class="earth-map__cap-swatch earth-map__cap-swatch--arc" aria-hidden="true" />
            {arcs.length} arcs
          </span>
        </>
      )
    }
    {
      livePoints.length > 0 && (
        <>
          <span class="earth-map__cap-sep">·</span>
          <span class="earth-map__cap-section">
            <span class="earth-map__cap-swatch earth-map__cap-swatch--arxiv" aria-hidden="true" />
            {livePoints.filter((p) => p.source === 'arxiv').length} arxiv
          </span>
          <span class="earth-map__cap-sep">·</span>
          <span class="earth-map__cap-section">
            <span class="earth-map__cap-swatch earth-map__cap-swatch--wire" aria-hidden="true" />
            {livePoints.filter((p) => p.source === 'macrowire').length} wire
          </span>
        </>
      )
    }
    <span class="earth-map__cap-sep">·</span>
    <span class="earth-map__cap-section earth-map__cap-section--f">
      <span class="earth-map__cap-swatch earth-map__cap-swatch--day" aria-hidden="true"></span>
      DAY/NIGHT
      <span class="earth-map__cap-term mono">δ{_subLat.toFixed(1)}° · {_hourMarker}</span>
    </span>
    <span class="earth-map__cap-sync">
      <span class={`earth-map__cap-badge earth-map__cap-badge--${isLive ? 'live' : 'fallback'}`}>
        {isLive ? 'LIVE' : 'FALLBACK'}
      </span>
      <span class="earth-map__cap-sync-text">SYNCHRONIZED</span>
      <span class="earth-map__cap-sync-ago" data-counter={`${elapsedMin}`} data-duration="600">
        {elapsedMin}
      </span>
      <span class="earth-map__cap-sync-text">M AGO</span>
      <span class="earth-map__cap-sync-stamp">{fetchedAtStamp}</span>
    </span>
  </figcaption>
</figure>

<style>
  .earth-map {
    --earth-focus-panel-width: 380px;
    margin: 0;
    padding: 0;
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    display: flex;
    flex-direction: column;
  }
  .earth-map__svg {
    width: 100%;
    height: auto;
    display: block;
    background: var(--c-bg);
  }

  /* === Star field === */
  .earth-map__stars {
    /* Tiny keyframe twinkle; reduced-motion-aware below. */
    animation: star-twinkle 6s linear infinite;
  }
  .earth-map__star {
    fill: var(--c-ink-3);
    opacity: 0.55;
    transform-origin: center;
    transform-box: fill-box;
  }
  .earth-map__star:nth-child(8n) {
    opacity: 0.85;
  }
  .earth-map__star:nth-child(8n + 1) {
    opacity: 0.7;
  }
  @keyframes star-twinkle {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* === Globe sphere outline + country borders === */
  /* v7.7.6 — sphere is filled by url(#earth-map__ocean) gradient in
     markup; CSS only declares the stroke for the limb. */
  .earth-map__sphere {
    stroke: var(--j-cobalt-3);
    stroke-opacity: 0.65;
    stroke-width: 0.7;
  }
  .earth-map__sphere-edge {
    /* The crisp outer 1px stroke at 70% opacity — declares the disc edge. */
  }
  /* v7.7.6 — continents are sage land, bordered by warm amber so the
     silhouette of Africa / Eurasia reads instantly. */
  .earth-map__country {
    fill: var(--j-sage);
    fill-opacity: 0.88;
    stroke: var(--c-primary-2-light);
    stroke-opacity: 0.65;
    stroke-width: 0.9;
    stroke-linejoin: round;
    transition:
      fill-opacity 120ms ease,
      stroke-opacity 120ms ease;
  }
  .earth-map__country:hover {
    fill-opacity: 1;
    stroke-opacity: 0.95;
  }

  /* === v7.8.1 — country hover-highlight ============================
     The hitbox carries the geometry. By default the country is
     transparent; on hover/focus it brightens with a sage fill + amber
     stroke. The --hover custom property is set by the
     :hover/:focus-visible pseudo-class so JS-driven state (touch,
     programmatic focus) can mirror the same look via a class. */
  .earth-map__country-hitbox {
    fill: transparent;
    stroke: transparent;
    stroke-width: 1.2;
    cursor: pointer;
    pointer-events: all;
    transition:
      fill var(--j-dur) var(--j-ease-snappy),
      stroke var(--j-dur) var(--j-ease-snappy),
      stroke-opacity var(--j-dur) var(--j-ease-snappy);
  }
  .earth-map__country-hitbox:hover,
  .earth-map__country-hitbox:focus-visible,
  .earth-map__country-hitbox[data-hover='1'] {
    --hover: 1;
    fill: color-mix(in oklab, var(--j-sage) 22%, transparent);
    stroke: var(--c-warn);
    stroke-opacity: 0.95;
  }
  .earth-map__country-hitbox:focus-visible,
  .earth-map__venue:focus-visible {
    outline: none;
    stroke: var(--c-warn);
    stroke-width: 2;
    stroke-opacity: 1;
  }
  .earth-map__country-vignette {
    pointer-events: none;
  }

  /* v7.7.6 — slow auto-rotation of the countries group. The clipPath
     in markup keeps back-hemisphere countries masked, so the continents
     drift across the visible disc instead of swinging off the rim. */
  .earth-map__countries {
    transform-box: fill-box;
    transform-origin: center;
    animation: earth-rotate 480s linear infinite;
    will-change: transform;
  }
  @keyframes earth-rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .earth-map__countries {
      animation: none;
    }
  }

  /* v7.7.6 — night-side dim. Drawn as a path on the sphere outline
     using a radial gradient so the day/night boundary is a real gradient
     on the limb rather than just a dashed line. */
  .earth-map__night-mask {
    fill: url(#earth-map__night);
    pointer-events: none;
    mix-blend-mode: multiply;
  }
  .earth-map__scatter {
    fill: url(#earth-map__scatter);
    pointer-events: none;
  }

  /* === v7.8.1 — venue hover-highlight ===============================
     The dot is brightened on hover/focus (amber stroke + scale up), and
     the custom mono label (city name) fades in. Same --hover hook as the
     country hitbox so JS-driven state mirrors the pseudo-class look. */
  .earth-map__venue {
    cursor: pointer;
    outline: none;
  }
  .earth-map__venue:hover .earth-map__dot,
  .earth-map__venue:focus-visible .earth-map__dot,
  .earth-map__venue[data-hover='1'] .earth-map__dot {
    stroke: var(--c-warn);
    stroke-width: 2.4;
    filter: brightness(1.2);
  }
  .earth-map__venue:focus-visible .earth-map__dot {
    stroke: var(--c-warn);
    stroke-width: 2;
  }
  .earth-map__venue:focus-visible {
    outline: none;
  }

  /* === Layer A — venues === */
  .earth-map__pulse {
    fill: none;
    stroke: var(--c-primary-2);
    stroke-width: 1;
    opacity: 0.4;
    animation: globe-pulse 3.6s ease-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }
  .earth-map__pulse:nth-child(1) {
    animation-delay: 0s;
  }
  .earth-map__pulse:nth-child(2) {
    animation-delay: 0.6s;
  }
  .earth-map__pulse:nth-child(3) {
    animation-delay: 1.2s;
  }
  .earth-map__dot {
    fill: var(--c-primary-2);
    stroke: var(--c-primary-2-light);
    stroke-width: 1;
    transition:
      stroke var(--j-dur) var(--j-ease-snappy),
      stroke-width var(--j-dur) var(--j-ease-snappy),
      filter var(--j-dur) var(--j-ease-snappy);
  }
  /* === v7.8.1 — custom mono label, hidden by default, fades in on
     venue hover/focus. Painted stroke makes it readable against any
     background (cobalt ocean, sage continent, amber dot, terminator). */
  .earth-map__label {
    font-family: var(--j-ff-mono);
    font-size: 9.5px;
    fill: var(--c-warn);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0;
    pointer-events: none;
    paint-order: stroke;
    stroke: var(--c-bg);
    stroke-width: 3;
    stroke-linejoin: round;
    transition: opacity var(--j-dur) var(--j-ease-snappy);
  }
  .earth-map__venue:hover .earth-map__label,
  .earth-map__venue:focus-visible .earth-map__label,
  .earth-map__venue[data-hover='1'] .earth-map__label {
    opacity: 1;
  }

  /* === Layer B — world events === */
  .earth-map__event-shape {
    fill: var(--c-amber-deep);
    stroke: var(--c-bg);
    stroke-width: 1;
    opacity: 0.85;
  }
  .earth-map__event--critical .earth-map__event-shape {
    fill: var(--c-amber-deep);
    opacity: 1;
  }
  .earth-map__event--moderate .earth-map__event-shape {
    fill: var(--c-amber);
    opacity: 0.78;
  }
  .earth-map__event--mild .earth-map__event-shape {
    fill: var(--c-ink-2);
    opacity: 0.6;
  }

  /* === Layer E — connection arcs === */
  .earth-map__arc {
    fill: none;
    stroke: var(--c-warn-soft);
    stroke-width: 0.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.7;
    animation: arc-draw 1.6s var(--j-ease-out) forwards;
    animation-delay: calc(var(--i, 0) * 60ms + 800ms);
  }
  .earth-map__arc--pos {
    stroke: var(--c-amber);
  }
  .earth-map__arc--neg {
    stroke: var(--c-ink-3);
  }
  .earth-map__arc--neutral {
    stroke: var(--c-ink-4);
  }
  @keyframes arc-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* === Layer C — GDELT (severity-weighted, polarity-tinted) === */
  .earth-map__gdelt {
    stroke: none;
  }
  .earth-map__gdelt--pos {
    fill: var(--c-amber);
    opacity: 0.65;
  }
  .earth-map__gdelt--neg {
    fill: var(--c-ink-2);
    opacity: 0.55;
  }
  .earth-map__gdelt--neutral {
    fill: var(--c-ink-3);
    opacity: 0.4;
  }

  /* === Layer F — terminator === */
  .earth-map__day-wash {
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .earth-map__terminator-line {
    fill: none;
    stroke: var(--c-warn);
    stroke-width: 1.2;
    stroke-dasharray: 4, 3;
    opacity: 0.8;
    pointer-events: none;
  }
  .earth-map__subsolar {
    fill: var(--c-amber);
    stroke: var(--c-bg);
    stroke-width: 1;
  }
  .earth-map__subsolar-pulse {
    fill: none;
    stroke: var(--c-amber);
    stroke-width: 1;
    opacity: 0.5;
    transform-origin: center;
    transform-box: fill-box;
    animation: subsolar-pulse 3.6s ease-out infinite;
  }
  @keyframes subsolar-pulse {
    0% {
      transform: scale(0.5);
      opacity: 0.7;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  /* === Layer D — arXiv + WIRE markers === */
  .earth-map__live {
    stroke: var(--c-bg);
    stroke-width: 0.6;
    transition:
      stroke 120ms ease,
      stroke-width 120ms ease;
    cursor: help;
  }
  .earth-map__live--arxiv {
    fill: color-mix(in oklab, var(--c-amber) 75%, var(--c-warn) 25%);
    opacity: 0.85;
  }
  .earth-map__live--macrowire {
    fill: color-mix(in oklab, var(--c-sage) 80%, var(--c-ink) 20%);
    opacity: 0.75;
  }
  /* === hover-sync focus ring (preserved) === */
  .earth-map__live--focus,
  .earth-map__gdelt--focus {
    stroke: var(--c-amber);
    stroke-width: 2.4;
    animation: earth-marker-focus 1.2s var(--j-ease-out) forwards;
    transform-origin: center;
    transform-box: fill-box;
  }
  @keyframes earth-marker-focus {
    0% {
      stroke-opacity: 0.4;
      transform: scale(1);
    }
    35% {
      stroke-opacity: 1;
      transform: scale(1.6);
    }
    100% {
      stroke-opacity: 0;
      transform: scale(2.2);
    }
  }

  /* === v7.8.1 side-drawer click-to-dive focus panel ===
     Right-anchored drawer on desktop (380px), full-width bottom-sheet
     on mobile ≤ 720px. Animates in via the slide-in keyframe. */
  .earth-map__focus-panel {
    position: fixed;
    inset-block-start: var(--j-sp-3);
    inset-inline-end: var(--j-sp-3);
    inset-block-end: auto;
    width: min(var(--earth-focus-panel-width), calc(100vw - var(--j-sp-4)));
    max-block-size: calc(100vh - var(--j-sp-4) - var(--j-sp-4));
    overflow-y: auto;
    z-index: 40;
    border: var(--j-b-1);
    background: var(--c-bg-2);
    color: var(--c-ink);
    padding: var(--j-sp-2);
    transform: translateX(0);
    animation: earth-focus-in var(--j-dur-slow) var(--j-ease-out) both;
  }
  .earth-map__focus-panel[hidden] {
    display: none;
  }
  @keyframes earth-focus-in {
    from {
      transform: translateX(calc(100% + var(--j-sp-3)));
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
  /* === Mobile ≤ 720px — full-width bottom-sheet === */
  @media (max-width: 720px) {
    .earth-map__focus-panel {
      inset-block-start: auto;
      inset-block-end: 0;
      inset-inline-start: 0;
      inset-inline-end: 0;
      width: 100%;
      max-block-size: 60vh;
      border: var(--j-b-1);
      border-block-end: none;
      border-inline-start: none;
      border-inline-end: none;
      animation: earth-focus-in-bottom var(--j-dur-slow) var(--j-ease-out) both;
    }
    @keyframes earth-focus-in-bottom {
      from {
        transform: translateY(100%);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }
  }
  .earth-map__focus-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block-end: var(--j-sp-1);
    border-bottom: var(--j-b-hairline);
  }
  .earth-map__focus-kicker,
  .earth-map__focus-close,
  .earth-map__focus-grid dt,
  .earth-map__focus-grid dd {
    font-family: var(--j-ff-mono);
    font-size: var(--j-t-xs);
    letter-spacing: var(--j-track-wide);
    text-transform: uppercase;
  }
  .earth-map__focus-kicker {
    color: var(--c-amber);
  }
  .earth-map__focus-close {
    appearance: none;
    border: var(--j-b-hairline);
    border-radius: var(--j-r);
    background: transparent;
    color: var(--c-ink-2);
    padding: calc(var(--j-sp-1) / 2) var(--j-sp-1);
    cursor: pointer;
  }
  .earth-map__focus-close:hover {
    color: var(--c-ink);
    border-color: var(--c-ink-2);
  }
  .earth-map__focus-close:focus-visible {
    outline: 2px solid var(--c-amber);
    outline-offset: 2px;
  }
  .earth-map__focus-title {
    padding-block: var(--j-sp-2);
    color: var(--c-ink);
    font-size: var(--j-t-md);
    font-weight: var(--j-w-heading);
    letter-spacing: var(--j-track-wide);
    text-transform: uppercase;
  }
  .earth-map__focus-grid {
    margin: 0;
    display: grid;
    gap: var(--j-sp-1);
  }
  .earth-map__focus-grid[hidden] {
    display: none;
  }
  .earth-map__focus-grid div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--j-sp-1);
    padding-block: var(--j-sp-1);
    border-top: var(--j-b-hairline);
  }
  .earth-map__focus-grid dt {
    color: var(--c-ink-3);
  }
  .earth-map__focus-grid dd {
    margin: 0;
    color: var(--c-ink);
    text-align: end;
    line-height: var(--j-lh-snug);
    overflow-wrap: anywhere;
  }

  /* === NEW v7.7.4 HUD chrome — 4-cell KPI strip === */
  .earth-map__hud {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-tape);
  }
  .earth-map__hud-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 14px;
    border-right: 1px solid var(--c-rule-soft);
  }
  .earth-map__hud-cell:last-child {
    border-right: none;
  }
  .earth-map__hud-label {
    font-size: 9px;
    color: var(--c-ink-3);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .earth-map__hud-value {
    font-size: 13px;
    color: var(--c-ink);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
    font-weight: 600;
  }
  @media (max-width: 600px) {
    .earth-map__hud {
      grid-template-columns: repeat(2, 1fr);
    }
    .earth-map__hud-cell:nth-child(2n) {
      border-right: none;
    }
    .earth-map__hud-cell:nth-child(-n + 2) {
      border-bottom: 1px solid var(--c-rule-soft);
    }
  }

  /* === Caption (legend + last-sync, v7.7.0 vocabulary preserved) === */
  .earth-map__caption {
    font-size: 10px;
    color: var(--c-ink-2);
    padding: 12px 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    border-top: 1px solid var(--c-rule);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .earth-map__cap-section {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .earth-map__cap-swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
  }
  .earth-map__cap-swatch--venue {
    background: var(--c-primary-2);
  }
  .earth-map__cap-swatch--event {
    background: var(--c-amber-deep);
    transform: rotate(45deg);
  }
  .earth-map__cap-swatch--gdelt-pos {
    background: var(--c-amber);
    opacity: 0.6;
    border-radius: 50%;
  }
  .earth-map__cap-swatch--arc {
    background: transparent;
    border-top: 1px solid var(--c-amber);
    height: 0;
    width: 12px;
    margin-block: 4px;
  }
  .earth-map__cap-swatch--arxiv {
    background: color-mix(in oklab, var(--c-amber) 75%, var(--c-warn) 25%);
    border-radius: 50%;
    opacity: 0.85;
  }
  .earth-map__cap-swatch--wire {
    background: color-mix(in oklab, var(--c-sage) 80%, var(--c-ink) 20%);
    border-radius: 50%;
    opacity: 0.75;
  }
  .earth-map__cap-swatch--day {
    background: color-mix(in oklab, var(--c-warn) 30%, transparent);
    border: 1px dashed var(--c-warn);
    opacity: 0.6;
  }
  .earth-map__cap-term {
    color: var(--c-warn);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-left: 4px;
  }
  .earth-map__cap-section--f {
    color: var(--c-amber);
  }
  .earth-map__cap-sep {
    color: var(--c-ink-4);
  }

  /* === last-sync chrome (right-side cluster, preserved) === */
  .earth-map__cap-sync {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: var(--c-ink-2);
  }
  .earth-map__cap-badge {
    display: inline-block;
    padding: 1px 6px;
    border: 1px solid currentColor;
    font-weight: 600;
    font-size: 9px;
    letter-spacing: 0.14em;
    line-height: 1.4;
  }
  .earth-map__cap-badge--live {
    color: var(--c-warn);
  }
  .earth-map__cap-badge--fallback {
    color: var(--c-ink-3);
  }
  .earth-map__cap-sync-text {
    color: var(--c-ink-3);
  }
  .earth-map__cap-sync-ago {
    color: var(--c-ink);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
    font-weight: 600;
    min-width: 16px;
    text-align: right;
    display: inline-block;
  }
  .earth-map__cap-sync-stamp {
    color: var(--c-ink-3);
    margin-left: 6px;
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  @media (max-width: 720px) {
    .earth-map__cap-sync {
      margin-left: 0;
      flex-basis: 100%;
    }
  }

  /* === Reduced-motion guard (v7.7.0 vocabulary + new twinkle) === */
  @media (prefers-reduced-motion: reduce) {
    .earth-map__pulse,
    .earth-map__arc,
    .earth-map__subsolar-pulse,
    .earth-map__live--focus,
    .earth-map__gdelt--focus,
    .earth-map__stars {
      animation: none;
      opacity: 1;
    }
    .earth-map__stars {
      opacity: 0.6;
    }
    .earth-map__arc {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  /**
   * earth-sync + click-to-dive (v7.8) — deliberately framework-free so the
   * public /live ↔ /desk focus bus stays small and SSR-safe.
   */
  interface CountryFocusDetail {
    id: string;
    name: string;
    lat: number;
    lon: number;
  }
  interface VenueFocusDetail {
    city: string;
    lat: number;
    lon: number;
    caption: string;
  }
  interface FocusStorageValue {
    id?: string;
    ts?: number;
  }

  const FOCUS_DURATION_MS = 1200;
  const STORAGE_KEY = 'earth:focus:v1';
  const svg = document.querySelector<SVGSVGElement>('.earth-map__svg');
  const panel = document.querySelector<HTMLElement>('[data-focus-panel]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-focus-close]');
  const countryDetails = document.querySelector<HTMLElement>('[data-focus-country]');
  const venueDetails = document.querySelector<HTMLElement>('[data-focus-venue]');
  const focusTitle = document.querySelector<HTMLElement>('[data-focus-title]');
  const focusKind = document.querySelector<HTMLElement>('[data-focus-kind]');

  const setText = (selector: string, value: string): void => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };
  const closePanel = (): void => {
    if (!panel) return;
    panel.hidden = true;
    if (countryDetails) countryDetails.hidden = true;
    if (venueDetails) venueDetails.hidden = true;
  };
  const openPanel = (): void => {
    if (!panel) return;
    panel.hidden = false;
    panel.focus({ preventScroll: true });
  };

  function focusMarker(id: string | null | undefined): void {
    if (!id || !svg) return;
    const marker = svg.querySelector<SVGCircleElement>(`[data-event-id="${CSS.escape(id)}"]`);
    if (!marker) return;
    marker.classList.remove('earth-map__live--focus', 'earth-map__gdelt--focus');
    void marker.getBoundingClientRect();
    if (marker.classList.contains('earth-map__live')) {
      marker.classList.add('earth-map__live--focus');
    } else {
      marker.classList.add('earth-map__gdelt--focus');
    }
    window.setTimeout(() => {
      marker.classList.remove('earth-map__live--focus', 'earth-map__gdelt--focus');
    }, FOCUS_DURATION_MS);
  }

  const emitFocus = (target: Element): void => {
    const country = target.closest<SVGPathElement>('[data-country-id]');
    if (country) {
      const detail: CountryFocusDetail = {
        id: country.dataset.countryId ?? '',
        name: country.dataset.countryName ?? 'UNKNOWN COUNTRY',
        lat: Number(country.dataset.countryLat ?? '0'),
        lon: Number(country.dataset.countryLon ?? '0'),
      };
      window.dispatchEvent(
        new CustomEvent<CountryFocusDetail>('earth:country-focus', {
          detail,
          bubbles: true,
          composed: true,
        }),
      );
      return;
    }
    const venue = target.closest<SVGGElement>('[data-venue-city]');
    if (!venue) return;
    const detail: VenueFocusDetail = {
      city: venue.dataset.venueCity ?? 'UNKNOWN CITY',
      lat: Number(venue.dataset.venueLat ?? '0'),
      lon: Number(venue.dataset.venueLon ?? '0'),
      caption: venue.dataset.venueCaption ?? 'research venue',
    };
    window.dispatchEvent(
      new CustomEvent<VenueFocusDetail>('earth:venue-focus', {
        detail,
        bubbles: true,
        composed: true,
      }),
    );
  };

  svg?.addEventListener('click', (event: MouseEvent) => {
    if (event.target instanceof Element) emitFocus(event.target);
  });
  svg?.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key !== 'Enter' && event.key !== ' ') return;
    if (!(event.target instanceof Element)) return;
    event.preventDefault();
    emitFocus(event.target);
  });

  /* === v7.8.1 — JS-driven --hover (data-hover='1') state =============
     CSS :hover works on mouse; touch + programmatic focus need an
     explicit toggle. Mirrors the same custom-mono-label reveal used by
     :hover/:focus-visible. */
  type Hoverable = SVGPathElement | SVGGElement;
  const HOVER_TARGET_SELECTOR = '.earth-map__country-hitbox, .earth-map__venue';
  const hoverable = svg?.querySelectorAll<Hoverable>(HOVER_TARGET_SELECTOR) ?? null;
  const setHover = (target: Element, on: boolean): void => {
    const host = target.closest<Hoverable>(HOVER_TARGET_SELECTOR);
    if (!host) return;
    if (on) host.setAttribute('data-hover', '1');
    else host.removeAttribute('data-hover');
  };
  hoverable?.forEach((el) => {
    el.addEventListener('mouseenter', () => setHover(el, true));
    el.addEventListener('mouseleave', () => setHover(el, false));
    el.addEventListener('focus', () => setHover(el, true));
    el.addEventListener('blur', () => setHover(el, false));
    el.addEventListener('touchstart', () => setHover(el, true), { passive: true });
  });
  document.addEventListener(
    'touchstart',
    (event: TouchEvent) => {
      if (!svg) return;
      const t = event.target as Element | null;
      if (!t) return;
      if (t.closest(HOVER_TARGET_SELECTOR)) return;
      // Tap outside any hoverable → clear all data-hover
      hoverable?.forEach((el) => el.removeAttribute('data-hover'));
    },
    { passive: true },
  );

  window.addEventListener('earth:country-focus', (event: Event) => {
    const detail = (event as CustomEvent<CountryFocusDetail>).detail;
    if (!detail || !svg) return;
    const country = svg.querySelector<SVGPathElement>(
      `[data-country-id="${CSS.escape(detail.id)}"]`,
    );
    if (!country) return;
    const data = country.dataset;
    if (focusKind) focusKind.textContent = 'COUNTRY FOCUS';
    if (focusTitle) focusTitle.textContent = detail.name;
    setText('[data-focus-capital]', data.countryCapital ?? 'NOT INDEXED');
    setText('[data-focus-region]', data.countryRegion ?? 'ATLAS GEOMETRY');
    setText('[data-focus-timezone]', data.countryTimezone ?? 'UTC');
    setText('[data-focus-light]', data.countryLight ?? 'TERMINATOR');
    setText('[data-focus-points]', data.countryPoints ?? '0');
    if (countryDetails) countryDetails.hidden = false;
    if (venueDetails) venueDetails.hidden = true;
    openPanel();
  });

  window.addEventListener('earth:venue-focus', (event: Event) => {
    const detail = (event as CustomEvent<VenueFocusDetail>).detail;
    if (!detail || !svg) return;
    const venue = svg.querySelector<SVGGElement>(`[data-venue-city="${CSS.escape(detail.city)}"]`);
    if (!venue) return;
    const data = venue.dataset;
    if (focusKind) focusKind.textContent = 'VENUE FOCUS';
    if (focusTitle) focusTitle.textContent = detail.city;
    setText('[data-focus-caption]', data.venueCaption ?? detail.caption);
    setText('[data-focus-domains]', data.venueDomains ?? 'RESEARCH DATA');
    setText('[data-focus-arxiv]', data.venueArxiv ?? '0');
    setText('[data-focus-wire]', data.venueWire ?? '0');
    if (countryDetails) countryDetails.hidden = true;
    if (venueDetails) venueDetails.hidden = false;
    openPanel();
  });

  closeButton?.addEventListener('click', closePanel);
  document.addEventListener(
    'click',
    (event: MouseEvent) => {
      if (!panel || panel.hidden || !(event.target instanceof Element)) return;
      if (panel.contains(event.target)) return;
      if (event.target.closest('.earth-map__country-hitbox, .earth-map__venue')) return;
      closePanel();
    },
    true,
  );
  document.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape') closePanel();
  });

  window.addEventListener('earth:focus', (event: Event) => {
    const detail = (event as CustomEvent<{ id?: string }>).detail;
    if (!detail?.id) return;
    focusMarker(detail.id);
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({ id: detail.id, ts: Date.now() } satisfies FocusStorageValue),
      );
    } catch {
      /* localStorage may be unavailable in privacy mode. */
    }
  });

  window.addEventListener('storage', (event: StorageEvent) => {
    if (event.key !== STORAGE_KEY || !event.newValue) return;
    try {
      const parsed = JSON.parse(event.newValue) as FocusStorageValue;
      if (parsed.id && typeof parsed.ts === 'number' && Date.now() - parsed.ts < 2000) {
        focusMarker(parsed.id);
      }
    } catch {
      /* Ignore malformed cross-tab payloads. */
    }
  });

  /**
   * v7.9 split — load country paths at runtime.
   * Fetches /data/world-map-ortho.json and populates the empty
   * `.earth-map__hitbox` container. Cheap (1.05 MB) and lazy
   * (deferred until idle so it never competes with first paint).
   *
   * Each path carries the same data-country-* attributes the SSR
   * version used to emit, so the focus listeners wired up above
   * keep working without changes.
   */
  const countriesTarget = document.querySelector<SVGGElement>('[data-countries-target]');
  if (countriesTarget) {
    interface CountryOrthoJson {
      id: string;
      name: string;
      lat: number;
      lon: number;
      dGlobe: string;
    }
    const offsetForLon = (lon: number): number => Math.round(lon / 15);
    const tzFor = (lon: number): string => {
      const o = offsetForLon(lon);
      return `UTC${o >= 0 ? '+' : ''}${o}`;
    };
    const COUNTRY_META: Record<string, { capital: string; region: string }> = {
      '036': { capital: 'Canberra', region: 'Oceania' },
      '076': { capital: 'Brasília', region: 'South America' },
      '124': { capital: 'Ottawa', region: 'North America' },
      '156': { capital: 'Beijing', region: 'East Asia' },
      '250': { capital: 'Paris', region: 'Western Europe' },
      '276': { capital: 'Berlin', region: 'Central Europe' },
      '356': { capital: 'New Delhi', region: 'South Asia' },
      '392': { capital: 'Tokyo', region: 'East Asia' },
      '528': { capital: 'Amsterdam', region: 'Western Europe' },
      '608': { capital: 'Manila', region: 'Southeast Asia' },
      '702': { capital: 'Singapore', region: 'Southeast Asia' },
      '756': { capital: 'Bern', region: 'Central Europe' },
      '826': { capital: 'London', region: 'Western Europe' },
      '840': { capital: 'Washington, D.C.', region: 'North America' },
    };
    const metaFor = (id: string): { capital: string; region: string } =>
      COUNTRY_META[id] ?? { capital: 'NOT INDEXED', region: 'ATLAS GEOMETRY' };

    const populate = (countries: CountryOrthoJson[]): void => {
      const ns = 'http://www.w3.org/2000/svg';
      const frag = document.createDocumentFragment();
      const now = new Date();
      const subLat =
        (now.getMonth() > 2 || now.getMonth() < 9 ? 1 : -1) *
        23.5 *
        Math.cos(
          (2 * Math.PI * (now.getMonth() < 3 ? now.getMonth() + 9 : now.getMonth() - 3)) / 12,
        );
      const subLon = -(now.getUTCHours() - 12) * 15;
      const toRad = Math.PI / 180;
      const lightFor = (lat: number, lon: number): string => {
        const rel =
          Math.sin(lat * toRad) * Math.sin(subLat * toRad) +
          Math.cos(lat * toRad) * Math.cos(subLat * toRad) * Math.cos((lon - subLon) * toRad);
        if (rel > 0.25) return 'DAY';
        if (rel < -0.25) return 'NIGHT';
        return 'TERMINATOR';
      };
      for (const c of countries) {
        if (!c.dGlobe) continue;
        const path = document.createElementNS(ns, 'path');
        path.setAttribute('d', c.dGlobe);
        path.setAttribute('data-country-id', c.id);
        path.setAttribute('data-country-name', c.name);
        path.setAttribute('data-country-lat', String(c.lat));
        path.setAttribute('data-country-lon', String(c.lon));
        path.setAttribute('data-country-capital', metaFor(c.id).capital);
        path.setAttribute('data-country-region', metaFor(c.id).region);
        path.setAttribute('data-country-timezone', tzFor(c.lon));
        path.setAttribute('data-country-points', '0');
        path.setAttribute('data-country-light', lightFor(c.lat, c.lon));
        path.setAttribute('class', 'earth-map__country-hitbox');
        path.setAttribute('tabindex', '0');
        path.setAttribute('role', 'button');
        path.setAttribute('aria-label', `Focus ${c.name}`);
        frag.appendChild(path);
      }
      countriesTarget.appendChild(frag);
      // Re-attach hover listeners to the newly-injected hitboxes.
      const HOVER_TARGET_SELECTOR = '.earth-map__country-hitbox, .earth-map__venue';
      countriesTarget
        .querySelectorAll<SVGPathElement>('.earth-map__country-hitbox')
        .forEach((el) => {
          el.addEventListener('mouseenter', () => el.setAttribute('data-hover', '1'));
          el.addEventListener('mouseleave', () => el.removeAttribute('data-hover'));
          el.addEventListener('focus', () => el.setAttribute('data-hover', '1'));
          el.addEventListener('blur', () => el.removeAttribute('data-hover'));
          el.addEventListener('touchstart', () => el.setAttribute('data-hover', '1'), {
            passive: true,
          });
        });
      void HOVER_TARGET_SELECTOR;
    };
    const start = (): void => {
      fetch('/data/world-map-ortho.json')
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`))))
        .then(populate)
        .catch((err) => {
          console.warn('[earth-map] country paths failed to load', err);
        });
    };
    const w = window as Window & { requestIdleCallback?: (cb: () => void) => void };
    if (typeof w.requestIdleCallback === 'function') {
      w.requestIdleCallback(start);
    } else {
      w.setTimeout(start, 0);
    }
  }
</script>
