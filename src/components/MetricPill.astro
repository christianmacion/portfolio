---
/**
 * MetricPill.astro — single headline-metric pill.
 *
 * Tone maps to a numeric color token so the value's hue carries semantic
 * weight (e.g. amber accent for quant metrics, near-black for AI/structural).
 */
interface Props {
  label: string;
  value: string;
  sub?: string;
  tone?: 'brand' | 'accent' | 'gold' | 'data-pos';
}
const { label, value, sub, tone = 'brand' } = Astro.props;
/* v9.3 a11y 96 follow-up (2026-08-01) — accent tone was
   --c-primary-2-deep (dark: --j-cobalt-deep #475891) on dark page bg
   (#1a1714) = 2.61:1, failing WCAG 1.4.3 large-text 3:1. Promoted to
   --c-primary-2 (dark: --j-cobalt #5b6ba8) = 3.15:1 (pass). Light
   theme --j-cobalt #2c4a7e on #d4cebd = 6.10:1 (pass). */
const valueColor =
  tone === 'accent'
    ? 'var(--c-primary-2)'
    : tone === 'gold'
      ? 'var(--c-gold)'
      : tone === 'data-pos'
        ? 'var(--c-amber)'
        : 'var(--c-primary)';
---

<div class="metric">
  <div class="metric__value mono" style={`color: ${valueColor}`}>{value}</div>
  <div class="metric__label">{label}</div>
  {sub && <div class="metric__sub faint text-xs">{sub}</div>}
</div>

<style>
  .metric {
    padding: var(--sp-4);
    background: var(--c-bg);
    border: var(--border);
    /* v6.18 — rely on --j-r=0 via tokens-v6.13.css cascade */
    text-align: center;
  }
  .metric__value {
    font-size: var(--fs-2xl);
    font-weight: 600;
    line-height: 1;
    margin-bottom: var(--sp-2);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  .metric__label {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--c-ink-2);
  }
  .metric__sub {
    margin-top: var(--sp-2);
  }
</style>
