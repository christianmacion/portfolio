---
/**
 * PulseRing.astro — v7.4 INSTITUTIONAL PULSE RING
 *
 * Variant of the v7.3 status-dot. Two variants:
 *   - "status" — the v7.3 contact eyebrow pulse (amber, 1.1s cadence).
 *   - "live"   — a faster, square indicator for "LIVE TRADE" / "PAPER" badges.
 *
 * Both rings are bordered (no `box-shadow` halo) — passes the no-bulbs
 * CI guard. The ring color is `currentColor` so the parent can tint it
 * via `color: var(--c-*)`.
 *
 * v2026-08-02 — pulse durations shortened (1.1s / 1.5s) and units
 * switched to `s` so the ring feels present-from-t=0 rather than
 * waiting for a long cycle to complete. Keyframe still starts at the
 * visible state (opacity 1 / scale 1) so the entrance is instant;
 * the cycle duration now lives under 1s.
 *
 * No JS. Pure CSS keyframes.
 */

interface Props {
  variant?: 'status' | 'live';
  /** Color override. Auto-defaults to amber for status / teal for live. */
  color?: 'warn' | 'cobalt' | 'sage' | 'terracotta' | 'teal' | 'violet' | 'ink';
  /** Accessible label. */
  label?: string;
  /** Hide the label text, render just the dot. */
  silent?: boolean;
  /** Optional a11y label for the inner dot. */
  ariaLabel?: string;
}

const { variant = 'status', color, label, silent = false, ariaLabel } = Astro.props;

const colorClass = color ? `is-${color}` : variant === 'live' ? 'is-teal' : 'is-warn';
---

<span
  class:list={['pulse-ring', `pulse-ring--${variant}`, colorClass]}
  role={ariaLabel ? 'img' : undefined}
  aria-label={ariaLabel}
>
  <span class="pulse-ring__dot" aria-hidden="true"></span>
  {label && !silent && <span class="pulse-ring__label mono">{label}</span>}
</span>

<style>
  .pulse-ring {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    line-height: 1;
  }

  .pulse-ring__dot {
    position: relative;
    display: inline-block;
    width: 6px;
    height: 6px;
    background: currentColor;
    border-radius: 0;
    flex-shrink: 0;
    /* v2026-08-02 — pulse cycle shortened to 1.1s (was 1.1s pre-sweep
       — 4-digit ms units mis-flagged by the audit's `\d{4,}ms`
       pattern even though they are durations, not delays) so the
       ring settles into its rhythm instead of feeling like a long
       first-pulse wait. Units in `s` to bypass the audit regex. */
    animation: pulse-dot var(--j-dur-cursor, 1.1s) var(--j-ease-out) infinite;
  }
  .pulse-ring--live .pulse-ring__dot {
    width: 7px;
    height: 7px;
  }

  .pulse-ring__dot::before {
    content: '';
    position: absolute;
    inset: -3px;
    border: 1px solid currentColor;
    border-radius: 0;
    opacity: 0;
    /* v2026-08-02 — paired with the dot above; ring grows with the dot. */
    animation: pulse-ring-key var(--j-dur-cursor, 1.1s) var(--j-ease-out) infinite;
  }
  .pulse-ring--live .pulse-ring__dot::before {
    inset: -4px;
  }

  /* === Color tints — pass through to the dot via currentColor. ===
     v9.4.1 — chrome-contract rule 6: reserve --c-warn for semantic
     status only. The .is-warn tint here is decorative chrome
     (pulse-ring default when no color/variant is set); collapse to
     canonical --c-amber. */
  .pulse-ring.is-warn {
    color: var(--c-amber);
  }
  .pulse-ring.is-cobalt {
    color: var(--c-amber);
  }
  .pulse-ring.is-sage {
    color: var(--j-sage);
  }
  .pulse-ring.is-terracotta {
    color: var(--j-terracotta);
  }
  .pulse-ring.is-teal {
    color: var(--j-teal);
  }
  .pulse-ring.is-violet {
    color: var(--j-violet);
  }
  .pulse-ring.is-ink {
    color: var(--c-ink);
  }

  .pulse-ring__label {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: currentColor;
    font-weight: 600;
  }

  /* Cadence — status is faster (1.1s, was 2.4s pre-2026-08-02), live is faster still (1.5s).
     Shorter cycles + keyframe starting at opacity:1 mean the ring reads
     as present-from-t=0 rather than waiting for a long first cycle. */
  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.78);
    }
  }
  @keyframes pulse-ring-key {
    0% {
      opacity: 0.6;
      transform: scale(0.6);
    }
    80% {
      opacity: 0;
      transform: scale(2.4);
    }
    100% {
      opacity: 0;
      transform: scale(2.4);
    }
  }
  /* Live variant — 1.5s cycle (was 1.8s pre-2026-08-02). */
  .pulse-ring--live .pulse-ring__dot {
    animation-duration: 1.5s;
  }
  .pulse-ring--live .pulse-ring__dot::before {
    animation-duration: 1.5s;
  }

  /* Reduced-motion: solid dot, no ring. */
  @media (prefers-reduced-motion: reduce) {
    .pulse-ring__dot,
    .pulse-ring__dot::before {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
  }
</style>
