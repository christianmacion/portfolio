---
/**
 * PulseRing.astro — v7.4 INSTITUTIONAL PULSE RING (RETIRED v6.18 W2)
 *
 * v6.18 W2 lock (2026-08-08): the pulse-ring animation is RETIRED
 * per [[feedback-no-status-indicators-signal-lights]] BINDING.
 * Components that previously used <PulseRing> should swap to a plain
 * static `<span class="pulse-ring pulse-ring--static">` element with
 * no animation. The component is preserved here for back-compat with
 * any page that hasn't migrated yet — it now renders a STATIC dot
 * (no infinite pulse, no opacity oscillation, no scale animation).
 *
 * The variant prop is still accepted but ignored; the dot is always
 * a 6×6 amber square. The label, color, and ariaLabel props still
 * apply (semantic a11y, not animation).
 *
 * NO JS. NO keyframes. NO infinite animations.
 */

interface Props {
  /** Deprecated — variant ignored post-W2. Kept for back-compat. */
  variant?: 'status' | 'live';
  /** Color override. Auto-defaults to amber. */
  color?: 'warn' | 'cobalt' | 'sage' | 'terracotta' | 'teal' | 'violet' | 'ink';
  /** Accessible label. */
  label?: string;
  /** Hide the label text, render just the dot. */
  silent?: boolean;
  /** Optional a11y label for the inner dot. */
  ariaLabel?: string;
}

const { color, label, silent = false, ariaLabel } = Astro.props;

const colorClass = color ? `is-${color}` : 'is-warn';
---

<span
  class:list={['pulse-ring', 'pulse-ring--static', colorClass]}
  role={ariaLabel ? 'img' : undefined}
  aria-label={ariaLabel}
>
  <span class="pulse-ring__dot" aria-hidden="true"></span>
  {label && !silent && <span class="pulse-ring__label mono">{label}</span>}
</span>

<style>
  .pulse-ring {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    line-height: 1;
  }

  /* === v6.18 W2 lock (2026-08-08): STATIC dot. NO animation.
     All previous infinite pulse keyframes are removed. The dot is
     a plain 6×6 square in currentColor. === */
  .pulse-ring__dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: currentColor;
    border-radius: 0;
    flex-shrink: 0;
    /* No transform-origin, no animation. Static. */
  }

  /* === Color tints — pass through to the dot via currentColor. === */
  .pulse-ring.is-warn {
    color: var(--c-amber);
  }
  .pulse-ring.is-cobalt {
    color: var(--c-amber);
  }
  .pulse-ring.is-sage {
    color: var(--j-sage);
  }
  .pulse-ring.is-terracotta {
    color: var(--j-terracotta);
  }
  .pulse-ring.is-teal {
    color: var(--j-teal);
  }
  .pulse-ring.is-violet {
    color: var(--j-violet);
  }
  .pulse-ring.is-ink {
    color: var(--c-ink);
  }

  .pulse-ring__label {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: currentColor;
    font-weight: 600;
  }

  /* === Belt-and-suspender: even though the dot is static, declare
     prefers-reduced-motion neutral so any future regression that
     re-introduces an animation is nilled at the source. === */
  @media (prefers-reduced-motion: reduce) {
    .pulse-ring__dot {
      animation: none !important;
    }
  }
</style>
