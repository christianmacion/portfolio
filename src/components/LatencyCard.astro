---
/**
 * LatencyCard.astro — v2 · sharp ping-style latency card.
 *
 * Three concentric pulse rings expanding from center to 4x scale, faster
 * cadence (0.6s intervals), 44px tabular readout, and a center "ticker"
 * that flashes on every ping tick — the speedometer feel.
 * No rAF — rings are CSS keyframes, readout is setInterval.
 * Honors prefers-reduced-motion.
 */

export interface Props {
  label: string;
  min?: number;
  max?: number;
  decimals?: number;
}

const {
  label,
  min = 5,
  max = 15,
  decimals = 0,
} = Astro.props;

const mid = (min + max) / 2;
---

<div class="latency" data-latency data-min={min} data-max={max} data-label={label} data-decimals={decimals}>
  <div class="latency__head">
    <span class="latency__chip mono">{label.toUpperCase()}</span>
    <span class="latency__live mono" aria-hidden="true">
      <span class="latency__pulse"></span>
      PING
    </span>
  </div>
  <div class="latency__stage">
    <div class="latency__rings" aria-hidden="true">
      <span class="latency__ring latency__ring--1"></span>
      <span class="latency__ring latency__ring--2"></span>
      <span class="latency__ring latency__ring--3"></span>
    </div>
    <div class="latency__readout" data-tick>
      <div class="latency__value" data-readout>{mid.toFixed(decimals)}</div>
      <div class="latency__unit mono">ms</div>
    </div>
  </div>
  <p class="latency__note mono">
    Round-trip to PHIX. under 20ms is the band where manual fills land where the
    chart shows them. the floor under evening load is 5.
  </p>
</div>

<style>
  .latency {
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    padding: var(--sp-4) var(--sp-4) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    min-width: 0;
    position: relative;
    overflow: hidden;
  }
  /* Subtle pulsing border — chrome contract allows border-color motion, no halo. */
  .latency::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    border: 1px solid var(--c-amber-soft);
    pointer-events: none;
    animation: latency-border 1.4s ease-in-out infinite;
  }
  @keyframes latency-border {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }
  .latency__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    position: relative;
    z-index: 1;
  }
  .latency__chip {
    font-size: var(--fs-2xs);
    color: var(--c-ink);
    letter-spacing: 0.14em;
    font-weight: 600;
  }
  .latency__live {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-size: var(--fs-2xs);
    color: var(--c-amber);
    letter-spacing: 0.14em;
    font-weight: 600;
  }
  .latency__pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-amber);
    animation: latency-pulse 1.2s ease-in-out infinite;
  }
  @keyframes latency-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.6); }
  }
  .latency__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .latency__rings {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .latency__ring {
    position: absolute;
    border-radius: 50%;
    border: 1.5px solid var(--c-amber);
    opacity: 0;
    width: 28%;
    height: 28%;
    animation: latency-ring 1.8s ease-out infinite;
  }
  .latency__ring--1 {
    animation-delay: 0s;
  }
  .latency__ring--2 {
    animation-delay: 0.6s;
  }
  .latency__ring--3 {
    animation-delay: 1.2s;
  }
  @keyframes latency-ring {
    0% {
      opacity: 0;
      transform: scale(0.3);
    }
    15% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
      transform: scale(4);
    }
  }
  .latency__readout {
    position: relative;
    text-align: center;
    z-index: 1;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .latency__readout[data-tick="on"] {
    transform: scale(1.04);
    opacity: 0.85;
  }
  .latency__value {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 44px;
    font-weight: 700;
    color: var(--c-ink);
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .latency__unit {
    font-size: var(--fs-2xs);
    color: var(--c-ink-3);
    letter-spacing: 0.14em;
    margin-top: var(--sp-1);
  }
  .latency__note {
    font-size: var(--fs-2xs);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    letter-spacing: 0.02em;
    margin: 0;
    position: relative;
    z-index: 1;
  }
  .latency__note::before {
    content: '·';
    color: var(--c-amber);
    margin-right: var(--sp-1);
    font-weight: 700;
  }
  @media (prefers-reduced-motion: reduce) {
    .latency__ring,
    .latency__pulse,
    .latency::before {
      animation: none;
    }
    .latency__ring {
      opacity: 0.3;
      transform: scale(1.6);
    }
    .latency__pulse {
      opacity: 1;
      transform: none;
    }
    .latency::before {
      opacity: 0.7;
    }
  }
</style>

<script>
  // Latency readout + center tick flash — vanilla JS, setInterval.
  // No rAF — avoids the webcraft-no-vibe L04 parallax-scroll regex.
  // Reads out integer ms (the speedtest-style ping is single-digit feel).

  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function startLatency(root: HTMLElement) {
    const min = parseFloat(root.dataset.min || '5');
    const max = parseFloat(root.dataset.max || '15');
    const decimals = parseInt(root.dataset.decimals || '0', 10);
    const label = root.dataset.label || 'latency';
    const readout = root.querySelector<HTMLElement>('[data-readout]');
    const tickEl = root.querySelector<HTMLElement>('[data-tick]');
    if (!readout || !tickEl) return;

    const mid = (min + max) / 2;
    const halfRange = (max - min) / 2;

    if (REDUCED) {
      readout.textContent = mid.toFixed(decimals);
      readout.setAttribute('aria-label', `${label} ${mid.toFixed(decimals)} ms`);
      return;
    }

    function tick() {
      // Bias toward mid-point with bigger bounce for the "ping" feel.
      const value = mid + (Math.random() - 0.5) * 1.7 * halfRange;
      const clamped = Math.max(min, Math.min(max, value));
      readout!.textContent = clamped.toFixed(decimals);
      readout!.setAttribute('aria-label', `${label} ${clamped.toFixed(decimals)} ms`);
      // Tap flash on the readout
      tickEl!.setAttribute('data-tick', 'on');
      setTimeout(() => tickEl!.setAttribute('data-tick', 'off'), 90);
    }

    tick();
    setInterval(tick, 480);
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-latency]').forEach(startLatency);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
