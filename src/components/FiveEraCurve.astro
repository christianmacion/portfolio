---
/**
 * FiveEraCurve.astro : v11.W4 · 5-era out-of-sample stability curve.
 *
 * Visual: 1px equity curve across 5 era bands (2018-2019, 2020, 2021, 2022,
 * 2023-2024). Era boundary markers as 1px amber vertical hairlines with 6px
 * dot at the curve intersection. Regime classification strip below.
 *
 * Tetlock calibration: every era carries n_trades + Sharpe + DD + period.
 * Reveal: 240ms ease-out draw-on + 400ms stagger for boundary dots.
 * Reduced-motion: snap to terminal state.
 *
 * Chrome contract: 1px amber accent only, sharp 0-2px corners, hairline 1px,
 * cream background, navy ink.
 *
 * Numbers are placeholders for design layout. Production values swap in
 * from src/data/profile.ts when backtested Sharpe/DD are verified.
 */
type Era = {
  label: string;
  period: string;
  n: number;
  sharpe: number;
  dd: number;
  regime: string;
};

const eras: Era[] = [
  { label: 'Era 1', period: '2018-2019', n: 4200, sharpe: 1.42, dd: -8.1, regime: 'pre-COVID bull' },
  { label: 'Era 2', period: '2020',      n: 2800, sharpe: 2.18, dd: -14.3, regime: 'COVID crash + recovery' },
  { label: 'Era 3', period: '2021',      n: 3100, sharpe: 0.94, dd: -11.2, regime: 'meme / retail frenzy' },
  { label: 'Era 4', period: '2022',      n: 3500, sharpe: 1.71, dd: -9.8, regime: 'rates hiking' },
  { label: 'Era 5', period: '2023-2024', n: 4100, sharpe: 1.55, dd: -7.4, regime: 'regime normalize' },
];

const totalN = eras.reduce((s, e) => s + e.n, 0);
const avgSharpe = eras.reduce((s, e) => s + e.sharpe, 0) / eras.length;
const avgDD = eras.reduce((s, e) => s + e.dd, 0) / eras.length;
---

<section class="fiveera" aria-labelledby="fiveera-title">
  <header class="fiveera__head">
    <p class="kicker mono">STRATEGY VALIDATION · 5-ERA STABILITY</p>
    <h2 id="fiveera-title" class="fiveera__title">5 eras. 17,700 trades. Deflated Sharpe 0.42 to 1.18 across regimes.</h2>
    <p class="fiveera__sub">Out-of-sample walk-forward validation. Block-bootstrap CIs. CSCV-based PBO. All 5 eras positive.</p>
  </header>

  <div class="fiveera__viz" role="img" aria-label="5-era equity curve. 5 eras between 2018 and 2024. All positive. Average Sharpe 1.56. Average max drawdown 10.16 percent.">
    <svg viewBox="0 0 720 240" preserveAspectRatio="xMidYMid meet" class="fiveera__svg" aria-hidden="true">
      <line x1="0"   y1="60"  x2="720" y2="60"  class="fiveera__grid" />
      <line x1="0"   y1="120" x2="720" y2="120" class="fiveera__grid" />
      <line x1="0"   y1="180" x2="720" y2="180" class="fiveera__grid" />

      <line x1="144" y1="0"   x2="144" y2="240" class="fiveera__era fiveera__era--1" />
      <line x1="288" y1="0"   x2="288" y2="240" class="fiveera__era fiveera__era--2" />
      <line x1="432" y1="0"   x2="432" y2="240" class="fiveera__era fiveera__era--3" />
      <line x1="576" y1="0"   x2="576" y2="240" class="fiveera__era fiveera__era--4" />

      <path d="M0,180 L72,160 L144,140 L216,90 L288,110 L360,135 L432,120 L504,90 L576,80 L648,55 L720,40"
            class="fiveera__curve" />

      <circle cx="144" cy="140" r="3" class="fiveera__dot" />
      <circle cx="288" cy="110" r="3" class="fiveera__dot" />
      <circle cx="432" cy="120" r="3" class="fiveera__dot" />
      <circle cx="576" cy="80"  r="3" class="fiveera__dot" />
      <circle cx="720" cy="40"  r="3" class="fiveera__dot fiveera__dot--terminal" />
    </svg>

    <ol class="fiveera__regime">
      <li>BULL</li>
      <li>CRASH</li>
      <li>FRENZY</li>
      <li>HIKING</li>
      <li>NORMALIZE</li>
    </ol>
  </div>

  <div class="fiveera__table-wrap">
    <table class="fiveera__table">
      <thead>
        <tr>
          <th>Era</th>
          <th>Period</th>
          <th>Regime</th>
          <th class="num">N trades</th>
          <th class="num">Sharpe</th>
          <th class="num">Max DD</th>
        </tr>
      </thead>
      <tbody>
        {eras.map((e) => (
          <tr>
            <td class="mono">{e.label}</td>
            <td class="mono">{e.period}</td>
            <td>{e.regime}</td>
            <td class="mono num">{e.n.toLocaleString()}</td>
            <td class="mono num">{e.sharpe.toFixed(2)}</td>
            <td class="mono num">{e.dd.toFixed(1)}%</td>
          </tr>
        ))}
        <tr class="fiveera__total">
          <td>Aggregate</td>
          <td>2018-2024</td>
          <td>5 regimes</td>
          <td class="mono num">{totalN.toLocaleString()}</td>
          <td class="mono num">{avgSharpe.toFixed(2)} avg</td>
          <td class="mono num">{avgDD.toFixed(1)}% avg</td>
        </tr>
      </tbody>
    </table>
  </div>

  <footer class="fiveera__foot">
    <p class="fiveera__caption mono">
      5-Era OOS STABILITY · DEFLATED SHARPE · BLOCK-BOOTSTRAP CIs · CSCV-BASED PBO ·
      17,700 TRADES · ALL 5 ERAS POSITIVE · DD avg -10.2%
    </p>
    <p class="fiveera__caveat mono">
      ILLUSTRATIVE VALUES FOR DESIGN LAYOUT · PRODUCTION NUMBERS PENDING BACKTEST VERIFICATION
    </p>
  </footer>
</section>

<style>
  .fiveera {
    /* FiveEraCurve is a 'paper' callout panel : dark elevated surface with cream ink.
       Use --j-paper / --j-paper-ink directly so both dark and light chrome themes resolve
       to the same dark-paper treatment (--c-paper aliases to --j-bg-elev which flips to
       cream in light mode, breaking the dark-panel pattern). */
    --fiveera-bg: var(--j-paper, #2a2622);
    --fiveera-ink: var(--j-paper-ink, #d4cebd);
    --fiveera-ink-2: #c4bfb1;
    --fiveera-ink-3: #9a9486;
    --fiveera-rule: var(--j-ink-4, #4a4438);
    --fiveera-amber: var(--c-amber);
  }
  .fiveera { padding: 64px 24px; background: var(--fiveera-bg); border-top: 1px solid var(--fiveera-rule); border-bottom: 1px solid var(--fiveera-rule); color: var(--fiveera-ink); }
  .fiveera__head { max-width: 880px; margin: 0 auto 32px; }
  .fiveera__head .kicker { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fiveera-ink-2); border-left: 2px solid var(--fiveera-amber); padding-left: 8px; margin: 0 0 12px; }
  .fiveera__title { font-family: Inter, system-ui, sans-serif; font-size: clamp(24px, 3vw, 36px); font-weight: 600; line-height: 1.18; margin: 0 0 12px; color: var(--fiveera-ink); }
  .fiveera__sub { font-size: 14px; color: var(--fiveera-ink-2); margin: 0; }

  .fiveera__viz { max-width: 880px; margin: 0 auto 24px; }
  .fiveera__svg { width: 100%; height: auto; display: block; }
  .fiveera__grid { stroke: var(--fiveera-rule); stroke-width: 1; stroke-dasharray: 2 4; }
  .fiveera__era { stroke: var(--fiveera-ink-3); stroke-width: 1; stroke-dasharray: 1 3; opacity: 0.5; }
  .fiveera__curve { fill: none; stroke: var(--fiveera-amber); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1000; stroke-dashoffset: 1000; animation: fiveera-draw 1200ms ease-out 200ms forwards; }
  .fiveera__dot { fill: var(--fiveera-amber); opacity: 0; animation: fiveera-fade 400ms ease-out 600ms forwards; }
  .fiveera__dot--terminal { opacity: 0; animation: fiveera-fade 600ms ease-out 1400ms forwards; }

  @keyframes fiveera-draw { to { stroke-dashoffset: 0; } }
  @keyframes fiveera-fade { to { opacity: 1; } }

  .fiveera__regime { list-style: none; padding: 0; margin: 8px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.08em; color: var(--fiveera-ink-2); text-align: center; }
  .fiveera__regime li { padding: 6px 0; border-top: 1px solid var(--fiveera-rule); }

  .fiveera__table-wrap { max-width: 880px; margin: 24px auto 0; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .fiveera__table { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 13px; }
  .fiveera__table th, .fiveera__table td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--fiveera-rule); color: var(--fiveera-ink); }
  .fiveera__table th { font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fiveera-ink-2); font-weight: 500; }
  .fiveera__table .num { text-align: right; }
  .fiveera__total { background: rgba(201, 138, 22, 0.06); font-weight: 600; }
  .fiveera__total td { color: var(--fiveera-ink); border-top: 1px solid var(--fiveera-amber); }

  .fiveera__foot { max-width: 880px; margin: 24px auto 0; }
  .fiveera__caption { font-size: 11px; letter-spacing: 0.08em; color: var(--fiveera-ink-2); margin: 0 0 4px; font-weight: 500; }
  .fiveera__caveat { font-size: 10px; letter-spacing: 0.06em; color: var(--fiveera-ink-2); margin: 0; font-weight: 600; opacity: 0.85; }

  @media (max-width: 600px) {
    .fiveera { padding: 40px 16px; }
    .fiveera__table { table-layout: fixed; font-size: 11px; }
    .fiveera__table th, .fiveera__table td { padding: 6px 8px; word-break: break-word; overflow-wrap: anywhere; }
    .fiveera__table th:nth-child(1), .fiveera__table td:nth-child(1) { width: 56px; }
    .fiveera__table th:nth-child(2), .fiveera__table td:nth-child(2) { width: 78px; }
    .fiveera__table th:nth-child(3), .fiveera__table td:nth-child(3) { width: auto; }
    .fiveera__table th:nth-child(4), .fiveera__table td:nth-child(4) { width: 70px; }
    .fiveera__table th:nth-child(5), .fiveera__table td:nth-child(5) { width: 56px; }
    .fiveera__table th:nth-child(6), .fiveera__table td:nth-child(6) { width: 64px; }
  }

  @media (max-width: 480px) {
    .fiveera__regime { font-size: 9px; letter-spacing: 0.04em; }
    .fiveera__regime li { padding: 4px 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fiveera__curve { stroke-dasharray: none; stroke-dashoffset: 0; animation: none; }
    .fiveera__dot { opacity: 1; animation: none; }
  }
</style>
