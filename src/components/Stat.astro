---
/**
 * Stat.astro : a "metric tile": big mono number + label + sub + optional sparkline.
 *
 * Usage:
 *   <Stat value="31" label="eval gates" sub="G1-G31 statistical harness" />
 *   <Stat value="0.886" label="recall@3" sub="on 800-query benchmark" spark={[...]} />
 */
import Sparkline from '@components/Sparkline.astro';
import katex from 'katex';
import '@components/KatexStyles.astro';

interface Props {
  value: string;
  label: string;
  sub?: string;
  spark?: number[];
  sparkColor?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  trend?: 'up' | 'down' | 'flat';
  variant?: 'default' | 'primary' | 'accent' | 'mono';
  formula?: string;
}
const {
  value,
  label,
  sub,
  spark,
  sparkColor,
  size = 'md',
  trend,
  variant = 'default',
  formula,
} = Astro.props;
const trendGlyph = trend === 'up' ? '↑' : trend === 'down' ? '↓' : trend === 'flat' ? '→' : '';
const trendClass = trend ? `stat--trend-${trend}` : '';
// Wire the odometer only when the value is parseable as a number (e.g.,
// "31", "76.5k", "0.886"). The driver reads `data-counter` and animates
// 0 → parseFloat(value) over 1.2s, then snaps to the exact final string
// so suffixes like "k" or "%" are preserved.
const counterTarget = Number.isFinite(Number.parseFloat(value)) ? value : null;
let formulaHtml = '';
if (formula) {
  try {
    formulaHtml = katex.renderToString(formula, {
      displayMode: false,
      throwOnError: false,
      output: 'html',
      strict: 'ignore',
      trust: false,
    });
  } catch {
    formulaHtml = formula;
  }
}
---

<div class:list={['stat', `stat--${size}`, `stat--${variant}`, trendClass]}>
  <div class="stat__head">
    <span class="stat__label">{label}</span>
    {formula && <span class="stat__formula" set:html={formulaHtml} />}
  </div>
  <div class="stat__value-row">
    {
      counterTarget !== null ? (
        <span class="stat__value mono" data-counter={counterTarget}>
          {value}
        </span>
      ) : (
        <span class="stat__value mono">{value}</span>
      )
    }
    {
      trendGlyph && (
        <span class="stat__trend" aria-hidden="true">
          {trendGlyph}
        </span>
      )
    }
    {
      spark && (
        <span class="stat__spark">
          <Sparkline points={spark} stroke={sparkColor ?? 'var(--c-amber)'} fill="gradient" />
        </span>
      )
    }
  </div>
  {sub && <div class="stat__sub">{sub}</div>}
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-4) var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }
  .stat:hover {
    border-color: var(--c-ink-3);
    box-shadow: var(--shadow-sm);
    /* v6.18 W2 polish (2026-08-08): Bryllim card-hover-lift. */
    transform: translateY(-1px);
  }
  @media (prefers-reduced-motion: reduce) {
    .stat:hover {
      transform: none;
    }
  }
  .stat__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-2);
  }
  .stat__label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-ink-2);
    font-weight: 600;
  }
  .stat__formula {
    /* v9.9.1 : was var(--c-amber) + opacity:0.85, which alpha-blends to
       #7e683b over --c-bg-2 (#f3ede1) → 4.25:1 (light theme) : fails
       WCAG 2.2 AA 4.5:1. Swapped to var(--c-ink-2) (#3d4a5e light /
       #c4bfb1 dark) with full opacity → 7.18:1 / 7.71:1 : both AAA. */
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: 1;
  }
  .stat__value-row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }
  .stat__value {
    font-weight: 600;
    color: var(--c-primary);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  .stat--sm .stat__value {
    font-size: var(--fs-xl);
  }
  .stat--md .stat__value {
    font-size: var(--fs-2xl);
  }
  .stat--lg .stat__value {
    font-size: var(--fs-3xl);
  }
  .stat--xl .stat__value {
    font-size: var(--fs-display);
  }
  .stat__trend {
    font-family: var(--ff-mono);
    font-weight: 600;
    font-size: var(--fs-lg);
  }
  /* v6.11.18 : F14 amber-only migration. Was var(--c-pass) / var(--c-fail);
     every chrome element across Man Group / Renaissance / AQR / Bridgewater
     uses monochrome amber + ink. Trend-up is amber-light (bright, advancing),
     trend-down is ink-3 (dimmed, receding); same hue family, sign lives in
     the glyph (▲/▼) rather than in hue. v6.11.11 CI gate will flag the old
     var(--c-pass) / var(--c-fail) refs. */
  .stat--trend-up .stat__trend {
    color: var(--c-amber-light);
  }
  .stat--trend-down .stat__trend {
    color: var(--c-ink-3);
  }
  .stat--trend-flat .stat__trend {
    color: var(--c-ink-2);
  }
  .stat__spark {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }
  .stat__sub {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
  }

  /* === Variants === */
  .stat--primary {
    background: var(--c-tape);
    border-color: var(--c-amber);
  }
  .stat--primary .stat__label {
    color: var(--c-ink-faint);
  }
  .stat--primary .stat__value {
    color: var(--c-primary);
  }
  .stat--primary .stat__sub {
    color: var(--c-ink-mist);
  }

  /* v6.9.16 : institutional: drop the amber linear-gradient background.
     Variant reads as "tape panel" not "amber panel" : opacity hierarchy
     via --c-bg-2 + amber-deep border is enough. */
  .stat--accent {
    background: var(--c-bg-2);
    border-color: var(--c-amber);
  }

  .stat--mono {
    background: var(--c-tape);
    border-color: var(--c-tape-2);
  }
  .stat--mono .stat__label {
    color: var(--c-white-ghost);
  }
  /* v6.11.18.1 : F14 sweep. Was a hardcoded green (#3fb950) : traffic-
     light signal. Mono variant now uses the institutional amber token. */
  .stat--mono .stat__value {
    color: var(--c-amber);
  }
  .stat--mono .stat__sub {
    color: var(--c-white-ghost);
  }
  .stat--mono .stat__formula {
    color: var(--c-warn);
  }
</style>
