---
/**
 * MarketTape.astro : v12 live-data Bloomberg-terminal tape.
 *
 * Server-renders with deterministic seeded values so first paint shows a
 * plausible tape without flash. After hydration, a JS module fetches
 * /api/market/ticker every 60s and replaces the inner track with live
 * Yahoo + CoinGecko + ECB quotes. Each item carries a `data-source`
 * attribute so the chrome (and axe-debug, and copy-paste reviewers) can
 * see which upstream is feeding it.
 *
 * The trailing `lastSync HH:MM:SSZ` badge sits at the right edge and
 * updates on every refresh, so visitors can see the freshness directly.
 *
 * Constraints (BINDING per Owner directive + chrome contract):
 *   - NO em-dashes anywhere in user-visible text
 *   - NO halo / glow / gradient / box-shadow with non-zero blur
 *   - NO signal-lights / pulse rings / "available" dots
 *   - WCAG 2.2 AA contrast; amber-only sentiment (F14)
 *
 * Usage:
 *   <MarketTape />                                    // default 16 symbols (seeded)
 *   <MarketTape symbols={[{sym, px, deltaPct, vol}]} /> // per-page override
 */
import { seedFromString, walk, formatPx, formatPct, buildSeed } from '@utils/prng';
import { INDEX_SEEDS, getIndexSnap } from '@utils/markets-data';

interface Symbol {
  sym: string;
  px: number;
  deltaPct: number;
  vol?: string;
  /** Optional data-source attribution (yahoo | coingecko | ecb). */
  source?: 'yahoo' | 'coingecko' | 'ecb' | 'static';
}
interface Props {
  symbols?: Symbol[];
  /** Seconds for one full track traversal. Default 60. */
  durationSec?: number;
  /** Stop label shown on right edge (e.g., "BUILD_DATE 2026-07-10"). */
  trailing?: string;
}
const {
  symbols,
  durationSec = 60,
  trailing = 'series seeded from BUILD_DATE for reproducibility',
} = Astro.props;

const rng = seedFromString(buildSeed() + '::tape');

const stratSeeds: { id: string; ticker: string; base: number; sigma: number }[] = [
  { id: '01-deflated-sharpe', ticker: '01·DEFLATED', base: 100, sigma: 1.6 },
  { id: '02-cross-sectional-momentum', ticker: '02·XS-MOM', base: 100, sigma: 1.4 },
  { id: '03-timeseries-momentum-voltarget', ticker: '03·TSM-VT', base: 100, sigma: 1.1 },
  { id: '04-variance-risk-premium', ticker: '04·VRP', base: 100, sigma: 1.7 },
  { id: '05-pairs-cointegration', ticker: '05·PAIRS', base: 100, sigma: 0.7 },
  { id: '06-funding-carry', ticker: '06·CARRY', base: 100, sigma: 0.9 },
  { id: '07-macro-regime-overlay', ticker: '07·MACRO', base: 100, sigma: 1.3 },
  { id: '08-backtest-engine-costs', ticker: '08·BT-COST', base: 100, sigma: 1.5 },
  { id: '09-lookahead-bias-audit', ticker: '09·LOOKAHD', base: 100, sigma: 0.4 },
];

const indexSeeds = INDEX_SEEDS;

const defaultSymbols: Symbol[] = [];

for (const s of stratSeeds) {
  const series = walk(rng, s.base, s.sigma, 100);
  const px = +series[series.length - 1].toFixed(2);
  const deltaPct = +(((px - s.base) / s.base) * 100).toFixed(2);
  defaultSymbols.push({ sym: s.ticker, px, deltaPct, vol: 'σ' + s.sigma.toFixed(1), source: 'static' });
}
for (const i of indexSeeds) {
  const snap = getIndexSnap(i.sym);
  if (!snap) continue;
  defaultSymbols.push({
    sym: snap.sym,
    px: snap.px,
    deltaPct: snap.deltaPct,
    vol: snap.volUnit,
    source: 'static',
  });
}

const items = (symbols ?? defaultSymbols).map((it) => ({
  ...it,
  pxStr: formatPx(it.px, it.px >= 1000 ? 2 : 2),
  deltaStr: formatPct(it.deltaPct),
  // F14 amber-only rule. Sign carried by intensity (bright vs soft amber),
  // not hue. No green/red traffic-light.
  colorClass: Math.abs(it.deltaPct) < 0.005 ? 'muted' : it.deltaPct > 0 ? 'pass' : 'fail',
}));

const idByTicker = new Map(stratSeeds.map((s) => [s.ticker, s.id] as const));

const stop = trailing;
---

<div
  class="tape"
  role="region"
  aria-label="Live market tape"
  data-component="market-tape"
  data-live-url="/api/market/ticker"
>
  <div class="tape__viewport">
    <div class="tape__track" style={`--tape-dur: ${durationSec}s`} data-track>
      {
        [...items, ...items].map((it) => {
          const projectId = idByTicker.get(it.sym);
          return (
            <a
              class:list={['tape__item', `tape__item--${it.colorClass}`]}
              href={projectId ? `/projects/quant/${projectId}` : undefined}
              data-source={it.source ?? 'static'}
            >
              <span class="tape__sym mono">{it.sym}</span>
              <span class="tape__px mono">{it.pxStr}</span>
              <span class="tape__delta mono">{it.deltaStr}</span>
              {it.vol && <span class="tape__vol mono">{it.vol}</span>}
            </a>
          );
        })
      }
    </div>
  </div>
  <div class="tape__stop mono" aria-hidden="true" data-stop>
    <span class="tape__stop-label">{stop}</span>
    <span class="tape__stop-sep" aria-hidden="true">·</span>
    <time class="tape__stop-sync mono" data-last-sync datetime="">
      sync pending
    </time>
  </div>
</div>

<script>
  // Live ticker refresh - fetch /api/market/ticker every 60s, replace
  // the track with fresh quotes. The chrome (data-source attribution,
  // lastSync badge) updates in place; the scroll keyframe keeps running.

  type TickerItem = {
    sym: string;
    px: number;
    deltaPct: number;
    source: 'yahoo' | 'coingecko' | 'ecb';
    currency?: string;
    label?: string;
  };

  type TickerResponse = {
    ok: true;
    items: TickerItem[];
    lastSync: string;
    sources: { yahoo: string | null; coingecko: string | null; ecb: string | null };
    status: { yahoo: 'live' | 'cached' | 'error'; coingecko: 'live' | 'cached' | 'error'; ecb: 'live' | 'cached' | 'error' };
  };

  function formatPx(px: number): string {
    if (px >= 1000) return px.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    if (px >= 1) return px.toFixed(4).replace(/\.?0+$/, '');
    return px.toFixed(2);
  }

  function formatPct(pct: number): string {
    if (Math.abs(pct) < 0.005) return '0.00%';
    const sign = pct > 0 ? '+' : '';
    return `${sign}${pct.toFixed(2)}%`;
  }

  function colorClass(pct: number): 'muted' | 'pass' | 'fail' {
    if (Math.abs(pct) < 0.005) return 'muted';
    return pct > 0 ? 'pass' : 'fail';
  }

  function isTickerResponse(raw: unknown): raw is TickerResponse {
    if (!raw || typeof raw !== 'object') return false;
    const o = raw as Record<string, unknown>;
    return o.ok === true && Array.isArray(o.items) && typeof o.lastSync === 'string';
  }

  function isItem(raw: unknown): raw is TickerItem {
    if (!raw || typeof raw !== 'object') return false;
    const o = raw as Record<string, unknown>;
    return (
      typeof o.sym === 'string' &&
      typeof o.px === 'number' &&
      typeof o.deltaPct === 'number' &&
      (o.source === 'yahoo' || o.source === 'coingecko' || o.source === 'ecb')
    );
  }

  function lastSyncHHMMSS(iso: string): string {
    const m = iso.match(/T(\d{2}:\d{2}:\d{2})/);
    return m ? `${m[1]}Z` : iso;
  }

  async function refreshTape(tape: HTMLElement): Promise<void> {
    const url = tape.dataset.liveUrl;
    if (!url) return;
    const track = tape.querySelector<HTMLElement>('[data-track]');
    const lastSync = tape.querySelector<HTMLElement>('[data-last-sync]');
    if (!track || !lastSync) return;
    try {
      const res = await fetch(url, { headers: { Accept: 'application/json' } });
      if (!res.ok) return;
      const raw: unknown = await res.json();
      if (!isTickerResponse(raw)) return;
      const items = raw.items.filter(isItem);
      if (items.length === 0) return;
      // Render fresh items (duplicated so the keyframe loop is seamless).
      const html = items
        .map((it) => {
          const cls = colorClass(it.deltaPct);
          return `<a class="tape__item tape__item--${cls}" data-source="${it.source}"><span class="tape__sym mono">${it.sym}</span><span class="tape__px mono">${formatPx(it.px)}</span><span class="tape__delta mono">${formatPct(it.deltaPct)}</span></a>`;
        })
        .join('');
      // Replace the track contents in place - keep the original children count
      // so the -50% translateX loop distance stays correct.
      track.innerHTML = html + html;
      // Update the lastSync badge.
      const stamp = lastSyncHHMMSS(raw.lastSync);
      lastSync.textContent = `sync ${stamp}`;
      lastSync.setAttribute('datetime', raw.lastSync);
    } catch {
      // Network failure: leave the previous (or seeded) tape visible.
    }
  }

  function init(): void {
    const tapes = document.querySelectorAll<HTMLElement>('[data-component="market-tape"]');
    tapes.forEach((tape) => {
      // First refresh immediately, then every 60s.
      void refreshTape(tape);
      window.setInterval(() => void refreshTape(tape), 60_000);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .tape {
    background: var(--surface-paper);
    color: var(--c-ink-2);
    border-block: 1px solid var(--c-rule);
    position: relative;
    overflow: hidden;
    user-select: none;
  }
  .tape__viewport {
    overflow: hidden;
    width: 100%;
    height: 44px;
    display: flex;
    align-items: center;
  }
  .tape__track {
    display: inline-flex;
    gap: var(--s-6);
    white-space: nowrap;
    padding-inline: var(--s-5);
    animation: tape-scroll var(--tape-dur, 60s) linear infinite;
    will-change: transform;
  }
  .tape__item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--type-mono-size);
    letter-spacing: var(--type-caption-track);
    text-decoration: none;
    color: inherit;
    min-height: 44px;
    padding-inline: var(--s-2);
    position: relative;
  }
  .tape__item::after {
    content: '·';
    margin-left: var(--s-3);
    color: var(--c-ink-3);
    opacity: 0.6;
    pointer-events: none;
  }
  .tape__sym {
    color: var(--c-ink-2);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: var(--type-caption-track);
  }
  .tape__px {
    color: var(--c-ink);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  .tape__delta {
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  .tape__vol {
    color: var(--c-ink-3);
    font-size: var(--type-caption-size-mobile);
    letter-spacing: var(--type-caption-track);
    margin-left: var(--s-1);
  }
  .tape__item--pass .tape__delta {
    color: var(--c-amber);
    font-weight: 400;
  }
  .tape__item--fail .tape__delta {
    color: var(--c-ink-2);
    font-weight: 400;
  }
  .tape__item--muted .tape__delta {
    color: var(--c-ink-3);
  }
  .tape:hover .tape__track {
    animation-play-state: paused;
  }

  .tape__stop {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding-inline: var(--s-4);
    color: var(--c-ink-3);
    font-size: var(--type-caption-size-mobile);
    letter-spacing: var(--type-caption-track);
    text-transform: uppercase;
    background: var(--surface-paper-deep);
    border-left: 1px solid var(--c-rule);
    pointer-events: none;
  }
  .tape__stop-sep {
    color: var(--c-ink-4);
    opacity: 0.6;
  }
  .tape__stop-sync {
    color: var(--c-ink-3);
    letter-spacing: var(--type-caption-track);
  }

  @keyframes tape-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* Reduced-motion: hold the track still at translateX(0). */
  @media (prefers-reduced-motion: reduce) {
    .tape__track {
      animation: none !important;
    }
  }

  @media (max-width: 1279px) {
    .tape__trailing {
      display: none;
    }
  }
</style>