---
/**
 * Nav.astro — top navigation, responsive (collapses on mobile).
 * v3.5: split into primary (always-visible on desktop) and secondary
 * (Resources disclosure) to keep 1280px rows breathable.
 */
import { path } from '@utils/url';
import { profile } from '@utils/profile';
const bookMailto = `mailto:${profile.contact.email}?subject=${encodeURIComponent('Book a 30-min review')}&body=${encodeURIComponent('Suggested slots (next 14 days, PH UTC+8):\\n— Reply with 2-3 windows that work for you and I will confirm within 24 hours.')}`;
import NavMore from '@components/NavMore.astro';
const { pathname } = Astro.url;
const isActive = (href: string) => {
  const suffix = href === '/' ? '/' : href;
  return pathname === suffix || pathname.startsWith(suffix + '/');
};

// Primary links — visible inline at every viewport >= 1024px.
// Mobile (<=980px) renders ALL links flat inside the burger menu.
// v6.11.13 — Positions promoted from secondary to primary. The "Live
// book" label was ambiguous (trade book? book to read?) and buried the
// most important recruiter-visiting page behind a 10-link disclosure.
// v9.3 IA wave 2 (2026-08-01) — /now promoted from position #8 to #2.
// Reasoning: /now is the second-most-current artifact (dated one-pager
// of current activities); eye-tracking on recruiters first-passes only
// reads positions 1-4. Promoting to #2 lifts "what does he care about
// this week?" to the row recruiters actually scan.
const primary = [
  { href: path('/'), label: 'Home' },
  { href: path('/now'), label: 'Now' },
  { href: path('/for-recruiters'), label: 'For recruiters' },
  { href: path('/proof'), label: 'Proof' },
  { href: path('/positions'), label: 'Positions' },
  { href: path('/projects'), label: 'Projects' },
  { href: path('/solutions'), label: 'Solutions' },
  { href: path('/methodology'), label: 'Method' },
];

// v6.1.0 (Mission G) — Markets dropdown sits between Proof and Projects
// on desktop (as a <details><summary> disclosure), flat with a heading
// inside the burger menu on mobile. /ai is a sub-route of /research for
// nav IA but is its own page.
const markets = [
  { href: path('/markets'), label: 'Markets' },
  { href: path('/prediction-markets'), label: 'Prediction' },
  { href: path('/research'), label: 'Research' },
  { href: path('/research/frontier-models'), label: 'Frontier Brief' },
];

// Secondary links - behind a "Resources" details disclosure on desktop,
// flat list on mobile.
// v6.11.13 — /positions promoted to primary nav (was "Live book" here);
// removed to avoid duplicate entry.
// v6.12 — /screening-call promoted to top of Resources disclosure (recruiter-
// facing 30-min agenda; most-requested artifact after /for-recruiters).
const secondary = [
  { href: path('/screening-call'), label: 'Screening' },
  { href: path('/experience'), label: 'Experience' },
  { href: path('/publications'), label: 'Pubs' },
  { href: path('/papers'), label: 'Papers' },
  { href: path('/talks'), label: 'Talks' },
  { href: path('/contact'), label: 'Contact' },
  { href: path('/glossary'), label: 'Glossary' },
  { href: path('/uses'), label: 'Uses' },
  { href: path('/reading'), label: 'Reading' },
  { href: path('/workbooks'), label: 'Workbooks' },
  { href: path('/about-this-site'), label: 'About this site' },
  { href: path('/colophon'), label: 'Colophon' },
];
---

<header class="nav">
  <div class="container nav__inner">
    <!-- v6.13.2 a11y fix (Lighthouse 95→100, 2026-07-31):
         aria-label must include the visible text "Christian T. Macion" verbatim
         (Lighthouse label-content-name-mismatch). Em-dash separator matches
         institutional register; "home" suffix preserves the link-purpose cue. -->
    <a href={path('/')} class="nav__brand" aria-label="Christian T. Macion — home">
      {
        /* v7.2 2026-07-24 — logo legibility fix. The prior <picture> chose the
           mark asset by OS `prefers-color-scheme`, but the nav background follows
           the *body theme* (--c-tape → --j-bg): cream on theme-light, warm-dark on
           the base surface. So a dark-OS visitor on the light home got the
           near-white mark on a cream bar → the C/M vanished, leaving only the
           chevron (owner's "can't be read" report). Inlining the SVG lets the C/M
           strokes use currentColor (= --ink-on-tape = the theme's correct ink),
           so contrast is correct in every theme × OS combination. The chevron
           uses the AA amber token in both themes. */
      }
      <svg
        class="nav__brand-mark"
        viewBox="0 0 64 64"
        width="36"
        height="36"
        role="img"
        aria-label="Christian Macion monogram"
        focusable="false"
      >
        <g fill="none" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M 28 22 A 12 12 0 1 0 28 42" stroke="currentColor"></path>
          <polyline points="36,44 36,20" stroke="currentColor"></polyline>
          <polyline points="36,20 47,40 58,20" stroke="var(--c-amber)"></polyline>
          <polyline points="58,20 58,44" stroke="currentColor"></polyline>
        </g>
      </svg>
      <span class="nav__brand-text">
        {
          /* v6.10.47 — derive the brand name from profile.fullName. The ®
            glyph is wrapped in <sup> so the existing `.nav__brand-name sup`
            rule (font-size 0.65em + amber tint) renders it as a proper
            typographic superscript instead of inline text. */
        }
        <span class="nav__brand-name" set:html={profile.fullName.replace('®', '<sup>®</sup>')} />
        <span class="nav__brand-sub">{profile.titles.short}</span>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav__toggle-input" aria-hidden="true" />
    <label for="nav-toggle" class="nav__toggle" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav__links" aria-label="Primary">
      <div class="nav__primary">
        {
          /* v6.1.0 (Mission G) — Markets dropdown sits BETWEEN Proof and Projects.
            Split the loop into 3 chunks so the dropdown interrupts the linear
            flow at the spec'd position. */
        }
        {
          primary.slice(0, 3).map(({ href, label }) => (
            <a href={href} class:list={['nav__link', { 'nav__link--active': isActive(href) }]}>
              {label}
            </a>
          ))
        }
        <NavMore items={markets} mode="dropdown" label="Markets" class="nav__more" />
        {
          primary.slice(3).map(({ href, label }) => (
            <a href={href} class:list={['nav__link', { 'nav__link--active': isActive(href) }]}>
              {label}
            </a>
          ))
        }
        <NavMore items={secondary} mode="dropdown" class="nav__more" />
      </div>

      <div class="nav__secondary-row">
        <NavMore items={markets} mode="inline" label="Markets" class="nav__more-flat" />
        <NavMore items={secondary} mode="inline" class="nav__more-flat" />
        {/* v9.3 IA wave 2 (2026-08-01) — Mobile drawer variant: same 3-pill
           Resume split-button, expanded inline (no dropdown panel). */}
        <details class="nav__resume-split nav__resume-split--mobile">
          <summary
            class="btn btn--primary btn--sm nav__cta nav__cta--resume"
            aria-label="Download resume — choose variant"
            aria-controls="resume-pills-mobile"
          >
            <span>Resume</span>
            <svg
              class="nav__cta-chev"
              width="10"
              height="10"
              viewBox="0 0 10 10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2 3.5l3 3 3-3"></path>
            </svg>
          </summary>
          <div class="nav__resume-pills nav__resume-pills--mobile" id="resume-pills-mobile" role="menu">
            <a
              href={path('/resume-quant-onepage.pdf')}
              class="nav__resume-pill binding-stripe binding-stripe--handoff"
              role="menuitem"
              download
            >
              <span class="nav__resume-pill-kicker mono">QUANT</span>
              <span class="nav__resume-pill-body">1-page · market microstructure + alpha</span>
            </a>
            <a
              href={path('/resume-ai-only.pdf')}
              class="nav__resume-pill binding-stripe binding-stripe--iterate"
              role="menuitem"
              download
            >
              <span class="nav__resume-pill-kicker mono">AI</span>
              <span class="nav__resume-pill-body">RAG · evals · MCP · multi-agent</span>
            </a>
            <a
              href={path('/resume-tailored.pdf')}
              class="nav__resume-pill binding-stripe binding-stripe--ship"
              role="menuitem"
              download
            >
              <span class="nav__resume-pill-kicker mono">UNIFIED</span>
              <span class="nav__resume-pill-body">Senior QR + AI Engineer flagship</span>
            </a>
          </div>
        </details>
        {/* v9.3 IA wave 2 (2026-08-01) — Mobile drawer Book-a-call. Full-width
           amber CTA. Mailto fallback per Wave-2 conversion audit (cal.com
           /christianmacion/30min-review returns HTTP 404 as of 2026-08-01).
           Owner-action item to recover the cal.com handle + recreate the
           30min-review event type; until then, mailto is the binding path. */}
        <a
          href={bookMailto}
          class="btn btn--sm nav__book nav__book--mobile"
          aria-label="Book a 30-minute review via email (mailto fallback while cal.com handle is recovered)"
        >
          <span>Book a call</span>
        </a>
        {/* v9.3 IA wave 2 (2026-08-01) — Mobile drawer GitHub icon. */}
        <a
          href="https://github.com/christianmacion26"
          class="nav__icon-link nav__icon-link--mobile"
          aria-label="Christian Macion on GitHub (opens in new tab)"
          target="_blank"
          rel="me noopener"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path>
          </svg>
          <span class="nav__icon-link-label">Christian Macion on GitHub</span>
        </a>
      </div>

      <a
        href={path('/search?focus=1')}
        class="nav-search"
        aria-label="Search the site"
        title="Search (Pagefind)"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </a>
      {/* v9.3 IA wave 2 (2026-08-01) — GitHub icon link in nav. Custom
         16×16 SVG (mono fill, accent on hover) → external profile.
         Touch target expanded to 44×44 via nav__icon-link::after. */}
      <a
        href="https://github.com/christianmacion26"
        class="nav__icon-link"
        aria-label="Christian Macion on GitHub (opens in new tab)"
        title="GitHub"
        target="_blank"
        rel="me noopener"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path>
        </svg>
      </a>
      {/* v9.3 IA wave 2 (2026-08-01) — Resume split-button disclosure.
         Native <details>/<summary> → 3 direct-PDF pills (Quant / AI /
         Unified). Replaces the 2-click "Resume ↓ → /resume → variant →
         PDF" path with a 1-click variant chooser. aria-controls +
         summary labels wire the disclosure to screen readers. */}
      <details class="nav__resume-split nav__resume-split--desktop">
        <summary
          class="btn btn--primary btn--sm nav__cta nav__cta--resume"
          aria-label="Download resume — choose variant"
          aria-controls="resume-pills-desktop"
        >
          <span>Resume</span>
          <svg
            class="nav__cta-chev"
            width="10"
            height="10"
            viewBox="0 0 10 10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M2 3.5l3 3 3-3"></path>
          </svg>
        </summary>
        <div class="nav__resume-pills" id="resume-pills-desktop" role="menu">
          <a
            href={path('/resume-quant-onepage.pdf')}
            class="nav__resume-pill binding-stripe binding-stripe--handoff"
            role="menuitem"
            download
          >
            <span class="nav__resume-pill-kicker mono">QUANT</span>
            <span class="nav__resume-pill-body">1-page · market microstructure + alpha</span>
          </a>
          <a
            href={path('/resume-ai-only.pdf')}
            class="nav__resume-pill binding-stripe binding-stripe--iterate"
            role="menuitem"
            download
          >
            <span class="nav__resume-pill-kicker mono">AI</span>
            <span class="nav__resume-pill-body">RAG · evals · MCP · multi-agent</span>
          </a>
          <a
            href={path('/resume-tailored.pdf')}
            class="nav__resume-pill binding-stripe binding-stripe--ship"
            role="menuitem"
            download
          >
            <span class="nav__resume-pill-kicker mono">UNIFIED</span>
            <span class="nav__resume-pill-body">Senior QR + AI Engineer flagship</span>
          </a>
        </div>
      </details>
      {/* v9.3 IA wave 2 (2026-08-01) — Persistent Book-a-call CTA in nav.
         Amber-deep on tape → terracotta on hover. Mailto fallback per
         Wave-2 conversion audit (cal.com/christianmacion/30min-review
         returns HTTP 404 as of 2026-08-01; verified via curl HTTP/2 404
         cf-ray a243042e0bad0dc3-HKG). Owner-action item to recover the
         cal.com handle + recreate the 30min-review event type; until
         then, mailto is the binding path per the conversion audit's
         "mailto + slot times tile" recommended fallback. */}
      <a
        href={bookMailto}
        class="btn btn--sm nav__book nav__book--desktop"
        aria-label="Book a 30-minute review via email (mailto fallback while cal.com handle is recovered)"
      >
        <span>Book a call</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    /* v6.1.0 — always institutional-tape (single palette, no light/dark flip).
       v6.11.6 — was rgba(13,17,23,1); use --c-tape token so future
       palette shifts propagate. */
    background: var(--c-tape);
    border-bottom: 1px solid var(--c-white-haze);
    color: var(--ink-on-tape);
  }
  /* v6.1.0 — light/dark mode removed. Background is always tape (set above
     on `.nav`); prefers-color-scheme and [data-theme] overrides are dead. */
  .nav__inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    color: var(--c-primary); /* v6.1.0 — always tape nav, light text */
    flex-shrink: 0;
    /* v6.3 polish — enforce ≥ 44 px tap target on the brand link.
       The audit flagged the brand chrome at 184×36 px.
       min-height:44 lifts the rect without shifting visible content
       because the brand is centered in a 56 px nav row. */
    min-height: 44px;
    padding: 0.25rem 0;
  }
  .nav__brand-mark {
    display: block;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
  }
  .nav__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .nav__brand-name {
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .nav__brand-name sup {
    font-size: 0.65em;
    color: var(--c-primary-2-light);
  }
  .nav__brand-sub {
    font-size: var(--fs-xs);
    /* v7.2 — was --c-white-faint (--j-ink-4): 3.10:1 light / 1.93:1 dark, fails
       WCAG AA at this 12px size. --c-ink-3 passes AA in both themes (6.20:1
       light / 5.62:1 dark) while staying secondary in the hierarchy. */
    color: var(--c-ink-3);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .nav__primary {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .nav__secondary-row {
    display: none;
  }
  .nav__link {
    color: var(--c-ink-mute); /* v6.1.0 — light text on dark nav */
    font-size: var(--fs-sm);
    font-weight: 500;
    padding: 0.5rem 0;
    /* v6.1 polish — enforce ≥ 44 px tap target on every nav link.
       The nav itself is 56 px tall; previous padding (0.5rem top/bot)
       rendered ~30 px high. min-height doesn't shift layout because
       the parent flex container centers content vertically. */
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 2px solid transparent;
    transition:
      color var(--transition),
      border-color var(--transition);
  }
  .nav__link:hover {
    color: var(--c-primary-2-light);
  }
  .nav__link--active {
    color: var(--c-primary-2-light);
    border-bottom-color: var(--c-primary-2);
  }
  /* v6.1.0 — Match .nav__link color treatment when NavMore is nested
     in the primary row (Markets dropdown + Resources dropdown).
     NavMore's default styles are tuned for `--c-ink-2` against light bg;
     here the nav is institutional-tape, so re-color and remove the
     pill-shaped hover background that no longer fits the row layout. */
  .nav__primary .nav-more__summary {
    color: var(--c-ink-mute);
    font-size: var(--fs-sm);
    font-weight: 500;
    padding: 0.5rem 0;
    border-radius: 0;
    /* v6.1 polish — min-height + flex centering so the dropdown summary
       matches the .nav__link touch target. */
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .nav__primary .nav-more__summary:hover,
  .nav__primary .nav-more[open] .nav-more__summary {
    color: var(--c-primary-2-light);
    background: transparent;
  }
  .nav__primary .nav-more[open] .nav-more__summary {
    border-bottom: 2px solid var(--c-primary-2);
  }
  /* Highlight the Markets summary when any of its children is the
     current page. We can't use NavMore's built-in isActive on the
     summary because that helper is scoped to a single href; mark
     the summary manually via data-active on the <details>. */
  .nav__primary .nav-more[data-active] .nav-more__summary {
    color: var(--c-primary-2-light);
    border-bottom: 2px solid var(--c-primary-2);
  }
  .nav__cta--mobile {
    display: none;
  }

  /* === v6.x · Force amber on the Resume CTA (P0-4) ===
     .btn--primary uses var(--c-primary), which flips to a pale ink in
     dark mode → invisible against the dark navbar. Always amber.
     v9.3 IA wave 2 (2026-08-01) a11y baseline — text color
     var(--c-bg-light) (#f7f2e7) on var(--c-amber-deep) (#8a6f2f)
     measured 4.28:1 in dark theme, failing WCAG 1.4.3 (4.5:1 body).
     Switched to var(--c-bg) for ≥4.5:1 in both themes. Hover swap:
     var(--c-bg) on var(--c-amber) for ≥4.5:1 contrast in both
     themes (was var(--c-bg-light) on var(--c-amber) = 2.95:1 dark). */
  .nav__cta {
    background: var(--c-amber-deep);
    color: var(--c-bg);
    border: 1px solid var(--c-amber);
    /* v6.18 polish — prevent "Resume ↓" wrapping to "Res..." on narrower
       desktops. The audit found the CTA clipped at 1024-1280px when
       the primary link row + dropdowns ate the available width. */
    white-space: nowrap;
    flex-shrink: 0;
  }
  .nav__cta:hover {
    background: var(--c-amber);
    color: var(--c-bg);
  }

  /* === v6.1.0 — theme toggle CSS removed (the button is gone) === */

  /* === Search shortcut ===
   * v6.1.1 polish — the 32×32 icon button failed WCAG 2.5.5 (44×44).
   * The visual stays 32×32; an invisible `::after` pseudo-element
   * expands the hit target by 6px on every side (32 + 12 = 44×44),
   * without shifting the layout or changing the visible button box. */
  .nav-search {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--c-white-wisp);
    border-radius: var(--radius-sm);
    color: var(--c-ink-mute);
    text-decoration: none;
    transition:
      color var(--transition),
      border-color var(--transition),
      background var(--transition);
  }
  .nav-search::after {
    content: '';
    position: absolute;
    inset: -6px;
  }
  .nav-search:hover {
    color: var(--c-primary-2-light);
    border-color: var(--c-primary-2-light);
  }

  /* === v9.3 IA wave 2 (2026-08-01) — GitHub icon link ===
     Same 32×32 visible / 44×44 hit-target pattern as .nav-search. */
  .nav__icon-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    min-width: 44px;
