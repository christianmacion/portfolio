---
/**
 * KeyHintPanel.astro — v7.7.92 (Mission F-A2-mount)
 * Floating keyboard-shortcut hints. Toggle with `?`.
 *
 * v7.7.92 — Re-mounted after C1 deletion in v7.7.91. The panel was dead
 * (only DOM-queried via `#keyhint-panel`, never imported) so knip + A11
 * gate-honesty flagged it. Now imported by BaseLayout, so every page
 * carries the panel and `?` actually does something useful.
 *
 * v7.7.91 — Modifier-bind all single-char shortcuts to satisfy WCAG
 * 2.1.4 AA (Character Key Shortcuts). Bare single-char shortcuts fire on
 * any press, including typed text. Cmd+/, Cmd+j, Cmd+k, Cmd+↑, Cmd+↓ all
 * require metaKey or ctrlKey. `?` stays bare (W3C exempt) for panel toggle.
 *
 * Chrome contract: 0px radii, mono + 1 amber, no halo, no glow, no gradient.
 * Hidden by default (`hidden` attribute + `aria-hidden="true"`). `?` opens.
 *
 * Wired by `src/scripts/keyboard-shortcuts.ts` (imported via BaseLayout).
 * Honors `prefers-reduced-motion` (opacity transition only — no slide).
 */

interface Shortcut {
  keys: string[]; // multi-key combos displayed together
  label: string;
}

const shortcuts: Shortcut[] = [
  { keys: ['?'], label: 'Toggle this panel' },
  { keys: ['⌘', '/'], label: 'Focus search' },
  { keys: ['⌘', 'j'], label: 'Jump down a viewport' },
  { keys: ['⌘', 'k'], label: 'Jump up a viewport' },
  { keys: ['⌘', '↑'], label: 'Go to top' },
  { keys: ['⌘', '↓'], label: 'Go to bottom' },
  { keys: ['Esc'], label: 'Close panel' },
];
---

<aside
  id="keyhint-panel"
  class="khp"
  role="region"
  aria-label="Keyboard shortcuts"
  aria-hidden="true"
  hidden
>
  <header class="khp__header">
    <span class="khp__title">Keyboard</span>
    <span class="khp__hint">press <kbd class="khp__kbd khp__kbd--inline">?</kbd> to toggle</span>
  </header>
  <ul class="khp__list">
    {shortcuts.map((s) => (
      <li class="khp__row">
        <span class="khp__keys">
          {s.keys.map((k, i) => (
            <>
              {i > 0 && <span class="khp__plus" aria-hidden="true">+</span>}
              <kbd class="khp__kbd">{k}</kbd>
            </>
          ))}
        </span>
        <span class="khp__label">{s.label}</span>
      </li>
    ))}
  </ul>
</aside>

<style>
  /* v7.7.92 — F-A2-mount restoration.
     Chrome contract: 0px radii, mono + 1 amber, hairline borders only. */
  .khp {
    position: fixed;
    top: calc(var(--nav-h, 56px) + var(--sp-3, 12px));
    right: var(--sp-3, 12px);
    z-index: 90;
    width: min(320px, calc(100vw - var(--sp-6, 24px)));
    padding: var(--sp-4, 16px);
    background: var(--c-paper, #0a0a0a);
    border: 1px solid var(--c-rule, #2a2a2a);
    border-radius: 0;
    color: var(--c-ink, #e8e8e8);
    font-family: var(--ff-mono, ui-monospace, monospace);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    box-shadow: none;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    pointer-events: none;
  }
  .khp.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .khp {
      transform: none;
      transition: opacity 0.01ms linear;
    }
  }
  .khp__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: var(--sp-3, 12px);
    margin-bottom: var(--sp-3, 12px);
    border-bottom: 1px solid var(--c-rule-soft, #1a1a1a);
  }
  .khp__title {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-amber, #c79b4a);
  }
  .khp__hint {
    font-size: 10px;
    color: var(--c-white-faint, #7a7a7a);
    letter-spacing: 0.06em;
  }
  .khp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2, 8px);
  }
  .khp__row {
    display: grid;
    grid-template-columns: minmax(96px, auto) 1fr;
    gap: var(--sp-3, 12px);
    align-items: center;
  }
  .khp__keys {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-wrap: nowrap;
  }
  .khp__plus {
    color: var(--c-white-faint, #7a7a7a);
    font-size: 10px;
    margin: 0 2px;
  }
  .khp__kbd {
    display: inline-block;
    min-width: 22px;
    padding: 2px 6px;
    background: var(--c-tape, #111);
    border: 1px solid var(--c-rule, #2a2a2a);
    border-radius: 0;
    color: var(--c-amber, #c79b4a);
    font: inherit;
    font-size: 10px;
    text-align: center;
    letter-spacing: 0.04em;
  }
  .khp__kbd--inline {
    color: var(--c-amber, #c79b4a);
  }
  .khp__label {
    font-size: 10px;
    color: var(--c-white-faint, #7a7a7a);
    letter-spacing: 0.04em;
  }
  /* Hide on small viewports — keyboard UX not relevant to touch-first. */
  @media (max-width: 720px) {
    .khp {
      display: none;
    }
  }
</style>
