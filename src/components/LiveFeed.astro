---
/**
 * LiveFeed.astro — v7.9.1 UNIFIED LIVE FEED + POLISH.
 *
 * Cross-source chronological feed that interleaves:
 *   - GDELT events   (geopolitical / market-moving 24h signals)
 *   - arXiv papers  (q-fin / stat.AP / cs.LG / cs.AI / cs.CL preprints)
 *   - macro-wire    (Reuters / CoinDesk / The Block / CoinTelegraph)
 *
 * Reads src/data/live-feed-cache.json (built by scripts/build-live-feed.mjs).
 * Items are pre-sorted DESC by timestamp and cross-feed-deduplicated.
 *
 * v7.9.1 polish:
 *   - Filter chips (ALL · GDELT · arXiv · WIRE) — toggle source visibility
 *   - Search input — substring match against title (case-insensitive)
 *   - Anchor links — `#event-<id>` permalinks on every row + auto-copy
 *   - earth:venue-focus / earth:country-focus listeners — scroll into view
 *     when the user clicks a city or country on /desk
 *   - URL hash deep-link — if `#event-<id>` is in the URL on load, scroll
 *     to that row + highlight it
 *
 * Visual register: light institutional / Bloomberg. Mono + 3 distinct
 * source accents (gdelt → cobalt, arxiv → amber, macrowire → sage).
 * No glow. No pills. No rotation. Reduced-motion fallback.
 */
import liveFeedCache from '../data/live-feed-cache.json';

interface Props {
  /** Cap rendered items (default: all). The fetcher already caps at 100. */
  cap?: number;
  /** Show only items newer than this many hours (default: 24). */
  windowHours?: number;
}
const { cap, windowHours = 24 } = Astro.props;

interface LiveEvent {
  id: string;
  source: 'gdelt' | 'arxiv' | 'macrowire';
  title: string;
  link: string;
  timestamp: string;
  category: string;
  severity?: string | null;
  city?: string | null;
  publisher?: string | null;
  fingerprint: string;
  domain: string;
  coords?: { lat: number; lon: number };
  related?: { source: string; id: string }[];
}
interface LiveFeedCache {
  generated: string;
  fetchedAt: string | null;
  cap: number;
  counts: { arxiv: number; macrowire: number; gdelt: number };
  total: number;
  events: LiveEvent[];
}
const cache = liveFeedCache as LiveFeedCache;

// === Filter by window ===
const now = new Date(cache.generated).getTime();
const cutoffMs = now - windowHours * 60 * 60 * 1000;
const freshEvents = cache.events.filter((e) => new Date(e.timestamp).getTime() >= cutoffMs);
const events: LiveEvent[] = cap ? freshEvents.slice(0, cap) : freshEvents;
const hasItems = events.length > 0;

// === Source → accent mapping ===
const sourceAccent: Record<string, string> = {
  gdelt: 'cobalt',
  arxiv: 'warn',
  macrowire: 'sage',
};
const sourceLabel: Record<string, string> = {
  gdelt: 'GDELT',
  arxiv: 'arXiv',
  macrowire: 'WIRE',
};
const accentFor = (src: string): string => sourceAccent[src] ?? 'ink';

// === Helpers ===
function formatHm(iso: string): string {
  if (!iso) return '';
  const m = iso.match(/T(\d{2}:\d{2})/);
  return m ? m[1] : '';
}
function formatDate(iso: string): string {
  if (!iso) return '';
  return iso.slice(0, 10);
}
function timeAgo(iso: string, refIso: string): string {
  const t = new Date(iso).getTime();
  const ref = new Date(refIso).getTime();
  const min = Math.max(0, Math.floor((ref - t) / 60_000));
  if (min < 60) return `${min}M`;
  const hr = Math.floor(min / 60);
  if (hr < 24) return `${hr}H`;
  return `${Math.floor(hr / 24)}D`;
}

/**
 * Local-time clock string at the venue's longitude.
 * v7.9.2 — arXiv papers don't carry a venue; use UTC. GDELT + WIRE
 * use coords.lon → nearest 15° offset (UTC±12 max). Daylight-saving is
 * NOT applied (offset-from-lon approximation), but that's fine for a
 * 24h feed where the absolute clock face is the institutional reading.
 */
function localClock(iso: string, lon: number | undefined): string {
  if (!iso) return '';
  const offsetHours = lon === undefined ? 0 : Math.round(lon / 15);
  const utcMs = new Date(iso).getTime();
  const localMs = utcMs + offsetHours * 60 * 60 * 1000;
  const d = new Date(localMs);
  const hh = String(d.getUTCHours()).padStart(2, '0');
  const mm = String(d.getUTCMinutes()).padStart(2, '0');
  const sign = offsetHours >= 0 ? '+' : '';
  return `${hh}:${mm} GMT${sign}${offsetHours}`;
}
function tzOffset(lon: number | undefined): number {
  return lon === undefined ? 0 : Math.round(lon / 15);
}

// === v7.9.3 — top 6 cities by event count (for quick-filter chips) ======
const cityCounts: Array<{ city: string; count: number }> = (() => {
  const m = new Map<string, number>();
  for (const e of events) {
    const c = (e.city ?? '').trim();
    if (!c) continue;
    m.set(c, (m.get(c) ?? 0) + 1);
  }
  return Array.from(m.entries())
    .sort((a, b) => b[1] - a[1])
    .slice(0, 6)
    .map(([city, count]) => ({ city, count }));
})();

// === v7.11 — time-bucket counts (for 1H/6H/24H/ALL filter chips) =========
const generatedMs = new Date(cache.generated).getTime();
const timeBucketCounts = (() => {
  const buckets = { '1h': 0, '6h': 0, '24h': 0, all: 0 };
  for (const e of events) {
    buckets.all++;
    const t = new Date(e.timestamp).getTime();
    const ageH = (generatedMs - t) / (60 * 60 * 1000);
    if (ageH <= 1) buckets['1h']++;
    if (ageH <= 6) buckets['6h']++;
    if (ageH <= 24) buckets['24h']++;
  }
  return buckets;
})();
---

<section
  class="live-feed"
  aria-label="Unified live feed — GDELT + arXiv + macro-wire"
  data-live-feed
>
  <header class="live-feed__head">
    <p class="live-feed__eyebrow mono">
      UNIFIED · {cache.counts.gdelt} GDELT · {cache.counts.arxiv} arXiv · {cache.counts.macrowire} WIRE
    </p>
    <p class="live-feed__legend mono">
      <span class="live-feed__chip live-feed__chip--cobalt">GDELT</span>
      <span class="live-feed__sep" aria-hidden="true">·</span>
      <span class="live-feed__chip live-feed__chip--warn">arXiv</span>
      <span class="live-feed__sep" aria-hidden="true">·</span>
      <span class="live-feed__chip live-feed__chip--sage">WIRE</span>
      <span class="live-feed__cap-stamp mono"
        >GENERATED {formatDate(cache.generated)} {formatHm(cache.generated)}</span
      >
    </p>
  </header>

  {/* === v7.9.1 polish — filter chips + search input ========================= */}
  {
    hasItems && (
      <div class="live-feed__filters" role="toolbar" aria-label="Filter live feed">
        <div class="live-feed__chips" role="group" aria-label="Source filter">
          <button
            type="button"
            class="live-feed__chip-btn live-feed__chip-btn--active"
            data-source-filter="all"
            aria-pressed="true"
          >
            ALL
          </button>
          <button
            type="button"
            class="live-feed__chip-btn"
            data-source-filter="gdelt"
            aria-pressed="false"
          >
            GDELT
          </button>
          <button
            type="button"
            class="live-feed__chip-btn"
            data-source-filter="arxiv"
            aria-pressed="false"
          >
            arXiv
          </button>
          <button
            type="button"
            class="live-feed__chip-btn"
            data-source-filter="macrowire"
            aria-pressed="false"
          >
            WIRE
          </button>
        </div>
        {/* v7.11 — time-scope chip row (1H · 6H · 24H · ALL) */}
        <div class="live-feed__chips" role="group" aria-label="Time-scope filter">
          <span class="live-feed__chip-label mono">WINDOW ·</span>
          <button
            type="button"
            class="live-feed__chip-btn live-feed__chip-btn--active"
            data-time-filter="all"
            aria-pressed="true"
          >
            ALL <span class="live-feed__chip-count">({timeBucketCounts.all})</span>
          </button>
          <button
            type="button"
            class="live-feed__chip-btn"
            data-time-filter="1h"
            aria-pressed="false"
          >
            1H <span class="live-feed__chip-count">({timeBucketCounts['1h']})</span>
          </button>
          <button
            type="button"
            class="live-feed__chip-btn"
            data-time-filter="6h"
            aria-pressed="false"
          >
            6H <span class="live-feed__chip-count">({timeBucketCounts['6h']})</span>
          </button>
          <button
            type="button"
            class="live-feed__chip-btn"
            data-time-filter="24h"
            aria-pressed="false"
          >
            24H <span class="live-feed__chip-count">({timeBucketCounts['24h']})</span>
          </button>
        </div>
        <label class="live-feed__search">
          <span class="sr-only">Search live feed titles</span>
          <input
            type="search"
            class="live-feed__search-input mono"
            placeholder="SEARCH TITLE OR CITY…"
            aria-label="Search live feed by title or city"
            autocomplete="off"
            spellcheck="false"
            data-search-input
          />
        </label>
        <p class="live-feed__count mono" data-visible-count>
          {events.length} VISIBLE
        </p>
      </div>
    )
  }

  {/* === v7.9.3 polish — popular-city quick filters + refresh countdown ====== */}
  {
    hasItems && cityCounts.length > 0 && (
      <div class="live-feed__cities" role="toolbar" aria-label="Filter by city">
        <span class="live-feed__city-label mono">CITIES ·</span>
        <button
          type="button"
          class="live-feed__city-btn live-feed__city-btn--active"
          data-city-filter="all"
          aria-pressed="true"
        >
          ALL
        </button>
        {cityCounts.map(({ city, count }) => (
          <button
            type="button"
            class="live-feed__city-btn"
            data-city-filter={city.toLowerCase()}
            aria-pressed="false"
          >
            {city.toUpperCase()} <span class="live-feed__city-count">({count})</span>
          </button>
        ))}
        <span
          class="live-feed__refresh mono"
          data-refresh-countdown
          data-generated={cache.generated}
        >
          CACHE · REFRESH
        </span>
        {/* v7.10 — copy-shareable-filter-URL button (institutional register) */}
        <button
          type="button"
          class="live-feed__share-btn mono"
          data-share-link
          title="Copy link with current filters"
        >
          COPY · LINK
        </button>
      </div>
    )
  }

  {
    hasItems && (
      <ol class="live-feed__list" aria-live="off" aria-atomic="false" data-live-list>
        {events.map((e) => (
          <li
            class={`live-feed__row live-feed__row--${accentFor(e.source)}`}
            id={`event-${e.id}`}
            data-event-id={e.id}
            data-event-source={e.source}
            data-event-lat={e.coords?.lat ?? ''}
            data-event-lon={e.coords?.lon ?? ''}
            data-event-tz={tzOffset(e.coords?.lon)}
            data-event-city={(e.city ?? '').toLowerCase()}
            data-event-title={e.title.toLowerCase()}
            data-event-ts={new Date(e.timestamp).getTime()}
            data-event-category={e.category.toLowerCase()}
          >
            <span class={`live-feed__source mono live-feed__source--${accentFor(e.source)}`}>
              {sourceLabel[e.source]}
            </span>
            <span class="live-feed__hm mono" title={e.timestamp}>
              <span class="live-feed__hm-ago">{timeAgo(e.timestamp, cache.generated)}</span>
              {/* v7.9.2 — venue-local clock (e.g. 15:15 GMT+8) shown on hover */}
              <span class="live-feed__hm-local">{localClock(e.timestamp, e.coords?.lon)}</span>
            </span>
            <a
              class="live-feed__title"
              href={e.link}
              target="_blank"
              rel="noopener noreferrer"
              referrerpolicy="strict-origin-when-cross-origin"
            >
              {e.title}
            </a>
            <span class="live-feed__cat mono">
              {e.city ? `${e.city.toUpperCase()} · ` : ''}
              {e.category.toUpperCase()}
            </span>
            {e.related && e.related.length > 0 && (
              <span
                class="live-feed__related mono"
                title={`Also in: ${e.related.map((r) => r.source).join(', ')}`}
              >
                ↔ {e.related.length}
              </span>
            )}
            {/* v7.9.1 — anchor link for permalinks */}
            <a
              class="live-feed__anchor mono"
              href={`#event-${e.id}`}
              aria-label={`Permalink to ${e.title}`}
              data-anchor-link
              onclick="navigator.clipboard?.writeText(this.href);return false;"
            >
              #
            </a>
          </li>
        ))}
      </ol>
    )
  }

  {
    !hasItems && (
      <p class="live-feed__empty">
        <span class="live-feed__chip live-feed__chip--ink">EMPTY</span>
        <span class="live-feed__empty-text">
          NO ITEMS IN {windowHours}H WINDOW · LAST GOOD{' '}
          {formatDate(cache.fetchedAt || cache.generated)}{' '}
          {formatHm(cache.fetchedAt || cache.generated)}
        </span>
      </p>
    )
  }

  {/* v7.19 — a11y live region (announces filter result count to screen readers) */}
  <div class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-live-announcer>
    Showing {events.length} of {events.length} events.
  </div>

  {/* v7.19 — keyboard shortcut hint (visible only to sighted users) */}
  {
    hasItems && (
      <p class="live-feed__kbd-hint mono">
        <kbd>/</kbd> SEARCH · <kbd>ESC</kbd> CLEAR · <kbd>J</kbd>/<kbd>K</kbd> NEXT/PREV ROW
      </p>
    )
  }
</section>

<style>
  /* === Container === */
  .live-feed {
    padding: 32px 0 48px;
    border-block: 1px solid var(--c-rule);
    background: var(--c-bg);
  }

  /* === Head === */
  .live-feed__head {
    margin-bottom: 16px;
  }
  .live-feed__eyebrow {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-warn);
    margin: 0 0 8px;
    font-weight: 600;
  }
  .live-feed__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    margin: 0;
  }
  .live-feed__chip {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border: 1px solid currentColor;
    border-radius: 0;
    font-weight: 600;
    line-height: 1.4;
  }
  .live-feed__chip--cobalt {
    color: var(--c-primary-2);
  }
  .live-feed__chip--warn {
    color: var(--c-warn);
  }
  .live-feed__chip--sage {
    color: var(--j-sage);
  }
  .live-feed__chip--ink {
    color: var(--c-ink-3);
  }
  .live-feed__sep {
    color: var(--c-ink-4);
    font-weight: 600;
  }
  .live-feed__cap-stamp {
    margin-left: auto;
    color: var(--c-ink-3);
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  /* === v7.9.1 — filter row ============================================= */
  .live-feed__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding: 10px 0 14px;
    border-bottom: 1px solid var(--c-rule);
    margin-bottom: 8px;
  }

  /* === v7.9.3 — popular-city quick filter row =========================== */
  .live-feed__cities {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 0 0 12px;
  }
  .live-feed__city-label {
    font-size: 9px;
    letter-spacing: 0.14em;
    color: var(--c-ink-3);
    margin-right: 4px;
  }
  .live-feed__city-btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--c-rule);
    color: var(--c-ink-2);
    padding: 6px 10px;
    font: 500 9.5px / 1.4 var(--ff-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 120ms ease,
      color 120ms ease,
      border-color 120ms ease;
  }
  .live-feed__city-btn:hover,
  .live-feed__city-btn:focus-visible {
    border-color: var(--c-ink-2);
    color: var(--c-ink);
  }
  .live-feed__city-btn:focus-visible {
    outline: 2px solid var(--c-amber);
    outline-offset: 1px;
  }
  .live-feed__city-btn--active {
    background: var(--c-warn);
    color: var(--c-bg);
    border-color: var(--c-warn);
  }
  .live-feed__city-count {
    color: inherit;
    opacity: 0.7;
    margin-left: 2px;
  }
  .live-feed__refresh {
    margin-left: auto;
    color: var(--c-ink-3);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .live-feed__share-btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--c-ink-3);
    color: var(--c-ink-2);
    padding: 7px 10px;
    font-size: 9px;
    letter-spacing: 0.14em;
    cursor: pointer;
    transition:
      background 120ms ease,
      color 120ms ease,
      border-color 120ms ease;
  }
  .live-feed__share-btn:hover,
  .live-feed__share-btn:focus-visible {
    border-color: var(--c-ink-1);
    color: var(--c-ink);
    background: var(--c-paper-2);
  }
  .live-feed__share-btn:focus-visible {
    outline: 2px solid var(--c-amber);
    outline-offset: 1px;
  }
  .live-feed__share-btn[data-copied='1'] {
    border-color: var(--c-amber);
    color: var(--c-amber);
  }
  .live-feed__chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .live-feed__chip-btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--c-rule);
    color: var(--c-ink-2);
    padding: 5px 10px;
    font: 600 10px / 1.4 var(--ff-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 120ms ease,
      color 120ms ease,
      border-color 120ms ease;
  }
  .live-feed__chip-btn:hover,
  .live-feed__chip-btn:focus-visible {
    border-color: var(--c-ink-2);
    color: var(--c-ink);
  }
  .live-feed__chip-btn:focus-visible {
    outline: 2px solid var(--c-amber);
    outline-offset: 1px;
  }
  .live-feed__chip-btn--active {
    background: var(--c-ink);
    color: var(--c-bg);
    border-color: var(--c-ink);
  }
  .live-feed__chip-label {
    color: var(--c-ink-3);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-self: center;
    margin-right: 2px;
  }
  .live-feed__chip-count {
    opacity: 0.6;
    font-weight: 500;
    margin-left: 2px;
  }
  .live-feed__search {
    flex: 1 1 220px;
    min-width: 180px;
    max-width: 360px;
    display: inline-block;
  }
  .live-feed__search-input {
    width: 100%;
    appearance: none;
    background: transparent;
    border: 1px solid var(--c-rule);
    color: var(--c-ink);
    padding: 5px 10px;
    font: 500 11px / 1.4 var(--ff-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .live-feed__search-input::placeholder {
    color: var(--c-ink-4);
    letter-spacing: 0.12em;
  }
  .live-feed__search-input:focus-visible {
    outline: 2px solid var(--c-amber);
    outline-offset: 1px;
    border-color: var(--c-amber);
  }
  .live-feed__count {
    margin: 0 0 0 auto;
    color: var(--c-ink-3);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* === v7.19 — keyboard shortcut hint ==================================== */
  .live-feed__kbd-hint {
    margin: 8px 0 0;
    padding: 0;
    color: var(--c-ink-4);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: right;
  }
  .live-feed__kbd-hint kbd {
    display: inline-block;
    padding: 1px 5px;
    margin: 0 1px;
    font-family: var(--ff-mono);
    font-size: 9px;
    line-height: 1.3;
    color: var(--c-ink-2);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: 2px;
    text-transform: uppercase;
  }

  /* === List === */
  .live-feed__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--c-rule);
  }
  .live-feed__row {
    display: grid;
    grid-template-columns: 64px 36px 1fr 200px 32px 18px;
    gap: 12px;
    align-items: baseline;
    padding: 12px 8px;
    border-bottom: 1px solid var(--c-rule);
    transition:
      background 0.2s ease,
      box-shadow 0.2s ease;
    scroll-margin-top: 80px;
  }
  .live-feed__row:hover,
  .live-feed__row:focus-visible {
    background: color-mix(in oklab, var(--c-amber) 4%, transparent);
  }
  /* v7.9.1 — dimmed state when filtered out */
  .live-feed__row[data-filtered='1'] {
    display: none;
  }
  /* v7.9.1 — highlight when scroll-to-focus or hash-deep-link targets it */
  .live-feed__row[data-flash='1'] {
    animation: live-row-flash 1.6s var(--j-ease-out) both;
  }
  @keyframes live-row-flash {
    0% {
      background: color-mix(in oklab, var(--c-amber) 26%, transparent);
    }
    100% {
      background: transparent;
    }
  }
  .live-feed__row--cobalt {
    border-left: 2px solid var(--c-primary-2);
  }
  .live-feed__row--warn {
    border-left: 2px solid var(--c-warn);
  }
  .live-feed__row--sage {
    border-left: 2px solid var(--j-sage);
  }

  .live-feed__source {
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    padding: 2px 6px;
    border: 1px solid currentColor;
    line-height: 1.4;
    text-align: center;
  }
  .live-feed__source--cobalt {
    color: var(--c-primary-2);
  }
  .live-feed__source--warn {
    color: var(--c-warn);
  }
  .live-feed__source--sage {
    color: var(--j-sage);
  }

  .live-feed__hm {
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--c-ink-3);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
    text-align: right;
    position: relative;
  }
  /* v7.9.2 — venue-local clock is hidden by default, fades in on row hover.
     Stays inside the same grid cell so the layout doesn't reflow. */
  .live-feed__hm-local {
    display: block;
    font-size: 9px;
    color: var(--c-warn);
    letter-spacing: 0.06em;
    margin-top: 2px;
    opacity: 0;
    transition: opacity 160ms ease;
    pointer-events: none;
  }
  .live-feed__row:hover .live-feed__hm-local,
  .live-feed__row:focus-within .live-feed__hm-local {
    opacity: 1;
  }

  .live-feed__title {
    font: 500 13px / 1.4 var(--ff-sans);
    color: var(--c-ink);
    text-decoration: none;
    transition: color 200ms var(--j-ease-out);
  }
  .live-feed__title:hover,
  .live-feed__title:focus-visible {
    color: var(--c-warn);
  }

  .live-feed__cat {
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .live-feed__related {
    font-size: 10px;
    color: var(--c-warn);
    text-align: right;
    font-weight: 600;
    cursor: help;
  }

  /* v7.9.1 — anchor link for permalinks */
  .live-feed__anchor {
    font-size: 11px;
    color: var(--c-ink-4);
    text-decoration: none;
    text-align: center;
    transition: color 120ms ease;
    line-height: 1.4;
  }
  .live-feed__anchor:hover,
  .live-feed__anchor:focus-visible {
    color: var(--c-warn);
  }
  .live-feed__anchor:focus-visible {
    outline: 2px solid var(--c-amber);
    outline-offset: 1px;
  }

  /* === Empty === */
  .live-feed__empty {
    margin: 0;
    padding: 24px 0;
    color: var(--c-ink-2);
    font-size: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .live-feed__empty-text {
    font-variant-numeric: tabular-nums;
  }

  /* === sr-only utility (a11y) === */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* === Responsive === */
  @media (max-width: 900px) {
    .live-feed__row {
      grid-template-columns: 56px 32px 1fr 18px;
      gap: 8px;
    }
    .live-feed__cat,
    .live-feed__related {
      grid-column: 3;
      margin-top: 4px;
    }
    .live-feed__anchor {
      grid-column: 4;
    }
    .live-feed__count {
      flex-basis: 100%;
      margin-left: 0;
    }
  }
  @media (max-width: 720px) {
    .live-feed__cap-stamp {
      margin-left: 0;
      flex-basis: 100%;
      margin-top: 4px;
    }
    .live-feed__search {
      flex-basis: 100%;
      max-width: none;
    }
  }

  /* === Reduced motion === */
  @media (prefers-reduced-motion: reduce) {
    .live-feed__row:hover,
    .live-feed__row:focus-visible {
      background: transparent;
    }
    .live-feed__title {
      transition: none;
    }
    .live-feed__row[data-flash='1'] {
      animation: none;
    }
  }
</style>

<script>
  /**
   * v7.9.1 — earth-hover-emit + filter / search / focus-scroll.
   *
   * 1. Filter chips (ALL · GDELT · arXiv · WIRE) toggle visibility.
   * 2. Search input filters by title substring (case-insensitive).
   * 3. earth:venue-focus / earth:country-focus → scroll first matching row
   *    into view + flash highlight.
   * 4. URL hash `#event-<id>` on load → scroll + flash.
   * 5. Anchor link click copies the permalink to clipboard.
   */
  const EMIT_COOLDOWN_MS = 80;
  const FLASH_DURATION_MS = 1600;

  /* === earth:focus emit (preserved) ====================================== */
  document.addEventListener('mouseover', (ev) => {
    const target = ev.target as HTMLElement | null;
    if (!target) return;
    const row = target.closest<HTMLElement>('.live-feed__row');
    if (!row) return;
    const id = row.dataset.eventId;
    if (!id) return;
    const lastId = row.getAttribute('data-last-emit');
    const lastTs = Number(row.getAttribute('data-last-ts') ?? '0');
    const now = Date.now();
    if (lastId === id && now - lastTs < EMIT_COOLDOWN_MS) return;
    row.setAttribute('data-last-emit', id);
    row.setAttribute('data-last-ts', String(now));
    window.dispatchEvent(
      new CustomEvent('earth:focus', {
        detail: {
          id,
          lat: row.dataset.eventLat ? Number(row.dataset.eventLat) : null,
          lon: row.dataset.eventLon ? Number(row.dataset.eventLon) : null,
        },
      }),
    );
  });

  document.addEventListener('focusin', (ev) => {
    const target = ev.target as HTMLElement | null;
    if (!target) return;
    const row = target.closest<HTMLElement>('.live-feed__row');
    if (!row) return;
    const id = row.dataset.eventId;
    if (!id) return;
    window.dispatchEvent(
      new CustomEvent('earth:focus', {
        detail: {
          id,
          lat: row.dataset.eventLat ? Number(row.dataset.eventLat) : null,
          lon: row.dataset.eventLon ? Number(row.dataset.eventLon) : null,
        },
      }),
    );
  });

  /* === v7.9.1 — filter chips + search ==================================== */
  const root = document.querySelector<HTMLElement>('[data-live-feed]');
  const list = document.querySelector<HTMLElement>('[data-live-list]');
  const counter = document.querySelector<HTMLElement>('[data-visible-count]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const chipButtons = document.querySelectorAll<HTMLButtonElement>('[data-source-filter]');
  const cityButtons = document.querySelectorAll<HTMLButtonElement>('[data-city-filter]');
  const timeButtons = document.querySelectorAll<HTMLButtonElement>('[data-time-filter]');
  const refreshCountdown = document.querySelector<HTMLElement>('[data-refresh-countdown]');
  /* === v7.19 — a11y live region + keyboard shortcuts ====================== */
  const announcer = document.querySelector<HTMLElement>('[data-live-announcer]');
  let announceTimer: number | null = null;

  let activeSource = 'all';
  let activeQuery = '';
  let activeCity = 'all';
  let activeWindow: 'all' | '1h' | '6h' | '24h' = 'all';

  /* === v7.10 — URL persistence (shareable filter URLs) ==================== */
  type FilterParams = {
    source: string;
    query: string;
    city: string;
    window: 'all' | '1h' | '6h' | '24h';
  };
  function readFiltersFromUrl(): FilterParams {
    const sp = new URLSearchParams(window.location.search);
    const source = sp.get('s');
    const query = sp.get('q') ?? '';
    const city = sp.get('c') ?? 'all';
    const win = sp.get('w') ?? 'all';
    const allowedWin: Array<'all' | '1h' | '6h' | '24h'> = ['all', '1h', '6h', '24h'];
    const windowVal = (allowedWin as string[]).includes(win)
      ? (win as 'all' | '1h' | '6h' | '24h')
      : 'all';
    return { source: source ?? 'all', query, city, window: windowVal };
  }
  function writeFiltersToUrl(): void {
    const sp = new URLSearchParams(window.location.search);
    if (activeSource && activeSource !== 'all') sp.set('s', activeSource);
    else sp.delete('s');
    if (activeQuery) sp.set('q', activeQuery);
    else sp.delete('q');
    if (activeCity && activeCity !== 'all') sp.set('c', activeCity);
    else sp.delete('c');
    if (activeWindow && activeWindow !== 'all') sp.set('w', activeWindow);
    else sp.delete('w');
    const qs = sp.toString();
    const next = `${window.location.pathname}${qs ? '?' + qs : ''}${window.location.hash}`;
    history.replaceState(null, '', next);
  }

  function flashRow(row: HTMLElement): void {
    row.setAttribute('data-flash', '1');
    window.setTimeout(() => row.removeAttribute('data-flash'), FLASH_DURATION_MS);
  }

  function applyFilters(): void {
    if (!list) return;
    const rows = list.querySelectorAll<HTMLElement>('.live-feed__row');
    const winMs =
      activeWindow === '1h'
        ? 60 * 60 * 1000
        : activeWindow === '6h'
          ? 6 * 60 * 60 * 1000
          : activeWindow === '24h'
            ? 24 * 60 * 60 * 1000
            : Infinity;
    let visible = 0;
    for (const row of rows) {
      const source = row.dataset.eventSource ?? '';
      const title = row.dataset.eventTitle ?? '';
      const city = row.dataset.eventCity ?? '';
      const tsRaw = row.dataset.eventTs ?? '';
      const ts = Number(tsRaw);
      const sourceOk = activeSource === 'all' || source === activeSource;
      const queryOk = !activeQuery || title.includes(activeQuery) || city.includes(activeQuery);
      const cityOk = activeCity === 'all' || city === activeCity;
      const winOk = activeWindow === 'all' || !Number.isFinite(ts) || Date.now() - ts <= winMs;
      const show = sourceOk && queryOk && cityOk && winOk;
      if (show) {
        row.removeAttribute('data-filtered');
        visible++;
      } else {
        row.setAttribute('data-filtered', '1');
      }
    }
    if (counter) counter.textContent = `${visible} VISIBLE`;
    // v7.19 — announce filter result to screen-reader users (debounced 250ms)
    if (announcer) {
      const total = rows.length;
      const text =
        visible === total
          ? `Showing all ${total} event${total === 1 ? '' : 's'}.`
          : `Showing ${visible} of ${total} event${total === 1 ? '' : 's'} matching current filters.`;
      if (announceTimer !== null) window.clearTimeout(announceTimer);
      announceTimer = window.setTimeout(() => {
        announcer.textContent = text;
      }, 250);
    }
  }

  /* Initial sync from URL — apply active filters before listeners wire up. */
  const initialFilters = readFiltersFromUrl();
  activeSource = initialFilters.source;
  activeQuery = initialFilters.query;
  activeCity = initialFilters.city;
  activeWindow = initialFilters.window;
  if (searchInput && activeQuery) searchInput.value = activeQuery;
  for (const btn of chipButtons) {
    if ((btn.dataset.sourceFilter ?? 'all') === activeSource) {
      for (const other of chipButtons) other.classList.remove('live-feed__chip-btn--active');
      btn.classList.add('live-feed__chip-btn--active');
    }
  }
  for (const btn of cityButtons) {
    if ((btn.dataset.cityFilter ?? 'all') === activeCity) {
      for (const other of cityButtons) other.classList.remove('live-feed__city-btn--active');
      btn.classList.add('live-feed__city-btn--active');
    }
  }
  for (const btn of timeButtons) {
    if ((btn.dataset.timeFilter ?? 'all') === activeWindow) {
      for (const other of timeButtons) other.classList.remove('live-feed__chip-btn--active');
      btn.classList.add('live-feed__chip-btn--active');
    }
  }
  applyFilters();

  for (const btn of chipButtons) {
    btn.addEventListener('click', () => {
      for (const other of chipButtons) {
        other.classList.remove('live-feed__chip-btn--active');
      }
      btn.classList.add('live-feed__chip-btn--active');
      activeSource = btn.dataset.sourceFilter ?? 'all';
      applyFilters();
      writeFiltersToUrl();
    });
  }

  for (const btn of cityButtons) {
    btn.addEventListener('click', () => {
      for (const other of cityButtons) {
        other.classList.remove('live-feed__city-btn--active');
      }
      btn.classList.add('live-feed__city-btn--active');
      activeCity = btn.dataset.cityFilter ?? 'all';
      applyFilters();
      writeFiltersToUrl();
    });
  }

  /* === v7.11 — time-scope filter buttons =================================== */
  for (const btn of timeButtons) {
    btn.addEventListener('click', () => {
      for (const other of timeButtons) {
        other.classList.remove('live-feed__chip-btn--active');
      }
      btn.classList.add('live-feed__chip-btn--active');
      const win = btn.dataset.timeFilter ?? 'all';
      activeWindow = win === '1h' || win === '6h' || win === '24h' ? win : 'all';
      applyFilters();
      writeFiltersToUrl();
    });
  }

  let searchDebounce: number | null = null;
  searchInput?.addEventListener('input', () => {
    activeQuery = (searchInput.value ?? '').trim().toLowerCase();
    applyFilters();
    if (searchDebounce !== null) window.clearTimeout(searchDebounce);
    searchDebounce = window.setTimeout(() => writeFiltersToUrl(), 250);
  });

  /* === v7.10 — share button: copy filtered URL to clipboard ============= */
  const shareBtn = document.querySelector<HTMLButtonElement>('[data-share-link]');
  shareBtn?.addEventListener('click', () => {
    const url = window.location.href;
    const flash = (text: string): void => {
      const orig = shareBtn.textContent ?? '';
      shareBtn.textContent = text;
      shareBtn.setAttribute('data-copied', '1');
      window.setTimeout(() => {
        shareBtn.textContent = orig;
        shareBtn.removeAttribute('data-copied');
      }, 1400);
    };
    if (navigator.clipboard?.writeText) {
      navigator.clipboard
        .writeText(url)
        .then(() => flash('COPIED · LINK'))
        .catch(() => flash('COPY · FAILED'));
    } else {
      flash('COPY · UNSUPPORTED');
    }
  });

  /* === v7.9.3 — keyboard nav (j/k = next/prev row) ======================== */
  const rows = () =>
    Array.from(document.querySelectorAll<HTMLElement>('.live-feed__row:not([data-filtered="1"])'));
  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'j' && ev.key !== 'k') return;
    const t = ev.target as HTMLElement | null;
    if (!t) return;
    // Skip when typing in an input/textarea.
    const tag = t.tagName.toLowerCase();
    if (tag === 'input' || tag === 'textarea' || t.isContentEditable) return;
    const visible = rows();
    if (visible.length === 0) return;
    const active = document.activeElement as HTMLElement | null;
    const idx = visible.findIndex((r) => r === active || r.contains(active));
    const nextIdx = ev.key === 'j' ? Math.min(visible.length - 1, idx + 1) : Math.max(0, idx - 1);
    const next = visible[nextIdx === -1 ? 0 : nextIdx];
    if (!next) return;
    ev.preventDefault();
    next.scrollIntoView({ behavior: 'smooth', block: 'center' });
    flashRow(next);
    next.focus({ preventScroll: true });
  });

  /* === v7.19 — keyboard shortcuts (/ focus search, Escape clear) ========== */
  document.addEventListener('keydown', (ev) => {
    const t = ev.target as HTMLElement | null;
    const tag = t?.tagName.toLowerCase() ?? '';
    const inEditable = tag === 'input' || tag === 'textarea' || (t?.isContentEditable ?? false);

    // `/` → focus search (only when not already in an input)
    if (ev.key === '/' && !inEditable) {
      if (searchInput) {
        ev.preventDefault();
        searchInput.focus();
        searchInput.select();
      }
      return;
    }

    // `Escape` → clear search (only when search is focused AND has content)
    if (ev.key === 'Escape' && searchInput && document.activeElement === searchInput) {
      if (searchInput.value !== '') {
        ev.preventDefault();
        searchInput.value = '';
        activeQuery = '';
        applyFilters();
        writeFiltersToUrl();
      }
      return;
    }
  });

  /* === v7.9.3 — refresh countdown =========================================
     Cloudflare Pages free tier rebuilds on git push; cron doesn't trigger
     live cache rebuilds, so this is a soft hint about how stale the data
     is. Counts minutes since the cache was generated. */
  if (refreshCountdown) {
    const generatedAttr = refreshCountdown.dataset.generated;
    const generatedMs = generatedAttr ? new Date(generatedAttr).getTime() : Date.now();
    const tick = (): void => {
      const ageMin = Math.max(0, Math.floor((Date.now() - generatedMs) / 60_000));
      refreshCountdown.textContent = `CACHE · ${ageMin}M OLD`;
    };
    tick();
    window.setInterval(tick, 60_000);
  }

  /* === v7.9.1 — earth:venue-focus / earth:country-focus scroll ============ */
  function findFirstRowByCity(city: string): HTMLElement | null {
    if (!list) return null;
    const key = city.toLowerCase();
    return list.querySelector<HTMLElement>(`.live-feed__row[data-event-city="${CSS.escape(key)}"]`);
  }
  function findFirstRowByCountry(countryName: string): HTMLElement | null {
    if (!list) return null;
    // Country focus carries the country name. We match the title for any
    // country-named substring; this is heuristic but cheap.
    const key = countryName.toLowerCase();
    return list.querySelector<HTMLElement>(
      `.live-feed__row[data-event-title*="${CSS.escape(key)}"]`,
    );
  }

  window.addEventListener('earth:venue-focus', (ev: Event) => {
    const detail = (ev as CustomEvent<{ city?: string }>).detail;
    if (!detail?.city) return;
    const row = findFirstRowByCity(detail.city);
    if (!row) return;
    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
    flashRow(row);
  });

  window.addEventListener('earth:country-focus', (ev: Event) => {
    const detail = (ev as CustomEvent<{ name?: string }>).detail;
    if (!detail?.name) return;
    const row = findFirstRowByCountry(detail.name);
    if (!row) return;
    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
    flashRow(row);
  });

  /* === v7.9.1 — URL hash deep-link on load ================================ */
  function scrollToHashTarget(): void {
    const hash = window.location.hash;
    if (!hash || !hash.startsWith('#event-')) return;
    const target = document.querySelector<HTMLElement>(hash);
    if (!target) return;
    // Wait for layout to settle (filters applied above).
    requestAnimationFrame(() => {
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      flashRow(target);
    });
  }
  scrollToHashTarget();
  window.addEventListener('hashchange', scrollToHashTarget);

  /* === v7.9.1 — prevent duplicate flash on anchor click ================== */
  document.querySelectorAll<HTMLAnchorElement>('[data-anchor-link]').forEach((a) => {
    a.addEventListener('click', () => {
      const hash = a.getAttribute('href') ?? '';
      if (hash) {
        history.replaceState(null, '', hash);
        const target = document.querySelector<HTMLElement>(hash);
        if (target) flashRow(target);
      }
    });
  });

  /* === Refs to silence unused-var lints for the root node ================ */
  void root;
</script>
