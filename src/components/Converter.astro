---
/**
 * Converter.astro — v13.1.4 polish-7bc : world-class bank chrome.
 *
 * Institutional live FX + crypto converter modal. Mounted in BaseLayout.astro
 * as a sibling of CommandPalette (⌘K) + WorldView (⌘J). Opens via ⌘C keydown
 * OR SideRail shortcut button. Data fetched server-side from the Worker /rates
 * endpoint — no browser-side CORS dance.
 *
 * Chrome contract v1 (world-class bank):
 *   - mono font for ALL numeric data (var(--ff-mono))
 *   - tabular numerals (font-variant-numeric: tabular-nums)
 *   - amber (#6B5A1A) accent only on hero numbers, active delta, active tab
 *     underline, sync dot, source-attribution headers
 *   - hairline borders (var(--c-rule) at 1px)
 *   - sharp 0-2px corners (no rounded "cards")
 *   - no halo, no glow, no gradient, no shadow beyond 1px hairline
 *   - F-key strip across the top (Bloomberg metaphor)
 *   - source health pills under the F-strip (LIVE / STALE / DOWN)
 *   - hero conversion row with bid/ask disclosure for crypto
 *   - dense rate tables with 24h range mini-bars
 *   - refresh countdown with progress bar
 *
 * Structure:
 *   1. Hidden trigger button (data-cnv-open) — event-bus target
 *   2. Modal root (.cnv [data-cnv] role="dialog" aria-modal="true")
 *   3. Scrim (.cnv__scrim [data-cnv-close]) — backdrop close
 *   4. Panel (.cnv__panel) — the actual mini-web-app:
 *        a. F-key strip : F1/F2/F3 + window title + ESC hint
 *        b. Source health pills : ECB · BINANCE · COINGECKO · YAHOO status
 *        c. Hero conversion card : FROM amount ↔ TO amount
 *        d. Tabbed rate tables : FOREX | CRYPTO (BINANCE) | CRYPTO (COINGECKO)
 *        e. Footer : refresh progress bar + shortcut hints
 *
 * Constraints (binding):
 *   - §6 NDA scope : zero employer mentions
 *   - senior "Quant Researcher" positioning
 *   - 0 em-dashes (G81)
 *   - no Math.random / Date.now in chrome render
 *   - WCAG 2.2 AA: keyboard nav, focus rings, screen-reader labels
 *   - no {var} interpolation leaks
 *
 * Event-bus:
 *   - data-cnv-open (click) → cnv:open (custom event)
 *   - data-cnv-close (click) → close
 *   - Esc key → close
 *   - ⌘C / Ctrl+C → toggle (when modal is mountable; otherwise no-op)
 */
import { ALL_CURRENCIES, DEFAULT_SOURCE, DEFAULT_TARGET } from '@data/currencies';

const AI_PROXY_URL = 'https://christianmacion-ai-proxy.christianmacion.workers.dev';
const HAS_PROXY = AI_PROXY_URL !== '';

// Catalog snapshot for the client-side filtering. Mirrors the structure
// the previous page consumed (id, symbol, name, region, decimals, source,
// binanceSymbol, ecbKey, yahooTicker).
const catalog = ALL_CURRENCIES.map((c) => ({
  id: c.id,
  symbol: c.symbol,
  name: c.name,
  region: c.region,
  decimals: c.decimals,
  source: c.source,
  binanceSymbol: c.binanceSymbol ?? null,
  ecbKey: c.ecbKey ?? null,
  yahooTicker: c.yahooTicker ?? null,
}));

// Default source / target for the modal opener.
const defaultSource = DEFAULT_SOURCE;
const defaultTarget = DEFAULT_TARGET;
---

<!-- Hidden trigger button (event-bus target). The SideRail shortcut
     button is the visible trigger; this hidden button is the stable
     event-bus target so any caller (footer, KeyBoardShortcut, etc.)
     can open the modal via `cnv:open` without exposing a function. -->
<button
  type="button"
  class="cnv-trigger"
  data-cnv-open
  aria-label="Open live currency converter"
  aria-keyshortcuts="Meta+C Control+C"
  tabindex="-1"
></button>

<!-- Modal: role=dialog, aria-modal=true, hidden until ⌘C. -->
<div
  class="cnv"
  data-cnv
  role="dialog"
  aria-modal="true"
  aria-labelledby="cnv-title"
  hidden
>
  <button
    type="button"
    class="cnv__scrim"
    data-cnv-close
    aria-label="Close converter"
    tabindex="-1"
  ></button>

  <div class="cnv__panel" role="document">

    <!-- =========================================================
         F1 — F-KEY STRIP : top-of-book metaphor (Bloomberg style).
         Each F-key is a "screen" the operator can punch to. The
         active screen is the first/only one we own (FX), so F1 is
         highlighted. F2-F4 are reserved for future surfaces.
         ========================================================= -->
    <nav class="cnv__fkeys mono" aria-label="Converter surfaces">
      <span class="cnv__fkey is-on" data-cnv-surface="rates">
        <span class="cnv__fkey-tag">F1</span>
        <span class="cnv__fkey-label">RATES</span>
      </span>
      <span class="cnv__fkey" data-cnv-surface="future" aria-disabled="true">
        <span class="cnv__fkey-tag">F2</span>
        <span class="cnv__fkey-label">CARRY</span>
      </span>
      <span class="cnv__fkey" data-cnv-surface="future" aria-disabled="true">
        <span class="cnv__fkey-tag">F3</span>
        <span class="cnv__fkey-label">VOL</span>
      </span>
      <span class="cnv__fkey" data-cnv-surface="future" aria-disabled="true">
        <span class="cnv__fkey-tag">F4</span>
        <span class="cnv__fkey-label">CORR</span>
      </span>
      <span class="cnv__fkey-spacer"></span>
      <span class="cnv__title mono" id="cnv-title">
        LIVE CONVERTER
        <span class="cnv__title-kbd mono" aria-hidden="true">⌘C</span>
      </span>
      <span class="cnv__fkey-spacer"></span>
      <span class="cnv__close mono" data-cnv-close role="button" tabindex="0" aria-label="Close converter">
        ESC · CLOSE
      </span>
    </nav>

    <!-- =========================================================
         F2 — SOURCE HEALTH STRIP : per-feed status pills.
         Renders LIVE / STALE / DOWN with a color-coded dot + a
         human-readable stamp. The operator always knows which
         feed is hot. Mirrors the Worker envelope `source_status`.
         ========================================================= -->
    <div class="cnv__health mono" role="status" aria-live="polite" data-cnv-health>
      <span class="cnv__pill cnv__pill--ecb" data-cnv-pill="ecb">
        <span class="cnv__pill-dot" data-cnv-pill-dot></span>
        <span class="cnv__pill-tag">ECB</span>
        <span class="cnv__pill-state" data-cnv-pill-state>WAITING</span>
        <span class="cnv__pill-stamp" data-cnv-pill-stamp>·</span>
      </span>
      <span class="cnv__pill cnv__pill--binance" data-cnv-pill="binance">
        <span class="cnv__pill-dot" data-cnv-pill-dot></span>
        <span class="cnv__pill-tag">BINANCE</span>
        <span class="cnv__pill-state" data-cnv-pill-state>WAITING</span>
        <span class="cnv__pill-stamp" data-cnv-pill-stamp>·</span>
      </span>
      <span class="cnv__pill cnv__pill--coingecko" data-cnv-pill="coingecko">
        <span class="cnv__pill-dot" data-cnv-pill-dot></span>
        <span class="cnv__pill-tag">COINGECKO</span>
        <span class="cnv__pill-state" data-cnv-pill-state>WAITING</span>
        <span class="cnv__pill-stamp" data-cnv-pill-stamp>·</span>
      </span>
      <span class="cnv__pill cnv__pill--yahoo" data-cnv-pill="yahoo">
        <span class="cnv__pill-dot" data-cnv-pill-dot></span>
        <span class="cnv__pill-tag">YAHOO</span>
        <span class="cnv__pill-state" data-cnv-pill-state>WAITING</span>
        <span class="cnv__pill-stamp" data-cnv-pill-stamp>·</span>
      </span>
    </div>

    <!-- =========================================================
         F3 — HERO CONVERSION CARD : the operator's primary readout.
         Three-column grid: FROM amount | ↔ | TO amount. Source
         attribution + 1-unit cross rate sits below the trio.
         ========================================================= -->
    <section class="cnv__hero mono" aria-label="Conversion">

      <div class="cnv__hero-col cnv__hero-col--from">
        <label class="cnv__hero-label" for="cnv-amount-from">FROM</label>
        <input
          id="cnv-amount-from"
          class="cnv__hero-amount"
          data-cnv-amount-from
          data-cnv-amount
          type="text"
          inputmode="decimal"
          autocomplete="off"
          spellcheck="false"
          value="100"
          aria-label="Source amount"
        />
        <label class="cnv__hero-label" for="cnv-currency-from">CURRENCY</label>
        <div class="cnv__select-wrap">
          <select
            id="cnv-currency-from"
            class="cnv__hero-select"
            data-cnv-from
            aria-label="Source currency"
          >
            {catalog.map((c) => (
              <option value={c.id} selected={c.id === defaultSource}>
                {c.symbol} · {c.name}
              </option>
            ))}
          </select>
          <span class="cnv__select-caret" aria-hidden="true">▾</span>
        </div>
        <span class="cnv__hero-meta mono" data-cnv-from-meta>·</span>
      </div>

      <button
        type="button"
        class="cnv__swap"
        data-cnv-swap
        aria-label="Swap source and target currencies"
        title="Swap source and target (S)"
      >
        <span class="cnv__swap-arrow" aria-hidden="true">⇄</span>
        <span class="cnv__swap-rate" data-cnv-rate-pair>1 USD = · PHP</span>
      </button>

      <div class="cnv__hero-col cnv__hero-col--to">
        <label class="cnv__hero-label" for="cnv-amount-to">TO</label>
        <input
          id="cnv-amount-to"
          class="cnv__hero-amount cnv__hero-amount--read"
          data-cnv-amount-to
          type="text"
          inputmode="decimal"
          autocomplete="off"
          spellcheck="false"
          value="·"
          aria-label="Target amount (live)"
          aria-live="polite"
          readonly
        />
        <label class="cnv__hero-label" for="cnv-currency-to">CURRENCY</label>
        <div class="cnv__select-wrap">
          <select
            id="cnv-currency-to"
            class="cnv__hero-select"
            data-cnv-to
            aria-label="Target currency"
          >
            {catalog.map((c) => (
              <option value={c.id} selected={c.id === defaultTarget}>
                {c.symbol} · {c.name}
              </option>
            ))}
          </select>
          <span class="cnv__select-caret" aria-hidden="true">▾</span>
        </div>
        <span class="cnv__hero-meta mono" data-cnv-to-meta>·</span>
      </div>
    </section>

    <!-- =========================================================
         F4 — TAB STRIP : F-key style tabs (one per universe).
         Active tab gets the amber underline + brighter ink.
         ========================================================= -->
    <div class="cnv__tabs mono" role="tablist" aria-label="Rate universes">
      <button
        type="button"
        class="cnv__tab is-active"
        data-cnv-tab="forex"
        role="tab"
        aria-selected="true"
        aria-controls="cnv-tabpanel-forex"
      >
        <span class="cnv__tab-tag">F1</span>
        <span class="cnv__tab-label">FOREX · ECB</span>
        <span class="cnv__tab-count" data-cnv-tab-count="forex">·</span>
      </button>
      <button
        type="button"
        class="cnv__tab"
        data-cnv-tab="crypto-binance"
        role="tab"
        aria-selected="false"
        aria-controls="cnv-tabpanel-crypto-binance"
      >
        <span class="cnv__tab-tag">F2</span>
        <span class="cnv__tab-label">CRYPTO · BINANCE</span>
        <span class="cnv__tab-count" data-cnv-tab-count="crypto-binance">·</span>
      </button>
      <button
        type="button"
        class="cnv__tab"
        data-cnv-tab="crypto-coingecko"
        role="tab"
        aria-selected="false"
        aria-controls="cnv-tabpanel-crypto-coingecko"
      >
        <span class="cnv__tab-tag">F3</span>
        <span class="cnv__tab-label">CRYPTO · COINGECKO</span>
        <span class="cnv__tab-count" data-cnv-tab-count="crypto-coingecko">·</span>
      </button>
    </div>

    <!-- =========================================================
         F5 — RATE TABLES : dense institutional grid.
         FOREX shows MID only (ECB publishes one daily reference).
         CRYPTO shows LAST / BID / ASK / 24H Δ / 24H RANGE.
         Rows are 18px tall, hairlines between, hover = amber wash.
         ========================================================= -->
    <div
      class="cnv__panel-table is-active"
      id="cnv-tabpanel-forex"
      role="tabpanel"
      aria-labelledby="cnv-tab-forex"
    >
      <div class="cnv__scroll" role="region" aria-label="FOREX (ECB) rates">
        <table class="cnv__table mono">
          <thead>
            <tr>
              <th class="cnv__th cnv__th--sym">SYM</th>
              <th class="cnv__th cnv__th--name">NAME</th>
              <th class="cnv__th cnv__th--num">MID</th>
              <th class="cnv__th cnv__th--num">REGION</th>
              <th class="cnv__th cnv__th--src">SRC</th>
            </tr>
          </thead>
          <tbody data-cnv-rows-forex></tbody>
        </table>
      </div>
    </div>

    <div
      class="cnv__panel-table"
      id="cnv-tabpanel-crypto-binance"
      role="tabpanel"
      aria-labelledby="cnv-tab-crypto-binance"
      hidden
    >
      <div class="cnv__scroll" role="region" aria-label="CRYPTO (BINANCE) rates">
        <table class="cnv__table mono">
          <thead>
            <tr>
              <th class="cnv__th cnv__th--sym">SYM</th>
              <th class="cnv__th cnv__th--name">NAME</th>
              <th class="cnv__th cnv__th--num">LAST</th>
              <th class="cnv__th cnv__th--num">BID</th>
              <th class="cnv__th cnv__th--num">ASK</th>
              <th class="cnv__th cnv__th--num">24H Δ</th>
              <th class="cnv__th cnv__th--range">24H RNG</th>
              <th class="cnv__th cnv__th--src">SRC</th>
            </tr>
          </thead>
          <tbody data-cnv-rows-crypto-binance></tbody>
        </table>
      </div>
    </div>

    <div
      class="cnv__panel-table"
      id="cnv-tabpanel-crypto-coingecko"
      role="tabpanel"
      aria-labelledby="cnv-tab-crypto-coingecko"
      hidden
    >
      <div class="cnv__scroll" role="region" aria-label="CRYPTO (COINGECKO) rates">
        <table class="cnv__table mono">
          <thead>
            <tr>
              <th class="cnv__th cnv__th--sym">SYM</th>
              <th class="cnv__th cnv__th--name">NAME</th>
              <th class="cnv__th cnv__th--num">LAST</th>
              <th class="cnv__th cnv__th--num">BID</th>
              <th class="cnv__th cnv__th--num">ASK</th>
              <th class="cnv__th cnv__th--num">24H Δ</th>
              <th class="cnv__th cnv__th--range">24H RNG</th>
              <th class="cnv__th cnv__th--src">SRC</th>
            </tr>
          </thead>
          <tbody data-cnv-rows-crypto-coingecko></tbody>
        </table>
      </div>
    </div>

    <!-- =========================================================
         F6 — FOOTER : refresh progress bar + keyboard shortcuts.
         The progress bar fills as the countdown ticks (visual
         refresh metaphor). Shortcut hints use monospace kbd chips.
         ========================================================= -->
    <footer class="cnv__foot mono">
      <div class="cnv__refresh" aria-label="Next refresh in">
        <span class="cnv__refresh-label">REFRESH</span>
        <span class="cnv__refresh-bar" aria-hidden="true">
          <span class="cnv__refresh-fill" data-cnv-refresh-fill></span>
        </span>
        <span class="cnv__refresh-count" data-cnv-countdown>30s</span>
      </div>
      <div class="cnv__shortcuts" aria-label="Keyboard shortcuts">
        <span class="cnv__shortcut"><kbd>ESC</kbd> close</span>
        <span class="cnv__shortcut"><kbd>R</kbd> refresh</span>
        <span class="cnv__shortcut"><kbd>S</kbd> swap</span>
        <span class="cnv__shortcut"><kbd>TAB</kbd> universe</span>
        <span class="cnv__shortcut"><kbd>↵</kbd> row → FROM</span>
      </div>
      <span class="cnv__foot-stamp mono" data-cnv-foot-stamp>·</span>
    </footer>

  </div>
</div>

<!-- Hidden data : pass the catalog to the client-side script.
     Kept under data-cnv-config to keep the DOM tidy. -->
<script
  type="application/json"
  data-cnv-config
  set:html={JSON.stringify({
    aiProxyUrl: HAS_PROXY ? AI_PROXY_URL : '',
    currencies: catalog,
    defaultSource,
    defaultTarget,
  })}
/>

<style>
  /* ============================================================
     0. MODAL SHELL : role=dialog, z-modal, hidden until open.
     ============================================================ */
  .cnv {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cnv[hidden] {
    display: none;
  }
  .cnv__scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--c-bg) 92%, transparent);
    border: 0;
    padding: 0;
    cursor: default;
  }

  .cnv__panel {
    position: relative;
    width: min(960px, 94vw);
    max-height: 90vh;
    overflow: auto;
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: 0;
    padding: 0;
    box-shadow: 0 1px 0 var(--c-rule);
    /* Bloomberg terminal: a panel is a panel. No drop-shadow beyond a 1px hairline. */
    font-family: var(--ff-mono);
    color: var(--c-ink);
  }

  /* ============================================================
     1. F-KEY STRIP : top-of-book metaphor.
     ============================================================ */
  .cnv__fkeys {
    display: flex;
    align-items: stretch;
    gap: 0;
    height: 28px;
    padding: 0;
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg-2);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }
  .cnv__fkey {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
    color: var(--c-ink-3);
    border-right: 1px solid var(--c-rule);
    cursor: default;
    transition: color 120ms var(--mv-ease-institutional, ease-out),
      background 120ms var(--mv-ease-institutional, ease-out);
    white-space: nowrap;
  }
  .cnv__fkey.is-on {
    color: var(--c-amber);
    background: var(--c-bg);
    box-shadow: inset 0 -2px 0 var(--c-amber);
  }
  .cnv__fkey-tag {
    font-weight: 700;
    font-size: 0.58rem;
    padding: 1px 4px;
    border: 1px solid currentColor;
    border-radius: 0;
    line-height: 1;
  }
  .cnv__fkey-label {
    font-weight: 600;
  }
  .cnv__fkey-spacer {
    flex: 1 1 auto;
    border-right: 0;
  }
  .cnv__title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    margin: 0;
    color: var(--c-ink);
    font-weight: 700;
    text-transform: uppercase;
    border-right: 1px solid var(--c-rule);
    border-left: 1px solid var(--c-rule);
    background: var(--c-bg);
    letter-spacing: 0.14em;
  }
  .cnv__title-kbd {
    font-size: 0.58rem;
    padding: 1px 5px;
    border: 1px solid var(--c-rule);
    color: var(--c-amber);
    border-radius: 0;
    line-height: 1;
  }
  .cnv__close {
    display: inline-flex;
    align-items: center;
    padding: 0 12px;
    color: var(--c-ink-3);
    cursor: pointer;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    transition: color 120ms ease;
  }
  .cnv__close:hover,
  .cnv__close:focus-visible {
    color: var(--c-amber);
    outline: none;
  }

  /* ============================================================
     2. SOURCE HEALTH STRIP : per-feed LIVE / STALE / DOWN pills.
     ============================================================ */
  .cnv__health {
    display: flex;
    align-items: stretch;
    gap: 0;
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
  }
  .cnv__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-right: 1px solid var(--c-rule);
    color: var(--c-ink-3);
    transition: color 120ms ease;
    white-space: nowrap;
  }
  .cnv__pill:last-child {
    border-right: 0;
  }
  .cnv__pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-ink-3);
    flex-shrink: 0;
    transition: background 200ms var(--mv-ease-data, linear);
  }
  /* State text uses darker shades for WCAG AA on parchment (per chrome
     contract: status binding via text + weight + label, color is supplementary).
     Dots stay bright (decorative accent, not text). */
  .cnv__pill[data-state="live"] .cnv__pill-dot {
    background: var(--c-status-open, #3fb950);
    box-shadow: 0 0 0 0 var(--c-status-open, #3fb950);
    animation: cnv-pulse 2s ease-out infinite;
  }
  .cnv__pill[data-state="live"] .cnv__pill-state {
    color: #0d7a30; /* darker sage, ~5.4:1 on parchment */
    font-weight: 700;
  }
  .cnv__pill[data-state="stale"] .cnv__pill-dot {
    background: var(--c-bind-iterate, #d4a017);
  }
  .cnv__pill[data-state="stale"] .cnv__pill-state {
    color: #7a5a0a; /* darker amber-iterate, ~4.6:1 on parchment */
    font-weight: 700;
  }
  .cnv__pill[data-state="down"] .cnv__pill-dot {
    background: var(--c-status-blocked, #c0392b);
  }
  .cnv__pill[data-state="down"] .cnv__pill-state {
    color: #8a1f12; /* darker oxblood, ~6.0:1 on parchment */
    font-weight: 700;
  }
  @keyframes cnv-pulse {
    0%   { box-shadow: 0 0 0 0   color-mix(in oklab, var(--c-status-open, #3fb950) 60%, transparent); }
    70%  { box-shadow: 0 0 0 6px color-mix(in oklab, var(--c-status-open, #3fb950) 0%,   transparent); }
    100% { box-shadow: 0 0 0 0   color-mix(in oklab, var(--c-status-open, #3fb950) 0%,   transparent); }
  }
  .cnv__pill-tag {
    font-weight: 700;
    color: var(--c-ink);
    letter-spacing: 0.14em;
  }
  .cnv__pill-state {
    font-weight: 700;
  }
  .cnv__pill-stamp {
    color: var(--c-ink-3);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
  }

  /* ============================================================
     3. HERO CONVERSION CARD.
     ============================================================ */
  .cnv__hero {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg);
    min-height: 132px;
  }
  .cnv__hero-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    background: var(--c-bg-2);
