<script>
  /**
   * converter modal client script (vanilla TS, no deps).
   *
   * Data flow:
   *   1. Read config from <script type="application/json" data-cnv-config>.
   *   2. Fetch `GET AI_PROXY_URL/rates` — single envelope, server-side
   *      aggregation of ECB + Binance + CoinGecko + Yahoo.
   *   3. Compute fiat-to-fiat and fiat-to-crypto cross rates from the
   *      envelope's USD-anchored rates.
   *   4. Render the hero conversion + the three tab tables.
   *   5. Re-fetch every 30s. Visible countdown decrements every second.
   *
   * Failure modes:
   *   - Worker unreachable / 4xx / 5xx  → "rate unavailable" message;
   *     modal stays open; user can close with ESC.
   *   - Per-source degradation  → envelope's source_status reports which
   *     source is down; the table cells render `·` rather than fabricating
   *     numbers, and the source-health strip shows STALE / DOWN pills.
   *   - Non-numeric input → silently skipped until retyped.
   *   - Rate = 0           → treated as unavailable (division guard).
   */
  import { ALL_CURRENCIES, getCurrencyMeta } from '@data/currencies';

  type CurrencyBucket = 'fiat' | 'crypto-binance' | 'crypto-coingecko';

  interface Catalog {
    currencies: Array<{
      id: string;
      symbol: string;
      name: string;
      region: string;
      decimals: number;
      source: CurrencyBucket;
      binanceSymbol: string | null;
      ecbKey: string | null;
      yahooTicker: string | null;
    }>;
  }

  interface RatesEnvelope {
    request_id: string;
    ts: string;
    source_status: {
      ecb: 'ok' | 'degraded' | 'down';
      binance: 'ok' | 'degraded' | 'down';
      coingecko: 'ok' | 'degraded' | 'down';
      yahoo: 'ok' | 'degraded' | 'down';
    };
    fiat: Record<string, number>;
    crypto: Record<string, {
      last: number;
      bid?: number;
      ask?: number;
      change24h?: number;
      volume24h?: number;
      source: 'binance' | 'coingecko';
      symbol: string;
      high24h?: number;
      low24h?: number;
    }>;
    stale: boolean;
  }

  /* ============================================================================
   * CONFIG + STATE
   * ========================================================================== */

  const configScript = document.querySelector('[data-cnv-config]');
  if (!configScript) throw new Error('converter: missing [data-cnv-config]');
  const config = JSON.parse(configScript.textContent ?? '{}') as {
    aiProxyUrl: string;
    currencies: Catalog['currencies'];
  };
  const catalogData: Catalog = { currencies: config.currencies };

  const AI_PROXY_URL = config.aiProxyUrl;
  const REFRESH_INTERVAL_SEC = 30;

  let envelope: RatesEnvelope | null = null;
  let fromId = 'USD';
  let toId = 'PHP';
  let fromAmount = 100;
  let activeTab: 'forex' | 'crypto-binance' | 'crypto-coingecko' = 'forex';
  let countdown = REFRESH_INTERVAL_SEC;
  let refreshTimer: ReturnType<typeof setInterval> | null = null;
  let countdownTimer: ReturnType<typeof setInterval> | null = null;
  let lastFetchOk: number | null = null;

  /* ============================================================================
   * UTILS
   * ========================================================================== */

  function $(sel: string): HTMLElement | null {
    return document.querySelector(sel);
  }
  function $$(sel: string): NodeListOf<HTMLElement> {
    return document.querySelectorAll(sel);
  }

  function fmt(num: number, decimals: number): string {
    if (!Number.isFinite(num) || num === 0) return '·';
    return new Intl.NumberFormat('en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    }).format(num);
  }

  function fmtSignedPct(num: number): string {
    if (!Number.isFinite(num)) return '·';
    const arrow = num > 0.05 ? '▲' : num < -0.05 ? '▼' : '·';
    return arrow + ' ' + Math.abs(num).toFixed(2) + '%';
  }

  function fmtTime(iso: string): string {
    if (!iso) return '·';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '·';
    const hh = String(d.getUTCHours()).padStart(2, '0');
    const mm = String(d.getUTCMinutes()).padStart(2, '0');
    const ss = String(d.getUTCSeconds()).padStart(2, '0');
    return `${hh}:${mm}:${ss}Z`;
  }

  function fmtAge(seconds: number): string {
    if (seconds < 60) return seconds + 's';
    if (seconds < 3600) return Math.floor(seconds / 60) + 'm ' + (seconds % 60) + 's';
    return Math.floor(seconds / 3600) + 'h';
  }

  function parseAmount(input: string): number | null {
    const cleaned = input.replace(/[\s,]/g, '');
    if (cleaned === '' || cleaned === '-' || cleaned === '.') return null;
    const n = Number(cleaned);
    if (!Number.isFinite(n)) return null;
    return n;
  }

  /* ============================================================================
   * RATE FETCH (server-side proxy via Worker /rates)
   * ========================================================================== */

  async function fetchRates(): Promise<RatesEnvelope | null> {
    if (!AI_PROXY_URL) return null;
    try {
      const resp = await fetch(AI_PROXY_URL + '/rates', {
        method: 'GET',
        headers: { Accept: 'application/json' },
      });
      if (!resp.ok) {
        console.warn('rates HTTP', resp.status);
        return null;
      }
      return (await resp.json()) as RatesEnvelope;
    } catch (err) {
      console.warn('rates fetch failed', err);
      return null;
    }
  }

  /* ============================================================================
   * CONVERSION MATH
   * ========================================================================== */

  /**
   * Compute the cross rate from `from` to `to`. Returns 1-from = N to.
   * All envelope rates are USD-per-1-unit CCY, so the cross is uniform.
   */
  function computeCross(from: string, to: string): {
    rate: number;
    src: string;
  } | null {
    if (!envelope) return null;
    const { fiat, crypto } = envelope;

    const fromC = catalogData.currencies.find((c) => c.id === from);
    const toC = catalogData.currencies.find((c) => c.id === to);
    if (!fromC || !toC) return null;

    // USD-per-1-unit CCY for fiat, and for crypto we treat last as USD.
    const fromUsd = fromC.source === 'crypto-binance' || fromC.source === 'crypto-coingecko'
      ? (crypto[from]?.last ?? 0)
      : (fiat[from] ?? 0);
    const toUsd = toC.source === 'crypto-binance' || toC.source === 'crypto-coingecko'
      ? (crypto[to]?.last ?? 0)
      : (fiat[to] ?? 0);

    if (!fromUsd || !toUsd) return null;
    const rate = toUsd / fromUsd;
    const src =
      (fromC.source === 'fiat' ? (fromC.ecbKey ? 'ECB' : 'YAHOO') : fromC.source.toUpperCase()) +
      ' · ' +
      (toC.source === 'fiat' ? (toC.ecbKey ? 'ECB' : 'YAHOO') : toC.source.toUpperCase());
    return { rate, src };
  }

  /* ============================================================================
   * SOURCE HEALTH : per-feed status pill renderer.
   * Translates envelope.source_status + freshness into a 4-state pill.
   * ========================================================================== */

  function renderSourceHealth(): void {
    const pills = $$('[data-cnv-pill]');
    if (!envelope) {
      pills.forEach((pill) => {
        pill.setAttribute('data-state', 'waiting');
        const state = pill.querySelector('[data-cnv-pill-state]');
        if (state) state.textContent = 'WAITING';
      });
      return;
    }
    const now = Date.now();
    const ts = new Date(envelope.ts).getTime();
    const ageSec = isFinite(ts) ? Math.floor((now - ts) / 1000) : 9999;

    // Map worker source_status → pill state.
    // `ok` = live, `degraded` = stale, `down` = down.
    const map: Record<string, 'live' | 'stale' | 'down' | 'waiting'> = {
      ecb: envelope.source_status.ecb === 'ok' ? 'live'
        : envelope.source_status.ecb === 'degraded' ? 'stale' : 'down',
      binance: envelope.source_status.binance === 'ok' ? 'live'
        : envelope.source_status.binance === 'degraded' ? 'stale' : 'down',
      coingecko: envelope.source_status.coingecko === 'ok' ? 'live'
        : envelope.source_status.coingecko === 'degraded' ? 'stale' : 'down',
      yahoo: envelope.source_status.yahoo === 'ok' ? 'live'
        : envelope.source_status.yahoo === 'degraded' ? 'stale' : 'down',
    };

    pills.forEach((pill) => {
      const feed = pill.getAttribute('data-cnv-pill') as keyof typeof map | null;
      if (!feed) return;
      const state = map[feed];
      pill.setAttribute('data-state', state);
      const stateEl = pill.querySelector('[data-cnv-pill-state]');
      const stampEl = pill.querySelector('[data-cnv-pill-stamp]');
      if (stateEl) stateEl.textContent = state === 'live' ? 'LIVE' : state === 'stale' ? 'STALE' : 'DOWN';
      if (stampEl) {
        stampEl.textContent = state === 'live' ? fmtAge(ageSec) : state === 'stale' ? fmtAge(ageSec) : '—';
      }
    });
  }

  /* ============================================================================
   * HERO RENDER : primary readout for the operator.
   * ========================================================================== */

  function renderHero(): void {
    const cross = computeCross(fromId, toId);
    const toC = catalogData.currencies.find((c) => c.id === toId);
    const fromC = catalogData.currencies.find((c) => c.id === fromId);
    const decimals = toC?.decimals ?? 4;

    const toEl = $('[data-cnv-amount-to]');
    if (!toEl) return;

    const ratePairEl = $('[data-cnv-rate-pair]');
    const fromMetaEl = $('[data-cnv-from-meta]');
    const toMetaEl = $('[data-cnv-to-meta]');
    const footStampEl = $('[data-cnv-foot-stamp]');

    if (!cross) {
      toEl.value = '·';
      if (ratePairEl) ratePairEl.textContent = '1 ' + fromId + ' = · ' + toId;
      if (fromMetaEl) fromMetaEl.textContent = 'RATE UNAVAILABLE';
      if (toMetaEl) toMetaEl.textContent = 'REFRESHING…';
      if (footStampEl) footStampEl.textContent = '—';
      return;
    }

    const targetAmount = fromAmount * cross.rate;
    toEl.value = fmt(targetAmount, decimals);

    if (ratePairEl) ratePairEl.textContent = '1 ' + fromId + ' = ' + fmt(cross.rate, decimals) + ' ' + toId;

    const stamp = envelope ? fmtTime(envelope.ts) : '·';
    const staleTag = envelope?.stale ? ' · CACHED' : '';

    if (fromMetaEl) {
      const fromSrc = fromC
        ? (fromC.source === 'fiat' ? (fromC.ecbKey ? 'ECB' : 'YAHOO') : fromC.source.toUpperCase())
        : '·';
      fromMetaEl.textContent = fromSrc + ' · ' + stamp + staleTag;
    }
    if (toMetaEl) {
      const toSrc = toC
        ? (toC.source === 'fiat' ? (toC.ecbKey ? 'ECB' : 'YAHOO') : toC.source.toUpperCase())
        : '·';
      toMetaEl.textContent = toSrc + ' · ' + stamp + staleTag;
    }
    if (footStampEl) footStampEl.textContent = stamp + staleTag;
  }

  /* ============================================================================
   * TAB COUNTS : how many rows are populated per universe.
   * ========================================================================== */

  function renderTabCounts(): void {
    if (!envelope) return;
    const fiatCount = catalogData.currencies.filter((c) => c.source === 'fiat').length;
    const validFiat = catalogData.currencies.filter(
      (c) => c.source === 'fiat' && Number.isFinite(envelope!.fiat[c.id]) && envelope!.fiat[c.id] > 0,
    ).length;
    const binCount = catalogData.currencies.filter((c) => c.source === 'crypto-binance').length;
    const validBin = catalogData.currencies.filter(
      (c) => c.source === 'crypto-binance' && envelope!.crypto[c.id] && Number.isFinite(envelope!.crypto[c.id]!.last),
    ).length;
    const cgCount = 0; // coingecko not in current catalog
    const validCg = 0;

    const f1 = $('[data-cnv-tab-count="forex"]');
    const f2 = $('[data-cnv-tab-count="crypto-binance"]');
    const f3 = $('[data-cnv-tab-count="crypto-coingecko"]');
    if (f1) f1.textContent = `${validFiat}/${fiatCount}`;
    if (f2) f2.textContent = `${validBin}/${binCount}`;
    if (f3) f3.textContent = `${validCg}/${cgCount}`;
  }

  /* ============================================================================
   * TABLE RENDER : FOREX rows (ECB / Yahoo / METALS).
   * Shows MID only — ECB publishes one daily reference rate.
   * ========================================================================== */

  function renderForexRows(): void {
    const tbody = $('[data-cnv-rows-forex]');
    if (!tbody || !envelope) {
      if (tbody) tbody.innerHTML = '<tr><td colspan="5" class="cnv__empty">WAITING FOR ECB…</td></tr>';
      return;
    }
    const fiat = catalogData.currencies.filter((c) => c.source === 'fiat');
    tbody.innerHTML = fiat
      .map((c) => {
        const rate = envelope!.fiat[c.id];
        const valid = Number.isFinite(rate) && rate > 0;
        const srcStatus = envelope!.source_status[c.ecbKey ? 'ecb' : 'yahoo'] === 'ok'
          ? 'live'
          : envelope!.source_status[c.ecbKey ? 'ecb' : 'yahoo'] === 'degraded'
            ? 'stale'
            : 'down';
        const srcLabel = c.ecbKey ? 'ECB' : c.yahooTicker ? 'YF' : '·';
        return `
        <tr class="cnv__tr" data-cnv-prefill="${c.id}" tabindex="0" role="button" aria-label="Prefill converter with ${c.id}">
          <td class="cnv__td cnv__td--sym">${c.symbol}</td>
          <td class="cnv__td cnv__td--name">${c.name}</td>
          <td class="cnv__td cnv__td--num">${valid ? fmt(rate, c.decimals) : '·'}</td>
          <td class="cnv__td cnv__td--region">${c.region}</td>
          <td class="cnv__td cnv__td--src"><span class="cnv__src-chip" data-status="${srcStatus}">${srcLabel}</span></td>
        </tr>`;
      })
      .join('');
    wireRowPrefill(tbody);
  }

  /* ============================================================================
   * TABLE RENDER : CRYPTO rows (Binance / CoinGecko).
   * Shows LAST / BID / ASK / 24H Δ / 24H RANGE.
   * ========================================================================== */

  function renderCryptoRows(bucket: 'crypto-binance' | 'crypto-coingecko'): void {
    const tbody = $(
      bucket === 'crypto-binance'
        ? '[data-cnv-rows-crypto-binance]'
        : '[data-cnv-rows-crypto-coingecko]',
    );
    if (!tbody) return;
    const crypto = catalogData.currencies.filter((c) => c.source === bucket);
    if (!envelope || crypto.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" class="cnv__empty">NO ' + bucket.toUpperCase().replace('CRYPTO-', '') + ' SYMBOLS</td></tr>';
      return;
    }
    const feedKey = bucket === 'crypto-binance' ? 'binance' : 'coingecko';
    const srcStatus = envelope.source_status[feedKey] === 'ok'
      ? 'live'
      : envelope.source_status[feedKey] === 'degraded'
        ? 'stale'
        : 'down';
    const srcLabel = bucket === 'crypto-binance' ? 'BIN' : 'CG';

    tbody.innerHTML = crypto
      .map((c) => {
        const t = envelope!.crypto[c.id];
        const valid = !!t && Number.isFinite(t.last) && t.last > 0;
        const deltaCls =
          valid && t && t.change24h !== undefined
            ? t.change24h > 0.05
              ? 'cnv__td--up'
              : t.change24h < -0.05
                ? 'cnv__td--down'
                : 'cnv__td--flat'
            : 'cnv__td--flat';
        const bidValid = valid && t && Number.isFinite(t.bid) && t.bid! > 0;
        const askValid = valid && t && Number.isFinite(t.ask) && t.ask! > 0;
        const rangeHtml = valid && t && t.high24h !== undefined && t.low24h !== undefined
          ? renderRangeBar(t.low24h!, t.high24h!, t.last)
          : '<span class="cnv__range-na">N/A</span>';
        return `
        <tr class="cnv__tr" data-cnv-prefill="${c.id}" tabindex="0" role="button" aria-label="Prefill converter with ${c.id}">
          <td class="cnv__td cnv__td--sym">${c.symbol}</td>
          <td class="cnv__td cnv__td--name">${c.name}</td>
          <td class="cnv__td cnv__td--num">${valid && t ? fmt(t.last, c.decimals) : '·'}</td>
          <td class="cnv__td cnv__td--num">${bidValid && t ? fmt(t.bid!, c.decimals) : '·'}</td>
          <td class="cnv__td cnv__td--num">${askValid && t ? fmt(t.ask!, c.decimals) : '·'}</td>
          <td class="cnv__td cnv__td--num ${deltaCls}">${valid && t && t.change24h !== undefined ? fmtSignedPct(t.change24h) : '·'}</td>
          <td class="cnv__td cnv__td--range">${rangeHtml}</td>
          <td class="cnv__td cnv__td--src"><span class="cnv__src-chip" data-status="${srcStatus}">${srcLabel}</span></td>
        </tr>`;
      })
      .join('');
    wireRowPrefill(tbody);
  }

  /**
   * Render a 24h range mini-bar showing where the last price sits within
   * the 24h low / high band. Banks use this exact visual on trading desks.
   */
  function renderRangeBar(low: number, high: number, last: number): string {
    if (!Number.isFinite(low) || !Number.isFinite(high) || high <= low) {
      return '<span class="cnv__range-na">N/A</span>';
    }
    const range = high - low;
    const markPct = ((last - low) / range) * 100;
    const width = Math.min(100, Math.max(0, markPct));
    const cls = last > (low + range * 0.5) ? 'cnv__td--up' : 'cnv__td--down';
    return `<span class="cnv__range ${cls}" title="${fmt(low, 2)} – ${fmt(high, 2)}"><span class="cnv__range-fill" style="left:0; width:${width.toFixed(1)}%"></span><span class="cnv__range-mark" style="left:${width.toFixed(1)}%"></span></span>`;
  }

  function wireRowPrefill(tbody: Element): void {
    tbody.querySelectorAll('[data-cnv-prefill]').forEach((row) => {
      const id = row.getAttribute('data-cnv-prefill');
      if (!id) return;
      const h = (e: Event) => {
        e.preventDefault();
        fromId = id;
        const select = $('[data-cnv-from]') as HTMLSelectElement | null;
        if (select) select.value = id;
        renderHero();
      };
      row.addEventListener('click', h);
      row.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') h(e);
      });
    });
  }

  /* ============================================================================
   * REFRESH
   * ========================================================================== */

  async function refresh(): Promise<void> {
    const next = await fetchRates();
    if (!next) {
      const fromMeta = $('[data-cnv-from-meta]');
      if (fromMeta) fromMeta.textContent = 'RATE UNAVAILABLE · RETRYING…';
      lastFetchOk = null;
      renderSourceHealth();
      return;
    }
    envelope = next;
    lastFetchOk = Date.now();
    renderSourceHealth();
    renderHero();
    renderTabCounts();
    renderForexRows();
    renderCryptoRows('crypto-binance');
    renderCryptoRows('crypto-coingecko');
  }

  /* ============================================================================
   * OPEN / CLOSE
   * ========================================================================== */

  function open(): void {
    const root = $('[data-cnv]');
    if (!root) return;
    root.removeAttribute('hidden');
    refresh();
    if (refreshTimer) clearInterval(refreshTimer);
    refreshTimer = setInterval(refresh, REFRESH_INTERVAL_SEC * 1000);
    if (countdownTimer) clearInterval(countdownTimer);
    countdown = REFRESH_INTERVAL_SEC;
    countdownTimer = setInterval(tick, 1000);
    // Focus the source input.
    const fromInput = $('[data-cnv-amount-from]') as HTMLInputElement | null;
    if (fromInput) {
      setTimeout(() => fromInput.focus(), 0);
    }
  }

  function close(): void {
    const root = $('[data-cnv]');
    if (!root) return;
    root.setAttribute('hidden', '');
    if (refreshTimer) {
      clearInterval(refreshTimer);
      refreshTimer = null;
    }
    if (countdownTimer) {
      clearInterval(countdownTimer);
      countdownTimer = null;
    }
  }

  function tick(): void {
    countdown = Math.max(0, countdown - 1);
    const el = $('[data-cnv-countdown]');
    if (el) el.textContent = countdown + 's';
    const fill = $('[data-cnv-refresh-fill]') as HTMLElement | null;
    if (fill) {
      const pct = ((REFRESH_INTERVAL_SEC - countdown) / REFRESH_INTERVAL_SEC) * 100;
      fill.style.width = pct.toFixed(1) + '%';
    }
    if (countdown === 0) countdown = REFRESH_INTERVAL_SEC;
    // Re-render source health ages every tick.
    renderSourceHealth();
  }

  /* ============================================================================
   * WIRING
   * ========================================================================== */

  function wireInputs(): void {
    const fromInput = $('[data-cnv-amount-from]') as HTMLInputElement | null;
    const fromSelect = $('[data-cnv-from]') as HTMLSelectElement | null;
    const toSelect = $('[data-cnv-to]') as HTMLSelectElement | null;
    const swapBtn = $('[data-cnv-swap]') as HTMLButtonElement | null;

    fromInput?.addEventListener('input', () => {
      const n = parseAmount(fromInput.value);
      if (n === null) return;
      fromAmount = n;
      renderHero();
    });
    fromSelect?.addEventListener('change', () => {
      fromId = fromSelect.value;
      renderHero();
    });
    toSelect?.addEventListener('change', () => {
      toId = toSelect.value;
      renderHero();
    });
    swapBtn?.addEventListener('click', () => {
      [fromId, toId] = [toId, fromId];
      if (fromSelect) fromSelect.value = fromId;
      if (toSelect) toSelect.value = toId;
      renderHero();
    });
  }

  function wireTabs(): void {
    const tabs = $$('[data-cnv-tab]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-cnv-tab') as typeof activeTab | null;
        if (!target) return;
        activeTab = target;
        tabs.forEach((t) => {
          const isActive = t.getAttribute('data-cnv-tab') === target;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        const panels = $$('.cnv__panel-table');
        panels.forEach((p) => {
          const id = p.id;
          const matches =
            (target === 'forex' && id === 'cnv-tabpanel-forex') ||
            (target === 'crypto-binance' && id === 'cnv-tabpanel-crypto-binance') ||
            (target === 'crypto-coingecko' && id === 'cnv-tabpanel-crypto-coingecko');
          if (matches) {
            p.removeAttribute('hidden');
            p.classList.add('is-active');
          } else {
            p.setAttribute('hidden', '');
            p.classList.remove('is-active');
          }
        });
      });
    });
  }

  function wireClose(): void {
    // Scrim click closes.
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      if (target.closest('[data-cnv-close]')) {
        e.preventDefault();
        close();
      }
    });
    // Esc closes when modal is open.
    document.addEventListener('keydown', (e) => {
      const root = $('[data-cnv]');
      if (!root || root.hasAttribute('hidden')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      // Don't intercept keys when input is focused.
      const ae = document.activeElement;
      const isEditable =
        ae instanceof HTMLElement &&
        (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA' || ae.tagName === 'SELECT');
      if (isEditable) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const key = e.key.toLowerCase();
      if (key === 'r') {
        e.preventDefault();
        refresh();
      }
      if (key === 's') {
        e.preventDefault();
        const swapBtn = $('[data-cnv-swap]') as HTMLButtonElement | null;
        swapBtn?.click();
      }
      // Tab cycles through universes (forward), Shift+Tab backward.
      if (key === 'tab') {
        e.preventDefault();
        const order: Array<typeof activeTab> = ['forex', 'crypto-binance', 'crypto-coingecko'];
        const idx = order.indexOf(activeTab);
        const next = e.shiftKey
          ? (idx - 1 + order.length) % order.length
          : (idx + 1) % order.length;
        const target = order[next];
        const tab = $(`[data-cnv-tab="${target}"]`) as HTMLButtonElement | null;
        tab?.click();
      }
    });
  }

  function wireTrigger(): void {
    // Open triggers: any [data-cnv-open] element (SideRail shortcut, hidden
    // trigger, future footer link). Delegated so the listener is bound once.
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const t = target.closest('[data-cnv-open]');
      if (t) {
        e.preventDefault();
        open();
      }
    });
    // Listen for the custom event so external callers can dispatch
    // `new CustomEvent('cnv:open')` without exposing a global fn.
    document.addEventListener('cnv:open', open);
  }

  /* ============================================================================
   * BOOT
   * ========================================================================== */

  wireInputs();
  wireTabs();
  wireClose();
  wireTrigger();

  /* Silence the unused-import warning for ALL_CURRENCIES / getCurrencyMeta
   * · they are kept in scope so the catalog can be expanded later without
   * having to re-import. */
  void ALL_CURRENCIES;
  void getCurrencyMeta;
</script>