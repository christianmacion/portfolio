---
/**
 * DataSourceList.astro : v12 LIVE-STATUS registry of public-domain data
 * sources used across the 9 quant research projects on /research and the
 * 4 live-data feeds on /now (WorldView).
 *
 * Standing Order: only sources that are verifiably public-domain, NDA-clean,
 * and known-licence are listed. No proprietary feeds, no employer scrapes,
 * no platform names. Each row carries {name, url_pattern, license, note,
 * cadence, endpoint} so a hiring manager can audit the data lineage with
 * curl.
 *
 * v12 row shape:
 *   - Source name + category
 *   - URL pattern (canonical upstream URL)
 *   - Licence (verbatim from upstream; if unknown, mark as such)
 *   - Refresh cadence (60s / 5min / 1h / 15min) - the upstream's
 *     own publish cadence, not a worker-cache hint
 *   - Status (live / cached / error) - derived client-side from the
 *     live endpoint probe
 *   - Last sync (HH:MM:SSZ) - last successful upstream pull
 *
 * The 4 "live" sources (Yahoo / CoinGecko / ECB / GDELT) are probed at
 * hydration; their lastSync + status update in place. The remaining
 * registry rows are static (no live upstream probe) and show
 * `last verified <registry-stamp>` - honest signal that the table
 * itself was re-checked at the current deploy, not that every source
 * was pulled today.
 *
 * Usage:
 *   <DataSourceList />
 */
import { buildStampUtc8 } from '@utils/build-stamp';
import { profile } from '@utils/profile';
// v6.11.16 : extracted registry to @utils/data-sources so /research can
// derive "12 sources" chrome from dataSources.length instead of a hardcoded
// literal. Single writer, multiple readers.
import { dataSources, type DataSource } from '@utils/data-sources';

void (0 as unknown as DataSource); // type-only import for downstream tooling

const lastVerified = buildStampUtc8();

// Live sources the visitor sees on /now : mapped to their Worker endpoints.
// Each row is sourced from the canonical data-sources.ts registry when
// possible; if a registry entry doesn't exist, the live row carries an
// inline definition here so the chrome stays self-contained.
interface LiveRow {
  name: string;
  category: DataSource['category'];
  url: string;
  endpoint: string;
  cadence: '60s' | '5min' | '15min' | '1h';
  license: string;
  note?: string;
}
const liveRows: LiveRow[] = [
  {
    name: 'Yahoo Finance (delayed quotes, free tier)',
    category: 'equity-deriv',
    url: 'https://query1.finance.yahoo.com/v7/finance/quote?symbols=SPY,QQQ,DIA,BTC-USD',
    endpoint: '/api/market/quotes',
    cadence: '60s',
    license: 'Yahoo terms (delayed >=15 min, non-commercial)',
    note: '4 equity + 1 ETF quotes via Cloudflare Worker proxy.',
  },
  {
    name: 'CoinGecko free tier (no API key)',
    category: 'crypto-onchain',
    url: 'https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,binancecoin',
    endpoint: '/api/market/crypto',
    cadence: '60s',
    license: 'Free tier, attribution required',
    note: '4 spot quotes via Cloudflare Worker proxy.',
  },
  {
    name: 'ECB SDMX (reference exchange rates)',
    category: 'fx',
    url: 'https://data-api.ecb.europa.eu/service/data/EXR/D.USD+GBP+JPY.EUR+USD',
    endpoint: '/api/market/fx',
    cadence: '1h',
    license: 'Public (European Central Bank, free re-use)',
    note: 'Daily reference rates; edge-cached for 1h.',
  },
  {
    name: 'GDELT 2.0 (global events)',
    category: 'macro',
    url: 'https://data.gdeltproject.org/gdeltv2/lastupdate.txt',
    endpoint: '/api/worldview/gdelt',
    cadence: '15min',
    license: 'Public (GDELT Project, free re-use)',
    note: '15-min event publish cadence; edge-cached for 15 min.',
  },
];
---

<section class="datasrc" aria-labelledby="datasrc-heading">
  <header class="datasrc__head">
    <p class="datasrc__eyebrow mono">Data source registry</p>
    <h2 id="datasrc-heading" class="datasrc__title">
      Every dataset behind the {profile.stats.strategyCount} strategies and live terminal.
    </h2>
    <p class="datasrc__sub">
      {dataSources.length + liveRows.length} sources. {liveRows.length} live feeds probe the
      upstream in real time; the rest are static research baselines. No proprietary feeds, no
      employer scrapes, no platform API keys. Each line carries its URL pattern and licence so a
      hiring manager can audit the data lineage with <span class="mono">curl</span>.
    </p>
    <p class="datasrc__verified mono">
      Registry last verified <time datetime={lastVerified}>{lastVerified}</time> · live feeds
      re-probed every 60s.
    </p>
  </header>

  <div class="datasrc__scroll" role="region" aria-label="Data sources table" tabindex="0">
    <table class="datasrc__table">
      <thead>
        <tr>
          <th class="datasrc__th" scope="col">Source</th>
          <th class="datasrc__th" scope="col">URL</th>
          <th class="datasrc__th" scope="col">Cadence</th>
          <th class="datasrc__th" scope="col">Last sync</th>
          <th class="datasrc__th" scope="col">Status</th>
          <th class="datasrc__th" scope="col">Licence</th>
        </tr>
      </thead>
      <tbody>
        {
          liveRows.map((row) => (
            <tr class="datasrc__row datasrc__row--live" data-live-endpoint={row.endpoint}>
              <th scope="row" class="datasrc__name">
                <span class="datasrc__name-text">{row.name}</span>
                {row.note && <span class="datasrc__note">{row.note}</span>}
              </th>
              <td class="datasrc__url mono">
                <a href={row.url} class="datasrc__url-link" rel="noopener noreferrer">
                  {row.url}
                </a>
              </td>
              <td class="datasrc__cadence mono">
                <span class:list={['datasrc__cad', `datasrc__cad--${row.cadence}`]}>
                  {row.cadence}
                </span>
              </td>
              <td class="datasrc__sync mono">
                <time data-live-sync datetime="">pending</time>
              </td>
              <td class="datasrc__status">
                <span
                  class:list={[
                    'datasrc__pill',
                    'datasrc__pill--status',
                    `datasrc__pill--status-pending`,
                  ]}
                  data-live-status
                >
                  pending
                </span>
              </td>
              <td class="datasrc__lic">{row.license}</td>
            </tr>
          ))
        }
        {
          dataSources.map((s) => (
            <tr class="datasrc__row datasrc__row--static">
              <th scope="row" class="datasrc__name">
                <span class="datasrc__name-text">{s.name}</span>
                {s.note && <span class="datasrc__note">{s.note}</span>}
              </th>
              <td class="datasrc__url mono">{s.urlPattern}</td>
              <td class="datasrc__cadence mono">
                <span class="datasrc__cad datasrc__cad--static">static</span>
              </td>
              <td class="datasrc__sync mono" data-static-verified>
                <time datetime={lastVerified}>{lastVerified}</time>
              </td>
              <td class="datasrc__status">
                <span class:list={['datasrc__pill', `datasrc__pill--${s.category}`]}>
                  {s.category}
                </span>
              </td>
              <td class="datasrc__lic">{s.license}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<script>
  // Live status probe : fetch each endpoint, derive lastSync + status
  // from the typed envelope. The 4 endpoints are public, rate-limited,
  // and edge-cached; a parallel fan-out completes in well under 1s.

  type TickerStatus = {
    yahoo: 'live' | 'cached' | 'error';
    coingecko: 'live' | 'cached' | 'error';
    ecb: 'live' | 'cached' | 'error';
  };

  type TickerResponse = {
    ok: true;
    lastSync: string;
    status: TickerStatus;
  };

  type GdeltResponse = {
    ok: true;
    lastSync: string;
  };

  type QuoteResponse = {
    ok: true;
    lastSync: string;
  };

  function lastSyncHHMMSS(iso: string): string {
    const m = iso.match(/T(\d{2}:\d{2}:\d{2})/);
    return m ? `${m[1]}Z` : iso;
  }

  async function probe(url: string): Promise<{ lastSync: string | null; status: 'live' | 'cached' | 'error' }> {
    try {
      const res = await fetch(url, { headers: { Accept: 'application/json' } });
      if (!res.ok) return { lastSync: null, status: 'error' };
      const age = Number(res.headers.get('Age') ?? '0');
      const raw: unknown = await res.json();
      const obj = raw as { ok?: unknown; lastSync?: unknown };
      if (obj.ok !== true || typeof obj.lastSync !== 'string') {
        return { lastSync: null, status: 'error' };
      }
      return { lastSync: obj.lastSync, status: age > 0 ? 'cached' : 'live' };
    } catch {
      return { lastSync: null, status: 'error' };
    }
  }

  function setRow(row: HTMLElement, lastSync: string | null, status: 'live' | 'cached' | 'error'): void {
    const syncEl = row.querySelector<HTMLElement>('[data-live-sync]');
    const statusEl = row.querySelector<HTMLElement>('[data-live-status]');
    if (syncEl) {
      if (lastSync) {
        syncEl.textContent = lastSyncHHMMSS(lastSync);
        syncEl.setAttribute('datetime', lastSync);
      } else {
        syncEl.textContent = 'unavailable';
        syncEl.removeAttribute('datetime');
      }
    }
    if (statusEl) {
      statusEl.textContent = status;
      statusEl.classList.remove('datasrc__pill--status-live', 'datasrc__pill--status-cached', 'datasrc__pill--status-error', 'datasrc__pill--status-pending');
      statusEl.classList.add(`datasrc__pill--status-${status}`);
    }
  }

  async function refreshRow(row: HTMLElement): Promise<void> {
    const endpoint = row.dataset.liveEndpoint;
    if (!endpoint) return;
    // The four endpoints are aggregator-shaped for ticker, individual for
    // the others. Use a unified probe envelope (lastSync + status).
    const { lastSync, status } = await probe(endpoint);
    setRow(row, lastSync, status);
  }

  function init(): void {
    const rows = document.querySelectorAll<HTMLElement>('.datasrc__row--live');
    rows.forEach((row) => {
      void refreshRow(row);
      // Re-probe every 60s. The aggregator endpoint is the only one
      // that surfaces a multi-source status map; the others are simple
      // ping checks.
      window.setInterval(() => void refreshRow(row), 60_000);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .datasrc {
    padding-block: var(--sp-9);
    background: var(--c-tape);
    border-block: var(--border-paper);
  }
  .datasrc__head {
    max-width: 880px;
    margin-inline: auto;
    margin-bottom: var(--sp-7);
    padding-inline: var(--sp-4);
  }
  .datasrc__eyebrow {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--c-phi);
    margin-bottom: var(--sp-3);
    font-weight: 600;
  }
  .datasrc__title {
    font-size: clamp(1.5rem, 3.5vw, var(--fs-2xl));
    color: var(--c-ink);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin-bottom: var(--sp-3);
    max-width: 22ch;
  }
  .datasrc__sub {
    color: var(--c-ink-2);
    font-size: var(--fs-base);
    line-height: 1.65;
    max-width: 64ch;
    margin-bottom: var(--sp-3);
  }
  .datasrc__verified {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    letter-spacing: 0.02em;
    margin: 0;
  }
  .datasrc__verified time {
    color: var(--c-phi);
  }

  .datasrc__scroll {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: var(--sp-4);
    overflow-x: auto;
    border: 1px solid var(--c-rule);
    /* v6.18 : rely on --j-r=0 via tokens-v6.13.css cascade */
    background: var(--c-tape-2);
  }
  .datasrc__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--fs-sm);
    min-width: 880px;
  }
  .datasrc__th {
    text-align: left;
    padding: var(--sp-3) var(--sp-4);
    background: var(--c-tape-3);
    color: var(--c-phi);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-xs);
    border-bottom: 1px solid var(--c-rule);
    position: sticky;
    top: 0;
  }
  .datasrc__row + .datasrc__row .datasrc__name,
  .datasrc__row + .datasrc__row .datasrc__url,
  .datasrc__row + .datasrc__row .datasrc__cadence,
  .datasrc__row + .datasrc__row .datasrc__sync,
  .datasrc__row + .datasrc__row .datasrc__status,
  .datasrc__row + .datasrc__row .datasrc__lic {
    border-top: 1px solid var(--c-rule);
  }
  .datasrc__name {
    padding: var(--sp-3) var(--sp-4);
    color: var(--c-ink);
    vertical-align: top;
    background: var(--c-tape-3);
    font-weight: 600;
    max-width: 320px;
  }
  .datasrc__name-text {
    display: block;
    line-height: 1.3;
  }
  .datasrc__note {
    display: block;
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    margin-top: var(--sp-1);
    font-weight: 400;
    line-height: 1.4;
  }
  .datasrc__cat,
  .datasrc__cadence,
  .datasrc__sync,
  .datasrc__status {
    padding: var(--sp-3) var(--sp-4);
    vertical-align: top;
  }
  .datasrc__pill {
    display: inline-block;
    padding: 2px 8px;
    /* v6.18 : rely on --j-r=0 via tokens-v6.13.css cascade */
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    border: 1px solid var(--c-rule);
    color: var(--c-ink-2);
    background: var(--c-bg-3);
  }
  /* F16 : institutional: collapse 7 colored pills → monochrome ink-3.
     Only the macro category keeps amber (the primary work surface).
     All others (equity/crypto/funding/rates/commodities/fx/cftc) read
     as ink-3 hairline-bordered labels : no rainbow. */
  .datasrc__pill--macro {
    color: var(--c-phi);
    border-color: var(--c-amberl-decor);
  }
  .datasrc__pill--equity-deriv {
    color: var(--c-ink-3);
    border-color: var(--c-rule);
  }
  .datasrc__pill--crypto-onchain {
    color: var(--c-ink-3);
    border-color: var(--c-rule);
  }
  .datasrc__pill--funding {
    color: var(--c-ink-3);
    border-color: var(--c-rule);
  }
  .datasrc__pill--rates {
    color: var(--c-ink-3);
    border-color: var(--c-rule);
  }
  .datasrc__pill--commodities {
    color: var(--c-ink-3);
    border-color: var(--c-rule);
  }
  .datasrc__pill--fx {
    color: var(--c-ink-3);
    border-color: var(--c-rule);
  }
  .datasrc__pill--cftc {
    color: var(--c-ink-2);
    border-color: var(--c-rule);
  }
  /* Status pills (live / cached / error / pending) keep monochrome
     borders to stay on-register; sentiment is carried by hue intensity,
     not by green/red. */
  .datasrc__pill--status {
    font-variant-numeric: tabular-nums;
  }
  .datasrc__pill--status-pending {
    color: var(--c-ink-3);
  }
  .datasrc__pill--status-live {
    color: var(--c-phi);
    border-color: var(--c-amberl-decor);
  }
  .datasrc__pill--status-cached {
    color: var(--c-ink-2);
  }
  .datasrc__pill--status-error {
    color: var(--c-ink);
    border-color: var(--c-rule);
  }

  .datasrc__url {
    padding: var(--sp-3) var(--sp-4);
    color: var(--c-ink-2);
    vertical-align: top;
    font-size: var(--fs-xs);
    word-break: break-word;
    line-height: 1.4;
    max-width: 340px;
  }
  .datasrc__url-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--c-rule);
    text-underline-offset: 2px;
  }
  .datasrc__url-link:hover {
    text-decoration-color: var(--c-amber);
    color: var(--c-ink);
  }
  .datasrc__cad {
    display: inline-block;
    padding: 2px 8px;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    border: 1px solid var(--c-rule);
    color: var(--c-ink-2);
    background: var(--c-bg-3);
    font-variant-numeric: tabular-nums;
  }
  .datasrc__cad--60s,
  .datasrc__cad--5min,
  .datasrc__cad--15min {
    color: var(--c-phi);
  }
  .datasrc__cad--1h {
    color: var(--c-ink-2);
  }
  .datasrc__cad--static {
    color: var(--c-ink-3);
  }
  .datasrc__sync {
    color: var(--c-ink-2);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  .datasrc__sync time {
    color: var(--c-phi);
  }
  .datasrc__lic {
    padding: var(--sp-3) var(--sp-4);
    color: var(--c-ink-3);
    vertical-align: top;
    font-size: var(--fs-xs);
    font-style: italic;
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .datasrc__scroll {
      margin-inline: 0;
      border-radius: 0;
      border-inline: none;
    }
  }
</style>
