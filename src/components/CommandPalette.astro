---
/**
 * CommandPalette.astro : v11.W2 ⌘K command palette (Bryllim).
 *
 * Site-wide fuzzy-search command palette. Opens on ⌘K / Ctrl+K from any
 * page, filters a static route index + the current page's in-page
 * sections, navigates on Enter. Vanilla TS, no new deps.
 *
 * v11.W2 chrome contract:
 *   - chrome contract v9.9.1 binding preserved
 *   - sharp 0-2px corners (border-radius 0)
 *   - hairline 1px borders (var(--c-rule))
 *   - mono eyebrow + amber accent only
 *   - reduced-motion: no slide-in animation
 *   - keyboard: arrow up/down, enter, escape, ⌘k
 *   - mount site-wide via BaseLayout.astro
 *
 * The pill in SiteHeader.astro is wired to dispatch the open event
 * (data-cmdk-open attribute → click → cmdk:open custom event). The
 * capture-phase keydown listener registered here wins against any
 * other ⌘K handler via stopImmediatePropagation.
 *
 * Bundle: ~3.6KB minified, ~1.4KB gzipped (route table + script).
 */
import { subpages } from '@data/subpages';
import { path as basePath } from '@utils/url';

const staticRoutes: Array<{ href: string; label: string; tag: string }> = [
  { href: '/',                label: 'Home',            tag: 'PAGE' },
  { href: '/now/',            label: 'Now',             tag: 'PAGE' },
  { href: '/for-recruiters/', label: 'For recruiters',  tag: 'PAGE' },
  { href: '/screening-call/', label: 'Screening call',  tag: 'PAGE' },
  { href: '/proof/',          label: 'Proof',           tag: 'PAGE' },
  { href: '/projects/',       label: 'Projects',        tag: 'PAGE' },
  { href: '/work/',           label: 'Work',            tag: 'PAGE' },
  { href: '/converter/',      label: 'Converter',       tag: 'PAGE' },
  { href: '/experience/',     label: 'Experience',      tag: 'PAGE' },
  { href: '/skills/',         label: 'Skills',          tag: 'PAGE' },
  { href: '/glossary/',       label: 'Glossary',        tag: 'PAGE' },
  { href: '/certifications/', label: 'Certifications',  tag: 'PAGE' },
  { href: '/positions/',      label: 'Positions',       tag: 'PAGE' },
  { href: '/publications/',   label: 'Publications',    tag: 'PAGE' },
  { href: '/methodology/',    label: 'Methodology',     tag: 'PAGE' },
  { href: '/talks/',          label: 'Talks',           tag: 'PAGE' },
  { href: '/contact/',        label: 'Contact',         tag: 'PAGE' },
];

const dynamicRoutes = subpages.map((s) => ({
  href: basePath(`/${s.slug}/`),
  label: s.label,
  tag: 'SUBPAGE',
}));

// v13.1.4 polish : per-route icon glyphs. 14x14 stroke-only svg, matches
// the SideRail icon vocabulary. Unknown routes fall back to a chevron
// so the column never feels empty.
const ICON_MAP: Record<string, string> = {
  '/':                '<path d="M3 9 L9 3 L15 9 M5 8 V14 H13 V8"/>',
  '/now/':            '<circle cx="9" cy="9" r="5.5"/><path d="M9 6 V9 L11 11"/>',
  '/for-recruiters/': '<path d="M3 7 H15 M3 11 H15 M5 4 H13 M5 14 H13"/>',
  '/screening-call/': '<path d="M4 5 H14 V13 H4 Z M4 8 H14 M7 5 V13"/>',
  '/proof/':          '<path d="M9 2 L14 5 V11 L9 14 L4 11 V5 Z"/>',
  '/projects/':       '<rect x="3" y="3" width="5" height="5"/><rect x="10" y="3" width="5" height="5"/><rect x="3" y="10" width="5" height="5"/><rect x="10" y="10" width="5" height="5"/>',
  '/work/':           '<path d="M3 4 H15 V12 H3 Z M3 7 H15 M6 4 V12"/>',
  '/converter/':      '<path d="M3 5 H11 M9 3 L11 5 L9 7 M13 11 H5 M7 9 L5 11 L7 13"/>',
  '/experience/':     '<path d="M3 6 L9 2 L15 6 V14 H3 Z M7 14 V9 H11 V14"/>',
  '/skills/':         '<path d="M3 9 L9 3 L15 9 M9 3 V14"/>',
  '/glossary/':       '<path d="M3 4 H10 V14 H3 Z M11 4 H15 V14 H11"/>',
  '/certifications/': '<circle cx="9" cy="9" r="5.5"/><path d="M6 9 L8.5 11.5 L12 7"/>',
  '/positions/':      '<rect x="3" y="4" width="12" height="10" rx="1"/><path d="M6 8 H12 M6 11 H10"/>',
  '/publications/':   '<path d="M4 3 H10 L13 6 V14 H4 Z M10 3 V6 H13"/>',
  '/methodology/':    '<path d="M3 9 H7 M11 9 H15 M3 5 H15 M3 13 H15"/>',
  '/talks/':          '<path d="M3 6 H13 V12 H3 Z M13 8 L16 6 V12 L13 10"/>',
  '/contact/':        '<rect x="3" y="5" width="12" height="9" rx="0.5"/><path d="M3 6 L9 10 L15 6"/>',
};
const DEFAULT_ICON = '<path d="M6 4 L12 9 L6 14"/>';
function iconFor(href: string): string {
  return ICON_MAP[href] ?? DEFAULT_ICON;
}

// v11.W2 : financial-markets tag for each subpage (W2 task #4).
const financialMarketsTag: Record<string, string> = {
  notes: 'Notes on financial markets, quant research, and AI engineering',
  stack: 'Stack for financial markets, quant research, and AI engineering',
  repos: 'Repos for financial markets, quant research, and AI engineering',
  engagement: 'Engagement model for financial markets, quant research, and AI engineering',
};

// v13.1.W3 (2026-08-10) : "Ask anything" AI mode.
// Edge AI gateway URL — the Worker is a separate repo
// (~/Contingency/christianmacion-ai-proxy/) deployed to
// Cloudflare Workers (NOT Pages; the site is on GH Pages).
// The Worker proxies Cloudflare Workers AI (llama-3.1-8b-instruct),
// enforces origin allowlist + 20/day per-IP rate limit, and
// streams the answer back as Server-Sent Events. The portfolio
// (static GH Pages) holds only the URL — no key, no secret.
//
// To swap the endpoint, change the URL here and rebuild.
// To kill the feature, set AI_PROXY_URL to '' (the JS will
// then disable ask mode and the "?" prefix will fall through
// to a no-op search).
const AI_PROXY_URL = 'https://christianmacion-ai-proxy.christianmacion.workers.dev';
const ASK_TRIGGER = '?'; // type "?" at the start of the input → ask mode

const allRoutes = [
  ...staticRoutes.map((r) => ({ ...r, href: basePath(r.href) })),
  ...dynamicRoutes,
];

// JSON payload embedded for the script (no extra fetch).
// v13.1.W3 (2026-08-10) : aiProxyUrl + askTrigger added so the
// client-side ask-mode script can wire to the edge Worker without
// a runtime env lookup (the site is static).
const routesJson = JSON.stringify(allRoutes);
const fmTagJson = JSON.stringify(financialMarketsTag);
const aiProxyUrl = AI_PROXY_URL;
const askTrigger = ASK_TRIGGER;
---

<!-- Hidden trigger button. Site-header pill (data-cmdk-open) is the
     visible trigger; this hidden button is a stable event-bus target
     so any caller can open the palette without exposing a function. -->
<button
  type="button"
  class="cmdk-trigger"
  data-cmdk-open
  aria-label="Open command palette"
  aria-keyshortcuts="Meta+K Control+K"
  tabindex="-1"
></button>

<!-- v12.W2 : WorldView Live sibling trigger. The actual <WorldView />
     modal is mounted by BaseLayout.astro; this trigger is the event-bus
     target so any caller (SiteHeader pill, footer link, etc.) can open
     the terminal without touching the script API. -->
<button
  type="button"
  class="wv-trigger-cm"
  data-worldview-open
  aria-label="Open WorldView Live terminal"
  aria-keyshortcuts="Meta+J Control+J"
  tabindex="-1"
></button>

<!-- Modal: role=dialog, aria-modal=true, hidden until ⌘K. -->
<div
  class="cmdk"
  data-cmdk
  role="dialog"
  aria-modal="true"
  aria-labelledby="cmdk-title"
  hidden
>
  <button
    type="button"
    class="cmdk__scrim"
    data-cmdk-close
    aria-label="Close command palette"
    tabindex="-1"
  ></button>
  <div class="cmdk__panel" role="document">
    <p id="cmdk-title" class="cmdk__title mono">ASK ANYTHING · ⌘K</p>
    <input
      class="cmdk__input mono"
      data-cmdk-input
      type="text"
      placeholder="Ask anything…"
      autocomplete="off"
      spellcheck="false"
      aria-label="Search routes and sections"
      aria-controls="cmdk-results"
      aria-activedescendant=""
    />
    <ul
      class="cmdk__list"
      data-cmdk-list
      id="cmdk-results"
      role="listbox"
      aria-label="Search results"
    ></ul>
    <!-- v13.1.W3 (2026-08-10) : "Ask anything" AI mode. Sibling to
         the search list; toggled visible when the input starts with
         the ask trigger ("?"). Hosts the streamed AI answer bubbles.
         role="log" + aria-live="polite" so screen readers announce
         new tokens as they arrive, without interrupting the user. -->
    <div
      class="cmdk__chat"
      data-cmdk-chat
      role="log"
      aria-live="polite"
      aria-label="AI answer"
      hidden
    >
      <ol class="cmdk__chat-thread" data-cmdk-thread></ol>
      <p class="cmdk__chat-status mono" data-cmdk-status aria-hidden="true"></p>
    </div>
    <p class="cmdk__hint mono" aria-hidden="true">
      <span data-cmdk-hint-nav><kbd>↑</kbd><kbd>↓</kbd> NAVIGATE</span>
      <span data-cmdk-hint-open><kbd>↵</kbd> OPEN</span>
      <span data-cmdk-hint-ask><kbd>?</kbd> ASK · <kbd>↵</kbd> SEND</span>
      <span><kbd>esc</kbd> CLOSE</span>
    </p>
  </div>
</div>

<style>
  /* Hidden trigger : event bus only. The pill in SiteHeader is the
     visible chrome; this button is the canonical click target so any
     caller (pill, footer link, etc.) can open the palette without
     touching the script API. */
  .cmdk-trigger,
  .wv-trigger-cm {
    display: none;
  }

  /* Modal: fixed full-viewport, single grid placement.
     v13.1.4 polish-7ax (2026-08-14): use --z-modal (100) instead of
     calc(--z-nav + 10) = 60 so the palette sits above WorldView
     (also fixed, z-index: var(--z-modal) = 100). DOM-order tie-break
     (CommandPalette mounts after WorldView) + anchored panel below
     the modal z-index prevent the SVG bleed that painted a giant
     triangle behind the empty-state "No matches..." line. */
  .cmdk {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: grid;
    place-items: start center;
    padding-top: 12vh;
  }
  .cmdk[hidden] {
    display: none;
  }

  /* Scrim: dark warm-dim (#0d1117 @ 0.85) : matches tokens-v6.13. */
  .cmdk__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(13, 17, 23, 0.85);
    cursor: pointer;
    border: 0;
    padding: 0;
  }

  /* Panel: cream on warm-dim. Sharp 0-2px, hairline 1px, amber rule
     on top per chrome contract v9.9.1 (no halo/glow/gradient). */
  .cmdk__panel {
    position: relative;
    /* v13.1.4 polish-7ax (2026-08-14): anchor the panel's own stacking
       context at z-index: 1 so no child paints at the modal's z-0
       baseline — defends against any SVG bleed from sibling fixed
       surfaces (e.g. WorldView at z-index: var(--z-modal)). */
    z-index: 1;
    width: min(560px, 92vw);
    max-height: 72vh;
    background: var(--c-bg);
    color: var(--c-ink);
    border: 1px solid var(--c-rule);
    border-top: 2px solid var(--c-amber);
    border-radius: 0;
    box-shadow: var(--shadow-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    font-family: var(--ff-sans);
  }

  .cmdk__title {
    margin: 0;
    padding: 12px 16px 6px;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--c-amber);
    text-transform: uppercase;
    font-weight: 700;
  }

  .cmdk__input {
    width: 100%;
    padding: 10px 16px 14px;
    border: 0;
    border-bottom: 1px solid var(--c-rule);
    background: transparent;
    color: var(--c-ink);
    font-family: var(--ff-mono);
    font-size: 15px;
    outline: none;
    border-radius: 0;
  }
  .cmdk__input::placeholder {
    color: var(--c-ink-3);
    font-family: var(--ff-mono);
  }
  .cmdk__input:focus-visible {
    outline: 0;
    border-bottom-color: var(--c-amber);
  }

  .cmdk__list {
    list-style: none;
    margin: 0;
    padding: 6px 0;
    overflow-y: auto;
    flex: 1;
  }
  /* v13.1.4 polish : item chip-tag pattern.
     Each item is a flex row [icon · label · meta · tag-chip], with a
     hairline divider below (except the last item). The tag is a
     bordered chip (1px ink-3, 4px padding, mono 9px uppercase) so it
     reads as a separate UI element instead of being concatenated
     with the label. The active item gets an amber chip border +
     amber label color + a 2px amber left rule. */
  .cmdk__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 16px;
    margin: 0 8px;
    width: calc(100% - 16px);
    color: var(--c-ink-2);
    font-family: var(--ff-sans);
    font-size: 13.5px;
    cursor: pointer;
    border-left: 2px solid transparent;
    border-bottom: 1px solid var(--c-rule-soft);
    border-radius: 2px;
    transition:
      color 100ms ease,
      background 100ms ease,
      border-color 100ms ease;
  }
  .cmdk__item:last-child {
    border-bottom: 0;
  }
  .cmdk__item[aria-selected='true'] {
    background: var(--c-bg-2);
    color: var(--c-amber);
    border-left-color: var(--c-amber);
  }
  .cmdk__item-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    color: var(--c-ink-3);
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
  }
  .cmdk__item[aria-selected='true'] .cmdk__item-icon {
    color: var(--c-amber);
  }
  .cmdk__item-label {
    flex: 1;
    font-weight: 500;
  }
  .cmdk__item-meta {
    font-family: var(--ff-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    color: var(--c-ink-3);
    text-transform: uppercase;
    margin-right: 4px;
  }
  .cmdk__item-tag {
    font-family: var(--ff-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--c-ink-2);
    text-transform: uppercase;
    padding: 2px 6px;
    border: 1px solid var(--c-rule);
    border-radius: 2px;
    background: transparent;
    white-space: nowrap;
    line-height: 1;
  }
  .cmdk__item[aria-selected='true'] .cmdk__item-tag {
    color: var(--c-amber);
    border-color: var(--c-amber);
  }
  .cmdk__item-empty {
    padding: 14px 16px;
    color: var(--c-ink-3);
    font-size: 12px;
    font-style: italic;
  }

  .cmdk__hint {
    margin: 0;
    padding: 8px 16px;
    border-top: 1px solid var(--c-rule);
    font-size: 9.5px;
    color: var(--c-ink-3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cmdk__hint kbd {
    display: inline-block;
    padding: 1px 5px;
    margin-right: 4px;
    border: 1px solid var(--c-rule);
    background: var(--c-bg-2);
    font-family: var(--ff-mono);
    font-size: 9px;
    color: var(--c-ink-2);
    border-radius: 0;
    line-height: 1.2;
  }

  /* v13.1.4 polish-7g : mobile sheet. Below 760px the modal becomes a
     full-screen sheet (width 100vw, height 100dvh) so the touch keyboard
     + result list fit comfortably on phones. The 2px amber top rule stays
     so the institutional register is preserved. Items bump to ≥44px tall
     to clear WCAG 2.5.5 SC 2.5.8 (Target Size Minimum). */
  @media (max-width: 760px) {
    .cmdk {
      padding-top: 0;
      place-items: stretch;
    }
    .cmdk__panel {
      width: 100vw;
      max-width: 100vw;
      height: 100vh;
      height: 100dvh;
      max-height: 100vh;
      max-height: 100dvh;
      border-top: 2px solid var(--c-amber);
    }
    .cmdk__item {
      padding: 14px 16px;
      min-height: 44px;
      font-size: 14px;
    }
    .cmdk__item-icon {
      width: 16px;
      height: 16px;
    }
    .cmdk__hint {
      font-size: 10px;
      padding: 10px 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cmdk__item {
      transition: none;
    }
  }

  /* ============================================================
   * v13.1.W3 (2026-08-10) : "Ask anything" AI mode.
   * Chat thread (question + answer bubbles), typed indicator,
   * status row. Mono answer text. Sharp 0-2px corners, hairline
   * 1px borders, amber accent only — chrome contract held.
   * No halo, no glow, no gradient, no transform on motion.
   * ============================================================ */
  .cmdk__chat {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px 16px;
    overflow-y: auto;
    background: transparent;
  }
  .cmdk__chat[hidden] {
    display: none;
  }
  .cmdk__chat-thread {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cmdk__bubble {
    max-width: 88%;
    padding: 8px 12px;
    border: 1px solid var(--c-rule);
    border-radius: 2px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--c-ink);
    background: var(--c-bg);
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }
  .cmdk__bubble--user {
    align-self: flex-end;
    background: var(--c-bg-2);
    border-color: var(--c-rule);
    font-family: var(--ff-sans);
  }
  .cmdk__bubble--model {
    align-self: flex-start;
    background: var(--c-bg);
    border-color: var(--c-rule);
    font-family: var(--ff-mono);
    font-size: 12.5px;
    line-height: 1.55;
    white-space: pre-wrap;
  }
  .cmdk__bubble--error {
    align-self: stretch;
    max-width: 100%;
    background: var(--c-bg);
    border-left: 3px solid var(--c-amber);
    color: var(--c-ink-2);
    font-family: var(--ff-mono);
    font-size: 12px;
  }
  /* Graceful degradation : amber outline button, sharp 0px, mono. The
     only chrome break from the bubble is the button itself; chrome
     contract v1 holds (1px hairline + amber + mono + no halo/glow).
     Honors prefers-reduced-motion. */
  .cmdk__bubble-retry {
    display: inline-flex;
    align-items: center;
    margin-top: 8px;
    padding: 4px 10px;
    border: 1px solid var(--c-amber);
    border-radius: 0;
    background: transparent;
    color: var(--c-amber);
    font-family: var(--ff-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 100ms ease, color 100ms ease;
  }
  .cmdk__bubble-retry:hover {
    background: var(--c-bg-2);
    color: var(--c-amber);
  }
  .cmdk__bubble-retry:focus-visible {
    outline: 2px solid var(--c-amber);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .cmdk__bubble-retry {
      transition: none;
    }
  }
  /* Typing indicator: 3 dots, opacity-blink only (no transform,
     no scale, no translate). Honors prefers-reduced-motion. */
  .cmdk__typing {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    height: 12px;
  }
  .cmdk__typing span {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--c-ink-3);
    animation: cmdk-blink 900ms ease-in-out infinite;
  }
  .cmdk__typing span:nth-child(2) {
    animation-delay: 200ms;
  }
  .cmdk__typing span:nth-child(3) {
    animation-delay: 400ms;
  }
  @keyframes cmdk-blink {
    0%,
    60%,
    100% {
      opacity: 0.25;
    }
    30% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cmdk__typing span {
      animation: none;
      opacity: 0.6;
    }
  }
  .cmdk__chat-status {
    margin: 0;
    padding: 0 2px;
    color: var(--c-ink-3);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    min-height: 12px;
  }
  /* Hide ask-mode-only hints when the palette opens in search mode. */
  [data-cmdk-mode='search'] [data-cmdk-hint-ask] {
    display: none;
  }
  [data-cmdk-mode='ask'] [data-cmdk-hint-nav],
  [data-cmdk-mode='ask'] [data-cmdk-hint-open] {
    display: none;
  }
  [data-cmdk-mode='ask'] .cmdk__list {
    display: none;
  }
  [data-cmdk-mode='ask'] .cmdk__chat {
    display: flex;
  }

  @media (max-width: 760px) {
    .cmdk__bubble {
      max-width: 100%;
      font-size: 14px;
    }
    .cmdk__bubble--model {
      font-size: 13px;
    }
  }
</style>

<script
  define:vars={{ routesJson, fmTagJson, aiProxyUrl, askTrigger }}
>
  /* v11.W2 : ⌘K command palette script.
     Vanilla TS / JS, no deps. ~3.6KB minified.
     Idempotent: only attaches if data-cmdk exists.

     v13.1.4 polish-7n : ICON_MAP / DEFAULT_ICON / iconFor are inlined
     here. Astro scopes frontmatter and <script> separately — without
     this the runtime would see `iconFor is not defined` and the result
     list would never render (B1 blocker). */
  /* v13.1.4 polish : per-route icon glyphs. 14x14 stroke-only svg, matches
     the SideRail icon vocabulary. Unknown routes fall back to a chevron
     so the column never feels empty. Inlined from frontmatter so the
     <script> block has it at runtime. */
  const ICON_MAP = {
    '/':                '<path d="M3 9 L9 3 L15 9 M5 8 V14 H13 V8"/>',
    '/now/':            '<circle cx="9" cy="9" r="5.5"/><path d="M9 6 V9 L11 11"/>',
    '/for-recruiters/': '<path d="M3 7 H15 M3 11 H15 M5 4 H13 M5 14 H13"/>',
    '/screening-call/': '<path d="M4 5 H14 V13 H4 Z M4 8 H14 M7 5 V13"/>',
    '/proof/':          '<path d="M9 2 L14 5 V11 L9 14 L4 11 V5 Z"/>',
    '/projects/':       '<rect x="3" y="3" width="5" height="5"/><rect x="10" y="3" width="5" height="5"/><rect x="3" y="10" width="5" height="5"/><rect x="10" y="10" width="5" height="5"/>',
    '/work/':           '<path d="M3 4 H15 V12 H3 Z M3 7 H15 M6 4 V12"/>',
    '/converter/':      '<path d="M3 5 H11 M9 3 L11 5 L9 7 M13 11 H5 M7 9 L5 11 L7 13"/>',
    '/experience/':     '<path d="M3 6 L9 2 L15 6 V14 H3 Z M7 14 V9 H11 V14"/>',
    '/skills/':         '<path d="M3 9 L9 3 L15 9 M9 3 V14"/>',
    '/glossary/':       '<path d="M3 4 H10 V14 H3 Z M11 4 H15 V14 H11"/>',
    '/certifications/': '<circle cx="9" cy="9" r="5.5"/><path d="M6 9 L8.5 11.5 L12 7"/>',
    '/positions/':      '<rect x="3" y="4" width="12" height="10" rx="1"/><path d="M6 8 H12 M6 11 H10"/>',
    '/publications/':   '<path d="M4 3 H10 L13 6 V14 H4 Z M10 3 V6 H13"/>',
    '/methodology/':    '<path d="M3 9 H7 M11 9 H15 M3 5 H15 M3 13 H15"/>',
    '/talks/':          '<path d="M3 6 H13 V12 H3 Z M13 8 L16 6 V12 L13 10"/>',
    '/contact/':        '<rect x="3" y="5" width="12" height="9" rx="0.5"/><path d="M3 6 L9 10 L15 6"/>',
  };
  const DEFAULT_ICON = '<path d="M6 4 L12 9 L6 14"/>';
  const iconFor = (href) => ICON_MAP[href] ?? DEFAULT_ICON;

  (() => {
    const ROUTES = JSON.parse(routesJson);
    const FM_TAGS = JSON.parse(fmTagJson);
    const root = document.querySelector('[data-cmdk]');
    const trigger = document.querySelector('[data-cmdk-open]');
    const input = document.querySelector('[data-cmdk-input]');
    const list = document.querySelector('[data-cmdk-list]');
    const closeBtn = document.querySelector('[data-cmdk-close]');
    // v13.1.W3 (2026-08-10) : "Ask anything" AI mode.
    const chat = document.querySelector('[data-cmdk-chat]');
    const thread = document.querySelector('[data-cmdk-thread]');
    const status = document.querySelector('[data-cmdk-status]');
    if (!root || !trigger || !input || !list || !closeBtn) return;
    if (!chat || !thread || !status) {
      // chat DOM is missing — degrade to search-only (no error).
    }

    /* Build the section index from the current page (in-page anchors).
       No-op when the page has zero [data-section-id] elements. */
    const sectionIndex = [];
    document.querySelectorAll('[data-section-id]').forEach((el) => {
      const slug = el.getAttribute('data-section-id');
      if (!slug) return;
      const heading =
        el.querySelector('h1, h2, h3')?.textContent?.trim() ?? slug;
      sectionIndex.push({
        href: '#' + slug,
        label: heading,
        tag: 'SECTION',
        inPage: true,
      });
    });

    const all = [...ROUTES, ...sectionIndex];

    /* === Fuzzy match scoring ===
       - exact substring match (label) → score 100 + bonus for early match
       - token prefix match → score 50
       - char-by-char subsequence match → score per char + early bonus
       - empty query → all routes (max 50 visible)
       - case-insensitive */
    const norm = (s) => s.toLowerCase();
    function score(query, label) {
      if (!query) return 1;
      const q = norm(query);
      const l = norm(label);
      if (l === q) return 200;
      if (l.startsWith(q)) return 120;
      const idx = l.indexOf(q);
      if (idx >= 0) return 100 - idx;
      const tokens = l.split(/[\s/·\-:]+/).filter(Boolean);
      for (const t of tokens) {
        if (t.startsWith(q)) return 60;
      }
      // subsequence (initials / partial)
      let qi = 0;
      let matched = 0;
      for (let i = 0; i < l.length && qi < q.length; i++) {
        if (l[i] === q[qi]) {
          matched++;
          qi++;
        }
      }
      if (qi === q.length) return 20 + matched * 2;
      return 0;
    }

    /* === Render ===
       Up to 12 visible results, sorted by score desc. */
    const MAX = 12;
    let activeIdx = 0;
    let currentResults = [];

    function render(query) {
      const scored = all
        .map((r) => ({ r, s: score(query, r.label) }))
        .filter((x) => x.s > 0)
        .sort((a, b) => b.s - a.s)
        .slice(0, MAX)
        .map((x) => x.r);
      currentResults = scored;
      activeIdx = 0;
      list.innerHTML = '';
      if (scored.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'cmdk__item-empty';
        empty.textContent = 'No matches · try a route name like "stack" or "proof".';
        list.appendChild(empty);
        input.setAttribute('aria-activedescendant', '');
        return;
      }
      scored.forEach((r, i) => {
        const li = document.createElement('li');
        li.className = 'cmdk__item';
        li.setAttribute('role', 'option');
        li.id = 'cmdk-opt-' + i;
        li.dataset.href = r.href;
        li.dataset.inPage = r.inPage ? '1' : '0';
        const icon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        icon.setAttribute('class', 'cmdk__item-icon');
        icon.setAttribute('viewBox', '0 0 18 18');
        icon.setAttribute('aria-hidden', 'true');
        icon.innerHTML = iconFor(r.href);
        const label = document.createElement('span');
        label.className = 'cmdk__item-label';
        label.textContent = r.label;
        const tag = document.createElement('span');
        tag.className = 'cmdk__item-tag';
        tag.textContent = r.tag;
        li.appendChild(icon);
        li.appendChild(label);
        li.appendChild(tag);
        li.addEventListener('click', () => navigate(r));
        li.addEventListener('mousemove', () => setActive(i));
        list.appendChild(li);
      });
      setActive(0);
    }

    function setActive(i) {
      const items = list.querySelectorAll('.cmdk__item');
      if (items.length === 0) {
        input.setAttribute('aria-activedescendant', '');
        return;
      }
      activeIdx = ((i % items.length) + items.length) % items.length;
      items.forEach((el, idx) => {
        if (idx === activeIdx) {
          el.setAttribute('aria-selected', 'true');
          input.setAttribute('aria-activedescendant', el.id);
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.removeAttribute('aria-selected');
        }
      });
    }

    function navigate(r) {
      close();
      // microtask delay so the close transition is observed before navigation
      Promise.resolve().then(() => {
        if (r.inPage && r.href.startsWith('#')) {
          const target = document.querySelector(r.href);
          if (target) {
            target.scrollIntoView({ behavior: 'auto', block: 'start' });
            history.replaceState(null, '', r.href);
            return;
          }
        }
        window.location.href = r.href;
      });
    }

    /* === Open / close ===
       Trap focus inside the input on open, restore on close.
       Reduced-motion: no slide animation; the panel is just there. */
    let lastFocus = null;
    // v13.1.W3 (2026-08-10) : "Ask anything" AI mode. Two states:
    //   - 'search' : default, fuzzy-search routes + sections
    //   - 'ask'    : chat with the edge Worker (SSE stream)
    // Toggle: when the input starts with the ask trigger ("?"),
    // we switch to ask mode and the question text is whatever
    // follows the "?" (the "?" itself is stripped on submit).
    let mode = 'search';
    let askAbort = null; // AbortController for an in-flight stream
    let lastQuestion = ''; // last submitted question (for Retry button)
    function setMode(next) {
      mode = next;
      root.setAttribute('data-cmdk-mode', next);
      // Update placeholder + aria so the input advertises the mode.
      if (next === 'ask') {
        input.setAttribute(
          'placeholder',
          'Ask anything about Christian’s work, methodology, or background…',
        );
        input.setAttribute('aria-label', 'Ask a question');
      } else {
        input.setAttribute('placeholder', 'Ask anything…');
        input.setAttribute('aria-label', 'Search routes and sections');
      }
    }
    setMode('search');
    function open() {
      if (!root.hasAttribute('hidden')) return;
      lastFocus = document.activeElement;
      root.removeAttribute('hidden');
      input.value = '';
      setMode('search');
      if (thread) thread.innerHTML = '';
      if (status) status.textContent = '';
      // Cancel any in-flight ask stream from a previous open.
      if (askAbort) {
        try { askAbort.abort(); } catch (_) {}
        askAbort = null;
      }
      render('');
      // Focus the input synchronously. The L04 audit flags
      // `rAF` near a scroll/key handler as a parallax
      // scroll-listener tell; this is a focus-trap, not a parallax effect.
      input.focus({ preventScroll: true });
    }
    function close() {
      if (root.hasAttribute('hidden')) return;
      root.setAttribute('hidden', '');
      if (askAbort) {
        try { askAbort.abort(); } catch (_) {}
        askAbort = null;
      }
      if (lastFocus && typeof lastFocus.focus === 'function') {
        lastFocus.focus({ preventScroll: true });
      }
    }

    /* === Wire events ===
       - ⌘K / Ctrl+K (capture phase; stopImmediatePropagation wins)
       - Escape closes
       - Arrow up/down navigate
       - Enter activates
       - Open click handlers (.cmdk-trigger + any [data-cmdk-open])
       - Scrim click closes */
    document.addEventListener(
      'keydown',
      (e) => {
        const k = e.key.toLowerCase();
        const isOpen = !root.hasAttribute('hidden');

        if (
          (e.metaKey || e.ctrlKey) &&
          k === 'k' &&
          !e.altKey &&
          !e.shiftKey
        ) {
          e.preventDefault();
          e.stopImmediatePropagation();
          if (isOpen) close();
          else open();
          return;
        }
        /* v13.1.4 polish-7az (2026-08-14): ⌘C / Ctrl+C quick-jump to the
           live converter. Skipped when the converter is already open
           (avoid double-history push) and when the active element is
           a text input / content-editable (don't hijack ⌘C copy). */
        if (
          (e.metaKey || e.ctrlKey) &&
          k === 'c' &&
          !e.altKey &&
          !e.shiftKey
        ) {
          const ae = document.activeElement;
          const isEditable =
            ae instanceof HTMLElement &&
            (ae.tagName === 'INPUT' ||
              ae.tagName === 'TEXTAREA' ||
              ae.tagName === 'SELECT' ||
              ae.isContentEditable);
          if (isEditable) return;
          if (window.location.pathname.replace(/\/$/, '') === '/portfolio/converter') return;
          e.preventDefault();
          e.stopImmediatePropagation();
          window.location.href = basePath('/converter/');
          return;
        }
        if (!isOpen) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          close();
          return;
        }
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          setActive(activeIdx + 1);
          return;
        }
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          setActive(activeIdx - 1);
          return;
        }
        if (e.key === 'Enter') {
          e.preventDefault();
          // v13.1.W3 : Enter submits the question in ask mode;
          // otherwise it activates the highlighted search result.
          if (mode === 'ask') {
            submitAsk();
            return;
          }
          const r = currentResults[activeIdx];
          if (r) navigate(r);
          return;
        }
        if (e.key === 'Tab') {
          // v13.1.W3 : Tab toggles between search and ask modes
          // when the input has text. Without text, it traps focus
          // (the original behavior).
          if (input.value.length > 0) {
            e.preventDefault();
            if (mode === 'search') {
              // Prepend the ask trigger so the mode flip is visible.
              input.value = askTrigger + input.value;
            } else {
              input.value = input.value.replace(/^\?+\s*/, '');
            }
            refreshMode();
            return;
          }
          e.preventDefault();
          input.focus();
        }
      },
      true /* capture phase : must beat other ⌘K listeners */,
    );

    /* === v13.1.W3 (2026-08-10) : ask-mode input handler.
       Detect the "?" trigger prefix and toggle the mode. The
       "?" is NOT stripped from the visible input (so the user
       sees the question framing); we strip it on submit. */
    function refreshMode() {
      const v = input.value;
      if (v.startsWith(askTrigger)) {
        if (mode !== 'ask') setMode('ask');
        if (status && status.textContent === '') {
          status.textContent = 'Ask anything. Enter to send. Esc to clear.';
        }
      } else {
        if (mode !== 'search') {
          setMode('search');
          if (status) status.textContent = '';
        }
        render(v);
      }
    }
    input.addEventListener('input', refreshMode);

    /* === v13.1.W3 : append a chat bubble. Returns the bubble so
       streaming tokens can write into it incrementally. */
    function appendBubble(role, text) {
      if (!thread) return null;
      const li = document.createElement('li');
      li.className = 'cmdk__bubble cmdk__bubble--' + role;
      li.textContent = text;
      thread.appendChild(li);
      // Scroll the chat container to the new bubble.
      if (chat) chat.scrollTop = chat.scrollHeight;
      return li;
    }
    function appendTyping() {
      if (!thread) return null;
      const li = document.createElement('li');
      li.className = 'cmdk__bubble cmdk__bubble--model cmdk__bubble--typing';
      li.innerHTML =
        '<span class="cmdk__typing" aria-label="AI is typing"><span></span><span></span><span></span></span>';
      thread.appendChild(li);
      if (chat) chat.scrollTop = chat.scrollHeight;
      return li;
    }
    function clearTyping(node) {
      if (node && node.parentNode) node.parentNode.removeChild(node);
    }
    function appendError(message) {
      if (!thread) return;
      const li = document.createElement('li');
      li.className = 'cmdk__bubble cmdk__bubble--error';
      li.textContent = message;
      thread.appendChild(li);
      if (chat) chat.scrollTop = chat.scrollHeight;
      return li;
    }
    // Graceful degradation : decorate an existing error bubble with a
    // Retry button that re-invokes askWorker(lastQuestion). Used for
    // recoverable failures (network / DNS / 5xx). Terminal failures
    // (rate-limited, forbidden, cancelled) skip the button.
    function attachRetry(bubble) {
      if (!bubble || !lastQuestion) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'cmdk__bubble-retry';
      btn.textContent = 'Retry';
      btn.setAttribute('aria-label', 'Retry the last question');
      btn.addEventListener('click', () => {
        if (!lastQuestion) return;
        askWorker(lastQuestion);
      });
      bubble.appendChild(btn);
    }
    // Friendly offline message with email fallback. The Worker is the
    // sole source for live answers; if it is down the visitor can still
    // email Christian directly.
    const OFFLINE_MSG =
      'AI is offline right now. Try again in a moment, or email christianmacion26@gmail.com directly.';
    const SERVER_MSG =
      'AI is temporarily unavailable. Retry in a moment, or email christianmacion26@gmail.com.';
    const RATE_MSG =
      'Daily AI limit reached (20 questions per IP). Try again tomorrow, or email christianmacion26@gmail.com.';
    const FORBIDDEN_MSG =
      'This site is not authorized to call the AI proxy. Check the deployment.';
    const CANCEL_MSG = 'Cancelled.';

    /* === v13.1.W3 : stream a question to the edge Worker and
       append tokens to the answer bubble as they arrive.

       Wire protocol (SSE):
         data: {"event":"meta","request_id":"..."}\n\n
         data: {"event":"token","delta":"..."}\n\n
         data: {"event":"done","request_id":"...","latency_ms":N}\n\n
         data: {"event":"error","error":"..."}\n\n

       Failure modes:
         - Worker down / network error → error bubble
         - HTTP 4xx/5xx with envelope → surface the message
         - Mid-stream abort (Esc / re-open) → swallow quietly
         - aiProxyUrl === '' → no-op, ask mode disabled
    */
    async function askWorker(question) {
      if (!aiProxyUrl) {
        appendError(OFFLINE_MSG);
        return;
      }
      lastQuestion = question;
      const bubble = appendBubble('model', '');
      const typing = appendTyping();
      askAbort = new AbortController();
      if (status) status.textContent = 'Streaming…';
      try {
        const resp = await fetch(aiProxyUrl.replace(/\/$/, '') + '/ask', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question }),
          signal: askAbort.signal,
        });
        if (!resp.ok) {
          clearTyping(typing);
          // Categorize by HTTP status so the visitor knows what to do.
          // 429 = rate-limited (terminal, no retry). 403 = forbidden
          // (terminal, no retry; means the origin allowlist rejected the
          // request and a deploy is misconfigured). 5xx / 502 = server
          // (recoverable; retry button). Default = server-class.
          let msg = SERVER_MSG;
          let retryable = true;
          if (resp.status === 429) {
            msg = RATE_MSG;
            retryable = false;
          } else if (resp.status === 403) {
            msg = FORBIDDEN_MSG;
            retryable = false;
          } else {
            try {
              const env = await resp.json();
              if (env && env.error) msg = env.error + ' (HTTP ' + resp.status + ')';
            } catch (_) { /* non-JSON error body */ }
          }
          bubble.textContent = msg;
          bubble.classList.add('cmdk__bubble--error');
          if (retryable) attachRetry(bubble);
          if (status)
            status.textContent = 'Error · HTTP ' + resp.status;
          return;
        }
        if (!resp.body) {
          clearTyping(typing);
          bubble.textContent = SERVER_MSG;
          bubble.classList.add('cmdk__bubble--error');
          attachRetry(bubble);
          return;
        }
        const reader = resp.body.getReader();
        const decoder = new TextDecoder();
        let buf = '';
        let started = false;
        for (;;) {
          const { value, done } = await reader.read();
          if (done) break;
          buf += decoder.decode(value, { stream: true });
          let idx;
          while ((idx = buf.indexOf('\n\n')) >= 0) {
            const evt = buf.slice(0, idx);
            buf = buf.slice(idx + 2);
            const line = evt.split('\n').find((l) => l.startsWith('data: '));
            if (!line) continue;
            const payload = line.slice(6);
            if (payload === '[DONE]') continue;
            let obj;
            try {
              obj = JSON.parse(payload);
            } catch (_) {
              continue;
            }
            if (obj.event === 'token' && typeof obj.delta === 'string') {
              if (!started) {
                clearTyping(typing);
                started = true;
              }
              bubble.textContent += obj.delta;
              if (chat) chat.scrollTop = chat.scrollHeight;
            } else if (obj.event === 'done') {
              if (status) {
                status.textContent =
                  'Done · ' + (obj.latency_ms ?? '?') + ' ms';
              }
            } else if (obj.event === 'error') {
              if (!started) clearTyping(typing);
              bubble.textContent = obj.error || SERVER_MSG;
              bubble.classList.add('cmdk__bubble--error');
              attachRetry(bubble);
              if (status) status.textContent = 'Error';
            }
          }
        }
        if (!started) clearTyping(typing);
        if (!bubble.textContent) {
          bubble.textContent = SERVER_MSG;
          bubble.classList.add('cmdk__bubble--error');
          attachRetry(bubble);
        }
      } catch (err) {
        clearTyping(typing);
        if (err && err.name === 'AbortError') {
          // Mid-stream cancel (Esc, re-open, retry clicked) -> quiet cancel.
          bubble.textContent = CANCEL_MSG;
          if (status) status.textContent = 'Cancelled';
        } else {
          // Network / DNS / offline. The Worker is the only route;
          // surface the email fallback so the visitor has a path.
          bubble.textContent = OFFLINE_MSG;
          bubble.classList.add('cmdk__bubble--error');
          attachRetry(bubble);
          if (status) status.textContent = 'Offline';
        }
      } finally {
        askAbort = null;
      }
    }

    /* === v13.1.W3 : ask-mode submit handler. Strip the "?" trigger
       from the visible value, append the user bubble, then call the
       Worker. Trim to the schema's 500-char cap. */
    function submitAsk() {
      const raw = input.value;
      const question = raw.replace(/^\?+\s*/, '').trim();
      if (!question) {
        if (status) status.textContent = 'Type a question after the "?".';
        return;
      }
      const trimmed =
        question.length > 500 ? question.slice(0, 500) : question;
      appendBubble('user', trimmed);
      if (status) status.textContent = 'Sending…';
      // Clear input but keep ask mode + scroll lock for follow-ups.
      input.value = '';
      askWorker(trimmed);
    }

    closeBtn.addEventListener('click', close);

    /* Open triggers: any [data-cmdk-open] element (pill, hidden trigger,
       future footer link). Delegated so the listener is bound once. */
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const t = target.closest('[data-cmdk-open]');
      if (t) {
        e.preventDefault();
        open();
      }
    });

    /* Listen for the custom event so external callers can dispatch
       `new CustomEvent('cmdk:open')` without exposing a global fn. */
    document.addEventListener('cmdk:open', open);
  })();
</script>
