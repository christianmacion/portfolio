---
/**
 * WorldView.astro : v13.1.4 PHASE 1 GLOBE.
 *
 * Opens on ⌘J / Ctrl+J from any page (capture-phase keydown registered
 * in worldview.client.ts). Modal sibling of CommandPalette.astro, same
 * chrome contract: cream-on-warm-dim, sharp 0-2px corners, hairline 1px
 * border + 2px amber top rule, no halo/glow/gradient, mono + Inter only,
 * WCAG 2.2 AA.
 *
 * v13.1.4 : Phase 1 of the Globe RFC (see specs/2026-08-09-globe-rfc.md)
 * activates the rotating earth + L1/L2/L3 markers in the ⌘J modal,
 * replacing the v12.W4 Live Data Terminal's AIHistoryTimeline payload.
 *
 * Layout (two-pane):
 *   - LEFT  : the rotating globe SVG (360×360 viewBox), pins animate from
 *             GDELT events. Drag-to-rotate + hover-pause + reduced-motion
 *             handled by worldview.client.ts.
 *   - RIGHT : the ticker (L1/L2/L3 market ticks + GDELT events, sorted by
 *             timestamp, top 7 rows) — the data-feed story.
 *   - FOOT  : last-sync stamp + L1/L2/L3 legend + refresh cadence.
 *
 * Esc closes. Click outside the panel closes. The script handles all
 * keyboard + click logic; the trigger button below is the canonical
 * event-bus target so any caller can dispatch the modal without
 * importing the script.
 *
 * d3-geo + topojson-client are dynamic-imported by worldview.client.ts so
 * they only load on ⌘J (~25 KB lazy).
 */
import ChromeMarquee from '@components/ChromeMarquee.astro';

// The chrome marquee carries the live ticker identity : it sits above
// the globe + ticker pair so the terminal reads as a "live system" rather
// than a static brochure.
const tickerText =
  'CHRISTIAN T. MACION · LIVE COVERAGE · L1 / L2 / L3 · ⌘J · ' +
  '12 VENUES · 5 CONTINENTS · UTC+8 HOME BASE · ' +
  'GDELT 15-MIN · MARKET TICKS 30-SEC · DRAG TO ROTATE · HOVER PAUSES · ' +
  'PREFERS-REDUCED-MOTION STOPS ROTATION ·';

// Last-sync stamp is computed server-side at build time so the static
// HTML carries an honest stamp even before the client-side scheduler
// refreshes it. The client scheduler overwrites every 30s.
const buildStamp = new Date().toISOString().slice(11, 19) + 'Z';
---

<button
  type="button"
  class="wv-trigger"
  data-worldview-open
  aria-label="Open Live Data Terminal"
  aria-keyshortcuts="Meta+J Control+J"
  tabindex="-1"
></button>

<div
  class="wv"
  data-worldview
  role="dialog"
  aria-modal="true"
  aria-labelledby="wv-title"
  hidden
>
  <button
    type="button"
    class="wv__scrim"
    data-worldview-close
    aria-label="Close Live Data Terminal"
    tabindex="-1"
  ></button>
  <div class="wv__panel" role="document">
    <a class="wv__skip" href="#wv-ticker-list">Skip to ticker</a>
    <header class="wv__header">
      <p id="wv-title" class="wv__title mono">LIVE COVERAGE · L1 / L2 / L3 · ⌘J</p>
      <button
        type="button"
        class="wv__close"
        data-worldview-close
        aria-label="Close"
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <ChromeMarquee
      text={tickerText}
      speedSec={40}
      trailing="live ticker"
    />

    {/* v13.1.4 Phase 1 : two-pane globe + ticker layout. The SVG is the
         surface that worldview.client.ts populates with the rotating
         earth + L1/L2/L3 markers. The ul[data-worldview-ticker] is the
         data-feed list populated by the Ticker scheduler. The hint
         paragraph below is an aria-live region for screen-reader users. */}
    <section class="wv__globe-wrap" aria-labelledby="wv-globe-label">
      <h2 id="wv-globe-label" class="wv__eyebrow mono">LIVE COVERAGE · L1 / L2 / L3</h2>
      <div class="wv__panes">
        <div class="wv__globe-pane">
          {/* v13.1.4 polish-7 : real NASA Blue Marble satellite texture.
             Stage wraps the canvas (NASA texture, behind) and the SVG
             (country borders + cities + labels + GDELT pins, on top).
             The client renders the projected Earth texture to the
             canvas each frame via d3.geoOrthographic invert, so the
             satellite imagery rotates with the globe. Texture source:
             NASA Earth Observatory "Blue Marble" (Reto Stöckli, NASA
             GSFC) — public domain. */}
          <div class="wv-globe__stage">
            {/* v13.1.4 polish-7p : NASA attribution visible alongside the
               globe. Per NASA Earth Observatory policy, satellite imagery
               must carry visible credit to the source. The line is 9px
               mono, hairline rule, matching the chrome contract. Sits
               inside the globe pane so the credit is never more than a
               glance away from the texture it describes. */}
            <p class="wv__globe-credit mono" aria-label="Earth texture attribution">
              Earth imagery · NASA Earth Observatory · Blue Marble (Reto Stöckli, NASA GSFC) · public domain
            </p>
            <canvas
              data-worldview-canvas
              class="wv-globe__canvas"
              width="360"
              height="360"
              aria-hidden="true"
            ></canvas>
            <svg
              data-worldview-svg
              class="wv-globe"
              viewBox="0 0 360 360"
              preserveAspectRatio="xMidYMid meet"
              role="img"
              aria-label="Live coverage globe. 12 venues across 5 continents (L1 top-of-book, L2 consolidated tape, L3 full depth-of-book). Drag to rotate, hover for venue detail."
            ></svg>
          </div>
          {/* v13.1.4 polish : inline marker-tier legend in the globe pane so
              visitors can read what each ring count means without leaving
              the modal. svg-native, mono, hairline-stroked dots only
              (no halo / no glow per portfolio visual bar). */}
          <ul class="wv__key mono" role="list" aria-label="Marker tier key">
            <li class="wv__key-item">
              <svg class="wv__key-mark" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="3" class="wv__key-fill" />
              </svg>
              <span class="wv__key-label">L1</span>
              <span class="wv__key-desc">top-of-book</span>
            </li>
            <li class="wv__key-item">
              <svg class="wv__key-mark" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="6" class="wv__key-ring" fill="none" stroke-width="0.6" />
                <circle cx="8" cy="8" r="3" class="wv__key-fill" />
              </svg>
              <span class="wv__key-label">L2</span>
              <span class="wv__key-desc">consolidated tape</span>
            </li>
            <li class="wv__key-item">
              <svg class="wv__key-mark" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="7" class="wv__key-ring" fill="none" stroke-width="0.5" />
                <circle cx="8" cy="8" r="4.5" class="wv__key-ring" fill="none" stroke-width="0.6" />
                <circle cx="8" cy="8" r="2" class="wv__key-fill" />
              </svg>
              <span class="wv__key-label">L3</span>
              <span class="wv__key-desc">full depth-of-book</span>
            </li>
          </ul>
          <p class="wv__globe-hint mono" data-worldview-hint aria-live="polite">drag to rotate · hover pauses</p>
        </div>
        <div class="wv__ticker-pane" aria-labelledby="wv-ticker-label">
          <h3 id="wv-ticker-label" class="wv__ticker-label mono">TICKER</h3>
          <ul id="wv-ticker-list" class="wv__ticker" data-worldview-ticker role="list"></ul>
        </div>
      </div>
    </section>

    <footer class="wv__footer mono">
      <span class="wv__legend" data-worldview-status
        >last sync {buildStamp}</span
      >
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend wv__legend--regime" data-worldview-regime data-regime="neutral">NEUTRAL</span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend">L1 · L2 · L3</span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend">refresh 30s</span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend wv__legend--src">
        Clock <span data-worldview-sync-yahoo>{buildStamp}</span>
      </span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend">
        GDELT <span data-worldview-sync-gdelt>{buildStamp}</span>
      </span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend">
        Binance <span data-worldview-sync-binance>{buildStamp}</span>
      </span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend">
        CoinGecko <span data-worldview-sync-coingecko>{buildStamp}</span>
      </span>
    </footer>

    {/* v13.1.4 Phase 1 showcase : provenance strip just above the footer
         so visitors read the data plumbing as ground truth. Yahoo 6 +
         Binance 2 + CoinGecko 1 + ECB FX + GDELT 15m. Mono, hairline, 9px. */}
    <p class="wv__provenance mono" data-worldview-provenance>
      data · Yahoo 6 + Binance 2 + CoinGecko 1 + ECB FX + GDELT 15m · L1 = top-of-book · L2 = consolidated tape · L3 = full depth · 12 venues · 5 continents · UTC+8 home base
    </p>

    {/* Legacy data-attribute targets preserved so the existing
         worldview.client.ts script can still bind (no-op when
         the corresponding selectors are absent). */}
    <span hidden data-worldview-sync-coingecko aria-hidden="true"></span>
    <span hidden data-worldview-sync-binance aria-hidden="true"></span>
  </div>
</div>

<style>
  .wv-trigger {
    display: none;
  }

  .wv {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* v13.1.4 polish-7q : use the canonical --z-modal token (100) instead
       of calc(--z-nav + 10) = 60. The lower value let sticky page chrome
       (SideRail drawer at z-nav+1=51, mobile backdrop at z-nav-1=49) and
       any future z-nav-adjacent surfaces win the stacking order in some
       browsers, which made the modal scrim appear transparent. Bumping
       to --z-modal keeps the modal unambiguously above every named
       surface below it (z-nav, z-nav-more, z-sticky, z-toast) and below
       the skip-link (z=1000, only painted when focused). */
    z-index: var(--z-modal);
    display: grid;
    place-items: start center;
    padding-top: 6vh;
  }
  .wv[hidden] {
    display: none;
  }

  .wv__scrim {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    /* v13.1.4 polish-7q : explicit display:block defeats the UA button
       inline-block default. Without it, the <button> UA box sometimes
       inherits its inline-block sizing model when placed inside a
       display:grid container, which left the scrim at 0×0 in Firefox.
       Also: width/height switched from 100% (relative to the grid track)
       to 100vw / 100vh (relative to the viewport), so the backdrop
       guarantees full viewport coverage regardless of grid auto-track
       behavior. */
    display: block;
    background: rgba(13, 17, 23, 0.85);
    cursor: pointer;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    appearance: none;
  }

  .wv__panel {
    position: relative;
    width: min(880px, 96vw);
    max-height: 88vh;
    background: var(--c-bg);
    color: var(--c-ink);
    border: 1px solid var(--c-rule);
    border-top: 2px solid var(--c-amber);
    border-radius: 0;
    box-shadow: var(--shadow-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    font-family: var(--ff-sans);
  }

  .wv__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px 8px;
    border-bottom: 1px solid var(--c-rule);
  }

  .wv__title {
    margin: 0;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--c-amber);
    text-transform: uppercase;
    font-weight: 700;
  }

  .wv__close {
    background: transparent;
    border: 1px solid var(--c-rule);
    color: var(--c-ink-2);
    /* v13.1.4 polish-7g : WCAG 2.5.5 / 2.5.8 touch target ≥44×44 px
       (was 22×22). The visible glyph (×) is centered via line-height +
       flexbox so the 22px icon sits centered in the 44px box. */
    width: 44px;
    height: 44px;
    line-height: 1;
    font-size: 18px;
    cursor: pointer;
    padding: 0;
    border-radius: 0;
    font-family: var(--ff-mono);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .wv__close:focus-visible {
    border-color: var(--c-amber);
    color: var(--c-amber);
    outline: none;
  }
  /* v13.1.4 polish-7g : hover is decoration only (no state info). Wrap
     in @media (hover: hover) so touch devices don't apply the rule. */
  @media (hover: hover) {
    .wv__close:hover {
      border-color: var(--c-amber);
      color: var(--c-amber);
    }
  }

  .wv__timeline-wrap {
    padding: 14px 16px 8px;
    border-bottom: 1px solid var(--c-rule);
    overflow-y: auto;
    flex: 1;
    min-height: 0;
  }

  /* v13.1.4 Phase 1 : two-pane globe + ticker layout. Globe sits in a
     square pane (GLOBE_SIZE = 360), ticker fills the remaining width.
     On viewports < 720px the panes stack vertically. */
  .wv__globe-wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    border-bottom: 1px solid var(--c-rule);
    overflow: hidden;
  }
  .wv__panes {
    display: grid;
    grid-template-columns: minmax(260px, 380px) 1fr;
    gap: 0;
    flex: 1;
    min-height: 0;
  }
  .wv__globe-pane {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 16px 14px;
    border-right: 1px solid var(--c-rule);
    background: var(--c-bg);
  }
  /* v13.1.4 polish-7 : globe stage. Canvas (NASA Blue Marble texture)
     sits behind, SVG (borders + cities + labels) sits on top. Stage
     preserves a square aspect ratio so the canvas + SVG align
     pixel-perfect. */
  .wv-globe__stage {
    position: relative;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 1 / 1;
    display: block;
  }
  .wv-globe__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 50%;
    /* Initial pre-load background so the canvas is visibly Earth-blue
       before the texture finishes downloading. Matches the ocean color
       so the swap is invisible. */
    background: var(--c-ink-deep, #0a1825);
    /* v13.1.4 polish-7k : prevent the browser from interpreting the
       drag gesture as scroll/zoom on touch devices. Combined with the
       Pointer Events in worldview.client.ts, the globe drag works on
       iOS Safari + Android Chrome touch. user-select: none stops the
       browser from selecting text during the drag. */
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .wv-globe {
    position: relative;
    width: 100%;
    max-width: 360px;
    height: auto;
    aspect-ratio: 1 / 1;
    display: block;
    z-index: 1;
    /* v13.1.4 polish-7k : touch-action: none on the SVG too so the
       drag gesture is captured before the browser decides it's a
       scroll. Both the canvas and the SVG need touch-action: none
       because the SVG is the drag target (Pointer Events bound on
       the SVG), but the canvas is visually behind it. */
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .wv__globe-hint {
    margin: 0;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    text-align: center;
  }
  /* v13.1.4 polish-7p : NASA attribution. 9px mono, hairline rule above,
     uppercase, ink-3 — same register as the footer legend. The credit
     sits inside the globe pane so it's always visible alongside the
     texture it describes. */
  .wv__globe-credit {
    margin: 0;
    padding: 6px 4px 0;
    border-top: 1px solid var(--c-rule-soft);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    text-align: center;
    line-height: 1.4;
  }
  /* Mobile sheet: emphasize the credit so the small type stays readable
     on the 280px globe. Same chrome, just a hair bigger. */
  @media (max-width: 760px) {
    .wv__globe-credit {
      font-size: 9.5px;
      padding: 5px 4px 0;
    }
  }

  /* v13.1.4 polish : skip-link. Hidden by default; only visible when
     keyboard-focused at the top of the modal. Same chrome as the
     SideRail shortcuts kbd tokens (hairline + ink + mono). */
  .wv__skip {
    position: absolute;
    top: 8px;
    left: 12px;
    padding: 4px 8px;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, monospace);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-1, #0a0a0a);
    background: var(--c-bg, #fafafa);
    border: 1px solid var(--c-ink-2, #1f1f1f);
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 120ms ease-out;
    z-index: 2;
  }
  .wv__skip:focus,
  .wv__skip:focus-visible {
    transform: translateY(0);
    outline: 1px solid var(--c-amber, #b45309);
    outline-offset: 2px;
  }

  /* v13.1.4 polish : marker-tier key (L1 / L2 / L3). Inline svg so it
     scales with the modal. Flat amber dots, hairline stroke on the
     rings — no halo, no glow (portfolio visual bar). */
  .wv__key {
    list-style: none;
    margin: 0;
    padding: 6px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-3);
  }
  .wv__key-item {
    display: flex;
    align-items: center;
    gap: 4px;
    justify-content: center;
  }
  .wv__key-mark {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .wv__key-fill {
    fill: var(--c-amber, #b45309);
  }
  .wv__key-ring {
    stroke: var(--c-amber, #b45309);
  }
  .wv__key-label {
    color: var(--c-ink-1, #0a0a0a);
    font-weight: 500;
  }
  .wv__key-desc {
    color: var(--c-ink-3);
    font-size: 8px;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    display: none;
  }
  @media (min-width: 720px) {
    .wv__key-desc {
      display: inline;
    }
  }
  .wv__ticker-pane {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 12px 14px 14px;
    overflow: hidden;
  }
  .wv__ticker-label {
    margin: 0 0 8px;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--c-ink-3);
    text-transform: uppercase;
    font-weight: 500;
  }
  .wv__ticker {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-y: auto;
    min-height: 0;
    flex: 1;
  }
  /* Ticker row classes referenced by worldview.client.ts Ticker.row().
     The row is a 5-column grid : time | source | symbol | signal | badge.
     Headline (price + %) lives in the signal column instead, keeping
     the headline cell as a free-text carry-over for GDELT event titles
     (which can be longer than the symbol cell allows). */
  :global(.wv-ticker__row) {
    display: grid;
    grid-template-columns: 60px 44px 60px 64px auto 28px;
    gap: 8px;
    align-items: center;
    padding: 5px 8px;
    border-bottom: 1px solid var(--c-rule);
    font-size: 11px;
    line-height: 1.35;
    color: var(--c-ink);
  }
  :global(.wv-ticker__time),
  :global(.wv-ticker__src),
  :global(.wv-ticker__region),
  :global(.wv-ticker__signal) {
    font-family: var(--ff-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--c-ink-2);
  }
  :global(.wv-ticker__src) {
    color: var(--c-amber);
  }
  :global(.wv-ticker__head) {
    font-family: var(--ff-sans);
    color: var(--c-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.wv-ticker__signal) {
    color: var(--c-amber);
    font-weight: 600;
  }
  :global(.wv-ticker__badge) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    padding: 1px 6px;
    font-family: var(--ff-mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: var(--c-amber);
    background: transparent;
    border: 1px solid var(--c-amber);
    border-radius: 2px;
  }
  :global(.wv-ticker__badge--l3) {
    color: var(--c-bg);
    background: var(--c-amber);
  }

  /* v13.1.4 polish-7g : ticker row is now a <button> wrapper (was <li>).
     The grid layout lives on .wv-ticker__row (button); .wv-ticker__item
     (<li>) wraps the row + the inline detail panel. The button reset
     strips default <button> chrome so the row reads as a list item, and
     full-width + text-align: left keep the grid columns visually
     unchanged. */
  :global(.wv-ticker__item) {
    display: block;
    border-bottom: 1px solid var(--c-rule);
  }
  :global(.wv-ticker__row) {
    display: grid;
    grid-template-columns: 60px 44px 60px 64px auto 28px;
    gap: 8px;
    align-items: center;
    width: 100%;
    padding: 5px 8px;
    border: 0;
    background: transparent;
    color: var(--c-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    border-radius: 0;
    font-size: 11px;
    line-height: 1.35;
    transition: background 120ms ease;
  }
  /* v13.1.4 polish-7g : hover is decoration only. Wrap in
     @media (hover: hover) so touch devices don't apply the rule. The
     active row is signalled via aria-expanded="true" + .wv-ticker__row--open
     so the state is reachable on touch. */
  @media (hover: hover) {
    :global(.wv-ticker__row:hover) {
      background: var(--c-bg-2);
    }
  }
  :global(.wv-ticker__row:focus-visible) {
    outline: 1px solid var(--c-amber);
    outline-offset: -1px;
  }
  :global(.wv-ticker__row:active) {
    background: var(--c-bg-2);
  }
  :global(.wv-ticker__row--open) {
    background: var(--c-bg-2);
    border-bottom: 0;
  }
