---
/**
 * WorldView.astro : v13.1.4 PHASE 1 GLOBE.
 *
 * Opens on ⌘J / Ctrl+J from any page (capture-phase keydown registered
 * in worldview.client.ts). Modal sibling of CommandPalette.astro, same
 * chrome contract: cream-on-warm-dim, sharp 0-2px corners, hairline 1px
 * border + 2px amber top rule, no halo/glow/gradient, mono + Inter only,
 * WCAG 2.2 AA.
 *
 * v13.1.4 : Phase 1 of the Globe RFC (see specs/2026-08-09-globe-rfc.md)
 * activates the rotating earth + L1/L2/L3 markers in the ⌘J modal,
 * replacing the v12.W4 Live Data Terminal's AIHistoryTimeline payload.
 *
 * Layout (two-pane):
 *   - LEFT  : the rotating globe SVG (360×360 viewBox), pins animate from
 *             GDELT events. Drag-to-rotate + hover-pause + reduced-motion
 *             handled by worldview.client.ts.
 *   - RIGHT : the ticker (L1/L2/L3 market ticks + GDELT events, sorted by
 *             timestamp, top 7 rows) — the data-feed story.
 *   - FOOT  : last-sync stamp + L1/L2/L3 legend + refresh cadence.
 *
 * Esc closes. Click outside the panel closes. The script handles all
 * keyboard + click logic; the trigger button below is the canonical
 * event-bus target so any caller can dispatch the modal without
 * importing the script.
 *
 * d3-geo + topojson-client are dynamic-imported by worldview.client.ts so
 * they only load on ⌘J (~25 KB lazy).
 */
import ChromeMarquee from '@components/ChromeMarquee.astro';

// The chrome marquee carries the live ticker identity : it sits above
// the globe + ticker pair so the terminal reads as a "live system" rather
// than a static brochure.
const tickerText =
  'CHRISTIAN T. MACION · LIVE COVERAGE · L1 / L2 / L3 · ⌘J · ' +
  '12 VENUES · 5 CONTINENTS · UTC+8 HOME BASE · ' +
  'GDELT 15-MIN · MARKET TICKS 30-SEC · DRAG TO ROTATE · HOVER PAUSES · ' +
  'PREFERS-REDUCED-MOTION STOPS ROTATION ·';

// Last-sync stamp is computed server-side at build time so the static
// HTML carries an honest stamp even before the client-side scheduler
// refreshes it. The client scheduler overwrites every 30s.
const buildStamp = new Date().toISOString().slice(11, 19) + 'Z';
---

<button
  type="button"
  class="wv-trigger"
  data-worldview-open
  aria-label="Open Live Data Terminal"
  aria-keyshortcuts="Meta+J Control+J"
  tabindex="-1"
></button>

<div
  class="wv"
  data-worldview
  role="dialog"
  aria-modal="true"
  aria-labelledby="wv-title"
  hidden
>
  <button
    type="button"
    class="wv__scrim"
    data-worldview-close
    aria-label="Close Live Data Terminal"
    tabindex="-1"
  ></button>
  <div class="wv__panel" role="document">
    <a class="wv__skip" href="#wv-ticker-list">Skip to ticker</a>
    <header class="wv__header">
      <p id="wv-title" class="wv__title mono">LIVE COVERAGE · L1 / L2 / L3 · ⌘J</p>
      <button
        type="button"
        class="wv__close"
        data-worldview-close
        aria-label="Close"
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <ChromeMarquee
      text={tickerText}
      speedSec={40}
      trailing="live ticker"
    />

    {/* v13.1.4 Phase 1 : two-pane globe + ticker layout. The SVG is the
         surface that worldview.client.ts populates with the rotating
         earth + L1/L2/L3 markers. The ul[data-worldview-ticker] is the
         data-feed list populated by the Ticker scheduler. The hint
         paragraph below is an aria-live region for screen-reader users. */}
    <section class="wv__globe-wrap" aria-labelledby="wv-globe-label">
      <h2 id="wv-globe-label" class="wv__eyebrow mono">LIVE COVERAGE · L1 / L2 / L3</h2>
      <div class="wv__panes">
        <div class="wv__globe-pane">
          <svg
            data-worldview-svg
            class="wv-globe"
            viewBox="0 0 360 360"
            preserveAspectRatio="xMidYMid meet"
            role="img"
            aria-label="Live coverage globe. 12 venues across 5 continents (L1 top-of-book, L2 consolidated tape, L3 full depth-of-book). Drag to rotate, hover for venue detail."
          ></svg>
          {/* v13.1.4 polish : inline marker-tier legend in the globe pane so
              visitors can read what each ring count means without leaving
              the modal. svg-native, mono, hairline-stroked dots only
              (no halo / no glow per portfolio visual bar). */}
          <ul class="wv__key mono" role="list" aria-label="Marker tier key">
            <li class="wv__key-item">
              <svg class="wv__key-mark" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="3" class="wv__key-fill" />
              </svg>
              <span class="wv__key-label">L1</span>
              <span class="wv__key-desc">top-of-book</span>
            </li>
            <li class="wv__key-item">
              <svg class="wv__key-mark" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="6" class="wv__key-ring" fill="none" stroke-width="0.6" />
                <circle cx="8" cy="8" r="3" class="wv__key-fill" />
              </svg>
              <span class="wv__key-label">L2</span>
              <span class="wv__key-desc">consolidated tape</span>
            </li>
            <li class="wv__key-item">
              <svg class="wv__key-mark" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="7" class="wv__key-ring" fill="none" stroke-width="0.5" />
                <circle cx="8" cy="8" r="4.5" class="wv__key-ring" fill="none" stroke-width="0.6" />
                <circle cx="8" cy="8" r="2" class="wv__key-fill" />
              </svg>
              <span class="wv__key-label">L3</span>
              <span class="wv__key-desc">full depth-of-book</span>
            </li>
          </ul>
          <p class="wv__globe-hint mono" data-worldview-hint aria-live="polite">drag to rotate · hover pauses</p>
        </div>
        <div class="wv__ticker-pane" aria-labelledby="wv-ticker-label">
          <h3 id="wv-ticker-label" class="wv__ticker-label mono">TICKER</h3>
          <ul id="wv-ticker-list" class="wv__ticker" data-worldview-ticker role="list"></ul>
        </div>
      </div>
    </section>

    <footer class="wv__footer mono">
      <span class="wv__legend" data-worldview-status
        >last sync {buildStamp}</span
      >
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend wv__legend--regime" data-worldview-regime data-regime="neutral">NEUTRAL</span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend">L1 · L2 · L3</span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend">refresh 30s</span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend wv__legend--src">
        Clock <span data-worldview-sync-yahoo>{buildStamp}</span>
      </span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend">
        GDELT <span data-worldview-sync-gdelt>{buildStamp}</span>
      </span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend">
        CoinGecko <span data-worldview-sync-coingecko>{buildStamp}</span>
      </span>
    </footer>

    {/* v13.1.4 Phase 1 showcase : provenance strip just above the footer
         so visitors read the data plumbing as ground truth. Yahoo 6 +
         CoinGecko 4 + ECB FX + GDELT 15m. Mono, hairline, 9px. */}
    <p class="wv__provenance mono" data-worldview-provenance>
      data · Yahoo 6 + CoinGecko 4 + ECB FX + GDELT 15m · L1 = top-of-book · L2 = consolidated tape · L3 = full depth · 12 venues · 5 continents · UTC+8 home base
    </p>

    {/* Legacy data-attribute targets preserved so the existing
         worldview.client.ts script can still bind (no-op when
         the corresponding selectors are absent). */}
    <span hidden data-worldview-sync-coingecko aria-hidden="true"></span>
  </div>
</div>

<style>
  .wv-trigger {
    display: none;
  }

  .wv {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-nav) + 10);
    display: grid;
    place-items: start center;
    padding-top: 6vh;
  }
  .wv[hidden] {
    display: none;
  }

  .wv__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(13, 17, 23, 0.85);
    cursor: pointer;
    border: 0;
    padding: 0;
  }

  .wv__panel {
    position: relative;
    width: min(880px, 96vw);
    max-height: 88vh;
    background: var(--c-bg);
    color: var(--c-ink);
    border: 1px solid var(--c-rule);
    border-top: 2px solid var(--c-amber);
    border-radius: 0;
    box-shadow: var(--shadow-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    font-family: var(--ff-sans);
  }

  .wv__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px 8px;
    border-bottom: 1px solid var(--c-rule);
  }

  .wv__title {
    margin: 0;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--c-amber);
    text-transform: uppercase;
    font-weight: 700;
  }

  .wv__close {
    background: transparent;
    border: 1px solid var(--c-rule);
    color: var(--c-ink-2);
    width: 22px;
    height: 22px;
    line-height: 1;
    font-size: 14px;
    cursor: pointer;
    padding: 0;
    border-radius: 0;
    font-family: var(--ff-mono);
  }
  .wv__close:hover,
  .wv__close:focus-visible {
    border-color: var(--c-amber);
    color: var(--c-amber);
    outline: none;
  }

  .wv__timeline-wrap {
    padding: 14px 16px 8px;
    border-bottom: 1px solid var(--c-rule);
    overflow-y: auto;
    flex: 1;
    min-height: 0;
  }

  /* v13.1.4 Phase 1 : two-pane globe + ticker layout. Globe sits in a
     square pane (GLOBE_SIZE = 360), ticker fills the remaining width.
     On viewports < 720px the panes stack vertically. */
  .wv__globe-wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    border-bottom: 1px solid var(--c-rule);
    overflow: hidden;
  }
  .wv__panes {
    display: grid;
    grid-template-columns: minmax(260px, 380px) 1fr;
    gap: 0;
    flex: 1;
    min-height: 0;
  }
  .wv__globe-pane {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 12px 16px 14px;
    border-right: 1px solid var(--c-rule);
    background: var(--c-bg);
  }
  .wv-globe {
    width: 100%;
    max-width: 360px;
    height: auto;
    aspect-ratio: 1 / 1;
    display: block;
  }
  .wv__globe-hint {
    margin: 0;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    text-align: center;
  }

  /* v13.1.4 polish : skip-link. Hidden by default; only visible when
     keyboard-focused at the top of the modal. Same chrome as the
     SideRail shortcuts kbd tokens (hairline + ink + mono). */
  .wv__skip {
    position: absolute;
    top: 8px;
    left: 12px;
    padding: 4px 8px;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, monospace);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-1, #0a0a0a);
    background: var(--c-bg, #fafafa);
    border: 1px solid var(--c-ink-2, #1f1f1f);
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 120ms ease-out;
    z-index: 2;
  }
  .wv__skip:focus,
  .wv__skip:focus-visible {
    transform: translateY(0);
    outline: 1px solid var(--c-amber, #b45309);
    outline-offset: 2px;
  }

  /* v13.1.4 polish : marker-tier key (L1 / L2 / L3). Inline svg so it
     scales with the modal. Flat amber dots, hairline stroke on the
     rings — no halo, no glow (portfolio visual bar). */
  .wv__key {
    list-style: none;
    margin: 0;
    padding: 6px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-3);
  }
  .wv__key-item {
    display: flex;
    align-items: center;
    gap: 4px;
    justify-content: center;
  }
  .wv__key-mark {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }
  .wv__key-fill {
    fill: var(--c-amber, #b45309);
  }
  .wv__key-ring {
    stroke: var(--c-amber, #b45309);
  }
  .wv__key-label {
    color: var(--c-ink-1, #0a0a0a);
    font-weight: 500;
  }
  .wv__key-desc {
    color: var(--c-ink-3);
    font-size: 8px;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    display: none;
  }
  @media (min-width: 720px) {
    .wv__key-desc {
      display: inline;
    }
  }
  .wv__ticker-pane {
    display: flex;
    flex-direction: column;
    min-height: 0;
    padding: 12px 14px 14px;
    overflow: hidden;
  }
  .wv__ticker-label {
    margin: 0 0 8px;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--c-ink-3);
    text-transform: uppercase;
    font-weight: 500;
  }
  .wv__ticker {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-y: auto;
    min-height: 0;
    flex: 1;
  }
  /* Ticker row classes referenced by worldview.client.ts Ticker.row().
     The row is a 5-column grid : time | source | symbol | signal | badge.
     Headline (price + %) lives in the signal column instead, keeping
     the headline cell as a free-text carry-over for GDELT event titles
     (which can be longer than the symbol cell allows). */
  :global(.wv-ticker__row) {
    display: grid;
    grid-template-columns: 60px 44px 60px 64px auto 28px;
    gap: 8px;
    align-items: center;
    padding: 5px 8px;
    border-bottom: 1px solid var(--c-rule);
    font-size: 11px;
    line-height: 1.35;
    color: var(--c-ink);
  }
  :global(.wv-ticker__time),
  :global(.wv-ticker__src),
  :global(.wv-ticker__region),
  :global(.wv-ticker__signal) {
    font-family: var(--ff-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: var(--c-ink-2);
  }
  :global(.wv-ticker__src) {
    color: var(--c-amber);
  }
  :global(.wv-ticker__head) {
    font-family: var(--ff-sans);
    color: var(--c-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.wv-ticker__signal) {
    color: var(--c-amber);
    font-weight: 600;
  }
  :global(.wv-ticker__badge) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    padding: 1px 6px;
    font-family: var(--ff-mono);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    color: var(--c-amber);
    background: transparent;
    border: 1px solid var(--c-amber);
    border-radius: 2px;
  }
  :global(.wv-ticker__badge--l3) {
    color: var(--c-bg);
    background: var(--c-amber);
  }

  /* Provenance strip sits just above the footer, full-width, hairline
     rule on top, 9px mono to mirror the chrome contract. No hover, no
     interaction — pure provenance. */
  .wv__provenance {
    margin: 0;
    padding: 7px 16px 8px;
    border-top: 1px solid var(--c-rule);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    background: var(--c-bg-2);
  }
  /* Regime chip styling per data-regime attribute. RISK-ON reads in
     amber (positive conviction), RISK-OFF in deeper amber-decor, NEUTRAL
     in ink-3. No animation, no pulse — chrome contract is still. */
  .wv__legend--regime {
    display: inline-flex;
    align-items: center;
    padding: 1px 6px;
    border: 1px solid var(--c-rule);
    border-radius: 2px;
    font-family: var(--ff-mono);
    letter-spacing: 0.08em;
    color: var(--c-ink-2);
  }
  .wv__legend--regime[data-regime='on'] {
    color: var(--c-amber);
    border-color: var(--c-amber);
  }
  .wv__legend--regime[data-regime='off'] {
    color: var(--c-amber-decor);
    border-color: var(--c-amber-decor);
  }

  .wv__eyebrow {
    margin: 0 0 8px;
    padding: 8px 16px 0;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--c-ink-3);
    text-transform: uppercase;
    font-weight: 500;
  }

  .wv__footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 16px;
    border-top: 1px solid var(--c-rule);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-3);
  }
  .wv__legend {
    color: var(--c-amber);
  }
  .wv__legend--src {
    color: var(--c-ink-2);
  }
  .wv__legend--src > span {
    color: var(--c-amber);
    font-family: var(--ff-mono);
    letter-spacing: 0.04em;
  }
  .wv__sep {
    color: var(--c-ink-3);
    opacity: 0.6;
  }

  @media (max-width: 720px) {
    .wv {
      padding-top: 3vh;
    }
    .wv__panel {
      width: 98vw;
      max-height: 94vh;
    }
    .wv__panes {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }
    .wv__globe-pane {
      border-right: 0;
      border-bottom: 1px solid var(--c-rule);
    }
    .wv-globe {
      max-width: 240px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wv__close {
      transition: none;
    }
  }
</style>
