---
/**
 * WorldView.astro : v12.W4 LIVE DATA TERMINAL.
 *
 * Opens on ⌘J / Ctrl+J from any page (capture-phase keydown registered
 * in worldview.client.ts). Modal sibling of CommandPalette.astro, same
 * chrome contract: cream-on-warm-dim, sharp 0-2px corners, hairline 1px
 * border + 2px amber top rule, no halo/glow/gradient, mono + Inter only,
 * WCAG 2.2 AA.
 *
 * v12.W4 : replaced globe + GDELT ticker with the LIVE DATA TERMINAL :
 *   1. AIHistoryTimeline (compact 3-col variant) : the trend-tracking
 *      flagship visual, anchored as the central artifact.
 *   2. ChromeMarquee : the live identity ticker (auto-rotates 40s).
 *   3. Status footer : last-sync HH:MM:SSZ stamp + data-depth legend.
 *
 * Esc closes. Click outside the panel closes. The script handles all
 * keyboard + click logic; the trigger button below is the canonical
 * event-bus target so any caller can dispatch the modal without
 * importing the script.
 */
import AIHistoryTimeline from '@components/AIHistoryTimeline.astro';
import ChromeMarquee from '@components/ChromeMarquee.astro';

// The chrome marquee carries the live ticker identity : each stage of
// the AI arc gets a slot in the strip so the terminal reads as a
// "live system" rather than a static brochure.
const tickerText =
  'CHRISTIAN T. MACION · LIVE DATA TERMINAL · ⌘J · ' +
  'PROMPTS NOV 2022 · SKILLS JUL 2023 · AGENTS DEC 2023 · ' +
  'HARNESS APR 2024 · LOOPS SEP 2024 · GRAPHS MAR 2025 · ' +
  'OFFICES Q4 2025 · 11 MONTHS AHEAD · 7 STAGES · 112 AGENTS NOW · ' +
  '2022 TO 2025 ·';

// Last-sync stamp is computed server-side at build time so the static
// HTML carries an honest stamp even before the client-side scheduler
// refreshes it. The client scheduler overwrites every 30s.
const buildStamp = new Date().toISOString().slice(11, 19) + 'Z';
---

<button
  type="button"
  class="wv-trigger"
  data-worldview-open
  aria-label="Open Live Data Terminal"
  aria-keyshortcuts="Meta+J Control+J"
  tabindex="-1"
></button>

<div
  class="wv"
  data-worldview
  role="dialog"
  aria-modal="true"
  aria-labelledby="wv-title"
  hidden
>
  <button
    type="button"
    class="wv__scrim"
    data-worldview-close
    aria-label="Close Live Data Terminal"
    tabindex="-1"
  ></button>
  <div class="wv__panel" role="document">
    <header class="wv__header">
      <p id="wv-title" class="wv__title mono">LIVE DATA TERMINAL · ⌘J</p>
      <button
        type="button"
        class="wv__close"
        data-worldview-close
        aria-label="Close"
      >
        <span aria-hidden="true">×</span>
      </button>
    </header>

    <ChromeMarquee
      text={tickerText}
      speedSec={40}
      trailing="live ticker"
    />

    <section class="wv__timeline-wrap" aria-labelledby="wv-timeline-label">
      <h2 id="wv-timeline-label" class="wv__eyebrow mono">AI HISTORY · 6 STAGES</h2>
      <AIHistoryTimeline
        variant="compact"
        chip="AI · HISTORY · 2022 TO 2025"
        title="Always up to trend. Two months ahead."
        lede=""
      />
    </section>

    <footer class="wv__footer mono">
      <span class="wv__legend" data-worldview-status
        >last sync {buildStamp}</span
      >
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend">L1 · L2 · L3</span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend">refresh 30s</span>
      <span class="wv__sep" aria-hidden="true">·</span>
      <span class="wv__legend wv__legend--src">
        Clock <span data-worldview-sync-yahoo>{buildStamp}</span>
      </span>
    </footer>

    {/* Legacy data-attribute targets preserved so the existing
         worldview.client.ts script can still bind (no-op when
         the corresponding selectors are absent). */}
    <span hidden data-worldview-svg aria-hidden="true"></span>
    <ul hidden data-worldview-ticker aria-hidden="true"></ul>
    <p hidden data-worldview-hint aria-hidden="true">live</p>
    <span hidden data-worldview-sync-gdelt aria-hidden="true"></span>
    <span hidden data-worldview-sync-coingecko aria-hidden="true"></span>
  </div>
</div>

<style>
  .wv-trigger {
    display: none;
  }

  .wv {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-nav) + 10);
    display: grid;
    place-items: start center;
    padding-top: 6vh;
  }
  .wv[hidden] {
    display: none;
  }

  .wv__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(13, 17, 23, 0.85);
    cursor: pointer;
    border: 0;
    padding: 0;
  }

  .wv__panel {
    position: relative;
    width: min(880px, 96vw);
    max-height: 88vh;
    background: var(--c-bg);
    color: var(--c-ink);
    border: 1px solid var(--c-rule);
    border-top: 2px solid var(--c-amber);
    border-radius: 0;
    box-shadow: var(--shadow-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    font-family: var(--ff-sans);
  }

  .wv__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px 8px;
    border-bottom: 1px solid var(--c-rule);
  }

  .wv__title {
    margin: 0;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    color: var(--c-amber);
    text-transform: uppercase;
    font-weight: 700;
  }

  .wv__close {
    background: transparent;
    border: 1px solid var(--c-rule);
    color: var(--c-ink-2);
    width: 22px;
    height: 22px;
    line-height: 1;
    font-size: 14px;
    cursor: pointer;
    padding: 0;
    border-radius: 0;
    font-family: var(--ff-mono);
  }
  .wv__close:hover,
  .wv__close:focus-visible {
    border-color: var(--c-amber);
    color: var(--c-amber);
    outline: none;
  }

  .wv__timeline-wrap {
    padding: 14px 16px 8px;
    border-bottom: 1px solid var(--c-rule);
    overflow-y: auto;
    flex: 1;
    min-height: 0;
  }

  .wv__eyebrow {
    margin: 0 0 8px;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    color: var(--c-ink-3);
    text-transform: uppercase;
    font-weight: 500;
  }

  .wv__footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 16px;
    border-top: 1px solid var(--c-rule);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-3);
  }
  .wv__legend {
    color: var(--c-amber);
  }
  .wv__legend--src {
    color: var(--c-ink-2);
  }
  .wv__legend--src > span {
    color: var(--c-amber);
    font-family: var(--ff-mono);
    letter-spacing: 0.04em;
  }
  .wv__sep {
    color: var(--c-ink-3);
    opacity: 0.6;
  }

  @media (max-width: 720px) {
    .wv {
      padding-top: 3vh;
    }
    .wv__panel {
      width: 98vw;
      max-height: 94vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wv__close {
      transition: none;
    }
  }
</style>
