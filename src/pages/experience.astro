---
/**
 * experience.astro : v2: timeline + math/quant aesthetic.
 *
 * Hero equation: where proof / work / time = per-engagement contribution density.
 * Stats panel: total engagements, total months, total proofs declared.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import TimelineEntry from '@components/TimelineEntry.astro';
import Stat from '@components/Stat.astro';
import Equation from '@components/Equation.astro';
import ReadMeta from '@components/ReadMeta.astro';
import ChromeHeader from '@components/ChromeHeader.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { path } from '@utils/url';
import { buildStampUtc8 } from '@utils/build-stamp';
import VoiceLine from '@components/VoiceLine.astro';

const allEntries: CollectionEntry<'experience'>[] = await getCollection('experience');
const entries = allEntries.sort((a, b) => a.data.order - b.data.order);

// Pre-render each entry's content
const rendered = await Promise.all(
  entries.map(async (e) => {
    const { Content } = await render(e);
    return { entry: e, Content };
  }),
);

// Aggregate metrics across all experiences (NDA-safe : only counts and labels)
const totalContributions = rendered.reduce(
  (sum, { entry }) => sum + (entry.data.contributions?.length ?? 0),
  0,
);
const totalProofs = rendered.reduce((sum, { entry }) => sum + (entry.data.proofs?.length ?? 0), 0);
const totalEntries = rendered.length;

// v6.11.18.2 : wordCount derived from rendered entry bodies (was
// hardcoded minutes={8} on the ReadMeta call). Sum across all entries
// of `body.split(/\s+/).length` then round up : the union of evidence
// paragraphs, not a chrome lie.
const wordCount = rendered.reduce((sum, { entry }) => {
  const body = typeof entry.body === 'string' ? entry.body : '';
  return sum + (body.trim().length ? body.trim().split(/\s+/).length : 0);
}, 0);

// v6.11.19 : totalMonths derived from frontmatter (was hardcoded 25 with
// a stale comment "2024-12 → 2026-05 = ~25 months" : that span is
// actually 17 months, not 25). Union of months across all entries is
// the honest unique-months span of the experience column. `today`
// comes from buildStampUtc8() (BUILD_DATE env var) per Standing
// Order §9 : no argless `new Date()` in deterministic outputs.
function parseExpDate(s: string): Date {
  const today = new Date(buildStampUtc8() + 'T00:00:00Z');
  if (s === 'present') return today;
  const [y, m] = s.split('-').map(Number);
  return new Date(Date.UTC(y, (m ?? 1) - 1, 1));
}
const monthKeys = new Set<string>();
for (const { entry } of rendered) {
  const start = parseExpDate(entry.data.startDate);
  const end = parseExpDate(entry.data.endDate ?? 'present');
  const cursor = new Date(start);
  while (cursor <= end) {
    monthKeys.add(
      `${cursor.getUTCFullYear()}-${String(cursor.getUTCMonth() + 1).padStart(2, '0')}`,
    );
    cursor.setUTCMonth(cursor.getUTCMonth() + 1);
  }
}
const totalMonths = monthKeys.size;
// Earliest + latest months across all rendered entries : shown in the
// chrome as the experience window so the date stamps reflect real data.
const sortedMonths = [...monthKeys].sort();
const expWindowEarliest = sortedMonths[0] ?? '';
const expWindowLatest = sortedMonths[sortedMonths.length - 1] ?? '';
const expWindow = `${expWindowEarliest} → ${expWindowLatest}`;

// v13.1.4 (2026-08-11, experience-uplift) : per-entry metadata strip.
// Mirrors work-live__meta on /work/ (polish-7p, commit 9eba08f).
// Indexed by entry order so the map() below passes the right one to
// each TimelineEntry. Commit hashes are real (from `git log -1 -- <file>`)
// and pin the most-recent substantive touch per entry. Paths point to
// the related public surface on the site. NO new frontmatter fields;
// copy-edit-only scope per the /comp/, /papers/, /404+500 reverts.
const repoBase = 'https://github.com/christianmacion/christianmacion.github.io/commit';
const entryMeta: Record<number, string> = {
  1: `SHIPPED · 2026-03 to 2026-06 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/methodology')}">/methodology/</a>`,
  2: `SHIPPED · 2025-01 to 2026-05 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/publications')}">/publications/</a>`,
  3: `SHIPPED · 2024-12 to 2025-12 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/projects/slop-scanner')}">/projects/slop-scanner/</a>`,
  4: `SHIPPED · 2026-04 to 2026-06 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/proof')}">/proof/</a>`,
  5: `SHIPPED · 2025-10 to 2026-04 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/proof')}">/proof/</a>`,
  6: `SHIPPED · 2025-01 to 2026-05 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/projects')}">/projects/</a>`,
  7: `IN FLIGHT · 2024-12 to present · <a href="${repoBase}/08456c0" target="_blank" rel="noopener noreferrer">commit 08456c0</a> · <a href="${path('/publications')}">/publications/</a>`,
  8: `SHIPPED · 2024-09 to 2024-09 · <a href="${repoBase}/884b3d2" target="_blank" rel="noopener noreferrer">commit 884b3d2</a> · <a href="${path('/proof')}">/proof/</a>`,
};
---

<BaseLayout
  title="Experience"
  description="Operator and researcher experience across multi-agent AI platforms, venture incubation, content automation, and systematic trading research."
  breadcrumbs={[
    { name: 'Home', href: path('/') },
    { name: 'Experience', href: path('/experience') },
  ]}
>
  <header class="page-head">
    <div class="container">
      {/* Bryllim pattern : number-prefixed section header before page H1. */}
      <p class="bryllim-mark mono" aria-hidden="true">01. experience</p>
      <ChromeHeader
        chip="EXPERIENCE · ENGAGEMENTS + PROOFS"
        eyebrow={`${entries.length} ENGAGEMENTS · NDA-SAFE · ${totalMonths}-MONTH ARC`}
        tenant="CHRISTIAN.T.MACION · UTC+8 · NDA-CLEAN · PROOF-PER-ROW"
        noSep
        hideTenet
      />
      <h1 class="page-head__title" data-words>
        Where the work happened, and how to <span class="hl">verify</span> it.
      </h1>
      <VoiceLine class="page-head__voice">
        Each engagement ships with proof. If the proof isn't public, the entry isn't here.
      </VoiceLine>
      <p class="page-head__sub">
        {entries.length} engagements. Each entry lists the contributions made and points to public artifacts
        that prove them. The systematic-strategy desk role is a <strong>closed past contract</strong
        >
        (03/2026 to 06/2026); all references are NDA-safe and free of proprietary data sources.
      </p>

      <p class="mono nda-line">
        NDA-safe by construction. Every entry is built from public repos, public talks, and
        public-data backtests. No proprietary data sources, strategy internals, or desk PnL appear
        anywhere on this site. Missing proof? email me and I'll send it within 24h if it's public.
      </p>

      <div class="head-eq">
        <Equation
          block
          latex={`\\text{contribution\\_density} = \\frac{\\sum_{e \\in E} \\text{proofs}(e)}{\\text{months}(\\Delta E)}`}
          size="md"
        />
      </div>

      <div class="head-stats">
        <Stat value={String(totalEntries)} label="engagements" sub="multi-hat" formula="|E|" />
        <Stat
          value={String(totalContributions)}
          label="contributions"
          sub="declared"
          formula="\sum c_e"
          trend="up"
        />
        <Stat
          value={String(totalProofs)}
          label="proof pointers"
          sub="public artifacts"
          formula="\sum p_e"
          trend="up"
        />
        <Stat value={`${totalMonths}`} label="months" sub={expWindow} formula="\Delta t" />
      </div>
    </div>
  </header>

  <div class="container container-narrow">
    <ReadMeta wordCount={wordCount} href={path('/proof')} />
  </div>

  <section class="section">
    <div class="container container-narrow">
      <div class="timeline">
        {
          rendered.map(({ entry, Content }) => (
            <TimelineEntry
              title={entry.data.title}
              company={entry.data.company}
              location={entry.data.location}
              startDate={entry.data.startDate}
              endDate={entry.data.endDate}
              isCurrent={entry.data.isCurrent}
              summary={entry.data.summary}
              contributions={entry.data.contributions}
              proofs={entry.data.proofs}
              meta={entryMeta[entry.data.order]}
            >
              <Content />
            </TimelineEntry>
          ))
        }
      </div>
      {/* Bryllim overflow : section list ends with right-aligned "ALL X →". */}
      <p class="timeline__overflow">
        <a href={path('/proof')} class="bryllim-overflow mono">ALL {totalProofs} PROOFS →</a>
      </p>

      {/* v13.1.4 (2026-08-11, experience-uplift) : recency stamp.
          Mirrors work-stamp on /work/ (polish-7p). Anchored to the
          most-recent substantive commit that touched the experience
          content (9003283, v12.W4 Bryllim parity). Build green,
          104 pages expected. */}
      <p class="experience-stamp mono">
        Last updated: 2026-08-14 · <a
          href="https://github.com/christianmacion/christianmacion.github.io/commit/9003283"
          target="_blank"
          rel="noopener noreferrer">commit 9003283</a
        > · {entries.length} engagements · NDA-clean · proof-per-row
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--sp-9) var(--sp-7);
    background: var(--c-paper);
    border-bottom: var(--border);
  }
  .page-head__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    flex-wrap: wrap;
  }
  .page-head__eyebrow-chip {
    display: inline-block;
    padding: 4px 10px;
    /* v9.2 a11y : was --c-phi-teal. Dark theme --j-phi-teal = #2d5f5a
     only hits 2.14:1 on dark page-head surface. Solid amber chip +
     --c-bg text reads at ≥5.6:1 in both themes : institutional
     register, F14-safe (no traffic-light). */
    color: var(--c-bg);
    border: 1px solid var(--c-amber);
    background: var(--c-amber);
    font-weight: 600;
  }
  .page-head__eyebrow-line {
    color: var(--c-warn);
    font-weight: 600;
  }
  .page-head__tenant {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-4) 0 0;
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    font-size: 0.78rem;
    color: var(--c-ink-2);
    letter-spacing: 0.06em;
  }
  .page-head__tenant span:nth-child(odd) {
    color: var(--c-warn);
    font-weight: 600;
  }
  .page-head__title {
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-3);
  }
  .page-head__voice {
    margin: 0 0 var(--sp-5);
    max-width: 60ch;
  }
  .page-head__sub {
    font-size: var(--fs-lg);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    max-width: 64ch;
    margin-bottom: var(--sp-6);
  }
  .page-head__sub strong {
    color: var(--c-ink);
    font-weight: 600;
  }
  .head-eq {
    padding: var(--sp-4) var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    margin-bottom: var(--sp-5);
    overflow-x: auto;
  }
  .head-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-3);
  }
  .timeline {
    padding-block: var(--sp-5);
  }

  @media (max-width: 880px) {
    .head-stats {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* === NDA-safe disclosure (v12.W4 : now a single mono line, not a callout) === */
  .nda-line {
    margin-top: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule-soft);
    border-left: 3px solid var(--c-amber);
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
  }

  /* Bryllim pattern : number-prefixed section register. */
  .bryllim-mark {
    font-size: 11px;
    color: var(--c-ink);
    letter-spacing: 0.04em;
    margin: 0 0 6px;
    text-transform: lowercase;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* Bryllim overflow : "ALL X →" link. */
  .bryllim-overflow {
    display: inline-block;
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--c-amber);
    padding-bottom: 1px;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .bryllim-overflow:hover {
    color: var(--c-ink);
    border-bottom-color: var(--c-ink);
  }
  .timeline__overflow {
    text-align: right;
    margin: var(--sp-5) 0 0;
  }

  /* v13.1.4 (2026-08-11, experience-uplift) : recency stamp at the
     bottom of the timeline. Same chrome as work-stamp on /work/.
     Mono + amber links + hairline above. */
  .experience-stamp {
    margin-top: var(--sp-5);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--c-rule-soft);
    font-size: var(--fs-xs);
    color: var(--c-ink-2);
    letter-spacing: 0.04em;
  }
  .experience-stamp a {
    color: var(--c-amber);
    text-decoration: none;
    border-bottom: 1px solid var(--c-amber);
  }
  .experience-stamp a:hover {
    color: var(--c-ink);
    border-bottom-color: var(--c-ink);
  }
</style>
