---
/**
 * glossary.astro : v6.0 · canonical term list (quant + AI).
 *
 * Alphabetical, 2-column on desktop, 1-column on mobile.
 * Each term has a stable anchor id so other pages can deep-link.
 * Definitions are short and written for the HR/recruiter reader
 * who doesn't yet know the field. Full long-form definitions live
 * on /glossary/[id] via src/pages/glossary/[slug].astro.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import ChromeHeader from '@components/ChromeHeader.astro';
import { path } from '@utils/url';
import { terms } from '../data/glossary-terms';
import VoiceLine from '@components/VoiceLine.astro';
import SectionMark from '@components/SectionMark.astro';
import { profile } from '@utils/profile';

const GATE_RANGE = `G1 to G${profile.stats.evalGates}`;

// Group by category for layout
const quantTerms = terms
  .filter((t) => t.category === 'Quant')
  .sort((a, b) => a.term.localeCompare(b.term));
const aiTerms = terms
  .filter((t) => t.category === 'AI')
  .sort((a, b) => a.term.localeCompare(b.term));

// The five most recently added terms. The file was first authored in
// v6.1.1 (commit 1d685d7) and last touched in v12.W4 (9003283); git
// cannot tell us per-term timestamps, so the array order is the
// source of truth for "recent" — the last five entries are the most
// recently added. Dedupe key = `id` (stable across rebuilds).
const recentTerms = terms.slice(-5);
---

<BaseLayout
  title="Glossary · Quant & AI terms"
  description="A short, alphabetised glossary of the quant and AI terms used across this site. Written for hiring managers and recruiters who don't yet know the field."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Glossary', href: '/glossary' },
  ]}
>
  <section class="hero">
    <div class="container container--narrow">
      <ChromeHeader
        chip="GLOSSARY · QUANT & AI · FOR NON-SPECIALISTS"
        eyebrow={`${terms.length} TERMS · 30-SECOND READS · DEEP-LINKABLE`}
        tenant={`CHRISTIAN.T.MACION · UTC+8 · ${terms.length} TERMS · DEEP-LINKABLE`}
        noSep
        hideTenet
      />
      <h1 class="hero__title" data-words>A short dictionary of the terms on this site.</h1>
      <VoiceLine class="hero__voice">
        Twenty-five terms, each short enough to read in thirty seconds, each deep-linkable from
        /methodology.
      </VoiceLine>
      <p class="hero__sub">
        Twenty-five canonical definitions. Each one is short enough to read in thirty seconds and
        stable enough to deep-link to from the methodology, proof, or solutions pages.
      </p>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="recent-heading">
    <div class="container container--narrow">
      <header class="section__head">
        <SectionMark index="01" title="recent" />
        <h2 class="section__title" id="recent-heading">Recently updated terms</h2>
        <p class="section__sub">
          The five most recently added definitions. Each one is short enough to read in thirty
          seconds and stable enough to deep-link to from /methodology or /proof.
        </p>
      </header>
      <ul class="recent-list">
        {
          recentTerms.map((t) => (
            <li class="recent-item">
              <a href={path(`/glossary/${t.id}`)} class="recent-link">
                <span class="recent-term">{t.term}</span>
                <span class="recent-short">{t.short}</span>
                <span class="recent-cat" aria-hidden="true">
                  {t.category}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="browse-heading">
    <div class="container container--narrow">
      <header class="section__head">
        <SectionMark index="02" title="browse" />
        <h2 class="section__title" id="browse-heading">Browse by category</h2>
        <p class="section__sub">
          Two vocabularies, one canonical list. Each card is a fast lane to a category of terms;
          the examples below are the three most-referenced terms in that lane.
        </p>
      </header>
      <div class="preview-grid">
        <a
          href="#quant"
          class="preview-card"
          aria-labelledby="preview-quant-title"
          aria-describedby="preview-quant-sub"
        >
          <span class="preview-card__count">{quantTerms.length} terms</span>
          <h3 class="preview-card__title" id="preview-quant-title">Quant</h3>
          <p class="preview-card__sub" id="preview-quant-sub">
            Statistical-evaluation vocabulary. The terms behind the {GATE_RANGE} validation stack
            on /methodology.
          </p>
          <ul class="preview-card__examples" aria-label="Example Quant terms">
            <li class="preview-card__example">alpha</li>
            <li class="preview-card__example">sharpe</li>
            <li class="preview-card__example">walk-forward</li>
          </ul>
          <span class="preview-card__cta" aria-hidden="true">Jump to Quant terms →</span>
        </a>
        <a
          href="#ai"
          class="preview-card"
          aria-labelledby="preview-ai-title"
          aria-describedby="preview-ai-sub"
        >
          <span class="preview-card__count">{aiTerms.length} terms</span>
          <h3 class="preview-card__title" id="preview-ai-title">AI</h3>
          <p class="preview-card__sub" id="preview-ai-sub">
            Multi-agent, retrieval, and evaluation vocabulary used across the AI lane of this site.
          </p>
          <ul class="preview-card__examples" aria-label="Example AI terms">
            <li class="preview-card__example">agent-charter</li>
            <li class="preview-card__example">eval-harness</li>
            <li class="preview-card__example">frozen-spec</li>
          </ul>
          <span class="preview-card__cta" aria-hidden="true">Jump to AI terms →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <nav class="jump-nav" aria-label="Jump to category">
        <a href="#quant" class="jump-nav__link">
          Quant · {quantTerms.length} terms
        </a>
        <span class="jump-nav__sep" aria-hidden="true">·</span>
        <a href="#ai" class="jump-nav__link">
          AI · {aiTerms.length} terms
        </a>
      </nav>
      <header class="section__head">
        <SectionMark index="03" title="all terms" />
        <h2 class="section__title" id="quant">Quant terms · {quantTerms.length}</h2>
        <p class="section__sub">
          Statistical-evaluation vocabulary. Where possible, terms link to the methodology page
          where they are applied in practice.
        </p>
      </header>

      <dl class="glossary">
        {
          quantTerms.map((t) => (
            <div class="glossary__item" id={t.id}>
              <dt class="glossary__term">
                <a
                  href={path(`/glossary/${t.id}`)}
                  class="glossary__anchor"
                  aria-label={`Read the full definition of ${t.term}`}
                >
                  →
                </a>
                <a href={path(`/glossary/${t.id}`)} class="glossary__term-link">
                  {t.term}
                </a>
              </dt>
              <dd class="glossary__def">{t.short}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container--narrow">
      <header class="section__head">
        <h2 class="section__title" id="ai">AI terms · {aiTerms.length}</h2>
        <p class="section__sub">
          Multi-agent, retrieval, and evaluation vocabulary used across the AI lane of this site.
        </p>
      </header>

      <dl class="glossary">
        {
          aiTerms.map((t) => (
            <div class="glossary__item" id={t.id}>
              <dt class="glossary__term">
                <a
                  href={path(`/glossary/${t.id}`)}
                  class="glossary__anchor"
                  aria-label={`Read the full definition of ${t.term}`}
                >
                  →
                </a>
                <a href={path(`/glossary/${t.id}`)} class="glossary__term-link">
                  {t.term}
                </a>
              </dt>
              <dd class="glossary__def">{t.short}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CTABanner
    title="See these terms in action."
    sub={`Each definition above links to a method or artifact on this site where it is applied. The methodology page maps every gate (${GATE_RANGE}) to the term it implements.`}
    primaryLabel="Read methodology"
    secondaryLabel="Browse solutions"
    secondaryHref={path('/solutions')}
  />
</BaseLayout>

<style>
  .hero {
    padding-block: var(--sp-9) var(--sp-7);
    background: var(--c-paper);
    border-bottom: var(--border);
  }
  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-amber);
    font-weight: 600;
    margin-bottom: var(--sp-5);
  }
  .hero__title {
    font-size: clamp(1.75rem, 4.5vw, var(--fs-3xl));
    line-height: 1.15;
    margin-bottom: var(--sp-4);
    color: var(--c-ink);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero__sub {
    font-size: var(--fs-lg);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    max-width: 60ch;
  }
  .hero__voice {
    margin: 0 0 var(--sp-5);
    max-width: 60ch;
  }
  .section {
    padding-block: var(--sp-9);
  }
  .section--alt {
    background: var(--c-bg-2);
  }
  .section__head {
    margin-bottom: var(--sp-6);
  }
  .section__title {
    font-size: clamp(1.5rem, 3.5vw, var(--fs-2xl));
    margin-bottom: var(--sp-3);
    color: var(--c-ink);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .section__sub {
    color: var(--c-ink-2);
    font-size: var(--fs-base);
    line-height: var(--lh-loose);
    max-width: 60ch;
  }

  .glossary {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5) var(--sp-7);
    counter-reset: term;
  }
  @media (max-width: 720px) {
    .glossary {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }
  }
  .glossary__item {
    padding-top: var(--sp-3);
    border-top: var(--border);
  }
  .glossary__term {
    font-weight: 600;
    color: var(--c-ink);
    margin-bottom: var(--sp-2);
    font-size: var(--fs-base);
    letter-spacing: -0.005em;
    scroll-margin-top: var(--nav-h);
  }
  .glossary__term-link {
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px dotted var(--c-rule);
    transition:
      color var(--transition),
      border-color var(--transition);
  }
  .glossary__term-link:hover {
    color: var(--c-amber);
    border-bottom-color: var(--c-amber);
  }
  .glossary__anchor {
    color: var(--c-ink-3);
    text-decoration: none;
    margin-right: var(--sp-2);
    font-family: var(--ff-mono);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .glossary__item:hover .glossary__anchor,
  .glossary__anchor:focus-visible {
    opacity: 1;
  }
  .glossary__def {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-loose);
    margin: 0;
  }

  /* v13.1.4 polish-7o : recent + preview + jump-nav chrome.
     Uses the existing color/spacing/border tokens so the visual
     register stays institutional; no new palette, no new font. */

  .recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
  }
  @media (max-width: 720px) {
    .recent-list {
      grid-template-columns: 1fr;
    }
  }
  .recent-item {
    margin: 0;
  }
  .recent-link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-4);
    background: var(--c-bg);
    border: var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--c-ink);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
    height: 100%;
  }
  .recent-link:hover {
    border-color: var(--c-amber);
    box-shadow: var(--shadow-sm);
  }
  .recent-term {
    font-weight: 600;
    color: var(--c-ink);
    font-size: var(--fs-base);
    letter-spacing: -0.005em;
  }
  .recent-short {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-loose);
    flex: 1;
  }
  .recent-cat {
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-ink-3);
    font-weight: 600;
    margin-top: var(--sp-1);
  }

  .preview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    margin: 0;
  }
  @media (max-width: 720px) {
    .preview-grid {
      grid-template-columns: 1fr;
    }
  }
  .preview-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-5);
    background: var(--c-bg);
    border: var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--c-ink);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }
  .preview-card:hover {
    border-color: var(--c-amber);
    box-shadow: var(--shadow-sm);
  }
  .preview-card__count {
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-amber);
    font-weight: 600;
  }
  .preview-card__title {
    font-size: var(--fs-xl);
    font-weight: 600;
    margin: 0;
    color: var(--c-ink);
    letter-spacing: -0.01em;
  }
  .preview-card__sub {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-loose);
    margin: 0;
    max-width: 50ch;
  }
  .preview-card__examples {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .preview-card__example {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    padding: 2px var(--sp-2);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    color: var(--c-ink-2);
    background: var(--c-paper);
  }
  .preview-card__cta {
    margin-top: auto;
    padding-top: var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--c-amber);
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .jump-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    align-items: center;
    padding: var(--sp-3) 0;
    margin-bottom: var(--sp-5);
    border-bottom: var(--border);
    font-size: var(--fs-sm);
  }
  .jump-nav__link {
    color: var(--c-ink-2);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.005em;
    padding: var(--sp-1) var(--sp-2);
    border-radius: var(--radius);
    transition:
      color var(--transition),
      background var(--transition);
  }
  .jump-nav__link:hover {
    color: var(--c-amber);
    background: var(--c-amber-soft);
  }
  .jump-nav__sep {
    color: var(--c-ink-3);
  }
</style>
