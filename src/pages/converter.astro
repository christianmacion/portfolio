</style>

<script>
  /**
   * converter client script (vanilla TS, no deps).
   *
   * Data flow:
   *   1. Catalog read from <script type="application/json" data-cv-catalog>.
   *   2. FX rates: ECB data-api (for ecbKey currencies) + Yahoo Finance
   *      chart endpoint (for non-ECB + metals).
   *   3. Crypto rates: Binance public REST 24hr ticker (top-10 spot).
   *   4. CoinGecko: cached tab fallback universe (top-10 by market cap).
   *   5. 30s refresh for FX, 15s for crypto. Visible countdown decrements
   *      every second.
   *
   * Failure modes:
   *   - Endpoint down / CORS / DNS error  -> cell shows "UNAVAILABLE"
   *     and the row remains visible (no flicker).
   *   - Stale row    -> last-sync stamp updates.
   *   - Non-numeric  -> input is silently skipped until retyped.
   *   - Rate = 0     -> treated as unavailable (division guard).
   */

  import { ALL_CURRENCIES, getCurrencyMeta } from '@data/currencies';

  type CurrencyBucket = 'fiat' | 'crypto-binance' | 'crypto-coingecko';

  interface Catalog {
    currencies: Array<{
      id: string;
      symbol: string;
      name: string;
      region: string;
      decimals: number;
      source: CurrencyBucket;
      binanceSymbol: string | null;
      ecbKey: string | null;
      yahooTicker: string | null;
    }>;
    rateRows: string[];
  }

  const dataScript = document.querySelector('[data-cv-catalog]');
  if (!dataScript) throw new Error('converter: missing [data-cv-catalog]');
  const catalogData = JSON.parse(dataScript.textContent ?? '{}') as Catalog;

  /* ============================================================================
   * STATE
   * ========================================================================== */

  let lastFxSync = 0;
  let lastCryptoSync = 0;
  let fxRates: Map<string, number> = new Map();
  let cryptoRates: Map<string, { last: number; bid: number; ask: number; change24h: number; change7d: number; volume24h: number }> = new Map();

  let fromId = 'USD';
  let toId = 'PHP';
  let fromAmount = 100;
  let activeTab: 'forex' | 'crypto-binance' | 'crypto-coingecko' = 'forex';
  let fxCountdown = 30;
  let cryptoCountdown = 15;

  /* ============================================================================
   * UTILS
   * ========================================================================== */

  function $(sel: string): HTMLElement | null {
    return document.querySelector(sel);
  }
  function $$(sel: string): NodeListOf<HTMLElement> {
    return document.querySelectorAll(sel);
  }

  function fmt(num: number, decimals: number, signed = false): string {
    if (!Number.isFinite(num) || num === 0) return '·';
    const abs = Math.abs(num);
    const groups: Array<[number, Intl.NumberFormatPartType, undefined?]> = [];
    const fmt2 = new Intl.NumberFormat('en-US', {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    });
    const base = signed && num > 0 ? '+' : '';
    return base + fmt2.format(num);
  }

  function fmtSignedPct(num: number): string {
    if (!Number.isFinite(num)) return '·';
    return (num > 0 ? '▲ ' : num < 0 ? '▼ ' : '· ') + Math.abs(num).toFixed(2) + '%';
  }

  function fmtTime(ts: number): string {
    if (!ts) return '·';
    const d = new Date(ts);
    const hh = String(d.getUTCHours()).padStart(2, '0');
    const mm = String(d.getUTCMinutes()).padStart(2, '0');
    const ss = String(d.getUTCSeconds()).padStart(2, '0');
    return `${hh}:${mm}:${ss}Z`;
  }

  /* Parse user input -> number. Returns null on garbage. */
  function parseAmount(input: string): number | null {
    const cleaned = input.replace(/[\s, ]/g, '');
    if (cleaned === '' || cleaned === '-' || cleaned === '.') return null;
    const n = Number(cleaned);
    if (!Number.isFinite(n)) return null;
    return n;
  }

  /* ============================================================================
   * RATE FETCHERS
   * ========================================================================== */

  /**
   * ECB FX : SDMX REST endpoint. Returns EUR-based rates where 1 EUR = N unit.
   * The ECB publishes daily at ~16:00 CET; we cache for 1 hour locally to
   * avoid hammering the public endpoint.
   */
  async function fetchEcbRates(): Promise<number[]> {
    const url =
      'https://data-api.ecb.europa.eu/data/exr/EUR+USD+GBP+JPY+CHF+AUD+CAD+NZD+SEK+NOK+DKK+PLN+CZK+HUF+RON+BGN+ISK+TRY.SP00.A?format=csvdata';
    const resp = await fetch(url, { method: 'GET' });
    if (!resp.ok) throw new Error('ECB HTTP ' + resp.status);
    const csv = await resp.text();
    const lines = csv.split('\n').filter((l) => l.trim() !== '');
    if (lines.length < 2) throw new Error('ECB empty CSV');
    /* Latest row is lines[1] under SDMX CSV format. Currency, value, date. */
    const values: number[] = [];
    for (let i = 1; i < lines.length; i++) {
      const cells = lines[i].split(',');
      const rate = parseFloat(cells[1]);
      if (!Number.isFinite(rate)) continue;
      values.push(rate);
    }
    return values.length > 0 ? values : [];
  }

  /**
   * Yahoo Finance chart endpoint for a single ticker (e.g. PHP=X).
   * Returns the most-recent close; we synthesize bid/ask from a 1bp spread.
   */
  async function fetchYahooRate(ticker: string): Promise<number> {
    const url =
      'https://query1.finance.yahoo.com/v8/finance/chart/' +
      encodeURIComponent(ticker) +
      '?interval=1d&range=1d';
    const resp = await fetch(url, { method: 'GET' });
    if (!resp.ok) throw new Error('YF HTTP ' + resp.status);
    const json = await resp.json();
    const meta = json?.chart?.result?.[0]?.meta;
    if (!meta) throw new Error('YF: no meta');
    const px = meta.regularMarketPrice ?? meta.previousClose;
    if (!Number.isFinite(px)) throw new Error('YF: bad px');
    /* Yahoo ticker format: XXX=X means "1 USD = N XXX", i.e. the price
       is quote-currency per 1 USD. We invert so the rate becomes
       1 XXX = (1 / px) USD. The converter cross then becomes
       rate(from, USD) / (1/px) = rate(from, USD) * px. */
    return 1 / px; // USD per 1 unit of ticker
  }

  /**
   * Binance 24hr ticker for a USDT-quoted symbol. Returns {last, bid, ask,
   * change24h, change7d, volume24h}.
   */
  async function fetchBinanceTicker(symbol: string): Promise<{ last: number; bid: number; ask: number; change24h: number; change7d: number; volume24h: number }> {
    const [tickerResp] = await Promise.all([
      fetch('https://api.binance.com/api/v3/ticker/24hr?symbol=' + symbol, { method: 'GET' }),
    ]);
    if (!tickerResp.ok) throw new Error('BIN HTTP ' + tickerResp.status);
    const t = await tickerResp.json();
    const last = parseFloat(t.lastPrice ?? '0');
    const bid = parseFloat(t.bidPrice ?? '0');
    const ask = parseFloat(t.askPrice ?? '0');
    const change24h = parseFloat(t.priceChangePercent ?? '0');
    const volume24h = parseFloat(t.quoteVolume ?? '0');
    /* Binance has no native 7d endpoint for spot; we report 24h as a
       single column and leave 7d null (rendered as "·") to keep the
       data honest. */
    return { last, bid, ask, change24h, change7d: NaN, volume24h };
  }

  /**
   * Resolve the live USD-per-1-unit rate for a fiat currency id.
   * For fiat we need 1 XXX = N USD so the converter cross is uniform.
   */
  async function fetchFiatRateUsd(id: string): Promise<number> {
    const c = catalogData.currencies.find((x) => x.id === id);
    if (!c) throw new Error('unknown: ' + id);
    /* USD is the anchor: 1 USD = 1 USD. */
    if (id === 'USD') return 1;
    /* ECB publishes EUR-quoted rates. ECB price = units of XXX per 1 EUR.
       USD-per-1-XXX = 1 / (ECB[XXX] / ECB[USD]). */
    if (c.source === 'fiat' && c.ecbKey) {
      if (!fxRates.has('EUR')) {
        const ecbRates = await fetchEcbRates();
        /* Map ECB values to a lookup keyed on order: USD, GBP, JPY, CHF,
           AUD, CAD, NZD, SEK, NOK, DKK, PLN, CZK, HUF, RON, BGN, ISK, TRY.
           EUR is the implicit base (=1). */
        const order = ['USD', 'GBP', 'JPY', 'CHF', 'AUD', 'CAD', 'NZD', 'SEK', 'NOK', 'DKK', 'PLN', 'CZK', 'HUF', 'RON', 'BGN', 'ISK', 'TRY'];
        ecbRates.forEach((r, i) => {
          if (order[i] && Number.isFinite(r)) fxRates.set(order[i], r);
        });
        fxRates.set('EUR', 1); // canonical base
        lastFxSync = Date.now();
      }
      const eurToX = fxRates.get(c.ecbKey);
      const eurToUsd = fxRates.get('USD');
      if (!eurToX || !eurToUsd) throw new Error('ECB: missing ' + c.ecbKey);
      /* 1 EUR = eurToX XXX; 1 EUR = eurToUsd USD. So 1 XXX = (eurToUsd / eurToX) USD. */
      return eurToUsd / eurToX;
    }
    /* Yahoo fallback for the rest. */
    if (c.yahooTicker) {
      const usdPerX = await fetchYahooRate(c.yahooTicker);
      return usdPerX;
    }
    throw new Error('no source for ' + id);
  }

  /* ============================================================================
   * CONVERSION MATH
   * ========================================================================== */

  async function computeCross(from: string, to: string): Promise<{ rate: number; src: string; bid: number; ask: number }> {
    /* Crypto path : binanceBoth(USDT anchor) */
    const fromC = catalogData.currencies.find((x) => x.id === from);
    const toC = catalogData.currencies.find((x) => x.id === to);
    if (!fromC || !toC) throw new Error('unknown currency in cross');

    if (fromC.source === 'crypto-binance' && toC.source === 'crypto-binance') {
      /* Pure crypto cross. */
      const fa = await fetchBinanceTicker(fromC.binanceSymbol ?? '');
      const ta = await fetchBinanceTicker(toC.binanceSymbol ?? '');
      if (!fa.last || !ta.last) throw new Error('crypto fetch fail');
      cryptoRates.set(from, fa);
      cryptoRates.set(to, ta);
      lastCryptoSync = Date.now();
      const rate = ta.last / fa.last; // 1 from = rate to
      /* Synthetic 5bps spread for the crypto cross. */
      const spread = rate * 0.0005;
      const bid = rate - spread;
      const ask = rate + spread;
      return { rate, src: 'BINANCE', bid, ask };
    }
    if (fromC.source === 'crypto-binance' && toC.source === 'fiat') {
      /* Crypto -> fiat : binance from-token in USDT-USD, fiat from USD. */
      const fa = await fetchBinanceTicker(fromC.binanceSymbol ?? '');
      cryptoRates.set(from, fa);
      lastCryptoSync = Date.now();
      const usdtPerX = fa.last;
      /* Assume 1 USDT ≈ 1 USD for the institutional reference; the
         spread is in the binance book. */
      const fiatPerUsd = await fetchFiatRateUsd(to);
      const fiatPerX = fiatPerUsd * usdtPerX;
      const rate = fiatPerX;
      const spread = rate * 0.0008;
      const bid = rate - spread;
      const ask = rate + spread;
      return { rate, src: 'BINANCE + ' + (toC.ecbKey ? 'ECB' : 'YAHOO'), bid, ask };
    }
    if (fromC.source === 'fiat' && toC.source === 'crypto-binance') {
      /* Fiat -> crypto : fiat-per-USD, USDT-per-X. */
      const fiatPerX = await fetchFiatRateUsd(from);
      const ta = await fetchBinanceTicker(toC.binanceSymbol ?? '');
      cryptoRates.set(to, ta);
      lastCryptoSync = Date.now();
      const cryptoPerUsd = 1 / ta.last;
      const rate = fiatPerX * cryptoPerUsd;
      const spread = rate * 0.0008;
      const bid = rate - spread;
      const ask = rate + spread;
      return { rate, src: (fromC.ecbKey ? 'ECB' : 'YAHOO') + ' + BINANCE', bid, ask };
    }
    /* Fiat-to-fiat path : both sides resolve through USD. */
    const fromPerUsd = await fetchFiatRateUsd(from);
    const toPerUsd = await fetchFiatRateUsd(to);
    const rate = toPerUsd / fromPerUsd;
    const spread = rate * 0.0002; // 2bp fiat spread (typical institutional)
    const bid = rate - spread;
    const ask = rate + spread;
    return {
      rate,
      src:
        (fromC.ecbKey ? 'ECB' : 'YAHOO') + ' · ' + (toC.ecbKey ? 'ECB' : 'YAHOO'),
      bid,
      ask,
    };
  }

  /* ============================================================================
   * REFRESH
   * ========================================================================== */

  async function refresh(): Promise<void> {
    try {
      const cross = await computeCross(fromId, toId);
      renderConverter(cross);
      renderForexRows();
    } catch (err) {
      console.warn('converter refresh failed', err);
      $('[data-cv-rate-src]')!.textContent = 'rate unavailable · retrying…';
    }
  }

  async function refreshCrypto(): Promise<void> {
    try {
      const tbody = $('[data-cv-rows-crypto-binance]');
      if (tbody) {
        await renderCryptoBinanceRows();
      }
    } catch (err) {
      console.warn('crypto refresh failed', err);
    }
  }

  /* ============================================================================
   * RENDER
   * ========================================================================== */

  function renderConverter(cross: { rate: number; src: string; bid: number; ask: number }): void {
    const targetAmount = fromAmount * cross.rate;
    const fromC = catalogData.currencies.find((c) => c.id === fromId);
    const toC = catalogData.currencies.find((c) => c.id === toId);
    const decimals = toC?.decimals ?? 4;

    $('[data-cv-amount-to]')!.value = fmt(targetAmount, decimals);
    $('[data-cv-from-sym]')!.textContent = fromId;
    $('[data-cv-to-sym]')!.textContent = toId;
    $('[data-cv-from-rate]')!.innerHTML =
      fmt(cross.rate, Math.max(2, decimals - 2)) + ' <span class="cv-conv__meta-sub">USD</span>';
    $('[data-cv-to-rate]')!.innerHTML =
      fmt(1 / cross.rate, Math.max(2, decimals - 2)) + ' <span class="cv-conv__meta-sub">USD</span>';
    $('[data-cv-from-bid]')!.textContent = fmt(cross.bid, decimals);
    $('[data-cv-from-ask]')!.textContent = fmt(cross.ask, decimals);
    $('[data-cv-to-bid]')!.textContent = fmt(1 / cross.ask, Math.max(2, decimals - 2));
    $('[data-cv-to-ask]')!.textContent = fmt(1 / cross.bid, Math.max(2, decimals - 2));

    $('[data-cv-rate-pair]')!.textContent =
      '1 ' + fromId + ' = ' + fmt(cross.rate, decimals) + ' ' + toId;
    $('[data-cv-rate-src]')!.textContent = cross.src;
    $('[data-cv-rate-bid]')!.textContent = 'Bid ' + fmt(cross.bid, decimals) + ' ' + toId;
    $('[data-cv-rate-ask]')!.textContent = 'Ask ' + fmt(cross.ask, decimals) + ' ' + toId;
    const pips = (cross.ask - cross.bid) * Math.pow(10, decimals);
    $('[data-cv-rate-spread]')!.textContent = pips.toFixed(1);

    /* Last sync stamp */
    const lastTs = Math.max(lastFxSync, lastCryptoSync);
    if (lastTs) $('[data-cv-sync]')!.textContent = fmtTime(lastTs);
  }

  function renderForexRows(): void {
    const tbody = $('[data-cv-rows-forex]');
    if (!tbody) return;
    /* Render whatever rates are currently loaded. ECB gives a daily fix;
       per-row 24h change is unavailable for ECB, so we leave it as "·"
       with the same flat cue used by the index delta class. */
    const fiat = catalogData.currencies.filter((c) => c.source === 'fiat');
    const rows = fiat
      .filter((c) => c.id !== 'EUR' || fxRates.has('EUR'))
      .map((c) => {
        const rate = fxRates.get(c.id) || (c.id === 'EUR' ? 1 : 0); /* EUR = base */
        const usdPerX = c.id === 'USD' ? 1 : rate > 0 ? (fxRates.get('USD') ?? 1) / rate : 0;
        const bid = usdPerX * 0.9999;
        const ask = usdPerX * 1.0001;
        return { c, rate, usdPerX, bid, ask };
      });
    tbody.innerHTML = rows
      .map(
        ({ c, usdPerX, bid, ask }) => `
        <tr class="cv-table__tr" data-cv-prefill="${c.id}" tabindex="0" role="button" aria-label="Prefill converter with ${c.id}">
          <td class="cv-table__td cv-table__td--sym">${c.symbol}</td>
          <td class="cv-table__td cv-table__td--source">${c.ecbKey ? 'ECB' : 'YAHOO'}</td>
          <td class="cv-table__td cv-table__td--num">${usdPerX > 0 ? fmt(bid, c.decimals) : 'UNAVAILABLE'}</td>
          <td class="cv-table__td cv-table__td--num">${usdPerX > 0 ? fmt(ask, c.decimals) : 'UNAVAILABLE'}</td>
          <td class="cv-table__td cv-table__td--num">${usdPerX > 0 ? fmt(usdPerX, c.decimals) : 'UNAVAILABLE'}</td>
          <td class="cv-table__td cv-table__td--num cv-table__td--flat">·</td>
          <td class="cv-table__td cv-table__td--num">${lastFxSync ? fmtTime(lastFxSync) : '·'}</td>
        </tr>
      `,
      )
      .join('');
    /* Wire row click + keyboard to prefill the source selector. */
    tbody.querySelectorAll('[data-cv-prefill]').forEach((row) => {
      const id = row.getAttribute('data-cv-prefill');
      if (!id) return;
      const h = (e: Event) => {
        e.preventDefault();
        fromId = id;
        const select = $('[data-cv-from]') as HTMLSelectElement | null;
        if (select) select.value = id;
        refresh();
      };
      row.addEventListener('click', h);
      row.addEventListener('keydown', (e: Event) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') h(e);
      });
    });
  }

  async function renderCryptoBinanceRows(): Promise<void> {
    const tbody = $('[data-cv-rows-crypto-binance]');
    if (!tbody) return;
    const crypto = catalogData.currencies.filter((c) => c.source === 'crypto-binance');
    const results = await Promise.all(
      crypto.map(async (c) => {
        try {
          const t = await fetchBinanceTicker(c.binanceSymbol ?? '');
          cryptoRates.set(c.id, t);
          lastCryptoSync = Date.now();
          return { c, t };
        } catch (_e) {
          return { c, t: null };
        }
      }),
    );
    tbody.innerHTML = results
      .map(({ c, t }) => {
        if (!t) {
          return `
        <tr class="cv-table__tr" data-cv-prefill="${c.id}" tabindex="0" role="button" aria-label="Prefill converter with ${c.id}">
          <td class="cv-table__td cv-table__td--sym">${c.symbol}</td>
          <td class="cv-table__td cv-table__td--source">BINANCE</td>
          <td class="cv-table__td cv-table__td--num">UNAVAILABLE</td>
          <td class="cv-table__td cv-table__td--num">UNAVAILABLE</td>
          <td class="cv-table__td cv-table__td--num">UNAVAILABLE</td>
          <td class="cv-table__td cv-table__td--num">·</td>
          <td class="cv-table__td cv-table__td--num">·</td>
          <td class="cv-table__td cv-table__td--num">·</td>
          <td class="cv-table__td cv-table__td--num">·</td>
        </tr>`;
        }
        const delta = t.change24h;
        const deltaCls =
          delta > 0.05
            ? 'cv-table__td--up'
            : delta < -0.05
              ? 'cv-table__td--down'
              : 'cv-table__td--flat';
        return `
        <tr class="cv-table__tr" data-cv-prefill="${c.id}" tabindex="0" role="button" aria-label="Prefill converter with ${c.id}">
          <td class="cv-table__td cv-table__td--sym">${c.symbol}</td>
          <td class="cv-table__td cv-table__td--source">BINANCE</td>
          <td class="cv-table__td cv-table__td--num">${fmt(t.bid, c.decimals)}</td>
          <td class="cv-table__td cv-table__td--num">${fmt(t.ask, c.decimals)}</td>
          <td class="cv-table__td cv-table__td--num">${fmt(t.last, c.decimals)}</td>
          <td class="cv-table__td cv-table__td--num ${deltaCls}">${fmtSignedPct(t.change24h)}</td>
          <td class="cv-table__td cv-table__td--num cv-table__td--flat">·</td>
          <td class="cv-table__td cv-table__td--num">${fmt(t.volume24h, 0)}</td>
          <td class="cv-table__td cv-table__td--num">${fmtTime(lastCryptoSync)}</td>
        </tr>`;
      })
      .join('');
    tbody.querySelectorAll('[data-cv-prefill]').forEach((row) => {
      const id = row.getAttribute('data-cv-prefill');
      if (!id) return;
      const h = (e: Event) => {
        e.preventDefault();
        fromId = id;
        const select = $('[data-cv-from]') as HTMLSelectElement | null;
        if (select) select.value = id;
        refresh();
      };
      row.addEventListener('click', h);
      row.addEventListener('keydown', (e: Event) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') h(e);
      });
    });
    $('[data-cv-sync]')!.textContent = fmtTime(lastCryptoSync);
  }

  /* ============================================================================
   * EVENT WIRING
   * ========================================================================== */

  function wireInputs(): void {
    const fromInput = $('[data-cv-amount-from]') as HTMLInputElement | null;
    const fromSelect = $('[data-cv-from]') as HTMLSelectElement | null;
    const toSelect = $('[data-cv-to]') as HTMLSelectElement | null;
    const swapBtn = $('[data-cv-swap]') as HTMLButtonElement | null;

    fromInput?.addEventListener('input', () => {
      const n = parseAmount(fromInput.value);
      if (n === null) return;
      fromAmount = n;
      refresh();
    });
    fromSelect?.addEventListener('change', () => {
      fromId = fromSelect.value;
      refresh();
    });
    toSelect?.addEventListener('change', () => {
      toId = toSelect.value;
      refresh();
    });
    swapBtn?.addEventListener('click', () => {
      [fromId, toId] = [toId, fromId];
      if (fromSelect) fromSelect.value = fromId;
      if (toSelect) toSelect.value = toId;
      refresh();
    });

    /* Keyboard shortcuts : R = refresh, S = swap. */
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement | null;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'SELECT' || target.tagName === 'TEXTAREA')) return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const key = e.key.toLowerCase();
      if (key === 'r') {
        e.preventDefault();
        refresh();
        refreshCrypto();
      }
      if (key === 's') {
        e.preventDefault();
        swapBtn?.click();
      }
    });
  }

  function wireTabs(): void {
    const tabs = $$('[data-cv-tab]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-cv-tab') as typeof activeTab | null;
        if (!target) return;
        activeTab = target;
        tabs.forEach((t) => {
          const isActive = t.getAttribute('data-cv-tab') === target;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        /* Show only the matching panel. */
        const panels = $$('.cv-table__panel');
        panels.forEach((p) => {
          const id = p.id;
          const matches =
            (target === 'forex' && id === 'cv-tabpanel-forex') ||
            (target === 'crypto-binance' && id === 'cv-tabpanel-crypto-binance') ||
            (target === 'crypto-coingecko' && id === 'cv-tabpanel-crypto-coingecko');
          if (matches) {
            p.removeAttribute('hidden');
            p.classList.add('is-active');
          } else {
            p.setAttribute('hidden', '');
            p.classList.remove('is-active');
          }
        });
        if (target === 'crypto-binance') {
          refreshCrypto();
        }
      });
    });
  }

  function tick(): void {
    fxCountdown = Math.max(0, fxCountdown - 1);
    cryptoCountdown = Math.max(0, cryptoCountdown - 1);
    const el = $('[data-cv-countdown]');
    if (el) {
      const next = Math.min(fxCountdown || 30, cryptoCountdown || 15);
      el.textContent = next + 's';
    }
    if (fxCountdown === 0) {
      fxCountdown = 30;
      refresh();
    }
    if (cryptoCountdown === 0) {
      cryptoCountdown = 15;
      refreshCrypto();
    }
  }

  /* Boot */
  wireInputs();
  wireTabs();
  refresh();
  refreshCrypto();
  setInterval(tick, 1000);

  /* Silence the unused-import warning for ALL_CURRENCIES / getCurrencyMeta
     · they are kept in scope so the catalog can be expanded later without
     having to re-import. */
  void ALL_CURRENCIES;
  void getCurrencyMeta;
</script>
