---
/**
 * converter.astro : v13.1.4 polish-7az institutional live converter.
 *
 * Live FX + crypto conversion widget, institutional register (Bloomberg /
 * Reuters reference). Reuses the existing data-substrate allowlist (ECB FX
 * + Yahoo Finance + Binance public REST + CoinGecko REST) wired in the
 * site CSP. No new endpoints, no new data files.
 *
 * Layout (top → bottom):
 *   1. Header strip : LIVE CONVERTER · ECB FX + BINANCE + COINGECKO · °C ·
 *      LAST SYNC HH:MM:SSZ · UTC+8 HOME BASE
 *   2. Converter widget : source/target inputs, currency selectors,
 *      swap button, live rate, bid/ask/spread for FX, refresh countdown
 *   3. Tabbed rate table : FOREX(ECB / YF) | CRYPTO(BINANCE) |
 *      CRYPTO(COINGECKO) ; 30+ rows; click a row to prefill the converter
 *   4. Footer : data provenance + refresh cadence + disclaimer
 *
 * Chrome contract v1:
 *   - mono font for ALL numbers (var(--ff-mono))
 *   - tabular numerals (font-variant-numeric: tabular-nums)
 *   - amber accent only on positive deltas / active / swap / sync dot
 *   - hairline borders (var(--c-rule))
 *   - sharp 0-2px corners
 *   - no halo, no glow, no gradient
 *
 * Constraints (binding):
 *   - §6 NDA scope : zero employer mentions
 *   - senior "Quant Researcher" positioning
 *   - 0 em-dashes (G81)
 *   - no Math.random / Date.now
 *   - WCAG 2.2 AA: keyboard nav, focus rings, screen-reader labels
 *   - no {var} interpolation leaks
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ChromeHeader from '@components/ChromeHeader.astro';
import CTABanner from '@components/CTABanner.astro';
import {
  ALL_CURRENCIES,
  DEFAULT_SOURCE,
  DEFAULT_TARGET,
  DEFAULT_RATE_ROWS,
} from '@data/currencies';
import { path } from '@utils/url';

// Catalog snapshot for the client-side filtering. ~30 rows, weight ~3KB.
const catalog = ALL_CURRENCIES.map((c) => ({
  id: c.id,
  symbol: c.symbol,
  name: c.name,
  region: c.region,
  decimals: c.decimals,
  source: c.source,
  binanceSymbol: c.binanceSymbol ?? null,
  ecbKey: c.ecbKey ?? null,
  yahooTicker: c.yahooTicker ?? null,
}));

// The rate-table rows are the same on every build (no Math.random,
// no Date.now). Order is what the spec asked for.
const rateRows = DEFAULT_RATE_ROWS.filter(
  (id) => ALL_CURRENCIES.find((c) => c.id === id) != null,
);
---

<BaseLayout
  title="Converter"
  description="Live institutional FX + crypto converter. ECB official rates, Binance 24hr ticker, CoinGecko top-of-book. Mono numbers, tabular alignment, pip display."
  breadcrumbs={[
    { name: 'Home',    href: '/' },
    { name: 'Markets', href: '/markets' },
    { name: 'Converter', href: '/converter' },
  ]}
>
  {/* ============================================================
       HEADER STRIP : chrome contract eyebrow + sync stamp.
       ============================================================ */}
  <section class="cv-head">
    <div class="container cv-head__inner">
      <ChromeHeader
        chip="LIVE CONVERTER · INSTITUTIONAL"
        eyebrow="FX · CRYPTO · METALS · 30+ ROWS"
        chipVariant="amber"
        noSep
        hideTenet
      />
      <p class="cv-head__tenant mono" aria-label="Sync status ticker">
        <span class="cv-head__chip">LIVE</span>
        <span class="cv-head__chip-sep">·</span>
        <span>ECB FX</span>
        <span class="cv-head__chip-sep">·</span>
        <span>BINANCE</span>
        <span class="cv-head__chip-sep">·</span>
        <span>COINGECKO</span>
        <span class="cv-head__chip-sep">·</span>
        <span>LAST SYNC <span data-cv-sync>·</span></span>
        <span class="cv-head__chip-sep">·</span>
        <span>UTC+8 HOME BASE</span>
      </p>
    </div>
  </section>

  {/* ============================================================
       HERO : dark editorial, terminal cadence.
       ============================================================ */}
  <section class="cv-hero">
    <div class="container cv-hero__inner">
      <h1 class="cv-hero__title" data-words>
        A live terminal-grade converter, sourced from the same wire feeds a quant desk reads.
      </h1>
      <p class="cv-hero__lead">
        ECB reference rates for 18 currencies, Yahoo Finance for ASEAN + BRICS, Binance
        spot for the 10-largest crypto by 24h turnover, CoinGecko REST as the
        fallback universe. No fabricated numbers, no synthetic rates. Every value
        in the table is a real bid from a public endpoint; refresh is every 30
        seconds for FX, every 15 seconds for crypto.
      </p>
    </div>
  </section>

  {/* ============================================================
       CONVERTER WIDGET : two columns + swap button + live readouts.
       ============================================================ */}
  <section class="cv-conv">
    <div class="container">
      <div class="cv-conv__grid" data-cv-conv>
        {/* Source column */}
        <div class="cv-conv__col">
          <label class="cv-conv__label mono" for="cv-amount-from">FROM</label>
          <input
            id="cv-amount-from"
            class="cv-conv__amount mono"
            data-cv-amount-from
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            value="100"
            aria-label="Source amount"
          />
          <label class="cv-conv__label mono" for="cv-currency-from">CURRENCY</label>
          <select
            id="cv-currency-from"
            class="cv-conv__select mono"
            data-cv-from
            aria-label="Source currency"
          >
            {catalog.map((c) => (
              <option value={c.id} selected={c.id === DEFAULT_SOURCE}>
                {c.symbol} · {c.name} · {c.region}
              </option>
            ))}
          </select>
          <dl class="cv-conv__meta mono" aria-label="Source meta">
            <div class="cv-conv__meta-row">
              <dt>1 <span data-cv-from-sym>{DEFAULT_SOURCE}</span></dt>
              <dd data-cv-from-rate>· <span class="cv-conv__meta-sub">mid</span></dd>
            </div>
            <div class="cv-conv__meta-row">
              <dt>BID</dt>
              <dd data-cv-from-bid>·</dd>
            </div>
            <div class="cv-conv__meta-row">
              <dt>ASK</dt>
              <dd data-cv-from-ask>·</dd>
            </div>
          </dl>
        </div>

        {/* Swap button */}
        <button
          type="button"
          class="cv-conv__swap mono"
          data-cv-swap
          aria-label="Swap source and target currencies"
          title="Swap (press S)"
        >
          <span aria-hidden="true">←</span>
          <span aria-hidden="true">→</span>
        </button>

        {/* Target column */}
        <div class="cv-conv__col">
          <label class="cv-conv__label mono" for="cv-amount-to">TO</label>
          <input
            id="cv-amount-to"
            class="cv-conv__amount mono"
            data-cv-amount-to
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            value="·"
            aria-label="Target amount (live)"
            aria-live="polite"
          />
          <label class="cv-conv__label mono" for="cv-currency-to">CURRENCY</label>
          <select
            id="cv-currency-to"
            class="cv-conv__select mono"
            data-cv-to
            aria-label="Target currency"
          >
            {catalog.map((c) => (
              <option value={c.id} selected={c.id === DEFAULT_TARGET}>
                {c.symbol} · {c.name} · {c.region}
              </option>
            ))}
          </select>
          <dl class="cv-conv__meta mono" aria-label="Target meta">
            <div class="cv-conv__meta-row">
              <dt>1 <span data-cv-to-sym>{DEFAULT_TARGET}</span></dt>
              <dd data-cv-to-rate>· <span class="cv-conv__meta-sub">mid</span></dd>
            </div>
            <div class="cv-conv__meta-row">
              <dt>BID</dt>
              <dd data-cv-to-bid>·</dd>
            </div>
            <div class="cv-conv__meta-row">
              <dt>ASK</dt>
              <dd data-cv-to-ask>·</dd>
            </div>
          </dl>
        </div>
      </div>

      {/* Live rate + spread + countdown */}
      <div class="cv-conv__readout mono" aria-live="polite">
        <p class="cv-conv__readout-line">
          <span class="cv-conv__readout-label">LIVE RATE</span>
          <span class="cv-conv__readout-pair" data-cv-rate-pair>1 USD = · PHP</span>
          <span class="cv-conv__readout-source" data-cv-rate-src>loading…</span>
        </p>
        <p class="cv-conv__readout-line cv-conv__readout-line--pip">
          <span class="cv-conv__readout-label">PIP</span>
          <span data-cv-rate-bid>Bid ·</span>
          <span class="cv-conv__readout-sep">·</span>
          <span data-cv-rate-ask>Ask ·</span>
          <span class="cv-conv__readout-sep">·</span>
          <span>Spread <span data-cv-rate-spread>·</span> pips</span>
        </p>
        <p class="cv-conv__readout-line cv-conv__readout-line--countdown">
          <span class="cv-conv__readout-label">REFRESH</span>
          <span data-cv-countdown>30s</span>
          <span class="cv-conv__readout-hint">press <kbd>R</kbd> to refresh now</span>
        </p>
      </div>
    </div>
  </section>

  {/* ============================================================
       RATE TABLE : 30+ institutional rows, tabbed by source.
       ============================================================ */}
  <section class="cv-table">
    <div class="container">
      <header class="cv-table__head">
        <p class="section__eyebrow">Bid · Ask · 24h Δ · 7d Δ · 24h Vol</p>
        <h2 class="cv-table__title">Live institutional rates</h2>
        <p class="section__sub">
          Click any row to prefill the converter. The two CRYPTO tabs use
          identical columns; the FOREX tab is thinned to the columns a
          spot desk would print (Bid / Ask / Last / 24h Δ %).
        </p>
      </header>

      <div class="cv-table__tabs mono" role="tablist" aria-label="Rate tabs">
        <button
          type="button"
          class="cv-table__tab is-active"
          data-cv-tab="forex"
          role="tab"
          aria-selected="true"
          aria-controls="cv-tabpanel-forex"
        >FOREX (ECB · YF)</button>
        <button
          type="button"
          class="cv-table__tab"
          data-cv-tab="crypto-binance"
          role="tab"
          aria-selected="false"
          aria-controls="cv-tabpanel-crypto-binance"
        >CRYPTO (BINANCE)</button>
        <button
          type="button"
          class="cv-table__tab"
          data-cv-tab="crypto-coingecko"
          role="tab"
          aria-selected="false"
          aria-controls="cv-tabpanel-crypto-coingecko"
        >CRYPTO (COINGECKO)</button>
      </div>

      {/* FOREX tab : 18 ECB + 14 Yahoo Finance = 32 rows */}
      <div
        class="cv-table__panel is-active"
        id="cv-tabpanel-forex"
        role="tabpanel"
        aria-labelledby="cv-tab-forex"
      >
        <div class="cv-table__scroll" role="region" aria-label="FOREX rates">
          <table class="cv-table__table mono">
            <thead>
              <tr>
                <th class="cv-table__th cv-table__th--sym">Symbol</th>
                <th class="cv-table__th">Source</th>
                <th class="cv-table__th cv-table__th--num">Bid</th>
                <th class="cv-table__th cv-table__th--num">Ask</th>
                <th class="cv-table__th cv-table__th--num">Last</th>
                <th class="cv-table__th cv-table__th--num">24h Δ</th>
                <th class="cv-table__th cv-table__th--num">Updated</th>
              </tr>
            </thead>
            <tbody data-cv-rows-forex>
              {/* rendered by client-side script */}
            </tbody>
          </table>
        </div>
      </div>

      {/* CRYPTO (BINANCE) tab : 10 rows */}
      <div
        class="cv-table__panel"
        id="cv-tabpanel-crypto-binance"
        role="tabpanel"
        aria-labelledby="cv-tab-crypto-binance"
        hidden
      >
        <div class="cv-table__scroll" role="region" aria-label="CRYPTO Binance rates">
          <table class="cv-table__table mono">
            <thead>
              <tr>
                <th class="cv-table__th cv-table__th--sym">Symbol</th>
                <th class="cv-table__th">Source</th>
                <th class="cv-table__th cv-table__th--num">Bid</th>
                <th class="cv-table__th cv-table__th--num">Ask</th>
                <th class="cv-table__th cv-table__th--num">Last</th>
                <th class="cv-table__th cv-table__th--num">24h Δ</th>
                <th class="cv-table__th cv-table__th--num">7d Δ</th>
                <th class="cv-table__th cv-table__th--num">24h Vol</th>
                <th class="cv-table__th cv-table__th--num">Updated</th>
              </tr>
            </thead>
            <tbody data-cv-rows-crypto-binance>
              {/* rendered by client-side script */}
            </tbody>
          </table>
        </div>
      </div>

      {/* CRYPTO (COINGECKO) tab : top 10 by market cap */}
      <div
        class="cv-table__panel"
        id="cv-tabpanel-crypto-coingecko"
        role="tabpanel"
        aria-labelledby="cv-tab-crypto-coingecko"
        hidden
      >
        <div class="cv-table__scroll" role="region" aria-label="CRYPTO CoinGecko rates">
          <table class="cv-table__table mono">
            <thead>
              <tr>
                <th class="cv-table__th cv-table__th--sym">Symbol</th>
                <th class="cv-table__th">Source</th>
                <th class="cv-table__th cv-table__th--num">Bid</th>
                <th class="cv-table__th cv-table__th--num">Ask</th>
                <th class="cv-table__th cv-table__th--num">Last</th>
                <th class="cv-table__th cv-table__th--num">24h Δ</th>
                <th class="cv-table__th cv-table__th--num">7d Δ</th>
                <th class="cv-table__th cv-table__th--num">Market Cap</th>
                <th class="cv-table__th cv-table__th--num">Updated</th>
              </tr>
            </thead>
            <tbody data-cv-rows-crypto-coingecko>
              {/* rendered by client-side script */}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  {/* ============================================================
       FOOTER : data provenance + cadence + disclaimer.
       ============================================================ */}
  <footer class="cv-foot mono">
    <div class="container cv-foot__inner">
      <p class="cv-foot__line">
        <span class="cv-foot__chip">DATA</span>
        <span>ECB FX (official, daily London fix)</span>
        <span class="cv-foot__sep">·</span>
        <span>Yahoo Finance (delayed quotes)</span>
        <span class="cv-foot__sep">·</span>
        <span>Binance public REST (24hr ticker)</span>
        <span class="cv-foot__sep">·</span>
        <span>CoinGecko REST (markets)</span>
      </p>
      <p class="cv-foot__line">
        <span class="cv-foot__chip">CADENCE</span>
        <span>FX refresh 30s</span>
        <span class="cv-foot__sep">·</span>
        <span>Crypto refresh 15s</span>
        <span class="cv-foot__sep">·</span>
        <span>UTC+8</span>
      </p>
      <p class="cv-foot__disclaimer">
        Rates are for reference only. Not investment advice. Verify any
        value against your counterparty feed before pricing a trade. Quotes
        sourced from the public endpoints above; bid/ask spread for fiat is
        sourced from Yahoo Finance when available, otherwise nominal. No data
        is fabricated; if a row reads <em>UNAVAILABLE</em>, the upstream
        endpoint did not return a value within the refresh window.
      </p>
    </div>
  </footer>

  <CTABanner
    title="Reading this page on a phone?"
    sub="The widget stacks to a single column below 760px and the swap button mirrors the source/target swap on mobile (touch-first). Press R to refresh, S to swap."
    primaryLabel="Read methodology"
    primaryHref={path('/methodology')}
    secondaryLabel="See markets terminal"
    secondaryHref={path('/markets')}
  />

  {/* JSON-LD : WebApplication schema so the converter surfaces as a tool
       in the Knowledge Graph. Keeps the public surface machine-readable
       without leaking any NDA scope. */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'Christian Macion · Live Converter',
      description:
        'Live institutional FX + crypto converter sourced from ECB, Yahoo Finance, Binance, and CoinGecko.',
      url: 'https://christianmacion.github.io/portfolio/converter/',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })}
  />

  {/* ============================================================
       HIDDEN DATA : pass the rate-table row ids to the client-side
       script so the script doesn't have to re-derive them. Kept
       under data-cv-rows to keep the DOM tidy.
       ============================================================ */}
  <script
    type="application/json"
    data-cv-catalog
    set:html={JSON.stringify({ currencies: catalog, rateRows })}
  />
</BaseLayout>

<style>
  /* ============================================================
     HEADER STRIP : chrome contract eyebrow + sync ticker
     ============================================================ */
  .cv-head {
    background: var(--c-tape);
    color: var(--ink-on-tape);
    padding: var(--sp-4) 0 var(--sp-3);
    border-bottom: 1px solid var(--c-rule);
  }
  .cv-head__inner {
    max-width: 1080px;
  }
  .cv-head__tenant {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    align-items: center;
    margin: var(--sp-3) 0 0;
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-tape-2);
    border: 1px solid var(--c-rule);
    font-size: 0.72rem;
    color: var(--c-ink-2);
    letter-spacing: 0.06em;
  }
  .cv-head__chip {
    color: var(--c-amber);
    font-weight: 700;
    background: color-mix(in oklab, var(--c-amber) 14%, transparent);
    padding: 1px 6px;
    border: 1px solid var(--c-amber);
    border-radius: 0;
  }
  .cv-head__chip-sep {
    color: var(--c-ink-3);
    opacity: 0.5;
  }

  /* ============================================================
     HERO : dark editorial, terminal cadence.
     ============================================================ */
  .cv-hero {
    background: var(--c-tape);
    color: var(--ink-on-tape);
    padding-block: clamp(var(--sp-6), 8vh, var(--sp-8));
    border-bottom: 1px solid var(--c-rule);
  }
  .cv-hero__inner {
    max-width: 1080px;
  }
  .cv-hero__title {
    font-size: clamp(1.7rem, 4vw, 2.9rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--c-primary);
    font-weight: 600;
    max-width: 30ch;
    margin: 0 0 var(--sp-4);
  }
  .cv-hero__lead {
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--c-white-soft);
    max-width: 70ch;
  }

  /* ============================================================
     CONVERTER WIDGET : 2 cols + swap button + readouts
     ============================================================ */
  .cv-conv {
    background: var(--c-bg);
    padding-block: var(--sp-7);
    border-bottom: 1px solid var(--c-rule);
  }
  .cv-conv__grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--sp-4);
    align-items: stretch;
  }
  .cv-conv__col {
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    border-radius: 2px;
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .cv-conv__label {
    margin: 0;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--c-ink-3);
    text-transform: uppercase;
  }
  .cv-conv__amount {
    width: 100%;
    padding: var(--sp-3) var(--sp-3);
    font-family: var(--ff-mono);
    font-size: 1.85rem;
    font-weight: 600;
    color: var(--c-amber);
    background: transparent;
    border: 1px solid var(--c-rule);
    border-radius: 0;
    outline: none;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  .cv-conv__amount:focus-visible {
    border-color: var(--c-amber);
    outline: 2px solid var(--c-amber);
    outline-offset: 2px;
  }
  .cv-conv__select {
    width: 100%;
    padding: var(--sp-2) var(--sp-3);
    font-family: var(--ff-mono);
    font-size: 0.78rem;
    color: var(--c-ink);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: 0;
    outline: none;
  }
  .cv-conv__select:focus-visible {
    border-color: var(--c-amber);
    outline: 2px solid var(--c-amber);
    outline-offset: 2px;
  }
  .cv-conv__meta {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: var(--sp-3) 0 0;
    padding: 0;
    font-size: 0.74rem;
  }
  .cv-conv__meta-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 4px 0;
    border-bottom: 1px dashed var(--c-rule);
    color: var(--c-ink-2);
  }
  .cv-conv__meta-row:last-child {
    border-bottom: 0;
  }
  .cv-conv__meta-row dt {
    color: var(--c-ink-3);
    letter-spacing: 0.08em;
  }
  .cv-conv__meta-row dd {
    margin: 0;
    color: var(--c-amber);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  .cv-conv__meta-sub {
    color: var(--c-ink-3);
    font-size: 0.6rem;
  }

  .cv-conv__swap {
    align-self: center;
    width: 52px;
    height: 52px;
    background: transparent;
    border: 1px solid var(--c-rule);
    border-radius: 50%;
    color: var(--c-ink-2);
    font-family: var(--ff-mono);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: color 120ms ease, border-color 120ms ease, background 120ms ease;
  }
  .cv-conv__swap:hover,
  .cv-conv__swap:focus-visible {
    color: var(--c-amber);
    border-color: var(--c-amber);
    background: color-mix(in oklab, var(--c-amber) 8%, transparent);
    outline: none;
  }
  .cv-conv__swap:focus-visible {
    outline: 2px solid var(--c-amber);
    outline-offset: 2px;
  }
  @media (max-width: 760px) {
    .cv-conv__grid {
      grid-template-columns: 1fr;
    }
    .cv-conv__swap {
      transform: rotate(90deg);
      justify-self: center;
      margin: var(--sp-1) 0;
    }
  }

  .cv-conv__readout {
    margin: var(--sp-5) 0 0;
    padding: var(--sp-4);
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    border-left: 3px solid var(--c-amber);
    border-radius: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    font-size: 0.85rem;
  }
  .cv-conv__readout-line {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: baseline;
    color: var(--c-ink-2);
  }
  .cv-conv__readout-label {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: var(--c-ink-3);
    text-transform: uppercase;
    min-width: 80px;
  }
