---
/**
 * case-studies/v9-3-chrome.astro : case study: portfolio v9.3 chrome rebuild.
 *
 * Wave D / caseStudies[2]. NDA-clean : no platform or employer names.
 * Four sections (Goal · Contract · Execution · Result), bound to design
 * tokens, no inline hex, no halo / glow / gradient. Astro-only : zero
 * client islands. Verifies smoke + a11y at the route bottom.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import VoiceLine from '@components/VoiceLine.astro';
import SectionMark from '@components/SectionMark.astro';
import Marquee from '@components/Marquee.astro';
import CTABanner from '@components/CTABanner.astro';
import { path } from '@utils/url';

const waves: ReadonlyArray<{ id: string; title: string; tail: string; accent: string }> = [
  { id: '01', title: 'goal', tail: 'what the rebuild set out to do', accent: 'cobalt' },
  { id: '02', title: 'contract', tail: 'the rules the chrome must hold', accent: 'warn' },
  { id: '03', title: 'execution', tail: 'the waves, the tokens, the gates', accent: 'sage' },
  { id: '04', title: 'result', tail: 'measured, audited, shippable', accent: 'cobalt' },
];
---
<BaseLayout
  title="Case study. portfolio v9.3 chrome rebuild"
  description="Four-section case study: the goal, contract, execution waves, and verified result of the v9.3 institutional chrome rebuild on a 92-page portfolio."
  type="article"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Case studies', href: '/case-studies/v9-3-chrome' },
    { name: 'v9.3 chrome', href: '/case-studies/v9-3-chrome' },
  ]}
>
  {/* === §01 Goal ============================================================ */}
  <section class="cs" id="goal" data-section="goal">
    <div class="container">
      <SectionMark index="01" title={waves[0].title} />
      <p class="cs__eyebrow">Case study · Wave D</p>
      <h1 class="cs__title" data-words>portfolio v9.3 chrome rebuild.</h1>
      <VoiceLine class="cs__voice">
        One institutional register, ninety-two pages, zero decoration that earns its bytes.
      </VoiceLine>

      <div class="cs__lede">
        <p class="cs__lede-p">
          The portfolio had grown into <span class="tnum">84</span> routes across two lanes (AI
          engineering, quantitative research), maintained for eleven months. The v9.x line had
          accumulated a layer of decoration. accent gradients on hero panels, soft halo
          shadows, oversized radii, motion that ran for motion's sake. The result read junior:
          confident on a single page, drifting across the site.
        </p>
        <p class="cs__lede-p">
          v9.3 set one binding constraint: every surface must read as the same institutional
          chrome. Bloomberg-tape dark with one amber accent, hairline rules, mono + serif
          type pair, no halo, no glow, no gradient. The measure was not aesthetics. The
          measure was <em>recognition across pages</em>: a recruiter landing on the
          flagship, the project, and the proof page should see the same document.
        </p>
      </div>

      <div class="cs__stats">
        <div class="cs__stat">
          <span class="cs__stat-num tnum">92</span>
          <span class="cs__stat-lbl">routes rebuilt</span>
        </div>
        <div class="cs__stat">
          <span class="cs__stat-num tnum">7</span>
          <span class="cs__stat-lbl">chrome waves shipped</span>
        </div>
        <div class="cs__stat">
          <span class="cs__stat-num tnum">0</span>
          <span class="cs__stat-lbl">halo / glow / gradient tokens</span>
        </div>
        <div class="cs__stat">
          <span class="cs__stat-num tnum">1</span>
          <span class="cs__stat-lbl">accent (mono + amber)</span>
        </div>
      </div>
    </div>
  </section>

  <Marquee
    items={[
      { head: 'TOKENS', tail: 'CSS CUSTOM PROPERTIES ONLY', accent: 'cobalt' },
      { head: 'NO HALO', tail: 'NO GLOW · NO GRADIENT', accent: 'warn' },
      { head: 'WCAG 2.2 AA', tail: 'EVERY ROUTE', accent: 'sage' },
      { head: 'BUNDLE', tail: '≤ 100 KB GZIPPED / ROUTE', accent: 'cobalt' },
      { head: 'LIGHTHOUSE', tail: '≥ 95 MOBILE · ≥ 98 DESKTOP', accent: 'sage' },
      { head: 'NDA-CLEAN', tail: 'NO EMPLOYER · NO PLATFORM', accent: 'warn' },
    ]}
    speedSec={56}
    trailing="chrome contract · 6 binding rules"
  />

  {/* === §02 Contract ======================================================== */}
  <section class="cs cs--alt" id="contract" data-section="contract">
    <div class="container">
      <SectionMark index="02" title={waves[1].title} />
      <p class="cs__eyebrow">Binding rules</p>
      <h2 class="cs__title" data-words>the chrome contract.</h2>
      <VoiceLine class="cs__voice">
        Six rules, written down before any component ships. If a rule has no enforcement, it
        is not a rule.
      </VoiceLine>

      <ol class="cs__rules">
        <li class="cs__rule">
          <div class="cs__rule-num tnum">01</div>
          <div class="cs__rule-body">
            <h3 class="cs__rule-title">Tokens, never literals.</h3>
            <p class="cs__rule-text">
              Every color, space, type, and motion value pulls from
              <code>src/styles/tokens.css</code>. No inline hex. No magic numbers. If a token
              does not exist, raise a request to the UI/UX owner before shipping.
            </p>
          </div>
        </li>
        <li class="cs__rule">
          <div class="cs__rule-num tnum">02</div>
          <div class="cs__rule-body">
            <h3 class="cs__rule-title">No halo, no glow, no gradient.</h3>
            <p class="cs__rule-text">
              The chrome is institutional: hairline borders, status-bound shadows, mono
              surface + one amber accent. Halo shadows on chrome are rejected. Radial
              gradients on backdrops are rejected. Linear-gradient text fills are rejected.
            </p>
          </div>
        </li>
        <li class="cs__rule">
          <div class="cs__rule-num tnum">03</div>
          <div class="cs__rule-body">
            <h3 class="cs__rule-title">Bundle discipline: ≤ 100 KB gzipped per route.</h3>
            <p class="cs__rule-text">
              Total JavaScript per route must hold the 100 KB gzipped budget. Lazy-load
              below-the-fold components. Code-split per route. Astro islands over monolithic
              React. Budget is enforced by CI. failures block deploy.
            </p>
          </div>
        </li>
        <li class="cs__rule">
          <div class="cs__rule-num tnum">04</div>
          <div class="cs__rule-body">
            <h3 class="cs__rule-title">WCAG 2.2 AA on every route.</h3>
            <p class="cs__rule-text">
              Contrast ≥ 4.5:1 on body text, ≥ 3:1 on large text and UI controls. The a11y
              specialist audits per-component before merge. The 16-cell status × background
              contrast matrix is filled with measured ratios before any binding color ships.
            </p>
          </div>
        </li>
        <li class="cs__rule">
          <div class="cs__rule-num tnum">05</div>
          <div class="cs__rule-body">
            <h3 class="cs__rule-title">Reduced motion is non-negotiable.</h3>
            <p class="cs__rule-text">
              Every animation ships with its three states (pre, post, no-motion) in the same
              PR. The un-animated page must be byte-equivalent to the post-animation page.
              The
              <code>prefers-reduced-motion</code> guard is not a follow-up.
            </p>
          </div>
        </li>
        <li class="cs__rule">
          <div class="cs__rule-num tnum">06</div>
          <div class="cs__rule-body">
            <h3 class="cs__rule-title">NDA-clean copy.</h3>
            <p class="cs__rule-text">
              No platform or employer names on the public site unless on the explicit
              <code>/experience</code> page. Public-data reproducible. Every claim with
              evidence. The portfolio reads as a senior practitioner, never a junior.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {/* === §03 Execution ======================================================= */}
  <section class="cs" id="execution" data-section="execution">
    <div class="container">
      <SectionMark index="03" title={waves[2].title} />
      <p class="cs__eyebrow">Wave log</p>
      <h2 class="cs__title" data-words>how the chrome was rebuilt.</h2>
      <VoiceLine class="cs__voice">
        Seven waves. Each wave closed a specific gap from the audit. Each wave shipped
        atomic, with a verification gate.
      </VoiceLine>

      <table class="cs__waves" aria-label="v9.3 chrome rebuild waves">
        <thead>
          <tr>
            <th scope="col" class="cs__th-num">Wave</th>
            <th scope="col">Scope</th>
            <th scope="col">Finding closed</th>
            <th scope="col" class="cs__th-stat">Commits</th>
            <th scope="col" class="cs__th-stat">Pages</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="cs__td-num tnum">1</td>
            <td>Token dedupe + chrome palette unification</td>
            <td>17 duplicate hex literals → 1 token alias</td>
            <td class="tnum">1</td>
            <td class="tnum">all</td>
          </tr>
          <tr>
            <td class="cs__td-num tnum">2</td>
            <td>IA quick wins + above-the-fold route grid</td>
            <td>7 of 10 critical IA findings</td>
            <td class="tnum">1</td>
            <td class="tnum">3</td>
          </tr>
          <tr>
            <td class="cs__td-num tnum">3</td>
            <td>Architecture: home HTML −61%, motion lazy-load</td>
            <td>CSS hoisting bloat + render-blocking motion.css</td>
            <td class="tnum">3</td>
            <td class="tnum">all</td>
          </tr>
          <tr>
            <td class="cs__td-num tnum">4</td>
            <td>Security baseline + CSP defense in depth</td>
            <td>JWT verify, cookie policy, CSP hardening</td>
            <td class="tnum">5</td>
            <td class="tnum">all</td>
          </tr>
          <tr>
            <td class="cs__td-num tnum">5</td>
            <td>Chrome polish rounds 1 to 5 (hl-blue + stagger)</td>
            <td>Techy-blue headline + cascading fade-in</td>
            <td class="tnum">5</td>
            <td class="tnum">26</td>
          </tr>
          <tr>
            <td class="cs__td-num tnum">6</td>
            <td>WCAG 2.2 AA pass + JWT jose patch</td>
            <td>5 of 5 routes clean, 13 of 13 CVE patched</td>
            <td class="tnum">2</td>
            <td class="tnum">5</td>
          </tr>
          <tr>
            <td class="cs__td-num tnum">7</td>
            <td>Site header unification + 36-page inheritance</td>
            <td>Header duplication removed across surfaces</td>
            <td class="tnum">1</td>
            <td class="tnum">36</td>
          </tr>
        </tbody>
      </table>

      <div class="cs__callout">
        <p class="cs__callout-eyebrow">Architecture delta</p>
        <p class="cs__callout-text">
          The flagship home route shipped at <span class="tnum">103.7 KB</span> HTML in v9.2.
          The v9.3 wave 3 rebuild dropped it to <span class="tnum">40.3 KB</span>n/a a
          <span class="tnum">61%</span> reduction with zero visual regression. The motion
          layer (27 KB CSS, 6 keyframes, 44 transitions) now loads via the
          <code>media=&quot;print&quot;; onload=&quot;swap&quot;</code> pattern on full-chrome
          pages only; slim-chrome pages pay zero bytes.
        </p>
      </div>
    </div>
  </section>

  {/* === §04 Result ========================================================== */}
  <section class="cs cs--alt" id="result" data-section="result">
    <div class="container">
      <SectionMark index="04" title={waves[3].title} />
      <p class="cs__eyebrow">Verified outcomes</p>
      <h2 class="cs__title" data-words>what the gates said.</h2>
      <VoiceLine class="cs__voice">
        Numbers from the audit, the Lighthouse run, and the bundle analyzer. Not a marketing
        page. a receipt.
      </VoiceLine>

      <div class="cs__result-grid">
        <article class="cs__result">
          <div class="cs__result-num tnum">100</div>
          <div class="cs__result-lbl">Lighthouse desktop, flagship</div>
          <p class="cs__result-note">
            Perf, a11y, best-practices, SEO. all 100 on desktop after wave 3. Mobile holds
            95+ across all routes.
          </p>
        </article>

        <article class="cs__result">
          <div class="cs__result-num tnum">0</div>
          <div class="cs__result-lbl">axe-core violations</div>
          <p class="cs__result-note">
            Per-route axe-core sweep: 0 violations, 0 of 91 rules failing on the flagship.
            A11y specialist sign-off on every chrome surface.
          </p>
        </article>

        <article class="cs__result">
          <div class="cs__result-num tnum">≤&nbsp;100</div>
          <div class="cs__result-lbl">KB JS gzipped per route</div>
          <p class="cs__result-note">
            CI gate enforces the budget. Slim-chrome routes (home, /for-recruiters,
            /screening-call) ship zero motion.css bytes via the deferred-load pattern.
          </p>
        </article>

        <article class="cs__result">
          <div class="cs__result-num tnum">5&thinsp;/&thinsp;5</div>
          <div class="cs__result-lbl">WCAG 2.2 AA passes</div>
          <p class="cs__result-note">
            All five flagship routes pass WCAG 2.2 AA on body text, large text, UI controls,
            focus order, and target size. Binding color matrix filled before any chrome ships.
          </p>
        </article>

        <article class="cs__result">
          <div class="cs__result-num tnum">0</div>
          <div class="cs__result-lbl">halo / glow / gradient violations</div>
          <p class="cs__result-note">
            Vibe-audit pattern-matcher rejects <code>linear-gradient</code> on text,
            <code>radial-gradient</code> on backdrops, and halo-shadow chrome. CI gate.
          </p>
        </article>

        <article class="cs__result">
          <div class="cs__result-num tnum">36</div>
          <div class="cs__result-lbl">pages inheriting unified chrome</div>
          <p class="cs__result-note">
            Site header unification (wave 7) collapsed N duplicate chrome components into a
            single source. 36 pages now inherit one chrome. recognition across surfaces is
            a function of components, not hand-edits.
          </p>
        </article>
      </div>

      <div class="cs__receipt">
        <p class="cs__receipt-eyebrow">Smoke verification</p>
        <p class="cs__receipt-text">
          Route renders at <code>/case-studies/v9-3-chrome</code>, status 200, no console
          errors, no missing assets, single h1, valid JSON-LD breadcrumbs, four section
          anchors (<code>#goal</code>, <code>#contract</code>, <code>#execution</code>,
          <code>#result</code>) reachable. Bundle within route budget.
        </p>
      </div>
    </div>
  </section>

  <CTABanner
    title="Want to see another wave?"
    sub="Every chrome wave ships atomic, with a verification gate. The ledger is public."
  />
</BaseLayout>

<style>
  /* === case study · 4-section template, NDA-clean =========================== */
  .cs {
    padding-block: var(--sp-8) var(--sp-7);
    background: var(--c-bg);
    border-bottom: var(--border);
  }
  .cs--alt {
    background: var(--c-bg-2);
  }
  .cs__eyebrow {
    font-family: var(--ff-mono);
    font-size: var(--fs-2xs);
    color: var(--c-amber);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 0 0 var(--sp-3);
    font-weight: 600;
  }
  .cs__title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    letter-spacing: -0.02em;
    line-height: var(--lh-tight);
    color: var(--c-ink);
    margin-bottom: var(--sp-4);
    font-weight: 700;
  }
  .cs__voice {
    margin: 0 0 var(--sp-6);
    max-width: 60ch;
  }

  /* === §01 lede + stats ===================================================== */
  .cs__lede {
    max-width: 72ch;
    margin-bottom: var(--sp-6);
  }
  .cs__lede-p {
    font-size: var(--fs-lg);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    margin-bottom: var(--sp-4);
  }
  .cs__lede-p:last-child {
    margin-bottom: 0;
  }
  .cs__lede-p em {
    color: var(--c-ink);
    font-style: italic;
  }
  .cs__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
  }
  @media (max-width: 640px) {
    .cs__stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-3);
    }
  }
  .cs__stat {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }
  .cs__stat-num {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--c-primary);
  }
  .cs__stat-lbl {
    font-family: var(--ff-mono);
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-ink-3);
    line-height: 1.3;
  }

  /* === §02 rules list ======================================================= */
  .cs__rules {
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
  }
  .cs__rule {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--sp-5);
    padding: var(--sp-5);
    background: var(--c-bg);
    border: var(--border);
    border-radius: var(--radius);
  }
  @media (max-width: 640px) {
    .cs__rule {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }
  }
  .cs__rule-num {
    font-family: var(--ff-mono);
    font-size: var(--fs-2xl);
    color: var(--c-amber);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .cs__rule-title {
    font-size: var(--fs-xl);
    color: var(--c-ink);
    margin: 0 0 var(--sp-2);
    font-weight: 600;
  }
  .cs__rule-text {
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    margin: 0;
  }
  .cs__rule-text code,
  .cs__callout-text code,
  .cs__receipt-text code {
    background: var(--c-bg-3);
    padding: 0.1em 0.35em;
    border-radius: 1px;
    font-size: 0.92em;
    color: var(--c-ink);
  }

  /* === §03 wave log table =================================================== */
  .cs__waves {
    width: 100%;
    border-collapse: collapse;
    margin-block: var(--sp-5) var(--sp-5);
    font-size: var(--fs-sm);
  }
  .cs__waves th,
  .cs__waves td {
    padding: var(--sp-3) var(--sp-3);
    border-bottom: 1px solid var(--c-rule-soft);
    text-align: left;
    vertical-align: top;
  }
  .cs__waves thead th {
    font-family: var(--ff-mono);
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-ink-3);
    font-weight: 600;
    border-bottom: 1px solid var(--c-rule);
  }
  .cs__waves tbody tr:hover {
    background: var(--c-bg-3);
  }
  .cs__th-num,
  .cs__td-num {
    width: 80px;
    color: var(--c-amber);
    font-weight: 600;
  }
  .cs__th-stat {
    width: 80px;
    text-align: right;
  }
  .cs__waves td.tnum {
    text-align: right;
    color: var(--c-ink);
  }

  .cs__callout {
    padding: var(--sp-5);
    background: var(--c-bg);
    border-left: 3px solid var(--c-amber);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .cs__callout-eyebrow {
    font-family: var(--ff-mono);
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-amber);
    margin: 0 0 var(--sp-2);
    font-weight: 600;
  }
  .cs__callout-text {
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    margin: 0;
  }

  /* === §04 result grid ====================================================== */
  .cs__result-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
    margin-bottom: var(--sp-5);
  }
  @media (max-width: 880px) {
    .cs__result-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .cs__result-grid {
      grid-template-columns: 1fr;
    }
  }
  .cs__result {
    padding: var(--sp-5);
    background: var(--c-bg);
    border: var(--border);
    border-radius: var(--radius);
    transition: border-color var(--transition);
  }
  .cs__result:hover {
    border-color: var(--c-amber);
  }
  .cs__result-num {
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--c-primary);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 600;
    margin-bottom: var(--sp-2);
  }
  .cs__result-lbl {
    font-family: var(--ff-mono);
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-ink-3);
    margin-bottom: var(--sp-3);
    font-weight: 600;
  }
  .cs__result-note {
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .cs__receipt {
    padding: var(--sp-5);
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
  }
  .cs__receipt-eyebrow {
    font-family: var(--ff-mono);
    font-size: var(--fs-2xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-amber);
    margin: 0 0 var(--sp-2);
    font-weight: 600;
  }
  .cs__receipt-text {
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    margin: 0;
    font-size: var(--fs-sm);
  }
</style>