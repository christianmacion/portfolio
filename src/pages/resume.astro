---
/**
 * resume.astro — v3: 4 tailored resumes · 11 download targets. The flagship
 * single-page Senior QR + AI Engineer resume (Letter + A4) leads; the 3
 * tailored variants (PDF / MD / TXT each) remain as alternatives.
 *
 * Hero equation: which resume = argmax over JD fit.
 *
 * Per variant, format surface:
 *   - Flagship  → 2 × PDF (Letter + A4)
 *   - Tailored  → 3 formats (PDF + MD + TXT)
 *   - AI-only   → 3 formats (PDF + MD + TXT)
 *   - Quant-1P  → 3 formats (PDF + MD + TXT)
 *
 * Generated by:
 *   - scripts/build-resumes.mjs     → PDFs  (calls the OJP/Upwork python-docx builder)
 *   - scripts/build-resumes-md.mjs  → MD + TXT
 *   - public/resume.pdf + resume-a4.pdf (flagship, pre-rendered by resume-ship mission)
 *
 * v6.13.2 — resume-ship 2026-07-31 flagship added. A 1-page Senior QR +
 * AI Engineer distillation anchored in the 8-corpus doctrine stack,
 * rendered both as Letter (US standard 8.5×11") and A4 (international
 * 210×297mm). HIRED-FlowCV V4 register: 4-prose SUMMARY + 28-bullet
 * CORE SKILLS grid + single-column EXPERIENCE + 5-group CERTIFICATIONS
 * led by Tier-1 issuers. Built to pass public_facing_educator's NDA
 * scrub + portfolio-positioning-level gate. Sits at the top of the
 * resume grid as the recommended primary; the 3 tailored variants
 * remain below as alternatives.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Equation from '@components/Equation.astro';
import Stat from '@components/Stat.astro';
import { path } from '@utils/url';
import VoiceLine from '@components/VoiceLine.astro';
import { countProjectsByRole } from '@utils/project-helpers';

const quantProjectCount = await countProjectsByRole('quant');

const resumes = [
  // v6.13.2 — flagship single-page Senior QR + AI Engineer resume.
  // Rendered both Letter (US standard) and A4 (international) — same
  // content, two page sizes. The flagship is the new primary surface;
  // the 3 tailored variants below remain as alternatives for JDs that
  // need a longer or more lane-specific narrative.
  {
    label: 'Flagship · Senior QR + AI Engineer (1-page)',
    blurb:
      'Refined 1-page distillation anchored in the 8-corpus doctrine stack. Senior QR + AI Engineer register. Built for the JD that asks for both. HIRED-FlowCV V4 layout: 4-prose SUMMARY + 28-bullet CORE SKILLS grid + single-column EXPERIENCE + 5-group CERTIFICATIONS led by Tier-1 issuers.',
    primary: true,
    pages: '1 page',
    slug: 'flagship',
    formats: [
      {
        kind: 'pdf',
        file: path('/resume.pdf'),
        label: 'Letter PDF',
        note: 'US · 8.5 × 11" · 1 page',
      },
      {
        kind: 'pdf',
        file: path('/resume-a4.pdf'),
        label: 'A4 PDF',
        note: 'international · 210 × 297mm',
      },
    ],
  },
  {
    label: 'Unified · AI Engineer + Quant Researcher',
    blurb:
      'The single-pane view: covers both lanes simultaneously. Best for recruiters hiring for a combined seat or undecided between the two.',
    pages: '4 pages',
    slug: 'tailored',
    formats: [
      {
        kind: 'pdf',
        file: path('/resume-tailored.pdf'),
        label: 'PDF',
        note: 'visual · brand-faithful',
      },
      {
        kind: 'md',
        file: path('/resume-tailored.md'),
        label: 'MD',
        note: 'LLM-agent · llms.txt ingest',
      },
      {
        kind: 'txt',
        file: path('/resume-tailored.txt'),
        label: 'TXT',
        note: 'Workday · Greenhouse · Taleo',
      },
    ],
  },
  {
    label: 'AI Engineer Lane',
    blurb:
      'AI Engineer emphasis: multi-agent LLM systems, eval harnesses, MCP servers, and the projects that prove them.',
    pages: '4 pages',
    slug: 'ai-only',
    formats: [
      {
        kind: 'pdf',
        file: path('/resume-ai-only.pdf'),
        label: 'PDF',
        note: 'visual · brand-faithful',
      },
      {
        kind: 'md',
        file: path('/resume-ai-only.md'),
        label: 'MD',
        note: 'LLM-agent · llms.txt ingest',
      },
      {
        kind: 'txt',
        file: path('/resume-ai-only.txt'),
        label: 'TXT',
        note: 'Workday · Greenhouse · Taleo',
      },
    ],
  },
  {
    label: 'Quant Researcher Lane (one-pager)',
    blurb: `Quantitative Researcher emphasis: ${quantProjectCount} public-data projects with real headline metrics, plus the methodology that ties them together.`,
    pages: '1 page',
    slug: 'quant-onepage',
    formats: [
      {
        kind: 'pdf',
        file: path('/resume-quant-onepage.pdf'),
        label: 'PDF',
        note: 'visual · brand-faithful',
      },
      {
        kind: 'md',
        file: path('/resume-quant-onepage.md'),
        label: 'MD',
        note: 'LLM-agent · llms.txt ingest',
      },
      {
        kind: 'txt',
        file: path('/resume-quant-onepage.txt'),
        label: 'TXT',
        note: 'Workday · Greenhouse · Taleo',
      },
    ],
  },
];

// v6.10.35 — derive counts from resumes array; format count uniform across all
// v6.13.2 — flagship has 2 PDF formats (Letter + A4); others have 3 (PDF/MD/TXT).
// Compute formatCount as the union of unique format kinds across all resumes,
// and downloadCount as the sum of all format links.
const resumeCount = resumes.length;
const allFormatKinds = new Set<string>();
let downloadCount = 0;
for (const r of resumes) {
  for (const f of r.formats) {
    allFormatKinds.add(f.kind);
    downloadCount += 1;
  }
}
const formatCount = allFormatKinds.size;
---

<BaseLayout
  title="Resume"
  description={`${resumeCount} tailored resumes × ${formatCount} formats (PDF / Markdown / plain text). NDA-safe, public-data reproducible, ATS-friendly.`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Resume', href: '/resume' },
  ]}
>
  <header class="page-head">
    <div class="container">
      <p class="page-head__eyebrow mono">
        <span class="page-head__eyebrow-chip">RESUME · {resumeCount} VERSIONS · {downloadCount} DOWNLOADS</span>
        <span class="page-head__eyebrow-line">FLAGSIP SENIOR QR + AI ENGINEER · NDA-SAFE · ATS-FRIENDLY</span>
      </p>
      <h1 class="page-head__title" data-words>
        {resumeCount} tailored resumes. <span class="hl">One flagship.</span>
      </h1>
      <VoiceLine class="page-head__voice">
        Same person, four shapes. Flagship first; the three tailored variants cover
        longer-form lane-by-lane cases.
      </VoiceLine>
      <p class="page-head__sub">
        Pick the version that matches the role you're hiring for. The flagship is a refined 1-page
        Senior QR + AI Engineer distillation in two page sizes (Letter + A4). The three tailored
        variants ship in three formats each — PDF for human reviewers, Markdown for LLM-based
        recruiter agents, plain text for Workday-classic / Greenhouse / Taleo ATS pipelines. All
        four are NDA-safe, free of proprietary data sources, and reference only public-data
        methodology or open-source work.
      </p>

      <div class="head-eq">
        <Equation
          block
          latex={`\\text{resume}^{\\star} = \\arg\\max_{r \\in R} \\; \\text{fit}(r, \\text{JD}) \\quad \\text{where} \\quad R = \\{R_{\\text{unified}}, R_{\\text{AI}}, R_{\\text{Quant}}\\}`}
          size="md"
        />
      </div>

      <div class="head-stats">
        <Stat value={String(resumeCount)} label="tailored" sub="resumes" />
        <Stat value={String(downloadCount)} label="downloads" sub="PDF · MD · TXT" />
        <Stat value="100%" label="NDA-safe" sub="by construction" />
        <Stat value={String(quantProjectCount)} label="quant proj" sub="public-data" />
      </div>

      <p class="page-head__tenant mono">
        <span>CHRISTIAN.T.MACION</span>
        <span aria-hidden="true">·</span>
        <span>HIRED-FLOWCV V4</span>
        <span aria-hidden="true">·</span>
        <span>1-PAGE / 4-PAGE</span>
        <span aria-hidden="true">·</span>
        <span>PDF · MD · TXT</span>
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="resume-grid">
        {
          resumes.map((r) => (
            <article class:list={['resume-card', { 'resume-card--primary': r.primary }]}>
              <div class="resume-card__head">
                <div class="resume-card__label">{r.label}</div>
                <span class="pill pill--brand">{r.pages}</span>
              </div>
              <div class="resume-card__blurb">{r.blurb}</div>
              <ul class="resume-card__formats">
                {r.formats.map((f) => (
                  <li class="format">
                    <a class="format__link" href={f.file} download>
                      <span class="format__kind">{f.label}</span>
                      <span class="format__note">{f.note}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <aside class="resume-note">
        <h3 class="resume-note__title">If you'd rather a different shape</h3>
        <p>
          I keep a <strong>bullet-bank resume materials</strong> package (~80 bullet variants) for tailored
          one-pagers per JD. Email me the JD and I'll send back a tailored version within 24 hours.
        </p>
        <p class="resume-note__mono">
          Built with the same HIRED-FlowCV builder used for OnlineJobs.ph and Upwork applications —
          ATS-safe, single-column, no tables-for-layout. Source JSONs live in
          <code>scripts/resumes/</code>; PDFs regenerate via <code>npm run resumes:build</code>, MD
          + TXT via <code>npm run resumes:build:md</code>.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--sp-9) var(--sp-7);
    background: var(--c-paper);
    border-bottom: var(--border);
  }
  .page-head__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    flex-wrap: wrap;
  }
  .page-head__eyebrow-chip {
    display: inline-block;
    padding: 4px 10px;
    /* v9.2 a11y — was --c-phi-teal. Dark theme --j-phi-teal = #2d5f5a
     only hits 2.14:1 on dark page-head surface. Solid amber chip +
     --c-bg text reads at ≥5.6:1 in both themes — institutional
     register, F14-safe (no traffic-light). */
    color: var(--c-bg);
    border: 1px solid var(--c-amber);
    background: var(--c-amber);
    font-weight: 600;
  }
  .page-head__eyebrow-line {
    color: var(--c-warn);
    font-weight: 600;
  }
  .page-head__tenant {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-4) 0 0;
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    font-size: 0.78rem;
    color: var(--c-ink-2);
    letter-spacing: 0.06em;
  }
  .page-head__tenant span:nth-child(odd) {
    color: var(--c-warn);
    font-weight: 600;
  }
  .page-head__title {
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-3);
  }
  .page-head__sub {
    font-size: var(--fs-lg);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    max-width: 64ch;
    margin-bottom: var(--sp-6);
  }
  .page-head__voice {
    margin: 0 0 var(--sp-5);
    max-width: 60ch;
  }
  .head-eq {
    padding: var(--sp-4) var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    margin-bottom: var(--sp-5);
    overflow-x: auto;
  }
  .head-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-3);
  }
  .resume-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--sp-5);
    margin-bottom: var(--sp-7);
  }
  .resume-card {
    display: flex;
    flex-direction: column;
    padding: var(--sp-5);
    background: var(--c-bg);
    border: var(--border);
    border-radius: var(--radius);
    color: var(--c-ink);
    transition:
      border-color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }
  .resume-card:hover {
    border-color: var(--c-primary);
    box-shadow: var(--shadow-md);
  }
  /* v6.10.33 — institutional: drop the F13-era amber gradient (rgba 212,160,23 stale).
     Lift via --c-bg-2 token; primary border remains to signal the hero variant. */
  .resume-card--primary {
    border-color: var(--c-primary);
    background: var(--c-bg-2);
  }
  .resume-card__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
  }
  .resume-card__label {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--c-primary);
    line-height: 1.3;
  }
  .resume-card__blurb {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    margin-bottom: var(--sp-4);
    flex: 1;
  }
  .resume-card__formats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-2);
    border-top: 1px solid var(--c-rule-soft);
    padding-top: var(--sp-3);
  }
  .format__link {
    display: grid;
    grid-template-columns: minmax(96px, auto) 1fr;
    align-items: baseline;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule-soft);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--c-ink);
    transition:
      border-color var(--transition),
      background var(--transition);
  }
  .format__link:hover {
    border-color: var(--c-primary);
    background: var(--c-bg);
    color: var(--c-ink);
  }
  .format__kind {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--c-primary);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .format__note {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: 1.4;
  }
  .resume-note {
    padding: var(--sp-5);
    background: var(--c-bg-2);
    border-left: 3px solid var(--c-amber);
    border-radius: 0 var(--radius) var(--radius) 0;
    max-width: 760px;
  }
  .resume-note__title {
    font-size: var(--fs-lg);
    color: var(--c-primary);
    margin-bottom: var(--sp-2);
  }
  .resume-note p {
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
  }
  .resume-note p + p {
    margin-top: var(--sp-3);
  }
  .resume-note__mono {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
  }
  .resume-note__mono code {
    font-family: var(--font-mono);
    background: var(--c-bg-2);
    padding: 1px 5px;
    border-radius: 3px;
    color: var(--c-primary);
  }
  .resume-note strong {
    color: var(--c-ink);
    font-weight: 600;
  }

  @media (max-width: 880px) {
    .head-stats {
      grid-template-columns: 1fr 1fr;
    }
    .resume-card__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .format__link {
      grid-template-columns: minmax(80px, auto) 1fr;
    }
  }
</style>
