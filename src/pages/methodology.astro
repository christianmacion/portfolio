---
/**
 * methodology.astro : the eval-first philosophy, G1-G31 gate stack, model-routing policy,
 * agent charter pattern. Spell out the *method*, not just the outputs.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Equation from '@components/Equation.astro';
import GatesLattice from '@components/GatesLattice.astro';
import DSRCalculator from '@components/DSRCalculator.astro';
import SectionTOC from '@components/SectionTOC.astro';
import PipelineDiagram from '@components/PipelineDiagram.astro';
import ChromeHeader from '@components/ChromeHeader.astro';
import { path } from '@utils/url';
import VoiceLine from '@components/VoiceLine.astro';
import SectionMark from '@components/SectionMark.astro';
import AIHistoryTimeline from '@components/AIHistoryTimeline.astro';
import { profile } from '@utils/profile';

// Gate-count chrome: derives from profile.stats.evalGates. Used in
// SectionTOC label, data-toc-label, headline H2, voice sub line,
// and other "G1-G31" references on this page.
const GATE_RANGE = `G1 to G${profile.stats.evalGates}`;

const gates = [
  {
    range: 'G1 to G5',
    name: 'Mechanical validity',
    desc: 'Schema conformance, exit-0 contract, structured output parse, JSON Schema strict-mode, byte-length budget.',
  },
  {
    range: 'G6 to G10',
    name: 'Statistical nulls',
    desc: `<a href="${path('/glossary/block-bootstrap')}">block-bootstrap</a> CIs, random-timing nulls, <a href="${path('/glossary/regime')}">regime</a>-shuffle, parameter-prior sensitivity, Monte-Carlo coverage.`,
  },
  {
    range: 'G11 to G15',
    name: 'Walk-forward & OOS',
    desc: `Locked <a href="${path('/glossary/oos')}">OOS</a> windows, 5-era stability, expanding/rolling <a href="${path('/glossary/walk-forward')}">walk-forward</a> windows, frozen-spec evaluation, <a href="${path('/glossary/embargo')}">embargoed</a> test set.`,
  },
  {
    range: 'G16 to G20',
    name: 'Multiple testing',
    desc: `<a href="${path('/glossary/deflated-sharpe')}">Deflated Sharpe Ratio</a> (DSR), <a href="${path('/glossary/cscv-pbo')}">CSCV-based Probability of Backtest Overfit</a> (PBO), <a href="${path('/glossary/minbtl')}">Minimum Backtest Length</a> (MinBTL), <a href="${path('/glossary/bonferroni-holm')}">Bonferroni-Holm</a>, BH-FDR.`,
  },
  {
    range: 'G21 to G25',
    name: 'Look-ahead discipline',
    desc: `Point-in-time dataset verification, <a href="${path('/glossary/survivorship-bias')}">survivorship-bias</a> check, rebalance-vs-signal timing, frozen-spec, no-leakage to scoring.`,
  },
  {
    range: 'G26 to G31',
    name: 'Economic & cost realism',
    desc: `Spread/<a href="${path('/glossary/slippage')}">slippage</a>/latency per asset class, capacity-constraint report, funding-carry, borrow cost, vol-targeted sizing, <a href="${path('/glossary/regime')}">regime</a> overlay.`,
  },
];

const routing = [
  {
    tier: 'Opus',
    role: 'judgment / hardest autonomous decisions',
    ratio: '~1 dispatch per analysis chain',
  },
  {
    tier: 'Sonnet',
    role: 'assembly / structured generation',
    ratio: '~3 to 5 dispatches per chain',
  },
  {
    tier: 'Haiku',
    role: 'mechanical / fast deterministic steps',
    ratio: '~10 to 30 dispatches per chain',
  },
  { tier: 'Fable', role: 'long-horizon autonomous research', ratio: 'one off, overnight' },
];

const charter = [
  { tag: 'role', value: 'A specific function, never generic "AI assistant"' },
  { tag: 'inputs', value: 'Typed input contract (JSON Schema, fail-closed)' },
  { tag: 'outputs', value: 'Typed output contract with strict validation' },
  { tag: 'handoffs', value: 'What this agent must NOT do (anti-charter)' },
  { tag: 'gates', value: `Which of ${GATE_RANGE} apply, with exit codes` },
  { tag: 'evidence', value: 'What the agent must attach as proof' },
];
---

<BaseLayout
  title="Methodology"
  description={`The eval-first discipline. ${GATE_RANGE} statistical gate stack. Model-routing policy. Agent charter pattern.`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Methodology', href: '/methodology' },
  ]}
  extraJsonLd={{
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to ship what has passed a G1 to G31 statistical gate',
    description:
      'The eval-first discipline: every shipped primitive passes through 31 statistical gates covering mechanical validity, statistical significance, robustness, and economic validity.',
    step: [
      {
        '@type': 'HowToStep',
        name: 'Frame the primitive',
        text: 'Define the loop as a finite-state machine with terminal state, idempotent write, dedupe key, coverage filter, and AAR.',
      },
      {
        '@type': 'HowToStep',
        name: 'Run G1 to G7 pre-flight',
        text: 'Mechanical-validity checks (fire-unit n, screen unit-of-analysis, joint-set sizing, regime-sign, n-aware t-stat floor, source-shift sanity, live-book overlap).',
      },
      {
        '@type': 'HowToStep',
        name: 'Run G8 to G31 full stack',
        text: 'Statistical-significance, robustness, and economic-validity gates including walk-forward, block-bootstrap, deflated Sharpe, Monte Carlo ruin probability, and regime-conditional deployment.',
      },
      {
        '@type': 'HowToStep',
        name: 'Write the AAR',
        text: 'One-page After-Action Report at ~/.claude/cache/corporate/aars/<id>.md with goal, decomposition, cost, critique, and doctrine reflection.',
      },
      {
        '@type': 'HowToStep',
        name: 'Ship or kill',
        text: 'Verdict derives from gates. PASS → ship. FAIL → kill or iterate with documented scope. No in-between.',
      },
    ],
    author: {
      '@type': 'Person',
      name: profile.fullName,
      url: 'https://christianmacion-portfolio.pages.dev/',
    },
    publisher: {
      '@type': 'WebSite',
      name: 'Christian T. Macion Portfolio',
      url: 'https://christianmacion-portfolio.pages.dev/',
    },
  }}
>
  <header class="method-head">
    <div class="container">
      <ChromeHeader
        chip="METHODOLOGY · EVAL-FIRST DISCIPLINE"
        eyebrow={`${GATE_RANGE} GATE STACK · MODEL-ROUTING · AGENT CHARTER`}
        tenant={`CHRISTIAN.T.MACION · UTC+8 · ${profile.stats.evalGates}-GATE EVAL · OWNER-VERIFIED`}
        noSep
        hideTenet
      />
      <h1 class="method-head__title" data-words>
        Don’t ship what hasn’t passed a <span class="hl">measurable gate</span>.
      </h1>
      <VoiceLine class="method-head__voice">
        Five stages. Each kills 70%+ of the work. Same gate stack rates systematic strategies and
        LLM outputs.
      </VoiceLine>

      <ul class="method-head__pipeline">
        <li>
          <strong>Regime.</strong> Classify market state. Trend / range / vol regime before any signal.
        </li>
        <li><strong>Pre-flight.</strong> Mechanical validity. Schema, parse, dedupe, exit-0.</li>
        <li>
          <strong>Research.</strong> Walk-forward, deflated Sharpe, block-bootstrap, orthogonality.
        </li>
        <li><strong>Backtest.</strong> OOS, regime conditioning, Monte-Carlo ruin probability.</li>
        <li><strong>Scribe.</strong> One-page memo + kill log. Verdict derives from gates.</li>
      </ul>

      <!-- v13.1 (2026-08-09, positioning brief): 39-word intro paragraph.
           Two sentences. The 31 gates listed by family. Cross-domain
           claim: same gate IDs mean the same thing whether the artifact
           is a trading strategy or an LLM output. -->
      <p class="method-head__intro mono">
        Every shipped primitive passes through 31 gates: mechanical validity, statistical nulls,
        walk-forward OOS, multiple testing, look-ahead discipline, economic and cost realism. Same
        gate IDs mean the same thing whether the artifact is a trading strategy or an LLM output.
      </p>

      <div class="method-head__eq-block">
        <Equation
          block
          size="lg"
          latex={`\\Pr(\\text{ship}) \\;=\\; \\Pr(\\text{ship} \\mid \\text{passes G1--G${profile.stats.evalGates}}) \\cdot \\prod_{i=1}^{${profile.stats.evalGates}} \\Pr(G_i \\mid \\text{evidence}_i)`}
        />
      </div>
    </div>
  </header>

  <SectionTOC
    label="On this methodology page"
    items={[
      { id: 'gates', label: `${GATE_RANGE} gate stack` },
      { id: 'routing', label: 'Model routing' },
      { id: 'dsr', label: 'DSR calculator' },
      { id: 'charter', label: 'Agent charter' },
    ]}
  />

  <section
    class="section"
    data-toc-id="gates"
    data-toc-label={`${GATE_RANGE} gate stack`}
    data-section-id="methodology"
  >
    <div class="container">
      <header class="section__head">
        <SectionMark index="00" title="methodology" />
        <p class="section__eyebrow">The gate stack</p>
        <h2 class="section__title" id="gates">{GATE_RANGE}. Six families. One contract.</h2>
        <p class="section__sub">
          Every candidate (LLM output, systematic strategy, content artifact) passes through the
          same gate stack. Gates are mechanical (exit-0 contract), not opinionated. A pass means the
          candidate is allowed to surface; a fail means it isn't. Gate IDs are load-bearing: a "G16"
          means the same thing across the corpus.
        </p>
      </header>

      <div class="gates" role="table" aria-label={`${GATE_RANGE} gate stack: six families`}>
        <div class="gates__row gates__row--head" role="row">
          <span class="gates__cell gates__cell--range mono" role="columnheader">Gate ID</span>
          <span class="gates__cell gates__cell--name" role="columnheader">Family</span>
          <span class="gates__cell gates__cell--desc" role="columnheader">What it checks</span>
        </div>
        {
          gates.map((g, i) => (
            <div class="gates__row" id={`family-${i + 1}`} role="row">
              <span class="gates__cell gates__cell--range mono" role="cell">
                {g.range}
              </span>
              <span class="gates__cell gates__cell--name" role="cell">
                {g.name}
              </span>
              <p class="gates__cell gates__cell--desc" role="cell" set:html={g.desc} />
            </div>
          ))
        }
      </div>

      {/* v13.1.4 polish-7ae : per-section metadata. Same register as
          /positions/ `.positions-card__meta` (polish-7z commit ec1674b)
          and /contact/ `.contact-card__meta` (polish-7x commit 19aa5ef). */}
      <div class="method-meta mono">
        PUBLISHED · since 2024-09 · related:
        <a href={path('/glossary/')}>related glossary surface →</a>
        · commit <code>72f8528</code>
      </div>

      {
        /* v11.W3 : 31-cell lattice visualisation wired to theatre.js.
           Sits below the 6-row summary as a deeper view of every
           individual gate. W4 will replace this with the interactive
           data-viz (per-cell hover + click-through to glossary). */
      }
      <GatesLattice />
    </div>
  </section>

  {
    /* v12.W4 : AI HISTORY TIMELINE mounted as evidence of trend-tracking.
      The methodology isn't a static document :  it tracks the AI arc in
      real time. The 31-gate stack was assembled on the HARNESS + LOOPS
      rungs and the GRAPHS rung is now wiring multi-agent orchestration
      into the gate tests. Renders as a vertical stack on this page to
      fit the reading rhythm. */
  }
  <section class="section section--trend" data-section-id="methodology">
    <div class="container container-wide">
      <SectionMark index="01" title="trend arc" ariaHidden={false} />
      <p class="section__eyebrow">Why the gate stack tracks the curve</p>
      <h2 class="section__title">The methodology is not a static document.</h2>
      <p class="section__sub">
        Each rung of the AI arc changed how the gate stack is wired. PROMPTS gave the eval family;
        SKILLS gave the structured-output contract; AGENTS gave the run-loop schema; HARNESS gave
        the sandbox; LOOPS gave the AAR pattern; GRAPHS gave the shared-memory graph that connects
        every gate test to every shipped artefact. OFFICES is where the gate stack now runs: 14
        squads, 112 agents, every gate test attached to a graph node. Below: the dated record of
        adoption versus mainstream emergence.
      </p>

      <AIHistoryTimeline
        variant="stack"
        chip="AI · HISTORY · METHODOLOGY EVIDENCE"
        title="Six rungs that built this gate stack."
        lede="The methodology is wired rung-by-rung. Each architectural jump maps to a gate family on this page."
      />

      {/* v13.1.4 polish-7ae : per-section metadata. Same register as
          /positions/ `.positions-card__meta` (polish-7z commit ec1674b). */}
      <div class="method-meta mono">
        PUBLISHED · since 2025-12 · related:
        <a href={path('/timeline')}>related timeline surface →</a>
        · commit <code>7611669</code>
      </div>

      <p class="section__foot mono">
        <a href={path('/timeline')}>Full timeline →</a>
      </p>
    </div>
  </section>

  <section
    class="section section--alt"
    data-toc-id="routing"
    data-toc-label="Model routing"
    data-section-id="methodology"
  >
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Model routing</p>
        <h2 class="section__title" id="routing">Tiered dispatch, not single-agent.</h2>
        <p class="section__sub">
          A multi-agent system runs at ~15× the token cost of a single agent. Route by what the step
          needs to compute, not by default. Every dispatch has a per-step budget.
        </p>
      </header>

      <div class="routing">
        {
          routing.map((r) => (
            <div class="route">
              <div class="route__tier mono">{r.tier}</div>
              <div class="route__role">{r.role}</div>
              <div class="route__ratio mono">{r.ratio}</div>
            </div>
          ))
        }
      </div>

      <div class="routing-eq">
        <Equation
          latex={`\\text{cost} = \\sum_{i} \\text{tokens}(i) \\cdot \\text{price}(\\text{tier}(i)) \\quad \\text{where} \\quad \\text{tier} : \\mathcal{A} \\to \\{\\text{Opus, Sonnet, Haiku, Fable}\\}`}
        />
      </div>

      <div
        class="routing-pipeline"
        aria-label="End-to-end pipeline from intent to deliverable with feedback loop"
      >
        <p class="routing-pipeline__cap mono">end-to-end pipeline · every project</p>
        <PipelineDiagram
          tone="paper"
          steps={[
            { num: '01', title: 'Intent', desc: 'problem statement + success metric + NDA audit' },
            { num: '02', title: 'Frame', desc: 'frozen spec · eval harness drafted before code' },
            { num: '03', title: 'Build', desc: 'tier-routed agents · cost-capped per step' },
            { num: '04', title: 'Verify', desc: `gate stack ${GATE_RANGE} · exit-0 contract` },
            {
              num: '05',
              title: 'Deliver',
              desc: 'public repo or live paper-trade · published only if all pass',
            },
          ]}
        />
      </div>

      {/* v13.1.4 polish-7ae : per-section metadata. Same register as
          /positions/ `.positions-card__meta` (polish-7z commit ec1674b). */}
      <div class="method-meta mono">
        PUBLISHED · since 2024-09 · related:
        <a href={path('/projects/')}>related projects surface →</a>
        · commit <code>7611669</code>
      </div>
    </div>
  </section>

  <section
    class="section"
    data-toc-id="dsr"
    data-toc-label="DSR calculator"
    data-section-id="methodology"
  >
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Interactive · G16</p>
        <h2 class="section__title" id="dsr">
          Try the <a href={path('/glossary/deflated-sharpe')}>deflated Sharpe</a> calculator.
        </h2>
        <p class="section__sub">
          Same in-sample <a href={path('/glossary/sharpe')}>Sharpe</a>, different DSR, depending on
          how many strategies you tried. This is the gate that turns "1.14 looks great" into
          <a href={path('/glossary/deflated-sharpe')}>"DSR 0.70, fail."</a>
        </p>
      </header>

      <DSRCalculator />

      {/* v13.1.4 polish-7ae : per-section metadata. Same register as
          /positions/ `.positions-card__meta` (polish-7z commit ec1674b). */}
      <div class="method-meta mono">
        PUBLISHED · since 2024-09 · related:
        <a href={path('/glossary/deflated-sharpe')}>related glossary surface →</a>
        · commit <code>7611669</code>
      </div>
    </div>
  </section>

  <section
    class="section"
    data-toc-id="charter"
    data-toc-label="Agent charter"
    data-section-id="methodology"
  >
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Agent charter</p>
        <h2 class="section__title" id="charter">{charter.length} required fields per agent.</h2>
        <p class="section__sub">
          A charter is a contract, not a prompt. Same six fields, same semantics, every agent. No
          exceptions.
        </p>
      </header>

      <div class="charter">
        {
          charter.map((c) => (
            <div class="charter__row">
              <div class="charter__tag mono">{c.tag}</div>
              <div class="charter__val">{c.value}</div>
            </div>
          ))
        }
      </div>

      {/* v13.1.4 polish-7ae : per-section metadata. Same register as
          /positions/ `.positions-card__meta` (polish-7z commit ec1674b). */}
      <div class="method-meta mono">
        PUBLISHED · since 2024-09 · related:
        <a href={path('/work/')}>related work surface →</a>
        · commit <code>7611669</code>
      </div>
    </div>
  </section>

  <section class="section section--alt" data-section-id="methodology">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Related pages</p>
        <h2 class="section__title">Where the rest of the method lives.</h2>
        <p class="section__sub">
          This page owns the gate stack, model routing, and the agent charter. The incident log
          (where the gate stack caught a real bug) lives on
          <a href={path('/mistakes')}>/mistakes</a>. The first-90-days plan for a new QR seat is on
          <a href={path('/for-recruiters')}>/for-recruiters</a>. The implementation record (repos,
          licenses, verification dates) lives on <a href={path('/colophon')}>/colophon</a>.
        </p>
      </header>

      {/* v13.1.4 polish-7ae : per-section metadata. Same register as
          /positions/ `.positions-card__meta` (polish-7z commit ec1674b). */}
      <div class="method-meta mono">
        STABLE · since 2024-09 · related:
        <a href={path('/for-recruiters/')}>related recruiter surface →</a>
        · commit <code>9003283</code>
      </div>
    </div>
  </section>

  {/* v13.1.4 polish-7ae : recency stamp at bottom. Same register as
      /positions/ `.positions-recency` (polish-7z commit ec1674b)
      and /contact/ `.contact-recency` (polish-7x commit 19aa5ef). */}
  <p class="method-recency mono">
    Last updated: 2026-08-11 · commit
    <a href="https://github.com/christianmacion/christianmacion.github.io/commit/72f8528"
      ><code>72f8528</code></a
    >
  </p>
</BaseLayout>

<style is:global>
  /* v13.1.4 polish-7n : gate-stack summary table. Re-introduced because
     the previous scoped <style> block was removed at v12.W4. Without
     these rules the table layout falls back to browser defaults and
     inline glossary links miss WCAG 2.5.5 (≥44×44 px).

     is:global: required because the gates table body is rendered via
     `set:html={g.desc}` — Astro scoped styles do not apply to raw
     HTML injected that way. Without is:global the rules below would
     compile to `.gates__cell--desc[data-astro-cid-XXX]` and miss the
     cells entirely (they have no cid attribute). */

  .gates {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--c-rule);
  }

  .gates__row {
    display: grid;
    grid-template-columns: minmax(120px, 18%) minmax(160px, 22%) 1fr;
    gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--c-rule-soft);
    align-items: baseline;
  }

  .gates__row--head {
    background: var(--c-bg-2);
    padding: var(--sp-2) var(--sp-4);
  }

  .gates__row:hover:not(.gates__row--head) {
    background: var(--c-bg-2);
  }

  .gates__cell {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-loose);
  }

  .gates__cell--range {
    font-weight: 600;
    color: var(--c-ink);
    letter-spacing: 0.02em;
  }

  .gates__row--head .gates__cell--range {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .gates__cell--name {
    color: var(--c-ink);
    font-weight: 600;
  }

  .gates__row--head .gates__cell--name {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .gates__cell--desc {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    margin: 0;
  }

  .gates__row--head .gates__cell--desc {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* v13.1.4 polish-7n : inline glossary links. M1 medium fix — the
     <a> inside a paragraph inherits the paragraph's line-height (~44px)
     so the hit-area is tall but the visible glyph is narrow, failing
     WCAG 2.5.5 on the width dimension. `display: inline-flex` with
     `align-items: center` plus `min-width: 44px` / `min-height: 44px`
     expands the hit-area to the WCAG 2.5.5 minimum without changing
     the visual chrome (no halo, no glow, no rounded chrome). `line-height: 1`
     keeps the glyph vertically centered inside the 44px box. */
  .gates__cell--desc a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 8px;
    line-height: 1;
    color: var(--c-primary);
    text-decoration: underline;
    text-decoration-color: var(--c-rule-strong);
    text-underline-offset: 3px;
  }

  .gates__cell--desc a:hover,
  .gates__cell--desc a:focus-visible {
    color: var(--c-amber);
    text-decoration-color: var(--c-amber);
  }

  .gates__cell--desc a:focus-visible {
    outline: 2px solid var(--c-amber);
    outline-offset: 2px;
  }

  @media (max-width: 720px) {
    .gates__row {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
    .gates__row--head {
      display: none;
    }
  }

  /* v13.1.4 polish-7ae : per-section metadata. Same register as
     /positions/ `.positions-card__meta` (polish-7z commit ec1674b)
     and /contact/ `.contact-card__meta` (polish-7x commit 19aa5ef).
     Hairline divider + mono + 1 accent; no halo, no glow, no chrome. */
  .method-meta {
    margin-top: var(--sp-4);
    padding-top: var(--sp-2);
    border-top: 1px dashed var(--c-rule-soft);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    letter-spacing: 0.04em;
    line-height: 1.5;
    max-width: 65ch;
  }

  .method-meta a {
    color: var(--c-primary);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 2px;
  }

  .method-meta code {
    font-family: var(--ff-mono);
    color: var(--c-ink-2);
    background: transparent;
    padding: 0;
  }

  /* v13.1.4 polish-7ae : recency stamp at bottom. Same register as
