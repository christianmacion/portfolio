---
/**
 * methodology.astro — the eval-first philosophy, G1–G31 gate stack, model-routing policy,
 * agent charter pattern. Spell out the *method*, not just the outputs.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Equation from '@components/Equation.astro';
import CTABanner from '@components/CTABanner.astro';
import DSRCalculator from '@components/DSRCalculator.astro';
import SectionTOC from '@components/SectionTOC.astro';
import PipelineDiagram from '@components/PipelineDiagram.astro';
import ChromeHeader from '@components/ChromeHeader.astro';
import { path } from '@utils/url';
import VoiceLine from '@components/VoiceLine.astro';
import { profile } from '@utils/profile';

// Gate-count chrome: derives from profile.stats.evalGates. Used in
// SectionTOC label, data-toc-label, headline H2, voice sub line,
// and other "G1–G31" references on this page.
const GATE_RANGE = `G1–G${profile.stats.evalGates}`;

const gates = [
  {
    range: 'G1–G5',
    name: 'Mechanical validity',
    desc: 'Schema conformance, exit-0 contract, structured output parse, JSON Schema strict-mode, byte-length budget.',
  },
  {
    range: 'G6–G10',
    name: 'Statistical nulls',
    desc: `<a href="${path('/glossary/block-bootstrap')}">block-bootstrap</a> CIs, random-timing nulls, <a href="${path('/glossary/regime')}">regime</a>-shuffle, parameter-prior sensitivity, Monte-Carlo coverage.`,
  },
  {
    range: 'G11–G15',
    name: 'Walk-forward & OOS',
    desc: `Locked <a href="${path('/glossary/oos')}">OOS</a> windows, 5-era stability, expanding/rolling <a href="${path('/glossary/walk-forward')}">walk-forward</a> windows, frozen-spec evaluation, <a href="${path('/glossary/embargo')}">embargoed</a> test set.`,
  },
  {
    range: 'G16–G20',
    name: 'Multiple testing',
    desc: `<a href="${path('/glossary/deflated-sharpe')}">Deflated Sharpe Ratio</a> (DSR), <a href="${path('/glossary/cscv-pbo')}">CSCV-based Probability of Backtest Overfit</a> (PBO), <a href="${path('/glossary/minbtl')}">Minimum Backtest Length</a> (MinBTL), <a href="${path('/glossary/bonferroni-holm')}">Bonferroni–Holm</a>, BH-FDR.`,
  },
  {
    range: 'G21–G25',
    name: 'Look-ahead discipline',
    desc: `Point-in-time dataset verification, <a href="${path('/glossary/survivorship-bias')}">survivorship-bias</a> check, rebalance-vs-signal timing, frozen-spec, no-leakage to scoring.`,
  },
  {
    range: 'G26–G31',
    name: 'Economic & cost realism',
    desc: `Spread/<a href="${path('/glossary/slippage')}">slippage</a>/latency per asset class, capacity-constraint report, funding-carry, borrow cost, vol-targeted sizing, <a href="${path('/glossary/regime')}">regime</a> overlay.`,
  },
];

const routing = [
  {
    tier: 'Opus',
    role: 'judgment / hardest autonomous decisions',
    ratio: '~1 dispatch per analysis chain',
  },
  { tier: 'Sonnet', role: 'assembly / structured generation', ratio: '~3–5 dispatches per chain' },
  {
    tier: 'Haiku',
    role: 'mechanical / fast deterministic steps',
    ratio: '~10–30 dispatches per chain',
  },
  { tier: 'Fable', role: 'long-horizon autonomous research', ratio: 'one off, overnight' },
];

const charter = [
  { tag: 'role', value: 'A specific function, never generic "AI assistant"' },
  { tag: 'inputs', value: 'Typed input contract (JSON Schema, fail-closed)' },
  { tag: 'outputs', value: 'Typed output contract with strict validation' },
  { tag: 'handoffs', value: 'What this agent must NOT do (anti-charter)' },
  { tag: 'gates', value: `Which of ${GATE_RANGE} apply, with exit codes` },
  { tag: 'evidence', value: 'What the agent must attach as proof' },
];
---

<BaseLayout
  title="Methodology"
  description={`The eval-first discipline. ${GATE_RANGE} statistical gate stack. Model-routing policy. Agent charter pattern.`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Methodology', href: '/methodology' },
  ]}
>
  <header class="method-head">
    <div class="container">
      <ChromeHeader
        chip="METHODOLOGY · EVAL-FIRST DISCIPLINE"
        eyebrow={`${GATE_RANGE} GATE STACK · MODEL-ROUTING · AGENT CHARTER`}
        tenant={`CHRISTIAN.T.MACION · UTC+8 · ${profile.stats.evalGates}-GATE EVAL · OWNER-VERIFIED`}
        noSep
        hideTenet
      />
      <h1 class="method-head__title" data-words>
        Don’t ship what hasn’t passed a <span class="hl">measurable gate</span>.
      </h1>
      <VoiceLine class="method-head__voice">
        If it isn’t measured, it isn’t built. Five-rule discipline, six gate families.
      </VoiceLine>

      <p class="method-head__sub">
        One engineering principle. Applied to LLM outputs and to systematic trading strategies with
        the same gate stack. The method is what scales; the tools change. The principle has three
        operational rules: every candidate is gated before ship (mechanical, not opinionated); the
        gate ID is load-bearing (a gate name is a contract); and a failure is logged, not worked
        around (no live-tuning the gate to make the candidate pass).
      </p>

      <div class="method-head__eq-block">
        <Equation
          block
          size="lg"
          latex={`\\Pr(\\text{ship}) \\;=\\; \\Pr(\\text{ship} \\mid \\text{passes G1--G${profile.stats.evalGates}}) \\cdot \\prod_{i=1}^{${profile.stats.evalGates}} \\Pr(G_i \\mid \\text{evidence}_i)`}
        />
      </div>
    </div>
  </header>

  <SectionTOC
    label="On this methodology page"
    items={[
      { id: 'gates', label: `${GATE_RANGE} gate stack` },
      { id: 'routing', label: 'Model routing' },
      { id: 'dsr', label: 'DSR calculator' },
      { id: 'charter', label: 'Agent charter' },
      { id: 'incidents', label: 'Where the method broke' },
      { id: 'oss', label: 'Open-source record' },
      { id: 'neg', label: 'Negative space' },
      { id: 'hire', label: 'If you hired me' },
    ]}
  />

  <section class="section" data-toc-id="gates" data-toc-label={`${GATE_RANGE} gate stack`}>
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">The gate stack</p>
        <h2 class="section__title" id="gates">{GATE_RANGE}. Six families. One contract.</h2>
        <p class="section__sub">
          Every candidate — LLM output, systematic strategy, content artifact — passes through the
          same gate stack. Gates are mechanical (exit-0 contract), not opinionated. A pass means the
          candidate is allowed to surface; a fail means it isn't. Gate IDs are load-bearing — they
          appear in the AAR footer, in the eval-harness CI run, and in the per-candidate
          permission-to-publish decision, so a "G16" means the same thing across the corpus. The
          table below shows one family per row; the gate ID is the row's first column.
        </p>
      </header>

      <div class="gates" role="table" aria-label={`${GATE_RANGE} gate stack — six families`}>
        <div class="gates__row gates__row--head" role="row">
          <span class="gates__cell gates__cell--range mono" role="columnheader">Gate ID</span>
          <span class="gates__cell gates__cell--name" role="columnheader">Family</span>
          <span class="gates__cell gates__cell--desc" role="columnheader">What it checks</span>
        </div>
        {
          gates.map((g, i) => (
            <article class="gates__row" id={`family-${i + 1}`} role="row">
              <span class="gates__cell gates__cell--range mono" role="cell">{g.range}</span>
              <h3 class="gates__cell gates__cell--name" role="cell">{g.name}</h3>
              <p class="gates__cell gates__cell--desc" role="cell" set:html={g.desc} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt" data-toc-id="routing" data-toc-label="Model routing">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Model routing</p>
        <h2 class="section__title" id="routing">Tiered dispatch, not single-agent.</h2>
        <p class="section__sub">
          A multi-agent system runs at ~15× the token cost of a single agent. The cost is real — the
          answer is to route by what the step actually needs to compute, not by default. Every
          dispatch has a per-step budget.
        </p>
      </header>

      <div class="routing">
        {
          routing.map((r) => (
            <div class="route">
              <div class="route__tier mono">{r.tier}</div>
              <div class="route__role">{r.role}</div>
              <div class="route__ratio mono">{r.ratio}</div>
            </div>
          ))
        }
      </div>

      <div class="routing-eq">
        <Equation
          latex={`\\text{cost} = \\sum_{i} \\text{tokens}(i) \\cdot \\text{price}(\\text{tier}(i)) \\quad \\text{where} \\quad \\text{tier} : \\mathcal{A} \\to \\{\\text{Opus, Sonnet, Haiku, Fable}\\}`}
        />
      </div>

      <div
        class="routing-pipeline"
        aria-label="End-to-end pipeline from intent to deliverable with feedback loop"
      >
        <p class="routing-pipeline__cap mono">end-to-end pipeline · every project</p>
        <PipelineDiagram
          tone="paper"
          steps={[
            { num: '01', title: 'Intent', desc: 'problem statement + success metric + NDA audit' },
            { num: '02', title: 'Frame', desc: 'frozen spec · eval harness drafted before code' },
            { num: '03', title: 'Build', desc: 'tier-routed agents · cost-capped per step' },
            { num: '04', title: 'Verify', desc: `gate stack ${GATE_RANGE} · exit-0 contract` },
            {
              num: '05',
              title: 'Deliver',
              desc: 'public repo or live paper-trade · published only if all pass',
            },
          ]}
        />
      </div>
    </div>
  </section>

  <section class="section" data-toc-id="dsr" data-toc-label="DSR calculator">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Interactive · G16</p>
        <h2 class="section__title" id="dsr">
          Try the <a href={path('/glossary/deflated-sharpe')}>deflated Sharpe</a> calculator.
        </h2>
        <p class="section__sub">
          See how the same in-sample <a href={path('/glossary/sharpe')}>Sharpe</a> can pass or fail G16
          depending on how many strategies you actually tried. This is the gate that turns "1.14 looks
          great" into <a href={path('/glossary/deflated-sharpe')}>"DSR 0.70 — fail."</a>
        </p>
      </header>

      <DSRCalculator />
    </div>
  </section>

  <section class="section" data-toc-id="charter" data-toc-label="Agent charter">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Agent charter</p>
        <h2 class="section__title" id="charter">{charter.length} required fields per agent.</h2>
        <p class="section__sub">
          A charter is a contract, not a prompt. Every agent has the same six fields, with the same
          semantics. No exceptions.
        </p>
      </header>

      <div class="charter">
        {
          charter.map((c) => (
            <div class="charter__row">
              <div class="charter__tag mono">{c.tag}</div>
              <div class="charter__val">{c.value}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt" data-toc-id="neg" data-toc-label="Negative space">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">What I will not do</p>
        <h2 class="section__title" id="neg">Negative-space as design.</h2>
      </header>
      <ul class="neg">
        <li>
          I will not claim current employment at any NDA-protected firm. The systematic-strategy
          desk engagement is a <strong>closed past contract</strong> (03/2026 – 06/2026).
        </li>
        <li>
          I will not reference proprietary data sources, fund renames, or per-strategy t-stats from
          any NDA-protected desk.
        </li>
        <li>
          I will not share a <a href={path('/glossary/sharpe')}>"Sharpe = X.X"</a> number without showing
          the gate stack that produced it.
        </li>
        <li>I will not ship an agent without an exit-0 mechanical-validator contract.</li>
        <li>
          I will not present a backtest without capacity, <a href={path('/glossary/slippage')}
            >slippage</a
          >, and a locked <a href={path('/glossary/oos')}>OOS</a> window.
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--alt" data-toc-id="hire" data-toc-label="If you hired me">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">What I'd build first</p>
        <h2 class="section__title" id="hire">If you hired me onto a quant desk.</h2>
        <p class="section__sub">
          These are the first 90 days, ordered by leverage. A new QR on a 2–5 person pod doesn't
          start with alpha — they start by making the existing book defensible to a risk manager and
          a PM. The discipline compounds; the alpha is downstream.
        </p>
      </header>
      <ol class="plan">
        <li class="plan__row">
          <div class="plan__week mono">WK 1–2</div>
          <div class="plan__body">
            <h3 class="plan__title">Backtest-engine audit + look-ahead scan</h3>
            <p class="plan__body-p">
              Run the one-bar shift test (project 09) on every strategy in the book. Quantify the
              phantom-Sharpe gap. This is the gate that catches the most expensive error class
              first.
            </p>
            <div class="plan__gates mono">G21–G25 · look-ahead discipline</div>
          </div>
        </li>
        <li class="plan__row">
          <div class="plan__week mono">WK 3–4</div>
          <div class="plan__body">
            <h3 class="plan__title">Cost-model calibration + break-even turnaround</h3>
            <p class="plan__body-p">
              Per-strategy <a href={path('/glossary/slippage')}>slippage</a> / impact / spread estimate.
              For every strategy, ship the break-even turnaround cost (project 08). Strategies that win
              gross and lose net come off the book.
            </p>
            <div class="plan__gates mono">G26–G31 · economic & cost realism</div>
          </div>
        </li>
        <li class="plan__row">
          <div class="plan__week mono">WK 5–8</div>
          <div class="plan__body">
            <h3 class="plan__title">Multiple-testing correction across the book</h3>
            <p class="plan__body-p">
              Re-rank every strategy by <a href={path('/glossary/deflated-sharpe')}>DSR</a> (project 01),
              not raw <a href={path('/glossary/sharpe')}>Sharpe</a>. Re-rank by <a
                href={path('/glossary/cscv-pbo')}>CSCV-based PBO</a
              >
              (prob. of backtest overfit). The book's "best strategy" is rarely the strategy with the
              highest raw Sharpe.
            </p>
            <div class="plan__gates mono">G16–G20 · multiple testing</div>
          </div>
        </li>
        <li class="plan__row">
          <div class="plan__week mono">WK 9–12</div>
          <div class="plan__body">
            <h3 class="plan__title">Walk-forward OOS window standardization</h3>
            <p class="plan__body-p">
              Locked, <a href={path('/glossary/embargo')}>embargoed</a>
              <a href={path('/glossary/oos')}>OOS</a> windows (project 06 pattern) across the book. Frozen-spec
              evaluation. <a href={path('/glossary/walk-forward')}>Walk-forward</a> standardization. The
              book becomes reproducible from cold start.
            </p>
            <div class="plan__gates mono">G11–G15 · walk-forward & OOS</div>
          </div>
        </li>
      </ol>

      <div class="plan__note">
        <strong>The pattern:</strong> defenses before alpha. A QR who can defend the book is hireable;
        a QR who can find alpha is hireable-and-defensible. The first 90 days establish the defense.
      </div>
    </div>
  </section>

  <section class="section" data-toc-id="incidents" data-toc-label="Where the method broke">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Methodology incidents</p>
        <h2 class="section__title" id="incidents">Where the method broke, and what got codified.</h2>
        <p class="section__sub">
          Three cases where the gate stack caught a real bug, plus one where the gate stack was
          wrong and got amended. The discipline holds because the gate stack has been
          falsified — by its author's own work, not by a benchmark.
        </p>
      </header>

      <ol class="incidents">
        <li class="incidents__row">
          <div class="incidents__id mono">G37</div>
          <div class="incidents__body">
            <h3 class="incidents__title">Bid-ask bounce vs. stitched-OHLCV</h3>
            <p class="incidents__prose">
              A backtest on a stitched MEXC mirror of Binance bars showed a +5.6 Sharpe "weekend-gap
              fade" signal. The signal was a stitching artifact — the mirror overlapped weekend
              bars with the next Monday's open, and the bounce was a phantom mean-reversion. Gate
              G37 (data-source-stitch audit) caught the overlap; the signal was killed. The gate
              was codified after this incident, not before. AAR: corrections.md entry 2026-08-02
              "stitched-OHLCV binding rule."
            </p>
          </div>
        </li>
        <li class="incidents__row">
          <div class="incidents__id mono">G21</div>
          <div class="incidents__body">
            <h3 class="incidents__title">One-bar shift on the BTC funding-carry book</h3>
            <p class="incidents__prose">
              The funding-carry candidate cleared pre-flight and the cheap n-aware t-stat gate. G21
              (one-bar shift) collapsed the Sharpe from 2.4 to 0.31 on the same fixture panel — the
              edge was a look-ahead in the funding-rate timestamp. The candidate was killed; the
              methodology was not amended, because G21 is exactly the gate designed to catch this.
              AAR: 2026-08-01-idea19-btc-funding-carry-deep-preflight.md.
            </p>
          </div>
        </li>
        <li class="incidents__row">
          <div class="incidents__id mono">G16</div>
          <div class="incidents__body">
            <h3 class="incidents__title">Deflated Sharpe after 30 sweeps</h3>
            <p class="incidents__prose">
              A "BTC Friday short" candidate cleared with raw Sharpe 1.14 across 9 sweeps, then
              failed G16 (deflated Sharpe) once the sweep count was raised to 30. The same in-sample
              Sharpe with the corrected multiple-testing penalty became DSR 0.70 — a fail. The
              discipline is the gate, not the headline number. AAR:
              2026-08-01-afk-strategy-mining-v2.md.
            </p>
          </div>
        </li>
        <li class="incidents__row">
          <div class="incidents__id mono">G40</div>
          <div class="incidents__body">
            <h3 class="incidents__title">A gate the gate stack didn't have</h3>
            <p class="incidents__prose">
              The CFD 5-min landscape survey passed all existing pre-flight gates and still turned
              out to be a thin market that manufactured Sharpe on a 3-month window. The gate stack
              had no data-coverage gate, so the failure mode wasn't codified. G40 (minimum bar-count
              per asset × frequency cell) was added after the survey was killed, with the explicit
              "real-but-too-thin" binding rule. AAR: 2026-08-02-afk-sweep-v2p6-outcome.md.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--alt" data-toc-id="oss" data-toc-label="Open-source record">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Open-source implementation record</p>
        <h2 class="section__title" id="oss">Where the canon lives.</h2>
        <p class="section__sub">
          The repositories that anchor the methodology, motion, and chrome contracts on this site.
          Each row: repo → role on this site → license → last verified date. The "verified" date is
          the last time the license badge and upstream head were checked. License claims are
          re-verified quarterly, not assumed.
        </p>
      </header>

      <div class="oss-table" role="table" aria-label="Open-source implementation record">
        <div class="oss-table__row oss-table__row--head" role="row">
          <span class="oss-table__cell oss-table__cell--repo mono" role="columnheader">Repository</span>
          <span class="oss-table__cell oss-table__cell--role" role="columnheader">Role on this site</span>
          <span class="oss-table__cell oss-table__cell--license mono" role="columnheader">License</span>
          <span class="oss-table__cell oss-table__cell--verified mono" role="columnheader">Verified</span>
        </div>
        <div class="oss-table__row" role="row">
          <span class="oss-table__cell oss-table__cell--repo mono" role="cell">
            <a href="https://github.com/karpathy/autoresearch" rel="noopener" target="_blank"
              >karpathy/autoresearch</a
            >
          </span>
          <span class="oss-table__cell oss-table__cell--role" role="cell"
            >Pattern — autonomous research loop</span
          >
          <span class="oss-table__cell oss-table__cell--license mono" role="cell">MIT</span>
          <span class="oss-table__cell oss-table__cell--verified mono" role="cell">2026-07-31</span>
        </div>
        <div class="oss-table__row" role="row">
          <span class="oss-table__cell oss-table__cell--repo mono" role="cell">
            <a href="https://github.com/obra/superpowers" rel="noopener" target="_blank"
              >obra/superpowers</a
            >
          </span>
          <span class="oss-table__cell oss-table__cell--role" role="cell"
            >Pattern — skill authoring methodology</span
          >
          <span class="oss-table__cell oss-table__cell--license mono" role="cell">MIT</span>
          <span class="oss-table__cell oss-table__cell--verified mono" role="cell">2026-07-31</span>
        </div>
        <div class="oss-table__row" role="row">
          <span class="oss-table__cell oss-table__cell--repo mono" role="cell">
            <a href="https://github.com/jeffallan/claude-skills" rel="noopener" target="_blank"
              >jeffallan/claude-skills</a
            >
          </span>
          <span class="oss-table__cell oss-table__cell--role" role="cell"
            >Pattern — ui-ux-pro-max, chrome governance reference</span
          >
          <span class="oss-table__cell oss-table__cell--license mono" role="cell">MIT</span>
          <span class="oss-table__cell oss-table__cell--verified mono" role="cell">2026-07-31</span>
        </div>
        <div class="oss-table__row" role="row">
          <span class="oss-table__cell oss-table__cell--repo mono" role="cell">
            <a href="https://github.com/i-dencker/research-writing" rel="noopener" target="_blank"
              >i-dencker/research-writing</a
            >
          </span>
          <span class="oss-table__cell oss-table__cell--role" role="cell"
            >Pattern — research-writing methodology</span
          >
          <span class="oss-table__cell oss-table__cell--license mono" role="cell">MIT</span>
          <span class="oss-table__cell oss-table__cell--verified mono" role="cell">2026-07-31</span>
        </div>
        <div class="oss-table__row" role="row">
          <span class="oss-table__cell oss-table__cell--repo mono" role="cell">
            <a href="https://github.com/legomushroom/mojs" rel="noopener" target="_blank"
              >legomushroom/mojs</a
            >
          </span>
          <span class="oss-table__cell oss-table__cell--role" role="cell"
            >Reference — animation primitive for /desk motion</span
          >
          <span class="oss-table__cell oss-table__cell--license mono" role="cell">MIT</span>
          <span class="oss-table__cell oss-table__cell--verified mono" role="cell">2026-07-31</span>
        </div>
        <div class="oss-table__row" role="row">
          <span class="oss-table__cell oss-table__cell--repo mono" role="cell">
            <a href="https://github.com/theatre-js/theatre" rel="noopener" target="_blank"
              >theatre-js/theatre</a
            >
          </span>
          <span class="oss-table__cell oss-table__cell--role" role="cell"
            >Reference — animation core; studio AGPL-3.0 (dev-only)</span
          >
          <span class="oss-table__cell oss-table__cell--license mono" role="cell"
            >Apache-2.0 / AGPL-3.0</span
          >
          <span class="oss-table__cell oss-table__cell--verified mono" role="cell">2026-07-31</span>
        </div>
        <div class="oss-table__row" role="row">
          <span class="oss-table__cell oss-table__cell--repo mono" role="cell">
