---
/**
 * ai.astro — the "/ai" page: 11-agent platform tour + 31-gate eval console.
 *
 * v6.1 Mission F. Composes:
 *   - Stat row (11 agents · 31 gates · 6 projects · 76.5 k LOC Python)
 *   - <AgentGraph /> — 11-node DAG, animated feedback loop, server SVG
 *   - Loop engineering explainer — "Idea → Eval → Ship → Measure → Next"
 *   - 6 AI project cards (collected from src/content/projects/ai/*.mdx)
 *   - <EvalConsole /> — 31-gate result grid
 *   - Disclosure: open-source on GitHub, 31 gates enforced by CI
 *
 * Determinism: no Math.random / Date.now / argless new Date() in any
 * frontmatter path. Project order comes from each mdx's `order` field.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import AgentGraph from '@components/AgentGraph.astro';
import EvalConsole from '@components/EvalConsole.astro';
import MiniSpark from '@components/MiniSpark.astro';
import VoiceLine from '@components/VoiceLine.astro';
import Stat from '@components/Stat.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { path } from '@utils/url';
import { profile } from '@utils/profile';

const GATE_RANGE = `G1–G${profile.stats.evalGates}`;
const NGATE = `${profile.stats.evalGates}-gate`;

interface AIProject {
  slug: string;
  title: string;
  summary: string;
  metrics: { label: string; value: string; sub?: string }[];
  date: string; // YYYY-MM (deterministic, from frontmatter `date`)
  order: number;
}

// Pull the 6 AI projects directly from the existing content collection
// (no separate file or schema). Order is the frontmatter `order` field;
// this matches the source-of-truth used by /projects and /research.
const allProjects: CollectionEntry<'project'>[] = await getCollection('project');
const aiProjects: AIProject[] = allProjects
  .filter((p) => p.data.role === 'ai')
  .sort((a, b) => a.data.order - b.data.order)
  .map<AIProject>((p) => ({
    slug: p.id,
    title: p.data.title,
    summary: p.data.summary,
    metrics: p.data.metrics,
    date:
      p.data.date instanceof Date
        ? p.data.date.toISOString().slice(0, 7)
        : String(p.data.date).slice(0, 7),
    order: p.data.order,
  }));

// Deterministic sparklines per project, derived from the project slug.
// Seed is the slug itself so the same project always renders the same
// mini spark — never Math.random, never Date.now.
function hashSlug(s: string): number {
  let h = 0x811c9dc5;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return h >>> 0;
}
function miniSeries(seed: string, n: number): number[] {
  let s = hashSlug(seed);
  const out: number[] = [];
  let v = 0.5;
  for (let i = 0; i < n; i++) {
    s = (s + 0x6d2b79f5) >>> 0;
    let t = s;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    const u = ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    v += (u - 0.5) * 0.18;
    v = Math.max(0.1, Math.min(0.9, v));
    out.push(v);
  }
  return out;
}

const loopSteps = [
  { num: '01', title: 'Idea', desc: 'Draft the eval harness BEFORE writing the prompt.' },
  { num: '02', title: 'Eval', desc: `Score against ${GATE_RANGE}. Evidence per gate, exit codes.` },
  { num: '03', title: 'Ship', desc: 'Tier-routed agents. Per-step budget. Cut-over only on pass.' },
  { num: '04', title: 'Measure', desc: "OTel traces · Cohen's κ · bootstrap CIs · DSR." },
  { num: '05', title: 'Next', desc: 'Reflect → revise → loop. No-progress halt ships nothing.' },
];

// v6.11.34 — source-of-truth for the platform DAG. Mirrors the
// AgentGraph component's nodes[] in layout (4 inputs / 3 middles /
// 3 outputs / 1 orchestrator). Counts derived from .length below.
const platformInputs = [
  { label: 'Doc corpus', sub: '17 · 34 chunks' },
  { label: 'Eval set', sub: '35 Q · gold' },
  { label: 'Build output', sub: 'ships · tests' },
  { label: 'Telemetry', sub: 'OTel · traces' },
];
---

<BaseLayout
  title={`AI lane — ${profile.stats.aiAgentCount} agents, ${profile.stats.evalGates} gates`}
  description={`The ${profile.stats.aiAgentCount}-agent platform and the ${profile.stats.evalGates}-gate eval console behind every AI artifact. Every LLM output passes the same statistical gate stack as a published systematic strategy.`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'AI', href: '/ai' },
  ]}
>
  <header class="section section--hero ai-hero">
    <div class="container">
      <p class="section__eyebrow">AI lane</p>
      <h1 class="section__title" data-words>
        {profile.stats.aiAgentCount} agents. One loop. <span class="hl">{NGATE}.</span>
      </h1>
      <VoiceLine size="md">
        Every LLM output I ship passes the same statistical gate stack as a systematic strategy. The
        harness is the artifact; the model is interchangeable.
      </VoiceLine>
      <div class="ai-hero__stats">
        <Stat
          value={profile.stats.aiAgentCount}
          label="agents"
          sub="4 inputs · 3 middles · 3 outputs · 1 orchestrator"
          size="md"
          variant="primary"
        />
        <Stat
          value={profile.stats.evalGates}
          label="eval gates"
          sub={`G1–G${profile.stats.evalGates} · 6 families · exit-0 contract`}
          size="md"
          variant="primary"
        />
        <Stat
          value={String(aiProjects.length)}
          label="projects"
          sub="in-repo · reproducible"
          size="md"
          variant="primary"
        />
        <Stat
          value={profile.stats.locPython}
          label="LOC Python"
          sub="stdlib-heavy · LLM-free scoring"
          size="md"
          variant="primary"
        />
      </div>
    </div>
  </header>

  {/* === Section 1 — the {profile.stats.aiAgentCount}-agent platform === */}
  <section
    class="section section--alt"
    id="platform"
    data-toc-id="platform"
    data-toc-label={`${profile.stats.aiAgentCount}-agent platform`}
  >
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">The platform</p>
        <h2 class="section__title">
          {profile.stats.aiAgentCount} agents. A directed-acyclic graph with one feedback edge.
        </h2>
        <p class="section__sub">
          {platformInputs.length} inputs feed the orchestrator. The orchestrator dispatches to RAG-Recall,
          Eval-Gate, and Router. The middles publish to Artifact, Metric, and Feedback. Feedback loops
          back to the orchestrator — that loop is the entire system.
        </p>
      </header>

      <AgentGraph />

      <ul class="ai-cap-list mono">
        <li>
          <span class="ai-cap-list__k">inputs</span>
          <span class="ai-cap-list__v">doc corpus · eval set · build output · telemetry</span>
        </li>
        <li>
          <span class="ai-cap-list__k">middles</span>
          <span class="ai-cap-list__v">RAG-Recall · Eval-Gate · Router</span>
        </li>
        <li>
          <span class="ai-cap-list__k">outputs</span>
          <span class="ai-cap-list__v">Artifact · Metric · Feedback</span>
        </li>
        <li>
          <span class="ai-cap-list__k">loop</span>
          <span class="ai-cap-list__v">Feedback → Orchestrator — this is the system</span>
        </li>
      </ul>
    </div>
  </section>

  {/* === Section 2 — Loop engineering === */}
  <section class="section" id="loop" data-toc-id="loop" data-toc-label="Loop engineering">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Loop engineering</p>
        <h2 class="section__title">Idea → Eval → Ship → Measure → Next.</h2>
        <p class="section__sub">
          Loop engineering is what the AI lane is. The first step is the harness, not the prompt.
          The last step is the gate, not the model's confidence.
        </p>
      </header>

      <ol class="ai-loop" aria-label="Five-step loop engineering cycle">
        {
          loopSteps.map((s) => (
            <li class="ai-loop__step">
              <span class="ai-loop__num mono">{s.num}</span>
              <h3 class="ai-loop__title">{s.title}</h3>
              <p class="ai-loop__desc">{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* === Section 2b — STELLA + graph engineering === v7.6
       Surfaces the next layer: STELLA Office (53-agent, 6-sub-team)
       + the graph rung. Link out to /workbooks/. NDA-safe: counts
       and taxonomy only, no officer names. */}
  <section class="section section--alt" id="stella" data-toc-id="stella" data-toc-label="STELLA · Graph engineering">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Beyond the loop · STELLA Office</p>
        <h2 class="section__title">The next rung: graphs as shared memory.</h2>
        <p class="section__sub">
          The 5-rung spine — <b>prompt → skills → agents → loops → graphs</b> — is what
          STELLA's {profile.stats.aiAgentCount}-agent office runs on. The graph layer is the
          productivity unlock: typed entities + relations + provenance, queryable, shared
          across every agent so the corpus isn't re-derived on every dispatch.
        </p>
      </header>

      <div class="stella-grid">
        <div class="stella-cell stella-cell--arch">
          <p class="stella-cell__num mono">A</p>
          <h3 class="stella-cell__name">Multi-agent office</h3>
          <p class="stella-cell__sub">
            {profile.stats.aiAgentCount} agents in 6 sub-teams. 4 doctrinal corpora. 5-must-have
            compliance on every loop primitive. NDA-safe by construction — counts and taxonomy
            only, never officer names.
          </p>
          <a href={path('/methodology')} class="stella-cell__link">Methodology →</a>
        </div>

        <div class="stella-cell stella-cell--graph">
          <p class="stella-cell__num mono">B</p>
          <h3 class="stella-cell__name">Knowledge graph layer</h3>
          <p class="stella-cell__sub">
            9 entity types. 9 predicates. Four-stage pipeline — Extract · Resolve ·
            Assemble · Query. The AAR → graph contract: every mission writes its
            findings, every AAR mutates the graph.
          </p>
          <a href={path('/workbooks')} class="stella-cell__link">Workbook trilogy →</a>
        </div>

        <div class="stella-cell stella-cell--rung">
          <p class="stella-cell__num mono">C</p>
          <h3 class="stella-cell__name">5-rung spine</h3>
          <p class="stella-cell__sub">
            Most teams plateau at the loop. STELLA runs at the graph rung — and ships
            the public-facing narrative via two workbooks
            (<em>AI Engineering from the Ground Up</em>, <em>Graph Engineering for Everyone</em>).
          </p>
          <a href={path('/workbooks/ai-engineering/')} class="stella-cell__link">Read W1 →</a>
        </div>
      </div>
    </div>
  </section>

  {/* === Section 2c — AI trends 2022→2026 === v7.6
       Maps the 2022→2026 public AI trend line onto the 5-rung spine
       (prompt → skills → agents → loops → graphs). Each rung is a
       forced move by the frontier labs; each rung is matched by a
       specific deliverable on the portfolio surface. NDA-clean by
       construction: public events only, no employer naming. */}
  <section class="section" id="ai-trends" data-toc-id="ai-trends" data-toc-label="AI trends 2022→2026">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">AI trends 2022→2026</p>
        <h2 class="section__title">How the graph rung emerged.</h2>
        <p class="section__sub">
          The 5-rung spine — <b>prompt → skills → agents → loops → graphs</b> — is not a roadmap
          we invented. It is what the public AI trend line actually produced, year by year, from
          2022-11 to 2026-03. Each rung was a forced move by the frontier labs; each rung was
          matched, in the portfolio, by a specific deliverable on the matching surface. The
          lesson per year is the institutional takeaway that survived contact with the next year.
        </p>
      </header>

      <ol class="ai-trend-grid" aria-label="AI trends 2022 to 2026, mapped to the 5-rung spine">
        <li class="ai-trend">
          <p class="ai-trend__year mono">2022</p>
          <h3 class="ai-trend__name">Prompt · ChatGPT goes public</h3>
          <p class="ai-trend__body">
            <b>Trend.</b> 2022-11 ChatGPT reaches 100M users in two months. The public
            surface discovers the prompt as the unit of work.
          </p>
          <p class="ai-trend__body">
            <b>Then.</b> A single-prompt demonstrator. No harness, no eval, no contract.
          </p>
          <p class="ai-trend__body">
            <b>Lesson.</b> Prompting is not engineering. The variable that survives
            is the eval set, not the wording.
          </p>
          <a href={path('/workbooks/ai-engineering/')} class="ai-trend__link">
            W1: prompt chapter →
          </a>
        </li>

        <li class="ai-trend">
          <p class="ai-trend__year mono">2023</p>
          <h3 class="ai-trend__name">Skills · GPT-4, function calling, RAG</h3>
          <p class="ai-trend__body">
            <b>Trend.</b> 2023-03 GPT-4 + plugins. 2023-06 function calling. 2023-10
            RAG becomes the default retrieval pattern. The model becomes a tool
            user, not a search replacement.
          </p>
          <p class="ai-trend__body">
            <b>Then.</b> Skills module: tool schemas, JSON-mode contracts,
            retrieval-graded chunks. The first eval harness ships.
          </p>
          <p class="ai-trend__body">
            <b>Lesson.</b> Grounding beats fluency. A tool-using model with a real
            corpus beats a fluent model hallucinating.
          </p>
          <a href={path('/research/frontier-models')} class="ai-trend__link">
            Frontier models benchmark →
          </a>
        </li>

        <li class="ai-trend">
          <p class="ai-trend__year mono">2024</p>
          <h3 class="ai-trend__name">Agents · Claude Sonnet 3.5, Computer Use</h3>
          <p class="ai-trend__body">
            <b>Trend.</b> 2024-06 Claude Sonnet 3.5 ships agentic coding. 2024-10
            Anthropic Computer Use beta. The agent becomes a first-class product
            surface.
          </p>
          <p class="ai-trend__body">
            <b>Then.</b> Solo agent with a planner + tool belt. Eval harness measures
            plan quality, not just answer quality.
          </p>
          <p class="ai-trend__body">
            <b>Lesson.</b> An agent without a loop is a long prompt. The harness
            is the product.
          </p>
          <a href={path('/workbooks/ai-engineering/')} class="ai-trend__link">
            W1: agent chapter →
          </a>
        </li>

        <li class="ai-trend">
          <p class="ai-trend__year mono">2025</p>
          <h3 class="ai-trend__name">Loops · MCP, DeepSeek-R1, eval-driven rollout</h3>
          <p class="ai-trend__body">
            <b>Trend.</b> 2025-02 Anthropic MCP. 2025 DeepSeek-R1 ships reasoning
            on par with closed models. Teams adopt eval-driven rollout, not
            vibe-driven rollout.
          </p>
          <p class="ai-trend__body">
            <b>Then.</b> The 5-must-have loop contract lands in production: terminal
            state, idempotent write, dedupe key, coverage filter, AAR.
          </p>
          <p class="ai-trend__body">
            <b>Lesson.</b> A loop without a coverage filter is a leak. The AAR is
            the reliability primitive.
          </p>
          <a href={path('/methodology')} class="ai-trend__link">
            Methodology: 5-must-have loop contract →
          </a>
        </li>

        <li class="ai-trend">
          <p class="ai-trend__year mono">2026</p>
          <h3 class="ai-trend__name">Graphs · Claude Opus 4.5, multi-agent offices</h3>
          <p class="ai-trend__body">
            <b>Trend.</b> 2026-03 Claude Opus 4.5. Frontier agents stop being
            prompted and start composing. Multi-agent offices stop being demos
            and start compounding across missions.
          </p>
          <p class="ai-trend__body">
            <b>Now.</b> STELLA: {profile.stats.aiAgentCount} agents, 6 sub-teams, knowledge
            graph with 9 entity types and 9 predicates. Every AAR writes back to
            the graph.
          </p>
          <p class="ai-trend__body">
            <b>Lesson.</b> The graph rung is where the office starts compounding.
            Without it, every agent re-derives the corpus and shipping velocity
            collapses.
          </p>
          <a href={path('/workbooks/graph-engineering/')} class="ai-trend__link">
            W3: graph engineering →
          </a>
        </li>
      </ol>

      <p class="section__sub section__sub--narrow">
        The graph rung is not a destination — it is the first rung where a multi-agent office
        can compound. Every prior rung (prompt, skills, agents, loops) is a per-call primitive.
        The graph is the per-office primitive: a shared, typed, queryable memory that turns
        {' '}{profile.stats.aiAgentCount} agents from collaboration cost into collaboration yield. The
        {' '}<a href={path('/workbooks')}>workbook trilogy</a> is the public-facing narrative; the
        portfolio is the running example.
      </p>
    </div>
  </section>

  {/* === Section 2e — Graph engineering · source, adoption, adaptation ===
       v7.6.7 — owner ask 2026-07-27: "highlight that we can do and have adopted
       to graph engineering. the file in downloads. show that we can do those.
       and we can adapt it to our quant research and trading." Two source PDFs
       were synthesized into the portfolio's workbook trilogy; this section
       publishes (a) the source papers, (b) the concrete adoption inside the
       STELLA office, and (c) the 1:1 mapping from the 4-stage graph pipeline
       onto quant research + trading. */}
  <section
    class="section section--alt"
    id="graph-engineering"
    data-toc-id="graph-engineering"
    data-toc-label="Graph engineering · adapted"
  >
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Method · source, adoption, adaptation</p>
        <h2 class="section__title">Graph engineering — read, run, adapt.</h2>
        <p class="section__sub">
          The graph rung isn't a posture. It's three deliverables you can verify: a source you can read,
          a production system you can run, and an adaptation you can audit against a different domain.
          Below: the two source papers we synthesized, the STELLA office's running adoption, and the
          1-to-1 mapping that ports the same pipeline onto quant research + trading.
        </p>
      </header>

      <div class="kg-strip">
        {/* Source card */}
        <article class="kg-card kg-card--source">
          <p class="kg-card__num mono">01 · SOURCE</p>
          <h3 class="kg-card__name">Two working papers</h3>
          <p class="kg-card__sub">
            We read both. We synthesized them into the workbook trilogy. Both PDFs ship with the
            site — open the working notes, follow the references, verify every claim against the
            upstream material.
          </p>
          <ul class="kg-card__list">
            <li>
              <a
                href={path('/workbooks/sources/graph-engineering-anthropic-playbook.pdf')}
                target="_blank"
                rel="noopener"
              >
                Graph Engineering — The Anthropic Playbook
              </a>
              <span class="kg-card__meta mono">177 KB · 6 pp · 4-stage pipeline</span>
            </li>
            <li>
              <a
                href={path('/workbooks/sources/graph-engineering-anthropic-karpathy-loop.pdf')}
                target="_blank"
                rel="noopener"
              >
                Graph Engineering — Karpathy Loop × Anthropic Playbook
              </a>
              <span class="kg-card__meta mono">1.4 MB · loop → AgentHub → DAG → graph</span>
            </li>
          </ul>
          <a href={path('/workbooks/graph-engineering/')} class="kg-card__link">
            Public-deep synthesis (W3) →
          </a>
        </article>

        {/* Adoption card */}
        <article class="kg-card kg-card--adopt">
          <p class="kg-card__num mono">02 · ADOPTION</p>
          <h3 class="kg-card__name">STELLA runs the 4-stage pipeline</h3>
          <p class="kg-card__sub">
            Not as a demo. As production. The same pipeline the playbook documents — extract →
            resolve → assemble → query — runs on every dispatch the {profile.stats.aiAgentCount}-agent
            office issues. The graph is the office's shared memory, not a sidecar.
          </p>
          <dl class="kg-stat-grid">
            <div class="kg-stat">
              <dt class="kg-stat__k mono">pipeline</dt>
              <dd class="kg-stat__v">4 stages</dd>
              <dd class="kg-stat__u mono">extract · resolve · assemble · query</dd>
            </div>
            <div class="kg-stat">
              <dt class="kg-stat__k mono">schema</dt>
              <dd class="kg-stat__v">9 · 9</dd>
              <dd class="kg-stat__u mono">9 entity types · 9 predicates</dd>
            </div>
            <div class="kg-stat">
              <dt class="kg-stat__k mono">contract</dt>
              <dd class="kg-stat__v">3 lines</dd>
              <dd class="kg-stat__u mono">AAR → graph (findings, agents, OK)</dd>
            </div>
            <div class="kg-stat">
              <dt class="kg-stat__k mono">storage</dt>
              <dd class="kg-stat__v">JSONL</dd>
              <dd class="kg-stat__u mono">append-only · dedupe-keyed</dd>
            </div>
          </dl>
          <a href={path('/workbooks/ai-engineering/')} class="kg-card__link">
            Public-facing narrative (W1) →
          </a>
        </article>

        {/* Adaptation card */}
        <article class="kg-card kg-card--adapt">
          <p class="kg-card__num mono">03 · ADAPTATION</p>
          <h3 class="kg-card__name">Same pipeline → quant + trading</h3>
          <p class="kg-card__sub">
            The four stages port 1-to-1 onto the trading lane. The entity types change (instruments,
            venues, signals instead of persons, projects, articles). The pattern doesn't.
          </p>
          <table class="kg-pipeline-map" aria-label="4-stage graph pipeline · AI lane vs trading lane">
            <thead>
              <tr>
                <th class="mono">stage</th>
                <th class="mono">AI lane</th>
                <th class="mono">trading lane</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="kg-pipeline-map__stage mono"><b>1 · Extract</b></td>
                <td>doc corpus → typed entities (PERSON / ORG / LOC / EVENT)</td>
                <td>filings + events + ticker relationships → typed entities</td>
              </tr>
              <tr>
                <td class="kg-pipeline-map__stage mono"><b>2 · Resolve</b></td>
                <td>"Neil Aldrin" → "Neil Armstrong" (semantic merge by Sonnet)</td>
                <td>"AAPL.O" → "Apple Inc" → "NASDAQ:AAPL" (canonical ID)</td>
              </tr>
              <tr>
                <td class="kg-pipeline-map__stage mono"><b>3 · Assemble</b></td>
                <td>Apollo corpus → 22 nodes · 34 edges · 1 component</td>
                <td>
                  4 trading-axis graphs: markets, signal lineage, trade lifecycle, risk propagation
                </td>
              </tr>
              <tr>
                <td class="kg-pipeline-map__stage mono"><b>4 · Query</b></td>
                <td>k-hop subgraph → grounded answer (Sonnet reasons over triples)</td>
                <td>
                  "what generated this P&L?" → lineage trace · "where is my risk?" → factor graph
                </td>
              </tr>
            </tbody>
          </table>
          <a href="/markets#graph-engineering-trading" class="kg-card__link">
            See it on /markets →
          </a>
        </article>
      </div>
    </div>
  </section>

  {/* === Section 3 — 6 AI projects === */}
  <section
    class="section section--alt"
    id="projects"
    data-toc-id="projects"
    data-toc-label="Projects"
  >
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Projects · the surface evidence</p>
        <h2 class="section__title">
          {aiProjects.length} artifacts. Each is a project, not a demo.
        </h2>
        <p class="section__sub">
          Every project on this page ships with a reproducible harness, a labeled eval set or scored
          output, and a CI-enforced gate stack. None depend on a paid API at read time.
        </p>
