  /* v13.1.4 (2026-08-11, contact-uplift) : recency stamp at bottom.
     Anchors the page to its last content-edit commit. Same register as
     /about/ `.about-recency` (polish-7t commit 3781944) and
     /work/ `.work-stamp` (polish-7p commit 9eba08f). */
  .contact-recency {
    margin: var(--sp-3) 0 0;
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-align: center;
  }
  .contact-recency a {
    color: var(--c-ink-2);
