---
/**
 * contact.astro : v2: full contact directory with all channels and "use this for X" guidance.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Equation from '@components/Equation.astro';
import { profile } from '@utils/profile';
import { path } from '@utils/url';
import VoiceLine from '@components/VoiceLine.astro';

const GATE_RANGE = `G1 to G${profile.stats.evalGates}`;

// v13.1.4 (2026-08-11, contact-uplift) : per-channel metadata. Status +
// date + response expectation + commit hash. Same register as /about/
// `.bio-prose__meta` (polish-7t commit 3781944). NDA-safe; closed
// channels can be flagged ARCHIVED here without changes elsewhere.
const CONTACT_COMMIT = '2d75d97';

const channels = [
  {
    label: 'Open roles · JDs',
    sub: 'Email with the JD attached',
    value: profile.contact.email,
    href: `mailto:${profile.contact.email}?subject=JD%20%E2%80%94%20%5Brole%5D`,
    primary: true,
    use: 'I reply within 24h with: problem → approach → evidence → outcome → proof.',
    meta: { status: 'ACTIVE', date: '2026-08-14', response: '24h reply' },
  },
  {
    label: 'Casual · paper-trail',
    sub: 'LinkedIn DM',
    value: 'linkedin.com/in/christianmacion',
    href: profile.contact.linkedin,
    external: true,
    use: 'DMs open · recruiter-friendly.',
    meta: { status: 'ACTIVE', date: '2026-08-14', response: '4h weekday' },
  },
  {
    label: 'Public work · proof',
    sub: 'GitHub',
    value: 'github.com/christianmacion26',
    href: profile.contact.github,
    external: true,
    use: `${profile.stats.repoCount} repos · runnable scorecards · reproducible methodology.`,
    meta: { status: 'ACTIVE', date: '2026-08-14', response: 'async, no SLA' },
  },
  {
    label: 'Writing · long-form',
    sub: 'Medium · twice monthly',
    value: 'medium.com/@christianmacion',
    href: profile.contact.medium,
    external: true,
    use: 'Quant research notes, multi-agent build logs, eval-harness write-ups. 2 posts / month.',
    meta: { status: 'ACTIVE', date: '2026-08-14', response: '2 posts / month' },
  },
  {
    label: 'Phone',
    sub: 'Sync, after email',
    value: profile.contact.phoneDisplay,
    href: `tel:${profile.contact.phone}`,
    use: 'UTC+8 · best 9 AM to 6 PM PHT.',
    meta: { status: 'ACTIVE', date: '2026-08-14', response: 'after email only' },
  },
];

const platforms = [
  {
    label: 'OnlineJobs.ph',
    value: 'v2.onlinejobs.ph/jobseekers/info/4760383',
    href: profile.contact.ojp,
    use: 'Filipino remote roles · OJP applications.',
    meta: { status: 'ACTIVE', date: '2026-08-14', response: '12h weekday' },
  },
  {
    label: 'Upwork',
    value: 'upwork.com/freelancers/~01785a76c001e4acd8',
    href: profile.contact.upwork,
    use: 'Contract engagements · hourly or fixed-price.',
    meta: { status: 'ACTIVE', date: '2026-08-14', response: '12h weekday' },
  },
];
---

<BaseLayout
  title="Contact"
  description={`Email ${profile.contact.email} with a JD, or reach me via LinkedIn, GitHub, or phone. Reply within 24h on weekdays.`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Contact', href: '/contact' },
  ]}
  surface="v6-13"
>
  <header class="contact-head" id="contact">
    <div class="container">
      <div class="contact-head__top">
        <div class="contact-head__copy">
          <p class="contact-head__eyebrow mono">
            <span class="contact-head__eyebrow-chip">CONTACT · 24H REPLY · NDA-SAFE</span>
            <span class="contact-head__eyebrow-line"
              >{channels.length} CHANNELS · JD-WITH-EMAIL GETS THE RICHEST REPLY</span
            >
          </p>
          <h1 class="contact-head__title" data-words>
            {channels.length} channels. <span class="hl">Pick the one that fits.</span>
          </h1>
          <VoiceLine class="contact-head__voice">
            Email-with-JD: richest reply. LinkedIn DM: casual. Phone: after email. Never first.
          </VoiceLine>
          <p class="contact-head__sub">
            Each tile names the job it does, not the platform. Email-with-JD path: problem →
            approach → evidence → outcome → proof.
          </p>

          <p class="contact-head__tenant mono">
            <span>CHRISTIAN.T.MACION</span>
            <span aria-hidden="true">·</span>
            <span>UTC+8</span>
            <span aria-hidden="true">·</span>
            <span>REMOTE-OK</span>
            <span aria-hidden="true">·</span>
            <span>4-BUSINESS-HOUR SLA</span>
          </p>
        </div>
      </div>

      <div class="contact-head__eq">
        <Equation
          latex={`\\text{response\\_time} \\leq 24 \\text{h} \\quad \\text{given} \\quad \\text{JD attached}`}
          size="md"
        />
      </div>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        {
          channels.map((c) => (
            <a
              class:list={['contact-card', { 'contact-card--primary': c.primary }]}
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
            >
              <div class="contact-card__label">
                {c.label}
                {c.external && (
                  <span class="contact-card__ext" aria-hidden="true">
                    ↗
                  </span>
                )}
              </div>
              <div class="contact-card__sub">{c.sub}</div>
              <div class="contact-card__value mono">{c.value}</div>
              <div class="contact-card__hint">{c.use}</div>
              {/* v13.1.4 (2026-08-11, contact-uplift) : per-channel
                  metadata. Status + date + response-time + commit hash.
                  Lives inside the card anchor so the meta stays visually
                  attached to the channel. Text only, no nested anchor. */}
              <div class="contact-card__meta mono">
                {c.meta.status} · {c.meta.date} · {c.meta.response} · commit <code>{CONTACT_COMMIT}</code>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* v14 (2026-08-23, contact-form) : visitor-can-send-email form.
      Owner directive: "to be able to send an email to me, just by the
      visitor to use the website and send." Privacy-preserving: no
      exposed address, mailto: fallback primary, CF Worker hook stub
      for back_end_engineer. Chrome contract v6.13: mono + amber +
      hairline + 0-2px radius. No halo, no glow. WCAG 2.2 AA: labels,
      focus rings, aria-live status. */}
  <section class="section section--form">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Send a message</p>
        <h2 class="section__title">No account. No tracking. One message lands in my inbox.</h2>
        <p class="section__sub">
          Fill the form, click Send. Opens your mail client prefilled, then sends through a
          privacy-preserving Cloudflare Worker if you'd rather skip the mail client. No exposed
          address, no third-party trackers, no newsletter. Same channel as
          <a href={`mailto:${profile.contact.email}`}>the email link above</a>: the form is the
          ergonomic surface; the wire stays the same.
        </p>
      </header>

      <form class="contact-form" data-contact-form data-recipient={profile.contact.email} aria-labelledby="contact-form-title" novalidate>
        <p class="contact-form__title mono" id="contact-form-title">MESSAGE</p>

        <div class="contact-form__row">
          <div class="contact-form__field">
            <label class="contact-form__label" for="cf-name">YOUR NAME</label>
            <input
              class="contact-form__input"
              id="cf-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              minlength="2"
              maxlength="80"
              aria-required="true"
              aria-describedby="cf-name-hint"
              placeholder="Jane Doe"
            />
            <p class="contact-form__hint" id="cf-name-hint">2-80 chars. Visible in the salutation.</p>
          </div>

          <div class="contact-form__field">
            <label class="contact-form__label" for="cf-email">YOUR EMAIL</label>
            <input
              class="contact-form__input"
              id="cf-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="120"
              aria-required="true"
              aria-describedby="cf-email-hint"
              placeholder="jane@example.com"
            />
            <p class="contact-form__hint" id="cf-email-hint">Reply lands here. Not displayed publicly.</p>
          </div>
        </div>

        <div class="contact-form__field">
          <label class="contact-form__label" for="cf-subject">SUBJECT</label>
          <input
            class="contact-form__input"
            id="cf-subject"
            name="subject"
            type="text"
            required
            minlength="3"
            maxlength="120"
            aria-required="true"
            placeholder="Hiring · partnership · press · other"
          />
        </div>

        <div class="contact-form__field">
          <label class="contact-form__label" for="cf-message">MESSAGE</label>
          <textarea
            class="contact-form__input contact-form__textarea"
            id="cf-message"
            name="message"
            required
            minlength="20"
            maxlength="4000"
            rows="7"
            aria-required="true"
            aria-describedby="cf-message-hint"
            placeholder="Tell me the job, the role, the timeline, or the ask. JD attached is the richest path; otherwise one paragraph is fine."
          ></textarea>
          <p class="contact-form__hint" id="cf-message-hint">
            <span data-contact-counter>0</span> / 4000 chars. Minimum 20.
          </p>
        </div>

        {/* Honeypot : hidden field that real users never fill. If a
            bot completes this field, the form silently fails. */}
        <div class="contact-form__honeypot" aria-hidden="true">
          <label for="cf-website">Website</label>
          <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="contact-form__actions">
          <button
            class="contact-form__btn contact-form__btn--primary mono"
            type="submit"
            data-contact-submit
          >
            <span data-contact-btn-label>SEND →</span>
          </button>
          <p class="contact-form__status mono" role="status" aria-live="polite" data-contact-status>
            READY · FILL THE FIELDS · CLICK SEND
          </p>
        </div>

        <p class="contact-form__privacy mono">
          Privacy: your email + message land in my inbox. Nothing is stored on this site, no
          newsletter opt-in, no third-party tracker. If the Worker is down the form falls back to a
          <code>mailto:</code> with the same fields prefilled.
        </p>
      </form>
    </div>
  </section>

  <section class="section section--book">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Book directly</p>
        <h2 class="section__title">Four open slots per week. 14-day rolling window. UTC+8.</h2>
        <p class="section__sub">
          Pick a slot that works. or reach me by any channel above if you'd rather start in
          writing. The screening agenda is pre-curated at
          <a href={path('/screening-call')}>/screening-call</a> so the first call starts with context,
          not discovery.
        </p>
      </header>
      <div class="book-shell">
        <iframe
          class="book-iframe"
          src="https://cal.com/christianmacion/30min-review?embed=true&theme=dark"
          title="Book a 30-minute review with Christian Macion on Cal.com"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allow="payment; camera; microphone"></iframe>
        <noscript>
          <p class="book-fallback">
            Calendar embed blocked. <a
              href="https://cal.com/christianmacion/30min-review"
              target="_blank"
              rel="noopener noreferrer">Open Cal.com in a new tab →</a
            >
          </p>
        </noscript>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Freelance platforms</p>
        <h2 class="section__title">If you're sourcing on a marketplace.</h2>
        <p class="section__sub">
          OJP/Upwork as supplementary, not first stop. Email-with-JD is the primary path.
        </p>
      </header>
      <div class="platforms-grid">
        {
          platforms.map((p) => (
            <a class="platform-card" href={p.href} target="_blank" rel="noopener noreferrer">
              <div class="platform-card__label mono">{p.label}</div>
              <div class="platform-card__value mono">{p.value}</div>
              <div class="platform-card__hint">{p.use}</div>
              {/* v13.1.4 (2026-08-11, contact-uplift) : per-platform
                  metadata line. Same register as the contact-card
                  meta. Text only, no nested anchor. */}
              <div class="platform-card__meta mono">
                {p.meta.status} · {p.meta.date} · {p.meta.response} · commit <code>{CONTACT_COMMIT}</code>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Reply shape</p>
        <h2 class="section__title">What to expect.</h2>
      </header>
      <ol class="how-i-reply">
        <li>
          <div class="how-i-reply__num mono">01</div>
          <div class="how-i-reply__body">
            <h3>Acknowledge within 24h</h3>
            <p>Short reply confirming receipt + when to expect the real response.</p>
          </div>
        </li>
        <li>
          <div class="how-i-reply__num mono">02</div>
          <div class="how-i-reply__body">
            <h3>Read the JD fully</h3>
            <p>
              End-to-end before replying. I surface the {GATE_RANGE} gates that already apply to your stack.
            </p>
          </div>
        </li>
        <li>
          <div class="how-i-reply__num mono">03</div>
          <div class="how-i-reply__body">
            <h3>Solution sketch</h3>
            <p>
              Structured response: problem → approach → evidence → outcome → proof pointer. Same shape as the
              solutions page.
            </p>
          </div>
        </li>
        <li>
          <div class="how-i-reply__num mono">04</div>
          <div class="how-i-reply__body">
            <h3>Tailored resume if appropriate</h3>
            <p>
              Open roles get a tailored PDF within 24h. {profile.stats.resumeCount} resume shapes exist
              (unified / AI-only / Quant one-pager).
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {/* v13.1.4 (2026-08-11, contact-uplift) : recency stamp at bottom.
      Anchors the page to its last content-edit commit. Same register as
      the /about/ `.about-recency` (polish-7t commit 3781944) and
      /work/ `.work-stamp` (polish-7p commit 9eba08f). Chrome contract v1:
      hairline rule + mono + 1 accent on hover; no halo, no glow. */}
  <p class="contact-recency mono">
    Last updated: 2026-08-14 · <a
      href={`https://github.com/christianmacion/christianmacion.github.io/commit/${CONTACT_COMMIT}`}
      target="_blank"
      rel="noopener noreferrer">commit {CONTACT_COMMIT}</a
    > · /contact/
  </p>
</BaseLayout>

<style>
  .contact-head {
    padding-block: var(--sp-9) var(--sp-7);
    background: var(--c-paper);
    border-bottom: var(--border);
  }
  .contact-head__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-5);
  }
  .contact-head__copy {
    flex: 1 1 auto;
    min-width: 0;
  }
  .contact-head__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    flex-wrap: wrap;
  }
  .contact-head__eyebrow-chip {
    display: inline-block;
    padding: 4px 10px;
    /* v9.2 a11y : was --c-phi-teal. Dark theme --j-phi-teal = #2d5f5a
     only hits 2.14:1 on dark page-head surface. Solid amber chip +
     --c-bg text reads at ≥5.6:1 in both themes : institutional
     register, F14-safe (no traffic-light). */
    color: var(--c-bg);
    border: 1px solid var(--c-amber);
    background: var(--c-amber);
    font-weight: 600;
  }
  .contact-head__eyebrow-line {
    color: var(--c-warn);
    font-weight: 600;
  }
  .contact-head__tenant {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-4) 0 0;
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    font-size: 0.78rem;
    color: var(--c-ink-2);
    letter-spacing: 0.06em;
  }
  .contact-head__tenant span:nth-child(odd) {
    color: var(--c-warn);
    font-weight: 600;
  }

  /* === Booking widget (Cal.com iframe embed) ===
     v6.18 : switched from <cal-inline> web-component (which rendered
     as an empty black box on cold load before the script hydrated) to
     a plain <iframe> pointing at /christianmacion/30min-review?embed=true.
     The iframe always loads; the embed mode in Cal.com's URL hides the
     chrome (header/footer) and renders the month_view inline. */
  .section--book {
    background: var(--c-bg-2);
    border-block: 1px solid var(--c-rule);
  }
  .book-shell {
    border: 1px solid var(--c-rule);
    background: var(--c-bg);
    padding: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .book-iframe {
    display: block;
    width: 100%;
    height: 720px;
    border: 0;
    background: var(--c-bg);
  }
  .book-fallback {
    font-family: var(--ff-mono);
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    padding: var(--sp-5);
    text-align: center;
  }

  @media (max-width: 640px) {
    .contact-head__top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .contact-head__title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-block: var(--sp-4) var(--sp-5);
  }
  .contact-head__sub {
    font-size: var(--fs-lg);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    max-width: 60ch;
    margin-bottom: var(--sp-6);
  }
  .contact-head__voice {
    margin: 0 0 var(--sp-4);
    max-width: 60ch;
  }
  .contact-head__eq {
    padding: var(--sp-4) var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    display: inline-block;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
  }
  .contact-card {
    display: block;
    padding: var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    color: var(--c-ink);
    text-decoration: none;
    transition:
      border-color var(--transition),
      transform var(--transition),
      box-shadow var(--transition);
  }
  .contact-card:hover {
    border-color: var(--c-primary);
    box-shadow: var(--shadow-md);
    color: var(--c-ink);
  }
  /* v6.10.33 : institutional: drop the F13-era amber gradient (rgba 212,160,23 stale).
     Lift via --c-bg-2 token; primary border remains to signal the hero variant. */
  .contact-card--primary {
    border-color: var(--c-primary);
    background: var(--c-bg-2);
  }
  .contact-card__label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-ink-2);
    margin-bottom: var(--sp-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .contact-card__ext {
    color: var(--c-amber);
    font-family: var(--ff-mono);
    font-size: var(--fs-sm);
  }
  .contact-card__value {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--c-primary);
    margin-bottom: var(--sp-2);
    word-break: break-word;
    overflow-wrap: break-word;
    line-height: 1.3;
  }
  .contact-card__sub {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--sp-1);
  }
  .contact-card__hint {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
  }
  /* v13.1.4 (2026-08-11, contact-uplift) : per-channel metadata line.
     Status + date + response-time + commit hash. Lives below the hint,
     footnote register. Same chrome as /about/ `.bio-prose__meta`
     (polish-7t commit 3781944) and /work/ `.work-live__meta`
     (polish-7p commit 9eba08f). Hairline rule + mono + 1 accent on
     hover; no halo, no glow, no gradient. */
  .contact-card__meta {
    margin-top: var(--sp-3);
    padding-top: var(--sp-2);
    border-top: 1px dashed var(--c-rule-soft);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
  .contact-card__meta code {
    font-family: var(--ff-mono);
    color: var(--c-ink-2);
    background: transparent;
    padding: 0;
  }

  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--sp-3);
  }
  .platform-card {
    display: block;
    padding: var(--sp-4);
    background: var(--c-bg);
    border: 1px solid var(--c-rule-soft);
    border-radius: var(--radius-sm);
    color: var(--c-ink);
    text-decoration: none;
    transition: border-color var(--transition);
  }
  .platform-card:hover {
    border-color: var(--c-ink-3);
    color: var(--c-ink);
  }
  .platform-card__label {
    font-size: var(--fs-xs);
    color: var(--c-ink-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--sp-2);
  }
  .platform-card__value {
    font-size: var(--fs-sm);
    color: var(--c-amber);
    margin-bottom: var(--sp-2);
    word-break: break-all;
  }
  .platform-card__hint {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
  }
  /* v13.1.4 (2026-08-11, contact-uplift) : per-platform metadata line.
     Same register as `.contact-card__meta`. Hairline divider + mono +
     ink-3 footnote. */
  .platform-card__meta {
    margin-top: var(--sp-3);
    padding-top: var(--sp-2);
    border-top: 1px dashed var(--c-rule-soft);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
  .platform-card__meta code {
    font-family: var(--ff-mono);
