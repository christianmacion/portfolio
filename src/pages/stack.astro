---
/**
 * stack.astro :  /stack/ · v9.8 Wave B tools + tech stack.
 *
 * What runs in production, what runs in dev, what is on the bench.
 * Single-source for the chrome that the /skills page references at a
 * higher level (this page is the inventory; /skills is the proficiency
 * matrix).
 *
 * Section layout (grid of stack-cards, 4 categories):
 *   02 :  tools and stack   (SectionMark)
 *   §    :  4 categories: language, data, infra, ai
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionMark from '@components/SectionMark.astro';
import SubpageHero from '@components/SubpageHero.astro';
import { buildStampUtc8 } from '@utils/build-stamp';

const subpage = {
  slug: 'stack',
  index: '02',
  title: 'tools and stack',
  pageTitle: 'Stack',
  description:
    'Tools, libraries, and infrastructure: what runs in production, what runs in dev, and what is on the bench.',
  chip: 'STACK · TOOLS · WHAT IS INSTALLED',
  // v11.W2 : financial-markets tag (task #4).
  roleLine: 'Stack for financial markets, quant research, and AI engineering',
};

const lastUpdated = buildStampUtc8();

/**
 * Verification fields (v13.1.4 polish-7o) :
 *   version : the pin actually resolved on this machine. Node/npm packages
 *             read from package-lock.json; Python packages from the local
 *             interpreter; protocols from the published spec revision.
 *   license : upstream license as declared by the package metadata.
 *   usedIn  : count of the 15 shipped projects under src/content/projects/
 *             (6 AI + 9 quant) whose declared `stack:` frontmatter lists
 *             the tool. Site-only tooling honestly reports 0.
 */
interface StackCard {
  category: string;
  items: Array<{
    name: string;
    tag: string;
    note: string;
    version: string;
    license: string;
    usedIn: string;
  }>;
}

const PROJECT_COUNT = 15; // 6 under projects/ai + 9 under projects/quant

const stack: StackCard[] = [
  {
    category: 'language & runtime',
    items: [
      {
        name: 'Python',
        tag: 'lang',
        version: '3.12+ (local 3.14.5)',
        license: 'PSF-2.0',
        usedIn: '15 of 15',
        note: 'Every shipped project is Python : backtests, RAG, judge harness, MCP server.',
      },
      {
        name: 'TypeScript',
        tag: 'lang',
        version: '5.9.3',
        license: 'Apache-2.0',
        usedIn: '0 of 15 · this site + tooling',
        note: 'Types the site, the content schemas, and the build scripts. No research code.',
      },
      {
        name: 'Astro',
        tag: 'framework',
        version: '7.2.0',
        license: 'MIT',
        usedIn: '0 of 15 · this site',
        note: 'Static-first, zero JS by default; islands only where a chart needs them.',
      },
      {
        name: 'Node',
        tag: 'runtime',
        version: '22 LTS (CI pin)',
        license: 'MIT',
        usedIn: '0 of 15 · build only',
        note: 'Runs the prebuild chain : resumes, OG image, GDELT pull, graph snapshot.',
      },
    ],
  },
  {
    category: 'data + numerics',
    items: [
      {
        name: 'NumPy',
        tag: 'numerics',
        version: '2.5.1',
        license: 'BSD-3-Clause',
        usedIn: '9 of 15',
        note: 'The array layer under every quant study : returns, bootstraps, null draws.',
      },
      {
        name: 'pandas',
        tag: 'data',
        version: '3.0.5',
        license: 'BSD-3-Clause',
        usedIn: '9 of 15',
        note: 'Panel alignment and resampling. Point-in-time joins, never a forward fill.',
      },
      {
        name: 'Matplotlib',
        tag: 'charts',
        version: '3.11.1',
        license: 'Matplotlib (BSD-style)',
        usedIn: '9 of 15',
        note: 'Equity curves and diagnostic panels rendered straight from the trade ledger.',
      },
      {
        name: 'TF-IDF cosine',
        tag: 'rag',
        version: 'from-scratch (stdlib)',
        license: 'own code · MIT',
        usedIn: '1 of 15',
        note: 'Retrieval for rag-recall : no vector DB, no API key, recall@3 = 0.886.',
      },
      {
        name: 'KaTeX',
        tag: 'math',
        version: '0.17.0',
        license: 'MIT',
        usedIn: '0 of 15 · site rendering',
        note: 'In-line equations on /skills, /methodology, /markets. Server-rendered, no runtime JS.',
      },
    ],
  },
  {
    category: 'infra + deploy',
    items: [
      {
        name: 'GitHub Pages',
        tag: 'host',
        version: 'actions/deploy-pages@v4',
        license: 'service (no license)',
        usedIn: '0 of 15 · hosts this site',
        note: 'One deploy target, no mirror. Every push to main ships the whole static build.',
      },
      {
        name: 'GitHub Actions',
        tag: 'ci',
        version: '7 workflows',
        license: 'service (no license)',
        usedIn: '0 of 15 · CI',
        note: 'Build, deploy gate, Lighthouse, a11y sweep, vibe audit, NDA guard, nightly GDELT.',
      },
      {
        name: 'Pagefind',
        tag: 'search',
        version: '1.5.2',
        license: 'MIT',
        usedIn: '0 of 15 · site search',
        note: 'Static index built postbuild. Search runs client-side with no backend.',
      },
      {
        name: 'Sharp',
        tag: 'assets',
        version: '0.35.3',
        license: 'Apache-2.0',
        usedIn: '0 of 15 · asset pipeline',
        note: 'Image optimisation and OG-card generation at build time.',
      },
    ],
  },
  {
    category: 'ai + eval',
    items: [
      {
        name: 'MCP',
        tag: 'protocol',
        version: 'spec rev 2025-06-18',
        license: 'MIT (spec)',
        usedIn: '1 of 15',
        note: 'eval-mcp-server implements all three primitives : Tools, Resources, Prompts.',
      },
      {
        name: 'OpenTelemetry GenAI',
        tag: 'tracing',
        version: 'semconv gen_ai.*',
        license: 'Apache-2.0',
        usedIn: '1 of 15',
        note: 'toolcall-agent emits spans per tool call, so failures are readable after the fact.',
      },
      {
        name: 'Streamlit',
        tag: 'demo',
        version: 'rolling (1.x)',
        license: 'Apache-2.0',
        usedIn: '2 of 15',
        note: 'Reviewer-facing front door for rag-recall and slop-scanner. One command to run.',
      },
      {
        name: 'axe-core',
        tag: 'a11y',
        version: '4.12.1',
        license: 'MPL-2.0',
        usedIn: '0 of 15 · site CI gate',
        note: 'WCAG 2.2 AA sweep on every route. Red axe run blocks the deploy gate.',
      },
    ],
  },
];
---

<BaseLayout
  title={subpage.pageTitle}
  description={subpage.description}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: subpage.pageTitle, href: `/${subpage.slug}` },
  ]}
>
  <SubpageHero slug={subpage.slug} label={subpage.pageTitle} roleLine={subpage.roleLine}>
    <p class="page-head__eyebrow mono">
      <span class="page-head__eyebrow-chip">{subpage.chip}</span>
      <span class="page-head__eyebrow-line">{stack.length} CATEGORIES · {stack.reduce((s, c) => s + c.items.length, 0)} ITEMS · VERSION + LICENSE PINNED</span>
    </p>
    <SectionMark index={subpage.index} title={subpage.title} ariaHidden={false} />
    <h2 class="page-head__title" data-words>
      What runs in prod. <span class="hl">Pinned, licensed, counted</span>.
    </h2>
    <p class="page-head__lede">
      The inventory, with the receipts. Every tool carries the version actually resolved on
      this machine, its upstream license, and how many of the {PROJECT_COUNT} shipped projects
      declare it. Site-only tooling reports zero rather than borrowing credit from the research
      work.
    </p>
  </SubpageHero>

  <div class="stack-body container">
    {
      stack.map((cat) => (
        <section class="stack-category" aria-labelledby={`stack-${cat.category.replace(/\s+/g, '-')}`} data-section-id="stack">
          <h2 class="stack-category__title" id={`stack-${cat.category.replace(/\s+/g, '-')}`}>
            {cat.category}
          </h2>
          <ul class="stack-grid" role="list">
            {
              cat.items.map((it) => (
                <li class="stack-card">
                  <div class="stack-card__head">
                    <h3 class="stack-card__name">{it.name}</h3>
                    <span class="stack-card__tag mono">{it.tag}</span>
                  </div>
                  <p class="stack-card__note">{it.note}</p>
                  <dl class="stack-card__meta mono">
                    <div class="stack-card__meta-row">
                      <dt>version</dt>
                      <dd>{it.version}</dd>
                    </div>
                    <div class="stack-card__meta-row">
                      <dt>license</dt>
                      <dd>{it.license}</dd>
                    </div>
                    <div class="stack-card__meta-row">
                      <dt>used in</dt>
                      <dd>{it.usedIn}</dd>
                    </div>
                  </dl>
                </li>
              ))
            }
          </ul>
        </section>
      ))
    }

    <p class="stack-stamp mono" aria-label="Last updated">
      LAST UPDATED · {lastUpdated} · UTC+8
    </p>
  </div>
</BaseLayout>

<style>
  .stack-body {
    padding-block: var(--sp-8);
  }
  .stack-category {
    margin-bottom: var(--sp-10);
  }
  .stack-category__title {
    font-size: var(--text-base, 1rem);
    font-weight: var(--font-weight-semibold, 600);
    color: var(--c-ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--c-rule);
    margin-bottom: var(--sp-5);
  }
  .stack-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--sp-4);
  }
  .stack-card {
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-sm, 0px);
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition:
      transform 200ms ease,
      border-color 200ms ease;
  }
  .stack-card:hover {
    transform: translateY(-2px);
    border-color: var(--c-amber);
  }
  .stack-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .stack-card__name {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--c-ink);
    margin: 0;
  }
  .stack-card__tag {
    font-size: 10px;
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 1px 6px;
    border: 1px solid var(--c-rule);
  }
  .stack-card__note {
    font-size: 13px;
    color: var(--c-ink-2);
    line-height: 1.45;
  }
  .stack-card__meta {
    margin: 0;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--c-rule);
    display: grid;
    gap: 3px;
    font-size: 11px;
    line-height: 1.4;
  }
  .stack-card__meta-row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .stack-card__meta dt {
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .stack-card__meta dd {
    margin: 0;
    color: var(--c-ink-2);
    text-align: right;
  }
  .stack-stamp {
    margin-top: var(--sp-10);
    font-size: 10.5px;
    color: var(--c-ink-3);
    letter-spacing: 0.06em;
    text-align: right;
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-card {
      transition: none;
    }
    .stack-card:hover {
      transform: none;
    }
  }
</style>
