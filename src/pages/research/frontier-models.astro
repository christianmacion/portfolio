  <section class="section section--alt">
    <div class="container container-narrow">
      <header class="section__head">
        <h2 class="section__title">Methodology</h2>
        <p class="section__sub">How the brief was produced.</p>
      </header>
      <div class="prose">
        <p>
          Produced by a multi-agent research pipeline: a research agent gathered and cross-checked
          primary sources (every headline number required two independent citations or an explicit
          single-source label); a cost-modeling agent computed task economics from verified prices;
          two independent verification gates then audited the draft — one for arithmetic,
          consistency, and claim-labeling; one for disclosure hygiene. Sources are footnoted
          throughout; figures were generated from the same verified tables. Every gap is declared in
          §9 of the brief (seven honest nulls and a nine-item do-not-use register) rather than
          filled.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <p class="updated mono">Last updated {PUBLISHED} · Independent research</p>
    </div>
  </section>

  <CTABanner
    title="Want the full corpus?"
    sub="The /research index lists every public-data systematic project. The /projects/quant and /projects/ai collections hold the long-form notes with code, gates, and reproducibility manifests."
    primaryLabel="Browse research"
    primaryHref={path('/research')}
    secondaryLabel="See methodology"
    secondaryHref={path('/methodology')}
  />
</BaseLayout>

<script>
  // Wire the copy-to-clipboard on the BibTeX card — mirrors the
  // /research/[...slug].astro pattern. Uses navigator.clipboard;
  // falls back to a hidden textarea for non-secure contexts.
  document.querySelectorAll<HTMLButtonElement>('.cite-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const card = btn.closest('.cite-card') as HTMLElement | null;
      const pre = card?.querySelector('pre.cite-bib code') as HTMLElement | null;
      const text = pre?.textContent ?? '';
      const labelEl = btn.querySelector('.cite-copy__label');
      const setLabel = (label: string) => {
        if (labelEl) labelEl.textContent = label;
      };
      try {
        await navigator.clipboard.writeText(text);
        setLabel('Copied');
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        try {
          // execCommand('copy') is deprecated but is the only path that
          // works in non-secure contexts. Cast via unknown to silence TS.
          (document as unknown as { execCommand: (cmd: string) => boolean }).execCommand('copy');
          setLabel('Copied');
        } catch {
          setLabel('Press ⌘C');
        }
        ta.remove();
      }
      setTimeout(() => setLabel('Copy BibTeX'), 1800);
    });
  });
</script>

