---
/**
 * research/frontier-models.astro — static route for the r3 frontier-models
 * consulting brief (PDF hosted at /research/frontier-models.pdf).
 *
 * Unlike /research/[...slug], this brief is NOT in the `project` collection —
 * it's a public research artifact (PDF only). This page exists so a
 * recruiter visiting /research/ can find, open, and read the brief from
 * the portfolio surface.
 *
 * v6.10.x institutional chrome — warm-dark, amber accent, sharp corners,
 * mono + 1 accent. Mirrors /research/[...slug].astro's discipline:
 *   - eyebrow / H1 / sub / italic abstract
 *   - executive summary (~200 words distilled from §1 of the PDF)
 *   - why this brief matters (4 bullets)
 *   - read the brief (CTA + size + page count)
 *   - cite this brief (BibTeX + copy-to-clipboard, matching existing pattern)
 *   - companion artifacts (PDF mirror, source MD, internal r1/r2 dossiers)
 *   - methodology note
 *   - last-updated stamp
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import Marquee from '@components/Marquee.astro';
import PulseRing from '@components/PulseRing.astro';
import { path } from '@utils/url';

const TITLE = 'Frontier Models for Quant Research & AI Engineering';
const PUBLISHED = '2026-07-18';
const PDF_SIZE_BYTES = 845924;
const PDF_PAGES = 18;
const PDF_SIZE_MB = (PDF_SIZE_BYTES / 1024 / 1024).toFixed(2);
const PDF_SIZE_KB = Math.round(PDF_SIZE_BYTES / 1024);
const CITATION_KEY = 'macion2026frontiermodels';
const CANONICAL_URL = 'https://christianmacion-portfolio.pages.dev/research/frontier-models/';
const YEAR = '2026';
const ISO_DATE = PUBLISHED;

// Label-only PDF size for the CTA — show KB on the link text.
const PDF_LABEL = `Open the ${PDF_PAGES}-page PDF · ${PDF_SIZE_KB} KB`;

const bibtex = `@techreport{${CITATION_KEY},
  author       = {Macion, Christian T.},
  title        = {${TITLE}: M3, Kimi K3, Claude Opus 4.8 (with Fable 5, GPT-5.6 Sol, Gemini 3 Pro as references)},
  institution  = {Independent research},
  year         = {${YEAR}},
  date         = {${ISO_DATE}},
  note         = {Public-shareable consulting brief. Sourced throughout; gaps declared.},
  url          = {${CANONICAL_URL}}
}`;

// Why this brief matters — 4 bullets mapping the brief to decision work.
const whyMatters = [
  {
    k: 'QUANT-RESEARCH WORKLOAD DECISION-MAKING',
    v: 'Routes six frontier models to the four workload classes a quant practice actually runs (bulk codegen, long-horizon synthesis, terminal-agentic execution, precision-critical writing). Distinguishes hygiene-check benchmarks (GPQA, saturated) from decision-moving ones (HLE, Terminal-Bench, cost-per-task).',
  },
  {
    k: 'AI-ENGINEERING AGENT / SYSTEM DESIGN',
    v: "Quantifies the cache break-even (f≈0.44) where Opus 4.8 undercuts K3 on input price; documents M3's vendor agentic numbers (Claw-Eval 74.5 #1; SWE-bench Pro 59.0); flags MCP/hooks/ecosystem maturity as a non-benchmarkable but decisive metric.",
  },
  {
    k: 'COST-PER-TASK ANALYSIS',
    v: 'Per-task arithmetic on four workload shapes (backtest codegen, research synthesis, agentic refactor, routine edits) at verified prices. M3 is structurally 10–20× cheaper than the middle tier on raw cost; the macro frame explains why open-weight-lineage prices have room to fall further.',
  },
  {
    k: 'MACRO US / CHINA CONTEXT',
    v: "Frames the price table against Stanford HAI's $285.9B US vs $12.4B China 2025 private-AI investment (23× ratio); explains the four-layer training-cost framework and why open-weight Chinese flagships are a strategic wedge against US-lab monetization.",
  },
];

// Companion artifacts the reader can open alongside the brief.
const companions = [
  {
    label: 'Frontier-models brief PDF (public mirror)',
    href: '/research/frontier-models.pdf',
    note: `${PDF_PAGES} pp · ${PDF_SIZE_KB} KB · letter format`,
    kind: 'pdf',
  },
  {
    label: 'Frontier-models brief — source markdown',
    href: '/research/frontier-models-source.md',
    note: 'public-shareable MD with figures and footnotes',
    kind: 'md',
  },
];
---

<BaseLayout
  title={`${TITLE} · Research brief`}
  description={`Public-shareable consulting brief comparing M3, Kimi K3, and Claude Opus 4.8 (with Fable 5, GPT-5.6 Sol, Gemini 3 Pro) for quant research + AI engineering. ${PDF_PAGES} pages.`}
  type="article"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Research', href: '/research' },
    { name: 'Frontier Models', href: '/research/frontier-models' },
  ]}
>
  <section class="hero" data-reveal id="hero">
    <div class="container container-narrow">
      <p class="eyebrow mono">
        <PulseRing label="r3 live" variant="live" color="warn" />
        <span>Model Intelligence Brief</span>
        <span aria-hidden="true">·</span>
        <span>{YEAR}</span>
        <span aria-hidden="true">·</span>
        <span class="mono">independent research</span>
      </p>
      <h1 class="hero__title" data-words>{TITLE}</h1>
      <p class="hero__sub">
        M3 · Kimi K3 · Claude Opus 4.8 — with Fable 5, GPT-5.6 Sol, and Gemini 3 Pro as reference
        points.
      </p>
      <p class="hero__abstract">
        <em
          >Six frontier-class models, one question: which earns the default seat in a quant-research
          and AI-engineering workflow — and what should route where. A metrics-first comparison,
          with every number sourced and every gap declared.</em
        >
      </p>
      <p class="hero__meta">
        <span class="meta__date mono">Published {PUBLISHED}</span>
        <span aria-hidden="true" class="meta__sep">·</span>
        <span class="mono">{PDF_PAGES} pp · {PDF_SIZE_MB} MB · letter PDF</span>
        <span aria-hidden="true" class="meta__sep">·</span>
        <span class="mono">Independent research</span>
      </p>
    </div>
  </section>

  {/* v7.4-WIDE — model ledger marquee between hero and exec summary. */}
  <Marquee
    items={[
      { head: 'M3', tail: '$0.30 / $1.20 · MARKET FLOOR', accent: 'warn' },
      { head: 'K3', tail: '1M CTX · TERMINAL-BENCH 88.3', accent: 'sage' },
      { head: 'OPUS 4.8', tail: '1M CTX · DEFAULT · CACHE-7.5%', accent: 'sage' },
      { head: 'FABLE 5', tail: '$10 / $50 · ENTERPRISE', accent: 'violet' },
      { head: 'GPT-5.6 SOL', tail: 'OPENAI · REFERENCE', accent: 'sage' },
      { head: 'GEMINI 3 PRO', tail: 'GOOGLE · REFERENCE', accent: 'sage' },
      { head: 'SWE-BENCH', tail: 'K3 76.8% · M3 59.0% · OPUS 71.4', accent: 'terracotta' },
      { head: 'HLE', tail: 'HUMANITY-LAST-EXAM · DECISION-MOVING', accent: 'warn' },
      { head: 'CLAW-EVAL', tail: 'M3 74.5 #1 · AGENTIC', accent: 'sage' },
      { head: 'CACHE BREAK', tail: 'f≈0.44 · OPUS UNDERCUTS K3', accent: 'sage' },
    ]}
    speedSec={64}
    trailing="r3 frontier-models ledger · 6 reference models"
  />

  <section class="section" id="summary">
    <div class="container container-narrow">
      <header class="section__head">
        <h2 class="section__title" data-words>Executive summary</h2>
        <p class="section__sub">
          Distilled from §1 of the brief. The full 18-page PDF walks through each claim with primary
          sources, an honest-nulls register, and a dated watch list.
        </p>
      </header>
      <div class="prose">
        <p>
          The landscape rearranged itself in 48 hours. On 16 July 2026 Moonshot shipped Kimi K3 — a
          2.8-trillion-parameter sparse MoE model at $3/$15 per million tokens — and within a day
          published agentic benchmarks that place it in the frontier cluster: Terminal-Bench 2.1
          88.3 (above Opus 4.8's 84.6, just under GPT-5.6 Sol's 88.8), MCP Atlas 84.2, and
          BrowseComp 91.2.
        </p>
        <p>
          The quieter finding is that M3 — the incumbent in this evaluation — is the market floor.
          M3's public pricing of $0.30/$1.20 per million tokens with a 1M-token context window is
          10–12.5× cheaper than K3 and roughly 17–21× cheaper than Opus 4.8 standard. M3 is not a
          weak model: vendor SWE-bench Verified is 80.5, and independently measured throughput of
          ~120–145 tokens/second is the fastest in this comparison by 2.3–5×.
        </p>
        <p>
          Capability per dollar now has three distinct tiers. Fable 5 ($10/$50) leads general
          reasoning and commands the highest price. The middle tier (K3, Opus 4.8, GPT-5.6 Sol,
          Gemini 3 Pro) trades blows within a few points on most benchmarks at $2–$30. M3 delivers
          90–95% of the middle tier's measured capability at one-tenth the price. The correct
          question is not "which model is best" but which tier each workload deserves.
        </p>
        <p>
          The recommendation: a three-tier routing policy — M3 for bulk and high-frequency work, K3
          for long-horizon synthesis and terminal-agentic tasks where its numbers genuinely lead,
          Opus 4.8 for cache-friendly agent loops and precision-critical writing — with Fable 5
          reserved for the small set of problems where being right is worth 2–4× the price. Section
          8 of the brief gives the full decision matrix and dated watch items.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="why">
    <div class="container container-narrow">
      <header class="section__head">
        <h2 class="section__title" data-words>Why this brief matters</h2>
        <p class="section__sub">
          Four threads — quant-research workload decisions, AI-engineering agent design, cost
          economics, and the US/China macro frame — that make this a load-bearing reference rather
          than a leaderboard recap.
        </p>
      </header>
      <ol class="why">
        {
          whyMatters.map((w) => (
            <li class="why__row">
              <span class="why__k mono">{w.k}</span>
              <p class="why__v">{w.v}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    /* === Model-release timeline — shared .ai-trend-grid primitive
       Pattern reused from /ai#ai-trends (Section 2c, v7.6).
       Each card: year chip + model release + the benchmark/feature
       that mattered for a quant-research workflow + lesson.
       CSS lives in src/styles/trend-grid.css (loaded by BaseLayout). */
  }
  <section
    class="section"
    id="model-timeline"
    data-toc-id="model-timeline"
    data-toc-label="Model-release timeline"
  >
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Frontier-model release timeline</p>
        <h2 class="section__title" data-words>Five releases that re-priced the field.</h2>
        <p class="section__sub">
          The brief compares six models in 2026; the timeline below shows the five releases between
          2023 and 2026 that made that comparison necessary. Each card carries the benchmark or
          feature that mattered for a quant-research workflow and the lesson that survived contact
          with the next year.
        </p>
      </header>

      <ol class="ai-trend-grid" aria-label="Frontier model releases 2023 to 2026">
        <li class="ai-trend">
          <p class="ai-trend__year mono">2023</p>
          <h3 class="ai-trend__name">GPT-4 · function calling</h3>
          <p class="ai-trend__body">
            <b>Release.</b> 2023-03 GPT-4. 2023-06 function calling + JSON-mode. The model becomes a tool
            user, not a search replacement.
          </p>
          <p class="ai-trend__body">
            <b>Then.</b> Single-shot prompting; no eval harness; ground truth = the model's claim.
          </p>
          <p class="ai-trend__body">
            <b>Lesson.</b> Grounding beats fluency. A tool-using model with a real corpus beats a fluent
            model hallucinating.
          </p>
        </li>

        <li class="ai-trend">
          <p class="ai-trend__year mono">2024</p>
          <h3 class="ai-trend__name">Sonnet 3.5 · Computer Use</h3>
          <p class="ai-trend__body">
            <b>Release.</b> 2024-06 Claude Sonnet 3.5. 2024-10 Anthropic Computer Use beta. SWE-bench
            Verified 60% — agents that read repos, run tests, ship patches.
          </p>
          <p class="ai-trend__body">
            <b>Then.</b> Solo agent with planner + tool belt. Eval harness measures plan quality, not
            just answer quality.
          </p>
          <p class="ai-trend__body">
            <b>Lesson.</b> The harness is the product. A long-context prompt is not an agent.
          </p>
        </li>

        <li class="ai-trend">
          <p class="ai-trend__year mono">2025</p>
          <h3 class="ai-trend__name">MCP · DeepSeek-R1</h3>
          <p class="ai-trend__body">
            <b>Release.</b> 2025-02 Anthropic MCP. 2025-Q1 DeepSeek-R1 ships reasoning on par with closed
            models at 1/30 the inference cost.
          </p>
          <p class="ai-trend__body">
            <b>Then.</b> Eval-driven rollout replaces vibe-driven rollout. The 5-must-have loop contract
            (terminal state, idempotent write, dedupe key, coverage filter, AAR) lands in production.
          </p>
          <p class="ai-trend__body">
            <b>Lesson.</b> A loop without a coverage filter is a leak. Pricing power moves to the team
            with the cheapest unit of verified work.
          </p>
        </li>

        <li class="ai-trend">
          <p class="ai-trend__year mono">2026</p>
          <h3 class="ai-trend__name">Opus 4.5 · Claw-Eval 74.5 #1</h3>
          <p class="ai-trend__body">
            <b>Release.</b> 2026-03 Claude Opus 4.5. Agentic eval Claw-Eval 74.5 — agentic leadership.
            MCP ecosystem maturity catches up.
          </p>
          <p class="ai-trend__body">
            <b>Then.</b> Multi-agent offices stop being demos and start compounding. Cache break-even
            (f ≈ 0.44) is where Opus undercuts K3 on input price for cache-heavy loops.
          </p>
          <p class="ai-trend__body">
            <b>Lesson.</b> The graph rung is where the office starts compounding. Without shared memory,
            every agent re-derives the corpus and shipping velocity collapses.
          </p>
          <a href={path('/research/frontier-models.pdf')} class="ai-trend__link">
            Brief § 4, 6 — agent economics →
          </a>
        </li>

        <li class="ai-trend">
          <p class="ai-trend__year mono">2026</p>
          <h3 class="ai-trend__name">Kimi K3 · Terminal-Bench 88.3</h3>
          <p class="ai-trend__body">
            <b>Release.</b> 2026-07-16 Kimi K3. 2.8T-param sparse MoE at $3/$15. Terminal-Bench 2.1 88.3
            (above Opus 4.8's 84.6).
          </p>
          <p class="ai-trend__body">
            <b>Then.</b> A three-tier routing policy becomes the default: M3 for bulk, K3 for long-horizon
            synthesis and terminal-agentic tasks, Opus 4.8 for cache-friendly agent loops and precision-critical
            writing.
          </p>
          <p class="ai-trend__body">
            <b>Lesson.</b> "Which model is best" is the wrong question. The right question is which tier
            each workload deserves.
          </p>
          <a href={path('/research/frontier-models.pdf')} class="ai-trend__link">
            Brief § 8 — decision matrix →
          </a>
        </li>
      </ol>

      <p class="section__sub" style="margin-top: var(--sp-5); max-width: 64ch;">
