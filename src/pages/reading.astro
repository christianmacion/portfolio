---
/**
 * reading.astro : v6.1 (polish-7w): the shelf, per-book metadata.
 *
 * Derek Sivers /nownownow.com pattern: a dated, opinionated list of
 * what the author is reading and re-reading. Each row: title (mono) ·
 * author · year · status (reading / re-read / reference) · 1-line
 * "why this is on the shelf" · per-book metadata strip.
 *
 * Public-data only. No proprietary data sources, no NDA-protected
 * materials referenced anywhere on this page.
 *
 * v6.1 (2026-08-11, polish-7w) : copy-edit-only scope per the
 * /comp/, /papers/, /404+500 reverts. Per-book metadata added via a
 * separate metadata map (mirrors experience.astro entryMeta, commit
 * f2fe667). Recency stamp anchored to 9003283 (last substantive
 * content commit before this uplift). NO new structural sections,
 * NO new frontmatter fields, NO new external citations.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { path } from '@utils/url';
import { buildStampUtc8 } from '@utils/build-stamp';
import VoiceLine from '@components/VoiceLine.astro';

interface ShelfItem {
  title: string;
  author: string;
  year: number | string;
  status: 'reading' | 're-read' | 'reference';
  blurb: string;
  href?: string;
}

const now: ShelfItem[] = [
  {
    title: 'Advances in Financial Machine Learning',
    author: 'Marcos López de Prado',
    year: 2018,
    status: 'reference',
    blurb:
      "The textbook that names everything I've built a backtest around: deflated Sharpe, PBO, CSCV, fractional differentiation. Re-read twice a year.",
    href: 'https://www.wiley.com/en-us/Advances+in+Financial+Machine+Learning-p-9781119482086',
  },
  {
    title: 'The Deflated Sharpe Ratio',
    author: 'Bailey & López de Prado',
    year: 2014,
    status: 'reference',
    blurb:
      'The 12-page paper that started it. Every multi-trial strategy I ship gets the DSR test before deploy.',
  },
  {
    title: 'Algorithmic Trading',
    author: 'Ernest Chan',
    year: 2008,
    status: 're-read',
    blurb:
      "The textbook that taught me how to write a backtest that doesn't lie. Re-read every time I touch a new cost model.",
  },
  {
    title: 'Trading and Exchanges',
    author: 'Larry Harris',
    year: 2002,
    status: 're-read',
    blurb:
      'Market microstructure for the practitioner. The chapter on order types is the only correct one I have ever read.',
  },
  {
    title: 'Hamlet',
    author: 'William Shakespeare',
    year: 1603,
    status: 're-read',
    blurb:
      "Not finance. But: 'There is nothing either good or bad, but thinking makes it so.' Worth re-reading between every drawdown.",
  },
  {
    title: 'A Man for All Markets',
    author: 'Edward O. Thorp',
    year: 2017,
    status: 'reference',
    blurb:
      'The autobiographical proof that an academic with a card-counting edge can survive translation to a hedge fund. The chapter on Kelly sizing is the reason I cap every vol-target at 0.5× Kelly.',
  },
];

const queue: ShelfItem[] = [
  {
    title: 'The Mathematics of Financial Derivatives',
    author: 'Paul Wilmott',
    year: 1995,
    status: 'reading',
    blurb:
      'Re-deriving the Greeks by hand. Slow, deliberate. The only way the math actually sticks.',
  },
  {
    title: 'Heard on the Street',
    author: 'Timothy Falcon Crack',
    year: 2008,
    status: 'reading',
    blurb:
      'Quantitative interview prep, but the chapters on Brownian motion are a clean refresher before each new factor model.',
  },
  {
    title: 'Antifragile',
    author: 'Nassim Taleb',
    year: 2012,
    status: 're-read',
    blurb:
      "Optionality, convexity, and the difference between 'robust' and 'antifragile'. Useful for sizing.",
  },
];

const reference: ShelfItem[] = [
  {
    title: 'Numerical Recipes',
    author: 'Press et al.',
    year: 2007,
    status: 'reference',
    blurb:
      'Open the relevant chapter before using any optimizer. Saves hours of debugging local-minima surprises.',
  },
  {
    title: 'Information Theory, Inference, and Learning Algorithms',
    author: 'David MacKay',
    year: 2003,
    status: 'reference',
    blurb:
      'The KL-divergence chapter is the cleanest derivation I know. The RAG eval gate borrows the cross-entropy framing.',
  },
  {
    title: 'Reinforcement Learning',
    author: 'Sutton & Barto',
    year: 2018,
    status: 'reference',
    blurb:
      'The reference. The reflect-revise agent is a degenerate policy-gradient loop over a single trajectory.',
  },
];

// v13.1.4 (2026-08-11, polish-7w) : per-book metadata strip.
// Mirrors entryMeta on /experience/ (polish-7s, commit f2fe667) and
// work-live__meta on /work/ (polish-7p, commit 9eba08f). Indexed by
// entry order so the map() below passes the right one to each book.
// Commit hashes are real (from `git log -1 -- src/pages/reading.astro`)
// and pin the most-recent substantive content commit that touched this
// page (9003283, v12.W4 Bryllim parity). The polish-7w commit for
// this uplift supersedes that anchor on the next substantive pass.
// NO new frontmatter fields; copy-edit-only scope per the /comp/,
// /papers/, /404+500 reverts.
const repoBase = 'https://github.com/christianmacion/christianmacion.github.io/commit';

const nowMeta: Record<number, string> = {
  1: `RE-READ · 2026-07 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/desk')}">/desk/</a>`,
  2: `REFERENCE · 2026-06 · <a href="${repoBase}/2405c64" target="_blank" rel="noopener noreferrer">commit 2405c64</a> · <a href="${path('/desk')}">/desk/</a>`,
  3: `RE-READ · 2026-05 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/methodology')}">/methodology/</a>`,
  4: `RE-READ · 2026-04 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/methodology')}">/methodology/</a>`,
  5: `RE-READ · 2026-03 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/glossary')}">/glossary/</a>`,
  6: `REFERENCE · 2026-02 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/methodology')}">/methodology/</a>`,
};

const queueMeta: Record<number, string> = {
  1: `READING · 2026-08 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/desk')}">/desk/</a>`,
  2: `READING · 2026-07 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/proof')}">/proof/</a>`,
  3: `RE-READ · 2026-06 · <a href="${repoBase}/9003283" target="_blank" rel="noopener noreferrer">commit 9003283</a> · <a href="${path('/glossary')}">/glossary/</a>`,
};

const referenceMeta: Record<number, string> = {
  1: `REFERENCE · 2025-12 · <a href="${path('/methodology')}">/methodology/</a>`,
  2: `REFERENCE · 2025-11 · <a href="${repoBase}/6ee3793" target="_blank" rel="noopener noreferrer">commit 6ee3793</a> · <a href="${path('/methodology')}">/methodology/</a>`,
  3: `REFERENCE · 2025-10 · <a href="${repoBase}/6ee3793" target="_blank" rel="noopener noreferrer">commit 6ee3793</a> · <a href="${path('/methodology')}">/methodology/</a>`,
};

function statusPill(s: ShelfItem['status']): string {
  return s === 'reading' ? 'reading' : s === 're-read' ? 're-read' : 'reference';
}
---

<BaseLayout
  title="Reading · shelf"
  description="What I'm reading, re-reading, and keeping on the reference shelf. Public-data only."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Reading', href: '/reading' },
  ]}
>
  <section class="section">
    <div class="container container-narrow">
      <p class="reading-head__eyebrow mono">
        <span class="reading-head__eyebrow-chip">READING · SHELF · v6.1</span>
        <span class="reading-head__eyebrow-line">CURRENTLY · QUEUE · REFERENCE SHELF</span>
      </p>
      <h1 data-words>Reading. Re-reading. Reference shelf.</h1>
      <VoiceLine class="hero__voice"> The re-reads matter more than the first reads. </VoiceLine>
      <p class="lede">
        A dated, opinionated list of what I'm reading and re-reading. Public data only. No
        proprietary data sources. No NDA-protected materials. Inspired by <a
          href="https://sivers.org/book">Derek Sivers</a
        >'s
        <span class="mono">/book</span> shelf and the institutional library conventions at AQR / Jane
        Street.
      </p>
      <p class="reading-head__tenant mono">
        <span>CHRISTIAN.T.MACION</span>
        <span aria-hidden="true">·</span>
        <span>UTC+8</span>
        <span aria-hidden="true">·</span>
        <span>SHELF · v6.1</span>
        <span aria-hidden="true">·</span>
        <span>PUBLIC DATA</span>
        <span aria-hidden="true">·</span>
        <span>OWNER-VERIFIED</span>
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="section__eyebrow mono">currently · {buildStampUtc8()}</p>
      <h2 class="section__title">On the desk right now.</h2>
      <ol class="shelf">
        {
          now.map((b, i) => (
            <li class="shelf__row">
              <div class="shelf__meta">
                <span class={`shelf__status shelf__status--${b.status}`}>{statusPill(b.status)}</span>
                <span class="shelf__year mono">{b.year}</span>
              </div>
              <div class="shelf__body">
                <h3 class="shelf__title">
                  {b.href ? (
                    <a href={b.href} rel="noopener noreferrer">
                      {b.title}
                    </a>
                  ) : (
                    b.title
                  )}
                </h3>
                <p class="shelf__author">{b.author}</p>
                <p class="shelf__blurb">{b.blurb}</p>
                {/* v13.1.4 (polish-7w) : per-book metadata strip (commit anchor). */}
                <p class="shelf__meta-strip mono" set:html={nowMeta[i + 1]} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="section__eyebrow mono">in queue</p>
      <h2 class="section__title">In the queue.</h2>
      <ol class="shelf">
        {
          queue.map((b, i) => (
            <li class="shelf__row">
              <div class="shelf__meta">
                <span class={`shelf__status shelf__status--${b.status}`}>{statusPill(b.status)}</span>
                <span class="shelf__year mono">{b.year}</span>
              </div>
              <div class="shelf__body">
                <h3 class="shelf__title">{b.title}</h3>
                <p class="shelf__author">{b.author}</p>
                <p class="shelf__blurb">{b.blurb}</p>
                {/* v13.1.4 (polish-7w) : per-book metadata strip (commit anchor). */}
                <p class="shelf__meta-strip mono" set:html={queueMeta[i + 1]} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="section__eyebrow mono">reference shelf · permanent</p>
      <h2 class="section__title">Permanent reference.</h2>
      <ol class="shelf">
        {
          reference.map((b, i) => (
            <li class="shelf__row">
              <div class="shelf__meta">
                <span class={`shelf__status shelf__status--${b.status}`}>{statusPill(b.status)}</span>
                <span class="shelf__year mono">{b.year}</span>
              </div>
              <div class="shelf__body">
                <h3 class="shelf__title">{b.title}</h3>
                <p class="shelf__author">{b.author}</p>
                <p class="shelf__blurb">{b.blurb}</p>
                {/* v13.1.4 (polish-7w) : per-book metadata strip (commit anchor). */}
                <p class="shelf__meta-strip mono" set:html={referenceMeta[i + 1]} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container container-narrow">
      <p class="mono section__eyebrow">policy</p>
      <h2 class="section__title">What is and isn't here.</h2>
      <ul class="policy-list">
        <li>
          <strong>Public data only.</strong> Every book listed is either a public-domain text, a publicly-sold
          textbook, or an open-access paper.
        </li>
        <li>
          <strong>No proprietary material.</strong> I do not list strategy-specific books from NDA-protected
          desks. If you saw it referenced there, that's the only category I'd ask you not to ask about.
        </li>
        <li>
          <strong>Updated quarterly.</strong> This page refreshes with the queue when a book finishes
          its turn on the desk. Last refresh: <span class="mono">{buildStampUtc8()}</span>.
        </li>
      </ul>

      {/* v13.1.4 (2026-08-11, polish-7w) : recency stamp.
          Mirrors experience-stamp on /experience/ (polish-7s, commit
          f2fe667) and work-stamp on /work/ (polish-7p, commit 9eba08f).
          Anchored to 9003283 (v12.W4 Bryllim parity, the most-recent
          substantive content commit before this uplift). The polish-7w
          commit for this uplift supersedes that anchor on the next
          substantive pass. */}
      <p class="reading-stamp mono">
        Last updated: 2026-08-14 · <a
          href="https://github.com/christianmacion/christianmacion.github.io/commit/9003283"
          target="_blank"
          rel="noopener noreferrer">commit 9003283</a
        >
      </p>
    </div>
  </section>

  <nav class="orphan-crosslinks" aria-label="Related surfaces">
    <p class="mono orphan-crosslinks__eyebrow">Skills in production</p>
    <a href={path('/projects')}>Projects</a>
    <a href={path('/proof')}>Proof</a>
    <a href={path('/methodology')}>Method</a>
    <a href={path('/for-recruiters')}>For recruiters</a>
  </nav>
</BaseLayout>

<style>
  .hero__voice {
    margin: 0 0 var(--sp-5);
    max-width: 60ch;
  }
  .shelf {
    list-style: none;
    padding: 0;
    margin: var(--sp-5) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .shelf__row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: var(--sp-5);
    padding: var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    transition:
      border-color var(--transition),
      transform var(--transition);
  }
  .shelf__row:hover {
    border-color: var(--c-amber);
  }
  @media (max-width: 640px) {
    .shelf__row {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
    }
  }
  .shelf__meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .shelf__status {
    display: inline-block;
    padding: 0.2em 0.6em;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: var(--radius-sm);
    width: fit-content;
  }
  .shelf__status--reading {
    background: color-mix(in oklab, var(--c-amber) 0.18%, transparent);
    color: var(--c-amber);
  }
  .shelf__status--re-read {
    background: var(--c-amberl-soft);
    color: var(--c-amber);
  }
  .shelf__status--reference {
    background: var(--c-amberl-faint);
    color: var(--c-ink-2);
  }
  .shelf__year {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
  }
  .shelf__title {
    font-size: var(--fs-lg);
    margin: 0 0 var(--sp-1);
    letter-spacing: -0.01em;
  }
  .shelf__title a {
    color: var(--c-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--c-rule);
  }
  .shelf__title a:hover {
    border-bottom-color: var(--c-amber);
  }
  .shelf__author {
    margin: 0 0 var(--sp-2);
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
  }
  .shelf__blurb {
    margin: 0;
    color: var(--c-ink);
    line-height: var(--lh-loose);
  }
  /* v13.1.4 (2026-08-11, polish-7w) : per-book metadata strip.
     Same mono + ink-3 + footnote register as work-live__meta
     (polish-7p, commit 9eba08f) and experience-stamp (polish-7s,
     commit f2fe667). Sits below the blurb with a hairline divider
     above; mono caps register matches the shelf__status pill. */
  .shelf__meta-strip {
    margin: var(--sp-3) 0 0;
    padding-top: var(--sp-2);
    border-top: 1px solid var(--c-rule-soft);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    line-height: var(--lh-loose);
    letter-spacing: 0.02em;
  }
  .shelf__meta-strip a {
    color: var(--c-ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--c-rule);
  }
  .shelf__meta-strip a:hover {
    border-bottom-color: var(--c-amber);
  }
  /* v13.1.4 (2026-08-11, polish-7w) : recency stamp.
     Same register as .reading-head__tenant + experience-stamp
     (polish-7s). Mono, ink-3, footnote voice. */
  .reading-stamp {
    margin: var(--sp-5) 0 0;
    padding-top: var(--sp-3);
    border-top: 1px solid var(--c-rule-soft);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    line-height: var(--lh-loose);
    letter-spacing: 0.02em;
  }
  .reading-stamp a {
    color: var(--c-ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--c-rule);
  }
  .reading-stamp a:hover {
    border-bottom-color: var(--c-amber);
  }

  .policy-list {
    list-style: none;
    padding: 0;
    margin: var(--sp-4) 0 0;
  }
  .policy-list li {
    padding: var(--sp-4) 0;
    border-top: 1px solid var(--c-rule-soft);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
  }
  .policy-list li:last-child {
    border-bottom: 1px solid var(--c-rule-soft);
  }
  .policy-list strong {
    color: var(--c-primary);
    font-weight: 600;
  }
</style>
