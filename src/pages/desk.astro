  .desk-map__corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 1px solid var(--c-ink);
    z-index: 2;
  }
  .desk-map__corner--tl { top: 4px;    left: 4px;   border-right: none; border-bottom: none; }
  .desk-map__corner--tr { top: 4px;    right: 4px;  border-left: none;  border-bottom: none; }
  .desk-map__corner--bl { bottom: 4px; left: 4px;   border-right: none; border-top: none; }
  .desk-map__corner--br { bottom: 4px; right: 4px;  border-left: none;  border-top: none; }
  .desk-map__frame::before {
    content: '';
    position: absolute;
    inset: -1px;
    pointer-events: none;
    border: 1px solid color-mix(in oklab, var(--c-amber) 0%, transparent);
    border-radius: var(--radius-md, 6px);
    /* v7.7.1 polish — soften the border pulse from 24% → 8% peak.
       Still keeps a hint of life on the institutional map chrome,
       but no longer reads as a halo. Reduced-motion guard below. */
    animation: desk-map-glow 6s ease-in-out infinite;
    z-index: 2;
  }
  @keyframes desk-map-glow {
    0%, 100% { border-color: color-mix(in oklab, var(--c-amber) 0%, transparent); }
    50%      { border-color: color-mix(in oklab, var(--c-amber) 8%, transparent); }
  }
  .desk-map__frame :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* === Events table === */
  .desk-events {
    padding: 56px 0;
    border-bottom: 1px solid var(--c-rule);
  }
  .desk-events__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-warn);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .desk-events__title {
    font: 600 28px / 1.2 var(--serif-display);
    color: var(--c-ink);
    letter-spacing: -0.018em;
    margin: 0 0 32px;
    max-width: 36ch;
  }
  .desk-events__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 13px;
  }
  .desk-events__table th {
    font: 500 10px / 1.4 var(--ff-mono);
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-align: left;
    padding: 12px 8px;
    border-bottom: 1px solid var(--c-rule);
  }
  .desk-events__table td {
    padding: 14px 8px;
    border-bottom: 1px dashed var(--c-rule);
    color: var(--c-ink);
    vertical-align: top;
  }
  .desk-events__row {
    animation: desk-row-in 0.5s cubic-bezier(.4,.7,.3,1) backwards;
    animation-delay: calc(var(--i, 0) * 90ms + 200ms);
    transition: background 0.2s ease;
  }
  .desk-events__row:hover {
    background: color-mix(in oklab, var(--c-amber) 4%, transparent);
  }
  @keyframes desk-row-in {
    from { opacity: 0; transform: translateX(-12px); }
    to   { opacity: 1; transform: none; }
  }
  .desk-events__col-num {
    width: 36px;
  }
  .desk-events__col-cat {
    width: 110px;
  }
  .desk-events__col-sev {
    width: 90px;
  }
  .desk-events__col-city {
    width: 140px;
  }
  .desk-events__num {
    color: var(--c-ink-3);
    font-size: 11px;
    font-weight: 500;
  }
  .desk-events__cat {
    font-size: 11px;
    color: var(--c-ink-2);
    letter-spacing: 0.04em;
  }
  .desk-events__pill {
    display: inline-block;
    padding: 2px 8px;
    border: 1px solid currentColor;
