    color: var(--c-ink-2);
  }

  /* === Responsive === */
  @media (max-width: 900px) {
    .desk-head__title {
      font-size: 36px;
    }
    .desk-events__title {
      font-size: 22px;
    }
    .desk-stats__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
    .desk-stats__grid--6 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 720px) {
    .desk-head {
      padding: 40px 0 32px;
    }
    .desk-events__col-cat {
      display: none;
    }
  }

  /* === v7.6.8 — reduced motion guard === */
  @media (prefers-reduced-motion: reduce) {
    .desk-stats__cell,
    .desk-events__row,
    .desk-events__pill--critical,
    .desk-map__frame::before {
      animation: none;
      opacity: 1;
    }
    .desk-events__row:hover {
      background: transparent;
    }
  }

  /* === v7.12 — desk events filter chips + anchor + counter ================ */
  .desk-events__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    margin: 24px 0 16px;
    padding: 12px 0;
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
    align-items: center;
  }
  .desk-events__chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }
  .desk-events__chip-label {
    color: var(--c-ink-3);
    font: 600 10px / 1.4 var(--ff-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-right: 2px;
  }
  .desk-events__chip-btn {
    appearance: none;
    background: transparent;
    border: 1px solid var(--c-rule);
    color: var(--c-ink-2);
    padding: 4px 10px;
    font: 600 10px / 1.4 var(--ff-mono);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 120ms ease,
      color 120ms ease,
      border-color 120ms ease;
  }
  .desk-events__chip-btn:hover:not(:disabled) {
    border-color: var(--c-ink-2);
    color: var(--c-ink);
  }
  .desk-events__chip-btn:focus-visible {
    outline: 2px solid var(--c-amber);
    outline-offset: 1px;
  }
  .desk-events__chip-btn--active {
    background: var(--c-ink);
    color: var(--c-bg);
    border-color: var(--c-ink);
  }
  .desk-events__chip-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .desk-events__chip-btn--critical { color: #8a1f1f; border-color: rgba(138,31,31,0.4); }
  .desk-events__chip-btn--critical:hover:not(:disabled) { background: rgba(138,31,31,0.06); }
  .desk-events__chip-btn--moderate { color: #8a6a2d; border-color: rgba(138,106,45,0.4); }
  .desk-events__chip-btn--moderate:hover:not(:disabled) { background: rgba(138,106,45,0.06); }
  .desk-events__chip-btn--mild { color: #2d6b3a; border-color: rgba(45,107,58,0.4); }
  .desk-events__chip-btn--mild:hover:not(:disabled) { background: rgba(45,107,58,0.06); }
  .desk-events__count {
    margin-left: auto;
    color: var(--c-ink-3);
    font: 600 11px / 1.4 var(--ff-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .desk-events__anchor {
    display: inline-block;
    width: 16px;
    color: var(--c-ink-3);
    text-decoration: none;
    opacity: 0;
    transition: opacity 120ms ease;
    margin-right: 4px;
  }
  .desk-events__row:hover .desk-events__anchor,
  .desk-events__row:focus-within .desk-events__anchor {
    opacity: 1;
  }
  .desk-events__anchor:hover { color: var(--c-amber); }
  .desk-events__row[data-desk-filtered="1"] { display: none; }
</style>

<script>
  /* === v7.12 — /desk events filter chips + URL persistence =============== */
  type CatKey = 'central-bank' | 'earnings' | 'geopolitical' | 'data-release' | 'fx' | 'all';
  type SevKey = 'critical' | 'moderate' | 'mild' | 'all';

  const catButtons = document.querySelectorAll<HTMLButtonElement>('[data-desk-cat]');
  const sevButtons = document.querySelectorAll<HTMLButtonElement>('[data-desk-sev]');
  const counter = document.querySelector<HTMLElement>('[data-desk-visible-count]');
  const rows = document.querySelectorAll<HTMLTableRowElement>('.desk-events__row');

  let activeCat: CatKey = 'all';
  let activeSev: SevKey = 'all';

  function readFilters(): void {
    const sp = new URLSearchParams(window.location.search);
    const c = sp.get('cat') ?? 'all';
    const s = sp.get('sev') ?? 'all';
    const validCat: CatKey[] = ['all', 'central-bank', 'earnings', 'geopolitical', 'data-release', 'fx'];
    const validSev: SevKey[] = ['all', 'critical', 'moderate', 'mild'];
    activeCat = (validCat as string[]).includes(c) ? (c as CatKey) : 'all';
    activeSev = (validSev as string[]).includes(s) ? (s as SevKey) : 'all';
  }
  function writeFilters(): void {
    const sp = new URLSearchParams(window.location.search);
    if (activeCat !== 'all') sp.set('cat', activeCat); else sp.delete('cat');
    if (activeSev !== 'all') sp.set('sev', activeSev); else sp.delete('sev');
    const qs = sp.toString();
    const next = `${window.location.pathname}${qs ? '?' + qs : ''}${window.location.hash}`;
    history.replaceState(null, '', next);
  }
  function applyFilters(): void {
    let visible = 0;
    for (const row of rows) {
      const cat = row.dataset.deskCat ?? '';
      const sev = row.dataset.deskSev ?? '';
      const ok = (activeCat === 'all' || cat === activeCat) && (activeSev === 'all' || sev === activeSev);
      if (ok) {
        row.removeAttribute('data-desk-filtered');
        visible++;
      } else {
        row.setAttribute('data-desk-filtered', '1');
      }
    }
    if (counter) counter.textContent = `${visible} VISIBLE`;
  }
  function setActiveButton(group: NodeListOf<HTMLButtonElement>, attr: string, value: string): void {
    for (const btn of group) {
      if ((btn.getAttribute(attr) ?? 'all') === value) {
        for (const other of group) other.classList.remove('desk-events__chip-btn--active');
        btn.classList.add('desk-events__chip-btn--active');
      }
    }
  }

  // Hydrate from URL first.
  readFilters();
  setActiveButton(catButtons, 'data-desk-cat', activeCat);
  setActiveButton(sevButtons, 'data-desk-sev', activeSev);
  applyFilters();

  for (const btn of catButtons) {
    btn.addEventListener('click', () => {
      activeCat = (btn.getAttribute('data-desk-cat') ?? 'all') as CatKey;
      setActiveButton(catButtons, 'data-desk-cat', activeCat);
      applyFilters();
      writeFilters();
    });
  }
  for (const btn of sevButtons) {
    btn.addEventListener('click', () => {
      activeSev = (btn.getAttribute('data-desk-sev') ?? 'all') as SevKey;
      setActiveButton(sevButtons, 'data-desk-sev', activeSev);
      applyFilters();
      writeFilters();
    });
  }
</script>

