---
/**
 * desk.astro : v7.5 THE DESK · 24h multi-asset coverage view.
 *
 * NDA-positive by construction. No employer or platform names; this
 * page is the public-facing "iron desk" view of the multi-agent office:
 *   - where coverage sits (venue cities)
 *   - what's scheduled to move (10 curated world events)
 *   - what's moving right now (50 GDELT signals, last 24h)
 *
 * Layout (top → bottom):
 *   1. MarketTape : scrolling equity tape
 *   2. Head : eyebrow + headline + lede + dual-path CTA
 *   3. EarthMap : 3-layer equirectangular world map
 *   4. World events table : 10 curated events with category / severity
 *   5. Coverage stats : venue count, event count, GDELT count, latency
 *   6. CTABanner : back to home / open /desk link
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import VoiceLine from '@components/VoiceLine.astro';
import MarketTape from '@components/MarketTape.astro';
import EarthMap from '@components/EarthMap.astro';
import CTABanner from '@components/CTABanner.astro';
import { getCollection } from 'astro:content';
import { profile, archSafe } from '@utils/profile';
import { path } from '@utils/url';
import { buildStampUtc8 } from '@utils/build-stamp';

// === Pull world events once, server-side, sort by order ===
interface WorldEventEntry {
  id: string;
  title: string;
  category: 'central-bank' | 'earnings' | 'geopolitical' | 'data-release' | 'fx';
  severity: 'mild' | 'moderate' | 'critical';
  lat: number;
  lon: number;
  city: string;
  source: string;
  order: number;
}
const eventEntries = await getCollection('worldEvent');
const events: WorldEventEntry[] = eventEntries
  .map((e: { id: string; data: WorldEventEntry }): WorldEventEntry => ({
    id: e.id,
    title: e.data.title,
    category: e.data.category,
    severity: e.data.severity,
    lat: e.data.lat,
    lon: e.data.lon,
    city: e.data.city,
    source: e.data.source,
    order: e.data.order,
  }))
  .sort((a: WorldEventEntry, b: WorldEventEntry) => a.order - b.order);

const email = profile.contact.email;
const mailto = `mailto:${email}?subject=QR%20%2F%20AI%20role%20%E2%80%94%20hiring%20inquiry`;

// === Position-row data (mirrors /positions paper-trade record) ===
// v13.1.4 polish-7o : persistence-tied snapshot. Same equity series
// + tradingDays + last-refreshed stamp as /positions, so the row on /desk
// is the same row that audits into the live paper-trade page. No
// fabricated live data — deterministic snapshot.
const equitySeries = [
  100.0, 100.4, 99.8, 100.9, 101.2, 100.7, 101.5, 102.1, 101.8, 102.4, 102.0, 101.4, 100.9, 101.6,
  102.3, 102.7, 103.1, 102.5, 101.9, 102.2, 102.8, 103.4, 102.9, 103.6, 104.2, 103.8, 104.5, 105.1,
  104.6, 105.3, 105.9, 106.4, 105.8, 106.6, 107.2, 107.8, 108.3, 107.6, 108.5, 109.2, 109.8, 109.1,
  109.9, 110.5, 111.0, 110.4, 111.2, 111.9, 111.3, 112.0,
];
const tradingDays = equitySeries.length;
const lastRefreshed = buildStampUtc8();

// === Event-category count for stats sub-line ===
// v13.1.4 polish-7o : derive category count from the curated events so
// the sub-line stays in sync when events are added/removed.
const eventCategories = new Set(events.map((e) => e.category)).size;
---

<BaseLayout
  title="The Desk"
  description={`24h multi-asset coverage to ${events.length} curated world events, ${archSafe.agentCount}-agent office, ${profile.stats.evalGates}-gate eval harness. NDA-positive by construction.`}
  surface="v6-13"
  theme="light"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'The Desk', href: '/desk' },
  ]}
>
  {/* === 1. MarketTape === */}
  <MarketTape />

  {/* === 1.5. Data-posture disclosure === */}
  <section class="desk-disclosure" aria-label="Data posture">
    <div class="container">
      <p class="desk-disclosure__line mono">
        <span class="desk-disclosure__chip">DATA POSTURE</span>
        Deterministic snapshot · 60s tape refresh · live book + terminal on
        <a href={path('/markets')}>/markets</a> · live paper-trade on
        <a href={path('/positions')}>/positions</a> (weekly manual refresh).
      </p>
      <p class="desk-disclosure__line mono">
        Events table, map, and stats are static for the build. The tape refreshes from Yahoo /
        CoinGecko / ECB; the order book is BUILD_DATE-seeded (no runtime refresh).
      </p>
    </div>
  </section>

  {/* === 2. Head === */}
  <header class="desk-head">
    <div class="container">
      <p class="desk-head__eyebrow mono">
        <span class="desk-head__eyebrow-chip">THE DESK · 24H COVERAGE · OPEN</span>
        <span class="desk-head__eyebrow-line"
          >{archSafe.agentCount}-AGENT OFFICE · {events.length} WORLD EVENTS · UTC+8</span
        >
      </p>
      <h1 class="desk-head__title" data-words>
        The world, in <span class="hl">24 hours</span>.
      </h1>
      <VoiceLine class="desk-head__voice">
        Coverage that proves it can be defended in interview. venue dots, scheduled events, and a
        24-hour signal overlay on the same equirectangular map.
      </VoiceLine>
      <p class="desk-head__sub">
        A backtest is what a strategy <em>would have done</em>. A paper-trade is what it <em
          >actually does</em
        >. The desk is what the multi-agent office <em>actually watches</em>n/a six research venues spanning
        APAC and the western exchanges, ten curated world events pinned to the calendar, and a rolling
        24-hour signal overlay so the office sees what is moving before the position-book reacts.
      </p>

      <div class="desk-head__cta">
        <a class="cta cta--primary" href={mailto}>EMAIL. HIRING INQUIRY</a>
        <a class="cta cta--ghost" href={path('/ai')}>READ THE LOOP →</a>
      </div>

      <p class="desk-head__tenant mono">
        <span>CHRISTIAN.T.MACION</span>
        <span aria-hidden="true">·</span>
        <span>UTC+8</span>
        <span aria-hidden="true">·</span>
        <span>{events.length} WORLD EVENTS</span>
        <span aria-hidden="true">·</span>
        <span>50+ GDELT SIGNALS</span>
        <span aria-hidden="true">·</span>
        <span>OWNER-VERIFIED</span>
      </p>
    </div>
  </header>

  {/* === 2.5. Position-row from /positions (deterministic; same source as /positions) === */}
  <section class="desk-posrow" aria-label="Live paper-trade position row">
    <div class="container">
      <p class="desk-posrow__eyebrow mono">
        LIVE PAPER-TRADE · POSITION ROW · FROM <a href={path('/positions')}>/positions</a>
      </p>
      <div class="desk-posrow__row" role="table">
        <div class="desk-posrow__cell desk-posrow__cell--name" role="rowheader">
          <span class="desk-posrow__rank mono">01</span>
          <div class="desk-posrow__name-text">
            <p class="desk-posrow__title">Vol-target time-series momentum · BTC/USDT</p>
            <p class="desk-posrow__sub mono">
              project 03 · {tradingDays} trading days · vol target 30% annualized · running since
              {profile.stats.positionsStartDate}
            </p>
          </div>
        </div>
        <div class="desk-posrow__metric" role="cell">
          <p class="desk-posrow__num mono">+12.0%</p>
          <p class="desk-posrow__lbl mono">RETURN</p>
        </div>
        <div class="desk-posrow__metric" role="cell">
          <p class="desk-posrow__num mono">≈0.39</p>
          <p class="desk-posrow__lbl mono">SHARPE ANN.</p>
        </div>
        <div class="desk-posrow__metric" role="cell">
          <p class="desk-posrow__num mono">−3.6%</p>
          <p class="desk-posrow__lbl mono">MAX DD</p>
        </div>
        <div class="desk-posrow__metric" role="cell">
          <p class="desk-posrow__num mono">4.2 bps</p>
          <p class="desk-posrow__lbl mono">SLIPPAGE</p>
        </div>
      </div>
      <p class="desk-posrow__tag mono">
        <span class="desk-posrow__chip">ACTIVE</span>
        Deterministic snapshot · same series as /positions · last refreshed {lastRefreshed}
      </p>
    </div>
  </section>

  {/* === 3. EarthMap : 3-layer world viz === */}
  <section class="desk-map" aria-label="Three-layer world map">
    <div class="container">
      <p class="desk-map__eyebrow mono">EARTH · VENUES · EVENTS · SIGNALS · 24H</p>
      <EarthMap width={1080} height={540} />
    </div>
  </section>

  {/* === 4. World events table === */}
  <section class="desk-events" aria-label="Curated world events">
    <div class="container">
      <p class="desk-events__eyebrow mono">{events.length} CURATED WORLD EVENTS</p>
      <h2 class="desk-events__title">The calendar that drives every position-book.</h2>

      <table class="desk-events__table">
        <colgroup>
          <col class="desk-events__col-num" />
          <col class="desk-events__col-cat" />
          <col class="desk-events__col-sev" />
          <col class="desk-events__col-title" />
          <col class="desk-events__col-city" />
        </colgroup>
        <thead>
          <tr>
            <th class="mono">#</th>
            <th class="mono">CAT</th>
            <th class="mono">SEV</th>
            <th>TITLE</th>
            <th class="mono">CITY</th>
          </tr>
        </thead>
        <tbody>
          {
            events.map((e) => (
              <tr>
                <td class="desk-events__num mono">{String(e.order).padStart(2, '0')}</td>
                <td class="desk-events__cat mono">{e.category}</td>
                <td class="desk-events__sev mono">
                  <span class={`desk-events__pill desk-events__pill--${e.severity}`}>
                    {e.severity.toUpperCase()}
                  </span>
                </td>
                <td class="desk-events__title-cell">{e.title}</td>
                <td class="desk-events__city mono">{e.city}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  {/* === 5. Coverage stats === */}
  <section class="desk-stats" aria-label="Coverage statistics">
    <div class="container">
      <p class="desk-stats__eyebrow mono">24H COVERAGE · DETERMINISTIC SNAPSHOT</p>
      <ul class="desk-stats__grid">
        <li class="desk-stats__cell">
          <p class="desk-stats__num mono">06</p>
          <p class="desk-stats__lbl mono">RESEARCH VENUES</p>
          <p class="desk-stats__sub mono">NYSE · NASDAQ · CME · ICE · HKEX · SGX</p>
        </li>
        <li class="desk-stats__cell">
          <p class="desk-stats__num mono">{events.length}</p>
          <p class="desk-stats__lbl mono">WORLD EVENTS</p>
          <p class="desk-stats__sub mono">{eventCategories} categories · curated weekly</p>
        </li>
        <li class="desk-stats__cell">
          <p class="desk-stats__num mono">50+</p>
          <p class="desk-stats__lbl mono">GDELT SIGNALS</p>
          <p class="desk-stats__sub mono">last 24h · 4 signal types</p>
        </li>
        <li class="desk-stats__cell">
          <p class="desk-stats__num mono">UTC+8</p>
          <p class="desk-stats__lbl mono">DESK TIMEZONE</p>
          <p class="desk-stats__sub mono">Digos, PH · 14h ahead of NYSE</p>
        </li>
      </ul>
    </div>
  </section>

  {/* === 6. CTA banner === */}
  <CTABanner
    title="Hire the operator, not the dashboard."
    sub={`${archSafe.agentCount}-agent multi-agent office · ${profile.stats.evalGates}-gate eval harness · ${profile.stats.locPython} LOC Python · NDA-clean by construction. Email below. reply within 24h.`}
    primaryHref={mailto}
    primaryLabel="EMAIL. HIRING INQUIRY"
    secondaryHref={path('/ai')}
    secondaryLabel="READ THE LOOP →"
  />
</BaseLayout>

<style>
  /* === Container === */
  .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* === Head === */
  .desk-head {
    padding: 56px 0 48px;
    border-bottom: 1px solid var(--c-rule);
  }
  .desk-head__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    flex-wrap: wrap;
  }
  .desk-head__eyebrow-chip {
    display: inline-block;
    padding: 4px 10px;
    /* v9.2 a11y : was --c-phi-teal. Dark theme --j-phi-teal = #2d5f5a
     only hits 2.14:1 on dark page-head surface. Solid amber chip +
     --c-bg text reads at ≥5.6:1 in both themes : institutional
     register, F14-safe (no traffic-light). */
    color: var(--c-bg);
    border: 1px solid var(--c-amber);
    background: var(--c-amber);
    font-weight: 600;
  }
  .desk-head__eyebrow-line {
    color: var(--c-warn);
    font-weight: 600;
  }
  .desk-head__tenant {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-4) 0 0;
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    font-size: 0.78rem;
    color: var(--c-ink-2);
    letter-spacing: 0.06em;
  }
  .desk-head__tenant span:nth-child(odd) {
    color: var(--c-warn);
    font-weight: 600;
  }
  .desk-head__title {
    font: 600 48px / 1 var(--j-ff-display);
    color: var(--c-ink);
    letter-spacing: -0.024em;
    margin: 0 0 24px;
    max-width: 18ch;
  }
  .desk-head__title .hl {
    font-style: italic;
    color: var(--c-amber);
  }
  .desk-head__voice {
    font: 500 16px / 1.5 var(--j-ff-display);
    color: var(--c-ink-2);
    font-style: italic;
    margin: 0 0 24px;
    max-width: 56ch;
  }
  .desk-head__sub {
    font: 400 15px / 1.6 var(--ff-sans);
    color: var(--c-ink);
    margin: 0 0 28px;
    max-width: 64ch;
  }
  .desk-head__sub em {
    font-family: var(--j-ff-display);
    font-style: italic;
    color: var(--c-warn);
    font-weight: 600;
  }
  .desk-head__cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* CTA (shared with home) */
  .cta {
    display: inline-block;
    padding: 14px 24px;
    font: 600 11px / 1 var(--ff-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--c-rule);
    cursor: pointer;
    transition:
      background 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
    background: transparent;
    color: var(--c-ink);
  }
  .cta--primary {
    background: var(--c-warn);
    color: var(--c-bg);
    border-color: var(--c-warn);
  }
  .cta--primary:hover {
    background: var(--c-amber);
    border-color: var(--c-amber);
  }
  .cta--ghost {
    background: transparent;
    color: var(--c-ink);
    border-color: var(--c-rule);
  }
  .cta--ghost:hover {
    color: var(--c-warn);
    border-color: var(--c-warn);
  }

  /* === Map === */
  .desk-map {
    padding: 48px 0 56px;
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg-2);
  }
  .desk-map__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-warn);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  /* === Disclosure strip === */
  /* v13.1.4 polish-7o : 2-line data-posture tie-in to /positions + /markets.
     Honest about cadence (tape 60s, positions manual, everything else static). */
  .desk-disclosure {
    padding: 18px 0 14px;
    background: var(--c-bg-2);
    border-bottom: 1px solid var(--c-rule);
  }
  .desk-disclosure__line {
    font-size: 11px;
    line-height: 1.6;
    color: var(--c-ink-2);
    margin: 0;
    letter-spacing: 0.04em;
    max-width: 80ch;
  }
  .desk-disclosure__line + .desk-disclosure__line {
    margin-top: 4px;
  }
  .desk-disclosure__chip {
    display: inline-block;
    padding: 2px 8px;
    margin-right: 10px;
    border: 1px solid var(--c-amber);
    background: var(--c-amber);
    color: var(--c-bg);
    font-weight: 600;
    letter-spacing: 0.08em;
    font-size: 10px;
  }
  .desk-disclosure__line a {
    color: var(--c-amber);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 3px;
    font-weight: 500;
  }

  /* === Position-row from /positions === */
  /* v13.1.4 polish-7o : compact row showing top-1 active paper-trade position.
     Same equity series as /positions (deterministic), no fabricated live data. */
  .desk-posrow {
    padding: 36px 0 40px;
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-rule);
  }
  .desk-posrow__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-warn);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 18px;
  }
  .desk-posrow__eyebrow a {
    color: var(--c-amber);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 3px;
  }
  .desk-posrow__row {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, 0.7fr);
    gap: 0;
    border: 1px solid var(--c-rule);
    background: var(--c-bg-2);
  }
  .desk-posrow__cell,
  .desk-posrow__metric {
    padding: 18px 20px;
    border-right: 1px solid var(--c-rule);
    min-width: 0;
  }
  .desk-posrow__cell:last-child,
  .desk-posrow__metric:last-child {
    border-right: 0;
  }
  .desk-posrow__cell--name {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .desk-posrow__rank {
    font-size: 11px;
    font-weight: 600;
    color: var(--c-ink-3);
    letter-spacing: 0.1em;
    padding-top: 2px;
  }
  .desk-posrow__name-text {
    min-width: 0;
  }
  .desk-posrow__title {
    font: 500 14px / 1.4 var(--ff-sans);
    color: var(--c-ink);
    margin: 0 0 4px;
    letter-spacing: -0.005em;
  }
  .desk-posrow__sub {
    font-size: 10.5px;
    color: var(--c-ink-3);
    letter-spacing: 0.04em;
    margin: 0;
  }
  .desk-posrow__metric {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
  }
  .desk-posrow__num {
    font: 600 22px / 1 var(--j-ff-display);
    color: var(--c-ink);
    letter-spacing: -0.02em;
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  .desk-posrow__lbl {
    font: 500 9.5px / 1.2 var(--ff-mono);
    color: var(--c-ink-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }
  .desk-posrow__tag {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 14px 0 0;
    font-size: 10.5px;
    color: var(--c-ink-3);
    letter-spacing: 0.04em;
  }
  .desk-posrow__chip {
    padding: 2px 8px;
    border: 1px solid var(--c-amber);
    background: var(--c-amber);
    color: var(--c-bg);
    font-weight: 600;
    letter-spacing: 0.08em;
    font-size: 10px;
  }

  /* === Events table === */
  .desk-events {
    padding: 56px 0;
    border-bottom: 1px solid var(--c-rule);
  }
  .desk-events__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-warn);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .desk-events__title {
    font: 600 28px / 1.2 var(--j-ff-display);
    color: var(--c-ink);
    letter-spacing: -0.018em;
    margin: 0 0 32px;
    max-width: 36ch;
  }
  .desk-events__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font-size: 13px;
  }
  .desk-events__table th {
    font: 500 10px / 1.4 var(--ff-mono);
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-align: left;
    padding: 12px 8px;
    border-bottom: 1px solid var(--c-rule);
  }
  .desk-events__table td {
    padding: 14px 8px;
    border-bottom: 1px dashed var(--c-rule);
    color: var(--c-ink);
    vertical-align: top;
  }
  .desk-events__col-num {
    width: 36px;
  }
  .desk-events__col-cat {
    width: 110px;
  }
  .desk-events__col-sev {
    width: 90px;
  }
  .desk-events__col-city {
    width: 140px;
  }
  .desk-events__num {
    color: var(--c-ink-3);
    font-size: 11px;
    font-weight: 500;
  }
  .desk-events__cat {
    font-size: 11px;
    color: var(--c-ink-2);
    letter-spacing: 0.04em;
  }
  .desk-events__pill {
    display: inline-block;
    padding: 2px 8px;
    border: 1px solid currentColor;
    font: 500 9.5px / 1.4 var(--ff-mono);
    letter-spacing: 0.1em;
  }
  .desk-events__pill--critical {
    color: var(--c-amber);
  }
  .desk-events__pill--moderate {
    color: var(--c-amber);
  }
  .desk-events__pill--mild {
    color: var(--c-ink-2);
  }
  .desk-events__title-cell {
    font: 500 14px / 1.4 var(--ff-sans);
    color: var(--c-ink);
  }
  .desk-events__city {
    font-size: 11px;
    color: var(--c-ink-2);
  }

  /* === Stats grid === */
  .desk-stats {
    padding: 48px 0 56px;
    background: var(--c-bg-2);
    border-bottom: 1px solid var(--c-rule);
