  }
  .desk-map__frame {
    overflow: hidden;
    border-radius: var(--radius-md, 6px);
    border: 1px solid var(--c-rule);
    /* v7.7.4 — square frame to match the 600×600 orthographic globe.
       Prior 2/1 aspect-ratio letterboxed the square globe with empty
       space left + right; user feedback "the earth is not centered and
       usable" → frame now hugs the globe. */
    aspect-ratio: 1 / 1;
    max-width: 720px;
    margin: 0 auto;
    position: relative;
  }

  /* === v7.8.0 — research-power readout beneath the globe ===
     Two bar charts (continent + domain) + one story paragraph.
     Each bar is a single CSS line — mono small-caps, hairline
     track, cobalt fill, hairline numeral at the end. The story
     paragraph tells the viewer what the globe is actually showing. */
  .desk-research {
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr;
    gap: 24px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--c-rule);
  }
  .desk-research__col--story {
    border-left: 1px solid var(--c-rule);
    padding-left: 24px;
