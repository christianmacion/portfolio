      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }
    .desk-events__chips {
      flex-direction: column;
      align-items: stretch;
    }
    .desk-events__chip-btn {
      width: 100%;
      text-align: left;
    }
  }
</style>

<script>
  /* === v7.12 — /desk events filter chips + URL persistence =============== */
  type CatKey = 'central-bank' | 'earnings' | 'geopolitical' | 'data-release' | 'fx' | 'all';
  type SevKey = 'critical' | 'moderate' | 'mild' | 'all';

  const catButtons = document.querySelectorAll<HTMLButtonElement>('[data-desk-cat]');
  const sevButtons = document.querySelectorAll<HTMLButtonElement>('[data-desk-sev]');
  const cityButtons = document.querySelectorAll<HTMLButtonElement>('[data-desk-city]');
  const counter = document.querySelector<HTMLElement>('[data-desk-visible-count]');
  const rows = document.querySelectorAll<HTMLTableRowElement>('.desk-events__row');

  let activeCat: CatKey = 'all';
  let activeSev: SevKey = 'all';
  let activeCity = 'all';

  function readFilters(): void {
    const sp = new URLSearchParams(window.location.search);
    const c = sp.get('cat') ?? 'all';
    const s = sp.get('sev') ?? 'all';
    const city = sp.get('city') ?? 'all';
    const validCat: CatKey[] = [
      'all',
      'central-bank',
      'earnings',
      'geopolitical',
      'data-release',
      'fx',
    ];
    const validSev: SevKey[] = ['all', 'critical', 'moderate', 'mild'];
    activeCat = (validCat as string[]).includes(c) ? (c as CatKey) : 'all';
    activeSev = (validSev as string[]).includes(s) ? (s as SevKey) : 'all';
    activeCity = city;
  }
  function writeFilters(): void {
    const sp = new URLSearchParams(window.location.search);
    if (activeCat !== 'all') sp.set('cat', activeCat);
    else sp.delete('cat');
    if (activeSev !== 'all') sp.set('sev', activeSev);
    else sp.delete('sev');
    if (activeCity !== 'all') sp.set('city', activeCity);
    else sp.delete('city');
    const qs = sp.toString();
    const next = `${window.location.pathname}${qs ? '?' + qs : ''}${window.location.hash}`;
    history.replaceState(null, '', next);
  }
  function applyFilters(): void {
    let visible = 0;
    for (const row of rows) {
      const cat = row.dataset.deskCat ?? '';
      const sev = row.dataset.deskSev ?? '';
      const city = row.dataset.deskCity ?? '';
      const ok =
        (activeCat === 'all' || cat === activeCat) &&
        (activeSev === 'all' || sev === activeSev) &&
        (activeCity === 'all' || city === activeCity);
      if (ok) {
        row.removeAttribute('data-desk-filtered');
        visible++;
      } else {
        row.setAttribute('data-desk-filtered', '1');
      }
    }
    if (counter) counter.textContent = `${visible} VISIBLE`;
  }
  function setActiveButton(
    group: NodeListOf<HTMLButtonElement>,
    attr: string,
    value: string,
  ): void {
    for (const btn of group) {
      if ((btn.getAttribute(attr) ?? 'all') === value) {
        for (const other of group) other.classList.remove('desk-events__chip-btn--active');
        btn.classList.add('desk-events__chip-btn--active');
      }
    }
  }

  // Hydrate from URL first.
  readFilters();
  setActiveButton(catButtons, 'data-desk-cat', activeCat);
  setActiveButton(sevButtons, 'data-desk-sev', activeSev);
  setActiveButton(cityButtons, 'data-desk-city', activeCity);
  applyFilters();

  for (const btn of catButtons) {
    btn.addEventListener('click', () => {
      activeCat = (btn.getAttribute('data-desk-cat') ?? 'all') as CatKey;
      setActiveButton(catButtons, 'data-desk-cat', activeCat);
      applyFilters();
      writeFilters();
    });
  }
  for (const btn of sevButtons) {
    btn.addEventListener('click', () => {
      activeSev = (btn.getAttribute('data-desk-sev') ?? 'all') as SevKey;
      setActiveButton(sevButtons, 'data-desk-sev', activeSev);
      applyFilters();
      writeFilters();
    });
  }
  for (const btn of cityButtons) {
    btn.addEventListener('click', () => {
      activeCity = btn.getAttribute('data-desk-city') ?? 'all';
      setActiveButton(cityButtons, 'data-desk-city', activeCity);
      applyFilters();
      writeFilters();
    });
  }

  /* === v7.14 — share button: copy filtered URL to clipboard =============== */
  const shareBtn = document.querySelector<HTMLButtonElement>('[data-desk-share]');
  shareBtn?.addEventListener('click', () => {
    const url = window.location.href;
    const flash = (text: string): void => {
      const orig = shareBtn.textContent ?? '';
      shareBtn.textContent = text;
      shareBtn.setAttribute('data-copied', '1');
      window.setTimeout(() => {
        shareBtn.textContent = orig;
        shareBtn.removeAttribute('data-copied');
      }, 1400);
    };
    if (navigator.clipboard?.writeText) {
      navigator.clipboard
        .writeText(url)
        .then(() => flash('COPIED · LINK'))
        .catch(() => flash('COPY · FAILED'));
    } else {
      flash('COPY · UNSUPPORTED');
    }
  });

  /* === v7.27 — per-row permalink copy button (replaces nested <a>) ======== */
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation(); // don't toggle the row
      const hash = btn.dataset.copyLink ?? '';
      const url = window.location.origin + window.location.pathname + hash;
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(url).catch(() => {});
      }
    });
  });

  /* === v7.20 — click/keyboard row expand for event detail ================== */
  function toggleRow(row: HTMLTableRowElement): void {
    const id = row.dataset.deskRow;
    if (!id) return;
    const detail = document.querySelector<HTMLTableRowElement>(`[data-desk-detail="${id}"]`);
    if (!detail) return;
    const expanded = row.getAttribute('data-desk-expanded') === '1';
    if (expanded) {
      row.removeAttribute('data-desk-expanded');
      detail.hidden = true;
    } else {
      row.setAttribute('data-desk-expanded', '1');
      detail.hidden = false;
    }
  }
  for (const row of rows) {
    row.addEventListener('click', (ev) => {
      // Don't toggle when the click was on the anchor permalink.
      const target = ev.target as HTMLElement | null;
      if (target?.closest('a')) return;
      toggleRow(row);
    });
    row.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        toggleRow(row);
      }
    });
  }
</script>
