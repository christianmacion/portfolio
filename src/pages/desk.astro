---
/**
 * desk.astro — v7.7.0 THE DESK · 24h multi-asset coverage view.
 *
 * v7.6.8 polish — owner ask 2026-07-27: "improve the UI/UX of hub. make
 * stella work on it and make it same quality as the login and main page.
 * world class. perfection in motion graphics and designs. do full audit
 * and fix all bugs."
 *
 * v7.7.0 — live-world: ArxivRadar (research preprints) + LiveWire (macro
 * wire headlines) slots added. EarthMap upgraded in place (severity-
 * weighted Layer C, hairline arcs to venue cities, last-sync chrome).
 * KPI cell "GDELT SIGNALS" → "GLOBAL SIGNALS" (sum across 3 feeds).
 *
 * Layout (top → bottom):
 *   1. MarketTape — scrolling equity tape
 *   2. Head — eyebrow + headline + voice + sub + dual-path CTA
 *   3. KPI strip — 4 count-up stats (venues / events / signals / tz)
 *   4. Marquee — methodology frame loop
 *   4b. ArxivRadar — 5-category research preprint ticker + grid
 *   5. EarthMap — 3-layer equirectangular world map (upgraded)
 *   6. LiveStats — instrument panel (4 cards, perp sparkline animation)
 *   7. World events table — 10 curated events with row stagger
 *   7b. LiveWire — 4-source macro wire ticker (Reuters/CoinDesk/Block/CoinTelegraph)
 *   8. LiveActivity — tail-of-the-loop event log
 *   9. CTABanner — back to home / open /desk link
 *
 * NDA-positive by construction. No employer or platform names; this
 * page is the public-facing "iron desk" view of the multi-agent office.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import VoiceLine from '@components/VoiceLine.astro';
import MarketTape from '@components/MarketTape.astro';
import NewsRibbon from '@components/NewsRibbon.astro';
import EarthMap from '@components/EarthMap.astro';
import Marquee from '@components/Marquee.astro';
import ArxivRadar from '@components/ArxivRadar.astro';
import LiveWire from '@components/LiveWire.astro';
import LiveStats from '@components/LiveStats.astro';
import LiveActivity from '@components/LiveActivity.astro';
import CTABanner from '@components/CTABanner.astro';
import { getCollection } from 'astro:content';
import { profile, archSafe } from '@utils/profile';
import { path } from '@utils/url';
import arxivCache from '../data/arxiv-cache.json';
import macrowireCache from '../data/macrowire-cache.json';
import gdeltCache from '../data/gdelt-cache.json';
import { INSTITUTIONS, INSTITUTION_STATS } from '../data/institutions';

// === Pull world events once, server-side, sort by order ===
interface WorldEventEntry {
  id: string;
  title: string;
  category: 'central-bank' | 'earnings' | 'geopolitical' | 'data-release' | 'fx';
  severity: 'mild' | 'moderate' | 'critical';
  lat: number;
  lon: number;
  city: string;
  source: string;
  order: number;
}
const eventEntries = await getCollection('worldEvent');
const events: WorldEventEntry[] = eventEntries
  .map((e: { id: string; data: WorldEventEntry }): WorldEventEntry => ({
    id: e.id,
    title: e.data.title,
    category: e.data.category,
    severity: e.data.severity,
    lat: e.data.lat,
    lon: e.data.lon,
    city: e.data.city,
    source: e.data.source,
    order: e.data.order,
  }))
  .sort((a: WorldEventEntry, b: WorldEventEntry) => a.order - b.order);

// === v7.12 — category + severity counts for filter chips =================
const CATEGORY_LABELS: Record<WorldEventEntry['category'], string> = {
  'central-bank': 'CB',
  earnings: 'ERN',
  geopolitical: 'GEO',
  'data-release': 'DAT',
  fx: 'FX',
};
const CATEGORY_ORDER: WorldEventEntry['category'][] = ['central-bank', 'earnings', 'geopolitical', 'data-release', 'fx'];
const SEVERITY_ORDER: WorldEventEntry['severity'][] = ['critical', 'moderate', 'mild'];
const categoryCounts: Record<WorldEventEntry['category'], number> = {
  'central-bank': 0, earnings: 0, geopolitical: 0, 'data-release': 0, fx: 0,
};
const severityCounts: Record<WorldEventEntry['severity'], number> = {
  critical: 0, moderate: 0, mild: 0,
};
for (const e of events) {
  categoryCounts[e.category]++;
  severityCounts[e.severity]++;
}

// === v7.7.1 — derive global-signal count from cache JSONs ===
// Sum across arxiv papers + macrowire headlines + gdelt events. The
// chrome reads "N+ SIGNALS" — the actual count, never hardcoded.
const arxivItems = (arxivCache as { items?: unknown[] }).items?.length ?? 0;
const macrowireItems = (macrowireCache as { items?: unknown[] }).items?.length ?? 0;
const gdeltItems = (gdeltCache as { events?: unknown[] }).events?.length ?? 0;
const globalSignals = arxivItems + macrowireItems + gdeltItems;

// === v7.8.0 — research-venue KPI strip ===
// INSTITUTIONS table now carries 56 venues with researchDomains + tier.
// Chrome reads the actual count (was hardcoded to "06" before).
const venueCount = INSTITUTIONS.length;
const t1Count = INSTITUTION_STATS.byTier.t1;
const continents = Object.keys(INSTITUTION_STATS.byContinent).length;

const email = profile.contact.email;
const mailto = `mailto:${email}?subject=QR%20%2F%20AI%20role%20%E2%80%94%20hiring%20inquiry`;
---

<BaseLayout
  title="The Desk"
  description={`24h multi-asset coverage — ${events.length} curated world events, ${archSafe.agentCount}-agent office, ${globalSignals}+ live signals across arXiv + macro-wire + GDELT. NDA-positive by construction.`}
  surface="v6-13"
  theme="light"
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'The Desk', href: '/desk' },
  ]}
>
  {/* === 1. MarketTape === */}
  <MarketTape />

  {/* === 2. Head === */}
  <header class="desk-head" data-reveal>
    <div class="container">
      <p class="desk-head__eyebrow mono">
        <span class="status-dot" aria-hidden="true"></span>
        THE DESK · {archSafe.agentCount}-AGENT OFFICE · {events.length} WORLD EVENTS · OPEN
      </p>
      <h1 class="desk-head__title" data-words>
        The world, in <span class="hl">24 hours</span>.
      </h1>
      <VoiceLine class="desk-head__voice">
        Coverage that proves it can be defended in interview — venue dots, scheduled events, and a
        24-hour signal overlay on the same equirectangular map.
      </VoiceLine>
      <p class="desk-head__sub">
        A backtest is what a strategy <em>would have done</em>. A paper-trade is what it <em
          >actually does</em
        >. The desk is what the multi-agent office
        <em>actually watches</em> — six research venues spanning APAC and the western exchanges, ten curated
        world events pinned to the calendar, and a rolling 24-hour signal overlay so the office sees what
        is moving before the position-book reacts.
      </p>

      <div class="desk-head__cta">
        <a class="cta cta--primary" href={mailto}>EMAIL — HIRING INQUIRY</a>
        <a class="cta cta--ghost" href={path('/ai')}>READ THE LOOP →</a>
      </div>
    </div>
  </header>

  {/* === 3. KPI strip — 6 count-up cells (v7.8.0 expanded) ===
       Was 4 cells with "6 venues" hardcoded. Now reads the live
       INSTITUTION_STATS aggregator: 56 venues across 6 continents,
       T1/T2/T3 split, signal count, world events, desk timezone. */}
  <section class="desk-stats" aria-label="Coverage statistics" data-reveal>
    <div class="container">
      <p class="desk-stats__eyebrow mono">24H COVERAGE · DETERMINISTIC SNAPSHOT</p>
      <ul class="desk-stats__grid desk-stats__grid--6">
        <li class="desk-stats__cell" style="--i: 0">
          <p class="desk-stats__num mono">
            <span data-counter={venueCount} data-duration="1200">{venueCount}</span>
          </p>
          <p class="desk-stats__lbl mono">RESEARCH VENUES</p>
        </li>
        <li class="desk-stats__cell" style="--i: 1">
          <p class="desk-stats__num mono">
            <span data-counter={t1Count} data-duration="1200">{t1Count}</span>
          </p>
          <p class="desk-stats__lbl mono">T1 INSTITUTIONS</p>
        </li>
        <li class="desk-stats__cell" style="--i: 2">
          <p class="desk-stats__num mono">
            <span data-counter={continents} data-duration="1200">{continents}</span>
          </p>
          <p class="desk-stats__lbl mono">CONTINENTS</p>
        </li>
        <li class="desk-stats__cell" style="--i: 3">
          <p class="desk-stats__num mono">
            <span data-counter={events.length} data-duration="1200">{events.length}</span>
          </p>
          <p class="desk-stats__lbl mono">WORLD EVENTS</p>
        </li>
        <li class="desk-stats__cell" style="--i: 4">
          <p class="desk-stats__num mono">
            <span data-counter={globalSignals} data-duration="1400">{globalSignals}+</span>
          </p>
          <p class="desk-stats__lbl mono">GLOBAL SIGNALS</p>
        </li>
        <li class="desk-stats__cell" style="--i: 5">
          <p class="desk-stats__num mono">UTC+8</p>
          <p class="desk-stats__lbl mono">DESK TIMEZONE</p>
        </li>
      </ul>
    </div>
  </section>

  {/* === 3b. NewsRibbon — desk-specific updates + methodology frames === */}
  <NewsRibbon />

  {/* === 4. Marquee — methodology frames === */}
  <Marquee
    items={[
      { head: 'PUBLIC-DATA', tail: 'GDPR-CLEAN · REPRODUCIBLE', accent: 'sage' },
      { head: 'EVAL-FIRST', tail: `${profile.stats.evalGates} GATES · EXIT-0 CONTRACT`, accent: 'warn' },
      { head: '24H SCAN', tail: '6 VENUES · 10 EVENTS · 100+ SIGNALS', accent: 'sage' },
      { head: 'TIMEZONE-AWARE', tail: 'UTC+8 DESK · 3/24 OVERLAP', accent: 'violet' },
      { head: 'REGIME-TAGGED', tail: 'CALM · NORMAL · STRESS', accent: 'terracotta' },
      { head: 'PIT STRICT', tail: 'NO LOOKAHEAD · NO SURVIVORSHIP', accent: 'sage' },
      { head: 'CHAIN-OF-CUSTODY', tail: 'SEED → SIGNAL → CITATION', accent: 'warn' },
      { head: 'NDA-POSITIVE', tail: 'COUNTS + TAXONOMY ONLY', accent: 'sage' },
    ]}
    speedSec={48}
    trailing="24h coverage · methodology"
  />

  {/* === 4b. ArxivRadar — research preprint ticker (v7.7.0) === */}
  <section class="desk-arxiv" aria-label="Latest research preprints" data-reveal>
    <div class="container">
      <p class="desk-arxiv__eyebrow mono">ARXIV · 5 CATEGORIES · PREPRINTS · 24H</p>
      <ArxivRadar speedSec={66} />
    </div>
  </section>

  {/* === 5. EarthMap — 3-layer world viz === */}
  <section class="desk-map" aria-label="Three-layer world map" data-reveal>
    <div class="container">
      <p class="desk-map__eyebrow mono">EARTH · VENUES · EVENTS · SIGNALS · 24H</p>
      <div class="desk-map__frame">
        <div class="desk-map__corner desk-map__corner--tl" aria-hidden="true"></div>
        <div class="desk-map__corner desk-map__corner--tr" aria-hidden="true"></div>
        <div class="desk-map__corner desk-map__corner--bl" aria-hidden="true"></div>
        <div class="desk-map__corner desk-map__corner--br" aria-hidden="true"></div>
        <EarthMap width={600} height={600} />
      </div>
      {/* v7.8.0 — research-power readout beneath the globe.
         Tells the viewer: "this is the research capacity anchored to
         each continent, this is the wire/news floor, this is the
         signal density coming out of each region." Story-driven. */}
      <div class="desk-research" aria-label="Research power and signal distribution">
        <div class="desk-research__col">
          <p class="desk-research__eyebrow mono">RESEARCH POWER · BY CONTINENT</p>
          <ul class="desk-research__bars">
            {Object.entries(INSTITUTION_STATS.byContinent)
              .sort((a, b) => b[1] - a[1])
              .map(([continent, count]) => {
                const max = Math.max(...Object.values(INSTITUTION_STATS.byContinent));
                const pct = Math.round((count / max) * 100);
                return (
                  <li class="desk-research__bar">
                    <span class="desk-research__bar-lbl mono">{continent}</span>
                    <span class="desk-research__bar-track" aria-hidden="true">
                      <span class="desk-research__bar-fill" style={`--pct: ${pct}%`}></span>
                    </span>
                    <span class="desk-research__bar-num mono">{count}</span>
                  </li>
                );
              })}
          </ul>
        </div>
        <div class="desk-research__col">
          <p class="desk-research__eyebrow mono">SIGNAL FLOOR · BY DOMAIN</p>
          <ul class="desk-research__bars">
            <li class="desk-research__bar">
              <span class="desk-research__bar-lbl mono">q-fin</span>
              <span class="desk-research__bar-track" aria-hidden="true">
                <span class="desk-research__bar-fill" style={`--pct: 100%`}></span>
              </span>
              <span class="desk-research__bar-num mono">{INSTITUTION_STATS.byFocus['q-fin'] || 0}</span>
            </li>
            <li class="desk-research__bar">
              <span class="desk-research__bar-lbl mono">cs-ai</span>
              <span class="desk-research__bar-track" aria-hidden="true">
                <span class="desk-research__bar-fill" style={`--pct: ${Math.round(((INSTITUTION_STATS.byFocus['cs-ai'] || 0) / (INSTITUTION_STATS.byFocus['q-fin'] || 1)) * 100)}%`}></span>
              </span>
              <span class="desk-research__bar-num mono">{INSTITUTION_STATS.byFocus['cs-ai'] || 0}</span>
            </li>
            <li class="desk-research__bar">
              <span class="desk-research__bar-lbl mono">cs-lg</span>
              <span class="desk-research__bar-track" aria-hidden="true">
                <span class="desk-research__bar-fill" style={`--pct: ${Math.round(((INSTITUTION_STATS.byFocus['cs-lg'] || 0) / (INSTITUTION_STATS.byFocus['q-fin'] || 1)) * 100)}%`}></span>
              </span>
              <span class="desk-research__bar-num mono">{INSTITUTION_STATS.byFocus['cs-lg'] || 0}</span>
            </li>
            <li class="desk-research__bar">
              <span class="desk-research__bar-lbl mono">cs-cl</span>
              <span class="desk-research__bar-track" aria-hidden="true">
                <span class="desk-research__bar-fill" style={`--pct: ${Math.round(((INSTITUTION_STATS.byFocus['cs-cl'] || 0) / (INSTITUTION_STATS.byFocus['q-fin'] || 1)) * 100)}%`}></span>
              </span>
              <span class="desk-research__bar-num mono">{INSTITUTION_STATS.byFocus['cs-cl'] || 0}</span>
            </li>
            <li class="desk-research__bar">
              <span class="desk-research__bar-lbl mono">stat</span>
              <span class="desk-research__bar-track" aria-hidden="true">
                <span class="desk-research__bar-fill" style={`--pct: ${Math.round(((INSTITUTION_STATS.byFocus['stat'] || 0) / (INSTITUTION_STATS.byFocus['q-fin'] || 1)) * 100)}%`}></span>
              </span>
              <span class="desk-research__bar-num mono">{INSTITUTION_STATS.byFocus['stat'] || 0}</span>
            </li>
          </ul>
        </div>
        <div class="desk-research__col desk-research__col--story">
          <p class="desk-research__eyebrow mono">WHAT THIS EARTH SEES</p>
          <p class="desk-research__story">
            <strong>{t1Count} T1 institutions</strong> across <strong>{continents} continents</strong>
            anchor the research-side of the desk. arxiv papers and macro-wire headlines land on these
            cities via deterministic hash. The {gdeltItems}-point GDELT overlay is the
            news-side: where things are <em>moving right now</em>, rendered with polarity + severity.
            Click any country or venue to dive.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* === 6. LiveStats — instrument panel (4 cards) === */}
  <LiveStats />

  {/* === 7. World events table — row stagger === */}
  <section class="desk-events" aria-label="Curated world events">
    <div class="container">
      <p class="desk-events__eyebrow mono">{events.length} CURATED WORLD EVENTS</p>
      <h2 class="desk-events__title">The calendar that drives every position-book.</h2>

      {/* v7.12 — category + severity filter chips + visible counter */}
      <div class="desk-events__filters" role="toolbar" aria-label="Filter desk events">
        <div class="desk-events__chips" role="group" aria-label="Category filter">
          <span class="desk-events__chip-label mono">CAT ·</span>
          <button type="button" class="desk-events__chip-btn desk-events__chip-btn--active" data-desk-cat="all">ALL ({events.length})</button>
          {CATEGORY_ORDER.map((c) => (
            <button
              type="button"
              class="desk-events__chip-btn"
              data-desk-cat={c}
              disabled={categoryCounts[c] === 0}
            >{CATEGORY_LABELS[c]} ({categoryCounts[c]})</button>
          ))}
        </div>
        <div class="desk-events__chips" role="group" aria-label="Severity filter">
          <span class="desk-events__chip-label mono">SEV ·</span>
          <button type="button" class="desk-events__chip-btn desk-events__chip-btn--active" data-desk-sev="all">ALL ({events.length})</button>
          {SEVERITY_ORDER.map((s) => (
            <button
              type="button"
              class="desk-events__chip-btn desk-events__chip-btn--{s}"
              data-desk-sev={s}
              disabled={severityCounts[s] === 0}
            >{s.toUpperCase()} ({severityCounts[s]})</button>
          ))}
        </div>
        <p class="desk-events__count mono" data-desk-visible-count>
          {events.length} VISIBLE
        </p>
      </div>

      <table class="desk-events__table">
        <caption class="sr-only">
          Curated world events that the desk tracks on a 24-hour rolling basis —
          central-bank policy meetings, scheduled data releases, geopolitical
          windows, and earnings that move the position-book.
        </caption>
        <colgroup>
          <col class="desk-events__col-num" />
          <col class="desk-events__col-cat" />
          <col class="desk-events__col-sev" />
          <col class="desk-events__col-title" />
          <col class="desk-events__col-city" />
        </colgroup>
        <thead>
          <tr>
            <th class="mono">#</th>
            <th class="mono">CAT</th>
            <th class="mono">SEV</th>
            <th>TITLE</th>
            <th class="mono">CITY</th>
          </tr>
        </thead>
        <tbody>
          {
            events.map((e, i) => (
              <tr
                class="desk-events__row"
                style={`--i: ${i}`}
                id={`event-${e.id}`}
                data-desk-cat={e.category}
                data-desk-sev={e.severity}
              >
                <td class="desk-events__num mono">
                  <a class="desk-events__anchor" href={`#event-${e.id}`} aria-label={`Permalink for event ${e.id}`}>#</a>
                  {String(e.order).padStart(2, '0')}
                </td>
                <td class="desk-events__cat mono">{e.category}</td>
                <td class="desk-events__sev mono">
                  <span class={`desk-events__pill desk-events__pill--${e.severity}`}>
                    {e.severity.toUpperCase()}
                  </span>
                </td>
                <td class="desk-events__title-cell">{e.title}</td>
                <td class="desk-events__city mono">{e.city}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  {/* === 7b. LiveWire — macro wire ticker (v7.7.0) === */}
  <section class="desk-wire" aria-label="Macro wire headlines" data-reveal>
    <div class="container">
      <p class="desk-wire__eyebrow mono">MACRO WIRE · 4 PUBLISHERS · HEADLINES · 24H</p>
      <LiveWire speedSec={64} trailing="macro wire · 24h" />
    </div>
  </section>

  {/* === 8. LiveActivity — tail of the loop === */}
  <LiveActivity />

  {/* === 9. CTA banner === */}
  <CTABanner
    title="Hire the operator, not the dashboard."
    sub={`${archSafe.agentCount}-agent multi-agent office · ${profile.stats.evalGates}-gate eval harness · ${profile.stats.locPython} LOC Python · NDA-clean by construction. Email below — reply within 24h.`}
    primaryHref={mailto}
    primaryLabel="EMAIL — HIRING INQUIRY"
    secondaryHref={path('/ai')}
    secondaryLabel="READ THE LOOP →"
  />
</BaseLayout>

<style>
  /* === Container === */
  .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* === Head === */
  .desk-head {
    padding: 56px 0 48px;
    border-bottom: 1px solid var(--c-rule);
  }
  .desk-head__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-warn);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 24px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .desk-head__title {
    font: 600 48px / 1 var(--serif-display);
    color: var(--c-ink);
    letter-spacing: -0.024em;
    margin: 0 0 24px;
    max-width: 18ch;
  }
  .desk-head__title .hl {
    font-style: italic;
    color: var(--c-amber);
  }
  .desk-head__voice {
    font: 500 16px / 1.5 var(--serif-display);
    color: var(--c-ink-2);
    font-style: italic;
    margin: 0 0 24px;
    max-width: 56ch;
  }
  .desk-head__sub {
    font: 400 15px / 1.6 var(--ff-sans);
    color: var(--c-ink);
    margin: 0 0 28px;
    max-width: 64ch;
  }
  .desk-head__sub em {
    font-family: var(--serif-display);
    font-style: italic;
    color: var(--c-warn);
    font-weight: 600;
  }
  .desk-head__cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* CTA (shared with home) */
  .cta {
    display: inline-block;
    padding: 14px 24px;
    font: 600 11px / 1 var(--ff-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--c-rule);
    cursor: pointer;
    transition:
      background 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
    background: transparent;
    color: var(--c-ink);
  }
  .cta--primary {
    background: var(--c-warn);
    color: var(--c-bg);
    border-color: var(--c-warn);
  }
  .cta--primary:hover {
    background: var(--c-amber-deep);
    border-color: var(--c-amber-deep);
  }
  .cta--ghost {
    background: transparent;
    color: var(--c-ink);
    border-color: var(--c-rule);
  }
  .cta--ghost:hover {
    color: var(--c-warn);
    border-color: var(--c-warn);
  }

  /* === Stats grid === */
  .desk-stats {
    padding: 48px 0 56px;
    background: var(--c-bg-2);
    border-bottom: 1px solid var(--c-rule);
  }
  .desk-stats__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-warn);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 24px;
  }
  .desk-stats__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .desk-stats__grid--6 {
    grid-template-columns: repeat(6, 1fr);
    gap: 18px;
  }
  .desk-stats__cell {
    border-top: 1px solid var(--c-rule);
    padding-top: 16px;
    position: relative;
    transition: border-color 0.2s ease;
    animation: desk-stat-in 0.6s cubic-bezier(.4,.7,.3,1) backwards;
    animation-delay: calc(var(--i, 0) * 100ms);
  }
  .desk-stats__cell:hover {
    border-top-color: var(--c-amber);
  }
  @keyframes desk-stat-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: none; }
  }
  .desk-stats__num {
    font: 600 32px / 1 var(--serif-display);
    color: var(--c-ink);
    letter-spacing: -0.022em;
    margin: 0 0 6px;
    font-variant-numeric: tabular-nums;
  }
  .desk-stats__grid--6 .desk-stats__num {
    font-size: 26px;
  }
  .desk-stats__grid--6 .desk-stats__lbl {
    font-size: 9.5px;
  }
  .desk-stats__num span[data-counter] {
    color: var(--c-phi);
  }
  .desk-stats__lbl {
    font: 500 10px / 1.2 var(--ff-mono);
    color: var(--c-ink-2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0;
  }

  /* === v7.7.0 — ArxivRadar section chrome === */
  .desk-arxiv {
    padding: 48px 0;
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg);
  }
  .desk-arxiv__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-warn);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  /* === v7.7.0 — LiveWire section chrome === */
  .desk-wire {
    padding: 48px 0;
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg);
  }
  .desk-wire__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-warn);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  /* === Map === */
  .desk-map {
    padding: 48px 0 56px;
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg);
  }
  .desk-map__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
