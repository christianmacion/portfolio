---
/**
 * proof.astro : the proof spine. Results only.
 *
 * ONE purpose : results, with the artifact behind each one.
 *   P.1 Identity            : who, on disk
 *   P.2 Research artifacts  : quant + AI results, metric per row
 *   P.3 Public track record : lectures, charts, RSS
 *   P.4 Evidence index      : the AARs behind the page
 *   P.5 Disclosure          : what is not here, and how to ask
 *
 * v12.W4 content reduction : flagship credentials moved out to
 * /certifications (which owns creds), shipped-code cards to /repos
 * (which owns public code), the solutions list to /solutions, and the
 * testimonials block deleted outright. This page carries results and
 * the evidence trail, nothing else.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ProofCard from '@components/ProofCard.astro';
import VideoEmbed from '@components/VideoEmbed.astro';
import CTABanner from '@components/CTABanner.astro';
import SectionTOC from '@components/SectionTOC.astro';
import VoiceLine from '@components/VoiceLine.astro';
import ChromeHeader from '@components/ChromeHeader.astro';
import SectionMark from '@components/SectionMark.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { path } from '@utils/url';
import { profile } from '@utils/profile';
const NGATE = `${profile.stats.evalGates}-gate`;

type ProjectEntry = CollectionEntry<'project'>;

// === Data: projects, surfaced as compact result rows ===
const allProjects: ProjectEntry[] = await getCollection('project');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
const quantProjects: ProjectEntry[] = projects.filter((p) => p.data.role === 'quant');
const aiProjects: ProjectEntry[] = projects.filter((p) => p.data.role === 'ai');

// v6.10.27 : counts derive from the actual collection, not hand-written
// literals, so the hero numbers stay in lockstep with the data.
const heroArtifactCount = quantProjects.length + aiProjects.length;
// v6.10.40 : derive OSS-project count for the /proof table row.
const ossProjectCount = projects.filter((p) => p.data.sourceLink).length;
const heroQuantCount = quantProjects.length;
const heroAiCount = aiProjects.length;

// v12.W4 : "on disk" = what this page can actually render now that
// credentials moved to /certifications and code cards to /repos:
// quantProjects + aiProjects + 1 ProofCard (the operator-discretion chart).
const proofCountOnDisk = heroArtifactCount + 1; /* ProofCard */

// v13.1.4 (2026-08-11, proof-uplift) : recency stamp at bottom.
// Anchors the page to its last content-edit commit. Same register
// as /contact/ `.contact-recency` (polish-7x commit 19aa5ef).
const PROOF_COMMIT = '9003283';

const formatProjectMetric = (p: (typeof projects)[number]) => {
  if (!p.data.metrics?.length) return null;
  const first = p.data.metrics[0];
  return { label: first.label, value: first.value, sub: first.sub };
};

// === Status → tone + label mapping (for status pills) ===
// production → Live (green), open-source → Open Source (amber),
// internal → Internal (monochrome · F14 institutional), archived → Archived (gray).
type StatusTone = 'pass' | 'warn' | 'mute';
type StatusInfo = { label: string; tone: StatusTone };
const STATUS_MAP: Record<string, StatusInfo> = {
  production: { label: 'Live', tone: 'pass' },
  'open-source': { label: 'Open Source', tone: 'warn' },
  internal: { label: 'Internal', tone: 'mute' },
  archived: { label: 'Archived', tone: 'mute' },
};
const statusInfo = (s?: string): StatusInfo | null => (s && STATUS_MAP[s]) || null;

// === Filter attributes (Topic × Type) ===
// Topic: quant | ai | oss (solutions get topic from their lane)
// Type: code | writeup | talk | live-demo
const projectTopic = (p: (typeof projects)[number]) => p.data.topic ?? null;
const projectType = (p: (typeof projects)[number]) => p.data.assetType ?? null;
const solutionTopic = (s: (typeof solutions)[number]): 'quant' | 'ai' | 'oss' | null => {
  if (s.data.lane === 'quant' || s.data.lane === 'ai') return s.data.lane;
  // education / systems lanes are public writeups → OSS
  return 'oss';
};
const solutionType = (_s: (typeof solutions)[number]) => 'writeup' as const;

// === Per-list pagination: page size 6 ===
const PAGE_SIZE = 6;
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const paginate = (items: any[]) => {
  // pinned first, then in original order
  const sorted = [...items].sort((a, b) => {
    const ap = a.data.pinned ? 1 : 0;
    const bp = b.data.pinned ? 1 : 0;
    if (ap !== bp) return bp - ap;
    return a.data.order - b.data.order;
  });
  return sorted.map((item, idx) => {
    let page: number;
    if (idx < PAGE_SIZE) {
      // page 1 = pinned + first (PAGE_SIZE - pinnedCount) unpinned
      page = 1;
    } else {
      const offset = idx - PAGE_SIZE;
      page = 2 + Math.floor(offset / PAGE_SIZE);
    }
    return { item, page };
  });
};
