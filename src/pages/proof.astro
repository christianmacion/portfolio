    class="section"
    id="research"
    data-toc-id="research"
    data-toc-label="Research artifacts"
    data-section-id="proof"
    data-reveal
    data-filter-host
    data-active-topic="all"
    data-active-type="all"
  >
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">P.2 · Research artifacts</p>
        <h2 class="section__title">
          {quantProjects.length} quant · {aiProjects.length} AI. <span class="mono"
