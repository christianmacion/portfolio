                  <span class="proof-list__name">{p.data.title}</span>
                  {m && (
                    <span class="proof-list__metric mono">
                      <span class="proof-list__metric-val">{m.value}</span>
                      <span class="proof-list__metric-lbl">{m.label}</span>
                    </span>
                  )}
                  <span class="proof-list__date mono">{date}</span>
                  <span class="proof-list__arrow mono" aria-hidden="true">
                    →
                  </span>
                </a>
                {p.data.summary && <p class="proof-list__summary">{p.data.summary}</p>}
              </li>
            );
          })
        }
      </ol>
      <nav class="proof-pager" aria-label="Quant projects pagination" data-pager hidden></nav>

      {/* AI projects */}
      <h3 class="proof-list__heading">AI projects to {heroAiCount}</h3>
      <ol
        class="proof-list proof-list--paged"
        aria-label="AI engineering projects"
        data-paged-list
        data-page-size={PAGE_SIZE}
      >
