---
/**
 * now.astro — Derek Sivers' /now pattern.
 *
 * A single dated page that says what I'm shipping this month, who I'm
 * open to working with, what I'm *not* doing, and where I am. Highest-
 * impact one-page artifact in the 2026 personal-site canon.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import { profile } from '@utils/profile';
import { path } from '@utils/url';
import VoiceLine from '@components/VoiceLine.astro';
import { buildStampUtc8 } from '@utils/build-stamp';

// Last-updated stamp derives from BUILD_DATE so it never goes stale.
// The /now page itself is hand-edited ~monthly; this stamp only reflects
// the last build that re-rendered it.
const updated = buildStampUtc8();
const updatedHuman = new Date(updated).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title="Now"
  description={`What Christian is shipping this month (${updatedHuman}). Open-to / not-open-to / where / how to reach me.`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Now', href: '/now' },
  ]}
>
  <header class="now-head">
    <div class="container container-narrow">
      <p class="now-head__eyebrow mono">
        <span class="now-head__eyebrow-chip">NOW · LAST UPDATED {updated}</span>
        <span class="now-head__eyebrow-line">WHAT I'M SHIPPING · OPEN-TO · NOT-OPEN-TO</span>
      </p>
      <h1 class="now-head__title" data-words>
        What I'm doing <span class="hl">right now</span>.
      </h1>
      <VoiceLine class="now-head__voice">
        Dated. Honest. Updated only when something changes that matters.
      </VoiceLine>
      <p class="now-head__sub">
        A dated one-pager. Updated ~monthly, or on regime-event override (job change, paper-trade
        regime flip, new gate added to the stack). Inspired by <a
          href="https://nownownow.com/about"
          target="_blank"
          rel="noopener noreferrer">/now</a
        >.
      </p>
      <div class="now-head__stamp mono">
        <span class="dot dot--amber"></span>
        <span><strong>Status:</strong> open to conversations · remote · UTC+8</span>
      </div>
      <p class="now-head__tenant mono">
        <span>CHRISTIAN.T.MACION</span>
        <span aria-hidden="true">·</span>
        <span>UTC+8</span>
        <span aria-hidden="true">·</span>
        <span>REMOTE-OK</span>
        <span aria-hidden="true">·</span>
        <span>{profile.availability.hours.toUpperCase()}</span>
        <span aria-hidden="true">·</span>
        <span>OWNER-VERIFIED</span>
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container container-narrow">
      <h2 class="now-h2">Where I am</h2>
      <ul class="now-list">
        <li>
          <strong>Based:</strong>
          {profile.location.display}. Working hours 09:00–18:00 PHT on weekdays.
        </li>
        <li><strong>Mode:</strong> remote only. {profile.availability.hours} available.</li>
        <li>
          <strong>Stacking:</strong> Quant Researcher / QR-rotational / AI-engineer seat at a hedge fund,
          prop shop, or systematic-trading fund.
        </li>
      </ul>

      <h2 class="now-h2">What I'm shipping this month</h2>
      <ul class="now-list">
        <li>
          <strong
            >New workbook published — <a href={path('/workbooks/kaufman-efficiency-ratio.pdf')}
              >Kaufman Efficiency Ratio (4 pp · 287 KB · PDF)</a
            >:</strong
          >
          {' '}adaptive efficiency measurement for trading strategies. Source: <code
            >macion2026kaufman</code
          >. Anchors the KAMA adaptive-MA discussion across the quant book.
        </li>
        <li>
          <strong>Live paper-trade on <a href={path('/positions')}>/positions</a>:</strong>
          running project 03 (vol-target time-series momentum, BTC/USDT, 30% annualized vol target) into
          its second regime cycle. Tracking slippage against the 5 bps linear-impact model — currently
          4.2 bps realized.
        </li>
        <li>
          <strong>Walk-forward OOS standardization across the book:</strong>
          applying the locked-window pattern from project 06 to the remaining 8 quant projects. ETA end
          of August 2026.
        </li>
        <li>
          <strong>Methodology expansion on <a href={path('/methodology')}>/methodology</a>:</strong>
          the "what I'd build first" 90-day plan is the latest addition. Next up: per-asset-class G16–G20
          deep dives.
        </li>
        <li>
          <strong>This site:</strong> ongoing edits — see <a
            href="https://github.com/christianmacion26/portfolio/commits/main"
            target="_blank"
            rel="noopener noreferrer">commit history</a
          >
          for a dated build log.
        </li>
      </ul>

      <h2 class="now-h2">Open to</h2>
      <ul class="now-list">
        <li>Quant Researcher / QR-rotational seats (crypto, equities, multi-asset).</li>
        <li>
          AI Engineer / Multi-Agent Engineer roles where evals and structured-output contracts are
          part of the spec.
        </li>
        <li>Hybrid QR + AI roles — these are rare and I rank them highest.</li>
        <li>
          Contract research engagements with a defined deliverable (a memo, a backtest harness, a
          strategy teardown).
        </li>
        <li>
          QuantDev roles that touch an eval harness / model-routing policy / walk-forward pipeline.
        </li>
      </ul>

      <h2 class="now-h2">Not open to</h2>
      <ul class="now-list now-list--not">
        <li>Unpaid trial tasks or take-homes longer than 4 hours.</li>
        <li>
          Relocation outside {profile.location.display}, or roles requiring proprietary data I
          cannot disclose post-engagement. See <a href={path('/for-recruiters')}>/for-recruiters</a> for
          the full 60-second skim; the reply-with-JD protocol is on <a href={path('/contact')}
            >/contact</a
          >.
        </li>
      </ul>

      <h2 class="now-h2">Currently reading</h2>
      <ul class="now-list">
        <li>
          <em>Advances in Financial Machine Learning</em> — Marcos López de Prado (re-read, ch. 16 on
          backtest overfitting).
        </li>
        <li>
          <em>The Deflated Sharpe Ratio</em> — Bailey &amp; López de Prado. The paper that gates
          G16 of the eval stack.
        </li>
        <li>
          <em>Evaluating LLM-based Code Generation: A Cross-Family Benchmark</em> — Parashar et al..
          Closest peer work to my <a href={path('/glossary/eval-harness')}>eval-harness</a> + MCP server.
        </li>
        <li><em>Hamlet</em> — Shakespeare. Sometimes you have to step away from the screen.</li>
        <li>
          <em>Research writing patterns</em> — for technical audiences. <a
            href="https://github.com/agentipedia/research-writing"
            target="_blank"
            rel="noopener noreferrer">GitHub</a
          > + <em>Karpathy / autoresearch</em> — autonomous research loops. <a
            href="https://github.com/karpathy/autoresearch"
            target="_blank"
            rel="noopener noreferrer">MIT licensed</a
          >.
        </li>
      </ul>

      <h2 class="now-h2">How to reach me</h2>
      <ul class="now-list">
        <li>
          <strong>For open roles:</strong> email with the JD attached — <a
            href={`mailto:${profile.contact.email}?subject=JD%20%E2%80%94%20%5Brole%5D`}
            >{profile.contact.email}</a
          >. Reply within 24h on weekdays.
        </li>
        <li>
          <strong>For casual / paper-trail:</strong>
          <a href={profile.contact.linkedin} target="_blank" rel="noopener noreferrer"
            >LinkedIn DM</a
          >.
        </li>
        <li>
          <strong>For public work / proof:</strong>
          <a href={profile.contact.github} target="_blank" rel="noopener noreferrer">GitHub</a> ({
            profile.stats.repoCount
          } public repos, all NDA-safe). Stack: see <a href={path('/uses')}>/uses</a>.
        </li>
      </ul>

      <div class="now-foot mono">
        This page is versioned. <a
          href={`https://github.com/christianmacion26/portfolio/commits/main/src/pages/now.astro`}
          target="_blank"
          rel="noopener noreferrer">Edit history →</a
        >
      </div>
    </div>
  </section>

  <CTABanner
    title="Got a JD? Send it."
    sub="I read every email. If the role matches, you'll get a reply within 24h with: problem → approach → evidence → outcome → proof."
    primaryLabel="Email me"
    secondaryLabel="Read methodology"
    secondaryHref={path('/methodology')}
  />
</BaseLayout>

<style>
  .now-head {
    padding-block: var(--sp-9) var(--sp-7);
    background: var(--c-bg);
    border-bottom: var(--border);
  }
  .now-head__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    flex-wrap: wrap;
  }
  .now-head__eyebrow-chip {
    display: inline-block;
    padding: 4px 10px;
    /* v9.2 a11y — was --c-phi-teal. Dark theme --j-phi-teal = #2d5f5a
     only hits 2.14:1 on dark page-head surface. Solid amber chip +
     --c-bg text reads at ≥5.6:1 in both themes — institutional
     register, F14-safe (no traffic-light). */
    color: var(--c-bg);
    border: 1px solid var(--c-amber);
    background: var(--c-amber);
    font-weight: 600;
  }
  .now-head__eyebrow-line {
    color: var(--c-warn);
    font-weight: 600;
  }
  .now-head__tenant {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-4) 0 0;
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    font-size: 0.78rem;
    color: var(--c-ink-2);
    letter-spacing: 0.06em;
  }
  .now-head__tenant span:nth-child(odd) {
    color: var(--c-warn);
    font-weight: 600;
  }
  .now-head__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-block: var(--sp-4) var(--sp-5);
    max-width: 22ch;
  }
  .now-head__voice {
    margin: 0 0 var(--sp-5);
    max-width: 60ch;
  }
  .now-head__sub {
    font-size: var(--fs-lg);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    max-width: 60ch;
    margin-bottom: var(--sp-5);
  }
  .now-head__sub a {
    color: var(--c-primary);
    text-decoration: underline;
    text-decoration-color: var(--c-amber);
    text-underline-offset: 3px;
  }
  .now-head__stamp {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4);
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    border-radius: 0;
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
  }
  .now-head__stamp strong {
    color: var(--c-ink);
    font-weight: 600;
  }

  .now-h2 {
    font-size: var(--fs-xl);
    color: var(--c-ink);
    margin: var(--sp-7) 0 var(--sp-3);
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--c-rule-soft);
    padding-bottom: var(--sp-2);
  }
  .now-h2:first-of-type {
    margin-top: var(--sp-3);
  }

  .now-list {
    list-style: none;
    padding: 0;
    max-width: 720px;
  }
  .now-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: var(--sp-3);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    font-size: var(--fs-base);
  }
  .now-list li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--c-amber);
    font-weight: 500;
  }
  .now-list strong {
    color: var(--c-ink);
    font-weight: 600;
  }
  .now-list a {
    color: var(--c-primary);
    text-decoration: underline;
    text-decoration-color: var(--c-rule);
    text-underline-offset: 2px;
  }
  .now-list a:hover {
    text-decoration-color: var(--c-amber);
  }
  .now-list--not li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--c-ink-3);
  }

  .now-foot {
    margin-top: var(--sp-6);
    padding: var(--sp-3) var(--sp-4);
    background: var(--c-paper);
    border: 1px dashed var(--c-rule);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    color: var(--c-ink-3);
  }
  .now-foot a {
    /* v9.3 a11y 96 follow-up (2026-08-01) — was --c-amber
       (dark: #8a6f2f) on --c-paper dark (#221f1b) = 3.43:1 fail.
       Promoted to --c-amber (dark: #a88a3e) = 5.25:1 pass. Light
       --c-amber #6b5220 on --c-paper #f3ede1 = 7.39:1 pass. */
    color: var(--c-amber);
    text-decoration: underline;
  }
</style>
