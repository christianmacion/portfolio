---
/**
 * now.astro : Derek Sivers' /now pattern.
 *
 * ONE purpose : live focus. What is on the desk this month, dated.
 *
 * v12.W4 content reduction : availability / open-to / not-open-to moved
 * to /for-recruiters (the recruiter pitch owns the hiring answer), the
 * contact ladder to /contact, and the reading list to /reading. This
 * page states what is shipping and nothing else.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import { path } from '@utils/url';
import VoiceLine from '@components/VoiceLine.astro';
import { buildStampUtc8 } from '@utils/build-stamp';

// Last-updated stamp derives from BUILD_DATE so it never goes stale.
// The /now page itself is hand-edited ~monthly; this stamp only reflects
// the last build that re-rendered it.
const updated = buildStampUtc8();
const updatedHuman = new Date(updated).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title="Now"
  description={`What Christian is shipping this month (${updatedHuman}). A dated work log, updated on ship.`}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Now', href: '/now' },
  ]}
>
  <header class="now-head">
    <div class="container container-narrow">
      <p class="now-head__eyebrow mono">
        <span class="now-head__eyebrow-chip">NOW · LAST UPDATED {updated}</span>
      </p>
      <h1 class="now-head__title" data-words>
        What I'm doing <span class="hl">right now</span>.
      </h1>
      <VoiceLine class="now-head__voice">
        Dated. Honest. Updated only when something changes that matters.
      </VoiceLine>
    </div>
  </header>

  <section class="section">
    <div class="container container-narrow">
      <h2 class="now-h2">Currently shipping</h2>
      <ul class="now-list">
        <li>
          <strong>Bloomberg-style trading terminal.</strong>
          9-panel layout for the live Upcomer Vanguard $2k account. Manual-only posture binding. Yahoo + Binance
          live data. 6-hour AFK build, CONVERGED 2026-08-08.
        </li>
        <li>
          <strong>Stage 2.5 multi-asset sweep.</strong>
          37 cells scored at 15m resolution across XAU/XAG/BTC/ETH. 11 carry the G16 monotone-positive
          fingerprint, 0 survive FDR at q=0.10. Resolution-invariant. Vector coverage is the constraint.
        </li>
        <li>
          <strong>Vanguard 2K synthesis.</strong>
          0/26 cleared (BTC 3/3 + Gold 19/19 + Silver 3/3 KILL). Signal firer dormant, manual-only. Top-3
          priorities queued.
        </li>
        <li>
          <strong>Portfolio v12.W4 Bryllim parity.</strong>
          10-hub nav (6 icon+label + 4 plain text). 5 v12.W3 regression fixes. Headshot re-crop to home hero.
          Site-wide axe sweep queued.
        </li>
        <li>
          <strong>Walk-forward OOS standardization.</strong>
          Applying the locked-window pattern from project 06 to the remaining 8 quant projects. ETA end
          of August 2026.
        </li>
      </ul>

      <h2 class="now-h2">Currently reading</h2>
      <ul class="now-list">
        <li>
          <strong>Shreve, Stochastic Calculus for Finance II.</strong>
          Ch. 4. Itô lemma + change-of-numéraire. Anchors the vol-target time-series momentum framework.
        </li>
        <li>
          <strong>Bailey &amp; López de Prado, Deflated Sharpe Ratio.</strong>
          Re-read for the G16 rule wording across the methodology page.
        </li>
        <li>
          <strong>Deming, Out of the Crisis.</strong>
          System of Profound Knowledge. Common cause vs special cause. Maps cleanly onto the
          31-gate eval harness.
        </li>
      </ul>

      <h2 class="now-h2">Currently thinking about</h2>
      <ul class="now-list">
        <li>
          <strong>The vector-coverage gap.</strong>
          Stage 2 keeps killing on coverage, not edge. Worth adding a G-candidate for regime-stratified
          sample-size minimums before Stage 3 burns another sweep.
        </li>
        <li>
          <strong>Eval bars for LLM-eval claims.</strong>
          A single Brier + FDR pair beats every "vibe" leaderboard. Standardizing the wording so
          multi-agent eval pages cite the same gate IDs as quant research.
        </li>
      </ul>

      <div class="now-foot mono">
        Hiring context: <a href={path('/for-recruiters')}>/for-recruiters</a> ·
        reach me: <a href={path('/contact')}>/contact</a> ·
        commit log: <a
          href="https://github.com/christianmacion26/portfolio/commits/main"
          target="_blank"
          rel="noopener noreferrer">github.com/christianmacion26/portfolio</a
        >.
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .now-head {
    padding-block: var(--sp-9) var(--sp-7);
    background: var(--c-bg);
    border-bottom: var(--border);
  }
  .now-head__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    flex-wrap: wrap;
  }
  .now-head__eyebrow-chip {
    display: inline-block;
    padding: 4px 10px;
    /* v9.2 a11y : was --c-phi-teal. Dark theme --j-phi-teal = #2d5f5a
     only hits 2.14:1 on dark page-head surface. Solid amber chip +
     --c-bg text reads at ≥5.6:1 in both themes : institutional
     register, F14-safe (no traffic-light). */
    color: var(--c-bg);
    border: 1px solid var(--c-amber);
    background: var(--c-amber);
    font-weight: 600;
  }
  .now-head__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-block: var(--sp-4) var(--sp-5);
    max-width: 22ch;
  }
  .now-head__voice {
    margin: 0 0 var(--sp-5);
    max-width: 60ch;
  }

  .now-h2 {
    font-size: var(--fs-xl);
    color: var(--c-ink);
    margin: var(--sp-7) 0 var(--sp-3);
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--c-rule-soft);
    padding-bottom: var(--sp-2);
  }
  .now-h2:first-of-type {
    margin-top: var(--sp-3);
  }

  .now-list {
    list-style: none;
    padding: 0;
    max-width: 720px;
  }
  .now-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: var(--sp-3);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    font-size: var(--fs-base);
  }
  .now-list li::before {
    content: '-';
    position: absolute;
    left: 0;
    color: var(--c-amber);
    font-weight: 500;
  }
  .now-list strong {
    color: var(--c-ink);
    font-weight: 600;
  }
  .now-list a {
    color: var(--c-primary);
    text-decoration: underline;
    text-decoration-color: var(--c-rule);
    text-underline-offset: 2px;
  }
  .now-list a:hover {
    text-decoration-color: var(--c-amber);
  }

  .now-foot {
    margin-top: var(--sp-6);
    padding: var(--sp-3) var(--sp-4);
    background: var(--c-paper);
    border: 1px dashed var(--c-rule);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    color: var(--c-ink-3);
  }
  .now-foot a {
    /* v9.3 a11y 96 follow-up (2026-08-01) : was --c-amber
       (dark: #8a6f2f) on --c-paper dark (#221f1b) = 3.43:1 fail.
       Promoted to --c-amber (dark: #a88a3e) = 5.25:1 pass. Light
       --c-amber #6b5220 on --c-paper #f3ede1 = 7.39:1 pass. */
    color: var(--c-amber);
    text-decoration: underline;
  }
</style>
