---
/**
 * markets.astro : v6.1 "Bloomberg-terminal" landing page.
 *
 * Layout (top → bottom):
 *   1. <MarketTape /> : full-bleed scrolling equity tape
 *   2. Stats row : 4 <StatCell /> for S&P, DXY, VIX, BTC-USD
 *   3. 3-col grid:
 *      - left  (30%) : <OrderBook symbol="SPX" />
 *      - center (45%) : <EquityCurveChart /> showing one strategy
 *      - right (25%) : mini order book / queue panel for a second symbol
 *   4. Bottom band : <CoverageGlobe /> · <TermStructure /> · indices list
 *
 * No client:* directives. All numbers are seeded from BUILD_DATE so the
 * page is byte-deterministic for a given build and shifts only between
 * builds. Cross-fade / carousel patterns from StatementCarousel are NOT
 * used here : these are static primitives, not rotators.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import VoiceLine from '@components/VoiceLine.astro';
import MarketTape from '@components/MarketTape.astro';
import OrderBook from '@components/OrderBook.astro';
import TermStructure from '@components/TermStructure.astro';
import CoverageGlobe from '@components/CoverageGlobe.astro';
import StatCell from '@components/StatCell.astro';
import MiniSpark from '@components/MiniSpark.astro';
import EquityCurveChart from '@components/EquityCurveChart.astro';
import CTABanner from '@components/CTABanner.astro';
import ChromeHeader from '@components/ChromeHeader.astro';
import { seedFromString, walk, buildSeed } from '@utils/prng';
import { path } from '@utils/url';
import { getIndexSnap } from '@utils/markets-data';
import { MARKETS_PREVIEW_ROWS, getCurrencyMeta } from '@data/currencies';

// === Index stats (PRNG-seeded from BUILD_DATE) ===
// Four headline indices with deterministic mid-prices and a small
// 30-day series for the inline MiniSpark on each card.
//
// v6.11.12 : pull px + delta + spark from src/utils/markets-data.ts so
// the stat cards show IDENTICAL numbers to the same indices on the
// MarketTape at the top of this page. Previously the cards had their
// own walk (sigma=12, len=30) while the tape had sigma=8.0, len=80 :
// the same instrument rendered two different prices on one page.
const STAT_CARD_SYMS = ['SPX', 'DXY', 'VIX', 'BTC-USD'] as const;
const indexCards = STAT_CARD_SYMS.map((sym) => {
  const snap = getIndexSnap(sym);
  if (!snap) throw new Error(`markets-data: missing snap for ${sym}`);
  return {
    sym: snap.sym,
    label: snap.label,
    value: snap.pxStr,
    delta: snap.deltaPct,
    sub: snap.sub,
    spark: snap.spark,
  };
});

// === Strategy equity curve for the center panel ===
// Take a deterministic 60-day price walk starting at 100, sigma 0.6 :
// matches the canonical "small systematic strategy" character so the
// chart looks honest (no 100× blowups, no flat lines).
const curveRng = seedFromString(buildSeed() + '::markets-curve');
const equitySeries = walk(curveRng, 100, 0.6, 60);

// === Yield curve for TermStructure ===
// 8 standard SOFR tenors, slightly inverted (a realistic 2026 shape).
// One flat reference spot at the 1M point.
const yieldCurve = [
  { tenor: '1M', yld: 5.32 },
  { tenor: '3M', yld: 5.28 },
  { tenor: '6M', yld: 5.21 },
  { tenor: '1Y', yld: 4.96 },
  { tenor: '2Y', yld: 4.71 },
  { tenor: '3Y', yld: 4.55 },
  { tenor: '5Y', yld: 4.42 },
  { tenor: '10Y', yld: 4.38 },
];

// === Secondary order book (right column) ===
// BTC-USD order book to pair with the SPX book on the left. v6.11.12 :
// pass the shared BTC-USD midPx so the right book shows the same BTC
// price as the stat card above + the tape. Previously it used its
// own internal walk (different sigma/seed) and rendered an unrelated
// synthetic price like $5,882 while the stat card showed $99,236.
const secondarySnap = getIndexSnap('BTC-USD');
const secondaryMidPx = secondarySnap?.px;
const secondarySymbol = 'BTC-USD';

// === Mini converter widget (v13.1.4 polish-7az) ===
// Resolve the 8-row preview set to its currency metadata so the static
// widget renders the same labels the converter page uses. The rate
// values themselves load client-side from ECB / Binance.
const previewCurrencies = MARKETS_PREVIEW_ROWS.map((id) => {
  const m = getCurrencyMeta(id);
  if (!m) throw new Error(`markets: missing currency ${id}`);
  return {
    id: m.id,
    symbol: m.symbol,
    name: m.name,
    source: m.source,
    decimals: m.decimals,
  };
});
---

<BaseLayout
  title="Markets"
  description="Deterministic Bloomberg-terminal layout: order book, term structure, coverage map, and PRNG-seeded index series. All numbers reproducible from BUILD_DATE."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Markets', href: '/markets' },
  ]}
>
  {
    /* ============================================================
       TAPE : full-bleed. The first thing the eye meets; instant
       signal density before the editorial copy begins.
       ============================================================ */
  }
  <MarketTape />

  {
    /* ============================================================
       HERO : identity-first, single column, dark editorial.
       Title is the page identity, not the navigation chrome.
       ============================================================ */
  }
  <section class="mk-hero">
    <div class="container mk-hero__inner">
      <ChromeHeader
        chip="MARKETS · TERMINAL VIEW · OPEN"
        eyebrow="DETERMINISTIC SNAPSHOT · SAME SEED · EVERY RENDER"
        tenant="CHRISTIAN.T.MACION · UTC+8 · BUILD_DATE DETERMINISTIC · OWNER-VERIFIED"
        noSep
        hideTenet
      />
      <h1 class="mk-hero__title" data-words>
        An institutional terminal for a portfolio that ships systems, not screenshots.
      </h1>
      <VoiceLine class="mk-hero__voice" ruled={false} size="md">
        Every number on this page is reproducible from <code>BUILD_DATE</code>. Same seed, same
        series, every render. The order book doesn't move because the data isn't moving.
      </VoiceLine>
      <p class="mk-hero__sub">
        A research view of what a quant desk reads in the first five minutes of the session: the
        tape, the book, the term structure, and the coverage map. All four primitives are reusable
        components and they also ship on <a href={path('/research')}>research</a>,
        <a href={path('/positions')}>positions</a>, and the
        <a href={path('/prediction-markets')}>prediction page</a>.
      </p>
    </div>
  </section>

  {
    /* ============================================================
       STATS ROW : 4 StatCells, indices + inline MiniSpark per cell.
       ============================================================ */
  }
  <section class="mk-stats">
    <div class="container">
      <div class="mk-stats__grid">
        {
          indexCards.map((c) => (
            <div class="mk-stats__cell">
              <StatCell label={c.label} value={c.value} delta={c.delta} sub={c.sub} />
              <div class="mk-stats__spark">
                <MiniSpark
                  points={c.spark}
                  width={220}
                  height={26}
                  ariaLabel={`${c.sym} 30-day series`}
                />
              </div>
              <p class="mk-stats__meta mono">
                <span class="mk-stats__meta-status">LIVE</span>
                <span class="mk-stats__meta-sep">·</span>
                <span class="mk-stats__meta-date">2024-01</span>
                <span class="mk-stats__meta-sep">·</span>
                <a href={path('/research')} class="mk-stats__meta-surface">/research/</a>
                <span class="mk-stats__meta-sep">·</span>
                <span class="mk-stats__meta-commit">9eba08f</span>
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* ============================================================
       3-COL TERMINAL : OrderBook (left) · EquityCurveChart (center)
       · Secondary OrderBook (right). On <=980px, stacks vertically.
       ============================================================ */
  }
  <section class="mk-terminal">
    <div class="container">
      <header class="mk-terminal__head">
        <p class="section__eyebrow">Book · Strategy · Book</p>
        <h2 class="mk-terminal__title">Live microstructure, three panels.</h2>
        <p class="section__sub">
          The center column is a real series, not a screenshot. Drawn from a 60-day Gaussian walk
          with a 6% annualized vol target. The book columns share the seed string so the ladders
          move coherently with the index tape above.
        </p>
      </header>

      <div class="mk-terminal__grid">
        <div class="mk-terminal__panel mk-terminal__panel--book">
          <OrderBook
            symbol="SPX"
            midPx={indexCards[0].spark[indexCards[0].spark.length - 1]}
            spreadBps={2}
            depth={12}
          />
        </div>
        <div class="mk-terminal__panel mk-terminal__panel--chart">
          <div class="mk-terminal__panel-head mono">EQUITY · strategy walk · 60d</div>
          <EquityCurveChart
            data={equitySeries}
            height={300}
            title="Composite strategy walk"
            caption="60-day composite walk from BUILD_DATE-seeded Gaussian random walk. σ = 0.6 daily; deterministic."
          />
        </div>
        <div class="mk-terminal__panel mk-terminal__panel--book">
          <OrderBook symbol={secondarySymbol} midPx={secondaryMidPx} spreadBps={4} depth={10} />
        </div>
      </div>
    </div>
  </section>

  {
    /* ============================================================
       BOTTOM BAND : CoverageGlobe · TermStructure · indices list.
       Three columns of equal weight; each is its own data primitive.
       ============================================================ */
  }
  <section class="mk-band">
    <div class="container">
      <div class="mk-band__grid">
        <div class="mk-band__panel">
          <CoverageGlobe />
        </div>
        <div class="mk-band__panel">
          <TermStructure
            points={yieldCurve}
            spot={yieldCurve[0].yld}
            caption="SOFR term structure · 1M to 10Y tenors · spot anchored at 1M"
            yFormat={(v) => `${v.toFixed(2)}%`}
          />
        </div>
        <div class="mk-band__panel">
          <div class="mk-band__indices">
            <h3 class="mk-band__indices-title mono">Indices</h3>
            <ol class="mk-band__indices-list mono">
              {
                indexCards.map((c, i) => (
                  <li class="mk-band__indices-row">
                    <span class="mk-band__indices-rank">{String(i + 1).padStart(2, '0')}</span>
                    <span class="mk-band__indices-sym">{c.sym}</span>
                    <span class="mk-band__indices-px">{c.value}</span>
                    <span
                      class:list={[
                        'mk-band__indices-delta',
                        c.delta > 0.005
                          ? 'mk-band__indices-delta--up'
                          : c.delta < -0.005
                            ? 'mk-band__indices-delta--down'
                            : 'mk-band__indices-delta--flat',
                      ]}
                    >
                      {c.delta > 0 ? '▲' : c.delta < 0 ? '▼' : '·'} {Math.abs(c.delta).toFixed(2)}%
                    </span>
                  </li>
                ))
              }
              {
                yieldCurve.slice(0, 4).map((y) => (
                  <li class="mk-band__indices-row">
                    <span class="mk-band__indices-rank">·</span>
                    <span class="mk-band__indices-sym">SOFR {y.tenor}</span>
                    <span class="mk-band__indices-px">{y.yld.toFixed(2)}%</span>
                    <span class="mk-band__indices-delta mk-band__indices-delta--flat">spot</span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mk-conv">
    <div class="container">
      <header class="mk-conv__head">
        <p class="section__eyebrow">Mini converter · 8 rows · live</p>
        <h2 class="mk-conv__title">Wire rates at a glance.</h2>
        <p class="section__sub">
          Six largest crypto by 24h turnover plus USD and PHP (Owner home base).
          Each row prefills the <a href={path('/converter/')}>full converter</a> on
          click and reuses the same ECB FX + Binance public REST endpoints.
        </p>
      </header>

      <div class="mk-conv__scroll" role="region" aria-label="Mini converter">
        <table class="mk-conv__table mono">
          <thead>
            <tr>
              <th class="mk-conv__th mk-conv__th--sym">Symbol</th>
              <th class="mk-conv__th">Name</th>
              <th class="mk-conv__th">Source</th>
              <th class="mk-conv__th mk-conv__th--num">Last (USD)</th>
              <th class="mk-conv__th mk-conv__th--num">24h Δ</th>
              <th class="mk-conv__th mk-conv__th--num">Updated</th>
            </tr>
          </thead>
          <tbody data-mk-conv-rows>
            {
              previewCurrencies.map((c) => (
                <tr
                  class="mk-conv__tr"
                  data-mk-conv-prefill={c.id}
                  tabindex="0"
                  role="button"
                  aria-label={`Open converter with ${c.symbol}`}
                >
                  <td class="mk-conv__td mk-conv__td--sym">{c.symbol}</td>
                  <td class="mk-conv__td mk-conv__td--name">{c.name}</td>
                  <td class="mk-conv__td mk-conv__td--source">
                    {c.source === 'crypto-binance'
                      ? 'BINANCE'
                      : c.source === 'fiat'
                        ? 'ECB / YF'
                        : 'COINGECKO'}
                  </td>
                  <td class="mk-conv__td mk-conv__td--num" data-mk-conv-px={c.id}>·</td>
                  <td class="mk-conv__td mk-conv__td--num" data-mk-conv-delta={c.id}>·</td>
                  <td class="mk-conv__td mk-conv__td--num" data-mk-conv-ts={c.id}>·</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mk-conv__cta mono">
        <a href={path('/converter/')} class="mk-conv__link">Open the full 30+ row converter →</a>
      </p>
    </div>
  </section>

  <p class="mk-canref mono">
    Animation reference:
    <a
      href="https://github.com/theatre-js/theatre"
      rel="noopener"
      data-license="Apache-2.0"
      target="_blank">theatre.js</a
    >
    (Apache-2.0 core / AGPL-3.0 studio) to reference-only.
  </p>

  <p class="mk-recency mono">
    Last updated: 2026-08-14 · commit <code class="mk-recency__commit">0619ea6</code>
  </p>

  <CTABanner
    title="Want to see the eval harness behind the numbers?"
    sub="Every primitive here ships as a reusable Astro component. The PRNG, the book ladder, the term-structure curve. All of it is the same code on /research and /positions."
    primaryLabel="Read methodology"
    primaryHref={path('/methodology')}
    secondaryLabel="See research projects"
    secondaryHref={path('/projects')}
  />
</BaseLayout>

<style>
  /* ============================================================
     HERO : dark editorial, terminal cadence.
     ============================================================ */
  .mk-hero {
    padding-block: clamp(var(--sp-7), 12vh, var(--sp-9));
    background: var(--c-tape);
    color: var(--ink-on-tape);
    border-bottom: 1px solid var(--c-white-mist);
  }
  .mk-hero__inner {
    max-width: 1080px;
  }
  .mk-hero__eyebrow {
    display: none;
  }
  .markets-head__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    flex-wrap: wrap;
  }
  .markets-head__eyebrow-chip {
    display: inline-block;
    padding: 4px 10px;
    /* v9.2 a11y : was --c-phi-teal. Dark theme --j-phi-teal = #2d5f5a
     only hits 2.14:1 on dark page-head surface. Solid amber chip +
     --c-bg text reads at ≥5.6:1 in both themes : institutional
     register, F14-safe (no traffic-light). */
    color: var(--c-bg);
    border: 1px solid var(--c-amber);
    background: var(--c-amber);
    font-weight: 600;
  }
  .markets-head__eyebrow-line {
    color: var(--c-warn);
    font-weight: 600;
  }
  .markets-head__tenant {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-4) 0 0;
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-tape-2);
    border: 1px solid var(--c-rule);
    font-size: 0.78rem;
    color: var(--c-ink-2);
    letter-spacing: 0.06em;
  }
  .markets-head__tenant span:nth-child(odd) {
    color: var(--c-warn);
    font-weight: 600;
  }
  .mk-hero__title {
    font-size: clamp(1.85rem, 4.4vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--c-primary);
    font-weight: 600;
    max-width: 22ch;
    margin-bottom: var(--sp-5);
  }
  .mk-hero__voice {
    color: var(--c-white-soft);
    margin-bottom: var(--sp-4);
    max-width: 64ch;
  }
  .mk-hero__voice code {
    font-family: var(--ff-mono);
    font-size: 0.85em;
    color: var(--c-amber);
    background: color-mix(in oklab, var(--c-amber) 8%, transparent);
    padding: 0.05em 0.4em;
    border-radius: 1px;
  }
  .mk-hero__sub {
    font-size: var(--fs-base);
    color: var(--c-white-faint);
    line-height: 1.65;
    max-width: 64ch;
  }
  .mk-hero__sub a {
    color: var(--c-amber);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 3px;
  }

  /* ============================================================
     STATS ROW : 4-up grid of StatCell + inline sparkline.
     ============================================================ */
  .mk-stats {
    padding-block: var(--sp-7);
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-rule);
  }
  .mk-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
  }
  .mk-stats__cell {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .mk-stats__spark {
    padding: var(--sp-2) var(--sp-4);
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    border-top: 0;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    margin-top: -1px;
    display: flex;
    align-items: center;
  }
  .mk-stats__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    align-items: center;
    margin: var(--sp-2) 0 0;
    padding: var(--sp-2) 0 0;
    border-top: 1px dashed var(--c-rule);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-ink-3);
  }
  .mk-stats__meta-status {
    color: var(--c-amber);
    font-weight: 600;
  }
  .mk-stats__meta-sep {
    color: var(--c-ink-3);
    opacity: 0.5;
  }
  .mk-stats__meta-surface {
    color: var(--c-ink-2);
    text-decoration: none;
  }
  .mk-stats__meta-surface:hover {
    color: var(--c-amber);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .mk-stats__meta-commit {
    color: var(--c-ink-3);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 880px) {
    .mk-stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .mk-stats__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-3);
    }
  }

  /* ============================================================
     3-COL TERMINAL : OrderBook | EquityCurve | OrderBook.
     ============================================================ */
  .mk-terminal {
    padding-block: var(--sp-8);
    background: var(--c-bg-2);
  }
  .mk-terminal__head {
    margin-bottom: var(--sp-6);
  }
  .mk-terminal__title {
    font-size: var(--fs-2xl);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-3);
  }
  .mk-terminal__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.4fr 0.85fr;
    gap: var(--sp-4);
    align-items: stretch;
  }
  .mk-terminal__panel {
    min-width: 0;
  }
  .mk-terminal__panel-head {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-ink-3);
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--c-rule);
  }
  @media (max-width: 1080px) {
    .mk-terminal__grid {
      grid-template-columns: 1fr 1fr;
    }
    .mk-terminal__panel--chart {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 720px) {
    .mk-terminal__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ============================================================
     BOTTOM BAND : CoverageGlobe · TermStructure · indices list.
     ============================================================ */
  .mk-band {
    padding-block: var(--sp-7);
    background: var(--c-tape-2);
    border-block: 1px solid var(--c-white-mist);
  }
  .mk-band__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr 0.85fr;
    gap: var(--sp-4);
    align-items: start;
  }
  @media (max-width: 1080px) {
    .mk-band__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 720px) {
    .mk-band__grid {
      grid-template-columns: 1fr;
    }
  }

  .mk-band__indices {
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    padding: var(--sp-4);
  }
  .mk-band__indices-title {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-ink-3);
    margin: 0 0 var(--sp-3);
  }
  .mk-band__indices-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .mk-band__indices-row {
    display: grid;
    grid-template-columns: 28px 1fr auto auto;
    gap: var(--sp-3);
    padding: var(--sp-2) 0;
    border-bottom: 1px dashed var(--c-rule);
    align-items: baseline;
    font-size: 0.74rem;
  }
  .mk-band__indices-row:last-child {
    border-bottom: 0;
  }
  .mk-band__indices-rank {
    color: var(--c-ink-3);
    font-size: 0.7rem;
  }
  .mk-band__indices-sym {
    color: var(--c-ink);
    font-weight: 600;
  }
  .mk-band__indices-px {
    color: var(--c-amber);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  .mk-band__indices-delta {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
    color: var(--c-ink-2);
  }
  /* v6.11.10 : F14 amber-only rule. Sign carried by glyph (▲/▼)
     + intensity (soft/normal), not hue. No traffic-light chrome. */
  .mk-band__indices-delta--up {
    color: var(--c-amber);
  }
  .mk-band__indices-delta--down {
    color: var(--c-ink-2);
  }
  .mk-band__indices-delta--flat {
    color: var(--c-ink-3);
  }

  /* ============================================================
     RECENCY STAMP : small mono line at the page foot, citing the
     most recent polish commit. Institutional register; amber dot.
     ============================================================ */
  .mk-recency {
    margin: var(--sp-6) auto 0;
    max-width: 1080px;
    padding: var(--sp-3) var(--sp-4);
    border-top: 1px solid var(--c-rule);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--c-ink-3);
    text-transform: uppercase;
  }
  .mk-recency__commit {
    color: var(--c-amber);
    font-family: var(--ff-mono);
    font-size: 0.78rem;
    background: color-mix(in oklab, var(--c-amber) 8%, transparent);
    padding: 0.05em 0.4em;
    border-radius: 1px;
  }

  /* ============================================================
     MINI CONVERTER (v13.1.4 polish-7az) : 8-row institutional
     preview of the full /converter/ page. Mono numbers, amber
     deltas, hairline rows, sharp corners. Chrome contract v1
     held (mono + amber + hairline + 0-2px radius).
     ============================================================ */
  .mk-conv {
    padding-block: var(--sp-7);
    background: var(--c-bg);
    border-block: 1px solid var(--c-rule);
  }
  .mk-conv__head {
    margin-bottom: var(--sp-5);
  }
  .mk-conv__title {
    font-size: var(--fs-xl);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: var(--sp-2) 0 var(--sp-3);
  }
  .mk-conv__head a {
    color: var(--c-amber);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 3px;
  }
  .mk-conv__scroll {
    overflow-x: auto;
    border: 1px solid var(--c-rule);
    background: var(--c-bg-2);
  }
  .mk-conv__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
  }
  .mk-conv__th {
    text-align: left;
    padding: var(--sp-2) var(--sp-3);
    font-weight: 500;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--c-ink-3);
    text-transform: uppercase;
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg);
    white-space: nowrap;
  }
  .mk-conv__th--num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  .mk-conv__tr {
    cursor: pointer;
    transition: background 80ms ease;
  }
  .mk-conv__tr:hover,
  .mk-conv__tr:focus-visible {
    background: color-mix(in oklab, var(--c-amber) 4%, var(--c-bg-2));
    outline: none;
  }
  .mk-conv__tr:focus-visible {
    box-shadow: inset 2px 0 0 var(--c-amber);
  }
  .mk-conv__td {
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--c-rule-soft);
    color: var(--c-ink);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
    white-space: nowrap;
  }
  .mk-conv__td--num {
    text-align: right;
  }
  .mk-conv__td--sym {
    font-weight: 600;
    color: var(--c-ink);
  }
  .mk-conv__td--name {
    color: var(--c-ink-2);
    font-size: 0.72rem;
  }
  .mk-conv__td--source {
    font-size: 0.66rem;
    color: var(--c-ink-3);
    letter-spacing: 0.06em;
  }
  .mk-conv__cta {
    margin: var(--sp-4) 0 0;
    text-align: right;
    font-size: 0.74rem;
  }
  .mk-conv__link {
    color: var(--c-amber);
    text-decoration: none;
    border-bottom: 1px dashed var(--c-amber-decor);
    padding-bottom: 2px;
  }
  .mk-conv__link:hover {
    border-bottom-style: solid;
  }
  @media (prefers-reduced-motion: reduce) {
    .mk-conv__tr {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Mini converter boot script (/markets/): populate the 8-row table
   * with live rates from the same ECB / Binance endpoints the full
   * /converter/ page uses. Click any row to navigate to the full
   * converter prefilled with that currency.
   */

  (() => {
    const fxCurrencies = ['USD', 'PHP'];
    const cryptoSymbols: Record<string, string> = {
      BTC: 'BTCUSDT',
      ETH: 'ETHUSDT',
      SOL: 'SOLUSDT',
      BNB: 'BNBUSDT',
      XRP: 'XRPUSDT',
      ADA: 'ADAUSDT',
    };

    function $n<T extends HTMLElement>(sel: string): T | null {
      return document.querySelector(sel) as T | null;
    }
    function fmt(n: number, d: number): string {
      if (!Number.isFinite(n) || n === 0) return '·';
      return new Intl.NumberFormat('en-US', {
        minimumFractionDigits: d,
        maximumFractionDigits: d,
      }).format(n);
    }
    function fmtSigned(n: number): string {
      if (!Number.isFinite(n)) return '·';
      return (n > 0 ? '▲ ' : n < 0 ? '▼ ' : '· ') + Math.abs(n).toFixed(2) + '%';
    }
    function ts(): string {
      const d = new Date();
      return `${String(d.getUTCHours()).padStart(2, '0')}:${String(d.getUTCMinutes()).padStart(2, '0')}:${String(d.getUTCSeconds()).padStart(2, '0')}Z`;
    }

    async function fetchYahoo(ticker: string): Promise<number> {
      const url = 'https://query1.finance.yahoo.com/v8/finance/chart/' + encodeURIComponent(ticker) + '?interval=1d&range=1d';
      const resp = await fetch(url);
      if (!resp.ok) throw new Error('YF ' + resp.status);
      const j = await resp.json();
      const px = j?.chart?.result?.[0]?.meta?.regularMarketPrice;
      if (!Number.isFinite(px)) throw new Error('YF: no px');
      return 1 / px; // USD per 1 unit of quote ticker
    }
    async function fetchBinance(sym: string): Promise<{ last: number; change: number }> {
      const resp = await fetch('https://api.binance.com/api/v3/ticker/24hr?symbol=' + sym);
      if (!resp.ok) throw new Error('BIN ' + resp.status);
      const t = await resp.json();
      return {
        last: parseFloat(t.lastPrice ?? '0'),
        change: parseFloat(t.priceChangePercent ?? '0'),
      };
    }

    async function populate(): Promise<void> {
      const stamp = ts();

      // Crypto first : independent per-row fetches.
      for (const [id, sym] of Object.entries(cryptoSymbols)) {
        try {
          const r = await fetchBinance(sym);
          const px = $n<HTMLElement>(`[data-mk-conv-px="${id}"]`);
          const d = $n<HTMLElement>(`[data-mk-conv-delta="${id}"]`);
          const tEl = $n<HTMLElement>(`[data-mk-conv-ts="${id}"]`);
          if (px) px.textContent = '$' + fmt(r.last, id === 'BTC' ? 2 : 4);
          if (d) {
            d.textContent = fmtSigned(r.change);
            d.classList.add(
              r.change > 0.05
                ? 'mk-conv__td--up'
                : r.change < -0.05
                  ? 'mk-conv__td--down'
                  : 'mk-conv__td--flat',
            );
          }
          if (tEl) tEl.textContent = stamp;
        } catch (_e) {
          /* leave cells as · */
        }
      }

      // USD is the anchor : 1 USD = 1 USD.
      const usdPx = $n<HTMLElement>('[data-mk-conv-px="USD"]');
      const usdTs = $n<HTMLElement>('[data-mk-conv-ts="USD"]');
      if (usdPx) usdPx.textContent = '$1.00';
      if (usdTs) usdTs.textContent = stamp;

      // PHP : resolve via Yahoo Finance (ECB does not publish PHP).
      try {
        const usdPerPhp = await fetchYahoo('PHP=X');
        const phpPx = $n<HTMLElement>('[data-mk-conv-px="PHP"]');
        const phpTs = $n<HTMLElement>('[data-mk-conv-ts="PHP"]');
        if (phpPx) phpPx.textContent = '$' + fmt(usdPerPhp, 6);
        if (phpTs) phpTs.textContent = stamp;
      } catch (_e) {
        /* leave PHP cells as · */
      }
    }

    function wireRowPrefill(): void {
      const tbody = $n<HTMLElement>('[data-mk-conv-rows]');
      if (!tbody) return;
      tbody.querySelectorAll<HTMLElement>('[data-mk-conv-prefill]').forEach((row) => {
        const id = row.getAttribute('data-mk-conv-prefill');
        if (!id) return;
        const go = (e: Event) => {
          e.preventDefault();
          const base = (import.meta as any).env?.BASE_URL?.replace(/\/$/, '') ?? '';
          window.location.href = base + '/converter/?from=' + id;
        };
        row.addEventListener('click', go);
        row.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ') go(e);
        });
      });
    }

    wireRowPrefill();
    populate();
    // Refresh every 30s for both tables; keeps the preview honest.
    // without thrashing the upstream endpoints.
    setInterval(populate, 30000);
  })();
</script>
