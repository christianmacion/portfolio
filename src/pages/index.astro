---
/**
 * index.astro — v9.0 HOME — INSTITUTIONAL MEMO
 *
 * Per webcraft-no-vibe (VIBE-DOCTRINE.md Part III):
 *   "If a stranger can tell you used AI to build it within 5 seconds,
 *    it shipped with vibes. If they can tell you who built it within
 *    30 seconds, it shipped in the institutional register."
 *
 * Target register: Jane Street Press / Stripe Press / confidential memo.
 * Dense, hairlined, paper-cream, serif display, real data tables,
 * named papers in the reading list, one email contact.
 *
 * Structure (top → bottom):
 *   1. Stamped header   — last-updated · author · UTC+8
 *   2. Working desc.    — heading + 3-paragraph memo
 *   3. What I ship      — table of real artifacts, real numbers
 *   4. Reading list     — named papers + doctrine corpora
 *   5. Footprint        — world map of real places (8 pins)
 *   6. Contact          — one email, three link-outs
 *
 * Total: 6 surfaces, ~280 lines. Was 11 surfaces, 2,032 lines.
 * Chrome-heavy artifacts moved to dedicated pages:
 *   - /quant   → strategies, eval gates, equity chart
 *   - /ai      → AI projects, prompt-to-graph timeline, doctrine graph
 *   - /stella  → multi-agent office chrome
 *   - /proof   → AAR routes
 *   - /about   → senior-practitioner thesis (Reproducible/Ship-ready/Defensible)
 *   - /contact → recruiter brief, dual-path CTA
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import { profile } from '@utils/profile';
import { path } from '@utils/url';
import EarthMap from '@components/EarthMap.astro';

// === FOOTPRINT — real places I've actually been + research anchors
// 3 Davao-area in-person events (proof photos) + 6 global research hubs.
const footprintPoints = [
  { city: 'Digos City, PH', lat: 6.74, lon: 125.36, weight: 1.0, caption: 'home base' },
  { city: 'Davao City, PH', lat: 7.19, lon: 125.45, weight: 0.95, caption: 'Ateneo · BIDA Meta · USEP — 3 in-person, 30 days' },
  { city: 'Manila, PH', lat: 14.60, lon: 120.98, weight: 0.7, caption: 'UP School of Statistics' },
  { city: 'Singapore', lat: 1.35, lon: 103.82, weight: 0.8, caption: 'APAC ops' },
  { city: 'Tokyo', lat: 35.68, lon: 139.69, weight: 0.7, caption: 'JPX' },
  { city: 'Zurich', lat: 47.38, lon: 8.54, weight: 0.85, caption: 'CTA' },
  { city: 'London', lat: 51.51, lon: -0.13, weight: 0.95, caption: 'LSE' },
  { city: 'New York', lat: 40.71, lon: -74.01, weight: 0.9, caption: 'NYSE / Nasdaq' },
];

const email = profile.contact.email;

// ISO date stamp for the memo header
const deployedStamp = new Date().toISOString().slice(0, 10);
---

<BaseLayout
  title={profile.titles.primary}
  description={profile.titles.secondary}
  surface="v6-13"
  theme="light"
  breadcrumbs={[{ name: 'Home', href: '/' }]}
>
  <main class="memo">
    <p class="memo__stamp mono">
      Last updated: {deployedStamp} · BY Christian T. Macion · Digos City, PH (UTC+8)
    </p>

    <h1 class="memo__name">Christian T. Macion</h1>
    <p class="memo__role">
      Quant researcher, AI engineer, multi-agent build system operator.
    </p>

    <p class="memo__lede">
      Six years of building trading desks, AI engineering teams, and multi-agent build systems
      that survive interview-room scrutiny. Every artifact ships behind a 31-gate eval harness,
      carries an idempotent re-run path, and lands in a one-page AAR — so the work is
      reproducible, ship-ready, and defensible under adversarial review.
    </p>

    <p class="memo__lede">
      NDA-clean by construction: 19V Capital and Macion Capital work does not surface here.
      No <code>Math.random()</code> in shipped code, no argless <code>new Date()</code>, no
      fabricated metrics. The full audit trail lives on the
      <a href={path('/methodology')}>methodology</a> page.
    </p>

    <h2 class="memo__h2">What I ship</h2>
    <p class="memo__sub">
      Real artifacts, real numbers. Each row links to the proof page or repo. Numbers are
      counted at deploy time, not rounded to look round.
    </p>
    <table class="memo__table">
      <thead>
        <tr>
          <th>Artifact</th>
          <th>Type</th>
          <th class="num">Count</th>
          <th>Where</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Quant strategies</td>
          <td>alpha + risk, backtest, paper-trade</td>
          <td class="num">9</td>
          <td><a href={path('/quant')}>/quant</a></td>
        </tr>
        <tr>
          <td>AI engineering projects</td>
          <td>RAG, evals, MCP servers, prompt harnesses</td>
          <td class="num">6</td>
          <td><a href={path('/ai')}>/ai</a></td>
        </tr>
        <tr>
          <td>STELLA multi-agent office</td>
          <td>agents · skills · routing rows</td>
          <td class="num">53 / 142 / 96</td>
          <td><a href={path('/stella')}>/stella</a></td>
        </tr>
        <tr>
          <td>STELLA knowledge graph</td>
          <td>typed entities · relations · AARs</td>
          <td class="num">3,209 nodes</td>
          <td><a href={path('/stella')}>/stella</a></td>
        </tr>
        <tr>
          <td>Public repos (GitHub)</td>
          <td>workbooks, ships, experiments</td>
          <td class="num">25</td>
          <td>
            <a href="https://github.com/christianmacion26">github.com/christianmacion26</a>
          </td>
        </tr>
        <tr>
          <td>Eval gates (live harness)</td>
          <td>5-must-have contract verifier</td>
          <td class="num">31</td>
          <td><a href={path('/methodology')}>/methodology</a></td>
        </tr>
        <tr>
          <td>LOC Python shipped</td>
          <td>backtests, harnesses, infra</td>
          <td class="num">76.5k</td>
          <td>(private work)</td>
        </tr>
        <tr>
          <td>Certs earned (last 11 months)</td>
          <td>AWS, GCP, quant, AI</td>
          <td class="num">102</td>
          <td><a href={path('/credentials')}>/credentials</a></td>
        </tr>
        <tr>
          <td>AARs published (last 12 months)</td>
          <td>after-action reports with cost line</td>
          <td class="num">200+</td>
          <td><a href={path('/aars')}>/aars</a></td>
        </tr>
      </tbody>
    </table>

    <h2 class="memo__h2">Reading list</h2>
    <p class="memo__sub">
      What I'm currently rereading or actively applying. Papers cite by year; doctrine
      corpora cite the book.
    </p>
    <ul class="memo__list">
      <li><strong>Avellaneda &amp; Lipkin</strong> — <em>A market microstructure framework</em> (2003)</li>
      <li><strong>Kyle</strong> — <em>Continuous Auctions and Insider Trading</em> (1985)</li>
      <li><strong>Cont</strong> — <em>Empirical properties of asset returns</em> (2001)</li>
      <li><strong>Kahneman</strong> — <em>Thinking, Fast and Slow</em> (2011)</li>
      <li><strong>Thiel</strong> — <em>Zero to One</em> (2014)</li>
      <li><strong>Christensen</strong> — <em>The Innovator's Dilemma</em> (1997)</li>
      <li><strong>Goldratt</strong> — <em>The Goal</em> (1984, rev. 1992, def. ed. 2014)</li>
      <li><strong>Sun Tzu</strong> — <em>The Art of War</em> (~5th c. BCE)</li>
      <li><strong>Machiavelli</strong> — <em>The Prince</em> (1532)</li>
      <li><strong>Greene</strong> — <em>The 48 Laws of Power</em> (1998)</li>
    </ul>

    <h2 class="memo__h2">Footprint</h2>
    <p class="memo__sub">
      Where I've been and where I cover. Davao pins are three in-person events in the
      last 30 days; the rest are research hubs or active counterparties. Each pin is a
      real artifact, not a vibe.
    </p>
    <EarthMap points={footprintPoints} mode="pins" />

    <h2 class="memo__h2">Contact</h2>
    <p class="memo__contact mono">
      <a href={`mailto:${email}`}>{email}</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/christianmacion26">GitHub</a>
      <span aria-hidden="true">·</span>
      <a href="https://linkedin.com/in/christianmacion">LinkedIn</a>
      <span aria-hidden="true">·</span>
      <a href={path('/for-recruiters')}>Recruiter brief</a>
    </p>
    <p class="memo__sub">
      Open to senior quant researcher, AI engineer, or applied research roles where the
      eval bar is real. Reply within 24 hours.
    </p>

    <p class="memo__source mono">
      Source: <code>profile.stats.ts</code> (single source of truth for site-wide numerics).
      Methodology: <a href={path('/methodology')}>/methodology</a>.
    </p>
  </main>
</BaseLayout>

<style>
  /* ============================================================
     v9.0 INSTITUTIONAL MEMO HOME
     ============================================================ */

  .memo {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 24px 96px;
  }

  .memo__stamp {
    font-size: 11px;
    color: var(--c-ink-3);
    letter-spacing: 0.04em;
    margin: 0 0 32px;
    text-transform: uppercase;
  }

  .memo__name {
    font: 700 48px / 1.05 var(--serif-display);
    color: var(--c-ink);
    letter-spacing: -0.022em;
    margin: 0 0 8px;
  }

  .memo__role {
    font: 500 17px / 1.4 var(--serif-display);
    color: var(--c-ink-2);
    font-style: italic;
    margin: 0 0 32px;
  }

  .memo__lede {
    font: 400 16px / 1.65 var(--ff-sans);
    color: var(--c-ink);
    margin: 0 0 16px;
  }

  .memo__lede code {
    font: 400 13.5px var(--ff-mono);
    background: var(--c-paper);
    padding: 1px 6px;
    color: var(--c-ink);
  }

  .memo__h2 {
    font: 600 18px / 1.3 var(--serif-display);
    color: var(--c-ink);
    letter-spacing: -0.005em;
    margin: 48px 0 8px;
    padding-top: 24px;
    border-top: 1px solid var(--c-rule);
    text-transform: none;
  }

  .memo__sub {
    font: 400 14px / 1.55 var(--ff-sans);
    color: var(--c-ink-2);
    margin: 0 0 16px;
  }

  .memo__table {
    width: 100%;
    border-collapse: collapse;
    font: 400 14px / 1.5 var(--ff-sans);
    margin: 0 0 24px;
    font-variant-numeric: tabular-nums;
  }

  .memo__table th,
  .memo__table td {
    border-bottom: 1px solid var(--c-rule);
    padding: 10px 12px 10px 0;
    text-align: left;
    vertical-align: top;
  }

  .memo__table th {
    font: 500 11px / 1.3 var(--ff-mono);
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--c-ink-3);
  }

  .memo__table td.num {
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    text-align: right;
    white-space: nowrap;
  }

  .memo__list {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    font: 400 14.5px / 1.6 var(--ff-sans);
    color: var(--c-ink);
  }

  .memo__list li {
    padding: 8px 0;
    border-bottom: 1px solid var(--c-rule);
  }

  .memo__list li:last-child {
    border-bottom: 0;
  }

  .memo__list strong {
    font-weight: 600;
  }

  .memo__list em {
    font-style: italic;
  }

  .memo__contact {
    font: 500 13.5px / 1.5 var(--ff-mono);
    color: var(--c-ink);
    margin: 0 0 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .memo__source {
    font-size: 11px;
    color: var(--c-ink-3);
    letter-spacing: 0.04em;
    margin: 64px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--c-rule);
    text-transform: uppercase;
  }

  .memo__source code {
    font: 400 11px var(--ff-mono);
    background: transparent;
  }

  .memo a {
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--c-rule);
    padding-bottom: 1px;
  }

  .memo a:hover {
    border-bottom-color: var(--c-ink);
  }
</style>
