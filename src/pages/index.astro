---
/**
 * index.astro : v9.1 HOME : INSTITUTIONAL BROADSIDE
 *
 * Per webcraft-no-vibe (VIBE-DOCTRINE.md Part III):
 *   "If a stranger can tell you used AI to build it within 5 seconds,
 *    it shipped with vibes. If they can tell you who built it within
 *    30 seconds, it shipped in the institutional register."
 *
 * Target register: Jane Street Press / Stripe Press / FT-style broadside.
 *
 * Visual identity:
 *   - Geometric CM monogram (signature mark, top-left)
 *   - Running header tape (deploy date + version + UTC offset + nav links)
 *   - Big Roman-serif display H1 (italic middle name, FT-style)
 *   - Hairline rules between sections, like a printed broadside
 *   - Section marks (§ 01, § 02) : editorial register
 *   - Tabular data strip (6 live counters : anchor the page as "alive")
 *   - Last: world map (8 pins) : the v8.5.1 hotfix, preserved
 *
 * Density: 5 sections, ~480 lines. Was 11 sections, 2,032 lines.
 */

import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import { profile } from '@utils/profile';
import { path } from '@utils/url';
import headshot from '../assets/portrait/headshot-source.jpg';
import EarthMap from '@components/EarthMap.astro';
import Marquee from '@components/Marquee.astro';
import HeroSkills from '@components/HeroSkills.astro';
import HeroCurve from '@components/HeroCurve.astro';
import CertWall from '@components/CertWall.astro';
import SectionMark from '@components/SectionMark.astro';
import FiveEraCurve from '@components/FiveEraCurve.astro';
import GatesLattice from '@components/GatesLattice.astro';
import AIHistoryTimeline from '@components/AIHistoryTimeline.astro';

// v9.4.1 FLAGSHIP HERO : re-aimed for hireability.
// Marquee ribbon between hero and counter strip. Reuses Marquee.astro.
// v9.4.1: removed STELLA / GATE STACK / Acion / workbook chips (internal
// jargon). Replaced with recruiter-readable proof chips that match the
// skills matrix on the right side of the hero.
const heroMarqueeItems = [
  '6 YEARS · QUANT RESEARCH + AI ENGINEERING',
  '9 PAPER-TRADED ALPHA STRATEGIES',
  '76.5K PYTHON LOC',
  '6 AI ENGINEERING PROJECTS SHIPPED',
  '25 PUBLIC GITHUB REPOSITORIES',
  'STA TIER-1 CERTIFIED TECHNICAL ANALYST',
];

const footprintPoints = [
  // Home base : Digos City, Davao del Sur, Philippines. Canonical 6.74°N, 125.36°E.
  { city: 'Digos City, PH', lat: 6.74, lon: 125.36, weight: 1.0, caption: 'home base · UTC+8', labelAnchor: 'bottom' as const, labelDx: 8, labelDy: 6 },
  // 16 financial markets hubs : coverage of equities, futures, FX, crypto, alt-data.
  // Each one is a real venue + a real venue-type (exchange / market-maker / data).
  // v12.W4 Bryllim parity : dense clusters get explicit label anchors so
  // the labels never overlap their pins (London/Frankfurt/Zurich, Chicago/
  // Toronto, Tokyo/Seoul, HK/Shanghai/Manila, Singapore/Manila, NYC/GMU).
  { city: 'Manila, PH', lat: 14.6, lon: 120.98, weight: 0.7, caption: 'PDEx · PSE', labelAnchor: 'right' as const },
  { city: 'Singapore', lat: 1.35, lon: 103.82, weight: 0.9, caption: 'SGX · APAC derivatives', labelAnchor: 'bottom' as const, labelDx: -10, labelDy: 16 },
  { city: 'Hong Kong', lat: 22.32, lon: 114.17, weight: 0.85, caption: 'HKEX · HSI · Hang Seng', labelAnchor: 'right' as const, labelDx: 6 },
  { city: 'Tokyo', lat: 35.68, lon: 139.69, weight: 0.85, caption: 'JPX · TSE · Nikkei', labelAnchor: 'top' as const, labelDy: -8 },
  { city: 'Shanghai', lat: 31.23, lon: 121.47, weight: 0.7, caption: 'SHFE · SSE', labelAnchor: 'top' as const, labelDx: -14, labelDy: -8 },
  { city: 'Mumbai', lat: 19.08, lon: 72.88, weight: 0.7, caption: 'NSE · BSE · Nifty', labelAnchor: 'top' as const, labelDy: -6 },
  { city: 'Dubai', lat: 25.2, lon: 55.27, weight: 0.6, caption: 'DGCX · regional oil', labelAnchor: 'top' as const, labelDy: -6 },
  { city: 'Seoul', lat: 37.56, lon: 126.97, weight: 0.7, caption: 'KRX · Kospi', labelAnchor: 'top' as const, labelDx: 14, labelDy: -10 },
  { city: 'Sydney', lat: -33.87, lon: 151.21, weight: 0.6, caption: 'ASX', labelAnchor: 'top' as const },
  { city: 'Tokyo (alt-data)', lat: 35.68, lon: 139.78, weight: 0.5, caption: 'Japan alt-data · consumption', labelAnchor: 'right' as const, labelDx: 8 },
  { city: 'London', lat: 51.51, lon: -0.13, weight: 0.95, caption: 'LSE · ICE · LCH · FX', labelAnchor: 'top' as const, labelDx: -16, labelDy: -10 },
  { city: 'Frankfurt', lat: 50.11, lon: 8.68, weight: 0.85, caption: 'Eurex · DAX', labelAnchor: 'bottom' as const, labelDy: 14 },
  { city: 'Zurich', lat: 47.38, lon: 8.54, weight: 0.85, caption: 'SIX · CTA', labelAnchor: 'top' as const, labelDx: 10, labelDy: -10 },
  { city: 'Chicago', lat: 41.88, lon: -87.63, weight: 0.9, caption: 'CME · CBOT · agricultural', labelAnchor: 'top' as const, labelDy: -8 },
  { city: 'New York', lat: 40.71, lon: -74.01, weight: 1.0, caption: 'NYSE · Nasdaq · Bloomberg · Refinitiv', labelAnchor: 'bottom' as const, labelDx: -10, labelDy: 18 },
  { city: 'Zug, CH', lat: 47.17, lon: 8.51, weight: 0.7, caption: 'Crypto Valley · Ethereum foundation', labelAnchor: 'right' as const, labelDx: 8 },
  { city: 'San Francisco', lat: 37.77, lon: -122.42, weight: 0.7, caption: 'Coinbase · Kraken · FalconX', labelAnchor: 'top' as const, labelDy: -6 },
  { city: 'São Paulo', lat: -23.55, lon: -46.63, weight: 0.6, caption: 'B3 · Bovespa', labelAnchor: 'top' as const, labelDy: -8 },
  { city: 'Toronto', lat: 43.65, lon: -79.38, weight: 0.6, caption: 'TSX · Toronto-Dominion', labelAnchor: 'right' as const, labelDx: 8 },
  { city: 'GMU (GDELT)', lat: 38.83, lon: -77.31, weight: 0.5, caption: 'GDELT · alt-data · events 15-min', labelAnchor: 'top' as const, labelDx: 10, labelDy: -8 },
];

const email = profile.contact.email;
// v9.3.5 : deployedStamp + buildTime moved to SiteHeader.astro (single source of truth).

// Live counters : v9.4.1 hireability-facing. All sourced from profile.stats.ts.
// Stripped AARs / evalGates / pagesBuilt from first viewport (internal jargon);
// yearsExperience + aiProjectCount added so the strip answers a recruiter's
// "how long + how much" question in 5 seconds.
const liveCounters = [
  { label: 'YEARS EXPERIENCE', value: profile.stats.yearsExperience },
  { label: 'QUANT STRATEGIES', value: profile.stats.strategyCount },
  { label: 'PYTHON LOC', value: profile.stats.locPython },
  { label: 'AI PROJECTS', value: profile.stats.aiProjectCount },
  { label: 'PUBLIC GITHUB REPOS', value: profile.stats.repoCount },
  { label: 'CERTIFICATIONS', value: profile.stats.certCount },
];
---

<BaseLayout
  title={profile.titles.pageTitle}
  description={profile.titles.secondary}
  surface="v6-13"
  theme="light"
  chrome="full"
  pixelDisplay={true}
  breadcrumbs={[{ name: 'Home', href: '/' }]}
>
  <!-- v9.3.2 (2026-08-02) : a11y: BaseLayout.astro already wraps the
       page in <main id="main">; rendering an inner <main> here produced
       nested <main> landmarks (invalid HTML5; confusing to screen-reader
       landmark navigation). Replaced with <section> so the broadside is
       semantically sectioned, not landmarked. The outer BaseLayout
       <main id="main"> remains the single landmark for AT users. -->
  <section class="broadside home-section" aria-label="Home broadside">
    <!-- v9.3.5 : running header tape REMOVED. The global SiteHeader (above
         the Nav) now ships the CM monogram + name + role + UTC + deployed
         stamp on every page, including home. The downstream nav row is
         covered by the global Nav component. The home page keeps its
         flagship hero (eyebrow + H1 + role), stats strip, hook, and
         quick-route grid. the broadside reading still differentiates
         home from subpages; the chrome is now shared. -->

    <!-- ============= 00 : HOME =============
         Bryllim-style number-prefixed section header. Mono digit + space
         + em-dash + space + lowercase name. Sits BEFORE the existing
         hero landmark as an editorial section register (not a heading).
         The hero H1 below remains the page H1; this mark is decorative
         chrome so a11y heading hierarchy is preserved. -->
    <SectionMark index="00" title="home" />

    <!-- ============= v11.W1.2 HIRING HERO =============
         Left: searchable role title, hybrid value proposition, recruiter CTAs.
         Right: concise expertise matrix showing quant + AI engineering capability.
         v11.W1.2: H1 = "Quantitative Researcher" (seniority signalled via
         tenure + proof + Stage 0 doctrine integration, not the bare title).
         Role line refreshed for financial markets. Voice: Munger latticework
         (quant + AI + chrome as one cross-validated practice), Tetlock
         calibration (sample size + era on every OOS claim), Kahneman
         System-2 (numbers + evidence + tenure), Sagan Standard (every
         number verified or removed), Goldratt constraint (proof beats
         chrome, chrome never delays the proof beat). -->
    <section class="hero-flagship" aria-label="Quantitative researcher and AI engineer for financial markets">
      <!-- v12.W4 Bryllim parity : headshot is the FIRST element of the home
           hero. SideRail brand block is now text-only (no face photo). The
           landing-page owns the "this is me" first-impression beat. Source
           is 755x1200 portrait (aspect 0.629); we honor the natural ratio
           so the FULL image is visible. Widths=[200, 280, 440] match the
           sizes attribute: 200px on mobile, 280px on desktop. -->
      <figure class="hero-flagship__headshot">
        <Image
          src={headshot}
          alt={profile.headshot.alt}
          width={280}
          height={445}
          widths={[200, 280, 440]}
          sizes="(max-width: 720px) 200px, 280px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero-flagship__headshot-img"
        />
        <figcaption class="hero-flagship__headshot-credit mono">{profile.headshot.credit}</figcaption>
      </figure>

      <div class="hero-flagship__copy">
        <p class="hero-flagship__eyebrow mono" data-stagger="1">
          CHRISTIAN T. MACION · DIGOS CITY, DAVAO DEL SUR, PHILIPPINES · REMOTE (UTC+8)
        </p>
        <p class="hero-flagship__availability mono" data-stagger="2">
          OPEN TO QUANT RESEARCH + AI ENGINEER ROLES FOR FINANCIAL MARKETS · REMOTE 30 HRS/WK · UTC+8
        </p>
        <!-- v12.W4 : removed pixel-display class so the H1 renders in
             Inter display (var(--j-ff-display)) instead of JetBrains Mono.
             The Bryllim reference uses pixel LOGO + serif body; the H1
             is the body, so it ships as institutional sans-serif (FT /
             Bloomberg register), not bitmap mono. data-words fires the
             motion.ts word-wrap so "Quantitative Researcher" cascades
             into view on load (80ms cadence, see motion.css §3). -->
        <h1 class="hero-flagship__name" data-stagger="3" data-words>
          Quantitative Researcher
        </h1>
        <p class="hero-flagship__role" data-stagger="4">
          AI Engineer. Quantitative Researcher. 6 years. Live systems, not slides.
        </p>
        <!-- v11.W1.2 : 60-second path. Kahneman WYSIATI: front-load proof,
             not adjectives. Tetlock calibration: name a Brier-style grade
             so a recruiter sees the trader skill in the same 5 seconds
             they see the title. Munger latticework: name quant + AI +
             chrome as one cross-validated practice, not five siloed skills. -->
        <p class="hero-flagship__60s mono" data-stagger="5">If you are hiring - 60-second path:</p>
        <p class="hero-flagship__sixty" data-stagger="6">
          A fox across 5 era buckets, not a hedgehog on one story. 31-gate eval stack. Brier near 0.72
          (70% CI 0.64 to 0.79) against the 0.50 base rate for self-reported practitioner claims. The proof sits
          one click below: strategy workbooks, trade logs, and the G1 to G31 gate stack.
        </p>
        <!-- v12.W4 quant-aesthetic : unified CTA treatment. ONE consistent
             institutional pattern across all five buttons (no three-style
             mix). Outlined, paper bg, hairline border, ink color, no fill,
             no transform on hover. Color shift only: border + text go amber
             on hover (the institutional "system responds" cue, not a SaaS
             lift). Chrome contract rule 3 (no halo / glow / lift) is upheld. -->
        <div class="hero-flagship__cta" data-stagger="7">
          <a
            href={path('/resume-quant-onepage.pdf')}
            class="hero-flagship__cta-btn hero-flagship__cta-btn--key"
            download
          >
            Download the 1-page resume
          </a>
          <a href={path('/proof')} class="hero-flagship__cta-btn">
            See the shipped work
          </a>
          <a href={path('/contact')} class="hero-flagship__cta-btn">
            Book a 30-minute call
          </a>
          <a href={path('/methodology')} class="hero-flagship__cta-btn">
            Method (G1-G31)
          </a>
          <a href={path('/for-recruiters')} class="hero-flagship__cta-btn">
            Recruiter brief
          </a>
        </div>
        <!-- v11.W1: financial-markets evidence rail. Sits directly below the
             60-second CTA strip so the domain frame is the last thing read
             before the eye leaves the hero. Mono caps + ink-2 match the
             `__60s` eyebrow already above the strip, so this adds a register
             the chrome contract already defines rather than a new one.
             `<p>` (not a heading) keeps the h1-only hero hierarchy intact. -->
        <p class="hero-flagship__markets mono" data-stagger="8">{profile.titles.marketsRail}</p>
      </div>
      <div class="hero-flagship__viz">
        <HeroSkills />
      </div>
    </section>

    <!-- v9.7.1 : flagship live-performance centerpiece. Animated SVG equity
         curve placed between hero-flagship and the live counter strip. Reads
         as proof of "this person ships" to the curve draws on mount, pulses
         at the terminus, and captions the expected paper-trade return.
         Cream surface + amber line preserve the chrome contract. -->
    <HeroCurve />

    <!-- ============= LIVE DATA STRIP : moved up (PATCH 7): primary visual proof
         sits right after the hero. Reading order: H1 → role → CTAs → curve →
         strip (proof) → marquee (ambient) → § 01. ============= -->
    <aside class="strip" aria-label="Live counters">
      <div class="strip__inner">
        {
          liveCounters.map((c) => (
            <div class="strip__cell">
              {/* Bryllim-style diagonal arrow in upper-right of each cell.
                  Decorative only : aria-hidden so screen-readers get the
                  numeric value from data-countup without competing chrome. */}
              <span class="strip__arrow" aria-hidden="true">↗</span>
              <p class="strip__num" data-countup={c.value}>{c.value}</p>
              <p class="strip__label mono">{c.label}</p>
            </div>
          ))
        }
      </div>
      <p class="strip__sub mono">
        {profile.stats.certCount} certs in the last {profile.stats.ageMonths} months. AWS, GCP, quant, AI.
      </p>
    </aside>

    <!-- ============= RUNNING-TAPE RIBBON : moved down (PATCH 7): ambient
         ribbon AFTER the proof. Reuses Marquee.astro. 5 items per UI/UX. -->
    <aside class="hero-ribbon" aria-label="Operating register">
      <Marquee items={heroMarqueeItems} speedSec={60} />
    </aside>

    <!-- ============= § 01 : LEDE ============= -->
    <section class="lede" aria-label="Working description" data-section-id="projects">
      <!-- v11.W1.2 : copy refreshed for Stage 0 doctrine integration. The
           lede is now a 2-paragraph latticework framing: paragraph 1
           names the practice (quant + AI + chrome as one cross-validated
           model), paragraph 2 names the proof beat (workbooks + trade
           logs + kill log + 31-gate stack). Sagan Standard: every
           artefact name maps to a real, accessible page or repo. -->
      <SectionMark index="01" title="projects" />
      <h2 class="lede__mark mono">§ 01. The Work</h2>
      <p class="lede__body">
        Quant research, production AI engineering, and the chrome discipline that makes the work legible to a hiring
        reader are not adjacent skills. They are one cross-validated practice. A trading edge cleared by the 31-gate
        stack is the same artifact audited for accessibility, indexed in a workbook, and rendered as recruiter-facing
        proof on this site. Each discipline stress-tests the others.
      </p>
      <p class="lede__body">
        Below: 9 quant strategies with published methodology, 6 production AI projects, 25 public repositories, and
        a 31-gate eval harness with a public kill log. Every claim is dated. Every commit is referenced. Every closed
        backtest carries its drawdown window. Client-confidential work is omitted.
      </p>
    </section>

    <!-- ============= § 01.5 : AI HISTORY TIMELINE =============
         v12.W4 : flagship visual proof that the trend-tracking fingerprint
         is real. PROMPTS to GRAPHS, two months ahead of mainstream each
         rung. NDA-safe copy: dates from canonical industry emergence +
         personal shipped records. Renders as a horizontal strip on
         desktop, vertical stack on mobile (auto via media query). -->
    <section class="trend" aria-label="Trend-tracking arc">
      <AIHistoryTimeline
        variant="strip"
        chip="AI · HISTORY · THE LEAD"
        title="Always up to trend. Two months ahead."
        lede="Six architectural jumps in three years, each adopted on day one. The lead is the trend-tracking fingerprint for a quant seat."
      />
    </section>

    <!-- ============= § 02 : ARTIFACTS TABLE ============= -->
    <section class="artifacts" aria-label="What I ship" data-section-id="proof">
      <SectionMark index="02" title="proof" />
      <h2 class="artifacts__mark mono">§ 02. What I Ship</h2>
      <p class="artifacts__sub">
        9 quant strategies with published methodology. 6 production AI projects. 31-gate eval harness with public
        kill log. Numbers below are counted at deploy time, not rounded.
      </p>
      <table class="artifacts__table">
        <thead>
          <tr>
            <th>Artifact</th>
            <th>Type</th>
            <th class="num">Count</th>
            <th>Where</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Quant strategies (financial markets)</td>
            <td>alpha + risk, backtest, paper-trade · equities, futures, FX, crypto, alt-data</td>
            <td class="num">{profile.stats.strategyCount}</td>
            <td><a href={path('/projects')}>/projects</a></td>
          </tr>
          <tr>
            <td>Strategy workbooks + trade logs</td>
            <td>per-strategy memos, OOS metrics, kill log, drawdown windows</td>
            <td class="num">9 + trade log</td>
            <td><a href={path('/workbooks')}>/workbooks</a></td>
          </tr>
          <tr>
            <td>AI engineering projects</td>
            <td>RAG · LLM evaluation · MCP · multi-agent systems for trading ops</td>
            <td class="num">{profile.stats.aiProjectCount}</td>
            <td><a href={path('/ai')}>/ai</a></td>
          </tr>
          <tr>
            <td>Public repos (GitHub)</td>
            <td>workbooks, ships, experiments</td>
            <td class="num">{profile.stats.repoCount}</td>
            <td>
              <a href="https://github.com/christianmacion26">github.com/christianmacion26</a>
            </td>
          </tr>
          <tr>
            <td>Research validation methods (G1-G31)</td>
            <td>Walk-forward validation · block bootstrap · deflated Sharpe · regime conditioning</td>
            <td class="num">31</td>
            <td><a href={path('/methodology')}>/methodology</a></td>
          </tr>
          <tr>
            <td>Python codebase</td>
            <td>Backtests · AI tooling · research infrastructure</td>
            <td class="num">{profile.stats.locPython}</td>
            <td><a href={path('/proof')}>/proof</a></td>
          </tr>
          <tr>
            <td>Certs earned (last 11 months)</td>
            <td>AWS, GCP, quant, AI</td>
            <td class="num">{profile.stats.certCount}</td>
            <td><a href={path('/certifications')}>/certifications</a></td>
          </tr>
        </tbody>
      </table>
      {/* Bryllim-style overflow link: right-aligned "ALL X →" anchors
          the artifacts table back to the canonical /projects index.
          Decorative arrow ↗ already lives in the strip; this is the
          section-end overflow that points to the full page. */}
      <p class="artifacts__overflow">
        <a href={path('/projects')} class="bryllim-overflow mono">ALL {profile.stats.strategyCount + profile.stats.aiProjectCount} PROJECTS →</a>
      </p>
    </section>

    <!-- ============= § 03 : CERTIFICATIONS WALL ============= -->
    <SectionMark index="03" title="certifications" />
    <section aria-label="Strategy validation discipline" data-section-id="validation">
      <div class="home-section">
        <FiveEraCurve />
      </div>
      <div class="home-section">
        <GatesLattice />
      </div>
    </section>

    <section aria-label="Certifications" data-section-id="certifications">
      <CertWall />
    </section>
    <p class="certwall__overflow">
      <a href={path('/certifications')} class="bryllim-overflow mono">ALL {profile.stats.certCount} CERTS →</a>
    </p>

    <!-- ============= § 04 : READING LIST ============= -->
    <section class="help" aria-label="How I help" data-section-id="now">
      <SectionMark index="04" title="now" />
      <h2 class="help__mark mono">§ 04. What I Ship</h2>
      <p class="reading__sub">
        Four engagement shapes. Not services I list. Live systems built, deployed, kept honest with verifiable
        evidence.
      </p>
      <div class="help__grid help__grid--inline">
        <article class="help__card">
          <p class="help__kicker mono">QUANT RESEARCH</p>
          <h3 class="help__title">Statistical-arb pipelines that survive live deployment</h3>
          <p class="help__body">
            Walk-forward backtests, deflated Sharpe, regime conditioning. The 31-gate stack filters out edges that
            only looked good in-sample. Each pipeline ships with a paper-trade leg and a postmortem.
          </p>
        </article>
        <article class="help__card">
          <p class="help__kicker mono">AI ENGINEERING</p>
          <h3 class="help__title">Multi-agent build systems with eval-first discipline</h3>
          <p class="help__body">
            Production agents behind a frozen eval harness and a kill-switch. Failures banked into postmortems;
            wins banked into the next eval set. Ship behind metrics, not vibes.
          </p>
        </article>
        <article class="help__card">
          <p class="help__kicker mono">AI EVAL</p>
          <h3 class="help__title">Statistical gates for LLM claims</h3>
          <p class="help__body">
            Deflated Sharpe, block-bootstrap CIs, walk-forward stability. Same tools you use on backtests, applied
            to LLM eval scores. Built when the metric is too pretty.
          </p>
        </article>
        <article class="help__card">
          <p class="help__kicker mono">REPRODUCIBILITY</p>
          <h3 class="help__title">Reproducible artifacts with audit trails</h3>
          <p class="help__body">
            Frozen-spec eval, idempotent re-run, one-page AAR. Verifiable by a stranger, not just an insider.
          </p>
        </article>
      </div>
      {/* Bryllim overflow: section list ends with right-aligned "ALL X →"
          to the proof page where every capability claim is anchored. */}
      <p class="help__overflow">
        <a href={path('/proof')} class="bryllim-overflow mono">ALL PROOFS →</a>
      </p>
    </section>

    <!-- ============= § 05 : FOOTPRINT ============= -->
    <section class="footprint" aria-label="Footprint">
      <h2 class="footprint__mark mono">§ 05. Footprint</h2>
      <p class="footprint__sub">
        17 venues. Real counterparts, real exchanges, real alt-data feeds. Verifiable, not decorative.
      </p>
      <EarthMap points={footprintPoints} mode="pins" />
    </section>

    <!-- ============= § 06 : CONTACT ============= -->
    <footer class="contact" aria-label="Contact">
      <h2 class="contact__mark mono">§ 06. Contact</h2>
      <p class="contact__line mono">
        <a href={`mailto:${email}`}>{email}</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/christianmacion26">GitHub</a>
        <span aria-hidden="true">·</span>
        <a href="https://linkedin.com/in/christianmacion">LinkedIn</a>
        <span aria-hidden="true">·</span>
        <a href={path('/for-recruiters')}>Recruiter brief</a>
      </p>
      <p class="contact__sub">
        Open to quant research and AI engineer roles in financial markets. Selective contract engagements with
        publishable methodology. Reply within 24 hours.
      </p>
      <p class="contact__line mono">
        <a href={path('/methodology')}>Method (G1-G31)</a>
        <span aria-hidden="true">·</span>
        <a href={path('/comp')}>Comp bands</a>
        <span aria-hidden="true">·</span>
        <a href={path('/positions')}>Live positions</a>
      </p>
    </footer>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     v9.1 INSTITUTIONAL BROADSIDE HOME
     Target register: Jane Street Press / Stripe Press / FT-style broadside.
     Paper-cream background, dark navy ink, hairline rules everywhere.
     ============================================================ */

  .broadside {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--s-6) var(--s-9);
  }

  /* ====== RUNNING HEADER TAPE ====== */
  .tape {
    margin: 0 -32px 32px;
    padding: 14px 32px;
    border-top: 2px solid var(--c-ink);
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg);
  }
  .tape__row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tape__row--top {
    margin-bottom: 8px;
    color: var(--c-ink);
    font-weight: 500;
  }
  .tape__row--bottom {
    color: var(--c-ink-2);
    padding-top: 8px;
    border-top: 1px solid var(--c-rule);
  }
  .tape__mark {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--c-ink);
  }
  .tape__id {
    font-weight: 700;
    color: var(--c-ink);
    letter-spacing: 0.16em;
  }
  .tape__sep {
    color: var(--c-ink-3);
    opacity: 0.55;
  }
  .tape__role,
  .tape__loc,
  .tape__utc {
    font-weight: 500;
  }
  .tape__nav {
    color: var(--c-ink-2);
    text-decoration: none;
    border: 0;
    padding: 0;
    transition: color 120ms ease;
  }
  .tape__nav:hover {
    color: var(--c-ink);
  }
  .tape__nav--cta {
    font-weight: 700;
    color: var(--c-ink);
  }

  /* ====== HERO : big serif display ====== */
  .hero {
    padding: 32px 0 24px;
    border-bottom: 1px solid var(--c-rule);
  }
  .hero__eyebrow {
    font-size: 10.5px;
    color: var(--c-ink-3);
    letter-spacing: 0.18em;
    margin: 0 0 24px;
    text-transform: uppercase;
  }
  .hero__name {
    font-family: var(--j-ff-display);
    font-weight: 700;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 0.96;
    letter-spacing: -0.028em;
    color: var(--c-ink);
    margin: 0 0 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 18px;
  }
  .hero__name-1 {
    font-style: normal;
  }
  .hero__name-2,
  .hero__name-3 {
    font-style: normal;
    font-weight: inherit;
    color: inherit;
  }
  .hero__role {
    font: 400 17px / 1.45 var(--j-ff-display);
    color: var(--c-ink-2);
    font-style: italic;
    margin: 0;
    max-width: 60ch;
  }

  /* ====== LIVE DATA STRIP ====== */
  .strip {
    margin: 32px 0;
    border-top: 1px solid var(--c-ink);
    border-bottom: 1px solid var(--c-ink);
    padding: 18px 0 14px;
  }
  .strip__inner {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0;
  }
  .strip__cell {
    padding: 0 16px;
    border-left: 1px solid var(--c-rule);
    position: relative;
  }
  /* v9.4.2 : Bryllim diagonal-arrow mark. Upper-right of each cell.
     Mono caps so it reads as a label, not an emoji. Hover bumps it to
     ink color (no halo, no glow, no transform). */
  .strip__arrow {
    position: absolute;
    top: 2px;
    right: 8px;
    font-family: var(--ff-mono);
    font-size: 11px;
    line-height: 1;
    color: var(--c-ink-3);
    letter-spacing: 0;
    transition: color 120ms ease;
  }
  .strip__cell:hover .strip__arrow {
    color: var(--c-ink);
  }
  .strip__cell:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .strip__num {
    font-family: var(--j-ff-display);
    font-weight: 700;
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.018em;
    color: var(--c-ink);
    margin: 0 0 6px;
    font-variant-numeric: tabular-nums;
  }
  .strip__label {
    font-size: 10px;
    color: var(--c-ink-2);
    letter-spacing: 0.14em;
    margin: 0;
  }

  /* v9.4.2 : strip subtitle carries the "/ 11 MO" temporal context
     that was previously crammed into the 6th counter label. */
  .strip__sub {
    font-size: 10px;
    color: var(--c-ink-3);
    letter-spacing: 0.12em;
    margin: 12px 0 0;
    text-transform: uppercase;
  }

  /* ====== SECTIONS : § marks + body ====== */
  .lede,
  .artifacts,
  .reading,
  .footprint,
  .contact {
    padding: var(--s-7) 0 var(--s-3);
    border-bottom: 1px solid var(--c-rule);
  }
  .contact {
    border-bottom: 0;
  }

  .lede__mark,
  .artifacts__mark,
  .reading__mark,
  .footprint__mark,
  .contact__mark {
    font-size: var(--type-caption-size);
    color: var(--c-amber);
    letter-spacing: var(--type-caption-track);
    margin: 0 0 var(--s-5);
    text-transform: uppercase;
    font-weight: 400;
  }

  /* ============================================================
   * v9.4.2 BRYLLIM PATTERN : "ALL X →" overflow link.
   * Right-aligned at section end; mono caps; amber accent underline.
   * No halo, no glow, no transform.
   * ============================================================ */
  .bryllim-overflow {
    display: inline-block;
    font-family: var(--ff-mono);
    font-size: var(--type-caption-size);
    letter-spacing: var(--type-caption-track);
    text-transform: uppercase;
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--c-amber);
    padding-bottom: 1px;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .bryllim-overflow:hover {
    color: var(--c-ink);
    border-bottom-color: var(--c-ink);
  }
  .artifacts__overflow,
  .certwall__overflow,
  .help__overflow {
    text-align: right;
    margin: 18px 0 0;
  }

  .lede__body {
    font: 400 17px / 1.65 var(--ff-sans);
    color: var(--c-ink);
    margin: 0 0 16px;
    max-width: 62ch;
  }
  .lede__body code {
    font: 400 14px var(--ff-mono);
    background: var(--c-bg-elev);
    padding: 1px 7px;
    color: var(--c-ink);
    border: 1px solid var(--c-rule);
  }

  /* ====== ARTIFACTS TABLE ====== */
  .artifacts__sub,
  .reading__sub,
  .footprint__sub,
  .contact__sub {
    font: 400 14.5px / 1.6 var(--ff-sans);
    color: var(--c-ink-2);
    margin: 0 0 22px;
    max-width: 60ch;
  }

  .artifacts__table {
    width: 100%;
    border-collapse: collapse;
    font: 400 14px / 1.5 var(--ff-sans);
    margin: 0 0 24px;
    font-variant-numeric: tabular-nums;
  }
  .artifacts__table th,
  .artifacts__table td {
    border-bottom: 1px solid var(--c-rule);
    padding: 11px 16px 11px 0;
    text-align: left;
    vertical-align: top;
  }
  .artifacts__table th {
    font: 500 10.5px / 1.3 var(--ff-mono);
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--c-ink);
  }
  .artifacts__table td.num {
    text-align: right;
    white-space: nowrap;
    font-weight: 500;
  }

  /* v9.4 : hook + quick-route sections removed (PATCH 3+4) : see
     portfolio-flagship-hero-v9-4-2026-08-07 for the patch list. */

  /* ====== CONTACT ====== */
  .contact__line {
    font: 500 14.5px / 1.5 var(--ff-mono);
    color: var(--c-ink);
    margin: 0 0 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .contact__source {
    font-size: 11px;
    color: var(--c-ink-3);
    letter-spacing: 0.04em;
    margin: 24px 0 0;
    text-transform: uppercase;
  }
  .contact__source code {
    font: 400 11px var(--ff-mono);
    background: transparent;
  }

  /* ====== LINKS ====== */
  .broadside a {
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--c-rule);
    padding-bottom: 1px;
    transition: border-color 120ms ease;
  }
  .broadside a:hover {
    border-bottom-color: var(--c-ink);
  }

  /* ====== RESPONSIVE ====== */
  @media (max-width: 760px) {
    .broadside {
      padding: 0 20px 64px;
    }
    .tape {
      margin: 0 -20px 24px;
      padding: 12px 20px;
    }
    .tape__sep--hide,
    .tape__utc--hide {
      display: none;
    }
    .tape__row--top {
      flex-wrap: wrap;
      gap: 6px 10px;
    }
    /* v9.3 Wave 4 (2026-08-01) : wrap the bottom nav into a 2-column
       grid on mobile instead of horizontal-scroll. The previous
       `overflow-x: auto` was clipping "FOR RECRUITERS" → "FOR RECRUITER"
       on iPhone-13-width viewports and forcing the recruiter to
       horizontally scroll a one-row nav, which read as a regression.
       Now the 6 items stack into a 2×3 grid (each row = 3 items) so the
       entire nav is visible without scroll, with the same institutional
       mono caps register. */
    .tape__row--bottom {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      column-gap: 14px;
      row-gap: 8px;
      padding-top: 10px;
      border-top: 1px solid var(--c-rule);
      white-space: normal;
    }
    .tape__row--bottom .tape__sep {
      display: none;
    }
    .strip__inner {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px 0;
    }
    .strip__cell {
      border-left: 0;
      padding: 0 8px;
    }
    .strip__cell:nth-child(4),
    .strip__cell:nth-child(5),
    .strip__cell:nth-child(6) {
      border-top: 1px solid var(--c-rule);
      padding-top: 14px;
      margin-top: 4px;
    }
    .reading__list li {
      grid-template-columns: 32px 1fr;
    }
    .reading__text {
      grid-column: 2;
    }
    /* v9.4 : quick-route mobile rules removed (PATCH 4b). */
  }

  /* ============================================================
   * v9.4 FLAGSHIP HERO : 2-column flagship layout
   * Left: eyebrow + H1 + role + 2 CTAs. Right: animated SVG curve.
   * Cream surface for the copy column; dark inset panel hosts the
   * curve. Hairline rule between the two columns; collapses to a
   * single column ≤ 860px.
   * ============================================================ */
  .hero-flagship {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    align-items: stretch;
    padding: 28px 0 32px;
    border-bottom: 1px solid var(--c-rule);
  }
  /* v12.W4 Bryllim parity : landing-page headshot. Sits as the first
     element of the hero, owns the "this is me" first-impression beat.
     Monochrome (already desaturated at source), hairline border, sharp
     0-2px corners. No halo, no glow, no gradient (chrome contract).
     v12.W4.3 Owner directive: CENTER the image and show it FULL
     (no aspect-ratio crop, no object-fit:cover). Source is 755×1200
     portrait (aspect 0.629); we honor the natural ratio. Widths
     match the sizes attribute: 200px on mobile, 280px on desktop.
     Bryllim-style entrance: subtle fade + slight scale-up on load. */
  .hero-flagship__headshot {
    margin: 0 auto 4px;
    max-width: 280px;
    width: 100%;
  }
  .hero-flagship__headshot-img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--c-rule);
    border-radius: 2px;
    /* Bryllim-style entrance : opacity + slight scale on load. */
    opacity: 0;
    transform: translateY(6px) scale(0.985);
    animation: hero-flagship__headshot-enter 720ms
      cubic-bezier(0.16, 1, 0.3, 1) 120ms forwards;
    will-change: opacity, transform;
  }
  /* Subtle hover lift, color-shift only (no transform per chrome
     contract rule 3). Cursor reveals the photo is interactive (clicks
     to /about or scrolls). */
  .hero-flagship__headshot-img:hover,
  .hero-flagship__headshot-img:focus-visible {
    border-color: var(--c-amber);
    transition: border-color 180ms var(--j-ease-snappy, ease-out);
  }
  @keyframes hero-flagship__headshot-enter {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  /* Honor reduced motion : skip the entrance, sit at rest. */
  @media (prefers-reduced-motion: reduce) {
    .hero-flagship__headshot-img {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
  .hero-flagship__headshot-credit {
    margin: 6px 0 0;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-3);
    text-align: center;
  }
  .hero-flagship__copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  .hero-flagship__eyebrow {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--c-ink-3);
    margin: 0;
  }
  /* W2.7 : availability badge. Single-line amber accent below the location
     eyebrow. Mono caps + 0.06em tracking match the chrome contract. */
  .hero-flagship__availability {
    font-size: 10.5px;
    letter-spacing: 0.06em;
    color: var(--c-amber);
    margin: 6px 0 0;
    text-transform: uppercase;
  }
  /* W2.7 : 60-second path eyebrow. Recruiter-facing prompt that sits
     immediately above the CTA strip. Mono caps, muted ink-2, tight
     11px so it reads as a label, not a heading. */
  .hero-flagship__60s {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-ink-2);
    margin: 8px 0 0;
  }
  /* v11.W1: financial-markets evidence rail. Closes the hero with the
     primary positioning frame. Reuses --c-ink-2 (already verified 7.15:1
     against the hero surface on the __60s eyebrow above) so this ships no
     new contrast pair for the site-wide axe sweep to grade. Hairline top
     rule only: no glow, no gradient, no halo, per the chrome contract. */
  .hero-flagship__markets {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-ink-2);
    margin: 18px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--c-rule, var(--c-ink-3));
    max-width: 46ch;
    text-wrap: pretty;
  }
  .hero-flagship__name {
    /* v12.W4 quant-aesthetic : H1 typography reads as institutional
       FT-style sans (Inter display, --j-ff-display). The pre-W4 era
       shipped this in JetBrains Mono (via pixel-display + --ff-mono),
       which read as AI-vibe / bitmap, not Bloomberg-Terminal-grade
       body type. The Bryllim reference uses pixel LOGO + serif/sans
       BODY; the H1 is the body, so it inherits --j-ff-display
       (Inter) without any font-face override. */
    font-family: var(--j-ff-display);
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    font-weight: 600;
    color: var(--c-ink);
    margin: 0;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  .hero-flagship__name-1,
  .hero-flagship__name-3 {
    font-style: normal;
  }
  .hero-flagship__name-2 {
    font-style: italic;
    color: var(--c-amber);
    padding: 0 0.04em;
  }
  .hero-flagship__role {
    font-family: var(--j-ff-display);
    font-size: clamp(18px, 1.7vw, 22px);
    line-height: 1.4;
    color: var(--c-ink-2);
    margin: 0;
    max-width: 36ch;
    text-wrap: balance;
  }
  .hero-flagship__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
  /* v12.W4 quant-aesthetic : UNIFIED BUTTON TREATMENT.
     Owner directive 2026-08-08: ONE consistent institutional pattern
     across every CTA on the home page. The pre-v12.W4 era shipped
     three styles (filled amber primary + outlined secondary + light
     outlined tertiary) which read as three different ideas. New
     treatment: every CTA gets the same shape, paper bg, ink color,
     hairline border, no fill, no transform. Color shift only on hover:
     border + text go amber (the institutional "system responds" cue,
     not a SaaS lift or fill change). Reference register: D.E. Shaw
     + Renaissance + Jane Street + Two Sigma use outlined text-link
     or hairline-bordered buttons as their primary affordance; the
     filled amber CTA was the AI-vibe tell.
     Subtle weight via copy + ordering, not via fill. The first two
     CTAs (Download + Book) are the "do this now" affordances; the
     remaining three (See shipped + Method + Recruiter brief) are
     proof / context routes. Visual hierarchy comes from placement
     and copy, not from fill state.
     Chrome contract compliance:
       rule 1 : mono + 1 accent (amber border on hover)
       rule 3 : NO halo / glow / lift on hover (no transform)
       rule 6 : NO pill (border-radius: 0)
       rule 7 : NO animation that competes with content (100ms transition)
     The --key variant (Download resume) gets a 1px ink border at
     rest so the eye lands on it first; everything else uses the
     --c-rule hairline. Still outlined, no fill. */
  .hero-flagship__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0;
    background: transparent;
    color: var(--c-ink);
    border: 1px solid var(--c-rule);
    transition:
      border-color 100ms var(--j-ease-snappy),
      color 100ms var(--j-ease-snappy);
  }
  .hero-flagship__cta-btn--key {
    /* Key affordance (Download resume) gets a heavier ink border at
       rest so the eye lands on it first within the row. Still
       outlined, still no fill, still no transform. */
    border-color: var(--c-ink-2);
    font-weight: 600;
  }
  .hero-flagship__cta-btn:hover,
  .hero-flagship__cta-btn:focus-visible {
    border-color: var(--c-amber);
    color: var(--c-amber);
    /* NO transform: chrome-contract rule 3 forbids the SaaS lift. */
  }
  .hero-flagship__cta-btn--key:hover,
  .hero-flagship__cta-btn--key:focus-visible {
    border-color: var(--c-amber);
    color: var(--c-amber);
  }
  .hero-flagship__viz {
    min-width: 0;
  }

  /* ============================================================
   * v9.4 HERO RIBBON : Marquee sits between the flagship hero and
   * the counter strip. Hairline rules top + bottom; tight vertical
   * padding so it reads as a tape, not a section.
   * ============================================================ */
  .hero-ribbon {
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
    padding: 8px 0;
    background: var(--c-bg-elev);
    margin: 0;
  }

  @media (max-width: 860px) {
    .hero-flagship {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 24px 0 28px;
    }
    .hero-flagship__headshot {
      max-width: 200px;
      margin: 0 auto 4px;
    }
    .hero-flagship__cta {
      gap: 10px;
    }
  }
</style>

<script>
  // v9.4 : count-up animation for the home page stats strip.
  // IntersectionObserver fires when the strip enters the viewport.
  // Honors prefers-reduced-motion: reduce (snap to target).
  import { initCountUps } from '../utils/countup';

  const start = () => initCountUps();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
</script>
