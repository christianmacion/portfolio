---
/**
 * index.astro — v9.1 HOME — INSTITUTIONAL BROADSIDE
 *
 * Per webcraft-no-vibe (VIBE-DOCTRINE.md Part III):
 *   "If a stranger can tell you used AI to build it within 5 seconds,
 *    it shipped with vibes. If they can tell you who built it within
 *    30 seconds, it shipped in the institutional register."
 *
 * Target register: Jane Street Press / Stripe Press / FT-style broadside.
 *
 * Visual identity:
 *   - Geometric CM monogram (signature mark, top-left)
 *   - Running header tape (deploy date + version + UTC offset + nav links)
 *   - Big Roman-serif display H1 (italic middle name, FT-style)
 *   - Hairline rules between sections, like a printed broadside
 *   - Section marks (§ 01, § 02) — editorial register
 *   - Tabular data strip (6 live counters — anchor the page as "alive")
 *   - Last: world map (8 pins) — the v8.5.1 hotfix, preserved
 *
 * Density: 5 sections, ~480 lines. Was 11 sections, 2,032 lines.
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import { profile } from '@utils/profile';
import { path } from '@utils/url';
import EarthMap from '@components/EarthMap.astro';

const footprintPoints = [
  // Digos City, Davao del Sur, Philippines — CANONICAL coordinates: 6.74°N, 125.36°E.
  // Do NOT add a second Digos pin here. The 7.19°N, 125.45°E region is Davao City
  // (~50 km north), NOT Digos. A previous build shipped a rogue pin at that
  // location labeled 'Digos City, PH — Ateneo · BIDA Meta · USEP' — the events
  // (Ateneo de Davao, BIDA Meta, USEP) actually happened in Davao City, not Digos.
  // The architecture audit (2026-08-02) flagged the wrong city-label on the
  // wrong coordinates; surgical fix is to drop the rogue pin and keep the
  // single canonical home-base pin. If a future revision needs to surface
  // in-person events at non-home cities, add them under their actual city
  // (Davao City, Manila, etc.) — never under Digos.
  { city: 'Digos City, PH', lat: 6.74, lon: 125.36, weight: 1.0, caption: 'home base' },
  { city: 'Manila, PH', lat: 14.6, lon: 120.98, weight: 0.7, caption: 'UP School of Statistics' },
  { city: 'Singapore', lat: 1.35, lon: 103.82, weight: 0.8, caption: 'APAC ops' },
  { city: 'Tokyo', lat: 35.68, lon: 139.69, weight: 0.7, caption: 'JPX' },
  { city: 'Zurich', lat: 47.38, lon: 8.54, weight: 0.85, caption: 'CTA' },
  { city: 'London', lat: 51.51, lon: -0.13, weight: 0.95, caption: 'LSE' },
  { city: 'New York', lat: 40.71, lon: -74.01, weight: 0.9, caption: 'NYSE / Nasdaq' },
];

const email = profile.contact.email;
// v9.3.5 — deployedStamp + buildTime moved to SiteHeader.astro (single source of truth).

// Live counters — all sourced from profile.stats.ts (single source of truth).
const liveCounters = [
  { label: 'STRATEGIES', value: profile.stats.strategyCount },
  { label: 'EVAL GATES', value: profile.stats.evalGates },
  { label: 'AARs YTD', value: '218' },
  { label: 'PAGES BUILT', value: profile.stats.pagesBuilt },
  { label: 'PUBLIC REPOS', value: profile.stats.repoCount },
  { label: 'CERTS / 11 MO', value: profile.stats.certCount },
];
---

<BaseLayout
  title={profile.titles.primary}
  description={profile.titles.secondary}
  surface="v6-13"
  theme="light"
  chrome="full"
  breadcrumbs={[{ name: 'Home', href: '/' }]}
>
  <!-- v9.3.2 (2026-08-02) — a11y: BaseLayout.astro already wraps the
       page in <main id="main">; rendering an inner <main> here produced
       nested <main> landmarks (invalid HTML5; confusing to screen-reader
       landmark navigation). Replaced with <section> so the broadside is
       semantically sectioned, not landmarked. The outer BaseLayout
       <main id="main"> remains the single landmark for AT users. -->
  <section class="broadside" aria-label="Home broadside">
    <!-- v9.3.5 — running header tape REMOVED. The global SiteHeader (above
         the Nav) now ships the CM monogram + name + role + UTC + deployed
         stamp on every page, including home. The downstream nav row is
         covered by the global Nav component. The home page keeps its
         flagship hero (eyebrow + H1 + role), stats strip, hook, and
         quick-route grid — the broadside reading still differentiates
         home from subpages; the chrome is now shared. -->

    <!-- ============= BIG DISPLAY HEADLINE ============= -->
    <section class="hero" aria-label="Identity">
      <p class="hero__eyebrow mono">A WORKING DESCRIPTION · CURRENT</p>
      <h1 class="hero__name">
        <span class="hero__name-1">Christian</span>
        <span class="hero__name-2">T.</span>
        <span class="hero__name-3">Macion</span>
      </h1>
      <p class="hero__role">
        Building trading desks and multi-agent systems for six years — eval-first, ship-ready.
      </p>
    </section>

    <!-- ============= LIVE DATA STRIP ============= -->
    <aside class="strip" aria-label="Live counters">
      <div class="strip__inner">
        {
          liveCounters.map((c) => (
            <div class="strip__cell">
              <p class="strip__num">{c.value}</p>
              <p class="strip__label mono">{c.label}</p>
            </div>
          ))
        }
      </div>
    </aside>

    <!-- ============= v9.3 IA wave 2 (2026-08-01) — S1 LEDE HOOK ============= -->
    <!-- Above-the-fold, single-sentence "why-care" answer (8-sec readable).
         Institutional register: senior QR + AI engineer-architect framing,
         NDA-clean disclosure, evaluation-first posture. Sits between the
         live counters and the quick-route grid so the eye reads:
         counters (proof) → hook (positioning) → routes (action). -->
    <aside class="hook" aria-label="Working summary">
      <p class="hook__body">
        Quant researcher + AI engineer-architect, six years building trading desks and multi-agent
        build systems — eval-first, NDA-clean, ship-ready.
      </p>
    </aside>

    <!-- ============= v9.3 IA wave 2 (2026-08-01) — S2 QUICK-ROUTE GRID ============= -->
    <!-- Three-card quick-route grid pointing to the highest-leverage
         next-step pages: /for-recruiters (recruiter 60-sec skim),
         /now (current activities), /projects/quant (9 strategies).
         Each card has a left-edge status binding stripe (handoff /
         iterate / ship) so the IA reads "what do I do next" without
         the recruiter having to scroll. Reduced-motion fade-in only. -->
    <nav class="quick-route" aria-label="Quick routes">
      <a
        href={path('/for-recruiters')}
        class="quick-route__card binding-stripe binding-stripe--handoff"
      >
        <p class="quick-route__kicker mono">FOR HIRING MANAGERS</p>
        <p class="quick-route__title">60-second skim</p>
        <p class="quick-route__sub">
          Senior QR + AI Engineer register · NDA-clean · immediate start.
        </p>
        <p class="quick-route__cta mono">Open brief &rarr;</p>
      </a>
      <a href={path('/now')} class="quick-route__card binding-stripe binding-stripe--iterate">
        <p class="quick-route__kicker mono">CURRENTLY WORKING ON</p>
        <p class="quick-route__title">What I am doing now</p>
        <p class="quick-route__sub">
          Dated one-pager of current activities, open problems, and bets.
        </p>
        <p class="quick-route__cta mono">Open /now &rarr;</p>
      </a>
      <a
        href={path('/projects/quant')}
        class="quick-route__card binding-stripe binding-stripe--ship"
      >
        <p class="quick-route__kicker mono">QUANT SHIPPED</p>
        <p class="quick-route__title">9 strategies · backtested</p>
        <p class="quick-route__sub">
          Alpha + risk pairs · fire-rule granularity · G1–G31 gate stack.
        </p>
        <p class="quick-route__cta mono">Open quant &rarr;</p>
      </a>
    </nav>

    <!-- ============= § 01 — LEDE ============= -->
    <section class="lede" aria-label="Working description">
      <!-- v9.3.2 (2026-08-02) — a11y: § 01 marker was styled <p>; screen-reader
           "navigate by headings" returned only the hero h1. Promote to <h2>
           so AT users can jump between broadside sections. Visual styling
           unchanged — class retains lede__mark mono treatment. -->
      <h2 class="lede__mark mono">§ 01 — The Work</h2>
      <p class="lede__body">
        Six years building trading desks, AI engineering teams, and multi-agent build systems that
        survive interview-room scrutiny. Every artifact ships behind a 31-gate eval harness, carries
        an idempotent re-run path, and lands in a one-page AAR — so the work is reproducible,
        ship-ready, and defensible under adversarial review.
      </p>
      <p class="lede__body">
        NDA-clean by construction: prior-employer work does not surface here. No <code
          >Math.random()</code
        > in shipped code, no argless
        <code>new Date()</code>, no fabricated metrics. The full audit trail lives on the <a
          href={path('/methodology')}>methodology</a
        > page.
      </p>
    </section>

    <!-- ============= § 02 — ARTIFACTS TABLE ============= -->
    <section class="artifacts" aria-label="What I ship">
      <h2 class="artifacts__mark mono">§ 02 — What I Ship</h2>
      <p class="artifacts__sub">
        Real artifacts, real numbers. Each row links to the proof page or repo. Numbers are counted
        at deploy time, not rounded to look round.
      </p>
      <table class="artifacts__table">
        <thead>
          <tr>
            <th>Artifact</th>
            <th>Type</th>
            <th class="num">Count</th>
            <th>Where</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Quant strategies</td>
            <td>alpha + risk, backtest, paper-trade</td>
            <td class="num">{profile.stats.strategyCount}</td>
            <td><a href={path('/projects/quant')}>/projects/quant</a></td>
          </tr>
          <tr>
            <td>AI engineering projects</td>
            <td>RAG, evals, MCP servers, prompt harnesses</td>
            <td class="num">6</td>
            <td><a href={path('/ai')}>/ai</a></td>
          </tr>
          <tr>
            <td>STELLA multi-agent office</td>
            <td>agents · skills · routing rows</td>
            <td class="num">53 / 142 / 96</td>
            <td><a href={path('/workbooks')}>/workbooks</a></td>
          </tr>
          <tr>
            <td>STELLA knowledge graph</td>
            <td>typed entities · relations · AARs</td>
            <td class="num">3,209 nodes</td>
            <td><a href={path('/workbooks')}>/workbooks</a></td>
          </tr>
          <tr>
            <td>Public repos (GitHub)</td>
            <td>workbooks, ships, experiments</td>
            <td class="num">{profile.stats.repoCount}</td>
            <td>
              <a href="https://github.com/christianmacion26">github.com/christianmacion26</a>
            </td>
          </tr>
          <tr>
            <td>Eval gates (live harness)</td>
            <td>5-must-have contract verifier</td>
            <td class="num">{profile.stats.evalGates}</td>
            <td><a href={path('/methodology')}>/methodology</a></td>
          </tr>
          <tr>
            <td>LOC Python shipped</td>
            <td>backtests, harnesses, infra</td>
            <td class="num">{profile.stats.locPython}</td>
            <td>(private work)</td>
          </tr>
          <tr>
            <td>Certs earned (last 11 months)</td>
            <td>AWS, GCP, quant, AI</td>
            <td class="num">{profile.stats.certCount}</td>
            <td><a href={path('/certifications')}>/certifications</a></td>
          </tr>
          <tr>
            <td>Pages built (live)</td>
            <td>Astro static · 90 routes</td>
            <td class="num">{profile.stats.pagesBuilt}</td>
            <td><a href="/sitemap-index.xml">sitemap-index.xml</a></td>
          </tr>
        </tbody>
      </table>
    </section>

    <!-- ============= § 03 — READING LIST ============= -->
    <section class="help" aria-label="How I help">
      <h2 class="help__mark mono">§ 03 — How I help</h2>
      <p class="reading__sub">
        Engagement shapes I've shipped. Not services I list — live systems built, deployed, and
        kept honest with verifiable evidence.
      </p>
      <div class="help__grid help__grid--inline">
        <article class="help__card">
          <p class="help__kicker mono">QUANT RESEARCH</p>
          <h3 class="help__title">Statistical-arb pipelines that survive live deployment</h3>
          <p class="help__body">
            Walk-forward backtests, deflated Sharpe, and a gate stack that filters out the ones
            that only looked good in-sample. Each pipeline ships with a paper-trade leg and a
            postmortem — kills included.
          </p>
        </article>
        <article class="help__card">
          <p class="help__kicker mono">AI ENGINEERING</p>
          <h3 class="help__title">Multi-agent build systems with eval-first discipline</h3>
          <p class="help__body">
            Production agents behind a frozen eval harness and a kill-switch. Failures banked
            into postmortems; wins banked into the next eval set. Ship behind metrics, not vibes.
          </p>
        </article>
        <article class="help__card">
          <p class="help__kicker mono">EVAL HARNESS</p>
          <h3 class="help__title">Statistical gates for AI/ML claims</h3>
          <p class="help__body">
            Deflated Sharpe, block-bootstrap CIs, walk-forward stability — same tools you use on
            backtests, applied to LLM eval scores. Built when the metric is too pretty.
          </p>
        </article>
        <article class="help__card">
          <p class="help__kicker mono">SHIP DISCIPLINE</p>
          <h3 class="help__title">Reproducible artifacts with audit trails</h3>
          <p class="help__body">
            Frozen-spec eval, idempotent re-run path, one-page AAR. Verifiable by a stranger, not
            just an insider.
          </p>
        </article>
      </div>
    </section>

    <!-- ============= § 04 — FOOTPRINT ============= -->
    <section class="footprint" aria-label="Footprint">
      <h2 class="footprint__mark mono">§ 04 — Footprint</h2>
      <p class="footprint__sub">
        Where I cover and where I've shipped. Each pin is a real counterpart, a real venue, or a
        real engagement — verifiable, not decorative.
      </p>
      <EarthMap points={footprintPoints} mode="pins" />
    </section>

    <!-- ============= § 05 — CONTACT ============= -->
    <footer class="contact" aria-label="Contact">
      <h2 class="contact__mark mono">§ 05 — Contact</h2>
      <p class="contact__line mono">
        <a href={`mailto:${email}`}>{email}</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/christianmacion26">GitHub</a>
        <span aria-hidden="true">·</span>
        <a href="https://linkedin.com/in/christianmacion">LinkedIn</a>
        <span aria-hidden="true">·</span>
        <a href={path('/for-recruiters')}>Recruiter brief</a>
      </p>
      <p class="contact__sub">
        Open to senior quant researcher, AI engineer, or applied research roles where the eval bar
        is real. Reply within 24 hours.
      </p>
      <p class="contact__source mono">
        Source: <code>profile.stats.ts</code>. Methodology: <a href={path('/methodology')}
          >/methodology</a
        >.
      </p>
    </footer>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     v9.1 INSTITUTIONAL BROADSIDE HOME
     Target register: Jane Street Press / Stripe Press / FT-style broadside.
     Paper-cream background, dark navy ink, hairline rules everywhere.
     ============================================================ */

  .broadside {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 32px 96px;
  }

  /* ====== RUNNING HEADER TAPE ====== */
  .tape {
    margin: 0 -32px 32px;
    padding: 14px 32px;
    border-top: 2px solid var(--c-ink);
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg);
  }
  .tape__row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tape__row--top {
    margin-bottom: 8px;
    color: var(--c-ink);
    font-weight: 500;
  }
  .tape__row--bottom {
    color: var(--c-ink-2);
    padding-top: 8px;
    border-top: 1px solid var(--c-rule);
  }
  .tape__mark {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--c-ink);
  }
  .tape__id {
    font-weight: 700;
    color: var(--c-ink);
    letter-spacing: 0.16em;
  }
  .tape__sep {
    color: var(--c-ink-3);
    opacity: 0.55;
  }
  .tape__role,
  .tape__loc,
  .tape__utc {
    font-weight: 500;
  }
  .tape__nav {
    color: var(--c-ink-2);
    text-decoration: none;
    border: 0;
    padding: 0;
    transition: color 120ms ease;
  }
  .tape__nav:hover {
    color: var(--c-ink);
  }
  .tape__nav--cta {
    font-weight: 700;
    color: var(--c-ink);
  }

  /* ====== HERO — big serif display ====== */
  .hero {
    padding: 32px 0 24px;
    border-bottom: 1px solid var(--c-rule);
  }
  .hero__eyebrow {
    font-size: 10.5px;
    color: var(--c-ink-3);
    letter-spacing: 0.18em;
    margin: 0 0 24px;
    text-transform: uppercase;
  }
  .hero__name {
    font-family: var(--serif-display);
    font-weight: 700;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 0.96;
    letter-spacing: -0.028em;
    color: var(--c-ink);
    margin: 0 0 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 18px;
  }
  .hero__name-1 {
    font-style: normal;
  }
  .hero__name-2,
  .hero__name-3 {
    font-style: normal;
    font-weight: inherit;
    color: inherit;
  }
  .hero__role {
    font: 400 17px / 1.45 var(--serif-display);
    color: var(--c-ink-2);
    font-style: italic;
    margin: 0;
    max-width: 60ch;
  }

  /* ====== LIVE DATA STRIP ====== */
  .strip {
    margin: 32px 0;
    border-top: 1px solid var(--c-ink);
    border-bottom: 1px solid var(--c-ink);
    padding: 18px 0 14px;
  }
  .strip__inner {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0;
  }
  .strip__cell {
    padding: 0 16px;
    border-left: 1px solid var(--c-rule);
  }
  .strip__cell:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .strip__num {
    font-family: var(--serif-display);
    font-weight: 700;
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.018em;
    color: var(--c-ink);
    margin: 0 0 6px;
    font-variant-numeric: tabular-nums;
  }
  .strip__label {
    font-size: 10px;
    color: var(--c-ink-2);
    letter-spacing: 0.14em;
    margin: 0;
  }

  /* ====== SECTIONS — § marks + body ====== */
  .lede,
  .artifacts,
  .reading,
  .footprint,
  .contact {
    padding: 40px 0 8px;
    border-bottom: 1px solid var(--c-rule);
  }
  .contact {
    border-bottom: 0;
  }

  .lede__mark,
  .artifacts__mark,
  .reading__mark,
  .footprint__mark,
  .contact__mark {
    font-size: 11px;
    color: var(--c-warn, #8a6a2a);
    letter-spacing: 0.14em;
    margin: 0 0 18px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .lede__body {
    font: 400 17px / 1.65 var(--ff-sans);
    color: var(--c-ink);
    margin: 0 0 16px;
    max-width: 62ch;
  }
  .lede__body code {
    font: 400 14px var(--ff-mono);
    background: var(--c-bg-elev);
    padding: 1px 7px;
    color: var(--c-ink);
    border: 1px solid var(--c-rule);
  }

  /* ====== ARTIFACTS TABLE ====== */
  .artifacts__sub,
  .reading__sub,
  .footprint__sub,
  .contact__sub {
    font: 400 14.5px / 1.6 var(--ff-sans);
    color: var(--c-ink-2);
    margin: 0 0 22px;
    max-width: 60ch;
  }

  .artifacts__table {
    width: 100%;
    border-collapse: collapse;
    font: 400 14px / 1.5 var(--ff-sans);
    margin: 0 0 24px;
    font-variant-numeric: tabular-nums;
  }
  .artifacts__table th,
  .artifacts__table td {
    border-bottom: 1px solid var(--c-rule);
    padding: 11px 16px 11px 0;
    text-align: left;
    vertical-align: top;
  }
  .artifacts__table th {
    font: 500 10.5px / 1.3 var(--ff-mono);
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--c-ink);
  }
  .artifacts__table td.num {
    text-align: right;
    white-space: nowrap;
    font-weight: 500;
  }

  /* ====== v9.3 IA wave 2 (2026-08-01) — S1 LEDE HOOK + S2 QUICK-ROUTE ====== */
  /* The hook sits between the live counters and the quick-route grid.
     It is a single-sentence 8-sec-readable "why-care" answer in
     institutional register. The quick-route grid is a 3-card nav
     pointing to the highest-leverage next-step pages, each with a
     left-edge status binding stripe (handoff / iterate / ship). */
  .hook {
    margin: 0 0 24px;
    padding: 14px 0;
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
  }
  .hook__body {
    font: 400 17px / 1.55 var(--ff-sans);
    color: var(--c-ink);
    margin: 0;
    max-width: 60ch;
    font-style: italic;
  }

  .quick-route {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 0 0 32px;
    border: 1px solid var(--c-rule);
    border-bottom: 0;
  }
  .quick-route__card {
    padding: 18px 22px 16px 24px;
    text-decoration: none;
    color: var(--c-ink);
    border-bottom: 1px solid var(--c-rule);
    border-left: 1px solid var(--c-rule);
    display: flex;
    flex-direction: column;
    gap: 4px;
    transition:
      background var(--transition),
      border-color var(--transition);
    border-bottom: 0;
    border-bottom: 1px solid var(--c-rule);
  }
  .quick-route__card:first-child {
    border-left: 0;
  }
  .quick-route__card:hover {
    background: var(--c-bg-2);
    border-left-color: var(--c-ink-2);
  }
  .quick-route__card:focus-visible {
    outline: 2px solid var(--c-primary-2-light);
    outline-offset: -2px;
  }
  .quick-route__kicker {
    font-size: 10px;
    color: var(--c-ink-2);
    letter-spacing: 0.16em;
    margin: 0 0 4px;
    text-transform: uppercase;
    font-weight: 700;
  }
  .quick-route__title {
    font: 600 17px / 1.25 var(--serif-display);
    color: var(--c-ink);
    margin: 0 0 4px;
    letter-spacing: -0.012em;
  }
  .quick-route__sub {
    font: 400 13px / 1.45 var(--ff-sans);
    color: var(--c-ink-2);
    margin: 0 0 6px;
  }
  .quick-route__cta {
    font-size: 10.5px;
    color: var(--c-ink-2);
    letter-spacing: 0.1em;
    margin: 0;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* Reduced-motion guard: the quick-route cards have no animation by
     default, so the un-animated page is byte-identical to the
     animated page when prefers-reduced-motion is on. No overrides
     needed; documenting the contract here. */

  /* ====== CONTACT ====== */
  .contact__line {
