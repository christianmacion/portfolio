  /* v13.1 Bryllim parity : bio paragraphs. Two short declarative
     sentences each (Bryllim register: plain language, no adjective
     stacks). Inter body, 15px, line-height 1.6 for legibility. */
  .hero-flagship__bio {
    font-family: var(--j-ff-display);
    font-size: 15px;
    line-height: 1.6;
    color: var(--c-ink);
    margin: 0;
    max-width: 56ch;
  }
