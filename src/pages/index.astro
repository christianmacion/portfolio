---
/**
 * index.astro : v9.1 HOME : INSTITUTIONAL BROADSIDE
 *
 * Per webcraft-no-vibe (VIBE-DOCTRINE.md Part III):
 *   "If a stranger can tell you used AI to build it within 5 seconds,
 *    it shipped with vibes. If they can tell you who built it within
 *    30 seconds, it shipped in the institutional register."
 *
 * Target register: Jane Street Press / Stripe Press / FT-style broadside.
 *
 * Visual identity:
 *   - Geometric CM monogram (signature mark, top-left)
 *   - Running header tape (deploy date + version + UTC offset + nav links)
 *   - Big Roman-serif display H1 (italic middle name, FT-style)
 *   - Hairline rules between sections, like a printed broadside
 *   - Section marks (§ 01, § 02) : editorial register
 *   - Tabular data strip (6 live counters : anchor the page as "alive")
 *   - Last: world map (8 pins) : the v8.5.1 hotfix, preserved
 *
 * Density: 5 sections, ~480 lines. Was 11 sections, 2,032 lines.
 */

import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import { profile } from '@utils/profile';
import { path } from '@utils/url';
import headshot from '../assets/portrait/headshot-source.jpg';
import Footprint from '@components/Footprint.astro';
import Marquee from '@components/Marquee.astro';
import HeroCurve from '@components/HeroCurve.astro';
import CertWall from '@components/CertWall.astro';
import SectionMark from '@components/SectionMark.astro';
import FiveEraCurve from '@components/FiveEraCurve.astro';
import GatesLattice from '@components/GatesLattice.astro';
import AIHistoryTimeline from '@components/AIHistoryTimeline.astro';

// v9.4.1 FLAGSHIP HERO : re-aimed for hireability.
// Marquee ribbon between hero and counter strip. Reuses Marquee.astro.
// v9.4.1: removed STELLA / GATE STACK / Acion / workbook chips (internal
// jargon). Replaced with recruiter-readable proof chips that match the
// skills matrix on the right side of the hero.
const heroMarqueeItems = [
  '6 YEARS · QUANT RESEARCH + AI ENGINEERING',
  '9 PAPER-TRADED ALPHA STRATEGIES',
  '76.5K PYTHON LOC',
  '6 AI ENGINEERING PROJECTS SHIPPED',
  '25 PUBLIC GITHUB REPOSITORIES',
  'STA TIER-1 CERTIFIED TECHNICAL ANALYST',
];

const email = profile.contact.email;
// v9.3.5 : deployedStamp + buildTime moved to SiteHeader.astro (single source of truth).
// v13.0 : SiteHeader removed from render; values now live on the global Nav chrome.

// v13.1.4 (2026-08-11, polish-7ag) : per-section metadata + recency stamp.
// Status + date + commit hash + related surface, mirroring the /about/
// `.bio-prose__meta` (polish-7t commit 3781944) and /contact/
// `.contact-card__meta` (polish-7x commit 19aa5ef). Copy-edit-only scope
// per the /comp/, /papers/, /404+500 reverts. NDA-safe: no 19V Capital
// or Macion Capital references; past NDA contracts framed as closed.
const HOME_COMMIT = '0279f24';

// Live counters : v9.4.1 hireability-facing. All sourced from profile.stats.ts.
// Stripped AARs / evalGates / pagesBuilt from first viewport (internal jargon);
// yearsExperience + aiProjectCount added so the strip answers a recruiter's
// "how long + how much" question in 5 seconds.
const liveCounters = [
  { label: 'YEARS EXPERIENCE', value: profile.stats.yearsExperience },
  { label: 'QUANT STRATEGIES', value: profile.stats.strategyCount },
  { label: 'PYTHON LOC', value: profile.stats.locPython },
  { label: 'AI PROJECTS', value: profile.stats.aiProjectCount },
  { label: 'PUBLIC GITHUB REPOS', value: profile.stats.repoCount },
  { label: 'CERTIFICATIONS', value: profile.stats.certCount },
];
---

<BaseLayout
  title={profile.titles.pageTitle}
  description={profile.titles.secondary}
  surface="v6-13"
  theme="light"
  chrome="full"
  pixelDisplay={true}
  breadcrumbs={[{ name: 'Home', href: '/' }]}
>
  <!-- v9.3.2 (2026-08-02) : a11y: BaseLayout.astro already wraps the
       page in <main id="main">; rendering an inner <main> here produced
       nested <main> landmarks (invalid HTML5; confusing to screen-reader
       landmark navigation). Replaced with <section> so the broadside is
       semantically sectioned, not landmarked. The outer BaseLayout
       <main id="main"> remains the single landmark for AT users. -->
  <section class="broadside home-section" aria-label="Home broadside">
    <!-- v9.3.5 : running header tape REMOVED. The global SiteHeader (above
         the Nav) now ships the CM monogram + name + role + UTC + deployed
         stamp on every page, including home. The downstream nav row is
         covered by the global Nav component. The home page keeps its
         flagship hero (eyebrow + H1 + role), stats strip, hook, and
         quick-route grid. the broadside reading still differentiates
         home from subpages; the chrome is now shared. -->

    <!-- ============= v13.1 BRYLLIM HERO =============
         Two-column Bryllim parity (2026-08-09): headshot on the left,
         name + subhead + 2-paragraph bio + social-links row on the right.
         Stats strip (years / strategies / LOC / projects) moves below as
         a full-width 4-cell row. The 5-CTA button cluster is replaced
         by the social-links row + a quiet resume text-link in the
         markets rail — fewer buttons, same routing.

         Voice: Bryllim register (short declarative sentences, plain
         language, no adjective stacks). Doctrine: Munger latticework
         (the bio names quant + AI + chrome as one cross-validated
         practice); Sagan Standard (every numeric claim traces to a
         shipped artifact); Goldratt constraint (chrome never delays
         the proof beat — the strip + curve below carry that beat). -->
    <section
      class="hero-flagship"
      aria-label="Quantitative researcher and AI engineer for financial markets"
    >
      <!-- Left column : headshot. No caption (decorative chrome removed
           per image #22-23). No entrance animation (per prefers-reduced-
           motion baseline). Widths match the sizes attribute: 200px on
           mobile, 280px on desktop. -->
      <figure class="hero-flagship__headshot">
        <Image
          src={headshot}
          alt={profile.headshot.alt}
          width={280}
          height={445}
          widths={[200, 280, 440]}
          sizes="(max-width: 860px) 200px, 280px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero-flagship__headshot-img"
        />
      </figure>

      <!-- Right column : Bryllim reading order.
           H1 first (the recruiter's 5-second grade), then subhead, then
           2-paragraph bio, then the social-links row, then the markets
           rail that closes the hero with the domain frame. -->
      <div class="hero-flagship__copy">
        <p class="hero-flagship__eyebrow mono">
          CHRISTIAN T. MACION · DIGOS CITY, DAVAO DEL SUR, PHILIPPINES · REMOTE (UTC+8)
        </p>
        <h1 class="hero-flagship__name">Quantitative Researcher</h1>
        {/* v14 (2026-08-23, hero-capability) : 12-word capability statement
            lives right below the H1. Visitor evaluates Owner in 30s; this
            is the proof beat. Same register as the Bryllim subhead, just
            sharpened: capability + receipt in one line. */}
        <p class="hero-flagship__subhead">
          Six years shipping alpha strategies and the AI systems behind them.
        </p>
        <p class="hero-flagship__bio">
          I'm a quant researcher who builds the eval harness behind the alpha. Six years across
          equities, futures, FX, and crypto. Same methodology, two lanes: systematic strategies on
          public data and multi-agent LLM systems behind frozen specs.
        </p>
        <p class="hero-flagship__bio">
          I love turning rough ideas into things a stranger can re-run from a public commit. The
          proof sits one click below: strategy workbooks, trade logs, and the G1 to G31 gate stack.
        </p>

        <!-- v13.1.4 (2026-08-14, polish-7aw) : money-making proof strip
             in the hero region. Single line, no new section. Numbers
             verbatim from memory (content-uplift-scope = copy-edit-only).
             Both candidates' return characters visible at first glance.
             Manual-only posture preserved (no live capital claim). -->
        <p class="hero-flagship__proof mono">
          RECENT ALPHA-HUNT · V2K Donchian(20) XAU/USD · $1,781/yr at 1 micro lot · 14 months to $2K
          payout · 4 of 4 walk-forward positive · Funding carry top-8 · Sharpe 5.29 · ann 9.76% ·
          manual only
        </p>

        <!-- v13.1 (Bryllim parity) : social-links row. Mono caps + ↗
             arrow on each cell matches the Bryllim reference spacing.
             github / linkedin / medium / email — the four canonical
             public surfaces. No new chrome tokens introduced. -->
        <nav class="hero-flagship__links" aria-label="Public profiles">
          <a
            href={profile.contact.github}
            class="hero-flagship__link"
            rel="me noopener"
            target="_blank"
          >github <span aria-hidden="true">↗</span></a>
          <a
            href={profile.contact.linkedin}
            class="hero-flagship__link"
            rel="me noopener"
            target="_blank"
          >linkedin <span aria-hidden="true">↗</span></a>
          <a
            href={profile.contact.medium}
            class="hero-flagship__link"
            rel="me noopener"
            target="_blank"
          >medium <span aria-hidden="true">↗</span></a>
          <a
            href={`mailto:${profile.contact.email}`}
            class="hero-flagship__link"
          >email <span aria-hidden="true">↗</span></a>
        </nav>

        <!-- v13.1 (Bryllim parity) : markets rail + quiet resume link.
             The 5-CTA cluster is removed; a single text-link to the
             1-page resume lives at the end of the rail so the
             institutional "system responds" cue survives without
             becoming a SaaS button. -->
        <p class="hero-flagship__markets mono">
          {profile.titles.marketsRail}
          <span class="hero-flagship__markets-sep" aria-hidden="true">·</span>
          <a
            href={path('/resume-quant-onepage.pdf')}
            class="hero-flagship__resume"
            download
          >1-PAGE RESUME <span aria-hidden="true">↗</span></a>
        </p>
      </div>
    </section>

    <!-- v9.7.1 : flagship live-performance centerpiece. Animated SVG equity
         curve placed between hero-flagship and the live counter strip. Reads
         as proof of "this person ships" to the curve draws on mount, pulses
         at the terminus, and captions the expected paper-trade return.
         Cream surface + amber line preserve the chrome contract. -->
    <HeroCurve />

    <!-- ============= LIVE DATA STRIP : moved up (PATCH 7): primary visual proof
         sits right after the hero. Reading order: H1 → role → CTAs → curve →
         strip (proof) → marquee (ambient) → § 01. ============= -->
    <aside class="strip" aria-label="Live counters">
      <div class="strip__inner">
        {
          liveCounters.map((c) => (
            <div class="strip__cell">
              {/* Bryllim-style diagonal arrow in upper-right of each cell.
                  Decorative only : aria-hidden so screen-readers get the
                  numeric value from data-countup without competing chrome. */}
              <span class="strip__arrow" aria-hidden="true">
                ↗
              </span>
              <p class="strip__num" data-countup={c.value}>
                {c.value}
              </p>
              <p class="strip__label mono">{c.label}</p>
            </div>
          ))
        }
      </div>
      <p class="strip__sub mono">
        {profile.stats.certCount} certs in the last {profile.stats.ageMonths} months. AWS, GCP, quant,
        AI.
      </p>
    </aside>

    <!-- ============= RUNNING-TAPE RIBBON : moved down (PATCH 7): ambient
         ribbon AFTER the proof. Reuses Marquee.astro. 5 items per UI/UX. -->
    <aside class="hero-ribbon" aria-label="Operating register">
      <Marquee items={heroMarqueeItems} speedSec={60} />
    </aside>

    <!-- ============= § 01 : LEDE ============= -->
    <section class="lede" aria-label="Working description" data-section-id="projects">
      <!-- v11.W1.2 : copy refreshed for Stage 0 doctrine integration. The
           lede is now a 2-paragraph latticework framing: paragraph 1
           names the practice (quant + AI + chrome as one cross-validated
           model), paragraph 2 names the proof beat (workbooks + trade
           logs + kill log + 31-gate stack). Sagan Standard: every
           artefact name maps to a real, accessible page or repo. -->
      <SectionMark index="01" title="projects" />
      <h2 class="lede__mark mono">§ 01. The Work</h2>
      <p class="home-meta mono">
        LIVE · 2026-08 · commit <code>9eba08f</code> · <a href={path('/projects/')}>→ /projects/</a>
      </p>
      <p class="lede__body">
        Quant research, production AI engineering, and the chrome discipline that makes the work
        legible to a hiring reader are not adjacent skills. They are one cross-validated practice. A
        trading edge cleared by the 31-gate stack is the same artifact audited for accessibility,
        indexed in a workbook, and rendered as recruiter-facing proof on this site. Each discipline
        stress-tests the others.
      </p>
      <p class="lede__body">
        Below: 9 quant strategies with published methodology, 6 production AI projects, 25 public
        repositories, and a 31-gate eval harness with a public kill log. Every claim is dated. Every
        commit is referenced. Every closed backtest carries its drawdown window. Client-confidential
        work is omitted.
      </p>
    </section>

    <!-- ============= § 01.5 : AI HISTORY TIMELINE =============
         v12.W4 : flagship visual proof that the trend-tracking fingerprint
         is real. PROMPTS to GRAPHS, two months ahead of mainstream each
         rung. NDA-safe copy: dates from canonical industry emergence +
         personal shipped records. Renders as a horizontal strip on
         desktop, vertical stack on mobile (auto via media query). -->
    <section class="trend" aria-label="Trend-tracking arc">
      <p class="home-meta mono">
        LIVE · 2026-08 · commit <code>2405c64</code> · <a href={path('/desk/')}>→ /desk/</a>
      </p>
      <AIHistoryTimeline
        variant="strip"
        chip="AI · HISTORY · THE LEAD"
        title="Always up to trend. Two months ahead."
        lede="Six architectural jumps in three years, each adopted on day one. The lead is the trend-tracking fingerprint for a quant seat."
      />
    </section>

    <!-- ============= § 02 : ARTIFACTS TABLE ============= -->
    <section class="artifacts" aria-label="What I ship" data-section-id="proof">
      <SectionMark index="02" title="proof" />
      <h2 class="artifacts__mark mono">§ 02. What I Ship</h2>
      <p class="home-meta mono">
        LIVE · 2026-08 · commit <code>9eba08f</code> · <a href={path('/proof/')}>→ /proof/</a>
      </p>
      <p class="artifacts__sub">
        9 quant strategies with published methodology. 6 production AI projects. 31-gate eval
        harness with public kill log. Numbers below are counted at deploy time, not rounded.
      </p>
      <table class="artifacts__table">
        <thead>
          <tr>
            <th>Artifact</th>
            <th>Type</th>
            <th class="num">Count</th>
            <th>Where</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Quant strategies (financial markets)</td>
            <td>alpha + risk, backtest, paper-trade · equities, futures, FX, crypto, alt-data</td>
            <td class="num">{profile.stats.strategyCount}</td>
            <td><a href={path('/projects')}>/projects</a></td>
          </tr>
          <tr>
            <td>Strategy workbooks + trade logs</td>
            <td>per-strategy memos, OOS metrics, kill log, drawdown windows</td>
            <td class="num">9 + trade log</td>
            <td><a href={path('/workbooks')}>/workbooks</a></td>
          </tr>
          <tr>
            <td>AI engineering projects</td>
            <td>RAG · LLM evaluation · MCP · multi-agent systems for trading ops</td>
            <td class="num">{profile.stats.aiProjectCount}</td>
            <td><a href={path('/ai')}>/ai</a></td>
          </tr>
          <tr>
            <td>Public repos (GitHub)</td>
            <td>workbooks, ships, experiments</td>
            <td class="num">{profile.stats.repoCount}</td>
            <td>
              <a href="https://github.com/christianmacion26">github.com/christianmacion26</a>
            </td>
          </tr>
          <tr>
            <td>Research validation methods (G1-G31)</td>
            <td
              >Walk-forward validation · block bootstrap · deflated Sharpe · regime conditioning</td
            >
            <td class="num">31</td>
            <td><a href={path('/methodology')}>/methodology</a></td>
          </tr>
          <tr>
            <td>Python codebase</td>
            <td>Backtests · AI tooling · research infrastructure</td>
            <td class="num">{profile.stats.locPython}</td>
            <td><a href={path('/proof')}>/proof</a></td>
          </tr>
          <tr>
            <td>Certs earned (last 11 months)</td>
            <td>AWS, GCP, quant, AI</td>
            <td class="num">{profile.stats.certCount}</td>
            <td><a href={path('/certifications')}>/certifications</a></td>
          </tr>
        </tbody>
      </table>
      {
        /* Bryllim-style overflow link: right-aligned "ALL X →" anchors
          the artifacts table back to the canonical /projects index.
          Decorative arrow ↗ already lives in the strip; this is the
          section-end overflow that points to the full page. */
      }
      <p class="artifacts__overflow">
        <a href={path('/projects')} class="bryllim-overflow mono"
          >ALL {profile.stats.strategyCount + profile.stats.aiProjectCount} PROJECTS →</a
        >
      </p>
    </section>

    <!-- ============= § 03 : CERTIFICATIONS WALL ============= -->
    <SectionMark index="03" title="certifications" />
    <p class="home-meta mono">
      LIVE · 2026-08 · commit <code>ed4742c</code> · <a href={path('/certifications/')}>→ /certifications/</a>
    </p>
    <section aria-label="Strategy validation discipline" data-section-id="validation">
      <div class="home-section">
        <FiveEraCurve />
      </div>
      <div class="home-section">
        <GatesLattice />
      </div>
    </section>

    <section aria-label="Certifications" data-section-id="certifications">
      <CertWall />
    </section>
    <p class="certwall__overflow">
      <a href={path('/certifications')} class="bryllim-overflow mono"
        >ALL {profile.stats.certCount} CERTS →</a
      >
    </p>

    <!-- ============= § 04 : READING LIST ============= -->
    <section class="help" aria-label="How I help" data-section-id="now">
      <SectionMark index="04" title="now" />
      <h2 class="help__mark mono">§ 04. What I Ship</h2>
      <p class="home-meta mono">
        LIVE · 2026-08 · commit <code>9eba08f</code> · <a href={path('/proof/')}>→ /proof/</a>
      </p>
      <p class="reading__sub">
        Four engagement shapes. Not services I list. Live systems built, deployed, kept honest with
        verifiable evidence.
      </p>
      <div class="help__grid help__grid--inline">
        <article class="help__card">
          <p class="help__kicker mono">QUANT RESEARCH</p>
          <h3 class="help__title">Statistical-arb pipelines that survive live deployment</h3>
          <p class="help__body">
            Walk-forward backtests, deflated Sharpe, regime conditioning. The 31-gate stack filters
            out edges that only looked good in-sample. Each pipeline ships with a paper-trade leg
            and a postmortem.
          </p>
        </article>
        <article class="help__card">
          <p class="help__kicker mono">AI ENGINEERING</p>
          <h3 class="help__title">Multi-agent build systems with eval-first discipline</h3>
          <p class="help__body">
            Production agents behind a frozen eval harness and a kill-switch. Failures banked into
            postmortems; wins banked into the next eval set. Ship behind metrics, not vibes.
          </p>
        </article>
        <article class="help__card">
          <p class="help__kicker mono">AI EVAL</p>
          <h3 class="help__title">Statistical gates for LLM claims</h3>
          <p class="help__body">
            Deflated Sharpe, block-bootstrap CIs, walk-forward stability. Same tools you use on
            backtests, applied to LLM eval scores. Built when the metric is too pretty.
          </p>
        </article>
        <article class="help__card">
          <p class="help__kicker mono">REPRODUCIBILITY</p>
          <h3 class="help__title">Reproducible artifacts with audit trails</h3>
          <p class="help__body">
            Frozen-spec eval, idempotent re-run, one-page AAR. Verifiable by a stranger, not just an
            insider.
          </p>
        </article>
      </div>
      {
        /* Bryllim overflow: section list ends with right-aligned "ALL X →"
          to the proof page where every capability claim is anchored. */
      }
      <p class="help__overflow">
        <a href={path('/proof')} class="bryllim-overflow mono">ALL PROOFS →</a>
      </p>
    </section>

    <!-- ============= § 05 : FOOTPRINT ============= -->
    <section class="footprint" aria-label="Footprint">
      <h2 class="footprint__mark mono">§ 05. Footprint</h2>
      <p class="home-meta mono">
        LIVE · 2026-08 · commit <code>32dafde</code> · <a href={path('/desk/')}>→ /desk/</a>
      </p>
      <p class="footprint__sub">
        20 venues across 3 regions. Real counterparts, real exchanges, real alt-data feeds.
        Verifiable, not decorative.
      </p>
      <Footprint />
    </section>

    <!-- ============= § 06 : CONTACT ============= -->
    <footer class="contact" aria-label="Contact">
      <h2 class="contact__mark mono">§ 06. Contact</h2>
      <p class="home-meta mono">
        LIVE · 2026-08 · commit <code>19aa5ef</code> · <a href={path('/contact/')}>→ /contact/</a>
      </p>
      <p class="contact__line mono">
        <a href={`mailto:${email}`}>{email}</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/christianmacion26">GitHub</a>
        <span aria-hidden="true">·</span>
        <a href="https://linkedin.com/in/christianmacion">LinkedIn</a>
        <span aria-hidden="true">·</span>
        <a href={path('/for-recruiters')}>Recruiter brief</a>
      </p>
      <p class="contact__sub">
        Open to quant research and AI engineer roles in financial markets. Selective contract
        engagements with publishable methodology. Reply within 24 hours.
      </p>
      <p class="contact__line mono">
        <a href={path('/methodology')}>Method (G1-G31)</a>
        <span aria-hidden="true">·</span>
        <a href={path('/comp')}>Comp bands</a>
        <span aria-hidden="true">·</span>
        <a href={path('/positions')}>Live positions</a>
      </p>
    </footer>

    {/* v13.1.4 (2026-08-11, polish-7ag) : recency stamp at bottom.
        Anchors the page to its last content-edit commit. Same register
        as /about/ `.about-recency` (polish-7t commit 3781944) and
        /contact/ `.contact-recency` (polish-7x commit 19aa5ef). Chrome
        contract v1: hairline rule + mono + 1 accent on hover; no halo,
        no glow. Text only, no nested anchor. */}
    <p class="home-recency mono">
      Last updated: 2026-08-14 · <a
        href={`https://github.com/christianmacion/christianmacion.github.io/commit/${HOME_COMMIT}`}
        target="_blank"
        rel="noopener noreferrer">commit {HOME_COMMIT}</a
      > · Quant Researcher · 31-gate eval-first
    </p>
  </section>
</BaseLayout>

<style>
  /* ============================================================
     v9.1 INSTITUTIONAL BROADSIDE HOME
     Target register: Jane Street Press / Stripe Press / FT-style broadside.
     Paper-cream background, dark navy ink, hairline rules everywhere.
     ============================================================ */

  .broadside {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--s-6) var(--s-9);
  }

  /* ====== RUNNING HEADER TAPE ====== */
  .tape {
    margin: 0 -32px 32px;
    padding: 14px 32px;
    border-top: 2px solid var(--c-ink);
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg);
  }
  .tape__row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .tape__row--top {
    margin-bottom: 8px;
    color: var(--c-ink);
    font-weight: 500;
  }
  .tape__row--bottom {
    color: var(--c-ink-2);
    padding-top: 8px;
    border-top: 1px solid var(--c-rule);
  }
  .tape__mark {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--c-ink);
  }
  .tape__id {
    font-weight: 700;
    color: var(--c-ink);
    letter-spacing: 0.16em;
  }
  .tape__sep {
    color: var(--c-ink-3);
    opacity: 0.55;
  }
  .tape__role,
  .tape__loc,
  .tape__utc {
    font-weight: 500;
  }
  .tape__nav {
    color: var(--c-ink-2);
    text-decoration: none;
    border: 0;
    padding: 0;
    transition: color 120ms ease;
  }
  .tape__nav:hover {
    color: var(--c-ink);
  }
  .tape__nav--cta {
    font-weight: 700;
    color: var(--c-ink);
  }

  /* ====== HERO : big serif display ====== */
  .hero {
