  .hero-flagship__link:hover,
  .hero-flagship__link:focus-visible {
    color: var(--c-amber);
  }
  .hero-flagship__link:hover span,
  .hero-flagship__link:focus-visible span {
    color: var(--c-amber);
  }
  /* v13.1 Bryllim parity : markets rail + quiet resume text-link.
