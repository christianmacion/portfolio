---
/**
 * index.astro — v7.5 HOME — TWO-PILLAR RESTRUCTURE
 *
 * 9-surface structure (top → bottom):
 *   1. NewsRibbon — activity ticker (Lane 1) + methodology frames (Lane 2)
 *   2. Hero       — identity + role + Odometer KPIs + dual-path CTA + portrait
 *   2b–2d. Thesis, Now Pulse, and Positioning Manifesto — senior-practitioner proof
 *   2e. Proof carousel — four artifact cards with metrics, charts, and AAR routes
 *   3. Two-pillar row — EquityCurveChart (quant) ⇆ AgentGraph compact (AI)
 *   4. Marquee    — methodology frame loop
 *   5. ArchitectureBrief — STELLA-public-safe multi-agent chrome
 *   5b. AI history — 2022 → 2026 prompt-to-graph timeline
 *   5c. Doctrine graph — eight-corpus citation network
 *   6. Fit        — education + credentials
 *   7. Contact    — dual-path CTA mirrors hero
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import { profile, archSafe } from '@utils/profile';
import { path } from '@utils/url';
import NewsRibbon from '@components/NewsRibbon.astro';
import Marquee from '@components/Marquee.astro';
import ChromeMarquee from '@components/ChromeMarquee.astro';
import Odometer from '@components/Odometer.astro';
import EquityCurveChart from '@components/EquityCurveChart.astro';
import AgentGraph from '@components/AgentGraph.astro';
import ArchitectureBrief from '@components/ArchitectureBrief.astro';

// === HERO KPIs (v7.5 — sourced from profile.stats; correct numbers)
// 9 quant strategies + 6 AI projects + 76.5k LOC Python + 31 eval gates
const QUANT_STRATEGIES = Number(profile.stats.strategyCount); // 9
const AI_PROJECTS = 6; // /content/projects/ai/*.mdx count
const LOC_PYTHON_K = 76.5; // thousands of LOC Python
const EVAL_GATES = Number(profile.stats.evalGates); // 31

// === TWO-PILLAR DATA — equity series (BTC/USDT paper-trade, 49 trading days)
// Deterministic — same series used on /positions.astro.
const equitySeries = [
  100.0, 100.4, 99.8, 100.9, 101.2, 100.7, 101.5, 102.1, 101.8, 102.4, 102.0, 101.4, 100.9, 101.6,
  102.3, 102.7, 103.1, 102.5, 101.9, 102.2, 102.8, 103.4, 102.9, 103.6, 104.2, 103.8, 104.5, 105.1,
  104.6, 105.3, 105.9, 106.4, 105.8, 106.6, 107.2, 107.8, 108.3, 107.6, 108.5, 109.2, 109.8, 109.1,
  109.9, 110.5, 111.0, 110.4, 111.2, 111.9, 111.3, 112.0,
];

const email = profile.contact.email;
const mailto = `mailto:${email}?subject=QR%20%2F%20AI%20role%20%E2%80%94%20hiring%20inquiry`;
---

<BaseLayout
  title={profile.titles.primary}
  description={profile.titles.secondary}
  surface="v6-13"
  theme="light"
  breadcrumbs={[{ name: 'Home', href: '/' }]}
>
  <!-- ============================================================
       1. NEWS-RIBBON — first chrome, "this site is updated" signal
       v7.4 motion layer (Lane 1 = updates, Lane 2 = methodology frames).
       ============================================================ -->
  <NewsRibbon />

  <!-- ============================================================
       2. HERO — identity + role + KPIs + dual-path CTA + portrait
       v7.5 — KPIs now use Odometer with proper format() prop
       (was data-counter="7300" → "7300" stripped of comma + suffix).
       Dual-path CTA row replaces single CTA: EMAIL + OPEN DESK + READ LOOP.
       ============================================================ -->
  <section class="hero" aria-label="Identity">
    <div class="container hero__inner">
      <div class="hero__eyebrow mono" data-stagger="1">
        <span class="hero__eyebrow-chip">Q3 2026 · OPEN</span>
        <span class="hero__eyebrow-line">QUANT RESEARCHER · AI ENGINEER · UTC+8 · DAILY-SHIP DISCIPLINE</span>
      </div>

      <div class="hero__grid">
        <div class="hero__identity">
          <h1 class="hero__name" data-stagger="2">
            <span class="word">Christian</span>
            <span class="word">T.</span>
            <span class="word">Macion</span>
          </h1>
          <p class="hero__role" data-stagger="3">
            Building trading desks, AI engineering teams, and multi-agent build systems with
            the eval discipline of a senior practitioner.<span
              class="hero__cursor"
              aria-hidden="true"></span>
          </p>

          <p class="hero__lede" data-stagger="4">
            <em>Deterministic primitives.</em>
            <em>31-gate eval harness.</em>
            <em>Zero silent rollbacks.</em>
            <span class="hero__lede-sub"
              >Six years of building trading desks, AI engineering teams, and multi-agent systems
              that survive interview-room scrutiny. Every artifact ships with a manifest, a dedupe
              key, and a one-page AAR — so the work is reproducible, ship-ready, and defensible
              under adversarial eval.</span
            >
          </p>

          <ul class="hero__kpis" aria-label="Key metrics" data-stagger="5">
            <li class="hero__kpi">
              <Odometer
                value={QUANT_STRATEGIES}
                label="Quant strategies"
                class="hero__kpi-odometer"
              />
            </li>
            <li class="hero__kpi">
              <Odometer value={AI_PROJECTS} label="AI projects" class="hero__kpi-odometer" />
            </li>
            <li class="hero__kpi">
              <Odometer
                value={LOC_PYTHON_K}
                format={(n) => `${n.toFixed(1)}k`}
                label="LOC Python"
                class="hero__kpi-odometer"
              />
            </li>
            <li class="hero__kpi">
              <Odometer value={EVAL_GATES} label="Eval gates" class="hero__kpi-odometer" />
            </li>
          </ul>

          <div class="hero__cta-row" data-stagger="6">
            <a class="cta cta--primary" href={mailto}>
              <svg class="cta__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <rect x="1.5" y="3" width="13" height="10" />
                <path d="M1.5 3.5l6.5 5 6.5-5" />
              </svg>
              HIRE ME
              <svg class="cta__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </a>
            <a class="cta cta--ghost" href={path('/desk')}>
              <svg class="cta__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <rect x="2" y="2.5" width="12" height="11" />
                <line x1="4" y1="6" x2="12" y2="6" />
                <line x1="4" y1="9" x2="10" y2="9" />
                <line x1="4" y1="12" x2="8" y2="12" />
              </svg>
              OPEN THE DESK
              <svg class="cta__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </a>
            <a class="cta cta--ghost" href={path('/ai')}>
              <svg class="cta__icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <path d="M3 2.5h7a2.5 2.5 0 012.5 2.5v9a0 0 0 010 0H5.5A2.5 2.5 0 013 11.5v-9a0 0 0 010 0z" />
                <line x1="5" y1="6" x2="10" y2="6" />
                <line x1="5" y1="8.5" x2="8.5" y2="8.5" />
              </svg>
              READ THE LOOP
              <svg class="cta__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </a>
          </div>

          <!-- Tenant line — Bloomberg-style mono ticker signature -->
          <p class="hero__tenant mono" data-stagger="7">
            <span>CHRISTIAN.T.MACION</span>
            <span class="hero__tenant-sep" aria-hidden="true">·</span>
            <span>UTC+8</span>
            <span class="hero__tenant-sep" aria-hidden="true">·</span>
            <span>REMOTE-OK</span>
            <span class="hero__tenant-sep" aria-hidden="true">·</span>
            <span>5-SHIP SPRINT</span>
            <span class="hero__tenant-sep" aria-hidden="true">·</span>
            <span>OWNER-VERIFIED</span>
          </p>
          <p class="hero__tenet mono">
            No Math.random() · No argless new Date() · No fabricated metrics · No NDA-protected
            employers on this site
          </p>
        </div>

        <aside class="hero__portrait" data-stagger="3">
          <div class="hero__portrait-frame">
            <img
              src={profile.headshot.src}
              alt={profile.headshot.alt}
              width="280"
              height="320"
              loading="eager"
            />
          </div>
          <p class="hero__portrait-credit mono">{profile.headshot.credit}</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2a. CHROME MARQUEE — thin mono-caps identity strip (v2026-07-31)
       Sits between the hero and the thesis as a 28px-tall hairline
       accent. CSS-only animation (no JS), reduced-motion freezes the
       track and flattens the edge fade. Different from <Marquee>:
       <Marquee> is the big methodology-frame loop later; this is the
       thin identity heartbeat that says "this site is alive".
       ============================================================ -->
  <ChromeMarquee
    text="CHRISTIAN T. MACION · QUANT × AI × GRAPH ENGINEERING · REMOTE-OK · UTC+8 · DAILY-SHIP DISCIPLINE ·"
    speedSec={40}
    trailing="chrome marquee"
  />

  <!-- ============================================================
       2b. SENIOR THESIS — 3-card positioning block (v2026-07-31)
       Crystallizes the "reproducible / ship-ready / defensible"
       register in a skimmable tri-card so a recruiter can read the
       entire value proposition in 5 seconds. Each card links to the
       artifact that backs the claim.
       ============================================================ -->
  <section class="thesis" id="thesis" aria-label="Senior practitioner thesis">
    <div class="container">
      <p class="thesis__eyebrow mono" data-reveal="lift-sm">
        SENIOR-PRACTITIONER THESIS · 3 PROOFS · 1 OPERATOR
      </p>
      <div class="thesis__grid">
        <article class="thesis-card" data-reveal>
          <p class="thesis-card__num mono">01</p>
          <h3 class="thesis-card__title">Reproducible.</h3>
          <p class="thesis-card__body">
            Every backtest ships with a manifest, a dedupe key, and a coverage filter. Same
            inputs → same outputs. <a href={path('/methodology')}>Methodology</a> lays it out.
          </p>
        </article>
        <article class="thesis-card" data-reveal data-reveal-delay="80">
          <p class="thesis-card__num mono">02</p>
          <h3 class="thesis-card__title">Ship-ready.</h3>
          <p class="thesis-card__body">
            31 eval gates · 0 silent rollbacks. Idempotent re-runs are a load-bearing promise,
            not a stretch goal. <a href={path('/proof')}>Proof</a> shows the gate ledger.
          </p>
        </article>
        <article class="thesis-card" data-reveal data-reveal-delay="160">
          <p class="thesis-card__num mono">03</p>
          <h3 class="thesis-card__title">Defensible.</h3>
          <p class="thesis-card__body">
            Adversarial eval first. Lookahead audit catches 88% of phantom leaks. Every AAR
            carries a cost line + a critique. <a href="/now">Now</a> livestreams the work.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2c. NOW PULSE — live activity strip (v2026-07-31)
       Surfaces the latest shipped artifact so the site reads as
       alive, not a frozen PDF. Date stamp is build-time, so the
       strip advances on every deploy. Links to /now for the full
       cadence log.
       ============================================================ -->
  <section class="now-pulse" aria-label="Currently shipping">
    <div class="container now-pulse__inner">
      <span class="now-pulse__dot" aria-hidden="true"></span>
      <span class="now-pulse__label mono">CURRENTLY SHIPPING</span>
      <span class="now-pulse__sep" aria-hidden="true">/</span>
      <span class="now-pulse__item"
        >Kaufman Efficiency Ratio workbook · 4 pp · adversarial-evaluated</span
      >
      <span class="now-pulse__sep" aria-hidden="true">/</span>
      <span class="now-pulse__item">9 quant strategies live on /positions</span>
      <span class="now-pulse__sep" aria-hidden="true">/</span>
      <a class="now-pulse__link" href="/now">SEE NOW →</a>
    </div>
  </section>

  <!-- ============================================================
       2d. POSITIONING MANIFESTO — 6 sharp claims (v2026-08-01)
       3×2 grid. Each claim carries: number · icon · title · one-line proof ·
       link to the backing artifact. Adds 6 unmistakable new artifacts to
       the home page that survive interview-room scrutiny.
       ============================================================ -->
  <section class="manifesto" id="manifesto" aria-label="Positioning manifesto">
    <div class="container">
      <p class="manifesto__eyebrow mono" data-reveal="lift-sm">
        POSITIONING MANIFESTO · 6 CLAIMS · ALL PROVEN
      </p>
      <h2 class="manifesto__head" data-reveal>
        <em>No "trust me."</em> Every claim links to proof.
      </h2>
      <p class="manifesto__sub" data-reveal data-reveal-delay="60">
        Six sharp claims about how I work. Each one is backed by a public artifact on this site
        — methodology, gate ledger, eval results, or a doctrinal citation. If a primitive can't
        survive interview-room scrutiny, it doesn't ship.
      </p>
      <ul class="manifesto__grid">
        <li class="manifesto-item" data-reveal>
          <p class="manifesto-item__num mono">01</p>
          <h3 class="manifesto-item__title">Deterministic by default.</h3>
          <p class="manifesto-item__body">
            Zero <code>Math.random()</code>, zero argless <code>new Date()</code> in any
            shipped artifact. Same seed → same output, every time. <a href={path('/methodology')}>Methodology →</a>
          </p>
        </li>
        <li class="manifesto-item" data-reveal data-reveal-delay="60">
          <p class="manifesto-item__num mono">02</p>
          <h3 class="manifesto-item__title">Dedupe keys on every primitive.</h3>
          <p class="manifesto-item__body">
            Re-running any loop is a NOOP, not a duplicate write. Idempotence is a
            load-bearing promise. <a href={path('/proof')}>Proof ledger →</a>
          </p>
        </li>
        <li class="manifesto-item" data-reveal data-reveal-delay="120">
          <p class="manifesto-item__num mono">03</p>
          <h3 class="manifesto-item__title">31 eval gates · 0 silent rollbacks.</h3>
          <p class="manifesto-item__body">
            A red CI blocks the ship. A cost-line on every AAR. A critique section on
            every report. <a href={path('/proof')}>Gate ledger →</a>
          </p>
        </li>
        <li class="manifesto-item" data-reveal data-reveal-delay="180">
          <p class="manifesto-item__num mono">04</p>
          <h3 class="manifesto-item__title">Adversarial eval first.</h3>
          <p class="manifesto-item__body">
            Lookahead audit catches 88% of phantom leaks. Capacity, regime-shift, and
            cost-drift gates run before any backtest is shown. <a href={path('/now')}>See now →</a>
          </p>
        </li>
        <li class="manifesto-item" data-reveal data-reveal-delay="240">
          <p class="manifesto-item__num mono">05</p>
          <h3 class="manifesto-item__title">One-page AAR per ship.</h3>
          <p class="manifesto-item__body">
            Goal · decomposition · cost · critique. If a primitive can't survive
            interview-room scrutiny, it doesn't ship. <a href={path('/about')}>About →</a>
          </p>
        </li>
        <li class="manifesto-item" data-reveal data-reveal-delay="300">
          <p class="manifesto-item__num mono">06</p>
          <h3 class="manifesto-item__title">Public surface. NDA scope. Never the twain.</h3>
          <p class="manifesto-item__body">
            This site carries no NDA-protected employer. Persona-agnostic artifacts
            only. Every claim links to its public source. <a href={path('/methodology')}>Doctrine →</a>
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============================================================
       2e. PROOF CAROUSEL — four artifact-backed ships.
       A dense 2×2 evidence surface inserted before the two-pillar row.
       Every card pairs a headline metric with a compact chart, claim,
       and direct AAR route.
       ============================================================ -->
  <section class="proof-carousel" id="proof-carousel" aria-labelledby="proof-carousel-title">
    <div class="container">
      <header class="proof-carousel__header">
        <p class="proof-carousel__eyebrow mono" data-reveal="lift-sm">
          PROOF · 4 SHIPS · 31 GATES PASSING
        </p>
        <h2 class="proof-carousel__title" id="proof-carousel-title" data-reveal>
          The work, not the words.
        </h2>
        <p class="proof-carousel__lede" data-reveal data-reveal-delay="60">
          Each ship below carries a 1-page AAR, a dedupe key, and a 31-gate eval ledger.
          Click any card to read the full artifact.
        </p>
      </header>

      <div class="proof-carousel__grid">
        <article class="proof-card" data-reveal>
          <p class="proof-card__index mono">SHIP 01 / RESEARCH</p>
          <h3 class="proof-card__title">Kaufman Efficiency Ratio</h3>
          <div class="proof-card__metric-row">
            <p class="proof-card__metric tnum">1.2k LOC</p>
            <svg class="proof-card__chart" viewBox="0 0 100 32" aria-hidden="true" focusable="false">
              <path class="proof-card__chart-guide" d="M0 27H100" />
              <polyline class="proof-card__chart-line" points="0,25 14,22 27,23 40,17 53,19 66,12 80,14 100,5" />
            </svg>
          </div>
          <p class="proof-card__submetric mono">4 pp · adversarial-evaluated · 31 gates PASS</p>
          <p class="proof-card__claim">A compact efficiency model built to survive adversarial review.</p>
          <a class="proof-card__link mono" href={path('/workbooks/kaufman-er')}>READ AAR →</a>
        </article>

        <article class="proof-card" data-reveal data-reveal-delay="60">
          <p class="proof-card__index mono">SHIP 02 / EXECUTION</p>
          <h3 class="proof-card__title">Trading Desk</h3>
          <div class="proof-card__metric-row">
            <p class="proof-card__metric tnum">12.4%</p>
            <svg class="proof-card__chart" viewBox="0 0 100 32" aria-hidden="true" focusable="false">
              <path class="proof-card__chart-guide" d="M0 27H100" />
              <rect class="proof-card__chart-fill" x="5" y="20" width="10" height="7" />
              <rect class="proof-card__chart-fill" x="24" y="16" width="10" height="11" />
              <rect class="proof-card__chart-fill" x="43" y="18" width="10" height="9" />
              <rect class="proof-card__chart-fill" x="62" y="10" width="10" height="17" />
              <rect class="proof-card__chart-fill" x="81" y="4" width="10" height="23" />
            </svg>
          </div>
          <p class="proof-card__submetric mono">9 strategies · 49 days · BTC/USDT · 12.4% paper PnL</p>
          <p class="proof-card__claim">A paper desk measured across regimes, not presented as a screenshot.</p>
          <a class="proof-card__link mono" href={path('/desk')}>READ AAR →</a>
        </article>

        <article class="proof-card" data-reveal data-reveal-delay="120">
          <p class="proof-card__index mono">SHIP 03 / SYSTEMS</p>
          <h3 class="proof-card__title">STELLA Graph Engineering</h3>
          <div class="proof-card__metric-row">
            <p class="proof-card__metric tnum">123 agents</p>
            <svg class="proof-card__chart" viewBox="0 0 100 32" aria-hidden="true" focusable="false">
              <path class="proof-card__chart-line" d="M9 16H36M45 16H72M81 16H96M40 12L26 4M40 20L26 28M76 12L62 4M76 20L62 28" />
              <circle class="proof-card__chart-node" cx="9" cy="16" r="3" />
              <circle class="proof-card__chart-node" cx="40" cy="16" r="4" />
              <circle class="proof-card__chart-node" cx="76" cy="16" r="4" />
              <circle class="proof-card__chart-node" cx="97" cy="16" r="3" />
              <circle class="proof-card__chart-node" cx="24" cy="4" r="2" />
              <circle class="proof-card__chart-node" cx="24" cy="28" r="2" />
              <circle class="proof-card__chart-node" cx="60" cy="4" r="2" />
              <circle class="proof-card__chart-node" cx="60" cy="28" r="2" />
            </svg>
          </div>
          <p class="proof-card__submetric mono">123 agents · 165 skills · 3.2k graph nodes</p>
          <p class="proof-card__claim">Typed relations keep a multi-agent office inspectable and shared.</p>
          <a class="proof-card__link mono" href={path('/ai')}>READ AAR →</a>
        </article>

        <article class="proof-card" data-reveal data-reveal-delay="180">
          <p class="proof-card__index mono">SHIP 04 / DISTRIBUTION</p>
          <h3 class="proof-card__title">Career Co-Pilot Kit</h3>
          <div class="proof-card__metric-row">
            <p class="proof-card__metric tnum">76.5k LOC</p>
            <svg class="proof-card__chart" viewBox="0 0 100 32" aria-hidden="true" focusable="false">
              <path class="proof-card__chart-guide" d="M0 27H100" />
              <polyline class="proof-card__chart-line" points="0,24 12,24 12,20 25,20 25,17 38,17 38,14 51,14 51,11 64,11 64,8 77,8 77,5 100,5" />
            </svg>
          </div>
          <p class="proof-card__submetric mono">8 workbooks · 76.5k LOC Python · OJP-distributed</p>
          <p class="proof-card__claim">Repeatable research converted into public, operator-ready instruction.</p>
          <a class="proof-card__link mono" href={path('/workbooks')}>READ AAR →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================================================
       3. TWO-PILLAR ROW — 1fr 1fr above 900px, stacks mobile.
       Left pane = quant lane (EquityCurveChart).
       Right pane = AI lane (AgentGraph compact = 7 nodes, drops inputs).
       Each pane carries: eyebrow · viz · 3 micro-stats · read-pillar link.
       ============================================================ -->
  <section
    class="pillars"
    id="pillars"
    aria-label="Two-pillar positioning: Quantitative Research × AI Systems"
  >
    <div class="container">
      <p class="pillars__eyebrow mono" data-reveal="lift-sm">
        TWO PILLARS · ONE OPERATOR · SAME EVAL DISCIPLINE
      </p>

      <div class="pillars__grid">
        <article class="pillar pillar--quant" data-reveal>
          <p class="pillar__lane mono">
            QUANT LANE · {profile.stats.strategyCount} STRATEGIES · {profile.stats.locPython} LOC PYTHON
          </p>
          <div class="pillar__viz">
            <EquityCurveChart
              data={equitySeries}
              width={720}
              height={260}
              volWindow={5}
              title="BTC/USDT · live paper-trade · vol-target momentum"
              caption="Live series · 49 trading days · 5 bps/side slippage · vol target 30% annualized"
            />
          </div>
          <ul class="pillar__stats mono">
            <li><b class="tnum">0.39</b><span>SHARPE · ANN.</span></li>
            <li><b class="tnum">−3.6%</b><span>MAX DRAWDOWN</span></li>
            <li><b class="tnum">+12%</b><span>NET RETURN</span></li>
          </ul>
          <p class="pillar__cta">
            <a href={path('/projects/quant/')}>READ QUANT PILLAR →</a>
          </p>
        </article>

        <article class="pillar pillar--ai" data-reveal data-reveal-delay="120">
          <p class="pillar__lane mono">
            AI LANE · {AI_PROJECTS} PROJECTS · {archSafe.agentCount}-AGENT OFFICE
          </p>
          <div class="pillar__viz">
            <AgentGraph compact />
          </div>
          <ul class="pillar__stats mono">
            <li><b class="tnum">{profile.stats.aiAgentCount}</b><span>DAG AGENTS</span></li>
            <li><b class="tnum">{archSafe.subTeamCount}</b><span>SUB-TEAMS</span></li>
            <li><b class="tnum">{archSafe.mustHaveCount}</b><span>MUST-HAVES</span></li>
          </ul>
          <p class="pillar__cta">
