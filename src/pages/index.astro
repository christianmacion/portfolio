  }
  .thesis-card__body a:hover {
    border-bottom-color: var(--c-warn);
  }

  /* ====== NOW PULSE (v2026-07-31) ====== */
  .now-pulse {
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-rule);
    padding: 14px 0;
  }
  .now-pulse__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font: 500 11px / 1.4 var(--ff-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .now-pulse__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c-warn);
    box-shadow: 0 0 0 0 var(--c-warn);
    animation: pulse-ring 2.4s ease-out infinite;
    flex: 0 0 auto;
  }
  @keyframes pulse-ring {
    0% {
      box-shadow: 0 0 0 0 var(--c-amberl-strong);
    }
    70% {
      box-shadow: 0 0 0 10px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-pulse__dot {
      animation: none;
    }
  }

  /* ====== POSITIONING MANIFESTO (v2026-08-01) ====== */
  .manifesto {
    background: var(--c-bg);
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
    padding: 56px 0 64px;
  }
  .manifesto__eyebrow {
    font: 600 11px / 1.2 var(--ff-mono);
    letter-spacing: 0.18em;
    color: var(--c-warn);
    text-transform: uppercase;
    margin: 0 0 18px;
  }
  .manifesto__head {
    font: 600 32px / 1.18 var(--serif-display);
    color: #1c2538;
    letter-spacing: -0.018em;
    margin: 0 0 12px;
    max-width: 32ch;
  }
  .manifesto__head em {
    font-style: italic;
    color: #3d4a5e;
    font-weight: 500;
  }
  .manifesto__sub {
    font: 400 14.5px / 1.55 var(--ff-sans);
    color: var(--c-ink-2);
    margin: 0 0 36px;
    max-width: 62ch;
  }
  .manifesto__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .manifesto-item {
    background: var(--c-bg-2);
    border: 1px solid var(--c-rule);
    border-left: 3px solid var(--c-warn);
    padding: 22px 22px 24px;
    transition: transform 240ms ease, border-color 240ms ease;
  }
  .manifesto-item:hover {
    transform: translateY(-2px);
    border-left-color: #1c2538;
  }
  .manifesto-item__num {
    font: 600 10px / 1 var(--ff-mono);
    letter-spacing: 0.2em;
    color: var(--c-warn);
    margin: 0 0 12px;
  }
  .manifesto-item__title {
    font: 600 16px / 1.25 var(--serif-display);
    color: #1c2538;
    margin: 0 0 10px;
    letter-spacing: -0.012em;
  }
  .manifesto-item__body {
    font: 400 13.5px / 1.55 var(--ff-sans);
    color: var(--c-ink-2);
    margin: 0;
  }
  .manifesto-item__body code {
    font: 500 12px / 1 var(--ff-mono);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    padding: 1px 5px;
    color: #1c2538;
  }
  .manifesto-item__body a {
    color: #1c2538;
    text-decoration: none;
    border-bottom: 1px solid var(--c-warn);
    transition: border-color 200ms ease;
    font-weight: 500;
  }
  .manifesto-item__body a:hover {
    border-bottom-color: #1c2538;
  }
  .now-pulse__label {
    color: var(--c-warn);
    font-weight: 600;
  }
  .now-pulse__sep {
    color: var(--c-ink-3);
    opacity: 0.6;
  }
  .now-pulse__item {
    color: var(--c-ink-2);
  }
  .now-pulse__link {
    color: var(--c-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--c-rule);
    margin-left: auto;
    padding-bottom: 1px;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .now-pulse__link:hover {
    color: var(--c-warn);
    border-bottom-color: var(--c-warn);
  }

  /* ====== PROOF CAROUSEL (v8.3) ======
     Evidence surface: flat cards, a teal rule, metric-first hierarchy.
     No shadow, glow, gradient, or traffic-light treatment. */
  .proof-carousel {
    padding: var(--sp-6) 0;
    background: var(--c-bg-2);
    border-bottom: var(--border-paper);
  }
  .proof-carousel__header {
    border-left: var(--c-proof-stripe) solid var(--c-accent-2);
    padding-left: var(--sp-3);
    margin-bottom: var(--sp-5);
  }
  .proof-carousel__eyebrow,
  .doctrine-graph__eyebrow {
    font: var(--j-w-mono) var(--j-t-xs) / var(--lh-snug) var(--ff-mono);
    color: var(--c-ink-2);
    letter-spacing: var(--j-track-wide);
    text-transform: uppercase;
    margin: 0 0 var(--sp-2);
  }
  .proof-carousel__title,
  .doctrine-graph__title {
    font: var(--j-w-heading) var(--c-proof-metric) / var(--lh-snug) var(--serif-display);
    color: var(--c-ink);
    letter-spacing: var(--j-track-tight);
    margin: 0 0 var(--sp-2);
  }
  .proof-carousel__lede,
  .doctrine-graph__lede {
    font: var(--j-type-meta);
    color: var(--c-ink-2);
    max-width: var(--container-narrow);
    margin: 0;
  }
  .proof-carousel__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
  }
  .proof-card {
    display: grid;
    grid-template-rows: auto auto auto auto 1fr auto;
    gap: var(--sp-2);
    min-width: 0;
    padding: var(--sp-3);
    background: var(--c-bg);
    border: var(--border-paper);
    border-top: var(--c-proof-stripe) solid var(--c-accent-2);
  }
  .proof-card__index {
    font: var(--j-w-mono) var(--j-t-xs) / var(--lh-tight) var(--ff-mono);
    color: var(--c-ink-3);
    letter-spacing: var(--j-track-wide);
    margin: 0;
  }
  .proof-card__title {
    font: var(--j-w-heading) var(--j-t-md) / var(--lh-snug) var(--serif-display);
    color: var(--c-ink);
    letter-spacing: var(--j-track-tight);
    margin: 0;
  }
  .proof-card__metric-row {
    display: grid;
    gap: var(--sp-2);
    min-width: 0;
  }
  .proof-card__metric {
    font: var(--j-w-heading) var(--c-proof-metric) / var(--lh-tight) var(--serif-display);
    color: var(--c-ink);
    letter-spacing: var(--j-track-tight);
    margin: 0;
  }
  .proof-card__chart {
    display: block;
    width: 100%;
    height: var(--sp-3);
    color: var(--c-accent-2);
  }
  .proof-card__chart-guide,
  .proof-card__chart-line {
    fill: none;
    stroke: currentColor;
    vector-effect: non-scaling-stroke;
  }
  .proof-card__chart-guide {
    stroke: var(--c-rule);
    stroke-width: 1;
  }
  .proof-card__chart-line {
    stroke-width: 2;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .proof-card__chart-fill {
    fill: var(--c-accent-2);
  }
  .proof-card__chart-node {
    fill: var(--c-bg);
    stroke: var(--c-accent-2);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .proof-card__submetric {
    font: var(--j-w-mono) var(--j-t-xs) / var(--lh-snug) var(--ff-mono);
    color: var(--c-ink-2);
    letter-spacing: var(--j-track-wide);
    margin: 0;
  }
  .proof-card__claim {
    font: var(--j-type-meta);
    color: var(--c-ink-2);
    margin: 0;
  }
  .proof-card__link {
    align-self: end;
    justify-self: start;
    font: var(--j-w-mono) var(--j-t-xs) / var(--lh-snug) var(--ff-mono);
    color: var(--c-ink);
    letter-spacing: var(--j-track-wide);
    text-decoration: none;
    border-bottom: var(--border-paper);
    padding-bottom: var(--j-sp-1);
    transition: var(--transition);
  }
  .proof-card__link:hover {
    border-bottom-color: var(--c-accent-2);
  }

  /* ====== DOCTRINE GRAPH (v8.3) ======
     The node rail + eight-card matrix is a compact citation network,
     not a decorative hero or a traffic-light dashboard. */
  .doctrine-graph {
    padding: var(--sp-6) 0;
    background: var(--c-bg);
    border-bottom: var(--border-paper);
  }
  .doctrine-graph__header {
    margin-bottom: var(--sp-3);
  }
  .doctrine-graph__network {
    padding: var(--sp-2) 0;
    margin-bottom: var(--sp-3);
    border-top: var(--border-paper);
    border-bottom: var(--border-paper);
  }
  .doctrine-graph__network svg {
    display: block;
    width: 100%;
    height: var(--sp-3);
  }
  .doctrine-network__line {
    fill: none;
    stroke: var(--c-rule);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .doctrine-network__node {
    fill: var(--c-bg);
    stroke: var(--c-accent-2);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .doctrine-graph__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-2);
  }
  .doctrine-card {
    display: grid;
    grid-template-columns: var(--c-proof-metric) 1fr;
    gap: var(--sp-2);
    align-items: start;
    min-width: 0;
    padding: var(--sp-2);
    background: var(--c-bg-2);
    border: var(--border-paper);
    border-left: var(--c-proof-stripe) solid var(--c-accent-2);
  }
  .doctrine-card__icon {
    display: block;
    width: var(--c-proof-metric);
    height: var(--c-proof-metric);
    color: var(--c-accent-2);
  }
  .doctrine-card__icon * {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }
  .doctrine-card__name {
    font: var(--j-w-mono) var(--j-t-xs) / var(--lh-snug) var(--ff-mono);
    color: var(--c-ink);
    letter-spacing: var(--j-track-wide);
    margin: 0 0 var(--j-sp-1);
  }
  .doctrine-card__anchor,
  .doctrine-card__application {
    font: var(--j-type-meta);
    margin: 0;
  }
  .doctrine-card__anchor {
    color: var(--c-ink);
    margin-bottom: var(--j-sp-1);
  }
  .doctrine-card__application {
    color: var(--c-ink-2);
  }

  @media (max-width: 980px) {
    .proof-carousel__grid,
    .doctrine-graph__grid {
      gap: var(--sp-2);
    }
    .doctrine-graph__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 720px) {
    .proof-carousel,
    .doctrine-graph {
      padding: var(--sp-5) 0;
    }
    .proof-carousel__header {
      padding-left: var(--sp-2);
      margin-bottom: var(--sp-4);
    }
    .proof-carousel__title,
    .doctrine-graph__title {
      font-size: var(--j-t-lg);
    }
    .proof-carousel__grid,
    .doctrine-graph__grid {
      grid-template-columns: 1fr;
    }
    .proof-card,
    .doctrine-card {
      padding: var(--sp-2);
    }
    .doctrine-graph__network {
      margin-bottom: var(--sp-2);
    }
  }

  /* ====== CTA (shared) ====== */
  .cta {
    display: inline-flex;
    align-items: center;
    padding: 14px 22px;
    font: 600 11px / 1 var(--ff-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--c-rule);
    cursor: pointer;
    transition:
      background 200ms ease,
      color 200ms ease,
      border-color 200ms ease;
    background: transparent;
    color: var(--c-ink);
  }
  .cta--primary {
    background: var(--c-warn);
    color: var(--c-bg);
    border-color: var(--c-warn);
  }
  .cta--primary:hover {
    background: var(--c-amber-deep);
    border-color: var(--c-amber-deep);
  }
  .cta--ghost {
    background: transparent;
    color: var(--c-ink);
    border-color: var(--c-rule);
  }
  .cta--ghost:hover {
    color: var(--c-warn);
    border-color: var(--c-warn);
  }

  /* ====== PILLARS — two-column grid ====== */
  .pillars {
    padding: 56px 0 64px;
    border-bottom: 1px solid var(--c-rule);
    background: var(--c-bg-2);
  }
  .pillars__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-warn);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 28px;
  }
  .pillars__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .pillar {
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    padding: 24px;
  }
  .pillar__lane {
    font: 500 10px / 1.4 var(--ff-mono);
    color: var(--c-ink-3);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--c-rule);
  }
  .pillar--ai .pillar__lane {
    color: var(--c-amber);
  }
  .pillar__viz {
    margin: 0 0 20px;
  }
  .pillar__viz :global(.eq-chart),
  .pillar__viz :global(.agent-graph) {
    margin: 0;
  }
  .pillar__stats {
    list-style: none;
    padding: 16px 0;
    margin: 0 0 16px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
  }
  .pillar__stats li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pillar__stats b {
    font: 600 20px / 1 var(--serif-display);
    color: var(--c-ink);
    letter-spacing: -0.018em;
  }
  .pillar__stats span {
    font: 500 9.5px / 1.2 var(--ff-mono);
    color: var(--c-ink-2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .pillar__cta {
    margin: 0;
  }
  .pillar__cta a {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-ink);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--c-rule);
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }
  .pillar__cta a:hover {
    color: var(--c-warn);
    border-bottom-color: var(--c-warn);
  }

  /* ====== ARCHITECTURE BRIEF (rendered by ArchitectureBrief.astro) ====== */
  /* Local overrides intentionally minimal — ArchitectureBrief.astro owns
     its own scoped styles. Reserve space in the page flow only. */
  .arch-brief {
    margin: 0;
  }

  /* ====== Fit (education) ====== */
  .fit {
    padding: 40px 0;
    border-bottom: 1px solid var(--c-rule);
  }
  .fit__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-ink-3);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .fit__line {
    font: 500 13px / 1.6 var(--ff-mono);
    color: var(--c-ink);
    margin: 0 0 8px;
  }
  .fit__line b {
    font-weight: 700;
    color: var(--c-ink);
  }
  .fit__line--meta {
    font: 400 12px / 1.6 var(--ff-sans);
    color: var(--c-ink-2);
    font-style: italic;
    margin: 0;
  }
  .fit__sep {
    color: var(--c-ink-3);
    margin: 0 8px;
  }

  /* ====== Contact — no gradient (audit C06 tell) ====== */
  .contact {
    padding: 56px 0;
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-rule);
  }
  .contact__inner {
    text-align: center;
  }
  .contact__eyebrow {
    font: 600 20px / 1.2 var(--serif-display);
    font-style: italic;
    color: var(--c-ink);
    margin: 0 0 8px;
  }
  .contact__cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 24px 0 20px;
  }
  .contact__secondary {
    font: 500 12px / 1.6 var(--ff-mono);
    color: var(--c-ink-2);
    margin: 0;
  }
  .contact__secondary a {
    color: var(--c-ink);
    text-decoration: none;
  }
  .contact__secondary a:hover {
    color: var(--c-warn);
  }

  /* ====== Responsive ====== */
  @media (max-width: 900px) {
    .pillars__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .arch-brief__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .arch-brief__title {
      font-size: 28px;
    }
    .thesis__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .now-pulse__inner {
      font-size: 10px;
      gap: 8px;
    }
    .now-pulse__link {
      margin-left: 0;
    }
  }

  @media (max-width: 720px) {
    .hero__inner {
      padding: 32px 0 40px;
    }
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hero__portrait {
      order: -1;
      max-width: 220px;
      margin: 0 auto;
    }
    .hero__name {
      font-size: 36px;
    }
    .hero__name .word:nth-child(2),
    .hero__name .word:nth-child(3) {
      font-size: 32px;
      color: #3d4a5e;
    }
    .hero__eyebrow {
      gap: 8px;
      margin-bottom: 24px;
    }
    .hero__eyebrow-chip {
      padding: 4px 9px 3px;
    }
    .hero__eyebrow-line {
      font-size: 10.5px;
    }
    .hero__kpis {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px 12px;
    }
    .hero__kpi :global(.odometer__value) {
      font-size: 22px;
    }
    .hero__cta-row {
      gap: 8px;
    }
    .cta {
      padding: 12px 16px;
      letter-spacing: 0.14em;
    }
    .hero__tenant {
      font-size: 10px;
      gap: 6px;
      letter-spacing: 0.12em;
    }
    .hero__tenet {
      font-size: 9.5px;
    }
    .pillar__stats {
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .pillar__stats b {
      font-size: 16px;
    }
    .pillar__stats span {
      font-size: 9px;
      letter-spacing: 0.1em;
    }
    .contact__eyebrow {
      font-size: 18px;
    }
    .manifesto {
      padding: 40px 0 48px;
    }
    .manifesto__head {
      font-size: 26px;
    }
    .manifesto__grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .manifesto-item {
      padding: 18px 18px 20px;
    }
  }

  /* ============================================================
     v7.6 — AI HISTORY TIMELINE (2022 → 2026)
     5-rung spine as a public-facing story. Surfaces STELLA +
     graph engineering alongside the prompt→graph journey.
     ============================================================ */
  .ai-history {
    padding-block: var(--sp-9);
    background: var(--c-bg);
    border-top: var(--border-paper);
    border-bottom: var(--border-paper);
  }
  .ai-history > .container {
    max-width: 1180px;
  }
  .ai-history__eyebrow {
    font: 500 11px / 1.4 var(--ff-mono);
    color: var(--c-amber);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .ai-history__title {
    font: 600 clamp(28px, 3.6vw, 44px) / 1.15 var(--serif-display);
    color: var(--c-ink);
    margin: 0 0 16px;
    letter-spacing: -0.022em;
    max-width: 880px;
  }
  .ai-history__title .hl {
    color: var(--c-amber);
  }
  .ai-history__lede {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--c-ink-2);
    max-width: 720px;
    margin: 0 0 48px;
  }
  .ai-history__rail {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    border-top: 1px solid var(--c-rule);
    border-bottom: 1px solid var(--c-rule);
    position: relative;
  }
  @media (max-width: 980px) {
    .ai-history__rail {
      grid-template-columns: repeat(2, 1fr);
    }
    .manifesto__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 580px) {
    .ai-history__rail {
      grid-template-columns: 1fr;
    }
  }
  .ai-rung {
    padding: 24px 20px;
    border-right: 1px solid var(--c-rule);
    display: flex;
    flex-direction: column;
    gap: 8px;
    position: relative;
    background: var(--c-bg);
    transition: background 0.2s ease;
  }
  .ai-rung:last-child {
    border-right: none;
  }
  @media (max-width: 980px) {
    .ai-rung:nth-child(2n) {
      border-right: none;
