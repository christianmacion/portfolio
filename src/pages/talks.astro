---
/**
 * talks.astro :  /talks/ · public lectures, conference & meetup appearances.
 *
 * Two sections:
 *   1) Public lectures  : VideoEmbed cards, 2-up, sourced from /proof.
 *   2) Conference & meetup appearances : tight list of public-facing events.
 *
 * Every artifact below is either a video on disk or a named event with a
 * public attestation (image, certificate, or institutional record). No
 * NDA-protected content; no proprietary data.
 *
 * v13.1.4 polish-7ai (2026-08-11, talks-uplift) :
 *   copy-edit-only pass : per-talk metadata (status + date + related
 *   surface + commit hash) + recency stamp at bottom. Anchored to /proof/
 *   polish-7af commit (9b0ced6) because the videos + cert images surfaced
 *   here live in /proof/. Same register as /notes/ polish-7ah (4e2cee3)
 *   + /proof/ polish-7af (9b0ced6) + /contact/ polish-7x (19aa5ef).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import VideoEmbed from '@components/VideoEmbed.astro';
import CTABanner from '@components/CTABanner.astro';
import { profile } from '@utils/profile';
import { path } from '@utils/url';
import VoiceLine from '@components/VoiceLine.astro';
import SectionMark from '@components/SectionMark.astro';

const fullName = profile.fullName.split(',')[0];
const NGATE = `${profile.stats.evalGates}-gate`;

// v13.1.4 (2026-08-11, talks-uplift) : per-page recency-stamp anchor.
// Held constant across all 8 entries so a single edit re-anchors the page.
// Points to /proof/ polish-7af (9b0ced6) because the videos + cert images
// surfaced here live in /proof/.
const TALKS_COMMIT = '9b0ced6';

// === Public lectures (VideoEmbed, 2-up) =====================================
// Per-entry status + related surface for the polish-7ai metadata strip.
// Status legend: DELIVERED (past, attested) | SCHEDULED (upcoming)
// | DRAFT (in prep). All entries below are DELIVERED.
const lectures = [
  {
    title: 'USeP EGE 313 Manobo lecture. live presenter view',
    date: '2024-09-13',
    audience: 'USeP · College of Engineering · EGE 313',
    description:
      'Live Presenter-view delivery for the EGE 313 cohort. Webcam lower-right; deck filename visible in the PPT Edit-mode frame.',
    src: path('/proof/usep-lecture.mp4'),
    poster: path('/proof/usep-lecture.jpg'),
    duration: 55,
    status: 'DELIVERED' as const,
    relatedSurface: '/proof',
    relatedHref: path('/proof'),
  },
  {
    title: 'AI workflow. same lecture, drafted via ChatGPT-assisted authoring',
    date: '2024-08-22',
    audience: 'USeP · EGE 313 (deck precursor)',
    description: `Three weeks before the lecture: same deck, drafted end-to-end via a single ChatGPT session. The precursor pattern to the current ${NGATE} authoring harness.`,
    src: path('/proof/ai-workflow.mp4'),
    poster: path('/proof/ai-workflow.jpg'),
    duration: 55,
    status: 'DELIVERED' as const,
    relatedSurface: '/proof',
    relatedHref: path('/proof'),
  },
];

// === Conference & meetup appearances (tight list) ===========================
// Per-entry status + related surface for the polish-7ai metadata strip.
// Related surfaces: /proof/ for video + cert image attestations;
// /methodology/ for the systematic-trading research guest lecture;
// /certifications/ for the STA Tier-1 CTA program graduate entry.
interface Appearance {
  date: string;
  dateLabel: string;
  title: string;
  audience: string;
  description: string;
  status: 'DELIVERED' | 'SCHEDULED' | 'DRAFT';
  relatedSurface: string;
  relatedHref: string;
  link?: { label: string; href: string };
}

const appearances: Appearance[] = [
  {
    date: '2024-10-05',
    dateLabel: 'Oct 5 2024',
    title: 'NASA Space Apps Challenge 2024. Galactic Problem Solver',
    audience: 'NASA Space Apps · Zurich global cohort',
    description:
      'Forty-eight-hour global hackathon; awarded the Galactic Problem Solver distinction for the open-data space-physics challenge track.',
    status: 'DELIVERED',
    relatedSurface: '/proof',
    relatedHref: path('/proof'),
    link: { label: 'Proof photo', href: path('/proof') },
  },
  {
    date: '2024-09-15',
    dateLabel: 'Sep 15 2024',
    title: 'PSHS-SMC alumni speaker. AI engineering and the PSHS → quant path',
    audience: 'Philippine Science High School. Southern Mindanao Campus',
    description:
      'Alumni talk on AI engineering, the math curriculum, and the educational path from PSHS-SMC to AI and quant careers. ~80 attendees, alumni and current students.',
    status: 'DELIVERED',
    relatedSurface: '/proof',
    relatedHref: path('/proof'),
  },
  {
    date: '2025-03-22',
    dateLabel: 'Mar 22 2025',
    title: 'USeP guest lecture. systematic trading research and AI for engineers',
    audience: 'University of Southeastern Philippines · College of Engineering',
    description:
      'Guest lecture on systematic trading research, multiple-testing discipline, and applied AI for engineering students. CpE / EE 5th-year elective cohort.',
    status: 'DELIVERED',
    relatedSurface: '/methodology',
    relatedHref: path('/methodology'),
  },
  {
    date: '2025-11-08',
    dateLabel: 'Nov 8 2025',
    title: 'AI for the Modern Workforce. Ateneo de Davao × US Embassy',
    audience: 'Ateneo de Davao University · US Embassy Manila',
    description:
      'Selected cohort for the AI for the Modern Workforce program; co-hosted by Ateneo de Davao and the US Embassy. AI-literacy curriculum for working professionals.',
    status: 'DELIVERED',
    relatedSurface: '/proof',
    relatedHref: path('/proof'),
    link: { label: 'Cert image', href: path('/proof/ateneo-american-corner-2025-11.jpg') },
  },
  {
    date: '2025-11-12',
    dateLabel: 'Nov 12 to 21 2025',
    title: 'BIDA × Bayan Academy × Meta AIccelerate 2025',
    audience: 'Board of Investments × Bayan Academy × Meta Philippines',
    description:
      'Five-day hybrid training on applied AI for Philippine MSMEs; co-signed certificate from BIDA, Bayan Academy, and Meta Philippines. Awarded Dec 17 2025.',
    status: 'DELIVERED',
    relatedSurface: '/proof',
    relatedHref: path('/proof'),
    link: { label: 'Cert image', href: path('/proof/bida-meta-aiccelerate-2025-11.jpg') },
  },
  {
    date: '2026-01-19',
    dateLabel: 'Jan 19 2026',
    title: 'CTA program graduate. Society of Technical Analysts of the Philippines',
    audience: 'STA Philippines · Tier-1 CTA program',
    description:
      'Tier-1 Certified Technical Analyst program, completed Jan 19 2026 (cert #260197). Final capstone: regime-classification case study on ASEAN equities.',
    status: 'DELIVERED',
    relatedSurface: '/certifications',
    relatedHref: path('/certifications'),
    link: { label: 'Cert image', href: path('/proof/cta-cert-portrait-2026-01.jpg') },
  },
];
---

<BaseLayout
  title="Talks"
  description="Public lectures, conference appearances, and meetup talks. sourced from the /proof archive. NDA-safe."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Talks', href: '/talks' },
  ]}
>
  <header class="talks-head">
    <div class="container">
      <p class="talks-head__eyebrow mono">
        <span class="talks-head__eyebrow-chip">TALKS · PUBLIC SPEAKING RECORD</span>
        <span class="talks-head__eyebrow-line">ON-DISK · EVENT-NAMED · ORGANIZER-LINKABLE</span>
      </p>
      <h1 class="talks-head__title" data-words>Talks, lectures, and recorded walkthroughs.</h1>
      <VoiceLine class="talks-head__voice">
        Every entry is on disk, named to the event, and linkable to the organizer.
      </VoiceLine>
      <p class="talks-head__sub">
        Every entry below is a public artifact. a video on disk, a named event with an
        institutional record, or a co-signed certificate. The {lectures.length} video lectures are surfaced
        from <a href={path('/proof')}>/proof</a>; the conference and meetup list names the rest.
      </p>
      <p class="talks-head__tenant mono">
        <span>CHRISTIAN.T.MACION</span>
        <span aria-hidden="true">·</span>
        <span>UTC+8</span>
        <span aria-hidden="true">·</span>
        <span>{lectures.length} LECTURES</span>
        <span aria-hidden="true">·</span>
        <span>PUBLIC</span>
        <span aria-hidden="true">·</span>
        <span>OWNER-VERIFIED</span>
      </p>
    </div>
  </header>

  {
    /* =========================================================
      Section 1 : Public lectures (VideoEmbed, 2-up)
      ========================================================= */
  }
  <section class="section" data-reveal data-section-id="talks">
    <div class="container">
      <header class="section__head">
        <SectionMark index="00" title="talks" />
        <p class="section__eyebrow">Section 1 · Public lectures</p>
        <h2 class="section__title">{lectures.length} recorded lectures on disk.</h2>
        <p class="section__sub">
          Both files are the canonical USeP EGE 313 delivery from late 2024. The second is the
          deck-authoring session three weeks prior. the precursor pattern to the current {NGATE} authoring
          harness.
        </p>
      </header>

      <div class="talks-grid">
        {
          lectures.map((lec) => (
            <article class="talks-card">
              <VideoEmbed
                src={lec.src}
                poster={lec.poster}
                title={lec.title}
                duration={lec.duration}
                caption={lec.description}
                mode="gallery"
              />
              <div class="talks-card__meta">
                <span class="talks-card__date mono">{lec.date}</span>
                <span class="talks-card__audience mono">{lec.audience}</span>
              </div>
              <h3 class="talks-card__title">{lec.title}</h3>
              <p class="talks-card__desc">{lec.description}</p>
              {/* v13.1.4 polish-7ai (talks-uplift) : per-lecture metadata strip.
                  status + date + related surface + commit. Same register as
                  /notes/ `.note-entry__meta` (polish-7ah 4e2cee3). */}
              <p class="talks-card__meta-strip mono" aria-label="Lecture metadata">
                <span class="talks-card__status">{lec.status}</span>
                <span class="talks-card__sep" aria-hidden="true">·</span>
                <time datetime={lec.date}>{lec.date}</time>
                <span class="talks-card__sep" aria-hidden="true">·</span>
                <span>related</span>
                <a href={lec.relatedHref}>{lec.relatedSurface}</a>
                <span class="talks-card__sep" aria-hidden="true">·</span>
                <span>commit</span>
                <code>{TALKS_COMMIT}</code>
              </p>
              <a
                class="talks-card__link"
                href={lec.src}
                download
                aria-label={`Download ${lec.title}`}
              >
                Download video ↓
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    /* =========================================================
      Section 2 : Conference & meetup appearances (tight list)
      ========================================================= */
  }
  <section class="section section--alt" data-reveal data-section-id="talks">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Section 2 · Conference & meetup appearances</p>
        <h2 class="section__title">Public events, awards, and recognitions.</h2>
        <p class="section__sub">
          A tight list of named public events. Most carry an institutional co-signer (NASA, Ateneo,
          US Embassy, BIDA, Meta, STA) and a date-stamped record.
        </p>
      </header>

      <ol class="talks-list">
        {
          appearances.map((a) => (
            <li class="talks-row">
              <div class="talks-row__date mono">{a.dateLabel}</div>
              <div class="talks-row__body">
                <h3 class="talks-row__title">{a.title}</h3>
                <div class="talks-row__audience mono">{a.audience}</div>
                <p class="talks-row__desc">{a.description}</p>
                {a.link && (
                  <a class="talks-row__link" href={a.link.href} rel="noopener noreferrer">
                    {a.link.label} →
                  </a>
                )}
                {/* v13.1.4 polish-7ai (talks-uplift) : per-appearance metadata strip.
                    status + date + related surface + commit. Same register as
                    /notes/ `.note-entry__meta` (polish-7ah 4e2cee3). */}
                <p class="talks-row__meta-strip mono" aria-label="Appearance metadata">
                  <span class="talks-row__status">{a.status}</span>
                  <span class="talks-row__sep" aria-hidden="true">·</span>
                  <time datetime={a.date}>{a.date}</time>
                  <span class="talks-row__sep" aria-hidden="true">·</span>
                  <span>related</span>
                  <a href={a.relatedHref}>{a.relatedSurface}</a>
                  <span class="talks-row__sep" aria-hidden="true">·</span>
                  <span>commit</span>
                  <code>{TALKS_COMMIT}</code>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CTABanner
    title="Want a specific talk in person?"
    sub="Open to invited lectures on systematic-trading research, AI-evaluation discipline, and the multi-agent LLM stack. Email with date, audience size, and venue."
    primaryLabel={`Email ${fullName}`}
    secondaryLabel="See methodology"
    secondaryHref={path('/methodology')}
  />

  {/* v13.1.4 polish-7ai (talks-uplift) : recency stamp at bottom. Same
      register as /proof/ `.proof-recency` (polish-7af 9b0ced6) and /contact/
      `.contact-recency` (polish-7x 19aa5ef). Anchors the page to its last
      content-edit commit (TALKS_COMMIT). */}
  <p class="talks-recency mono">
    Last updated: 2026-08-14 · <a
      href={`https://github.com/christianmacion/christianmacion.github.io/commit/${TALKS_COMMIT}`}
      target="_blank"
      rel="noopener noreferrer">commit {TALKS_COMMIT}</a
    > · /talks/ · Quant Researcher · 31-gate eval-first
  </p>
</BaseLayout>

<style>
  .talks-head {
    padding-block: var(--sp-9) var(--sp-7);
    background: var(--c-paper);
    border-bottom: var(--border);
  }
  .talks-head__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: var(--sp-4);
    color: var(--c-ink);
    font-weight: 600;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }
  .talks-head__sub {
    font-size: clamp(1rem, 2vw, var(--fs-lg));
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    margin-bottom: 0;
    max-width: 60ch;
  }
  .talks-head__voice {
    margin: 0 0 var(--sp-5);
    max-width: 60ch;
  }
  .talks-head__sub a {
    color: var(--c-amber);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 3px;
  }

  /* === Lectures grid (2-up) === */
  .talks-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-5);
  }
  .talks-card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-4);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    border-left: 3px solid var(--c-primary);
  }
  .talks-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-amber);
  }
  .talks-card__title {
    font-size: var(--fs-lg);
    margin: 0;
    color: var(--c-ink);
    line-height: var(--lh-snug);
  }
  .talks-card__desc {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    margin: 0;
  }
  .talks-card__link {
    margin-top: auto;
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--c-amber);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 3px;
    align-self: flex-start;
  }

  /* v13.1.4 polish-7ai (talks-uplift) : per-lecture metadata strip.
     Same register as /notes/ `.note-entry__meta` (polish-7ah 4e2cee3).
     Status chip in amber to match the existing date chip. */
  .talks-card__meta-strip {
    font-size: 10.5px;
    color: var(--c-ink-3);
    letter-spacing: 0.06em;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    align-items: center;
  }
  .talks-card__status {
    color: var(--c-amber);
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .talks-card__sep {
    color: var(--c-rule);
  }
  .talks-card__meta-strip a {
    color: var(--c-ink-2);
    text-decoration: none;
    letter-spacing: 0.06em;
  }
  .talks-card__meta-strip a:hover {
    color: var(--c-amber);
  }
  .talks-card__meta-strip code {
    color: var(--c-ink-2);
    font-family: ui-monospace, monospace;
    font-size: 10.5px;
  }

  /* === Tight appearances list === */
  .talks-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: var(--border);
  }
  .talks-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--sp-5);
    padding-block: var(--sp-5);
    border-bottom: var(--border);
    align-items: start;
  }
  .talks-row__date {
    font-size: var(--fs-sm);
    color: var(--c-amber);
    font-weight: 600;
    letter-spacing: 0.04em;
    padding-top: 2px;
  }
  .talks-row__title {
    font-size: var(--fs-lg);
    margin: 0 0 var(--sp-1);
    color: var(--c-ink);
    line-height: var(--lh-snug);
  }
  .talks-row__audience {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--sp-2);
  }
  .talks-row__desc {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    margin: 0 0 var(--sp-2);
  }
  .talks-row__link {
    font-family: var(--ff-mono);
    font-size: var(--fs-xs);
    color: var(--c-amber);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 3px;
  }

  /* v13.1.4 polish-7ai (talks-uplift) : per-appearance metadata strip.
     Same register as /notes/ `.note-entry__meta` (polish-7ah 4e2cee3). */
  .talks-row__meta-strip {
    font-size: 10.5px;
    color: var(--c-ink-3);
    letter-spacing: 0.06em;
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 6px;
    align-items: center;
  }
  .talks-row__status {
    color: var(--c-amber);
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .talks-row__sep {
    color: var(--c-rule);
  }
  .talks-row__meta-strip a {
    color: var(--c-ink-2);
    text-decoration: none;
    letter-spacing: 0.06em;
  }
  .talks-row__meta-strip a:hover {
    color: var(--c-amber);
  }
  .talks-row__meta-strip code {
    color: var(--c-ink-2);
    font-family: ui-monospace, monospace;
    font-size: 10.5px;
  }

  /* v13.1.4 polish-7ai (talks-uplift) : recency stamp at bottom.
     Same register as /proof/ `.proof-recency` (polish-7af 9b0ced6). */
  .talks-recency {
    margin: var(--sp-3) 0 var(--sp-6);
    padding: 0 var(--sp-4);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-align: center;
  }
  .talks-recency a {
    color: var(--c-ink-2);
    text-decoration: underline;
    text-decoration-color: var(--c-rule);
    text-underline-offset: 2px;
  }
  .talks-recency a:hover {
    color: var(--c-amber);
    text-decoration-color: var(--c-amber);
  }

  /* === Responsive === */
  @media (max-width: 720px) {
    .talks-grid {
      grid-template-columns: 1fr;
    }
    .talks-row {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
</style>
