---
/**
 * for-recruiters.astro : v6.0 · one-pager for HR / hiring managers.
 *
 * 60-second skim page for recruiters who don't yet know the body of
 * the site. Answers the six institutional questions directly:
 * 1) Who, 2) Status, 3) Seniority + target seats, 4) Location +
 * authorization, 5) Resume PDF + plain-text, 6) Fastest contact.
 * Plus an FAQPage JSON-LD so recruiters' search boxes surface the
 * canonical answers.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ChromeHeader from '@components/ChromeHeader.astro';
import { profile } from '@utils/profile';
import { path } from '@utils/url';
import VoiceLine from '@components/VoiceLine.astro';

const fullName = profile.fullName;
const loc = profile.location;
const email = profile.contact.email;
const phoneDisplay = profile.contact.phoneDisplay;
const linkedin = profile.contact.linkedin;
const NGATE = `${profile.stats.evalGates}-gate`;

// v6.12 : cold-email template. The {placeholder} tokens must appear as
// literal text (the recruiter is supposed to copy-paste then fill them),
// not as JSX expressions. Stored as a string in the frontmatter and
// rendered via <pre>{...}</pre> so Astro doesn't try to evaluate them.
const emailTemplate = `Subject: [{role-tag}] {seniority} · JD attached to {company}

Hi Christian :

I’m a {your-role} at {company}, sourcing for a {role} seat.
The JD is attached. Highlights:
  - {JD bullet 1}
  - {JD bullet 2}
  - {JD bullet 3}

If you’re open, I’d like a 30-min screening this {Tue|Wed|Thu}
between 18:00 to 22:00 PHT (UTC+8). Full agenda: christianmacion-portfolio.pages.dev/screening-call
If not, who do you recommend?

: {name}`;

// Same template, ASCII-punctuated, for the mailto body. Slightly different
// (: → -, ’ → ') so it survives ASCII-only transport cleanly.
const emailBody = `Hi Christian :\n\nI'm a {your-role} at {company}, sourcing for a {role} seat.\nThe JD is attached. Highlights:\n  - {JD bullet 1}\n  - {JD bullet 2}\n  - {JD bullet 3}\n\nIf you're open, I'd like a 30-min screening this {Tue|Wed|Thu} between 18:00-22:00 PHT (UTC+8).\nFull agenda: https://christianmacion-portfolio.pages.dev/screening-call\n\nIf not, who do you recommend?\n\n: {name}`;

// v12.W4 : FAQ trimmed to the questions the key-value table above does
// NOT already answer. Who / availability / location / resume / seniority
// all live in the table; repeating them as FAQ rows was the same answer
// twice on one page.
const faqs = [
  {
    q: 'What seniority level are they targeting?',
    a: 'Senior / staff Quant Researcher or Research Engineer. Primary seat: Quant Researcher (with QR-rotational considered). Secondary: AI Engineer inside a quant team that ships LLM tooling.',
  },
  {
    q: 'What data do the published results use?',
    a: 'Public sources only: Yahoo Finance, CoinGecko, FRED, EDGAR, SEC filings, public CME/CBOE chains. Every result on this site reproduces from them.',
  },
  {
    q: 'How fast can they respond?',
    a: 'Four business hours during the UTC+8 day for recruiter email. Cold DMs slower. Direct phone for qualified screening calls only.',
  },
  {
    q: 'Do they require sponsorship?',
    a: 'Not for remote engagements. the candidate works as an independent contractor from the Philippines. For full-time W-2 roles, visa sponsorship is the employer-side question; the candidate holds a Philippine passport and is open to globally remote (EOR) arrangements.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="For recruiters"
  description="The 60-second candidate one-pager: availability, location, target seats, resume PDFs, and direct contact for hiring managers."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'For recruiters', href: '/for-recruiters' },
  ]}
  surface="v6-13"
  chrome="slim"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <div class="container container--narrow">
      <ChromeHeader
        chip="FOR HIRING MANAGERS · 60-SECOND SKIM · NDA-CLEAN"
        eyebrow={`${fullName} · ${loc.display} · UTC+8 · IMMEDIATE START`}
        tenant={`CHRISTIAN.T.MACION · ${profile.stats.evalGates}-GATE EVAL · ${profile.stats.aiAgentCount}-AGENT OFFICE · ${profile.stats.locPython} LOC PYTHON`}
        chipVariant="amber"
        noSep
        hideTenet
      />
      <h1 class="hero__title" data-words>{fullName}</h1>
      <VoiceLine class="hero__voice">
        60-second skim. NDA-clean. Decide in one read.
      </VoiceLine>
      <p class="hero__sub">
        Quantitative researcher and AI engineer. {loc.display}. Remote QR, QR-rotational, or research-engineer
        seats with US-premarket or APAC overlap.
      </p>

      <div class="hero__fit">
        <p class="hero__fit-eyebrow mono">LOOKING FOR</p>
        <ul class="hero__fit-list">
          <li>Senior QR or research-engineer seat with a real eval bar.</li>
          <li>Strategy team that ships, with public-data or self-owned research.</li>
          <li>AI engineer seat inside a quant team that builds LLM tooling.</li>
        </ul>
        <p class="hero__fit-eyebrow mono">NOT LOOKING FOR</p>
        <ul class="hero__fit-list hero__fit-list--not">
          <li>Junior, intern, or rotational-only seats. Junior framing will end the conversation.</li>
        </ul>
      </div>

      <p class="hero__comp-link mono">
        Need comp ranges first? <a href={path('/comp')}>See engagement bands →</a>
      </p>

      <table class="kv">
        <tbody>
          <tr>
            <th scope="row">Status</th>
            <td>Open · immediate start · {profile.availability.hours}</td>
          </tr>
          <tr>
            <th scope="row">Target seats</th>
            <td
              >Quant Researcher (primary) · QR-Rotational · Quant Research Engineer · Research
              Engineer</td
            >
          </tr>
          <tr>
            <th scope="row">Location</th>
            <td>{loc.display} · working UTC+8 · remote-first</td>
          </tr>
          <tr>
            <th scope="row">Work authorization</th>
            <td
              >Filipino citizen · independent contractor · globally remote (EOR) · no sponsorship
              required</td
            >
          </tr>
          <tr>
            <th scope="row">Stack</th>
            <td
              >Python ({profile.stats.locPython} LOC) · {profile.stats.aiAgentCount} agents · {
                profile.stats.evalGates
              }-gate eval harness · MCP · multi-agent LLM · RAG · frozen-spec evals</td
            >
          </tr>
          <tr>
            <th scope="row">Resume PDF</th>
            <td>
              <a href={path('/resume')}>Tailored resumes →</a> ·
              <a href={path('/resume-tailored.pdf')} download>Quant (1-pg) ↓</a> ·
              <a href={path('/resume-ai-only.pdf')} download>AI-only ↓</a> ·
              <a href={path('/resume-quant-onepage.pdf')} download>Unified ↓</a>
            </td>
          </tr>
          <tr>
            <th scope="row">Contact</th>
            <td>
              <a href={`mailto:${email}?subject=Inquiry%20%E2%80%94%20Christian%20Macion`}
                >{email}</a
              >
              · {phoneDisplay} · <a href={linkedin} rel="noopener noreferrer" target="_blank"
                >LinkedIn</a
              >
            </td>
          </tr>
        </tbody>
      </table>

      <div class="hero__actions">
        <a
          class="btn btn--primary"
          href={`mailto:${email}?subject=Inquiry%20%E2%80%94%20Christian%20Macion`}
          >Email {fullName.split(',')[0]} →</a
        >
        <a class="btn btn--ghost" href={path('/resume')}>View resumes →</a>
        <a class="btn btn--ghost" href={path('/proof')}>See proof →</a>
        <a class="btn btn--ghost" href="#cold-email-template">Cold-email template ↓</a>
      </div>
    </div>
  </section>

  <section id="cold-email-template" class="section">
    <div class="container container--narrow">
      <header class="section__head">
        <p class="section__eyebrow mono">intro/</p>
        <h2 class="section__title">Cold-email template</h2>
        <p class="section__sub">
          Paste, fill, send. Two mailto links pre-fill subject + body. Reply SLA: 4 business hours during UTC+8
          day.
        </p>
      </header>

      <div class="intro-template">
        <pre class="intro-template__body mono">{emailTemplate}</pre>
        <ul class="intro-template__links">
          <li>
            <a
              class="btn btn--primary"
              href={`mailto:${email}?subject=${encodeURIComponent('[QR] Senior · JD attached to {role}')}&body=${encodeURIComponent(emailBody)}`}
            >
              Email [QR] track →
            </a>
          </li>
          <li>
            <a
              class="btn btn--ghost"
              href={`mailto:${email}?subject=${encodeURIComponent('[AI] Eval-first · JD attached to {role}')}&body=${encodeURIComponent(emailBody)}`}
            >
              Email [AI] track →
            </a>
          </li>
          <li class="intro-template__meta">
            Reply SLA · 4 business hours during UTC+8 day. Cold DMs: 24h SLA.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <header class="section__head">
        <h2 class="section__title">FAQ</h2>
        <p class="section__sub">
          {faqs.length} canonical questions. Short, factual, verifiable from the rest of the site.
        </p>
      </header>

      <ol class="faq">
        {
          faqs.map((f, i) => (
            <li class="faq__item">
              <details>
                <summary>
                  <span class="faq__num mono">{String(i + 1).padStart(2, '0')}</span>
                  <span class="faq__q">{f.q}</span>
                </summary>
                <p class="faq__a">{f.a}</p>
              </details>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--sp-9) var(--sp-7);
    background: var(--c-paper);
    border-bottom: var(--border);
  }
  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-4);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    flex-wrap: wrap;
  }
  /* v9.2 a11y : was --c-phi-teal. Dark theme --j-phi-teal = #2d5f5a
     only hits 2.14:1 on the dark page-head surface. Same fix as
     about.astro: solid amber chip + --c-bg text, ≥5.6:1 both themes. */
  .hero__eyebrow-chip {
    display: inline-block;
    padding: 4px 10px;
    color: var(--c-bg);
    border: 1px solid var(--c-amber);
    background: var(--c-amber);
    font-weight: 600;
  }
  .hero__eyebrow-line {
    color: var(--c-warn);
    font-weight: 600;
  }
  .hero__tenant {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-4) 0 0;
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    font-size: 0.78rem;
    color: var(--c-ink-2);
    letter-spacing: 0.06em;
  }
  .hero__tenant span:nth-child(odd) {
    color: var(--c-warn);
    font-weight: 600;
  }
  /* v9.3.1 (Phase 3B) : comp-link under the tenant block. Lets the
     recruiter jump to /comp without scrolling past the 7-row KV table.
     Inline mono, amber underline matches the rest of the chrome. */
  .hero__comp-link {
    margin: 0 0 var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-left: 3px solid var(--c-amber);
    font-size: var(--fs-xs);
    color: var(--c-ink-2);
    letter-spacing: 0.04em;
  }
  .hero__comp-link a {
    color: var(--c-primary);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .eyebrow {
    display: none;
  }
  .hero__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: var(--sp-4);
    color: var(--c-ink);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero__sub {
    font-size: clamp(1rem, 2vw, var(--fs-lg));
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    margin-bottom: var(--sp-7);
    max-width: 60ch;
  }
  .hero__voice {
    margin: 0 0 var(--sp-5);
    max-width: 60ch;
  }

  /* v12.W4.5 Bryllim-parity fit block. Looking-for / Not-looking-for as
     one bullet-list pair, mono caps, hairline borders. No halo, no glow.
     Sits directly below the hero sub so the recruiter reads the filter
     before the 7-row KV table. */
  .hero__fit {
    margin: 0 0 var(--sp-6);
    padding: var(--sp-4);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-left: 3px solid var(--c-amber);
  }
  .hero__fit-eyebrow {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-ink-3);
    margin: 0 0 var(--sp-2);
  }
  .hero__fit-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-4);
    color: var(--c-ink);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .hero__fit-list li {
    padding: var(--sp-2) 0;
    border-bottom: 1px solid var(--c-rule-soft);
  }
  .hero__fit-list li:last-child {
    border-bottom: 0;
  }
  .hero__fit-list--not li {
    color: var(--c-ink-2);
  }
  .kv {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--sp-7);
    border-top: var(--border);
    border-bottom: var(--border);
  }
  .kv th,
  .kv td {
    text-align: left;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--c-rule-soft);
    vertical-align: top;
  }
  .kv tr:last-child th,
  .kv tr:last-child td {
    border-bottom: none;
  }
  .kv th {
    width: 30%;
    color: var(--c-ink-3);
    font-weight: 600;
    text-transform: uppercase;
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    font-family: var(--ff-mono);
  }
  .kv td {
    color: var(--c-ink);
  }
  .kv a {
    color: var(--c-primary);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 3px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
  }

  .section {
    padding-block: var(--sp-9);
  }
  .section__head {
    margin-bottom: var(--sp-6);
  }
  .section__title {
    font-size: clamp(1.5rem, 3.5vw, var(--fs-2xl));
    margin-bottom: var(--sp-3);
    color: var(--c-ink);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .section__sub {
    color: var(--c-ink-2);
    font-size: var(--fs-base);
    line-height: var(--lh-loose);
    max-width: 60ch;
  }

  .faq {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border);
  }
  .faq__item {
    border-bottom: var(--border);
  }
  .faq__item details {
    padding: var(--sp-4) 0;
  }
  .faq__item summary {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    cursor: pointer;
    font-weight: 600;
    color: var(--c-ink);
    font-size: var(--fs-lg);
    list-style: none;
    padding-right: var(--sp-7);
    position: relative;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 0;
    color: var(--c-amber);
    font-size: 1.5rem;
    line-height: 1;
    font-weight: 400;
    transition: transform var(--transition);
  }
  /* v6.9.16 : drop the translateY(-2px) decorative shift. Used line-height
     + 1.5rem font for natural glyph centering instead. */
  .faq__item details[open] summary::after {
    content: '−';
    line-height: 0.85;
    display: inline-block;
  }
  .faq__num {
    color: var(--c-amber);
    font-size: var(--fs-sm);
    flex-shrink: 0;
    width: 2.5ch;
    letter-spacing: 0.05em;
  }
  .faq__q {
    flex: 1;
  }
  .faq__a {
    margin: var(--sp-4) 0 0 calc(2.5ch + var(--sp-4));
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    font-size: var(--fs-base);
  }

  @media (max-width: 600px) {
    .kv th {
      width: 38%;
    }
    .kv td {
      overflow-wrap: anywhere;
      max-width: 60vw;
      font-size: var(--fs-sm);
      line-height: 1.4;
    }
  }

  /* v6.12 : cold-email template block. Two-column on desktop, stacked on
     mobile. Mailto deep-links pre-fill subject + body via encodeURIComponent. */
  .intro-template {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--sp-5);
    align-items: start;
  }
  .intro-template__body {
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    padding: var(--sp-5);
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--c-ink);
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: auto;
    margin: 0;
  }
  .intro-template__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .intro-template__links li {
    margin: 0;
  }
  .intro-template__links .btn {
    width: 100%;
    justify-content: center;
  }
  .intro-template__meta {
    color: var(--c-ink-3);
    font-size: var(--fs-xs);
    font-family: var(--ff-mono);
    line-height: var(--lh-loose);
    padding-top: var(--sp-2);
    border-top: 1px solid var(--c-rule-soft);
  }

  @media (max-width: 720px) {
    .intro-template {
      grid-template-columns: 1fr;
    }
  }

  /* v6.12 : persona split. 2-pane reading-path grid; single column on
     narrow viewports. Derived from /methodology gate numbers + the
     3 resume PDF variants; no hardcoded chrome. */
  .persona-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
  }
  .persona-card {
    padding: var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-left: 3px solid var(--c-primary);
    border-radius: var(--radius);
  }
  .persona-card__title {
    font-size: var(--fs-lg);
    color: var(--c-ink);
    margin-bottom: var(--sp-2);
    font-weight: 600;
    line-height: 1.2;
  }
  .persona-card__sub {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-loose);
    margin-bottom: var(--sp-4);
  }
  .persona-card__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .persona-card__links li {
    padding-block: var(--sp-2);
    border-bottom: 1px solid var(--c-rule-soft);
  }
  .persona-card__links li:last-child {
    border-bottom: none;
  }
  .persona-card__links a {
    color: var(--c-primary);
    font-size: var(--fs-sm);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 3px;
    line-height: var(--lh-loose);
  }

  @media (max-width: 800px) {
    .persona-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
