---
/**
 * publications.astro : research log: papers, workbooks, talks, videos, OSS projects.
 * Targeted at recruiters who want to see *what Christian has published publicly*.
 *
 * Delta 6 : AQR-style research archive:
 *   - Topic filter (papers / OSS / workbooks / press) via CSS-only radio
 *   - Year grouping for research papers and OSS projects
 *   - Venue/author metadata column on each row
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/CTABanner.astro';
import ReadMeta from '@components/ReadMeta.astro';
import TrustStrip from '@components/TrustStrip.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { path } from '@utils/url';
import VoiceLine from '@components/VoiceLine.astro';
import SectionMark from '@components/SectionMark.astro';
import { profile } from '@utils/profile';

type ProjectEntry = CollectionEntry<'project'>;

// v13.1.4 (2026-08-11, publications-uplift) : per-publication metadata.
// Status + date + related surface + commit hash. Same register as
// /contact/ `.contact-card__meta` (polish-7x commit 19aa5ef) and
// /positions/ `.positions-card__meta` (polish-7z commit ec1674b).
const PUBLICATIONS_COMMIT = '2b0b040';

const allProjects: ProjectEntry[] = await getCollection('project');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
const aiPubs: ProjectEntry[] = projects.filter((p) => p.data.role === 'ai');
const quantPubs: ProjectEntry[] = projects.filter((p) => p.data.role === 'quant');

// Format a YYYY-MM-DD frontmatter date as "Mon YYYY"
function fmtDate(d?: Date | string): string {
  if (!d) return '';
  const date = typeof d === 'string' ? new Date(d) : d;
  if (isNaN(date.getTime())) return '';
  return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
function fmtYear(d?: Date | string): string {
  if (!d) return '';
  const date = typeof d === 'string' ? new Date(d) : d;
  if (isNaN(date.getTime())) return '';
  return String(date.getFullYear());
}

// Group pubs by year (descending) for the AQR-style year header.
// Typed against the project collection entry so downstream `.id`,
// `.data.title`, `.data.summary`, `.data.metrics`, `.data.stack`,
// `.data.sourceLink` accesses all type-check cleanly.
function groupByYear(items: ProjectEntry[]): [string, ProjectEntry[]][] {
  const map = new Map<string, ProjectEntry[]>();
  for (const item of items) {
    const y = fmtYear(item.data.date) || 'n/a';
    if (!map.has(y)) map.set(y, []);
    map.get(y)!.push(item);
  }
  return Array.from(map.entries()).sort((a, b) => Number(b[0]) - Number(a[0]));
}

const quantByYear = groupByYear(quantPubs);
const aiByYear = groupByYear(aiPubs);

// Published workbooks render with a download link + status="Published".
// In-progress entries omit `url` + `date` and render with the legacy
// "In progress" footer (see .wb__foot below).
const workbooks = [
  {
    title: 'Kaufman Efficiency Ratio. Trading Research Note',
    scope:
      'Adaptive efficiency measurement for trading strategies; reproducible Python + backtest manifest.',
    pages: '4 pp',
    audience: 'trading researchers, strategy developers',
    status: 'Published',
    date: '2026-07-18',
    author: 'Christian T. Macion',
    url: path('/workbooks/kaufman-efficiency-ratio.pdf'),
    fileSize: '287 KB',
    citationKey: 'macion2026kaufman',
  },
  {
    title: 'AI Architecture & Multi-Agent Systems Workbook',
    scope: `${profile.stats.aiAgentCount}-agent orchestrator, eval harness, MCP server, model routing`,
    pages: '~80 pp',
    audience: 'AI engineers, agent architects, eval harness designers',
  },
  {
    title: 'Statistical Modeling for Systematic Trading Workbook',
    scope: 'multiple testing, walk-forward, block-bootstrap, deflated Sharpe, cost realism',
    pages: '~110 pp',
    audience: 'quant researchers, strategy developers, backtest engineers',
  },
  {
    title: 'STA Tier-1 CTA Curriculum Workbook',
    scope: 'technical analysis fundamentals through advanced pattern recognition',
    pages: '~150 pp',
    audience: 'technical analysts, finance students, CFA/CMT candidates',
  },
];

const publishedCount = workbooks.filter((w) => w.status === 'Published').length;

const pressUnsorted = [
  {
    date: '2026-07-18',
    year: 2026,
    title:
      'Frontier Models for Quant Research & AI Engineering. r3 consulting brief released (18 pp, citable)',
    venue: 'portfolio.os · /research/frontier-models',
    detail:
      'Public-shareable brief comparing M3, Kimi K3, and Claude Opus 4.8 (with Fable 5, GPT-5.6 Sol, Gemini 3 Pro as reference points) for quant research + AI engineering. 18-page letter PDF, footnoted sources, two verification gates, declared gaps.',
    url: '/research/frontier-models',
  },
  {
    date: '2026-07-10',
    year: 2026,
    title:
      'v6.0.5 site patch. three real bugs shipped (Atom feed base path, AI H1 slugs, methodology cross-linking)',
    venue: 'portfolio.os · commit history',
    detail:
      'Three post-deploy audit fixes shipped: (1) feed.xml/feed-projects.xml/feed-solutions.xml entry URLs now include the /portfolio base path; (2) AI research page H1s now show human titles (RAG Recall Eval, Tool-Call Agent, LLM-as-Judge Harness, Eval MCP Server, Reflect-Revise Loop, Slop Scanner) instead of filename slugs; (3) /methodology now cross-links 12 unique glossary terms (DSR, PBO, walk-forward, block-bootstrap, embargo, OOS, slippage, Sharpe, regime, Bonferroni-Holm, MinBTL, survivorship) into the /glossary/{id} deep pages, up from zero.',
    url: 'https://github.com/christianmacion26/portfolio/commits/main',
  },
  {
    date: '2026-07-10',
    year: 2026,
    title: 'v6.0.4 spine shipped. 25 glossary deep pages + 15 research citation pages',
    venue: 'portfolio.os · release notes',
    detail:
      'Two new content surfaces: /glossary/{slug} (25 deep pages, one per glossary term, with extended prose + 3-6 related-term cross-links each) and /research/{lane}/{0N-slug} (15 academic citation pages, one per quant + AI project, where the numeric prefix comes from MDX filename order; URLs rendered as /research/quant/01-deflated-sharpe-ratio etc., with auto-generated BibTeX entries + copy-to-clipboard button + canonical-link row to /projects). Total 80 pages indexed. FlagshipCard self-link bug fixed (3 certs now point to issuer URLs). All build-time dates switched to UTC+8.',
    url: '/proof',
  },
  {
    date: '2026-04-21',
    year: 2026,
    title: 'Vol-target time-series momentum paper-trade. live publication on /positions',
    venue: 'portfolio.os · /positions',
    detail:
      'Live paper-trade started on project 03 (BTC/USDT, 30% annualized vol target). Public-data reproducible end-to-end. Currently in regime 2 (50+ trading days), tracking slippage against the 5 bps linear-impact model. 4.2 bps realized.',
    url: '/positions',
  },
  {
    date: '2026-03-22',
    year: 2026,
    title: 'Slop-scanner app released. 13-metric literature-grounded AI-output quality gate',
    venue: 'github.com/christianmacion26/slop-scanner',
    detail:
      'Streamlit app that scores a draft on 13 literature-grounded quality metrics (vocabulary entropy, hedge-word density, generic-template phrases, repetition n-grams) and outputs a single SLOP index from HEAVY to CLEAN. Stdlib scoring core needs no LLM and no API key. Drove a real draft from HEAVY (81) to CLEAN (3).',
    url: '/projects/ai/06-slop-scanner',
  },
  {
    date: '2024-09-15',
    year: 2024,
    title: 'PSHS-SMC alumni speaker. Philippine Science High School Southern Mindanao',
    venue: 'PSHS-SMC Alumni Talk Series',
    detail:
      'Talk on AI engineering and the educational path from PSHS to AI/quant careers. ~80 attendees (alumni + current students).',
  },
  {
    date: '2025-03-22',
    year: 2025,
    title: 'University guest lecturer. University of Southeastern Philippines (USeP)',
    venue: 'USeP College of Engineering',
    detail:
      'Guest lecture on systematic trading research and AI for engineering students. Course: CpE / EE 5th-year elective.',
  },
  {
    date: '2025-12-10',
    year: 2025,
    title: 'STA Tier-1 CTA Program completion. Society of Technical Analysts of the Philippines',
    venue: 'STA Philippines',
    detail:
      'Tier-1 Certified Technical Analyst program, completed Dec 2025. Final capstone: regime-classification case study on ASEAN equities.',
  },
  {
    date: '2025-11-21',
    year: 2025,
    title: 'BIDA × Meta AIccelerate 2025. 5-day hybrid training, awarded Dec 17 2025',
    venue: 'BIDA × Bayan Academy × Meta',
    detail:
      'Selected for the BIDA × Bayan Academy × Meta AIccelerate 2025 Batch 3 (Nov 12 to 21 2025). Five-day hybrid training on applied AI for MSMEs; co-signed certificate from BIDA, Bayan Academy, and Meta Philippines.',
    url: '/proof/bida-meta-aiccelerate-2025-11.jpg',
    kind: 'training',
  },
  {
    date: '2026-01-19',
    year: 2026,
    title: 'CTA program graduate. Society of Technical Analysts of the Philippines',
    venue: 'STA Philippines',
    detail:
      'Cert #260197 issued Jan 19 2026 (program completed Dec 2025; cert-grant ceremony Jan 19 2026). Photographic proof on the record. same image used in the hero signature strip.',
    url: '/proof/cta-cert-portrait-2026-01.jpg',
    kind: 'certification',
  },
];

// Sort press items by date desc (then by year desc as tiebreaker). The source-of-truth order in
// `pressUnsorted` is "most-recent-first as I wrote them"; this ensures a stable AQR-style
// date-DESC render even when I forget to physically reorder the array.
const press = [...pressUnsorted].sort((a, b) => {
  if (a.date !== b.date) return a.date < b.date ? 1 : -1;
  return (b.year ?? 0) - (a.year ?? 0);
});

const totalCount = quantPubs.length + aiPubs.length + workbooks.length + press.length;
---

<BaseLayout
  title="Publications"
  description="Public work. research projects, workbooks, talks, OSS repos, and press. All NDA-safe."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Publications', href: '/publications' },
  ]}
>
  {
    /* === CSS-only topic filter (no JS) ===
      v6.10.17 : a11y: drop aria-hidden="true" so screen readers
      can announce the filter state (was previously masked, defeating
      the purpose of the radio group). Visual hide is via .topic-input
      CSS below. */
  }
  <input type="radio" name="topic" id="topic-all" class="topic-input topic-input--all" checked />
  <input type="radio" name="topic" id="topic-papers" class="topic-input topic-input--papers" />
  <input type="radio" name="topic" id="topic-oss" class="topic-input topic-input--oss" />
  <input
    type="radio"
    name="topic"
    id="topic-workbooks"
    class="topic-input topic-input--workbooks"
  />
  <input type="radio" name="topic" id="topic-press" class="topic-input topic-input--press" />
  <header class="pub-head">
    <div class="container">
      <p class="pub-head__eyebrow mono">
        <span class="pub-head__eyebrow-chip">PUBLICATIONS · {totalCount} ARTIFACTS</span>
        <span class="pub-head__eyebrow-line">DATED · LINKABLE · PROOF-IN-ROW</span>
      </p>
      <h1 class="pub-head__title" data-words>
        Things I have <span class="hl">written, built, and said</span> in public.
      </h1>
      <VoiceLine class="pub-head__voice">
        Dated. Linkable. If a row says I did something, the proof is in the same row.
      </VoiceLine>
      <p class="pub-head__sub">
        Every artifact below is either an OSS repo, a memo, a workbook, or a public talk.
      </p>

      {/* Topic filter labels : radio inputs above are hidden; these are the clickable labels */}
      <nav class="topic-filter" aria-label="Filter publications by topic">
        <label for="topic-all" class="topic-btn"
          ><span class="mono">all</span> <span class="topic-count">{totalCount}</span></label
        >
        <label for="topic-papers" class="topic-btn"
          ><span class="mono">papers</span>
          <span class="topic-count">{quantPubs.length}</span></label
        >
        <label for="topic-oss" class="topic-btn"
          ><span class="mono">oss</span> <span class="topic-count">{aiPubs.length}</span></label
        >
        <label for="topic-workbooks" class="topic-btn"
          ><span class="mono">workbooks</span>
          <span class="topic-count">{workbooks.length}</span></label
        >
        <label for="topic-press" class="topic-btn"
          ><span class="mono">press</span> <span class="topic-count">{press.length}</span></label
        >
      </nav>
      <p class="pub-head__tenant mono">
        <span>CHRISTIAN.T.MACION</span>
        <span aria-hidden="true">·</span>
        <span>UTC+8</span>
        <span aria-hidden="true">·</span>
        <span>{totalCount} ARTIFACTS</span>
        <span aria-hidden="true">·</span>
        <span>NDA-SAFE</span>
        <span aria-hidden="true">·</span>
        <span>OWNER-VERIFIED</span>
      </p>
    </div>
  </header>

  <TrustStrip variant="tape" />

  <div class="container">
    <ReadMeta minutes={7} href={path('/proof')} />
  </div>

  <section class="section section--alt" data-topic="papers" data-section-id="publications">
    <div class="container">
      <header class="section__head">
        <SectionMark index="00" title="publications" />
        <p class="section__eyebrow">Research papers · {quantPubs.length} quant projects</p>
        <h2 class="section__title">Public-data systematic research.</h2>
      </header>
      {
        quantByYear.map(([year, pubs]) => (
          <div class="pub-year-group">
            <h3 class="pub-year mono">{year}</h3>
            <div class="pub-list" data-pub-list="quant">
              {pubs.map((p) => (
                <article class="pub">
                  <div class="pub__num mono" />
                  <div class="pub__body">
                    <h4 class="pub__title">
                      <a href={path(`/projects/${p.id}`)}>{p.data.title}</a>
                    </h4>
                    <p class="pub__summary">{p.data.summary}</p>
                    {p.data.metrics.length > 0 && (
                      <ul class="pub__metrics">
                        {p.data.metrics.map((m: ProjectEntry['data']['metrics'][number]) => (
                          <li>
                            <span class="pub__metric-label">{m.label}</span>
                            <span class="pub__metric-value mono">{m.value}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                    <div class="pub__meta">
                      {p.data.stack.slice(0, 6).map((s: string) => (
                        <span class="pill">{s}</span>
                      ))}
                    </div>
                    {/* v13.1.4 (2026-08-11, publications-uplift) :
                        per-publication metadata. Status + date + related
                        surface + commit hash. Inline copy-edit; lives
                        inside the card body so the meta stays visually
                        attached to the publication. Text only, no
                        nested anchor (the parent pub__title anchor
                        would otherwise swallow the click). */}
                    <div class="pub__meta-strip mono">
                      PUBLISHED · {fmtDate(p.data.date)} ·
                      <a href={path(`/projects/${p.id}`)}>related surface →</a>
                      · commit <code>{PUBLICATIONS_COMMIT}</code>
                    </div>
                  </div>
                  <div class="pub__action">
                    <div class="pub__date mono">{fmtDate(p.data.date)}</div>
                    <a class="btn btn--ghost btn--sm" href={path(`/projects/${p.id}`)}>
                      Read →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section" data-topic="oss" data-section-id="publications">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">OSS projects · {aiPubs.length} AI builds</p>
        <h2 class="section__title">Multi-agent LLM systems with eval-first discipline.</h2>
      </header>
      {
        aiByYear.map(([year, pubs]) => (
          <div class="pub-year-group">
            <h3 class="pub-year mono">{year}</h3>
            <div class="pub-list" data-pub-list="ai">
              {pubs.map((p) => (
                <article class="pub">
                  <div class="pub__num mono" />
                  <div class="pub__body">
                    <h4 class="pub__title">
                      <a href={path(`/projects/${p.id}`)}>{p.data.title}</a>
                    </h4>
                    <p class="pub__summary">{p.data.summary}</p>
                    {p.data.metrics.length > 0 && (
                      <ul class="pub__metrics">
                        {p.data.metrics.map((m: ProjectEntry['data']['metrics'][number]) => (
                          <li>
                            <span class="pub__metric-label">{m.label}</span>
                            <span class="pub__metric-value mono">{m.value}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                    <div class="pub__meta">
                      {p.data.stack.slice(0, 6).map((s: string) => (
                        <span class="pill">{s}</span>
                      ))}
                    </div>
                    {/* v13.1.4 (2026-08-11, publications-uplift) :
                        per-publication metadata for OSS rows. Same
                        register as the quant section above; status
                        flag = OPEN SOURCE so the row reads as a
                        public repo, not a draft memo. */}
                    <div class="pub__meta-strip mono">
                      OPEN SOURCE · {fmtDate(p.data.date)} ·
                      <a href={path(`/projects/${p.id}`)}>related surface →</a>
                      · commit <code>{PUBLICATIONS_COMMIT}</code>
                    </div>
                  </div>
                  <div class="pub__action">
                    <div class="pub__date mono">{fmtDate(p.data.date)}</div>
                    <a class="btn btn--ghost btn--sm" href={path(`/projects/${p.id}`)}>
                      Read →
                    </a>
                    {p.data.sourceLink && (
                      <a
                        class="btn btn--ghost btn--sm"
                        href={p.data.sourceLink}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Repo ↗
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--alt" data-topic="workbooks" data-section-id="publications">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Workbooks · long-form</p>
        <h2 class="section__title">
          {publishedCount} published · {workbooks.length - publishedCount} in progress.
        </h2>
        <p class="section__sub">
          Long-form workbooks that consolidate method, code, and exercises. Published entries ship
          as public PDFs; in-progress drafts are available on request.
        </p>
      </header>
      <div class="workbooks">
        {
          workbooks.map((w) => (
            <article class="wb">
              <h3 class="wb__title">{w.url ? <a href={w.url}>{w.title}</a> : w.title}</h3>
              <div class="wb__scope">{w.scope}</div>
              <div class="wb__meta mono">
                <span>{w.pages}</span>
                <span aria-hidden="true">·</span>
                <span>{w.audience}</span>
                {w.author && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>{w.author}</span>
                  </>
                )}
              </div>
              <div class="wb__foot mono">
                <span
                  class:list={[
                    'wb__status',
                    w.status === 'Published' ? 'wb__status--pub' : 'wb__status--wip',
                  ]}
                >
                  {w.status ?? 'In progress'}
                </span>
                {w.url ? (
                  <>
                    {' '}
                    :{' '}
                    <a href={w.url}>
                      {w.fileSize ?? 'PDF'} · {w.pages}
                    </a>
                    {w.date && (
                      <>
                        {' · '}
                        <time datetime={w.date}>{w.date}</time>
                      </>
                    )}
                    {w.citationKey && <span class="wb__cite mono"> · cite:{w.citationKey}</span>}
                  </>
                ) : (
                  ' to early-reader draft; full PDF available on request (non-public, gated by topic)'
                )}
              </div>
              {/* v13.1.4 (2026-08-11, publications-uplift) :
                  per-workbook metadata. Status flag maps the existing
                  wb__status chip onto the inline-strip register so the
                  row reads as PUBLISHED or DRAFT consistently with
                  papers and OSS. Related surface = /workbooks/ PDF
                  (when published) or /proof/ (when in progress). */}
              <div class="wb__meta-strip mono">
                {(w.status ?? 'DRAFT').toUpperCase()} · {w.date ?? 'unfiled'} ·
                <a href={w.url ?? path('/proof')}>related surface →</a>
                · commit <code>{PUBLICATIONS_COMMIT}</code>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" data-topic="press" data-section-id="publications">
    <div class="container">
      <header class="section__head">
        <p class="section__eyebrow">Press & recognition</p>
        <h2 class="section__title">Public talks, lectures, and recognitions.</h2>
      </header>
      <ol class="press">
        {
          press.map((p) => (
            <li class="press__row">
              <div class="press__year mono">{p.year}</div>
              <div class="press__body">
                <h3 class="press__title">{p.title}</h3>
                <div class="press__venue mono">Venue: {p.venue}</div>
                <p class="press__detail">{p.detail}</p>
                {/* v13.1.4 (2026-08-11, publications-uplift) :
                    per-press-row metadata. Status + date + related
                    surface (proof page when no own URL) + commit hash.
                    Inline copy-edit; lives inside the press body so
                    the meta stays visually attached to the row. */}
                <div class="press__meta-strip mono">
                  PUBLIC TALK · {p.date} ·
                  <a href={p.url ?? path('/proof')}>related surface →</a>
                  · commit <code>{PUBLICATIONS_COMMIT}</code>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CTABanner
    title="Want a specific paper or talk?"
    sub="Email me the topic and I'll point you to the artifact (PDF, video, repo) within 24 hours."
    primaryLabel="Email me"
    secondaryLabel="See methodology"
    secondaryHref={path('/methodology')}
  />

  {/* v13.1.4 (2026-08-11, publications-uplift) : recency stamp at
      bottom of page. Anchors the page to its last content-edit
      commit. Same register as /contact/ `.contact-recency`
      (polish-7x commit 19aa5ef) and /positions/ `.positions-recency`
      (polish-7z commit ec1674b). */}
  <p class="pub-recency mono">
    Last updated: 2026-08-11 · commit
    <a href={`https://github.com/christianmacion/christianmacion.github.io/commit/${PUBLICATIONS_COMMIT}`}
      ><code>{PUBLICATIONS_COMMIT}</code></a
    >
  </p>
</BaseLayout>

<style>
  /* === Topic filter (CSS-only, no JS) === */
  .topic-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .topic-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--c-rule-soft);
  }
  .topic-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius-sm);
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    cursor: pointer;
    /* v9.3.2 motion contract : explicit properties only. .topic-btn
       changes border-color, color, and background-color on hover/active.
       No layout-triggering properties (width/height). */
    transition:
      border-color var(--transition),
      color var(--transition),
      background-color var(--transition);
    user-select: none;
  }
  .topic-btn:hover {
    border-color: var(--c-amber);
    color: var(--c-primary);
  }
  .topic-count {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    padding: 0 var(--sp-2);
    border-radius: var(--radius-sm);
    background: var(--c-bg-2);
  }
  /* Selected state */
  .topic-input--all:checked ~ * .topic-btn:has(input[disabled]),
  .topic-input--papers:checked ~ * [data-topic='papers'],
  .topic-input--oss:checked ~ * [data-topic='oss'],
  .topic-input--workbooks:checked ~ * [data-topic='workbooks'],
  .topic-input--press:checked ~ * [data-topic='press'] {
    /* not quite : use sibling cascade */
  }
  /* v9.2 a11y : was --c-amber bg + --c-primary text which only
     hits 1.39:1 in light theme after the legacy --c-phi remap.
     Use the same theme-neutral amber/bg pairing as the rest of the
     site: --c-amber bg + --c-bg text, both themes ≥ 4.5:1. */
  .topic-input--all:checked ~ * label[for='topic-all'] {
    background: var(--c-amber);
    color: var(--c-bg);
    border-color: var(--c-amber);
  }
  .topic-input--all:checked ~ * label[for='topic-all'] .topic-count {
    color: var(--c-bg);
    background: var(--c-amber-light);
  }
  .topic-input--papers:checked ~ * label[for='topic-papers'] {
    background: var(--c-amber);
    color: var(--c-bg);
    border-color: var(--c-amber);
  }
  .topic-input--papers:checked ~ * label[for='topic-papers'] .topic-count {
    color: var(--c-bg);
    background: var(--c-amber-light);
  }
  .topic-input--oss:checked ~ * label[for='topic-oss'] {
    background: var(--c-amber);
    color: var(--c-bg);
    border-color: var(--c-amber);
  }
  .topic-input--oss:checked ~ * label[for='topic-oss'] .topic-count {
    color: var(--c-bg);
    background: var(--c-amber-light);
  }
  .topic-input--workbooks:checked ~ * label[for='topic-workbooks'] {
    background: var(--c-amber);
    color: var(--c-bg);
    border-color: var(--c-amber);
  }
  .topic-input--workbooks:checked ~ * label[for='topic-workbooks'] .topic-count {
    color: var(--c-bg);
    background: var(--c-amber-light);
  }
  .topic-input--press:checked ~ * label[for='topic-press'] {
    background: var(--c-amber);
    color: var(--c-bg);
    border-color: var(--c-amber);
  }
  .topic-input--press:checked ~ * label[for='topic-press'] .topic-count {
    color: var(--c-bg);
    background: var(--c-amber-light);
  }

  /* Hide sections by default; show based on filter.
     Radio inputs and <section data-topic> are direct children of <main>
     (siblings), so the selector is `~ [data-topic]` : `~ main` would
     require <main> to be a later sibling of the input, which it isn't. */
  [data-topic='papers'],
  [data-topic='oss'],
  [data-topic='workbooks'],
  [data-topic='press'] {
    display: none;
  }
  .topic-input--all:checked ~ [data-topic='papers'],
  .topic-input--all:checked ~ [data-topic='oss'],
  .topic-input--all:checked ~ [data-topic='workbooks'],
  .topic-input--all:checked ~ [data-topic='press'],
  .topic-input--papers:checked ~ [data-topic='papers'],
  .topic-input--oss:checked ~ [data-topic='oss'],
  .topic-input--workbooks:checked ~ [data-topic='workbooks'],
  .topic-input--press:checked ~ [data-topic='press'] {
    display: block;
  }
  .topic-input--all:checked ~ [data-topic='papers'] .pub-list,
  .topic-input--all:checked ~ [data-topic='oss'] .pub-list,
  .topic-input--all:checked ~ [data-topic='workbooks'] .workbooks,
  .topic-input--all:checked ~ [data-topic='press'] .press {
    display: flex;
  }

  /* === Year groups (AQR-style) === */
  .pub-year-group {
    margin-bottom: var(--sp-6);
  }
  .pub-year {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-amber);
    font-weight: 600;
    margin: 0 0 var(--sp-3);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--c-rule-soft);
  }

  .pub-head {
    padding-block: var(--sp-9) var(--sp-7);
    background: var(--c-bg);
    border-bottom: var(--border);
  }
  .pub-head__title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-block: var(--sp-4) var(--sp-5);
    max-width: 22ch;
  }
  .pub-head__sub {
    font-size: var(--fs-lg);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    max-width: 60ch;
    margin-bottom: 0;
  }
  .pub-head__voice {
    margin: 0 0 var(--sp-5);
    max-width: 60ch;
  }
  .pub-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    counter-reset: pub;
  }
  .pub {
    display: grid;
    grid-template-columns: 60px 1fr auto;
    gap: var(--sp-5);
    padding: var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    align-items: start;
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }
  .pub:hover {
    border-color: var(--c-primary);
    box-shadow: var(--shadow-sm);
  }
  .pub__num {
    font-size: var(--fs-lg);
    color: var(--c-primary);
    font-weight: 600;
    counter-increment: pub;
  }
  .pub__num::before {
    content: '[' counter(pub, decimal-leading-zero) ']';
  }
  .pub__title {
    font-size: var(--fs-lg);
    margin: 0 0 var(--sp-2);
  }
  .pub__title a {
    color: var(--c-ink);
  }
  .pub__title a:hover {
    color: var(--c-primary);
  }
  .pub__summary {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    margin: 0 0 var(--sp-3);
  }
  .pub__metrics {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-bottom: var(--sp-3);
  }
  .pub__metrics li {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .pub__metric-label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--c-ink-3);
  }
  .pub__metric-value {
    font-size: var(--fs-base);
    color: var(--c-primary);
    font-weight: 600;
  }
  .pub__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .pub__action {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    align-items: flex-end;
  }
  .pub__date {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .workbooks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-4);
  }
  .wb {
    padding: var(--sp-5);
    background: var(--c-bg);
    border: 1px solid var(--c-rule);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .wb__title {
    font-size: var(--fs-lg);
    color: var(--c-ink);
    margin: 0;
  }
  .wb__scope {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
  }
  .wb__meta {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .wb__foot {
    margin-top: auto;
    padding-top: var(--sp-3);
    border-top: 1px dashed var(--c-rule-soft);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
  }
  .wb__status {
    display: inline-block;
    padding: 0 6px;
    /* v6.10.36 : token alias for F13 amber family. */
    background: var(--c-amber-soft);
    color: var(--c-warn);
    border-radius: 1px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  /* Published variant : single accent (electric blue) hairline border
     so it reads as a status badge, not a CTA. No glow, no fill flip. */
  .wb__status--pub {
    background: transparent;
    color: var(--c-primary);
    border: 1px solid var(--c-primary);
  }
  .wb__cite {
    color: var(--c-ink-3);
    font-size: 0.92em;
  }

  .press {
    list-style: none;
    padding: 0;
    max-width: 760px;
  }
  .press__row {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    border-bottom: 1px solid var(--c-rule-soft);
  }
  .press__row:last-child {
    border-bottom: none;
  }
  .press__year {
    font-size: var(--fs-lg);
    color: var(--c-primary);
    font-weight: 600;
  }
  .press__title {
    font-size: var(--fs-base);
    margin: 0 0 var(--sp-1);
  }
  .press__venue {
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    margin-bottom: var(--sp-2);
  }
  .press__detail {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
    line-height: var(--lh-loose);
    margin: 0;
  }

  @media (max-width: 720px) {
    .pub {
      grid-template-columns: 40px 1fr;
    }
    .pub__action {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .press__row {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }

  /* v13.1.4 (2026-08-11, publications-uplift) : per-publication
     metadata strip. Same register as /contact/ `.contact-card__meta`
     (polish-7x commit 19aa5ef) and /positions/ `.positions-card__meta`
     (polish-7z commit ec1674b). Chrome-neutral (ink-3 + primary
     link), dashed hairline, mono caps. */
  .pub__meta-strip,
  .wb__meta-strip,
  .press__meta-strip {
    margin-top: var(--sp-2);
    padding-top: var(--sp-2);
    border-top: 1px dashed var(--c-rule-soft);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
  .pub__meta-strip a,
  .wb__meta-strip a,
  .press__meta-strip a {
    color: var(--c-primary);
    text-decoration: underline;
    text-decoration-color: var(--c-amber-decor);
    text-underline-offset: 2px;
  }
  .pub__meta-strip code,
  .wb__meta-strip code,
  .press__meta-strip code {
    font-family: var(--ff-mono);
    color: var(--c-ink-2);
    background: transparent;
    padding: 0;
  }

  /* v13.1.4 (2026-08-11, publications-uplift) : recency stamp at
     bottom of page. Same register as /contact/ `.contact-recency`
     (polish-7x commit 19aa5ef) and /positions/ `.positions-recency`
     (polish-7z commit ec1674b). */
  .pub-recency {
    margin: var(--sp-4) auto var(--sp-6);
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-xs);
    color: var(--c-ink-3);
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-align: center;
    max-width: 640px;
  }
  .pub-recency a {
    color: var(--c-ink-2);
    text-decoration: underline;
    text-decoration-color: var(--c-rule);
    text-underline-offset: 2px;
  }
  .pub-recency a:hover {
    text-decoration-color: var(--c-amber);
  }
  .pub-recency code {
    font-family: var(--ff-mono);
    color: var(--c-ink-2);
    background: transparent;
    padding: 0;
